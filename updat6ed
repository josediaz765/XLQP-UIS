        Parent = Box.Holder,
    })
    table.insert(Library.Corners, New("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Button }))
    Library:AddOutline(Button)
    Library:GiveSignal(Button.MouseButton1Click:Connect(function()
        Box:TogglePoppedOut()
    end))
    Box._PopOutButton = Button
end

local function ObsidianEnhanceContainer(Owner)
    if not Owner or Owner._Modernized then
        return Owner
    end
    Owner._Modernized = true
    if Owner.Button then
        function Owner:SetOrder(Order)
            assert(typeof(Order) == "number", "Order must be a number.")
            local Target = Owner.Type == "Tab" and Owner.Button.Parent or Owner.Button
            Target.LayoutOrder = Order
        end
        function Owner:SetTooltip(Text)
            Owner.Tooltip = Text
            if Owner.TooltipTable then
                Owner.TooltipTable:Destroy()
                Owner.TooltipTable = nil
            end
            if typeof(Text) == "string" then
                Owner.TooltipTable = Library:AddTooltip(Text, nil, Owner.Button)
            end
        end
        function Owner:UpdateTabInfo()
            if Owner.Window then
                Owner.Window:ShowTabInfo(Owner.Name, Owner.Description)
            end
        end
    end
    if Owner.Type == "Tab" and Owner.Show then
        local BaseShow = Owner.Show
        Owner.Show = function(Self, ...)
            if Library.ActiveTab and Library.ActiveTab ~= Self then
                Library.PreviousTab = Library.ActiveTab
            end
            return BaseShow(Self, ...)
        end
    end
    if Owner.AddSubTab then
        local OriginalAddSubTab = Owner.AddSubTab
        Owner.AddSubTab = function(Self, ...)
            local SubTab = OriginalAddSubTab(Self, ...)
            ObsidianEnhanceContainer(SubTab)
            local Args = { ... }
            local Info = typeof(Args[1]) == "table" and Args[1] or { Description = Args[3], Order = Args[4] }
            SubTab.Description = Info.Description
            if Info.Order ~= nil then
                SubTab:SetOrder(Info.Order)
            end
            if Info.Tooltip ~= nil then
                SubTab:SetTooltip(Info.Tooltip)
            end
            return SubTab
        end
    end
    if Owner.AddGroupbox then
        local OriginalAddGroupbox = Owner.AddGroupbox
        Owner.AddGroupbox = function(Self, Info)
            local RawInfo = typeof(Info) == "table" and Info or { Name = tostring(Info or "Groupbox"), Side = 1 }
            if typeof(RawInfo.Side) == "string" then
                RawInfo.Side = SideIndex[string.lower(RawInfo.Side)] or 1
            end
            RawInfo.Side = RawInfo.Side or 1
            local Box = OriginalAddGroupbox(Self, RawInfo)
            if Box then
                Box.Description = RawInfo.Description
                Library:MakeBoxPopOut(Box, {
                    Enabled = RawInfo.PopOut ~= false,
                    Header = Box.CollapseButton or Box.Holder,
                    Width = RawInfo.PopOutWidth,
                    MaxHeight = RawInfo.MaxPopOutHeight,
                })
                if RawInfo.PopOutButton == true then
                    ObsidianAddPopOutButton(Box)
                end
                if Box.AddTabbox then
                    local OriginalNestedTabbox = Box.AddTabbox
                    Box.AddTabbox = function(BoxSelf, TabInfo)
                        local TI = typeof(TabInfo) == "table" and TabInfo or { Name = TabInfo }
                        TI.Side = TI.Side or 1
                        local TB = OriginalNestedTabbox(BoxSelf, TI)
                        if TB then
                            Library:MakeBoxPopOut(TB, { Enabled = TI.PopOut ~= false, Header = TB.Holder })
                        end
                        return TB
                    end
                end
            end
            return Box
        end
    end
    if Owner.AddTabbox then
        local OriginalAddTabbox = Owner.AddTabbox
        Owner.AddTabbox = function(Self, Info)
            local RawInfo = typeof(Info) == "table" and Info or { Name = Info, Side = 1 }
            if typeof(RawInfo.Side) == "string" then
                RawInfo.Side = SideIndex[string.lower(RawInfo.Side)] or 1
            end
            RawInfo.Side = RawInfo.Side or 1
            local Box = OriginalAddTabbox(Self, RawInfo)
            if Box then
                Library:MakeBoxPopOut(Box, {
                    Enabled = RawInfo.PopOut ~= false,
                    Header = Box.Holder,
                    Width = RawInfo.PopOutWidth,
                    MaxHeight = RawInfo.MaxPopOutHeight,
                })
            end
            return Box
        end
    end
    return Owner
end

