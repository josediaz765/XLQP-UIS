        end
        if WindowInfo.EnableCompacting == nil then
            WindowInfo.EnableCompacting = true
        end
        if WindowInfo.SearchbarSize == nil then
            WindowInfo.SearchbarSize = UDim2.fromScale(0.5, 1)
        end
        if WindowInfo.AddGroupboxAnimation == nil then
            WindowInfo.AddGroupboxAnimation = false
        end
        if WindowInfo.ForceMobileSidebarResize ~= true then
            WindowInfo.EnableSidebarResize = false
        end
        if WindowInfo.ForceMobileResize ~= true then
            WindowInfo.Resizable = false
        end
        if WindowInfo.ForceMobileSearchValues ~= true then
            WindowInfo.SearchValues = false
        end
        WindowInfo.ShowCustomCursor = false
        Library.ShowCustomCursor = false
        Library.SuppressCallbackErrors = true
        Library.PopOutDragThreshold = math.max(tonumber(Library.PopOutDragThreshold) or 8, 14)
        if WindowInfo.MobilePerformanceMode ~= false then
            WindowInfo.Animations = {
                ToggleWindow = false,
                TabSwitch = false,
                Groupbox = false,
                Dropdown = false,
                KeyPicker = false,
                SubTabUnderline = false,
                SidebarSubTabs = false,
            }
            Library:SetPerformanceMode(true)
        end
    end
    local Window = BaseCreateWindow(self, WindowInfo)
    if Library.ReducedMotion then
        Library:SetReducedMotion(true)
    end
    ObsidianEnsureFloatLayers()
    ObsidianSetAlwaysOnTop(Library.ScreenGui, WindowInfo.AlwaysOnTop == true)
    function Window:SetAlwaysOnTop(Enabled)
        WindowInfo.AlwaysOnTop = Enabled == true
        ObsidianSetAlwaysOnTop(Library.ScreenGui, WindowInfo.AlwaysOnTop)
    end
    function Window:SetSnapping(Enabled, Distance, Margin, AvoidCoreGui)
        WindowInfo.Snapping = Enabled == true
        local Config = Library._WindowSnapConfig
        if Config then
            Config.Enabled = WindowInfo.Snapping
            if tonumber(Distance) then
                Config.Distance = tonumber(Distance)
            end
            if tonumber(Margin) then
                Config.Margin = tonumber(Margin)
            end
            if AvoidCoreGui ~= nil then
                Config.AvoidCoreGui = AvoidCoreGui == true
            end
        end
    end
    function Window:GetActiveTab()
        return Library.ActiveTab
    end
    function Window:GoBackTab()
        local Previous = Library.PreviousTab
        if Previous and not Previous.Destroyed and Previous.Show then
            Previous:Show()
        end
        return Previous
    end
    function Window:SetMobileButtonsVisible(Visible)
        WindowInfo.ShowMobileButtons = Visible == true
        for _, Object in Library.ScreenGui:GetDescendants() do
            if
                Object:IsA("GuiButton")
                and (Object.Name == "MobileButton" or Object:GetAttribute("ObsidianMobileButton"))
            then
                Object.Visible = WindowInfo.ShowMobileButtons
            end
        end
    end
    local OriginalAddTab = Window.AddTab
    Window.AddTab = function(Self, ...)
        local Tab = OriginalAddTab(Self, ...)
        ObsidianEnhanceContainer(Tab)
        local Args = { ... }
        local Info = typeof(Args[1]) == "table" and Args[1] or { Order = Args[4] }
        Tab.HasSubTabs = Info.SubTabs == true
        if Info.Order ~= nil then
            Tab:SetOrder(Info.Order)
        end
        if Info.Tooltip ~= nil then
            Tab:SetTooltip(Info.Tooltip)
        end
        return Tab
    end
    return Window
end

function Library:CloseAllPopOuts()
    for _, Tab in Library.Tabs do
        local function CloseOwner(Owner)
            if Owner.Groupboxes then
                for _, Box in Owner.Groupboxes do
                    if Box and Box.PoppedOut then
                        Box:SetPoppedOut(false)
                    end
                end
            end
            if Owner.Tabboxes then
                for _, Box in Owner.Tabboxes do
                    if Box and Box.PoppedOut then
                        Box:SetPoppedOut(false)
                    end
                end
            end
            if Owner.SubTabs then
                for _, Sub in Owner.SubTabs do
                    CloseOwner(Sub)
                end
            end
        end
        CloseOwner(Tab)
    end
end

function Library:GetOpenPopOuts()
    local Result = {}
    local function Scan(Owner)
        if not Owner then
            return
        end
        if Owner.Groupboxes then
            for _, Box in Owner.Groupboxes do
                if Box and Box.PoppedOut then
                    table.insert(Result, Box)
                end
            end
        end
        if Owner.Tabboxes then
            for _, Box in Owner.Tabboxes do
                if Box and Box.PoppedOut then
                    table.insert(Result, Box)
                end
            end
        end
        if Owner.SubTabs then
            for _, Sub in Owner.SubTabs do
                Scan(Sub)
            end
        end
    end
    for _, Tab in Library.Tabs do
        Scan(Tab)
    end
    return Result
end

function Library:ArrangePopOuts(Mode)
    local Boxes = Library:GetOpenPopOuts()
    local Viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    Mode = string.lower(tostring(Mode or "cascade"))
    if Mode == "center" then
        for _, Box in Boxes do
            if Box.CenterPopOut then
                Box:CenterPopOut()
            end
        end
        return Boxes
    end
    local X, Y = 18, 18
    local Step = Library.IsMobile and 18 or 26
    for _, Box in Boxes do
        if Box.SetPopOutPosition then
            Box:SetPopOutPosition(UDim2.fromOffset(X, Y))
            X += Step
            Y += Step
            if X > Viewport.X * 0.35 or Y > Viewport.Y * 0.35 then
                X, Y = 18, 18
            end
        end
    end
    return Boxes
end

function Library:SetPopOutsPinned(Value)
    for _, Box in Library:GetOpenPopOuts() do
        if Box.SetPopOutPinned then
            Box:SetPopOutPinned(Value)
        end
    end
end

function Library:SetPopOutsLocked(Value)
    for _, Box in Library:GetOpenPopOuts() do
        if Box.SetPopOutLocked then
            Box:SetPopOutLocked(Value)
        end
    end
end

local function RestoreMouseIcon()
    pcall(function()
        RunService:UnbindFromRenderStep(Library.ShowCursorBinding or "ObsidianShowCursor")
    end)
    UserInputService.MouseIconEnabled = Library.OriginalMouseIconEnabled
    if Cursor then
        Cursor.Visible = false
    end
end

local BaseUnloadModernized = Library.Unload
function Library:Unload(...)
    if Library.Unloaded then
        return
    end
    RestoreMouseIcon()
    if Library.KeybindMenu then
        Library.KeybindMenu:Destroy()
    end
    if Library.ContextMenus then
        for _, Menu in Library.ContextMenus do
            if Menu and Menu.Destroy then
                pcall(Menu.Destroy, Menu)
            end
        end
        table.clear(Library.ContextMenus)
    end
    pcall(function()
        Library:CloseAllPopOuts()
    end)
    local FloatGui = Library.FloatScreenGui
    local Results = table.pack(BaseUnloadModernized(self, ...))
    if FloatGui then
        pcall(function()
            FloatGui:Destroy()
        end)
    end
    Library.FloatScreenGui = nil
    Library.Floats = nil
    Library.Overlay = nil
    return table.unpack(Results, 1, Results.n)
end

getgenv().Library = Library
return Library
