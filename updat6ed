function Library:MakeBoxPopOut(Box, Options)
    Options = Options or {}
    if Box._PopOutInitialized then
        if Options.Width ~= nil then
            Box:SetPopOutWidth(Options.Width)
        end
        if Options.MaxHeight ~= nil then
            Box:SetMaxPopOutHeight(Options.MaxHeight)
        end
        return Box
    end
    Box.PoppedOut = false
    Box.PopOutEnabled = Options.Enabled ~= false
    Box.PopOutFloat = nil
    Box.PopOutPlaceholder = nil
    Box.PopOutPinned = false
    Box.PopOutLocked = false

    local Holder = Box.Holder
    local BoxHolder = Box.BoxHolder
    local Header = Options.Header or Box.CollapseButton or Box.Header or Holder
    local Controller = EnsureObsidianDragController()

    if not Box.PopOutEnabled or not Holder or not BoxHolder or not Header then
        function Box:SetPoppedOut()
            return Box
        end
        function Box:TogglePoppedOut()
            return Box
        end
        function Box:SetPopOutPinned()
            return false
        end
        function Box:SetPopOutLocked()
            return false
        end
        function Box:BringPopOutToFront()
            return Box
        end
        function Box:SetPopOutPosition()
            return Box
        end
        function Box:GetPopOutPosition()
            return nil
        end
        function Box:ResetPopOutPosition()
            return Box
        end
        function Box:CenterPopOut()
            return Box
        end
        return Box
    end

    Box._PopOutInitialized = true
    local Placeholder
    local Float
    local FloatScale
    local SizeConnection
    local VisibilityConnection
    local OriginalParent
    local OriginalSize
    local OriginalPosition
    local OriginalAnchorPoint
    local OriginalLayoutOrder
    local LastDockPosition
    local SyncingSize = false
    local HeaderConnection

    local function ScaleValue()
        return math.max(tonumber(Library.DPIScale) or 1, 0.01)
    end

    local function ViewportSize()
        local Camera = workspace.CurrentCamera
        return Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
    end

    local function ClampPosition(Position, LogicalSize)
        if Options.ClampToScreen == false then
            return Position
        end

        local Scale = ScaleValue()
        local Viewport = ViewportSize()
        local Padding = tonumber(Options.ScreenPadding) or (Library.IsMobile and 10 or 8)
        local Width = LogicalSize.X * Scale
        local Height = LogicalSize.Y * Scale
        local TopLeftInset, BottomRightInset = GetCoreGuiInset()
        local MinX = TopLeftInset.X + Padding
        local MinY = TopLeftInset.Y + Padding
        local MaxX = Viewport.X - BottomRightInset.X - math.min(Width, Viewport.X - Padding * 2) - Padding
        local MaxY = Viewport.Y - BottomRightInset.Y - math.min(Height, Viewport.Y - Padding * 2) - Padding
        local X = math.clamp(Position.X.Offset, MinX, math.max(MinX, MaxX))
        local Y = math.clamp(Position.Y.Offset, MinY, math.max(MinY, MaxY))
        return UDim2.fromOffset(X, Y)
    end

    local function LogicalHolderSize()
        local Scale = ScaleValue()
        local Size = Holder.AbsoluteSize
        local Width = math.max(Library.IsMobile and 180 or 80, tonumber(Box.PopOutWidth) or Size.X / Scale)
        local Height = math.max(34, Size.Y / Scale)
        local Viewport = ViewportSize()
        if Library.IsMobile then
            Width = math.min(Width, math.max(180, Viewport.X / Scale - 20))
            Height = math.min(Height, math.max(120, Viewport.Y / Scale - 28))
        end
        return Vector2.new(Width, Height)
    end

    local function RaiseFloat()
        if not Float or not Float.Parent then
            return
        end
        Library._FloatZCounter = (Library._FloatZCounter or 20) + 1
        if Library._FloatZCounter > 9000 then
            Library._FloatZCounter = 20
        end
        Float.ZIndex = Library._FloatZCounter
    end

    local function SyncSize()
        if SyncingSize or not Box.PoppedOut or not Float or not Holder.Parent then
            return
        end
        SyncingSize = true
        local Success = pcall(function()
            local Size = LogicalHolderSize()
            Float.Size = UDim2.fromOffset(Size.X, Size.Y)
            Holder.Size = UDim2.new(1, 0, 0, Size.Y)
            if Placeholder and Placeholder.Parent then
                Placeholder.Size = UDim2.new(1, 0, 0, Size.Y)
            end
            Float.Position = ClampPosition(Float.Position, Size)
        end)
        SyncingSize = false
        if not Success and Box.PoppedOut then
            task.defer(function()
                if Box.PoppedOut then
                    pcall(Box.SetPoppedOut, Box, false)
                end
            end)
        end
    end

    local function SyncVisible()
        if Float then
            Float.Visible = BoxHolder.Visible ~= false and Box.Visible ~= false
        end
    end

    local function MakePlaceholder(Height)
        return New("Frame", {
            Name = "PopOutPlaceholder",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, Height),
            LayoutOrder = OriginalLayoutOrder or 0,
            Active = false,
            Parent = OriginalParent or BoxHolder,
        })
    end

    Box.PopOutMaxHeight = Options.MaxHeight
    Box.PopOutWidth = Options.Width
    function Box:RefreshPopOutPlaceholder()
        if Placeholder and Placeholder.Parent then
            Placeholder.Size = UDim2.new(1, 0, 0, Holder.Size.Y.Offset)
        end
    end
    function Box:SetMaxPopOutHeight(Height)
        assert(Height == nil or (typeof(Height) == "number" and Height > 0), "Height must be positive or nil.")
        Box.PopOutMaxHeight = Height
        if Box.Resize then
            Box:Resize()
        end
        SyncSize()
        return Box
    end
    function Box:SetPopOutWidth(Width)
        assert(Width == nil or (typeof(Width) == "number" and Width > 0), "Width must be positive or nil.")
        Box.PopOutWidth = Width
        SyncSize()
        return Box
    end

    function Box:BringPopOutToFront()
        RaiseFloat()
        return Box
    end

    function Box:SetPopOutPinned(Value)
        Box.PopOutPinned = Value == true
        return Box.PopOutPinned
    end

    function Box:SetPopOutLocked(Value)
        Box.PopOutLocked = Value == true
        return Box.PopOutLocked
    end

    function Box:GetPopOutPosition()
        return Float and Float.Position or LastDockPosition
    end

    function Box:SetPopOutPosition(Position)
        if typeof(Position) ~= "UDim2" then
            return Box
        end
        LastDockPosition = Position
        if Float then
            Float.Position = ClampPosition(Position, LogicalHolderSize())
        end
        return Box
    end

    function Box:ResetPopOutPosition()
        if not Box.PoppedOut then
            return Box
        end
        local Position = Placeholder and Placeholder.AbsolutePosition or Holder.AbsolutePosition
        return Box:SetPopOutPosition(UDim2.fromOffset(Position.X, Position.Y))
    end

    function Box:CenterPopOut()
        if not Box.PoppedOut or not Float then
            return Box
        end
        local Size = LogicalHolderSize()
        local Scale = ScaleValue()
        local Viewport = ViewportSize()
        return Box:SetPopOutPosition(
            UDim2.fromOffset((Viewport.X - Size.X * Scale) * 0.5, (Viewport.Y - Size.Y * Scale) * 0.5)
        )
    end

    function Box:SetPoppedOut(Value, FloatPosition)
        if Box.Destroyed or not Box.PopOutEnabled then
            return Box
        end

        Value = Value == true
        if Box.PoppedOut == Value then
            if Value and typeof(FloatPosition) == "UDim2" then
                Box:SetPopOutPosition(FloatPosition)
            end
            return Box
        end

        if Value then
            ObsidianEnsureFloatLayers()
            if not Library.Floats or not Library.Floats.Parent then
                return Box
            end

            if Box.Resize then
                pcall(Box.Resize, Box)
            end
            if Options.Before then
                Library:SafeCallback(Options.Before)
            end

            OriginalParent = Holder.Parent
            OriginalSize = Holder.Size
            OriginalPosition = Holder.Position
            OriginalAnchorPoint = Holder.AnchorPoint
            OriginalLayoutOrder = Holder.LayoutOrder

            local AbsolutePosition = Holder.AbsolutePosition
            local Size = LogicalHolderSize()
            Placeholder = MakePlaceholder(Size.Y)
            Float = New("Frame", {
                Name = "ObsidianPopOut",
                Active = false,
                BackgroundTransparency = 1,
                ClipsDescendants = false,
                Position = UDim2.fromOffset(AbsolutePosition.X, AbsolutePosition.Y),
                Size = UDim2.fromOffset(Size.X, Size.Y),
                ZIndex = 20,
                Parent = Library.Floats,
            })
            FloatScale = New("UIScale", { Parent = Float })
            table.insert(Library.Scales, FloatScale)
            FloatScale.Scale = ScaleValue() - (tonumber(Library.ScalesOffset[FloatScale]) or 0)

            Holder.Parent = Float
            Holder.AnchorPoint = Vector2.zero
            Holder.Position = UDim2.fromOffset(0, 0)
            Holder.LayoutOrder = 0
            Holder.Size = UDim2.new(1, 0, 0, Size.Y)

            Box.PopOutFloat = Float
            Box.PopOutPlaceholder = Placeholder
            Box.PoppedOut = true

            if typeof(FloatPosition) == "UDim2" then
                Float.Position = FloatPosition
            elseif LastDockPosition then
                Float.Position = LastDockPosition
            end

            Float.Position = ClampPosition(Float.Position, Size)
            LastDockPosition = Float.Position

            if not table.find(Library.DraggableElements, Float) then
                table.insert(Library.DraggableElements, Float)
            end

            SizeConnection = Holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                task.defer(SyncSize)
            end)
            VisibilityConnection = BoxHolder:GetPropertyChangedSignal("Visible"):Connect(SyncVisible)

            SyncVisible()
            RaiseFloat()
            if Options.After then
                Library:SafeCallback(Options.After)
            end
            task.defer(SyncSize)
            return Box
        end

        if Controller.Active and Controller.Active.Owner == Box and Controller.Active.Stop then
            pcall(Controller.Active.Stop, true)
        end

        LastDockPosition = Float and Float.Position or LastDockPosition

        if SizeConnection then
            SizeConnection:Disconnect()
            SizeConnection = nil
        end
        if VisibilityConnection then
            VisibilityConnection:Disconnect()
            VisibilityConnection = nil
        end

        if Float then
            local Index = table.find(Library.DraggableElements, Float)
            if Index then
                table.remove(Library.DraggableElements, Index)
            end
        end

        if FloatScale then
            local Index = table.find(Library.Scales, FloatScale)
            if Index then
                table.remove(Library.Scales, Index)
            end
            Library.ScalesOffset[FloatScale] = nil
        end
        FloatScale = nil

        if Holder and Holder.Parent then
            Holder.Parent = OriginalParent or BoxHolder
            Holder.Size = OriginalSize or Holder.Size
            Holder.Position = OriginalPosition or UDim2.fromOffset(0, 0)
            Holder.AnchorPoint = OriginalAnchorPoint or Vector2.zero
            Holder.LayoutOrder = OriginalLayoutOrder or 0
        end

        if Placeholder then
            Placeholder:Destroy()
        end
        Placeholder = nil

        if Float then
            Float:Destroy()
        end
        Float = nil

        Box.PopOutFloat = nil
        Box.PopOutPlaceholder = nil
        Box.PoppedOut = false

        if Box.Resize then
            pcall(Box.Resize, Box)
        end
        if Options.After then
            Library:SafeCallback(Options.After)
        end
        return Box
    end

    function Box:TogglePoppedOut()
        return Box:SetPoppedOut(not Box.PoppedOut)
    end

    local function BeginDrag(Input)
        if Box.Destroyed or Box.PopOutLocked or not IsClickInput(Input) then
            return
        end

        if Controller.Active and Controller.Active.Stop then
            pcall(Controller.Active.Stop, true)
        end

        local PressMouse = Vector2.new(Input.Position.X, Input.Position.Y)
        local DragStartPosition = Float and Float.Position or nil
        local Dragging = false
        local Stopped = false
        local Active

        if Box.PoppedOut then
            RaiseFloat()
        end

        local function Stop(Cancelled)
            if Stopped then
                return
            end
            Stopped = true

            if Controller.Active == Active then
                Controller.Active = nil
            end

            if
                not Cancelled
                and Dragging
                and Box.PoppedOut
                and Float
                and not Box.PopOutPinned
                and not Box.PopOutLocked
            then
                local Center = Float.AbsolutePosition + Float.AbsoluteSize * 0.5
                if Placeholder and Placeholder.Parent and Library.Toggled then
                    local PlaceholderCenter = Placeholder.AbsolutePosition + Placeholder.AbsoluteSize * 0.5
                    if (Center - PlaceholderCenter).Magnitude <= (tonumber(Library.PopOutSnapDistance) or 80) then
                        Box:SetPoppedOut(false)
                    end
                end
            end
        end

        local function Update(ChangedInput)
            if Stopped or Box.Destroyed or Box.PopOutLocked then
                Stop(true)
                return
            end

            if
                Input.UserInputType == Enum.UserInputType.Touch
                and ChangedInput.UserInputType ~= Enum.UserInputType.Touch
            then
                return
            end
            if not IsHoverInput(ChangedInput) then
                return
            end

            local Current = Vector2.new(ChangedInput.Position.X, ChangedInput.Position.Y)
            local Delta = Current - PressMouse
            local Threshold = tonumber(Library.PopOutDragThreshold) or (Library.IsMobile and 14 or 8)

            if not Dragging then
                if Delta.Magnitude < Threshold then
                    return
                end
                Dragging = true
            end

            if not Box.PoppedOut then
                local StartAbsolute = Holder.AbsolutePosition
                Box:SetPoppedOut(true, UDim2.fromOffset(StartAbsolute.X, StartAbsolute.Y))
                if not Float then
                    Stop(true)
                    return
                end
                DragStartPosition = Float.Position
            end

            if Float and DragStartPosition then
                local Target =
                    UDim2.fromOffset(DragStartPosition.X.Offset + Delta.X, DragStartPosition.Y.Offset + Delta.Y)
                Float.Position = ClampPosition(Target, LogicalHolderSize())
                LastDockPosition = Float.Position
            end
        end

        Active = {
            Input = Input,
            Owner = Box,
            Update = Update,
            Stop = Stop,
        }
        Controller.Active = Active
    end

    HeaderConnection = Header.InputBegan:Connect(BeginDrag)
    if Box.Connections then
        table.insert(Box.Connections, HeaderConnection)
    else
        Library:GiveSignal(HeaderConnection)
    end

    if Box.Destroy and not Box._PopOutDestroyWrapped then
        local BaseDestroy = Box.Destroy
        Box.Destroy = function(Self, ...)
            if Controller.Active and Controller.Active.Owner == Self and Controller.Active.Stop then
                pcall(Controller.Active.Stop, true)
            end
            if Self.PoppedOut then
                pcall(Self.SetPoppedOut, Self, false)
            end
            return BaseDestroy(Self, ...)
        end
        Box._PopOutDestroyWrapped = true
    end

    return Box
end

local function ObsidianAddPopOutButton(Box)
    if not Box or not Box.PopOutEnabled or not Box.Holder or Box._PopOutButton then
        return
