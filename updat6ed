            table.clear(ExpandedConnections)
            for _, child in ExpandList:GetChildren() do
                if child:IsA("GuiObject") then
                    child:Destroy()
                end
            end
            table.clear(ExpandedRows)
            local dictionary = not IsSequentialArray(Dropdown.Values)
            local query = LowerText(ExpandSearch.Text or "")
            local count = 0
            for key, raw in Dropdown.Values do
                if IsDropdownDivider(raw) then
                    continue
                end
                local value = dictionary and key or raw
                local formatter = Dropdown.FormatListValue or Dropdown.FormatValue
                local text = tostring(formatter and formatter(raw) or raw)
                if query ~= "" and not TryFuzzyMatch(text, query) then
                    continue
                end
                count += 1
                local disabled = table.find(Dropdown.DisabledValues, value) ~= nil
                    or table.find(Dropdown.DisabledValues, raw) ~= nil
                local button = New("TextButton", {
                    Name = "ExpandedOption",
                    Active = not disabled,
                    BackgroundColor3 = "MainColor",
                    Text = text,
                    TextSize = 14,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    LayoutOrder = count,
                    Parent = ExpandList,
