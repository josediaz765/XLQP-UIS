        local Ball
        local BallShadow
        local BallActive = false
        if not Info.Compact then
            local InnerOutline = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundTransparency = 1,
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.new(1, -2, 1, -2),
