            ExpandSearch.Text = ""
            RebuildExpandedList()
            ExpandOverlay.Visible = true
        end

        function Dropdown:Collapse()
            Expanded = false
            if Library.ActiveExpandedDropdown == Dropdown then
                Library.ActiveExpandedDropdown = nil
