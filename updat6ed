        local function RefreshExpandedSelection()
            for _, row in ExpandedRows do
                if row.Button.Parent then
                    local selected = Info.Multi and Dropdown.Value[row.Value] == true
                        or not Info.Multi and Dropdown.Value == row.Value
                    row.Button.BackgroundColor3 = selected and Library.Scheme.AccentColor or Library.Scheme.MainColor
                    Library.Registry[row.Button].BackgroundColor3 = selected and "AccentColor" or "MainColor"
                    row.Button.TextTransparency = row.Disabled and 0.8 or selected and 0 or 0.4
                end
