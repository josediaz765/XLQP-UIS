                Library:AddOutline(button)
                table.insert(ExpandedRows, { Button = button, Value = value, Disabled = disabled })
                table.insert(
                    ExpandedConnections,
                    button.MouseButton1Click:Connect(function()
                        if Dropdown.Disabled or disabled then
