        local function SelectableEntries()
            local entries = {}
            local dictionary = not IsSequentialArray(Dropdown.Values)
            for key, raw in Dropdown.Values do
                if IsDropdownDivider(raw) then
                    continue
                end
                local value = dictionary and key or raw
                if table.find(Dropdown.DisabledValues, value) or table.find(Dropdown.DisabledValues, raw) then
                    continue
                end
                table.insert(entries, { Value = value, Raw = raw })
            end
            return entries
        end

        local function ApplyBulkSelection(selecting)
            if Dropdown.Disabled or not Info.Multi then
                return
            end
            local value = table.clone(Dropdown.Value)
            local entries = SelectableEntries()
            for _, entry in entries do
                value[entry.Value] = nil
            end
            if selecting then
                for _, entry in entries do
                    value[entry.Value] = true
                end
            elseif not Info.AllowNull and next(value) == nil and entries[1] then
                value[entries[1].Value] = true
            end
            Dropdown:SetValue(value)
        end

