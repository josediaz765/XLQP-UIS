	local function handleFeatureInspectionCommand(tabId, prompt)
		local lower = normalizeUICommand(prompt)
		local asksAll = lower:find("list em all", 1, true) or lower:find("list them all", 1, true)
			or lower:find("list every", 1, true) or lower:find("show them all", 1, true)
		local asksScan = (lower:find("ui element", 1, true) and (lower:find("search", 1, true) or lower:find("scan", 1, true) or lower:find("list", 1, true) or lower:find("how many", 1, true)))
			or lower:find("what features", 1, true) or lower:find("which features", 1, true)
			or lower:find("features does this script", 1, true) or lower:find("things inside the script", 1, true)
		if not asksAll and not asksScan then return false end
		local scan = inspectUIFeatures()
		local tabData=chatTabs[tabId]
		if not tabData then return true end
		tabData.Awaiting=true
		aiStatusLabel.Text = "AI inspecting " .. tostring(#scan.Entries) .. " features..."
		task.spawn(function()
			local systemPrompt=[[You are XLQP AI's live interface inspector. The user question is followed by a LIVE_XLQP_UI_REGISTRY produced at request time.
Use only that registry; do not use a memorized or pre-written feature list. State the exact COUNT. Explain features naturally and accurately.
If the user asks to list all, include every registry row exactly once with its visible name, type, purpose, and current value when present. Do not invent controls.]]
			local request=tostring(prompt).."\n\n"..uiInventoryForAI(scan)
			local callOk,ok,answer,provider=pcall(function() return XLQPGen1.AIService:Prompt(request,systemPrompt) end)
			if not callOk or not ok or sharedAIClean(answer)=="" then
				answer=asksAll and formatAllUIFeatures(scan) or ("The live registry currently contains "..tostring(#scan.Entries).." features. "..tostring(scan.TypeSummary or ""))
				provider="live registry fallback"
			end
			if asksAll then
				local lowerAnswer=tostring(answer):lower()
				local missing={}
				for _,entry in ipairs(scan.Entries) do
					if not lowerAnswer:find(tostring(entry.Name):lower(),1,true) then
						local current=entry.Value~=nil and (" Current: "..tostring(entry.Value)..".") or ""
						missing[#missing+1]="• "..tostring(entry.Name).." ("..tostring(entry.Type).."): "..tostring(entry.Description).."."..current
					end
				end
				if #missing>0 then answer=tostring(answer).."\n\nVerified live-registry entries the provider omitted:\n"..table.concat(missing,"\n") end
			end
			XLQPGen1._AIReplyThenRunTool(tabId,tostring(answer),function()
				addMessageToLog(tabId,"AI","Called tool: inspect_live_ui_registry")
			end)
			tabData.Awaiting=false
			aiStatusLabel.Text=(asksAll and "listed" or "inspected").." | "..tostring(#scan.Entries).." | "..tostring(provider or XLQPGen1.AIService:GetShortProvider())
		end)
		return true
	end

	local function handleLocalUIToolCommand(tabId, prompt)
		if handleFeatureInspectionCommand(tabId, prompt) then return true end
		local lower = normalizeUICommand(prompt)
		local desiredToggle
		local toggleQuery
		if lower:find("turn on", 1, true) or lower:find("switch on", 1, true) or lower:match("^enable%s+") or lower:match("^activate%s+") or lower:match("^start%s+") then
			desiredToggle = true
			toggleQuery = lower:gsub("turn%s+on", " "):gsub("switch%s+on", " "):gsub("^enable%s+", ""):gsub("^activate%s+", ""):gsub("^start%s+", "")
		elseif lower:find("turn off", 1, true) or lower:find("switch off", 1, true) or lower:match("^disable%s+") or lower:match("^deactivate%s+") or lower:match("^stop%s+") then
			desiredToggle = false
			toggleQuery = lower:gsub("turn%s+off", " "):gsub("switch%s+off", " "):gsub("^disable%s+", ""):gsub("^deactivate%s+", ""):gsub("^stop%s+", "")
		end

		if desiredToggle ~= nil then
			local element = findUIElement(toggleQuery, "Toggle")
			if not element then
				local names = listElementNames("Toggle", 7)
				local suffix = #names > 0 and (" Available toggles: " .. table.concat(names, ", ") .. ".") or ""
				addMessageToLog(tabId, "AI", "I couldn't find a toggle matching “" .. cleanElementQuery(toggleQuery) .. "”." .. suffix)
				aiStatusLabel.Text = "ready | toggle not found"
				return true
			end
			local elementName=tostring(element.Name or "Toggle")
			XLQPGen1._AIReplyThenRunTool(tabId,"I found “"..elementName.."”. I’ll turn it "..(desiredToggle and "on" or "off").." now.",function()
				local ok,err=runElementSet(element,desiredToggle)
				if ok then
					addMessageToLog(tabId,"AI","Called tool: set_ui_toggle")
					aiStatusLabel.Text="done | "..elementName
				else
					addMessageToLog(tabId,"AI","Executed tool: set_ui_toggle (failed: "..tostring(err or "unknown error")..")")
					aiStatusLabel.Text="toggle failed"
				end
			end)
			return true
		end

		local sliderQuery, sliderValue = lower:match("^set%s+(.+)%s+to%s+([%-]?[%d%.]+)%s*$")
		if not sliderQuery then sliderQuery, sliderValue = lower:match("^make%s+(.+)%s+([%-]?[%d%.]+)%s*$") end
		if not sliderQuery then sliderQuery, sliderValue = lower:match("^change%s+(.+)%s+to%s+([%-]?[%d%.]+)%s*$") end
		if sliderQuery and tonumber(sliderValue) then
			local element = findUIElement(sliderQuery, "Slider")
			if element then
				local elementName=tostring(element.Name or "Slider")
				local requestedValue=tonumber(sliderValue)
				XLQPGen1._AIReplyThenRunTool(tabId,"I found “"..elementName.."”. I’ll set it to "..tostring(requestedValue).." now.",function()
					local ok,err=runElementSet(element,requestedValue)
					if ok then
						addMessageToLog(tabId,"AI","Called tool: set_ui_slider")
						aiStatusLabel.Text="done | "..elementName
					else
						addMessageToLog(tabId,"AI","Executed tool: set_ui_slider (failed: "..tostring(err or "unknown error")..")")
					end
				end)
				return true
			end
		end

		local actionQuery = lower:match("^press%s+(.+)$") or lower:match("^click%s+(.+)$") or lower:match("^run%s+(.+)$")
		if actionQuery then
			local element = findUIElement(actionQuery, "Button")
			if element then
				local elementName=tostring(element.Name or "Button")
				XLQPGen1._AIReplyThenRunTool(tabId,"I found “"..elementName.."”. I’ll press it now.",function()
					local ok,err=runElementSet(element,true)
					if ok then addMessageToLog(tabId,"AI","Called tool: press_ui_button")
					else addMessageToLog(tabId,"AI","Executed tool: press_ui_button (failed: "..tostring(err or "unknown error")..")") end
				end)
				return true
			end
		end

		return false
	end

	local function handlePluginBuildCommand(tabId,prompt)
		local lower=tostring(prompt or ""):lower()
		local asksPlugin=lower:find("plugin",1,true)~=nil
		local asksCreate=lower:find("make",1,true) or lower:find("create",1,true) or lower:find("build",1,true) or lower:find("generate",1,true) or lower:find("write",1,true)
		if not asksPlugin or not asksCreate then return false end
		local tabData=chatTabs[tabId]
		if not tabData then return true end
		if type(XLQPGen1.CreatePluginFromSource)~="function" then
			addMessageToLog(tabId,"AI","I can build plugins after PluginsEnabled is turned on for this window.")
			return true
		end
		local requestedName=prompt:match("[Pp]lugin%s+[Cc]alled%s+['\"]?([%w%s%-%_]+)") or prompt:match("[Pp]lugin%s+[Nn]amed%s+['\"]?([%w%s%-%_]+)")
		if requestedName then requestedName=requestedName:gsub("%s+[Tt][Hh][Aa][Tt].*$",""):gsub("%s+[Tt][Oo].*$",""):gsub("^%s+",""):gsub("%s+$","") end
		requestedName=(requestedName and requestedName~="") and requestedName or ("XLQP_AI_Plugin_"..os.date("%H%M%S"))
		tabData.Awaiting=true
		aiStatusLabel.Text="building plugin..."
		task.spawn(function()
			local available=type(XLQPGen1.GetPluginTabNames)=="function" and XLQPGen1:GetPluginTabNames() or {}
			local systemPrompt=[[You are the XLQP Gen1 plugin builder. Return ONLY one complete Luau code block and no explanation.
The code MUST use this exact contract:
return function(API)
    local Tab = API.GetTab("VALID TAB NAME")
    if not Tab then return end
    API.Notify("Plugin name", "Loaded")
end
Available API: API.GetTab(name), API.ListTabs(), API.Notify(title,text), API.Library, API.XLQPGen1, API.Folder.
Use only a tab name from AVAILABLE_TABS. The Home tab is reserved and plugins must never add controls to Home or any Home child tab. Never download or execute remote code, access global environments, hook functions, delete files, or create endless loops. Never use undefined variables. The returned initializer must run without errors.]].."\nAVAILABLE_TABS: "..table.concat(available,", ")
			local source,lastError,provider
			local saved,message,path=false,"Plugin generation did not finish",nil
			for attempt=1,3 do
				local requestText=tostring(prompt)
				if attempt>1 then
					aiStatusLabel.Text="repairing plugin "..tostring(attempt-1).."/2..."
					requestText="Repair this XLQP plugin so validation and initialization succeed. Return only the corrected complete code.\nVALIDATION_ERROR: "..tostring(lastError).."\nBROKEN_CODE:\n```lua\n"..tostring(source or "").."\n```\nORIGINAL_REQUEST: "..tostring(prompt)
				end
				local callOk,ok,response,usedProvider=pcall(function() return XLQPGen1.AIService:Prompt(requestText,systemPrompt) end)
				provider=usedProvider or provider
				if not callOk or not ok then
					lastError=tostring(response or ok or "provider failed")
				else
					source=aiExtractFencedLua(response) or select(1,aiExtractRunnableLua(response,true))
					if not source or sharedAIClean(source)=="" then lastError="The provider did not return a complete Luau code block."
					else
						saved,message,path=XLQPGen1:CreatePluginFromSource(requestedName,source,true)
						if saved then break end
						lastError=tostring(message)
					end
				end
			end
			if saved then
				XLQPGen1._AIReplyThenRunTool(tabId,"Created, validated, and ran the plugin “"..requestedName.."” with "..tostring(provider or "XLQP AI")..". It is saved at "..tostring(path).." and appears in Plugins.",function()
					addMessageToLog(tabId,"AI","Called tool: create_xlqp_plugin")
					pcall(function() if XLQPGen1.OpenPlugins then XLQPGen1.OpenPlugins() end end)
				end)
			else
				XLQPGen1._AIReplyThenRunTool(tabId,"I did not save a broken plugin. Validation still failed after automatic repairs: "..tostring(lastError or message),function()
					addMessageToLog(tabId,"AI","Executed tool: create_xlqp_plugin (failed validation)")
				end)
			end
			tabData.Awaiting=false aiStatusLabel.Text=saved and "plugin ready" or "plugin rejected"
		end)
		return true
	end


	local function aiGraphemes(text)
		local output = {}
		text = tostring(text or "")
		local ok = pcall(function()
			for first, last in utf8.graphemes(text) do
				table.insert(output, text:sub(first, last))
			end
		end)
		if not ok or #output == 0 then
			for index = 1, #text do
				table.insert(output, text:sub(index, index))
			end
		end
		return output
	end

	typewriteAI=function(label, text, resizeCallback)
		if not (label and label.Parent) then return end
		local characters = aiGraphemes(text)
		local chunk = #characters > 1600 and 12 or (#characters > 900 and 8 or (#characters > 450 and 4 or 2))
		label.Text = ""
		local index = 1
		while index <= #characters and label.Parent do
			local last = math.min(#characters, index + chunk - 1)
			local parts = {}
			for i = index, last do
				parts[#parts + 1] = characters[i]
			end
			label.Text ..= table.concat(parts)
			if resizeCallback and (index % 30 == 1 or last == #characters) then
				resizeCallback(label)
			end
			index = last + 1
			task.wait(0.007)
		end
		if resizeCallback then resizeCallback(label) end
	end

