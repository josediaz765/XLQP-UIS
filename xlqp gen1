				slots[key] = {Frame=cell, Value=value, Unit=unit}
			end
			if showDays then addSlot("Days","DAYS",1) end
			addSlot("Hours","HOURS",2)
			addSlot("Minutes","MINS",3)
			addSlot("Seconds","SECS",4)
			local function render()
				local remaining = math.max(0, math.floor(Countdown.Remaining))
				local days = math.floor(remaining/86400)
				local hours = math.floor((remaining%86400)/3600)
				local minutes = math.floor((remaining%3600)/60)
				local seconds = remaining%60
				if not showDays then hours = hours + days*24 end
				if slots.Days then slots.Days.Value.Text = string.format("%02d", days) end
				slots.Hours.Value.Text = string.format("%02d", hours)
				slots.Minutes.Value.Text = string.format("%02d", minutes)
				slots.Seconds.Value.Text = string.format("%02d", seconds)
			end
			local token = 0
			local function stopLoop()
				token += 1
				if WindowConfig._LocalRegisterState.unregisterPeriodic then WindowConfig._LocalRegisterState.unregisterPeriodic(Countdown) end
			end
			local function loop()
				stopLoop()
				local current = token
				if WindowConfig._LocalRegisterState.registerPeriodic then
					WindowConfig._LocalRegisterState.registerPeriodic(Countdown,1,function()
						if not Countdown.Running or token~=current or not frame.Parent then return end
						Countdown.Remaining=math.max(0,Countdown.Remaining-1)
						if WindowConfig._LocalRegisterState.isGuiBranchVisible(frame) then render() end
						SafeCallback(CountConfig.OnTick,CountConfig.Name,Countdown.Remaining,Countdown)
						if Countdown.Remaining<=0 then
							Countdown.Running=false
							WindowConfig._LocalRegisterState.unregisterPeriodic(Countdown)
							SafeCallback(CountConfig.Callback,CountConfig.Name,Countdown)
							SafeCallback(CountConfig.OnFinished,CountConfig.Name,Countdown)
						end
					end,frame,true,false)
				else
					task.spawn(function()
						while Countdown.Running and token==current and frame.Parent do
							task.wait(1)
							if not Countdown.Running or token~=current then break end
							Countdown.Remaining=math.max(0,Countdown.Remaining-1)
							render()
							SafeCallback(CountConfig.OnTick,CountConfig.Name,Countdown.Remaining,Countdown)
							if Countdown.Remaining<=0 then
								Countdown.Running=false
								SafeCallback(CountConfig.Callback,CountConfig.Name,Countdown)
								SafeCallback(CountConfig.OnFinished,CountConfig.Name,Countdown)
								break
							end
						end
					end)
				end
			end
			function Countdown:Set(seconds)
				self.Remaining = math.max(0, tonumber(seconds) or 0)
				render()
				return self
			end
			function Countdown:Start(seconds)
				if seconds ~= nil then self:Set(seconds) end
				if self.Remaining <= 0 then return self end
				self.Running = true
				loop()
				return self
			end
			function Countdown:Pause() self.Running=false stopLoop() return self end
			function Countdown:Resume() if self.Remaining>0 then self.Running=true loop() end return self end
			function Countdown:Stop() self.Running=false stopLoop() self:Set(0) return self end
			function Countdown:Add(seconds) return self:Set(self.Remaining + (tonumber(seconds) or 0)) end
			function Countdown:GetRemaining() return self.Remaining end
			function Countdown:SetTitle(text) CountConfig.Name = tostring(text or "") title.Text = CountConfig.Name return self end
			function Countdown:SetContent(text) CountConfig.Content = tostring(text or "") desc.Text = CountConfig.Content return self end
			Countdown:Set(tonumber(CountConfig.Duration or CountConfig.Seconds or CountConfig.Time) or 0)
			if CountConfig.AutoStart ~= false and Countdown.Remaining > 0 then Countdown:Start() end
			Countdown.Wrapper = frame
			table.insert(XLQPGen1.AllElements, Countdown)
			WindowConfig._LocalRegisterState.SetupElement(CountConfig, frame, frame, Countdown)
			return Countdown
		end
