			end
			local function startWorldTagWorker()
				worldTagWorkerToken+=1
				if not state.Enabled or not frame.Parent then return end
				local token=worldTagWorkerToken
				task.spawn(function()
					while frame.Parent and state.Enabled and token==worldTagWorkerToken do
						local localRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						local players=Players:GetPlayers()
						for index=1,#players do
							if token~=worldTagWorkerToken or not state.Enabled then return end
							updateWorldTag(players[index],localRoot)
						end
						task.wait(0.35)
					end
				end)
			end
			AddConnection(toggle.Activated, function()
