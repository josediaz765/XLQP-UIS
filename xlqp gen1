		flashStroke.Parent = flash
		TweenService:Create(flash,TweenInfo.new(0.34,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{BackgroundTransparency=1}):Play()
		task.delay(0.38,function() if flash and flash.Parent then flash:Destroy() end end)
		if Reveal ~= false then
