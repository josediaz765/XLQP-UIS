	function XLQPGen1:_ResolveMediaCenterElement(kind,config)
		local center=self:_EnsureMediaCenter()
		if kind=="MediaPlayer" then
			local player=center.MediaPlayer
			if config.Volume~=nil and player.SetVolume then player:SetVolume(tonumber(config.Volume) or 0.5) end
			if config.Pitch~=nil and player.SetPitch then player:SetPitch(tonumber(config.Pitch) or 1) end
			if config.Loop~=nil and player.SetLoop then player:SetLoop(config.Loop==true) end
			if (config.AutoPlay~=nil or config.AutoPlayNext~=nil) and player.SetAutoPlay then player:SetAutoPlay((config.AutoPlay~=nil and config.AutoPlay or config.AutoPlayNext)==true) end
			if config.Preset and player.SetEffect then player:SetEffect(tostring(config.Preset)) end
			if config.Default and tostring(config.Default)~="" then
				player:SetURL(tostring(config.Default))
				if center.MusicControls and center.MusicControls.Source then center.MusicControls.Source:Set(tostring(config.Default),true)
				elseif center.MediaInput then center.MediaInput.Text=tostring(config.Default) end
			end
			if type(config.Playlist)=="table" and player.AddToPlaylist then
				for _,item in ipairs(config.Playlist) do
					local url=type(item)=="table" and (item.url or item.Url or item.URL or item.SoundId) or item
					local name=type(item)=="table" and (item.name or item.Name) or nil
					if url then player:AddToPlaylist(name or tostring(url),tostring(url)) end
				end
			end
			if center.RefreshQueue then center.RefreshQueue() end
			return player
		end
		local beat=center.Bytebeat
		if type(config.Playlist)=="table" and beat.AddPreset then
			for _,item in ipairs(config.Playlist) do
				beat:AddPreset(item)
				local itemName=tostring(item.Name or item.name or "Preset")
				local replaced=false
				for index,current in ipairs(center.BytebeatPresets or {}) do
					if tostring(current.Name or current.name)==itemName then center.BytebeatPresets[index]=item replaced=true break end
				end
				if not replaced then table.insert(center.BytebeatPresets,item) end
			end
		end
		if config.Mode and beat.Mode and beat.Mode.Set then pcall(function() beat.Mode:Set(tostring(config.Mode)) end) end
		if config.Hz and beat.Hz and beat.Hz.Set then pcall(function() beat.Hz:Set(tonumber(config.Hz),false) end) end
		if (config.Seconds or config.Duration) and beat.Seconds and beat.Seconds.Set then pcall(function() beat.Seconds:Set(tonumber(config.Seconds or config.Duration),false) end) end
		if config.Pitch and beat.Pitch and beat.Pitch.Set then pcall(function() beat.Pitch:Set(tonumber(config.Pitch),false) end) end
		if config.Speed and beat.Speed and beat.Speed.Set then pcall(function() beat.Speed:Set(tonumber(config.Speed),false) end) end
		if config.Default and beat.Code and beat.Code.Set then pcall(function() beat.Code:Set(tostring(config.Default)) end) end
		if center.BeatControls and center.BeatControls.Code then
			center.BeatControls.Code:Set(tostring(beat:Get() or config.Default or ""),true)
		elseif center.CodeBox then
			center.CodeBox.Text=tostring(beat:Get() or config.Default or "")
		end
		if center.BeatControls then
			if config.Mode and center.BeatControls.Mode then center.BeatControls.Mode:Set(tostring(config.Mode),true) end
			if config.Hz and center.BeatControls.Hz then center.BeatControls.Hz:Set(tonumber(config.Hz),true,true) end
			if (config.Seconds or config.Duration) and center.BeatControls.Duration then center.BeatControls.Duration:Set(tonumber(config.Seconds or config.Duration),true,true) end
			if config.Pitch and center.BeatControls.Pitch then center.BeatControls.Pitch:Set(tonumber(config.Pitch),true,true) end
			if config.Speed and center.BeatControls.Speed then center.BeatControls.Speed:Set(tonumber(config.Speed),true,true) end
		end
		if center.RefreshBytebeat then center.RefreshBytebeat() end
		return beat
	end

