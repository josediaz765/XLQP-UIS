			end
			function Cooldown:Start(duration)
				self:Cancel(true)
				self.Duration=math.max(0.1,tonumber(duration) or self.Duration or CooldownConfig.Duration)
				self.CoolingDown=true self.Value=true self.Remaining=self.Duration
				cooldownToken+=1
				local token=cooldownToken
				self:_EmitChanged(true,self.Remaining)
				task.spawn(function()
					local started=os.clock()
					while token==cooldownToken and frame.Parent do
						local elapsed=os.clock()-started
						self.Remaining=math.max(0,self.Duration-elapsed)
						local percent=math.clamp(self.Remaining/self.Duration,0,1)
						fill.Size=UDim2.new(percent,0,1,0)
						label.Text=string.format("%s  %.1fs",tostring(CooldownConfig.CooldownText or "Wait"),self.Remaining)
						if self.Remaining<=0 then break end
						RunService.Heartbeat:Wait()
					end
					if token~=cooldownToken then return end
					self.CoolingDown=false self.Value=false self.Remaining=0
					fill.Size=UDim2.new(0,0,1,0) label.Text=CooldownConfig.ButtonText
					self:_EmitChanged(false,0)
