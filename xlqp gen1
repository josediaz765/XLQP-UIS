   AddConnection(RunService.Stepped,function()
       local noclipEnabled = playerActionStates.noclip
       local flingEnabled = playerActionStates.walkflinging
       local active = noclipEnabled or flingEnabled
       if not active and not lastNoclipState then return end
       if os.clock() - lastNoclipSweep < (active and 0.35 or 0.1) then return end
       lastNoclipSweep = os.clock()
       lastNoclipState = active
       local character = homeLocalPlayer.Character
       if not character then
           return
       end
       for _, part in ipairs(character:GetDescendants()) do
           if part:IsA("BasePart") then
               if active and noclipDefaults[part] == nil then
                   noclipDefaults[part] = part.CanCollide
               end
               if active and part.CanCollide then
                   part.CanCollide = false
               elseif noclipDefaults[part] ~= nil then
                   part.CanCollide = noclipDefaults[part]
                   noclipDefaults[part] = nil
               end
           end
       end
       if not active then lastNoclipState = false end
   end)

