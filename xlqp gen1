	Create("UICorner",{CornerRadius=UDim.new(0,2),Parent=sidebarOuter})
	local sidebarBorder=AddThemeObject(Create("UIStroke",{Thickness=1.4,Transparency=.08,LineJoinMode=Enum.LineJoinMode.Round,Parent=sidebarOuter}),"TextDark")
