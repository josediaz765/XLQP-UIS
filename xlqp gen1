			local function requestJson(url)
				local ok,body=pcall(function() return game:HttpGet(url) end)
				if not ok or type(body)~="string" then return nil end
				local decoded
				pcall(function() decoded=HttpService:JSONDecode(body) end)
				return decoded
			end
			local gameIconResolved={}
			local gameIconWaiters={}
			local function applyGameIcon(image,asset)
				if image and image.Parent then pcall(function() image.Image=asset end) end
			end
			local function setThumbnail(image,placeId,universeId)
				placeId=tonumber(placeId)
				if not image or not placeId then return end
				local key=tostring(placeId)
				if gameIconResolved[key] then applyGameIcon(image,gameIconResolved[key]) return end
				XLQPSetSecureAsset(image,"Image","rbxthumb://type=GameIcon&id="..key.."&w=512&h=512",true)
				if gameIconWaiters[key] then table.insert(gameIconWaiters[key],image) return end
				gameIconWaiters[key]={image}
				task.spawn(function()
					local asset
					local universe=tonumber(universeId)
					if not universe then
						local data=requestJson("https://apis.roblox.com/universes/v1/places/"..key.."/universe")
						universe=data and tonumber(data.universeId)
					end
					local endpoint=universe
						and ("https://thumbnails.roblox.com/v1/games/icons?universeIds="..tostring(universe).."&returnPolicy=PlaceHolder&size=512x512&format=Png&isCircular=false")
						or ("https://thumbnails.roblox.com/v1/places/gameicons?placeIds="..key.."&returnPolicy=PlaceHolder&size=512x512&format=Png&isCircular=false")
					local meta=requestJson(endpoint)
					local entry=meta and meta.data and meta.data[1]
					local imageUrl=entry and entry.imageUrl
					if imageUrl and imageUrl~="" and XLQPGetCustomAsset and writefile and XLQPPrepareSecureFolder() then
						local path=XLQPSecureCacheFolder.."/gameicon_"..key..".png"
						local ready=isfile and isfile(path)
						if not ready then
							local body=XLQPSecureHttpGet(imageUrl)
							if XLQPIsImageBody(body) then ready=pcall(writefile,path,body) end
						end
						if ready then
							local ok,result=pcall(XLQPGetCustomAsset,path)
							if ok and result then asset=result end
						end
					end
					if asset then
						gameIconResolved[key]=asset
						for _,target in ipairs(gameIconWaiters[key] or {}) do applyGameIcon(target,asset) end
					end
					gameIconWaiters[key]=nil
				end)
			end
			local function getQueueFunction()
				if type(queue_on_teleport)=="function" then return queue_on_teleport end
				if syn and type(syn.queue_on_teleport)=="function" then return syn.queue_on_teleport end
				if fluxus and type(fluxus.queue_on_teleport)=="function" then return fluxus.queue_on_teleport end
				return nil
			end
			local function getAutoExecuteSource()
				local source=SessionConfig.AutoExecuteSource or SessionConfig.ReExecuteSource or SessionConfig.QueueSource
				if (not source or tostring(source)=="") and getgenv then
					local env=getgenv()
					source=env.XLQP_AUTO_REEXECUTE_SOURCE or env.XLQP_REEXECUTE_SOURCE
				end
				source=tostring(source or "")
				if source~="" then return source end
				local url=SessionConfig.AutoExecuteUrl or SessionConfig.ReExecuteUrl or SessionConfig.SourceUrl
				if (not url or tostring(url)=="") and getgenv then
					url=getgenv().XLQPSourceUrl
				end
				url=tostring(url or "")
				if url~="" then return "loadstring(game:HttpGet("..string.format("%q",url).."))()" end
				return ""
			end
			local function queueAutoExecute(reason)
				if not autoExecuteEnabled then return false end
				local source=getAutoExecuteSource()
				if source=="" then return false end
				local queued=false
				local queue=getQueueFunction()
				if queue then
					queued=pcall(function() queue(source) end) or queued
				end
				if writefile and (SessionConfig.AutoExecFile==true or SessionConfig.AutoExecuteFile==true) then
					local folder=tostring(SessionConfig.AutoExecFolder or "autoexec")
					local file=folder.."/"..tostring(SessionConfig.AutoExecName or "XLQPGen1_AutoReexecute.lua")
					pcall(function() if makefolder and (not isfolder or not isfolder(folder)) then makefolder(folder) end end)
					queued=pcall(function() writefile(file,source) end) or queued
				end
				if queued then
					notify("Auto execute queued",tostring(reason or "Teleport").." will re-run the script.","refresh-cw")
				end
				return queued
			end
			local function saveHistory()
				if not writefile then return end
				pcall(function() if makefolder and (not isfolder or not isfolder("XLQPGen1")) then makefolder("XLQPGen1") end end)
				pcall(function() writefile(historyPath,HttpService:JSONEncode(Session.History)) end)
