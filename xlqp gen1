	function Tool:GetParent()
		return XLQPGetGuiParent()
	end
	function Tool:ResolvePath(Path)
		Path=tostring(Path or self.Path or "workspace"):gsub("^game%.","")
		if Path=="" then return workspace end
		local Lower=Path:lower()
		if Lower=="workspace" then return workspace end
		if Lower=="players" then return Services.Players end
		if Lower=="player" or Lower=="localplayer" then return Services.Players.LocalPlayer end
		local Current
		for Segment in Path:gmatch("[^%.]+") do
			if not Current then
				local S=Segment:lower()
				if S=="workspace" then Current=workspace
				elseif S=="players" then Current=Services.Players
				elseif S=="player" or S=="localplayer" then Current=Services.Players.LocalPlayer
				else Current=game:FindFirstChild(Segment) or workspace:FindFirstChild(Segment) end
			elseif Segment=="Character" and Current==Services.Players.LocalPlayer then
				Current=Services.Players.LocalPlayer.Character
			elseif Segment=="PlayerGui" and Current==Services.Players.LocalPlayer then
				Current=Services.Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
			else
				Current=Current:FindFirstChild(Segment)
			end
			if not Current then return workspace end
		end
		return typeof(Current)=="Instance" and Current or workspace
	end
	function Tool:Snap(Position)
		if self.Grid<=0 then return Position end
		return Vector3.new(math.floor(Position.X/self.Grid+0.5)*self.Grid,math.floor(Position.Y/self.Grid+0.5)*self.Grid,math.floor(Position.Z/self.Grid+0.5)*self.Grid)
	end
	function Tool:Pointer(Input)
		if Input and Input.Position then return Vector2.new(Input.Position.X,Input.Position.Y) end
		return Services.UserInput:GetMouseLocation()
	end
	function Tool:Ray(Input)
		local Camera=workspace.CurrentCamera
		if not Camera then return nil end
		local Point=self:Pointer(Input)
		local Ray=Camera:ViewportPointToRay(Point.X,Point.Y)
		local Params=RaycastParams.new()
		pcall(function() Params.FilterType=Enum.RaycastFilterType.Exclude end)
		pcall(function() Params.FilterType=Enum.RaycastFilterType.Blacklist end)
		Params.FilterDescendantsInstances={self.GizmoFolder}
		local Hit=workspace:Raycast(Ray.Origin,Ray.Direction*900,Params)
		return Hit,Hit and Hit.Position or (Ray.Origin+Ray.Direction*28)
	end
	function Tool:MakeAxisPart(Name,Color,Size,ClassName)
		local Part=Instance.new(ClassName or "Part")
		Part.Name=Name
		Part.Anchored=true
		Part.CanCollide=false
		Part.CanQuery=false
		Part.Material=Enum.Material.Neon
		Part.Color=Color
		Part.Size=Size
		Part.Transparency=1
		Part.Parent=self.GizmoFolder
		self.Axis[#self.Axis+1]=Part
		return Part
	end
	function Tool:MakeGizmo()
		if self.GizmoFolder then return end
		self.GizmoFolder=Instance.new("Folder")
		self.GizmoFolder.Name=XLQPNames["XLQPGen1StudioToolGizmo"]
		self.GizmoFolder.Parent=workspace
		self.Axis={}
		self.AxisData={}
		for _,Data in ipairs({{"X",Color3.fromRGB(255,55,55)},{"Y",Color3.fromRGB(70,255,90)},{"Z",Color3.fromRGB(70,105,255)}}) do
			local Shaft=self:MakeAxisPart("StudioAxis_"..Data[1],Data[2],Vector3.new(5.4,0.14,0.14))
			local Tip=self:MakeAxisPart("StudioAxisTip_"..Data[1],Data[2],Vector3.new(1.05,0.82,0.82),"WedgePart")
			local Hitbox=self:MakeAxisPart("StudioAxisHit_"..Data[1],Data[2],Vector3.new(6.8,1.1,1.1))
			Hitbox.Transparency=1
			self.AxisData[Data[1]]={Shaft=Shaft,Tip=Tip,Hitbox=Hitbox}
			self.AxisData[Shaft]=Data[1]
			self.AxisData[Tip]=Data[1]
			self.AxisData[Hitbox]=Data[1]
		end
		self.Selection=Instance.new("SelectionBox")
		self.Selection.Name="StudioToolSelection"
		self.Selection.LineThickness=0.045
		self.Selection.Color3=Color3.fromRGB(0,170,255)
		self.Selection.SurfaceTransparency=1
		self.Selection.Parent=self.GizmoFolder
	end
	function Tool:UpdateGizmo()
		if not self.Axis then return end
		local show=self.Value==true and self.Selected~=nil and self.Selected.Parent~=nil
		for _,Part in ipairs(self.Axis) do
			if Part.Name:find("Hit") then
				Part.Transparency=1
			else
				Part.Transparency=show and 0.08 or 1
			end
			Part.CanQuery=show
		end
		if self.Selection then self.Selection.Adornee=show and self.Selected or nil end
		if not show then return end
		local Base=self.Selected.CFrame
		local Layout={
			X={CFrame=CFrame.new(3.4,0,0),Tip=CFrame.new(6.35,0,0)*CFrame.Angles(0,0,math.rad(-90))},
			Y={CFrame=CFrame.new(0,3.4,0)*CFrame.Angles(0,0,math.rad(90)),Tip=CFrame.new(0,6.35,0)},
			Z={CFrame=CFrame.new(0,0,3.4)*CFrame.Angles(0,math.rad(90),0),Tip=CFrame.new(0,0,6.35)*CFrame.Angles(math.rad(90),0,0)}
		}
		for Name,Data in pairs(Layout) do
			local Set=self.AxisData[Name]
			if Set then
				Set.Shaft.CFrame=Base*Data.CFrame
				Set.Hitbox.CFrame=Base*Data.CFrame
				Set.Tip.CFrame=Base*Data.Tip
			end
		end
	end
	function Tool:Select(Part)
		if typeof(Part)=="Instance" and Part:IsA("BasePart") then
			self.Selected=Part
			self:MakeGizmo()
			self:UpdateGizmo()
			SafeCallback(ToolConfig.Callback,ToolConfig.Name or "Studio Tool",Part,self)
		end
	end
	function Tool:Spawn(Position)
		local Part
		if self.PartType=="Wedge" then
			Part=Instance.new("WedgePart")
		elseif self.PartType=="CornerWedge" then
			Part=Instance.new("CornerWedgePart")
		else
			Part=Instance.new("Part")
			if self.PartType=="Ball" then Part.Shape=Enum.PartType.Ball end
			if self.PartType=="Cylinder" then Part.Shape=Enum.PartType.Cylinder end
		end
		Part.Name=ToolConfig.PartName or "StudioToolPart"
		Part.Size=Vector3.new(self.PartSize,self.PartSize,self.PartSize)
		Part.Anchored=self.Anchored
		Part.CanCollide=self.CanCollide
		Part.Material=Enum.Material.SmoothPlastic
		Part.Color=self.Color
		local _,RayPosition=self:Ray()
		Part.CFrame=CFrame.new(self:Snap(Position or RayPosition or Vector3.new(0,8,0)))
		local Parent=self:ResolvePath()
		local ok=pcall(function() Part.Parent=Parent end)
		if not ok or not Part.Parent then Part.Parent=workspace end
		if self.PartType=="Mesh" and self.MeshId~="" then
			local Mesh=Instance.new("SpecialMesh")
