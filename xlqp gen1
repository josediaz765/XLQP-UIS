				Size = UDim2.new(1, -24, 0, 44),
				Position = UDim2.new(0, 12, 0, 52),
				Parent = frame
			}), {
				Create("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,7), HorizontalAlignment=Enum.HorizontalAlignment.Left, VerticalAlignment=Enum.VerticalAlignment.Center})
			})
			local function addSlot(key, label, order)
				local cell = AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(255,255,255), 0, 9), {
					Name = key,
					Size = UDim2.new(0, 62, 0, 44),
					LayoutOrder = order,
					Parent = slotHolder
				}), {AddThemeObject(MakeElement("Stroke"), "Stroke")}), "Main")
				local value = AddThemeObject(SetProps(MakeElement("Label", "00", 17), {
					Name = "Value",
					Size = UDim2.new(1, 0, 0, 22),
					Position = UDim2.new(0, 0, 0, 4),
					Font = Enum.Font.GothamBlack,
