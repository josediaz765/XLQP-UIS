		local pagesHost=Create("Frame",{Name="MiniTabPages",Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,LayoutOrder=2,BackgroundTransparency=1,Parent=root})
		local tabs={Root=root,Header=header,PagesHost=pagesHost,Pages={},Buttons={},Selected=nil}
		local count=math.max(1,#names)
		for index,name in ipairs(names) do
			name=tostring(name)
			local page=Create("Frame",{Name=name.."Page",Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Visible=false,Parent=pagesHost})
