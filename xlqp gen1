function XLQPGen1:SetScaleEngine(value)
	self.ScaleEngineEnabled=value~=false
	WindowConfig.ScaleEngine=self.ScaleEngineEnabled
	if self.UpdateScaleEngine then self:UpdateScaleEngine() end
	return self.ScaleEngineEnabled
end
function XLQPGen1:GetScaleEngine()
	return self.ScaleEngineEnabled~=false
end
function XLQPGen1:UpdateScaleEngine()
	local scale=1
	if self.ScaleEngineEnabled~=false and UserInputService.TouchEnabled and WindowConfig.AdaptiveSizing~=true then
		local cam=workspace.CurrentCamera
		local vp=cam and cam.ViewportSize or Vector2.new(1280,720)
		local w=math.max(1,WindowConfig.Size and WindowConfig.Size.X.Offset or 860)
		local h=math.max(1,WindowConfig.Size and WindowConfig.Size.Y.Offset or 560)
		scale=math.clamp(math.min((vp.X-18)/w,(vp.Y-18)/h,1),0.62,1)
	end
	local setupScale=math.clamp(tonumber(self._SetupInterfaceScale or WindowConfig.InterfaceScale) or 1,0.78,1.22)
	if MainWindowScale then MainWindowScale.Scale=scale*setupScale end
	local settingScale=1
	if self.ScaleEngineEnabled~=false and UserInputService.TouchEnabled and WindowConfig.AdaptiveSizing~=true then
		local cam=workspace.CurrentCamera
		local vp=cam and cam.ViewportSize or Vector2.new(1280,720)
		local w=math.max(1,originalSettingsSize and originalSettingsSize.X.Offset or 620)
		local h=math.max(1,originalSettingsSize and originalSettingsSize.Y.Offset or 460)
		settingScale=math.clamp(math.min((vp.X-18)/w,(vp.Y-18)/h,1),0.62,1)
	end
	if SettingsWindowScale then SettingsWindowScale.Scale=settingScale*setupScale end
end
local function queueScaleEngineRefresh()
	task.defer(function() if XLQPGen1.UpdateScaleEngine then XLQPGen1:UpdateScaleEngine() end end)
