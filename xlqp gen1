		local function truncateText(text, maxWords)
			local words = {}
			for word in text:gmatch("%S+") do table.insert(words, word) end
			if #words > maxWords then
				return table.concat(words, " ", 1, maxWords) .. "...", true
			end
			return text, false
		end
		
