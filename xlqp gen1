			Name="English",Position=UDim2.new(0,42,0,28),Size=UDim2.new(1,-52,0,16),BackgroundTransparency=1,
			Text=code==autoCode and "Your Roblox language" or tostring(translatorLanguageNames[code] or code),
			TextColor3=darkText,TextSize=11,Font=Enum.Font.Gotham,
			TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=6,Parent=frame
		})
		local click=Create("TextButton",{Size=UDim2.fromScale(1,1),Text="",BackgroundTransparency=1,AutoButtonColor=false,ZIndex=8,Parent=frame})
		cards[code]={Frame=frame,Stroke=stroke,Native=native}
		click.Activated:Connect(function()
			selected=code
			refreshCards()
		end)
	end

	addLanguage(autoCode)
	for _,code in ipairs(XLQPGen1.LanguageOrder) do
		if code~=autoCode then addLanguage(code) end
	end
	refreshCards()

	local submit=Create("TextButton",{
		Name="Submit",AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-16),Size=UDim2.new(1,-36,0,42),
		BackgroundColor3=accent,BackgroundTransparency=1,BorderSizePixel=0,AutoButtonColor=false,Text="",ZIndex=6,Parent=card
	},{Create("UICorner",{CornerRadius=UDim.new(0,13)})})
	track(submit,"BackgroundTransparency",0)
	local submitLabel=Create("TextLabel",{
		Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=tostring(LanguageConfig.ButtonText or "Continue"),
		TextColor3=Color3.fromRGB(255,255,255),TextSize=14,Font=Enum.Font.GothamBold,ZIndex=7,Parent=submit
	})
	track(submitLabel,"TextTransparency",0)

	submit.Activated:Connect(function()
		if finished then return end
		finished=true
		result=selected
		XLQPGen1:SaveLanguage(selected)
		XLQPGen1._SelectedLanguage=selected
		TweenService:Create(shade,TweenInfo.new(0.2),{BackgroundTransparency=1}):Play()
		TweenService:Create(cardScale,TweenInfo.new(0.24,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Scale=0.94}):Play()
		for _,entry in ipairs(fades) do
			if entry.Object.Parent then TweenService:Create(entry.Object,TweenInfo.new(0.18),{[entry.Property]=1}):Play() end
		end
		task.delay(0.28,function() if gui and gui.Parent then gui:Destroy() end end)
	end)
	submit.MouseEnter:Connect(function() TweenService:Create(submit,TweenInfo.new(0.14),{BackgroundColor3=accent:Lerp(Color3.new(1,1,1),0.16)}):Play() end)
	submit.MouseLeave:Connect(function() TweenService:Create(submit,TweenInfo.new(0.18),{BackgroundColor3=accent}):Play() end)

	TweenService:Create(shade,TweenInfo.new(0.25),{BackgroundTransparency=0.35}):Play()
	TweenService:Create(cardScale,TweenInfo.new(0.36,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
	for _,entry in ipairs(fades) do
		TweenService:Create(entry.Object,TweenInfo.new(0.3,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{[entry.Property]=entry.Value}):Play()
	end

	local timeout=tonumber(LanguageConfig.Timeout)
	local started=os.clock()
	while not finished do
		if timeout and os.clock()-started>timeout then
			finished=true
			result=selected
			XLQPGen1:SaveLanguage(selected)
			if gui and gui.Parent then gui:Destroy() end
			break
		end
		task.wait(0.05)
	end

	XLQPGen1._PendingLanguage=result
	return result,true
end

