	local function readableElementValue(element)
		local value = element and element.Value
		if value == nil and element and type(element.Get) == "function" then
			pcall(function() value = element:Get() end)
		end
		if value == nil then return nil end
		if typeof and typeof(value) == "EnumItem" then return value.Name end
		if type(value) == "table" then
			local parts = {}
			for _, item in ipairs(value) do parts[#parts + 1] = tostring(item) end
			return #parts > 0 and table.concat(parts, ", ") or nil
		end
		local text = tostring(value)
		return #text > 80 and (text:sub(1, 77) .. "...") or text
	end

	local function elementDescription(element)
		local explicit = element and (element.Description or element.Desc or element.Content)
		if explicit and tostring(explicit) ~= "" then return tostring(explicit) end
		local name = normalizeUICommand(element and element.Name or "")
		if element and element.Wrapper and element.Wrapper.Parent then
			for _, object in ipairs(element.Wrapper:GetDescendants()) do
				if object:IsA("TextLabel") then
					local text = tostring(object.Text or ""):gsub("<.->", ""):gsub("%s+", " ")
					local normalized = normalizeUICommand(text)
					if #text >= 8 and #text <= 180 and normalized ~= "" and normalized ~= name and not normalized:find(name, 1, true) then
						return text
					end
				end
			end
		end
		return featureTypeHelp[tostring(element and element.Type or "")] or "registered XLQP UI feature"
	end

	local function inspectUIFeatures()
		local entries, seen, counts = {}, {}, {}
		for index, element in ipairs(XLQPGen1.AllElements or {}) do
			if type(element) == "table" and element.Wrapper and element.Wrapper.Parent then
				local name = tostring(element.Name or element.Title or ("Unnamed feature " .. index))
				local kind = tostring(element.Type or "Element")
				local identity = normalizeUICommand(name) .. "\0" .. normalizeUICommand(kind) .. "\0" .. tostring(element.Wrapper)
				if not seen[identity] then
					seen[identity] = true
					counts[kind] = (counts[kind] or 0) + 1
					entries[#entries + 1] = {
						Name = name, Type = kind, Description = elementDescription(element),
						Value = readableElementValue(element), Visible = elementVisible(element)
					}
				end
			end
		end
		table.sort(entries, function(a, b)
			if a.Type == b.Type then return a.Name:lower() < b.Name:lower() end
			return a.Type:lower() < b.Type:lower()
		end)
		local typeParts = {}
		for kind, amount in pairs(counts) do typeParts[#typeParts + 1] = tostring(amount) .. " " .. kind .. (amount == 1 and "" or "s") end
		table.sort(typeParts)
		lastUIInspection = {Entries = entries, Counts = counts, TypeSummary = table.concat(typeParts, ", "), ScannedAt = os.clock()}
		return lastUIInspection
	end

	local function formatAllUIFeatures(scan)
		local lines = {"Here are all " .. tostring(#scan.Entries) .. " registered UI features I found:"}
		for index, entry in ipairs(scan.Entries) do
			local current = entry.Value ~= nil and (" Current: " .. tostring(entry.Value) .. ".") or ""
			lines[#lines + 1] = tostring(index) .. ". " .. entry.Name .. " (" .. entry.Type .. "): " .. entry.Description .. "." .. current
		end
		return table.concat(lines, "\n")
	end
	local function uiInventoryForAI(scan)
		local lines={"LIVE_XLQP_UI_REGISTRY", "COUNT="..tostring(#scan.Entries), "TYPE_SUMMARY="..tostring(scan.TypeSummary or "")}
		for index,entry in ipairs(scan.Entries) do
			local description=tostring(entry.Description or ""):gsub("[\r\n]+"," "):sub(1,180)
			local value=entry.Value~=nil and tostring(entry.Value):gsub("[\r\n]+"," "):sub(1,100) or "<none>"
			lines[#lines+1]=table.concat({tostring(index),tostring(entry.Type),tostring(entry.Name),description,value,entry.Visible and "visible" or "hidden"}," | ")
		end
		return table.concat(lines,"\n")
	end

