	function Chat:Refresh(force)
		if not self.Loaded or not self.API then return end
		if self.Refreshing then
			if force then self.QueuedRefresh=true end
			return
		end
		self.Refreshing=true
		local changed=force==true
		if self.Tab=="global" or force then
			local ok,rows=pcall(function()
				local limit=tonumber(ChatConfig.Limit) or 50
				return self:FetchAPIRows({"getGlobalMessages","getMessages","fetchGlobalMessages"},limit,player.UserId) or self:FetchAPIRows({"getGlobalMessages","getMessages","fetchGlobalMessages"},limit) or self.GlobalCache or {}
			end)
			if ok and type(rows)=="table" then
				rows=self:ListRows(rows)
				local k=keyRows(rows)
				if force or k~=self.GlobalKey then
					local old=self.GlobalKey
					self.GlobalCache=rows
					self.GlobalKey=k
					changed=true
					if old~="" and k~=old and not self.Settings.MuteGlobal then self:Notify("Global Chat","New global chat message","message-circle") end
				end
			elseif not ok then status.Text=#(self.GlobalCache or {})>0 and "Using cached messages" or "Global error" end
		end
		if self.Target and (self.Tab=="dm" or force) then
			local ok,rows=pcall(function()
				if self.Target==self.SystemId then
					local sysRows=self:FetchAPIRows({"getSystemMessages","getVhSystemMessages","getVHSystemMessages","getBotMessages","getDirectMessages","getDmMessages","getDMs","getPrivateMessages"},player.UserId,self.Target,tonumber(ChatConfig.Limit) or 50)
					if type(sysRows)=="table" then return sysRows end
				end
				return self:FetchAPIRows({"getDirectMessages","getDmMessages","getDMMessages","getDMs","getPrivateMessages","getUserMessages","getConversationMessages"},player.UserId,self.Target,tonumber(ChatConfig.Limit) or 50) or self.DMCache or {}
			end)
			if ok and type(rows)=="table" then
				rows=self:NormalizeDMRows(rows)
				local k=keyRows(rows)
				if force or k~=self.DMKey then
					local old=self.DMKey
					self.DMCache=rows
					self.DMKey=k
					changed=true
					dmLast=rows[#rows]
					if dmLast then self:RememberDM(self.Target,self.TargetName,self.TargetThumb,dmLast.content or dmLast.message or "") end
					if old~="" and k~=old and not self.Settings.MuteDMs then self:Notify("Global Chat DM","New DM from "..tostring(self.TargetName or "someone"),"message-circle") end
				end
			elseif not ok then status.Text=#(self.DMCache or {})>0 and "Using cached DMs" or "DM error" end
		end
		if self.Tab=="dm" and not self.Target then
			self:RefreshDMList()
			changed=true
		end
		if changed then
			local drawOk=pcall(updateTabs)
			if not drawOk then status.Text="Chat render error" end
		end
		self.Refreshing=false
		if self.QueuedRefresh then
			self.QueuedRefresh=false
			task.defer(function()
				if Chat and Chat.Wrapper and Chat.Wrapper.Parent then Chat:Refresh(true) end
			end)
		end
	end
	function Chat:Report(userId,name,message)
		if self.Reporting or not self.API then return end
		self.PendingReport={UserId=userId,Name=name,Message=message}
		reportReason.Text=""
		reportPanel.Visible=true
	end
	function Chat:SubmitReport()
		if self.Reporting or not self.API or type(self.PendingReport)~="table" then return end
		if os.clock()-(self.LastReport or 0)<ChatConfig.ReportCooldown then
			status.Text="Report cooldown"
			return
		end
		self.Reporting=true
		self.LastReport=os.clock()
		status.Text="Reporting..."
		reportPanel.Visible=false
		local pending=self.PendingReport
		local reason=cleanText(reportReason.Text)
		if reason=="" then reason=tostring(pending.Message or "No reason") end
		task.spawn(function()
			local targetId=tonumber(pending.UserId) or tostring(pending.UserId or "")
			local targetName=tostring(pending.Name or "Unknown")
			local ok,result,method=self:CallAPI({"reportPlayer","submitReport","sendReport","reportUser","reportMessage","createReport"},player.Name,player.DisplayName,player.UserId,targetName,targetName,targetId,reason,tostring(pending.Message or ""))
			local success=ok and result~=false
			if type(result)=="table" then
				if result.success==false or result.ok==false or result.status=="error" or result.error then success=false end
				if result.success==true or result.ok==true or result.status=="ok" or result.status=="success" then success=true end
			end
			self.Reporting=false
			status.Text=success and "Report sent" or "Report could not send"
			if not success and not method then status.Text="Report method missing" end
			pcall(function()
				XLQPGen1:MakeNotification({Name="Global Chat",Content=status.Text,Image=success and "shield-check" or "triangle-alert",Pos=ChatConfig.NotifyPos,Time=4})
			end)
		end)
	end
	function Chat:Send()
		if self.Sending or not self.API then return end
		if not self.DisclaimerAccepted then
			disclaimerOverlay.Visible=true
			status.Text="Accept the Global Chat disclaimer first"
			return
		end
		local text=cleanText(inputBox.Text)
		if text=="" then return end
		local now=os.clock()
		local stamp=tostring(self.Tab).."|"..tostring(self.Target or "global").."|"..text
		if self.LastSendStamp==stamp and now-(self.LastSendStampTime or 0)<3 then status.Text="Already sent" return end
		if now-(self.LastSend or 0)<ChatConfig.SendCooldown then status.Text="Slow down" return end
		self.Sending=true
		self.LastSend=now
		self.LastSendStamp=stamp
		self.LastSendStampTime=now
		inputBox.Text=""
		status.Text="Sending..."
		pcall(function()
			TweenService:Create(sendScale,TweenInfo.new(0.08,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=0.92}):Play()
			task.delay(0.08,function() pcall(function() TweenService:Create(sendScale,TweenInfo.new(0.16,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play() end) end)
		end)
		task.spawn(function()
			local ok,result
			if self.Tab=="global" then
				local profile=XLQPGen1.DiscordAuthProfile or {}
				ok,result=self:CallAPI({"sendGlobalMessage","sendGlobal","postGlobalMessage"},player.Name,player.DisplayName,player.UserId,profile.avatarAsset or profile.avatar or getThumbnail(player.UserId),text)
			elseif self.Target and self.Target~=self.SystemId then
				local profile=XLQPGen1.DiscordAuthProfile or {}
				ok,result=self:CallAPI({"sendDirectMessage","sendDmMessage","sendDM","sendPrivateMessage","sendUserMessage"},player.UserId,player.Name,player.DisplayName,profile.avatarAsset or profile.avatar or getThumbnail(player.UserId),self.Target,self.TargetName,self.TargetName,self.TargetThumb,text)
				if ok and result~=false then self:RememberDM(self.Target,self.TargetName,self.TargetThumb,text) end
			else
				ok=false
			end
			self.Sending=false
			local success=ok and result~=false
			if not success then self.LastSendStamp="" end
			status.Text=success and "Sent" or "Send failed"
			sendButton.BackgroundTransparency=success and 0.04 or 0.2
			self.StickToBottom=true
			self:Refresh(true)
		end)
	end
	function Chat:BackToDMList()
		self.Target=nil
		self.TargetName=""
		self.TargetThumb=""
		self.DMCache={}
		self.DMKey=""
		self.Tab="dm"
