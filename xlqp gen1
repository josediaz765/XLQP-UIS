local destroyBeforeCompatibility = XLQPGen1.Destroy
function XLQPGen1:Destroy()
	if self._Destroyed then return end
	for _,entry in pairs(self._WindowSizeProxies or {}) do
		if entry and entry.Proxy then pcall(function() entry.Proxy:Destroy() end) end
	end
	self._WindowSizeProxies=nil
	if self.KeybindFrame and self.KeybindFrame.Parent then pcall(function() self.KeybindFrame:Destroy() end) end
	local panels={}
	for _,panel in pairs(self.Panels or {}) do panels[#panels+1]=panel end
	for _,panel in ipairs(panels) do if panel and panel.Destroy then pcall(function() panel:Destroy() end) end end
	if destroyBeforeCompatibility then
		destroyBeforeCompatibility(self)
	else
		self._Destroyed = true
		for _, connection in ipairs(self.Connections or {}) do
			pcall(function() if connection then connection:Disconnect() end end)
		end
		if type(self._WindowDestructor) == "function" and not self._RunningDestructor then
			self._RunningDestructor = true
			pcall(self._WindowDestructor)
			self._RunningDestructor = false
		end
		if XLQPGen1Gui and XLQPGen1Gui.Parent then pcall(function() XLQPGen1Gui:Destroy() end) end
	end
end

function XLQPGen1:FullUnload()
	if self._FullUnloaded then return self end
	self._FullUnloaded = true
	self._StartupBlocked = true
	self._GateActive = false
	self._PendingInit = false
	if self._DestroyBetaButtonsList then pcall(function() self:_DestroyBetaButtonsList() end) end
	if self._StopUIBuildWatcher then pcall(function() self:_StopUIBuildWatcher() end) end
	local labels = {}
	for _, label in ipairs(self._floatingLabels or {}) do labels[#labels + 1] = label end
	for _, label in ipairs(labels) do
		if type(label) == "table" and type(label.Destroy) == "function" then pcall(function() label:Destroy() end) end
	end
	self._floatingLabels = {}
	self._watermarkLabel = nil
	local loading = self._ActiveLoading
	if loading and type(loading.Close) == "function" and not loading.Closed then
		pcall(function() loading:Close(true) end)
	end
	if loading and loading.Gui and loading.Gui.Parent then pcall(function() loading.Gui:Destroy() end) end
	self._ActiveLoading = nil
	self._LoadingActive = false
	self._LoadingOverlay = nil
	self._LoadingIssueLabel = nil
	pcall(function() self:Destroy() end)
	local names = {}
	for _, resolved in pairs(XLQPNames) do names[tostring(resolved)] = true end
	local parents = {}
	pcall(function() if gethui then parents[#parents + 1] = gethui() end end)
	pcall(function() parents[#parents + 1] = game:GetService("CoreGui") end)
	pcall(function() parents[#parents + 1] = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") end)
	for _, parent in ipairs(parents) do
		if typeof(parent) == "Instance" then
			for _, child in ipairs(parent:GetChildren()) do
				if child:IsA("ScreenGui") and (names[child.Name] or child.Name:find("XLQP", 1, true) or child.Name:find("Verbal", 1, true)) then
					pcall(function() child:Destroy() end)
				end
			end
		end
	end
	pcall(function()
		for _, effect in ipairs(game:GetService("Lighting"):GetChildren()) do
			if effect:IsA("BlurEffect") and (effect.Name:find("XLQP", 1, true) or effect.Name:find("Verbal", 1, true)) then
				effect:Destroy()
			end
		end
	end)
	pcall(function() (getgenv and getgenv() or _G).XLQPGen1 = nil end)
	pcall(function() (getgenv and getgenv() or _G).XLQPDiscordAuth = nil end)
	return self
end

