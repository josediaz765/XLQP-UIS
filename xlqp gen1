		local function beginDrag(input, immediate)
			if self.EditableMode ~= true or (Frame:GetAttribute("__XLQPGen1MoveableConfig")~=true and not editableAllElements) then return end
			self:_SetEditableSelection(Frame)
			cleanupDrag()
			activeInput = input
			pressPosition = input.Position
			lastPosition = input.Position
			dragToken += 1
			if immediate then
				dragging = true
				createGhost(input.Position)
			else
				pending = true
			end
		end
		local function activateDrag(position)
			if dragging then return end
			pending = false
			dragging = true
			createGhost(position)
		end
		local function finishDrag(position)
			if pending and not dragging then
				pending = false
				activeInput = nil
				return
			end
			if not dragging then cleanupDrag() return end
			local x = position and position.X or lastPosition and lastPosition.X or 0
			local y = position and position.Y or lastPosition and lastPosition.Y or 0
			local target = lastTarget or XLQPGen1:GetEditableDropTarget(Frame, x, y)
			if not target then
				local originalContainer = XLQPGen1:GetMoveableContainer(Frame.Parent)
				if originalContainer and XLQPGen1:_EditablePointInside(originalContainer, x, y) then target = originalContainer end
			end
			cleanupDrag()
			if target then
				local moved = XLQPGen1:MoveElementFrame(Frame, target, y)
				if moved then
					XLQPGen1:_SetEditableSelection(Frame)
				elseif XLQPGen1.MakeNotification then
					XLQPGen1:MakeNotification({Name = "Editable Layout", Content = "That drop area cannot accept this element.", Image = "move", Time = 3})
				end
			else
				XLQPGen1:_SetEditableSelection(Frame)
				pcall(function() XLQPGen1:FlashElement(Frame,Color3.fromRGB(90,160,255),1) end)
				if XLQPGen1.MakeNotification then
					XLQPGen1:MakeNotification({Name = "Editable Layout", Content = "No valid drop area was selected, so the element stayed where it was.", Image = "move", Time = 2.5})
