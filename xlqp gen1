	local function profileNames()
		local names={}
		for name in pairs(XLQPGen1.ConfigCloud.Profiles) do names[#names+1]=name end
		table.sort(names,function(a,b) return a:lower()<b:lower() end)
		return names
	end
	local refreshProfiles,refreshElements
	local function loadProfile(name)
		local profile=name and XLQPGen1.ConfigCloud.Profiles[name]
		selectedName=profile and name or nil
		editor.Visible=profile~=nil
		emptyState.Visible=profile==nil
		if not profile then
			nameBox.Text="" descriptionBox.Text="" tagsBox.Text="" webhookBox.Text=""
			return
		end
		nameBox.Text=profile.Name or ""
		descriptionBox.Text=profile.Description or ""
		tagsBox.Text=profile.Tags or ""
		webhookBox.Text=profile.Webhook or ""
		status.Text="Editing “"..name.."”"
	end
	refreshProfiles=function()
		for _,child in ipairs(profileList:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
		for index,name in ipairs(profileNames()) do
			local profile=XLQPGen1.ConfigCloud.Profiles[name]
			local item=button(profileList,"",UDim2.new(1,-5,0,54),UDim2.new(),selectedName==name and strokeColor:Lerp(secondColor,0.55) or mainColor,5)
			item.LayoutOrder=index
			label(item,name,UDim2.new(1,-18,0,20),UDim2.fromOffset(9,7),12,textColor,Enum.Font.GothamBold,6)
			label(item,profile.Tags~="" and profile.Tags or "Discord webhook profile",UDim2.new(1,-18,0,16),UDim2.fromOffset(9,29),9,darkText,Enum.Font.Gotham,6)
			item.Activated:Connect(function() loadProfile(name) refreshProfiles() end)
		end
	end
	refreshElements=function()
		for _,child in ipairs(elementList:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
		local names=profileNames()
		local count=0
		for _,element in ipairs(XLQPGen1.ConfigCloud.Elements) do
			if element and element.ConfigCloud==true and element.Wrapper and element.Wrapper.Parent then
				count+=1
				local row=Create("Frame",{Size=UDim2.new(1,0,0,48),BackgroundColor3=secondColor,BackgroundTransparency=0.14,BorderSizePixel=0,ZIndex=4,Parent=elementList})
				Create("UICorner",{CornerRadius=UDim.new(0,9),Parent=row})
				Create("UIStroke",{Color=strokeColor,Transparency=0.5,Parent=row})
				label(row,element.ConfigCloudName,UDim2.new(1,-205,0,19),UDim2.fromOffset(11,6),11,textColor,Enum.Font.GothamBold,6)
				label(row,tostring(element.Type or "Element").." • "..element.ConfigCloudKey,UDim2.new(1,-205,0,16),UDim2.fromOffset(11,26),9,darkText,Enum.Font.Gotham,6)
				local assigned=XLQPGen1.ConfigCloud.Assignments[element.ConfigCloudKey] or ""
				local assign=button(row,assigned~="" and assigned or "Not assigned",UDim2.fromOffset(178,32),UDim2.new(1,-188,0,8),mainColor,6)
				assign.Activated:Connect(function()
					local current=XLQPGen1.ConfigCloud.Assignments[element.ConfigCloudKey] or ""
					local nextName=""
					if #names>0 then
						local currentIndex=0
						for i,name in ipairs(names) do if name==current then currentIndex=i break end end
						if currentIndex<#names then nextName=names[currentIndex+1] end
					end
					local ok,err=XLQPGen1:AssignConfigCloudProfile(element.ConfigCloudKey,nextName)
					status.Text=ok and (nextName~="" and (element.ConfigCloudName.." → "..nextName) or (element.ConfigCloudName.." unassigned")) or tostring(err)
					refreshElements()
				end)
			end
		end
		if count==0 then label(elementList,"No Config Cloud elements are registered in this script yet.",UDim2.new(1,0,0,42),UDim2.new(),10,darkText,Enum.Font.Gotham,5) end
	end

	local function valueText(value)
		if type(value)=="table" then
			local ok,encoded=pcall(HttpService.JSONEncode,HttpService,value)
			if ok then return encoded end
		end
		return tostring(value)
	end
	local function containsWebhook(value,seen)
		if type(value)=="string" then return value:lower():find("discord.com/api/webhooks/",1,true)~=nil end
		if type(value)~="table" then return false end
		seen=seen or {}
		if seen[value] then return false end
		seen[value]=true
		for key,item in pairs(value) do if containsWebhook(key,seen) or containsWebhook(item,seen) then return true end end
		return false
	end
	configFiles=function()
		local result={}
		if not (listfiles and readfile) then return result end
		local folders={tostring(XLQPGen1.Folder or WindowConfig.ConfigFolder or "XLQPGen1"),tostring(XLQPGen1.ConfigCloud.PublicFolder)}
		local seenPaths={}
		for _,folder in ipairs(folders) do
			local ok,files=pcall(listfiles,folder)
			if ok and type(files)=="table" then
				for _,path in ipairs(files) do
					local normalized=tostring(path):gsub("\\","/")
					local lower=normalized:lower()
					if not seenPaths[lower] and (lower:match("%.txt$") or lower:match("%.json$")) then
						seenPaths[lower]=true
						local readOk,raw=pcall(readfile,path)
						local decodeOk,data=false,nil
						if readOk then decodeOk,data=pcall(HttpService.JSONDecode,HttpService,raw) end
						if decodeOk and type(data)=="table" then
							local matches=0
							for flag in pairs(data) do if XLQPGen1.Flags[tostring(flag)] then matches+=1 end end
							local fileName=normalized:match("([^/]+)$") or normalized
							result[#result+1]={Path=path,Name=fileName:gsub("%.[^%.]+$",""),Raw=raw,Data=data,Count=matches,Webhook=containsWebhook(data),Public=lower:find("/configcloud/public/",1,true)~=nil}
						end
					end
				end
			end
		end
		table.sort(result,function(a,b) return a.Name:lower()<b.Name:lower() end)
		return result
	end

	local function publicNumber(item,...)
		for _,key in ipairs({...}) do
			local value=tonumber(item[key])
			if value then return value end
		end
		return 0
	end
	local function clearPublicLists()
		for _,child in ipairs(publicCatalog:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
		for _,child in ipairs(publicMineList:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
	end
	local function publicAvatar(item)
		local owner=tostring(item.owner_id or item.user_id or "0")
		return "rbxthumb://type=AvatarHeadShot&id="..owner.."&w=150&h=150"
	end
	local function publicOwnerText(item)
		local username=tostring(item.username or item.user_name or "")
		local display=tostring(item.display_name or item.displayName or username)
		if display=="" then display="Roblox player" end
		if username~="" and username~=display then return display.."  @"..username end
		return username~="" and ("@"..username) or display
	end
	local function resolvePublicOwner(item,ownerLabel)
		local ownerId=tonumber(item.owner_id or item.user_id)
		if not ownerId or ownerId<=0 or tostring(item.username or "")~="" then return end
		task.spawn(function()
			local username,displayName="",""
			pcall(function() username=Players:GetNameFromUserIdAsync(ownerId) end)
			pcall(function()
				local infos=Players:GetUserInfosByUserIdsAsync({ownerId})
				if infos and infos[1] then displayName=tostring(infos[1].DisplayName or "") end
			end)
			if ownerLabel and ownerLabel.Parent then
				item.username=username
				item.display_name=displayName~="" and displayName or username
				ownerLabel.Text=publicOwnerText(item)
			end
		end)
	end
	local function loadPublicItem(item)
		XLQPGen1:MakeNotification({Name="Config Cloud",Content="Downloading “"..tostring(item.config_name or "config").."”...",Time=2})
		task.spawn(function()
			local ok,result=XLQPGen1:LoadPublicConfigCloud(item)
			if ok then
				XLQPGen1:MakeNotification({Name="Public config loaded",Content="Saved as JSON: "..tostring(result),Time=4})
				refreshSavedConfigs()
				refreshFlagPage()
				refreshPublicConfigs()
			else
				XLQPGen1:MakeNotification({Name="Public config error",Content=tostring(result),Time=4,Color=Color3.fromRGB(224,86,101)})
			end
		end)
	end
	closeCodeModal=function()
		codeShade.Visible=false
		codeBox.Text=""
		codeStatus.Text="Waiting for a code."
		codeStatus.TextColor3=darkText
		codeMode="Import"
		codeItem=nil
		codeValid=false
	end
	openCodeModal=function(mode,item)
		codeMode=mode=="Export" and "Export" or "Import"
		codeItem=item
		codeBox.Text=""
		codeStatus.TextColor3=darkText
		codeValid=false
		if codeMode=="Export" then
			codeTitle.Text="Export config"
			codeDescription.Text="Copy this code and send it to someone you trust."
			codeStatus.Text="Generating export code..."
			submitCode.Text=""
			for _,child in ipairs(submitCode:GetChildren()) do
				if child:IsA("TextLabel") then child.Text="Copy code" end
			end
			codeShade.Visible=true
			task.spawn(function()
				local ok,generated=XLQPGen1:CreateConfigCloudExportCode(item)
				if not codeShade.Parent or codeMode~="Export" then return end
				if ok then
					codeBox.Text=generated
					codeStatus.Text="Export code ready."
					codeStatus.TextColor3=Color3.fromRGB(92,224,139)
					codeValid=true
				else
					codeStatus.Text=tostring(generated)
					codeStatus.TextColor3=Color3.fromRGB(224,86,101)
				end
			end)
		else
			codeTitle.Text="Import config"
			codeDescription.Text="Paste an export code. It is checked before anything is loaded."
			codeStatus.Text="Waiting for a code."
			for _,child in ipairs(submitCode:GetChildren()) do
				if child:IsA("TextLabel") then child.Text="Import" end
			end
			codeShade.Visible=true
			task.defer(function() if codeBox and codeBox.Parent then pcall(function() codeBox:CaptureFocus() end) end end)
		end
	end
	local function updatePublicQuota(count)
		publicOwnCount=math.max(0,math.floor(tonumber(count) or 0))
		publicUploadLimit=math.max(1,math.floor(tonumber(XLQPGen1.ConfigCloud and XLQPGen1.ConfigCloud.PublicUploadLimit) or 5))
		publicQuotaLabel.Text=tostring(publicOwnCount).." / "..tostring(publicUploadLimit)
		local full=publicOwnCount>=publicUploadLimit
		publicQuotaLabel.TextColor3=full and Color3.fromRGB(224,86,101) or textColor
		publicCreate.BackgroundColor3=full and Color3.fromRGB(68,48,55) or strokeColor:Lerp(secondColor,0.55)
	end
	local function notifyPublicError(title,message)
		XLQPGen1:MakeNotification({Name=title or "Config Cloud",Content=tostring(message or "Unknown error"),Time=4,Color=Color3.fromRGB(224,86,101)})
	end
	local function deletePublicItem(item)
		task.spawn(function()
			local ok,result=XLQPGen1:DeletePublicConfigCloud(item)
			if ok then
				XLQPGen1:MakeNotification({Name="Config deleted",Content="“"..tostring(item.config_name or "Config").."” was deleted. One upload token was restored.",Time=4})
				refreshPublicConfigs()
			else
				notifyPublicError("Delete failed",result)
			end
		end)
	end
	local function votePublicItem(item,vote,onDone)
		task.spawn(function()
			local ok,result=XLQPGen1:VotePublicConfigCloud(item,vote)
			if ok then
				if type(result)=="table" then
					local source=type(result.config)=="table" and result.config or result
					if type(source)=="table" then
						for key,value in pairs(source) do item[key]=value end
					end
				end
				if type(onDone)=="function" then task.defer(onDone,true,result) end
			else
				if type(onDone)=="function" then task.defer(onDone,false,result) end
				notifyPublicError("Vote failed",result)
			end
		end)
	end
	local function makePublicCard(item,index)
		local card=Create("Frame",{Name="PublicConfigCard",LayoutOrder=index,BackgroundColor3=secondColor,BackgroundTransparency=0.08,BorderSizePixel=0,ZIndex=6,Parent=publicCatalog})
		Create("UICorner",{CornerRadius=UDim.new(0,10),Parent=card})
		Create("UIStroke",{Color=strokeColor,Transparency=0.48,Parent=card})
		local avatar=Create("ImageLabel",{Size=UDim2.fromOffset(36,36),Position=UDim2.fromOffset(11,11),BackgroundColor3=mainColor,BorderSizePixel=0,Image=publicAvatar(item),ZIndex=7,Parent=card})
		Create("UICorner",{CornerRadius=UDim.new(1,0),Parent=avatar})
		local title=label(card,tostring(item.config_name or "Untitled config"),UDim2.new(1,-68,0,20),UDim2.fromOffset(55,8),12,textColor,Enum.Font.GothamBold,7)
		local owner=label(card,publicOwnerText(item),UDim2.new(1,-68,0,17),UDim2.fromOffset(55,29),9,darkText,Enum.Font.GothamMedium,7)
		resolvePublicOwner(item,owner)
		local description=label(card,tostring(item.description or "No description provided."),UDim2.new(1,-22,0,34),UDim2.fromOffset(11,54),9,textColor,Enum.Font.Gotham,7)
		description.TextWrapped=true
		description.TextYAlignment=Enum.TextYAlignment.Top
		description.TextTruncate=Enum.TextTruncate.AtEnd
		local gameText=tostring(item.game_name or item.gameName or "Unknown game")
		label(card,gameText,UDim2.new(1,-22,0,17),UDim2.fromOffset(11,92),9,darkText,Enum.Font.GothamMedium,7)
		local likes=publicNumber(item,"likes","like_count","upvotes","rating")
		local dislikes=publicNumber(item,"dislikes","dislike_count","downvotes")
		local downloads=publicNumber(item,"imports","import_count","downloads","download_count","loads")
		label(card,tostring(likes).." likes  •  "..tostring(dislikes).." dislikes  •  "..tostring(downloads).." loads",UDim2.new(1,-22,0,18),UDim2.fromOffset(11,116),8,darkText,Enum.Font.Gotham,7)

		local likeButton=decorateButton(button(card,"",UDim2.fromOffset(66,29),UDim2.fromOffset(11,142),mainColor,7),"thumbs-up",tostring(likes))
		local dislikeButton=decorateButton(button(card,"",UDim2.fromOffset(66,29),UDim2.fromOffset(83,142),mainColor,7),"thumbs-down",tostring(dislikes))
		local load=decorateButton(button(card,"",UDim2.fromOffset(76,29),UDim2.fromOffset(155,142),strokeColor:Lerp(secondColor,0.55),7),"download","Load")
		load.Activated:Connect(function() loadPublicItem(item) end)
		local currentVote=tonumber(item.user_vote or item.my_vote or item.current_vote or item.vote) or 0
		if currentVote>0 then currentVote=1 elseif currentVote<0 then currentVote=-1 else currentVote=0 end
		local voteBusy=false
		local function refreshVoteButtons()
			likes=publicNumber(item,"likes","like_count","upvotes","rating")
			dislikes=publicNumber(item,"dislikes","dislike_count","downvotes")
			updateDecoratedButton(likeButton,"thumbs-up",tostring(likes))
			updateDecoratedButton(dislikeButton,"thumbs-down",tostring(dislikes))
			likeButton.BackgroundColor3=currentVote==1 and strokeColor:Lerp(secondColor,0.38) or mainColor
			dislikeButton.BackgroundColor3=currentVote==-1 and strokeColor:Lerp(secondColor,0.38) or mainColor
			likeButton.BackgroundTransparency=currentVote==1 and 0 or 0.04
			dislikeButton.BackgroundTransparency=currentVote==-1 and 0 or 0.04
			local statusLabel=card:FindFirstChild("VoteStatus")
			if statusLabel then
				statusLabel.Text=currentVote==1 and "You liked this" or currentVote==-1 and "You disliked this" or ""
			end
		end
		local voteStatus=label(card,"",UDim2.fromOffset(80,18),UDim2.fromOffset(235,147),8,darkText,Enum.Font.GothamMedium,7)
		voteStatus.Name="VoteStatus"
		voteStatus.TextXAlignment=Enum.TextXAlignment.Right
		local function submitVote(requestedVote)
			if voteBusy then return end
			voteBusy=true
			likeButton.Active=false
			dislikeButton.Active=false
			local beforeVote=currentVote
			local beforeLikes=likes
			local beforeDislikes=dislikes
			local targetVote=currentVote==requestedVote and 0 or requestedVote
			if beforeVote==1 then likes=math.max(0,likes-1) end
			if beforeVote==-1 then dislikes=math.max(0,dislikes-1) end
			if targetVote==1 then likes+=1 end
			if targetVote==-1 then dislikes+=1 end
			item.likes=likes
			item.like_count=likes
			item.dislikes=dislikes
			item.dislike_count=dislikes
			currentVote=targetVote
			item.user_vote=currentVote
			item.my_vote=currentVote
			refreshVoteButtons()
			votePublicItem(item,targetVote,function(ok,result)
				voteBusy=false
				likeButton.Active=true
				dislikeButton.Active=true
				if not ok then
					currentVote=beforeVote
					likes=beforeLikes
					dislikes=beforeDislikes
					item.likes=likes
					item.like_count=likes
					item.dislikes=dislikes
					item.dislike_count=dislikes
					item.user_vote=currentVote
					item.my_vote=currentVote
				else
					local source=type(result)=="table" and (type(result.config)=="table" and result.config or result) or {}
					local serverVote=tonumber(source.user_vote or source.my_vote or source.current_vote or source.vote)
					if serverVote~=nil then
						if serverVote>0 then currentVote=1 elseif serverVote<0 then currentVote=-1 else currentVote=0 end
						item.user_vote=currentVote
						item.my_vote=currentVote
					end
				end
				refreshVoteButtons()
			end)
		end
		likeButton.Activated:Connect(function() submitVote(1) end)
		dislikeButton.Activated:Connect(function() submitVote(-1) end)
		refreshVoteButtons()

		local ownerId=tostring(item.owner_id or item.user_id or "")
		local localOwner=tostring(Players.LocalPlayer and Players.LocalPlayer.UserId or "")
		local owned=ownerId~="" and ownerId==localOwner
		if owned then
			local exportButton=decorateButton(button(card,"",UDim2.fromOffset(70,29),UDim2.fromOffset(11,181),mainColor,7),"upload","Export")
			exportButton.Activated:Connect(function() openCodeModal("Export",item) end)
			local isPublic=tonumber(item.is_public)==1 or item.is_public==true
			local visibilityButton=decorateButton(button(card,"",UDim2.fromOffset(82,29),UDim2.fromOffset(87,181),mainColor,7),isPublic and "eye" or "eye-off",isPublic and "Public" or "Private")
			visibilityButton.Activated:Connect(function()
				visibilityButton.Active=false
				task.spawn(function()
					local ok,result=XLQPGen1:SetPublicConfigCloudVisibility(item,not isPublic)
					visibilityButton.Active=true
					if ok then
						XLQPGen1:MakeNotification({Name="Config visibility",Content="“"..tostring(item.config_name or "Config").."” is now "..(not isPublic and "public." or "private."),Time=3})
						refreshPublicConfigs()
					else
						notifyPublicError("Visibility error",result)
					end
				end)
			end)
			local editButton=decorateButton(button(card,"",UDim2.fromOffset(66,29),UDim2.fromOffset(175,181),mainColor,7),"pencil","Edit")
			editButton.Activated:Connect(function() openPublicModal(item) end)
			local deleteIconButton=button(card,"",UDim2.fromOffset(48,29),UDim2.fromOffset(247,181),Color3.fromRGB(73,31,42),7)
			icon(deleteIconButton,"trash-2",UDim2.fromOffset(15,15),UDim2.fromOffset(16,7),8)
			deleteIconButton.Activated:Connect(function()
				deleteIconButton.Active=false
				deletePublicItem(item)
			end)
		end
		title:SetAttribute("NoLiquidGlassText",true)
		return card
	end
	local function renderPublicConfigs()
		clearPublicLists()
		local items={}
		for _,item in ipairs(publicItems) do items[#items+1]=item end
		table.sort(items,function(a,b)
			if publicSort=="Downloads" then return publicNumber(a,"imports","import_count","downloads","download_count")>publicNumber(b,"imports","import_count","downloads","download_count") end
			if publicSort=="Newest" then return publicNumber(a,"updated_at","created_at","timestamp")>publicNumber(b,"updated_at","created_at","timestamp") end
			local aScore=publicNumber(a,"likes","like_count","upvotes","rating")-publicNumber(a,"dislikes","dislike_count","downvotes")
			local bScore=publicNumber(b,"likes","like_count","upvotes","rating")-publicNumber(b,"dislikes","dislike_count","downvotes")
			return aScore>bScore
		end)
		local localOwner=tostring(Players.LocalPlayer and Players.LocalPlayer.UserId or "")
		local mine=0
		for index,item in ipairs(items) do
			makePublicCard(item,index)
			if tostring(item.owner_id or item.user_id or "")==localOwner then
				mine+=1
				local ownRow=Create("Frame",{Size=UDim2.new(1,-5,0,62),BackgroundColor3=mainColor,BackgroundTransparency=0.05,BorderSizePixel=0,LayoutOrder=mine,ZIndex=6,Parent=publicMineList})
				Create("UICorner",{CornerRadius=UDim.new(0,9),Parent=ownRow})
				Create("UIStroke",{Color=strokeColor,Transparency=0.46,Parent=ownRow})
				label(ownRow,tostring(item.config_name or "Untitled"),UDim2.new(1,-78,0,20),UDim2.fromOffset(9,7),10,textColor,Enum.Font.GothamBold,7)
				label(ownRow,tostring(item.game_name or "Unknown game"),UDim2.new(1,-78,0,16),UDim2.fromOffset(9,31),8,darkText,Enum.Font.Gotham,7)
				local ownEdit=button(ownRow,"",UDim2.fromOffset(28,28),UDim2.new(1,-64,0,17),secondColor,7)
				icon(ownEdit,"pencil",UDim2.fromOffset(13,13),UDim2.fromOffset(7,7),8)
				local ownDelete=button(ownRow,"",UDim2.fromOffset(28,28),UDim2.new(1,-32,0,17),Color3.fromRGB(73,31,42),7)
				icon(ownDelete,"trash-2",UDim2.fromOffset(13,13),UDim2.fromOffset(7,7),8)
				ownEdit.Activated:Connect(function() openPublicModal(item) end)
				ownDelete.Activated:Connect(function()
					ownDelete.Active=false
					deletePublicItem(item)
				end)
			end
		end
		if #items==0 then label(publicCatalog,"No public configs match this search.",UDim2.fromOffset(440,42),UDim2.new(),11,darkText,Enum.Font.Gotham,6) end
		if mine==0 then label(publicMineList,"You have not uploaded a public config yet.",UDim2.new(1,-8,0,48),UDim2.new(),9,darkText,Enum.Font.Gotham,6) end
		updatePublicQuota(publicOwnCount)
		for name,tab in pairs({["Top rated"]=publicTop,["Downloads"]=publicDownloads,["Newest"]=publicNewest}) do
			tab.BackgroundColor3=name==publicSort and strokeColor:Lerp(secondColor,0.58) or mainColor
		end
	end
	refreshPublicConfigs=function()
		clearPublicLists()
		label(publicCatalog,"Loading public configs...",UDim2.fromOffset(440,42),UDim2.new(),11,darkText,Enum.Font.Gotham,6)
		local query=tostring(publicSearch.Text or "")
		task.spawn(function()
			local result,err=XLQPGen1:GetPublicConfigCloud(query)
			if not result then
				publicItems={}
				clearPublicLists()
				label(publicCatalog,"Could not load public configs: "..tostring(err),UDim2.fromOffset(540,42),UDim2.new(),10,Color3.fromRGB(224,86,101),Enum.Font.Gotham,6)
				return
			end
			local merged={}
			local order={}
			local function mergeItem(item)
				if type(item)~="table" then return end
				local key=tostring(item.owner_id or item.user_id or "").."\0"..tostring(item.config_name or item.name or "")
				if not merged[key] then order[#order+1]=key end
				merged[key]=item
			end
			for _,item in ipairs(result) do mergeItem(item) end
			local mine=XLQPGen1:GetOwnPublicConfigCloud("")
			if type(mine)=="table" then
				updatePublicQuota(#mine)
				for _,item in ipairs(mine) do
					if configCloudPublicItemMatches(item,query) then mergeItem(item) end
				end
			else
				updatePublicQuota(publicOwnCount)
			end
			publicItems={}
			for _,key in ipairs(order) do publicItems[#publicItems+1]=merged[key] end
			renderPublicConfigs()
		end)
	end
