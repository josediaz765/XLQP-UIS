	local lastX,lastY,lastWidth,lastHeight,lastZ,lastCorner
	local function syncGlowLayers()
		if not (holder and holder.Parent and targetFrame and targetFrame.Parent) then return end
		local visible=applyVisibility()
		if not visible then return end
		if self._LayoutSuspended==true or self._ResizeFollowupsRunning==true or (tonumber(self._ResizeSettlingUntil) or 0)>os.clock() then return end
		local ok=pcall(function()
			local absPos=targetFrame.AbsolutePosition
			local absSize=targetFrame.AbsoluteSize
			if absSize.X<=0 or absSize.Y<=0 or absSize.X>4000 or absSize.Y>4000 then return end
			local parentOrigin=Vector2.new(0,0)
			local coordinateParent=holder.Parent
			if coordinateParent and coordinateParent:IsA("GuiObject") then parentOrigin=coordinateParent.AbsolutePosition end
			local targetZ=(tonumber(targetFrame.ZIndex) or 1)-1
			local t=tick()*((self._GlowSpeed or 5)/10)+phase
			local liveCornerInstance=cornerInstance and cornerInstance.Parent and cornerInstance or targetFrame:FindFirstChildOfClass("UICorner")
			cornerInstance=liveCornerInstance
