	WindowConfig._LocalRegisterState.AttachHoverEffect = function(Frame,Hitbox,Config)
		if typeof(Frame)~="Instance" or Frame:GetAttribute("__XLQPHoverInstalled") then return nil end
		Config=type(Config)=="table" and Config or {}
		if Config.Hover==false or Config.HoverEnabled==false then return nil end
		Frame:SetAttribute("__XLQPHoverInstalled",true)
		Hitbox=typeof(Hitbox)=="Instance" and Hitbox or Frame
		local overlay=Create("Frame",{
			Name="XLQPHoverOverlay",
			Size=UDim2.fromScale(1,1),
			BackgroundColor3=typeof(Config.HoverColor)=="Color3" and Config.HoverColor or Color3.fromRGB(255,255,255),
			BackgroundTransparency=1,
			BorderSizePixel=0,
			Active=false,
			ZIndex=2,
			Parent=Frame
		})
		overlay:SetAttribute("NoLiquidGlass",true)
		Create("UICorner",{CornerRadius=UDim.new(0,tonumber(Config.HoverCornerRadius) or 8),Parent=overlay})
		local scale=Frame:FindFirstChild("XLQPHoverScale")
		if not scale then scale=Create("UIScale",{Name="XLQPHoverScale",Scale=1,Parent=Frame}) end
		local stroke=Frame:FindFirstChildOfClass("UIStroke")
		local baseStrokeTransparency=stroke and stroke.Transparency or 1
		local baseStrokeColor=stroke and stroke.Color or Color3.fromRGB(255,255,255)
		local hovering=false
		local pressing=false
		local enabled=true
		local hoverScale=tonumber(Config.HoverScale) or 1.006
		local pressScale=tonumber(Config.PressScale) or 0.986
		local hoverTransparency=tonumber(Config.HoverTransparency) or 0.945
		local pressTransparency=tonumber(Config.PressTransparency) or 0.89
		local function animate()
			if not Frame.Parent then return end
			local active=enabled and hovering
			local down=enabled and pressing
			TweenService:Create(scale,TweenInfo.new(down and 0.07 or 0.18,down and Enum.EasingStyle.Quad or Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Scale=down and pressScale or (active and hoverScale or 1)}):Play()
			TweenService:Create(overlay,TweenInfo.new(down and 0.07 or 0.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=down and pressTransparency or (active and hoverTransparency or 1)}):Play()
			if stroke then
				local targetTransparency=down and math.max(0.08,baseStrokeTransparency-0.34) or (active and math.max(0.16,baseStrokeTransparency-0.18) or baseStrokeTransparency)
				local targetColor=(down or active) and (typeof(Config.HoverStrokeColor)=="Color3" and Config.HoverStrokeColor or baseStrokeColor:Lerp(Color3.fromRGB(255,255,255),0.24)) or baseStrokeColor
				TweenService:Create(stroke,TweenInfo.new(0.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Transparency=targetTransparency,Color=targetColor}):Play()
			end
		end
		AddConnection(Hitbox.MouseEnter,function() hovering=true animate() end)
		AddConnection(Hitbox.MouseLeave,function() hovering=false pressing=false animate() end)
		AddConnection(Hitbox.InputBegan,function(input)
			if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then pressing=true animate() end
		end)
		AddConnection(Hitbox.InputEnded,function(input)
			if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then pressing=false animate() end
		end)
		local Controller={Frame=Frame,Overlay=overlay,Scale=scale}
		function Controller:SetEnabled(Value)
			enabled=Value~=false
			if not enabled then hovering=false pressing=false end
			animate()
			return self
		end
		function Controller:Pulse()
			if not enabled or not Frame.Parent then return self end
			pressing=true animate()
			task.delay(0.09,function() if Frame.Parent then pressing=false animate() end end)
			return self
		end
		return Controller
	end

