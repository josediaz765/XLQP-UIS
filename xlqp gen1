	function Island:SetNotification(config)
		config=type(config)=="table" and config or {Title=tostring(config or "Notification")}
		self.NotificationToken+=1
		local token=self.NotificationToken
		self.Mode="Notification"
		self.Playing=false
		if self.Expanded then self:Collapse() end
		waveHolder.Visible=false
		controls.Visible=false
		trackLabel.Text=tostring(config.Title or config.Name or "Notification")
		subLabel.Text=tostring(config.Content or config.Description or "")
		local image=config.Image or config.Icon or GetIcon("bell") or GetIcon("info")
		if image and tostring(image)~="" then
			local resolved=tostring(image)
			if resolved:match("^%d+$") then resolved="rbxassetid://"..resolved end
			XLQPAssignProperty(art,"Image",resolved)
			art.ImageRectSize=Vector2.new() art.ImageRectOffset=Vector2.new()
		end
		self:Show()
		local duration=math.clamp(tonumber(config.Time or config.Duration) or 4,1,30)
		task.delay(duration,function()
			if self.NotificationToken==token and self.Mode=="Notification" then self:RestoreMusicOrHide() end
		end)
