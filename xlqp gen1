				local state={}
				for i=0,total-1 do
					if token~=self.Token then return nil end
					local good,value=pcall(fn,math.floor(i*step),state)
					value=good and value or 0
					if type(value)=="table" then
						local sum,count,negative=0,0,false
						for _,sample in ipairs(value) do
							sample=tonumber(sample) or 0
							if sample<0 then negative=true end
							sum=sum+sample
							count=count+1
						end
						value=count>0 and sum/count or 0
						if mode~="Floatbeat" and negative then value=value+128 end
					else
						value=tonumber(value) or 0
					end
					if mode=="Floatbeat" then
