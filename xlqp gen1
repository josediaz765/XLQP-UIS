local function sharedAIThemeFolder(path)
	if isfolder and isfolder(path) then return true end
	if not makefolder then return false end
	local pieces={}
	for piece in tostring(path or ""):gmatch("[^/\\]+") do pieces[#pieces+1]=piece end
	local current=""
	for _,piece in ipairs(pieces) do
		current=current=="" and piece or (current.."/"..piece)
		pcall(function() if not isfolder or not isfolder(current) then makefolder(current) end end)
	end
	return not isfolder or isfolder(path)
end

function SharedAIService:FindThemeImage(prompt)
	local query=sharedAIClean(prompt):gsub("[Mm]ake%s+",""):gsub("[Cc]reate%s+",""):gsub("[Gg]enerate%s+",""):gsub("[Tt]heme",""):gsub("[Bb]ackground",""):gsub("[Ii]mage","")
	query=sharedAIClean(query)
	if query=="" then query="galaxy wallpaper" end
	local imageUrl=""
	local duckUrl="https://api.duckduckgo.com/?q="..HttpService:UrlEncode(query).."&format=json&no_html=1&no_redirect=1&skip_disambig=1"
	local body,code=sharedAIRawRequest("GET",duckUrl,{["Accept"]="application/json",["User-Agent"]="Mozilla/5.0"},nil,35)
	if body~="" and (code==0 or (code>=200 and code<300)) then
		local data=sharedAIDecode(body)
		if type(data)=="table" then imageUrl=tostring(data.Image or data.ImageUrl or data.Thumbnail or "") end
	end
	if imageUrl=="" then
		local openUrl="https://en.wikipedia.org/w/api.php?action=opensearch&limit=1&namespace=0&format=json&search="..HttpService:UrlEncode(query)
		local openBody,openCode=sharedAIRawRequest("GET",openUrl,{["Accept"]="application/json",["User-Agent"]="Mozilla/5.0"},nil,35)
		local title
		if openBody~="" and (openCode==0 or (openCode>=200 and openCode<300)) then
			local data=sharedAIDecode(openBody)
			if type(data)=="table" and type(data[2])=="table" then title=data[2][1] end
		end
		if title then
			local summaryUrl="https://en.wikipedia.org/api/rest_v1/page/summary/"..HttpService:UrlEncode(tostring(title))
			local summaryBody,summaryCode=sharedAIRawRequest("GET",summaryUrl,{["Accept"]="application/json",["User-Agent"]="Mozilla/5.0"},nil,35)
			if summaryBody~="" and (summaryCode==0 or (summaryCode>=200 and summaryCode<300)) then
				local data=sharedAIDecode(summaryBody)
				if type(data)=="table" then
					if type(data.originalimage)=="table" then imageUrl=tostring(data.originalimage.source or "") end
					if imageUrl=="" and type(data.thumbnail)=="table" then imageUrl=tostring(data.thumbnail.source or "") end
				end
			end
		end
	end
	if imageUrl:sub(1,2)=="//" then imageUrl="https:"..imageUrl end
	return imageUrl
end

function sharedAIDecodeThemeResponse(answer)
	if type(answer)=="table" then return answer end
	local raw=tostring(answer or ""):gsub("```json",""):gsub("```lua",""):gsub("```","")
	raw=raw:gsub("[“”]","\""):gsub("[‘’]","'")
	local candidates={raw}
	for object in raw:gmatch("%b{}") do candidates[#candidates+1]=object end
	for _,candidate in ipairs(candidates) do
		local ok,data=pcall(function() return HttpService:JSONDecode(candidate) end)
		if ok and type(data)=="table" then return data end
		local repaired=candidate:gsub("'([^']-)'%s*:","\"%1\":"):gsub(":%s*'([^']-)'",":\"%1\""):gsub(",%s*([}%]])","%1")
		ok,data=pcall(function() return HttpService:JSONDecode(repaired) end)
		if ok and type(data)=="table" then return data end
	end
	return nil
end

local function sharedAIFallbackTheme(prompt,kind,answer)
	local text=(tostring(prompt or "").." "..tostring(answer or "")):lower()
	local colors
	local style="Vivid"
	if text:find("galaxy",1,true) or text:find("purple",1,true) or text:find("space",1,true) then
		style="Galaxy" colors={"#120A46","#412DD2","#BE37FF","#FF4BB4","#120A46"}
	elseif text:find("ocean",1,true) or text:find("blue",1,true) or text:find("ice",1,true) then
		style="Ocean" colors={"#071A52","#0866C6","#17D4FF","#755BFF","#071A52"}
	elseif text:find("fire",1,true) or text:find("red",1,true) or text:find("lava",1,true) then
		style="Fire" colors={"#34000D","#C41736","#FF5C35","#FFD166","#34000D"}
	elseif text:find("forest",1,true) or text:find("green",1,true) or text:find("nature",1,true) then
		style="Forest" colors={"#052E2B","#0C8F68","#47E69A","#B7F34A","#052E2B"}
	elseif text:find("sunset",1,true) or text:find("pink",1,true) then
		style="Sunset" colors={"#4B176D","#D8328B","#FF6678","#FFB84D","#4B176D"}
	else
		colors={"#15104B","#3E5BFF","#22D8FF","#D43CFF","#FF3E8A","#15104B"}
	end
	local extracted={}
	for hex in tostring(answer or ""):gmatch("#%x%x%x%x%x%x") do extracted[#extracted+1]=hex:upper() end
	if #extracted>=2 then colors=extracted if colors[#colors]~=colors[1] then colors[#colors+1]=colors[1] end end
	if kind=="live" then
		return {Type="live",Name="XLQP AI "..style,Colors=colors,Speed=.24,Rotation=8,Transparency=.035,ImageTransparency=.12,Effect="Stars",EffectColor="#D9E8FF",EffectCount=22,EffectSpeed=.34}
	end
	return {Type="normal",Name="XLQP AI "..style,Main=colors[1],Second=colors[2],Stroke=colors[3] or colors[2],Divider=colors[2],Text="#F7F8FF",TextDark="#B4BAD2",Bloom=colors[4] or colors[3]}
end

function SharedAIService:CreateThemeFromPrompt(prompt)
	if self.Config.ThemeToolsEnabled==false then return false,"AI theme tools are disabled in XLQP AI settings." end
	if not writefile then return false,"This executor does not provide writefile, so XLQP AI cannot save a theme." end
	prompt=tostring(prompt or "")
	local lower=prompt:lower()
	local forcedKind
	if lower:find("live color",1,true) or lower:find("livecolor",1,true) then forcedKind="live" end
	if lower:find("normal theme",1,true) or lower:find("static theme",1,true) then forcedKind="normal" end
	local explicitImage=prompt:match("(https?://[^%s\"'<>]+)")
	if explicitImage then explicitImage=explicitImage:gsub("[%)%]}>%,%.]+$","") end
	if not explicitImage then
		local assetId=prompt:match("[Aa]sset%s*[Ii][Dd]%s*[:#]?%s*(%d+)")
		if assetId then explicitImage="rbxassetid://"..assetId end
	end
	local schema=[[Return only one valid JSON object for an XLQP Gen1 theme. No markdown and no explanation.
Schema: {"Type":"live or normal","Name":"short theme name","Colors":["#RRGGBB"],"Main":"#RRGGBB","Second":"#RRGGBB","Stroke":"#RRGGBB","Divider":"#RRGGBB","Text":"#RRGGBB","TextDark":"#RRGGBB","Bloom":"#RRGGBB","BackgroundImage":"optional direct PNG/JPG URL or Roblox asset id","ImageTransparency":0.2,"Speed":0.25,"Rotation":8,"Transparency":0.05,"Effect":"None, Stars, Dots, or Rain","EffectColor":"#RRGGBB","EffectCount":20,"EffectSpeed":0.35}.
	For a live theme include at least 4 Colors and repeat the first color last for a seamless loop. For a normal theme include all named color fields. Keep text readable and use the image URL supplied by the user exactly.]]
	local ok,answer,provider=self:Chat({{role="system",content=schema},{role="user",content=prompt}},prompt)
	local data=ok and sharedAIDecodeThemeResponse(answer) or nil
	if type(data)~="table" then data=sharedAIFallbackTheme(prompt,forcedKind or "normal",answer) end
	local name=sharedAIClean(data.Name or data.name or "XLQP AI Theme"):gsub("[\\/:*?\"<>|]","_")
	if name=="" then name="XLQP AI Theme" end
	local kind=forcedKind or tostring(data.Type or data.type or "normal"):lower()
	if kind:find("live",1,true) then kind="live" else kind="normal" end
	local wantsImage=lower:find("background",1,true) or lower:find("wallpaper",1,true) or lower:find(" image",1,true) or lower:find("png",1,true) or lower:find("jpg",1,true)
	local fetchedImage=not explicitImage and wantsImage and self:FindThemeImage(prompt) or ""
	local image=explicitImage or (fetchedImage~="" and fetchedImage) or tostring(data.BackgroundImage or data.backgroundImage or data.Image or data.image or "")
	local imageTransparency=math.clamp(tonumber(data.ImageTransparency or data.imageTransparency) or 0.2,0,1)
	local root=tostring((XLQPGen1._WindowConfig and XLQPGen1._WindowConfig.ConfigFolder) or XLQPGen1.ConfigFolder or self.ConfigFolder or "VerbalHub")
	local window=XLQPGen1._GetWindow and XLQPGen1:_GetWindow() or XLQPGen1
	if kind=="live" then
		local colors={}
		for _,value in ipairs(type(data.Colors)=="table" and data.Colors or type(data.colors)=="table" and data.colors or {}) do
			local hex=sharedAIThemeHex(value)
			if hex then colors[#colors+1]=hex end
		end
		if #colors<2 then
			local fallback=sharedAIFallbackTheme(prompt,"live",answer)
			for _,value in ipairs(fallback.Colors) do colors[#colors+1]=value end
		end
		if colors[#colors]~=colors[1] then colors[#colors+1]=colors[1] end
		local effect=tostring(data.Effect or data.effect or "None")
		local allowedEffect={none="None",stars="Stars",dots="Dots",rain="Rain",rainfall="Rain"}
		effect=allowedEffect[effect:lower()] or "None"
		local pack={Name=name,Colors=colors,Speed=math.clamp(tonumber(data.Speed or data.speed) or .25,.03,3),Rotation=tonumber(data.Rotation or data.rotation) or 8,Transparency=math.clamp(tonumber(data.Transparency or data.transparency) or .05,0,1),BackgroundImage=image,ImageTransparency=imageTransparency,Effect=effect,EffectColor=sharedAIThemeHex(data.EffectColor or data.effectColor) or "#D9E4FF",EffectCount=math.clamp(math.floor(tonumber(data.EffectCount or data.effectCount) or 20),4,40),EffectSpeed=math.clamp(tonumber(data.EffectSpeed or data.effectSpeed) or .35,.05,2.5)}
		local folder=tostring(XLQPGen1.LiveColorFolder or "XLQPGen1/LiveColors")
		if not sharedAIThemeFolder(folder) then return false,"XLQP AI could not create the live color folder." end
		local saved=pcall(writefile,folder.."/"..name..".txt",HttpService:JSONEncode(pack))
		if not saved then return false,"XLQP AI could not save the live color file." end
		XLQPGen1:ReloadLiveColorThemes()
		XLQPGen1:SetLiveColorTheme(name)
		XLQPGen1:SetLiveColorMode("Background + Elements",name)
		return true,"XLQP AI created and applied live theme "..name..". Saved to "..folder.."/"..name..".txt"
	end
	local base=sharedAICopy(XLQPGen1.Themes and XLQPGen1.Themes.Default or {})
	local source=type(data.Theme)=="table" and data.Theme or type(data.theme)=="table" and data.theme or data
	local normalFallback=sharedAIFallbackTheme(prompt,"normal",answer)
	local keys={"Main","Second","Stroke","Divider","Text","TextDark","Bloom"}
	local valid=0
	for _,key in ipairs(keys) do
		local color=sharedAIThemeColor(source[key] or source[key:sub(1,1):lower()..key:sub(2)] or normalFallback[key])
		if color then base[key]=color valid+=1 end
	end
	if valid<4 then return false,"XLQP AI could not build enough valid normal theme colors." end
	XLQPGen1.Themes[name]=base
	local packed={}
	for key,value in pairs(base) do
		if typeof(value)=="Color3" then packed[key]={R=value.R*255,G=value.G*255,B=value.B*255} else packed[key]=value end
	end
	local themeFolder=root.."/Themes"
	if not sharedAIThemeFolder(themeFolder) then return false,"XLQP AI could not create the theme folder." end
	local saved=pcall(writefile,themeFolder.."/"..name..".json",HttpService:JSONEncode(packed))
	if not saved then return false,"XLQP AI could not save the normal theme file." end
	if window and type(window.SetTheme)=="function" then window:SetTheme(name) elseif XLQPGen1.SetTheme then XLQPGen1:SetTheme(name) end
	if image~="" and window and type(window.SetBackground)=="function" then
		window:SetBackground(image,imageTransparency)
		if type(window.SaveBackground)=="function" then window:SaveBackground(name.." Background",image,imageTransparency) end
	end
	return true,"XLQP AI created and applied normal theme "..name..". Saved to "..themeFolder.."/"..name..".json"
end

