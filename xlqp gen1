function XLQPAttachCursorGlow(frame,hitbox,config)
	if typeof(frame)~="Instance" or frame:GetAttribute("XLQPCursorGlow")==true then return nil end
	config=type(config)=="table" and config or {}
	if config.CursorGlow==false or config.Glow==false then return nil end
	frame:SetAttribute("XLQPCursorGlow",true)
	hitbox=typeof(hitbox)=="Instance" and hitbox or frame
	local size=math.clamp(math.floor(tonumber(config.CursorGlowSize) or 120),24,600)
	local glow=Create("Frame",{
		Name="XLQPCursorGlow",
		AnchorPoint=Vector2.new(0.5,0.5),
		Size=UDim2.fromOffset(size,size),
		Position=UDim2.fromScale(0.5,0.5),
		BackgroundColor3=XLQPResolveTagColor(config.CursorGlowColor,Color3.fromRGB(255,255,255)),
		BackgroundTransparency=1,
		BorderSizePixel=0,
		ZIndex=(tonumber(frame.ZIndex) or 1)+1,
		Visible=false,
		Parent=frame
	})
	glow:SetAttribute("NoLiquidGlass",true)
	Create("UICorner",{CornerRadius=UDim.new(1,0),Parent=glow})
	Create("UIGradient",{
		Rotation=0,
		Transparency=NumberSequence.new({
			NumberSequenceKeypoint.new(0,0.35),
			NumberSequenceKeypoint.new(0.45,0.72),
			NumberSequenceKeypoint.new(1,1)
		}),
		Parent=glow
	})
	local peak=math.clamp(tonumber(config.CursorGlowStrength) or 0.72,0,1)
	local active=false
	local function place(x,y)
		local origin=frame.AbsolutePosition
		glow.Position=UDim2.fromOffset(x-origin.X,y-origin.Y)
	end
	AddConnection(hitbox.MouseEnter,function()
		if frame:GetAttribute("XLQPLockedOut")==true then return end
		active=true
		glow.Visible=true
		TweenService:Create(glow,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{BackgroundTransparency=peak}):Play()
	end)
	AddConnection(hitbox.MouseLeave,function()
		active=false
		TweenService:Create(glow,TweenInfo.new(0.24,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
		task.delay(0.26,function() if not active and glow.Parent then glow.Visible=false end end)
	end)
	AddConnection(hitbox.MouseMoved,function(x,y)
		if not active then return end
		place(x,y)
	end)
	AddConnection(hitbox.InputChanged,function(input)
		if not active then return end
		if input.UserInputType==Enum.UserInputType.Touch then place(input.Position.X,input.Position.Y) end
	end)
	return glow
end

function XLQPApplyElementStyle(frame,config,object)
	if typeof(frame)~="Instance" or type(config)~="table" then return frame end
	local style=type(config.Style)=="table" and config.Style or config
	local function pick(...)
		for index=1,select("#",...) do
			local value=select(index,...)
			if value~=nil then return value end
		end
		return nil
	end
	local background=pick(style.BackgroundColor,style.BackgroundColor3,config.BackgroundColor)
	if background~=nil then
		local resolved=XLQPResolveTagColor(background,nil)
		if resolved then
			frame.BackgroundColor3=resolved
			frame:SetAttribute("XLQPStyleLocked",true)
		end
	end
	local transparency=pick(style.BackgroundTransparency,config.BackgroundTransparency)
	if tonumber(transparency) then frame.BackgroundTransparency=math.clamp(tonumber(transparency),0,1) end
	local radius=pick(style.CornerRadius,config.CornerRadius)
	if tonumber(radius) then
		local corner=frame:FindFirstChildOfClass("UICorner")
		if not corner then corner=Create("UICorner",{Parent=frame}) end
		corner.CornerRadius=UDim.new(0,math.max(0,math.floor(tonumber(radius))))
	end
	local height=pick(config.WrapperHeight,config.ElementHeight)
	if type(config.Style)=="table" then height=pick(config.Style.Height,height) end
	if tonumber(height) and frame.Size.Y.Scale==0 then
		frame.Size=UDim2.new(frame.Size.X.Scale,frame.Size.X.Offset,0,math.max(1,math.floor(tonumber(height))))
	end
	local stroke=frame:FindFirstChildOfClass("UIStroke")
	local strokeColor=pick(style.StrokeColor,config.StrokeColor,style.OutlineColor)
	local strokeTransparency=pick(style.StrokeTransparency,config.StrokeTransparency)
	local strokeThickness=pick(style.StrokeThickness,config.StrokeThickness)
	if (strokeColor~=nil or strokeTransparency~=nil or strokeThickness~=nil) then
		if not stroke then stroke=Create("UIStroke",{Parent=frame}) end
		if strokeColor~=nil then
			local resolved=XLQPResolveTagColor(strokeColor,nil)
			if resolved then stroke.Color=resolved stroke:SetAttribute("XLQPStyleLocked",true) end
		end
		if tonumber(strokeTransparency) then stroke.Transparency=math.clamp(tonumber(strokeTransparency),0,1) end
		if tonumber(strokeThickness) then stroke.Thickness=math.max(0,tonumber(strokeThickness)) end
	end
	local titleColor=pick(style.TitleColor,config.TitleColor,style.TextColor3)
	local descriptionColor=pick(style.DescriptionColor,config.DescriptionColor)
	local titleSize=pick(style.TitleSize,config.TitleSize)
	local fontValue=pick(style.Font,config.Font)
	local resolvedFont
	if fontValue~=nil then
		if typeof(fontValue)=="EnumItem" then
			resolvedFont=fontValue
		else
			local ok,found=pcall(function() return Enum.Font[tostring(fontValue):gsub("%s+","")] end)
			if ok then resolvedFont=found end
		end
	end
	for _,child in ipairs(frame:GetDescendants()) do
		if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
			local isTitle=child.Name=="Content" or child.Name=="Title" or child.Name=="EntryTitle"
			local isDescription=child.Name=="Description" or child.Name=="Desc" or child.Name=="EntryDescription"
			if titleColor~=nil and isTitle then
				local resolved=XLQPResolveTagColor(titleColor,nil)
				if resolved then child.TextColor3=resolved child:SetAttribute("XLQPTextColorOverride",resolved) end
			end
			if descriptionColor~=nil and isDescription then
				local resolved=XLQPResolveTagColor(descriptionColor,nil)
				if resolved then child.TextColor3=resolved child:SetAttribute("XLQPTextColorOverride",resolved) end
			end
			if tonumber(titleSize) and isTitle then child.TextSize=math.clamp(tonumber(titleSize),6,48) end
			if resolvedFont then child.Font=resolvedFont end
		end
	end
	if type(object)=="table" then
		function object:SetStyle(newStyle)
			if type(newStyle)~="table" then return self end
			XLQPApplyElementStyle(frame,{Style=newStyle},nil)
			return self
		end
	end
	return frame
end


XLQPGifDecoderUrl="https://gist.githubusercontent.com/ArvidSilverlock/38e25c9ddba8d63be3314580cd08c28d/raw"
local XLQPGifDecoder
local XLQPGifSupport
local XLQPGifSupportReason
local XLQPGifRuntime={}
XLQPGifRuntime.__index=XLQPGifRuntime

local function XLQPGifTrim(text)
	return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function XLQPGifSupported()
	if XLQPGifSupport~=nil then return XLQPGifSupport,XLQPGifSupportReason end
	if type(buffer)~="table" or type(buffer.create)~="function" or type(buffer.copy)~="function" then
		XLQPGifSupport=false
		XLQPGifSupportReason="This executor does not support buffers."
		return false,XLQPGifSupportReason
	end
	local contentOk,contentFromObject=pcall(function() return Content and Content.fromObject end)
	if not contentOk or type(contentFromObject)~="function" then
		XLQPGifSupport=false
		XLQPGifSupportReason="This executor does not support Content.fromObject."
		return false,XLQPGifSupportReason
	end
	local ok,editable=pcall(function()
		return game:GetService("AssetService"):CreateEditableImage({Size=Vector2.new(4,4)})
	end)
	if not ok or not editable then
		XLQPGifSupport=false
		XLQPGifSupportReason="This executor does not support EditableImage."
		return false,XLQPGifSupportReason
	end
	pcall(function() editable:Destroy() end)
	XLQPGifSupport=true
	XLQPGifSupportReason="Supported"
	return true,XLQPGifSupportReason
end

local function XLQPGifCleanHtml(text)
	text=tostring(text or "")
	text=text:gsub("\\u002F","/"):gsub("\\u003A",":"):gsub("\\u003F","?"):gsub("\\u0026","&"):gsub("\\u003D","="):gsub("\\/","/"):gsub("&amp;","&")
	return text
end

function XLQPGifTenorMedia(html)
	html=XLQPGifCleanHtml(html)
	local patterns={'property="og:image"%s+content="(https://[^"]+)"','name="twitter:image"%s+content="(https://[^"]+)"','"contentUrl":"(https://[^"]+)"','"image":"(https://[^"]+)"','"url":"(https://[^"]+)"'}
	for _,pattern in ipairs(patterns) do
		local result=html:match(pattern)
		if result then
			result=XLQPGifCleanHtml(result)
			if result:find("tenor") and result:lower():find("%.gif") then return result end
		end
	end
	local fallback
	for value in html:gmatch('https://[^"%s<>]+') do
		value=XLQPGifCleanHtml(value)
		if value:find("media%d*%.tenor%.com") then
			if value:lower():find("%.gif") then return value end
			if not fallback and value:find("/m/") then fallback=value end
		end
	end
	return fallback
end

function XLQPGifBytes(link)
	link=XLQPGifTrim(link)
	if link=="" then return nil,"Paste a GIF or Tenor URL first." end
	local function fetch(url,accept)
		local requester=XLQPResolveRequest()
		if type(requester)=="function" then
			local ok,response=pcall(requester,{
				Url=url,
				Method="GET",
				Headers={
					["User-Agent"]="Mozilla/5.0",
					["Accept"]=accept or "*/*"
				}
			})
			if ok and type(response)=="table" then
				local code=tonumber(response.StatusCode or response.Status) or 0
				local body=response.Body or response.body
				if type(body)=="string" and body~="" and (response.Success==true or code==0 or (code>=200 and code<300)) then
					return body
				end
			end
		end
		local ok,body=pcall(function() return game:HttpGet(url,true) end)
		if ok and type(body)=="string" and body~="" then return body end
	end
	local body=fetch(link,"image/gif,image/*,text/html,*/*")
	if not body then return nil,"The GIF could not be downloaded." end
	if body:sub(1,6)=="GIF87a" or body:sub(1,6)=="GIF89a" then return body end
	if link:lower():find("tenor%.com") then
		local mediaUrl=XLQPGifTenorMedia(body)
		if not mediaUrl then return nil,"A GIF file was not found on that Tenor page." end
		body=fetch(mediaUrl,"image/gif,image/*,*/*")
		if body and (body:sub(1,6)=="GIF87a" or body:sub(1,6)=="GIF89a") then return body end
		return nil,"Tenor returned invalid GIF data."
	end
	return nil,"The URL did not return a GIF file."
end

function XLQPGifGetDecoder()
	if type(XLQPGifDecoder)=="function" then return XLQPGifDecoder end
	if type(loadstring)~="function" then return nil end
	local source=XLQPSecureHttpGet(XLQPGifDecoderUrl)
	if type(source)~="string" or source=="" then return nil end
	local ok,result=pcall(function()
		local chunk=loadstring(source)
		return chunk and chunk()
	end)
	if ok and type(result)=="function" then XLQPGifDecoder=result end
	return XLQPGifDecoder
end

local function XLQPGifCloneBuffer(source)
	local output=buffer.create(buffer.len(source))
	buffer.copy(output,0,source,0,buffer.len(source))
	return output
end

local function XLQPGifSetPixel(target,offset,r,g,b,a)
	buffer.writeu8(target,offset,r)
	buffer.writeu8(target,offset+1,g)
	buffer.writeu8(target,offset+2,b)
	buffer.writeu8(target,offset+3,a)
end

function XLQPGifClearArea(canvas,canvasWidth,canvasHeight,x,y,width,height,r,g,b,a)
	local startX=math.max(0,x)
	local startY=math.max(0,y)
	local endX=math.min(canvasWidth-1,x+width-1)
	local endY=math.min(canvasHeight-1,y+height-1)
	if endX<startX or endY<startY then return end
	for py=startY,endY do
		for px=startX,endX do
			XLQPGifSetPixel(canvas,(py*canvasWidth+px)*4,r,g,b,a)
		end
	end
end

local function XLQPGifDrawPixel(canvas,canvasWidth,canvasHeight,palette,x,y,paletteIndex)
	if x<0 or y<0 or x>=canvasWidth or y>=canvasHeight then return end
	local paletteOffset=paletteIndex*3
	if paletteOffset+2>=buffer.len(palette) then return end
	XLQPGifSetPixel(canvas,(y*canvasWidth+x)*4,buffer.readu8(palette,paletteOffset),buffer.readu8(palette,paletteOffset+1),buffer.readu8(palette,paletteOffset+2),255)
end

function XLQPGifDrawFrame(canvas,gif,frame)
	local palette=frame.localPalette or gif.globalPalette
	if not palette then return end
	local transparentIndex=frame.transparentIndex
	local source=frame.paletteIndexes
	local sourceIndex=0
	if frame.isInterlaced then
		for _,pass in ipairs({{0,8},{4,8},{2,4},{1,2}}) do
			for row=pass[1],frame.height-1,pass[2] do
				for x=0,frame.width-1 do
					local paletteIndex=buffer.readu8(source,sourceIndex)
					sourceIndex+=1
					if transparentIndex==nil or paletteIndex~=transparentIndex then XLQPGifDrawPixel(canvas,gif.width,gif.height,palette,frame.left+x,frame.top+row,paletteIndex) end
				end
			end
		end
	else
		for y=0,frame.height-1 do
			for x=0,frame.width-1 do
				local paletteIndex=buffer.readu8(source,sourceIndex)
				sourceIndex+=1
				if transparentIndex==nil or paletteIndex~=transparentIndex then XLQPGifDrawPixel(canvas,gif.width,gif.height,palette,frame.left+x,frame.top+y,paletteIndex) end
			end
		end
	end
end

function XLQPGifRenderFrames(gif,isCancelled)
	local pixelCount=tonumber(gif.width)*tonumber(gif.height)
	if gif.width>1024 or gif.height>1024 then return nil,nil,"GIF dimensions exceed 1024 × 1024." end
	if #gif.frames>240 then return nil,nil,"GIF contains more than 240 frames." end
	if pixelCount*#gif.frames>24000000 then return nil,nil,"GIF needs too much animation memory." end
	local canvas=buffer.create(pixelCount*4)
	local frames={}
	local delays={}
	local backgroundR,backgroundG,backgroundB,backgroundA=0,0,0,0
	if gif.globalPalette and gif.backgroundIndex~=nil then
		local offset=gif.backgroundIndex*3
		if offset>=0 and offset+2<buffer.len(gif.globalPalette) then
			backgroundR=buffer.readu8(gif.globalPalette,offset)
			backgroundG=buffer.readu8(gif.globalPalette,offset+1)
			backgroundB=buffer.readu8(gif.globalPalette,offset+2)
			backgroundA=255
		end
	end
	local previousFrame
	local restoreBuffer
	for index,frame in ipairs(gif.frames) do
		if isCancelled and isCancelled() then return nil,nil,"Cancelled" end
		if previousFrame then
			local disposal=tonumber(previousFrame.disposalMethod) or 0
			if disposal==2 then
				XLQPGifClearArea(canvas,gif.width,gif.height,previousFrame.left,previousFrame.top,previousFrame.width,previousFrame.height,backgroundR,backgroundG,backgroundB,backgroundA)
			elseif disposal==3 and restoreBuffer then
				buffer.copy(canvas,0,restoreBuffer,0,buffer.len(restoreBuffer))
			end
		end
		restoreBuffer=(tonumber(frame.disposalMethod) or 0)==3 and XLQPGifCloneBuffer(canvas) or nil
		XLQPGifDrawFrame(canvas,gif,frame)
		frames[index]=XLQPGifCloneBuffer(canvas)
		local delay=tonumber(frame.frameDelay) or 0.08
		if delay>5 then delay/=100 end
		delays[index]=math.clamp(delay>0 and delay or 0.08,1/30,10)
		previousFrame=frame
		if index%2==0 then game:GetService("RunService").Heartbeat:Wait() end
	end
	return frames,delays
end

function XLQPGifRuntime.new(layers,notify)
	return setmetatable({Layers=layers or {},Notify=notify,Frames={},Delays={},FrameIndex=1,Elapsed=0,Token=0,Active=false},XLQPGifRuntime)
end

function XLQPGifRuntime:_Notify(text,success)
	if type(self.Notify)=="function" then pcall(self.Notify,tostring(text or ""),success==true) end
end

function XLQPGifRuntime:Stop(clearLayers)
	self.Token+=1
	self.Active=false
	if self.Connection then pcall(function() self.Connection:Disconnect() end) self.Connection=nil end
	if self.Editable then pcall(function() self.Editable:Destroy() end) self.Editable=nil end
	self.Content=nil
	self.Frames={}
	self.Delays={}
	self.FrameIndex=1
	self.Elapsed=0
	if clearLayers~=false then
		for _,layer in ipairs(self.Layers) do
			if layer and layer.Parent then
				pcall(function() layer.ImageContent=nil end)
				layer.Visible=false
			end
		end
	end
end

function XLQPGifRuntime:_ShowFrame(index)
	if not self.Editable or not self.Frames[index] then return end
	pcall(function() self.Editable:WritePixelsBuffer(Vector2.zero,Vector2.new(self.Width,self.Height),self.Frames[index]) end)
end

function XLQPGifRuntime:Apply(link,transparency)
	local supported,reason=XLQPGifSupported()
	if not supported then self:_Notify(reason,false) return false,reason end
	link=XLQPGifTrim(link)
	if link=="" then self:_Notify("Paste a GIF or Tenor URL first.",false) return false,"Missing URL" end
	if type(self.BeforeApply)=="function" then pcall(self.BeforeApply) end
	self:Stop(true)
	local token=self.Token
	self:_Notify("Downloading GIF…",true)
	local bytes,downloadError=XLQPGifBytes(link)
	if token~=self.Token then return false,"Cancelled" end
	if not bytes then self:_Notify(downloadError,false) return false,downloadError end
	self:_Notify("Decoding GIF…",true)
	local decoder=XLQPGifGetDecoder()
	if not decoder then self:_Notify("The GIF decoder is unavailable.",false) return false,"Decoder unavailable" end
	local decodeOk,gif=pcall(decoder,bytes)
	if token~=self.Token then return false,"Cancelled" end
	if not decodeOk or type(gif)~="table" or not gif.width or not gif.height or type(gif.frames)~="table" or #gif.frames==0 then
		self:_Notify("The GIF could not be decoded.",false)
		return false,"Decode failed"
	end
	self:_Notify("Building GIF frames…",true)
	local frames,delays,renderError=XLQPGifRenderFrames(gif,function() return token~=self.Token end)
	if token~=self.Token then return false,"Cancelled" end
	if not frames or #frames==0 then self:_Notify(renderError or "GIF frame build failed.",false) return false,renderError end
	local editableOk,editable=pcall(function()
		return game:GetService("AssetService"):CreateEditableImage({Size=Vector2.new(gif.width,gif.height)})
	end)
	if not editableOk or not editable then self:_Notify("EditableImage creation failed.",false) return false,"EditableImage failed" end
	if token~=self.Token then pcall(function() editable:Destroy() end) return false,"Cancelled" end
	self.Editable=editable
	self.Width=gif.width
	self.Height=gif.height
	self.Frames=frames
	self.Delays=delays
	self.FrameIndex=1
	self.Elapsed=0
	local contentOk,content=pcall(function() return Content.fromObject(editable) end)
	if not contentOk or not content then self:Stop(true) self:_Notify("This executor cannot display EditableImage content.",false) return false,"Display unsupported" end
	self.Content=content
	local displayed=false
	for _,layer in ipairs(self.Layers) do
		if layer and layer.Parent then
			layer.BackgroundTransparency=1
			layer.Image=""
			layer.ImageTransparency=math.clamp(tonumber(transparency) or 0.18,0,1)
			layer.ScaleType=Enum.ScaleType.Crop
			local ok=pcall(function() layer.ImageContent=content end)
			layer.Visible=ok
			displayed=displayed or ok
		end
	end
	if not displayed then self:Stop(true) self:_Notify("GIF display is unavailable in this executor.",false) return false,"Display unsupported" end
	self.Active=true
	self:_ShowFrame(1)
	self.Connection=game:GetService("RunService").Heartbeat:Connect(function(deltaTime)
		if not self.Active or #self.Frames==0 then return end
		if (tonumber(XLQPGen1._WindowMotionPausedUntil) or 0)>os.clock() then return end
		if self.BypassVisibilityCheck~=true then
			local runtimeState=XLQPGen1._WindowConfig and XLQPGen1._WindowConfig._LocalRegisterState
			local visibilityCheck=runtimeState and runtimeState.isGuiBranchVisible
			if type(visibilityCheck)=="function" then
				local anyVisible=false
				for _,layer in ipairs(self.Layers) do
					if layer and layer.Parent and layer.Visible and visibilityCheck(layer) then anyVisible=true break end
				end
				if not anyVisible then return end
			end
		end
		self.Elapsed+=deltaTime
		local needed=self.Delays[self.FrameIndex] or 0.08
		local advances=0
		while self.Elapsed>=needed and advances<4 do
			self.Elapsed-=needed
			self.FrameIndex=self.FrameIndex%#self.Frames+1
			needed=self.Delays[self.FrameIndex] or 0.08
			advances+=1
		end
		if advances>0 then self:_ShowFrame(self.FrameIndex) end
	end)
	self:_Notify("GIF background applied.",true)
	if XLQPGen1 and XLQPGen1._GifRuntime==self and XLQPGen1._SyncCustomLiveThemeSurfaces then
		task.defer(function()
			pcall(function() XLQPGen1:_SyncCustomLiveThemeSurfaces() end)
		end)
	end
	return true
end

function XLQPGen1:IsGifBackgroundSupported()
	return XLQPGifSupported()
end

function XLQPGen1:SetGifBackground(link,transparency)
	link=XLQPGifTrim(link)
	local runtime=self._GifRuntime
	if not runtime then return false,"Create a window before applying a GIF background." end
	if self._ReduceLagEnabled then return false,"Reduce Lag is enabled." end
	local supported,reason=XLQPGifSupported()
	if not supported then runtime:_Notify(reason,false) return false,reason end
	local config=self._WindowConfig or {}
	config.GifBackgroundUrl=link
	config.GifBackgroundEnabled=link~=""
	config.BackgroundEnabled=link~=""
	config.URLBackgroundEnabled=link~=""
	config.GifBackgroundTransparency=math.clamp(tonumber(transparency) or tonumber(config.GifBackgroundTransparency) or tonumber(config.BackgroundTransparency) or 0.18,0,1)
	self._WindowConfig=config
	if config._LocalRegisterState then config._LocalRegisterState.currentGifBackgroundUrl=link end
	if link=="" then self:RemoveGifBackground(true) return false,"Missing URL" end
	task.spawn(function()
		local ok=runtime:Apply(link,config.GifBackgroundTransparency)
		if not ok and config.GifBackgroundUrl==link then
			config.GifBackgroundEnabled=false
			if type(self._RestoreStaticBackground)=="function" then task.defer(self._RestoreStaticBackground) end
		end
	end)
	return true,"Loading"
end

function XLQPGen1:_SetGifBackgroundAwait(link,transparency,progressCallback)
	link=XLQPGifTrim(link)
	local runtime=self._GifRuntime
	if not runtime then return false,"Create a window before applying a GIF background." end
	if self._ReduceLagEnabled then return false,"Reduce Lag is enabled." end
	local supported,reason=XLQPGifSupported()
	if not supported then return false,reason end
	if link=="" then return false,"Missing URL" end

	local config=self._WindowConfig or {}
	config.GifBackgroundUrl=link
	config.GifBackgroundEnabled=true
	config.BackgroundEnabled=true
	config.GifBackgroundTransparency=math.clamp(tonumber(transparency) or tonumber(config.GifBackgroundTransparency) or tonumber(config.BackgroundTransparency) or 0.18,0,1)
	self._WindowConfig=config
	if config._LocalRegisterState then config._LocalRegisterState.currentGifBackgroundUrl=link end

	local previousNotify=runtime.Notify
	runtime.Notify=function(message,success)
		if type(previousNotify)=="function" then pcall(previousNotify,message,success) end
		if type(progressCallback)=="function" then pcall(progressCallback,tostring(message or ""),success==true) end
	end

	local ok,message=runtime:Apply(link,config.GifBackgroundTransparency)
	runtime.Notify=previousNotify

	if not ok then
		config.GifBackgroundEnabled=false
		return false,message
	end

	config.GifBackgroundEnabled=true
	config.BackgroundEnabled=true
	config.URLBackgroundEnabled=false
	return true,"Ready"
end

function XLQPGen1:RemoveGifBackground(restoreStatic)
	if self._GifRuntime then self._GifRuntime:Stop(true) end
	if self._WindowConfig then self._WindowConfig.GifBackgroundEnabled=false end
	if restoreStatic~=false and type(self._RestoreStaticBackground)=="function" then task.defer(self._RestoreStaticBackground) end
	return self
end

