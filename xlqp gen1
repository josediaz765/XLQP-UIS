			makeTool("+",38,function() Grid.BrushSize=math.min(28,Grid.BrushSize+1) updateStatus() end)
			makeTool("Clear",72,function() Grid:Clear() end)
			AddConnection(hitbox.InputBegan,begin)
			AddConnection(hitbox.InputChanged,move)
			AddConnection(UserInputService.InputEnded,finish)
			AddConnection(hitbox.MouseEnter,function() cursor.Visible=true end)
			AddConnection(hitbox.MouseLeave,function() cursor.Visible=false end)
			AddConnection(UserInputService.InputChanged,function(input)
				if cursor.Visible and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
					local x,y=clampPoint(input.Position)
					cursor.Position=UDim2.new(0,x+8,0,y+8)
