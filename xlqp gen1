	local function dismiss(applied)
		stopPreview()
		closeDropdown()
		TweenService:Create(window,TweenInfo.new(.16,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
			BackgroundTransparency=1
		}):Play()
		TweenService:Create(windowScale,TweenInfo.new(.16,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
			Scale=windowScale.Scale*.96
		}):Play()
		task.delay(.17,function()
			if menuGui and menuGui.Parent then menuGui:Destroy() end
			if self._CustomLiveMediaMenu==menuGui then self._CustomLiveMediaMenu=nil end
			if not applied then
				task.defer(function()
					if self._RefreshLiveColorDropdowns then self:_RefreshLiveColorDropdowns() end
					if WindowConfig._LocalRegisterState.liveColorThemeRefresh then
						pcall(WindowConfig._LocalRegisterState.liveColorThemeRefresh)
					end
				end)
			end
		end)
	end

	close.Activated:Connect(function() dismiss(false) end)
