		if not (toolbar and toolbar.Root and toolbar.Root.Parent and frame and frame.Parent and frame.Visible and self.EditableMode == true) then
			if toolbar and toolbar.Root then toolbar.Root.Visible = false end
			return
		end
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
		local width = toolbar.Root.AbsoluteSize.X > 0 and toolbar.Root.AbsoluteSize.X or 196
		local height = toolbar.Root.AbsoluteSize.Y > 0 and toolbar.Root.AbsoluteSize.Y or 36
		local position = frame.AbsolutePosition
		local size = frame.AbsoluteSize
		local x = math.clamp(position.X + size.X - width, 6, math.max(6, viewport.X - width - 6))
		local above = position.Y - height - 6
		local below = position.Y + size.Y + 6
		local y = above >= 6 and above or math.clamp(below, 6, math.max(6, viewport.Y - height - 6))
		local target=UDim2.fromOffset(x,y)
		toolbar.Root.Position=toolbar.Root.Visible and toolbar.Root.Position:Lerp(target,0.34) or target
		toolbar.Root.Visible = true
	end


