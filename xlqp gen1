function XLQPGen1.BytebeatTools:SplitTop(src)
	local out,start,depth,quote,esc={},1,0,nil,false
	for i=1,#src do
		local c=src:sub(i,i)
		if quote then
			if esc then esc=false elseif c=="\\" then esc=true elseif c==quote then quote=nil end
		else
			if c=="\"" or c=="'" then quote=c
			elseif c=="(" or c=="[" or c=="{" then depth=depth+1
			elseif c==")" or c=="]" or c=="}" then depth=math.max(0,depth-1)
			elseif depth==0 and (c=="," or c==";" or c=="\n") then
				local part=src:sub(start,i-1):gsub("^%s+",""):gsub("%s+$","")
				if part~="" then out[#out+1]=part end
				start=i+1
			end
		end
	end
	local part=src:sub(start):gsub("^%s+",""):gsub("%s+$","")
	if part~="" then out[#out+1]=part end
	return out
end
function XLQPGen1.BytebeatTools:FindAssign(src)
	local depth,quote,esc=0,nil,false
	for i=1,#src do
		local c=src:sub(i,i)
		if quote then
			if esc then esc=false elseif c=="\\" then esc=true elseif c==quote then quote=nil end
		else
			if c=="\"" or c=="'" then quote=c
			elseif c=="(" or c=="[" or c=="{" then depth=depth+1
			elseif c==")" or c=="]" or c=="}" then depth=math.max(0,depth-1)
			elseif depth==0 then
				local two=src:sub(i,i+1)
				if two=="+=" or two=="-=" or two=="*=" or two=="/=" or two=="%=" or two=="&=" or two=="|=" or two=="^=" then return i,two end
				if c=="=" and src:sub(i-1,i-1)~="=" and src:sub(i-1,i-1)~="!" and src:sub(i-1,i-1)~="<" and src:sub(i-1,i-1)~=">" and src:sub(i+1,i+1)~="=" and src:sub(i+1,i+1)~=">" then return i,"=" end
			end
		end
