	function controller:Download(entry,addToPlaylist,playNow)
		if self.Busy then return nil end
		self.Busy=true
		local ok,track=pcall(function()
			local id=entry.VideoId or XLQPYouTubeMusic.videoId(entry.URL)
			if not id then error("Invalid YouTube video") end
			local audioPath=folder.."/"..id..".mp3"
			local imagePath=folder.."/"..id.."_thumbnail.jpg"
			local image=type(isfile)=="function" and isfile(imagePath) and XLQPYouTubeMusic.asset(imagePath) or nil
			if not image then setStatus("Downloading YouTube thumbnail") image=XLQPYouTubeMusic.writeAsset(entry.ThumbnailUrl or ("https://i.ytimg.com/vi/"..id.."/hqdefault.jpg"),imagePath,{Accept="image/jpeg,image/*"}) end
			if not (type(isfile)=="function" and isfile(audioPath)) then
				local audioUrl,convertedTitle=XLQPYouTubeMusic.convert(id,converter,function(message) setStatus(message) end)
				entry.Title=entry.Title or convertedTitle
				setStatus("Downloading YouTube audio")
				local body=XLQPYouTubeMusic.request({Url=audioUrl,Method="GET",Headers={Accept="audio/mpeg,audio/mp3,application/octet-stream,*/*",["User-Agent"]="Mozilla/5.0"},Timeout=60}).Body
				local first,second=body:byte(1) or 0,body:byte(2) or 0
				if body:sub(1,3)~="ID3" and not (first==255 and second>=224) then error("Downloaded response is not MP3 audio") end
				writefile(audioPath,body)
			end
			local frameOk,frameData=pcall(XLQPYouTubeMusic.frames,id,folder,function(message) setStatus(message) end)
			if frameOk and type(frameData)=="table" then self.FrameCache[id]=frameData end
			return {name=entry.Title or id,url=audioPath,VideoId=id,Image=image,ImagePath=imagePath,ThumbnailUrl=entry.ThumbnailUrl,Channel=entry.Channel,SourceURL=entry.URL or ("https://www.youtube.com/watch?v="..id)}
		end)
		self.Busy=false
		if not ok then setStatus(track,true) return nil end
		setStatus("Downloaded "..tostring(track.name))
		if addToPlaylist then
			local _,index=mediaPlayer:AddToPlaylist(track)
			if center.RefreshQueue then center.RefreshQueue(true) end
			if playNow then mediaPlayer:PlayIndex(index or #mediaPlayer:GetPlaylist()) end
		end
		return track
	end
