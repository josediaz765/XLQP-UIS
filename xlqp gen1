						if not XLQPIsImageBody(bytes) then
							local requester=XLQPResolveRequest()
							if requester then
								local requestOk,response=pcall(requester,{Url=url,Method="GET",Headers={["Accept"]="image/*",["Referer"]="https://scriptblox.com/",["User-Agent"]="Mozilla/5.0"}})
								if requestOk and type(response)=="table" then bytes=response.Body or response.body end
							end
						end
						if not XLQPIsImageBody(bytes) then error("invalid image response") end
						writefile(filePath,bytes)
					end
					local asset=XLQPGetCustomAsset(filePath)
					if not asset then error("custom asset failed") end
					HubConfig._ImageAssetCache[url]=asset
					if imageLabel.Parent and imageLabel:GetAttribute("ScriptBloxImageURL")==url then XLQPAssignProperty(imageLabel,"Image",asset) end
				end)
