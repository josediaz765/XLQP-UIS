	end
	local function closeDropdown()
		opened=false
		openHeight=0
		if list and list.Parent then
			list.Size=UDim2.new(0,button.AbsoluteSize.X > 0 and button.AbsoluteSize.X or dropdownWidth,0,0)
			list.Visible=false
		end
	end
	table.insert(WindowConfig._LocalRegisterState.settingsDropdownClosers, closeDropdown)
	local function syncPopupPosition()
		if not opened or not (list and list.Parent and button and button.Parent) then return end
		if SettingsWindow and not SettingsWindow.Visible then closeDropdown() return end
		local abs=button.AbsolutePosition
		local absSize=button.AbsoluteSize
		local viewport=(workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(1920,1080)
		local width=math.max(80,absSize.X>0 and absSize.X or dropdownWidth)
		local x=math.clamp(abs.X,8,math.max(8,viewport.X-width-8))
		local belowY=abs.Y+absSize.Y+5
		local y=(belowY+openHeight<=viewport.Y-8) and belowY or math.max(8,abs.Y-openHeight-5)
		list.Position=UDim2.fromOffset(math.floor(x+.5),math.floor(y+.5))
		if list.Size.X.Offset~=math.floor(width+.5) then list.Size=UDim2.fromOffset(math.floor(width+.5),list.Size.Y.Offset) end
	end
	local popupSyncs=WindowConfig._LocalRegisterState.settingsPopupSyncs
	if not popupSyncs then
		popupSyncs={}
		WindowConfig._LocalRegisterState.settingsPopupSyncs=popupSyncs
		local popupElapsed=0
		AddConnection(RunService.Heartbeat,function(deltaTime)
			if SettingsWindow and not SettingsWindow.Visible then return end
			popupElapsed=popupElapsed+(tonumber(deltaTime) or 0)
			if popupElapsed<(XLQPGen1._ReduceLagEnabled and 0.1 or 0.05) then return end
			popupElapsed=0
			for index=1,#popupSyncs do
				local sync=popupSyncs[index]
				if sync then sync() end
			end
		end)
	end
	popupSyncs[#popupSyncs+1]=syncPopupPosition
	AddConnection(button.Activated,function()
		pcall(function() XLQPGen1:Haptic(0.28,0.02) end)
		for _, close in ipairs(WindowConfig._LocalRegisterState.settingsDropdownClosers) do
			if close ~= closeDropdown then pcall(close) end
		end
		local count=refresh()
		opened=not opened
		list.Visible=true
		list.Parent=XLQPGen1Gui
		openHeight=opened and math.clamp(count*(fontPreview and 53 or 35)+8,40,fontPreview and 318 or 220) or 0
		syncPopupPosition()
		TweenService:Create(list,TweenInfo.new(0.16),{Size=UDim2.new(0,button.AbsoluteSize.X > 0 and button.AbsoluteSize.X or dropdownWidth,0,openHeight)}):Play()
		if not opened then task.delay(0.17,function() list.Visible=false end) end
	end)
	refresh()
	return refresh
end

