				applyFontPreview(sample,option) applyFontPreview(rowLabel,option) applyFontPreview(preview,option)
			else
				local rowLabel=AddThemeObject(SetProps(MakeElement("Label",tostring(option),12),{Size=UDim2.new(1,-12,1,0),Position=UDim2.new(0,8,0,0),Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,TextStrokeTransparency=1,ZIndex=520002}),"Text")
