	apply.Activated:Connect(function()
		local link=tostring(linkBox.Text or ""):match("^%s*(.-)%s*$")
		if link=="" then
			status.Text="Paste an image, GIF or video link first."
			return
		end
		local themeName=tostring(nameBox.Text or ""):match("^%s*(.-)%s*$")
		if themeName=="" then
			themeName=self:_CustomLiveMediaDisplayName(link)
			nameBox.Text=themeName
		end
		local mediaType=self:_DetectCustomLiveMediaType(link)
		local candidateData={
			CustomMedia=true,
			MediaType=mediaType,
			MediaLink=link,
			Name=themeName,
			ImageTransparency=.14,
			Sync=sync
		}
		candidateData.ProgressCallback=function(message)
			if menuGui and menuGui.Parent then status.Text=tostring(message or "") end
		end
		status.Text=mediaType=="GIF" and "Downloading and decoding GIF…" or ("Applying "..mediaType:lower().."…")
		apply.Active=false
		cancel.Active=false
		task.spawn(function()
			local applied,errorMessage=self:_ApplyCustomLiveThemeMedia(candidateData)
			candidateData.ProgressCallback=nil
			if not applied then
				apply.Active=true
				cancel.Active=true
				status.Text=tostring(errorMessage or "Custom media could not be applied.")
				return
			end

			local colorSource=previousTheme~="Custom" and XLQPLiveColorThemes[previousTheme] or XLQPLiveColorThemes.Custom
			if colorSource then XLQPLiveColorThemes.Custom=colorSource end
			self.LiveColorThemeData.Custom=candidateData
			WindowConfig.LiveColorTheme="Custom"
			WindowConfig.LiveColorThemeImages=true
			self._ApplyingCustomLiveMedia=true
			self:SetLiveColorTheme("Custom")
			self:SetLiveColorThemeImages(true)
			self._ApplyingCustomLiveMedia=nil

			if sync and self.SetTransparentUI then self:SetTransparentUI(true) end
			self:_SyncCustomLiveThemeSurfaces()

			local saveOk,saveMessage=self:SaveCustomLiveMediaTheme({
				Name=themeName,
				Link=link,
				Type=mediaType,
				Sync=sync,
				Transparency=.14
			})

			apply.Active=true
			cancel.Active=true
			if not saveOk and saveMessage then
				self:MakeNotification({
					Name="Custom Live Theme",
					Content="Applied, but could not save: "..tostring(saveMessage),
					Image="triangle-alert",
					Time=4
				})
			else
				self:MakeNotification({
					Name="Custom Live Theme",
					Content="Applied "..themeName..".",
					Image="image",
					Time=3
				})
			end
			if self._RefreshLiveColorDropdowns then self:_RefreshLiveColorDropdowns() end
			if WindowConfig._LocalRegisterState.liveColorThemeRefresh then
				pcall(WindowConfig._LocalRegisterState.liveColorThemeRefresh)
			end
			dismiss(true)
		end)
	end)

