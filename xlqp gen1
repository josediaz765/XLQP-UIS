	end
	local function Refresh()
		if Soccer.Busy or Soccer.Destroyed then return end
		Soccer.Busy=true
		StatusLabel.Text="Loading"
		StatusDot.BackgroundColor3=Color3.fromRGB(245,190,75)
		RefreshButton.Text="..."
		SummaryLive.Visible=false
		ClearMatches()
		AddEmpty("Loading soccer matches...",false)
		task.spawn(function()
			local Slug=Leagues[Soccer.League] or Soccer.League or "fifa.world"
			local Date=DateValue(Soccer.DateOffset)
			local Ok,Body,Code,Data,Source=RequestScoreboard(Slug,Date,Soccer.DateOffset)
			ClearMatches()
			if not Ok then
				AddEmpty("Could not load matches after trying every ESPN route. HTTP "..tostring(Code~=0 and Code or "request failed"),true)
				StatusLabel.Text="Offline"
				StatusDot.BackgroundColor3=Color3.fromRGB(226,79,92)
				SummaryText.Text=Soccer.League.."  •  "..Date
				Soccer.Matches={}
			else
				local Events=type(Data)=="table" and Data.events or {}
				Soccer.Matches=Events
				Soccer.LastSource=Source or "ESPN"
				SummaryText.Text=Soccer.League.."  •  "..Date.."  •  "..tostring(#Events).." match"..(#Events==1 and "" or "es")
				if #Events==0 then AddEmpty("No matches found for this date.",false) else for Index,Event in ipairs(Events) do AddMatch(Event,Index) end end
				StatusLabel.Text="Updated "..os.date("%H:%M")
				StatusDot.BackgroundColor3=Color3.fromRGB(83,220,145)
			end
			RefreshButton.Text="Refresh"
			Soccer.Busy=false
			SafeCallback(SoccerConfig.Callback,SoccerConfig.Name or "Soccer",Soccer.Matches,Soccer)
		end)
	end
	for _,LeagueName in ipairs(LeagueOrder) do
		if Leagues[LeagueName] then
			local Button=noGlass(themed(Create("TextButton",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=LeagueName==Soccer.League and 0.08 or 0.34,BorderSizePixel=0,Text=LeagueName,Font=Enum.Font.GothamBold,TextSize=10,ZIndex=401,Parent=LeagueMenu}),"Second"))
			rounded(Button,8)
			if LeagueName==Soccer.League then Button.BackgroundColor3=Color3.fromRGB(52,91,184) end
			Button.TextColor3=Color3.fromRGB(244,247,255)
			Button.Activated:Connect(function()
				Soccer.League=LeagueName
				LeagueButton.Text=LeagueName.."  ▼"
				LeagueMenu.Visible=false
				LeagueMenu.Size=UDim2.new(0.36,-4,0,0)
				Refresh()
			end)
		end
	end
	LeagueButton.Activated:Connect(function()
		LeagueMenu.Visible=not LeagueMenu.Visible
		LeagueMenu.Size=LeagueMenu.Visible and UDim2.new(0.36,-4,0,(#LeagueOrder*34)+12) or UDim2.new(0.36,-4,0,0)
		LeagueButton.Text=Soccer.League..(LeagueMenu.Visible and "  ▲" or "  ▼")
	end)
	PreviousButton.Activated:Connect(function() Soccer.DateOffset-=1 Refresh() end)
	TodayButton.Activated:Connect(function() Soccer.DateOffset=0 Refresh() end)
	NextButton.Activated:Connect(function() Soccer.DateOffset+=1 Refresh() end)
	RefreshButton.Activated:Connect(Refresh)
	AutoButton.Activated:Connect(function() Soccer.AutoRefresh=not Soccer.AutoRefresh SetAutoVisual() end)
	function Soccer:SetLeague(Value)
		if Leagues[Value] then Soccer.League=Value else for Name,Slug in pairs(Leagues) do if Slug==Value then Soccer.League=Name break end end end
		LeagueButton.Text=Soccer.League.."  ▼"
		Refresh()
	end
	function Soccer:SetDate(Value)
		if type(Value)=="number" then Soccer.DateOffset=Value else
			local Target=tostring(Value or ""):gsub("%D","")
			if #Target==8 then
				local Year,Month,Day=tonumber(Target:sub(1,4)),tonumber(Target:sub(5,6)),tonumber(Target:sub(7,8))
				if Year and Month and Day then Soccer.DateOffset=math.floor((os.time({year=Year,month=Month,day=Day,hour=12})-os.time())/86400+0.5) end
			end
		end
		Refresh()
	end
	function Soccer:Refresh() Refresh() end
	function Soccer:SetAutoRefresh(Value) Soccer.AutoRefresh=Value==true SetAutoVisual() end
	function Soccer:GetMatches() return Soccer.Matches end
	function Soccer:GetSource() return Soccer.LastSource end
	function Soccer:Destroy() Soccer.Destroyed=true if Root and Root.Parent then Root:Destroy() end end
	Soccer.Wrapper=Root
	WindowConfig._LocalRegisterState.SetupElement(SoccerConfig,Root,RefreshButton,Soccer)
	table.insert(XLQPGen1.AllElements,Soccer)
	SetAutoVisual()
	task.spawn(function()
		if SoccerConfig.AutoLoad ~= false then
			task.wait(0.4)
			Refresh()
		else
			ClearMatches()
			AddEmpty("Press Refresh to load matches.", false)
			StatusLabel.Text = "Ready"
		end
		while Root.Parent and not Soccer.Destroyed do task.wait(SoccerConfig.RefreshTime) if Soccer.AutoRefresh and not Soccer.Busy then Refresh() end end
	end)
	return Soccer
end


