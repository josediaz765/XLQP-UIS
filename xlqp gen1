function SharedAIService:Chat(messages, fallbackPrompt, validator)
	local config = self:Load()
	local normalized = {}
	for _, message in ipairs(messages or {}) do
		if type(message) == "table" and tostring(message.content or "") ~= "" then normalized[#normalized + 1] = {role = tostring(message.role or "user"), content = tostring(message.content or "")} end
	end
	if #normalized == 0 then normalized = {{role = "system", content = config.SystemPrompt}, {role = "user", content = tostring(fallbackPrompt or "")}} end
	local errors = {}
	local function accept(answer, provider)
		local clean = sharedAIClean(answer)
		if clean == "" then return false end
		if type(validator) ~= "function" then return true end
		local ok, accepted, reason = pcall(validator, clean, provider)
		if not ok then
			errors[#errors + 1] = tostring(provider) .. ": response validator failed"
			return false
		end
		if accepted == false then
			errors[#errors + 1] = tostring(provider) .. ": " .. tostring(reason or "response did not answer the question")
			return false
		end
		return true
	end
	if config.CustomEnabled and (sharedAIClean(config.APIUrl) ~= "" or sharedAIClean(config.APISource) ~= "") then
		local answer, err = self:RunCustom(normalized, fallbackPrompt)
		if answer and accept(answer, "Custom API") then return true, sharedAIClean(answer), "Custom API" end
		errors[#errors + 1] = "Custom API: " .. tostring(err or "failed")
	end
	local order = {config.Provider}
	for _, provider in ipairs(self.ProviderNames) do if provider ~= config.Provider then order[#order + 1] = provider end end
	for _, provider in ipairs(order) do
		local runner = self.ProviderFunctions[provider]
		if runner then
			local ok, answer, err = pcall(function() return runner(self, normalized, fallbackPrompt) end)
			if ok and answer and accept(answer, provider) then return true, sharedAIClean(answer), provider end
			errors[#errors + 1] = provider .. ": " .. tostring(ok and err or answer or "failed")
		end
	end
	return false, table.concat(errors, " | "), nil
end

