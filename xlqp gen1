			local function render()
				for _,child in ipairs(strip:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
				for _,child in ipairs(fullList:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
				local playing={}
				for _,entry in ipairs(Friends.Entries) do
					if entry.InGame then playing[#playing+1]=entry end
				end
				local shown=math.min(#playing,columns)
				for index=1,shown do makeActivityCard(playing[index],index) end
				for index,entry in ipairs(Friends.Entries) do makeListRow(entry,index) end
				strip.Visible=not expanded
				fullList.Visible=expanded
				if expanded then
					emptyLabel.Visible=#Friends.Entries==0
					emptyLabel.Text="No friends found"
				else
					emptyLabel.Visible=shown==0
					emptyLabel.Text=#Friends.Entries>0 and "No friends are in a game right now" or "No friends found"
				end
				viewAllLabel.Text=expanded and "Show Less" or "View All"
				viewAllArrow.Rotation=expanded and 180 or 0
				viewAll.Visible=showViewAll and #Friends.Entries>0
				frame.Size=UDim2.new(1,0,0,expanded and expandedHeight or collapsedHeight)
			end

			local function refreshFromServer()
				local entries={}
				for _,player in ipairs(Players:GetPlayers()) do
					if player~=localPlayer then
						local ok,isFriend=pcall(function() return localPlayer:IsFriendsWith(player.UserId) end)
						if ok and isFriend then
							entries[#entries+1]={
								UserId=player.UserId,Name=player.Name,DisplayName=player.DisplayName,
								InGame=true,Online=true,GameName="This server",
								ActiveText=tostring(#Players:GetPlayers()).." in server",
								StatusText="In this server",PlaceId=game.PlaceId,Player=player
							}
						end
					end
				end
				Friends.Entries=entries
				render()
			end

			local refreshToken=0
			local function refreshFromWeb()
				refreshToken+=1
				local token=refreshToken
				task.spawn(function()
					local userId=localPlayer and localPlayer.UserId
					if not userId then return end
					local data=httpJson("https://friends.roblox.com/v1/users/"..tostring(userId).."/friends")
					if not data or type(data.data)~="table" or token~=refreshToken then return end
					local ids={}
					local byId={}
					for _,friend in ipairs(data.data) do
						local id=tonumber(friend.id)
						if id then
							ids[#ids+1]=id
							byId[id]={UserId=id,Name=tostring(friend.name or ""),DisplayName=tostring(friend.displayName or friend.name or "Friend"),InGame=false,Online=false,StatusText="Offline"}
						end
					end
					if #ids==0 then return end
					local batch={}
					for index=1,math.min(#ids,200) do batch[index]=ids[index] end
					local presence=httpPostJson("https://presence.roblox.com/v1/presence/users",{userIds=batch})
					if presence and type(presence.userPresences)=="table" then
						for _,entry in ipairs(presence.userPresences) do
							local id=tonumber(entry.userId)
							local record=id and byId[id]
							if record then
								local presenceType=tonumber(entry.userPresenceType) or 0
								record.Online=presenceType>0
								record.InGame=presenceType==2
								record.PlaceId=tonumber(entry.rootPlaceId or entry.placeId)
								record.GameName=tostring(entry.lastLocation or "")
								if record.GameName=="" then record.GameName=record.InGame and "In game" or "Website" end
								if record.InGame then
									record.StatusText="Playing "..record.GameName
								elseif presenceType==3 then
									record.StatusText="In Studio"
								elseif record.Online then
									record.StatusText="Online"
								else
									record.StatusText="Offline"
								end
							end
						end
					end
					local ordered={}
					for _,id in ipairs(ids) do
						local record=byId[id]
						if record then ordered[#ordered+1]=record end
					end
					table.sort(ordered,function(a,b)
						if a.InGame~=b.InGame then return a.InGame end
						if a.Online~=b.Online then return a.Online end
						return tostring(a.DisplayName):lower()<tostring(b.DisplayName):lower()
					end)
					if token~=refreshToken then return end
					Friends.Entries=ordered
					render()
					local filled=0
					for _,record in ipairs(ordered) do
						if record.InGame and record.PlaceId and filled<columns then
							filled+=1
							local count=activeCount(record.PlaceId)
							if token~=refreshToken then return end
							record.ActiveText=count and (formatPlayers(count).." active") or "In game"
						end
					end
					if token==refreshToken then render() end
				end)
			end

			AddConnection(viewAll.Activated,function()
				expanded=not expanded
				render()
			end)
			AddConnection(viewAll.MouseEnter,function()
				TweenService:Create(viewAllArrow,TweenInfo.new(0.16),{ImageTransparency=0}):Play()
			end)
			AddConnection(viewAll.MouseLeave,function()
				TweenService:Create(viewAllArrow,TweenInfo.new(0.18),{ImageTransparency=0.2}):Play()
			end)

			function Friends:Refresh()
				refreshFromWeb()
				return self
			end
			function Friends:SetExpanded(value)
				expanded=value==true
				render()
				return self
			end
			function Friends:Toggle()
				expanded=not expanded
				render()
				return self
			end
			function Friends:GetEntries() return self.Entries end
			function Friends:GetPlaying()
				local list={}
				for _,entry in ipairs(self.Entries) do
					if entry.InGame then list[#list+1]=entry end
				end
				return list
			end

			refreshFromServer()
			refreshFromWeb()
			table.insert(Friends.Connections,Players.PlayerAdded:Connect(function() task.defer(function() if #Friends.Entries==0 then refreshFromServer() end end) end))
			table.insert(Friends.Connections,Players.PlayerRemoving:Connect(function() task.defer(function() if #Friends.Entries==0 then refreshFromServer() end end) end))
			if FriendsConfig.AutoRefresh~=false and WindowConfig._LocalRegisterState.registerPeriodic then
				WindowConfig._LocalRegisterState.registerPeriodic(Friends,math.clamp(tonumber(FriendsConfig.RefreshRate) or 45,15,600),function()
					if frame.Parent then refreshFromWeb() end
				end,frame,false,false)
			end
			Friends.Wrapper=frame
			table.insert(XLQPGen1.AllElements,Friends)
			WindowConfig._LocalRegisterState.SetupElement(FriendsConfig,frame,nil,Friends)
			return Friends
		end
