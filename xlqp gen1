function XLQPGen1:AddDraggableLabel(Text)
	local labelConfig = type(Text) == "table" and Text or {Text = Text}
	local labelText = tostring(labelConfig.Text or labelConfig.Name or "")
	local showStats = labelConfig.fps == true or labelConfig.FPS == true or labelConfig.ShowStats == true

	if not XLQPGen1._refreshFloatingLabels then
		function XLQPGen1:_refreshFloatingLabels(refreshStyle)
			for _,floatingLabel in ipairs(self._floatingLabels or {}) do
				if floatingLabel and floatingLabel.UpdateDisplay then floatingLabel:UpdateDisplay() end
				if refreshStyle==true and floatingLabel and floatingLabel.RefreshStyle then floatingLabel:RefreshStyle() end
			end
		end
	end

	if showStats and not XLQPGen1._floatingStatsStarted then
		XLQPGen1._floatingStatsStarted = true
		local shared = XLQPGen1._WindowConfig and XLQPGen1._WindowConfig._LocalRegisterState
		XLQPGen1._floatingStatsFPS = math.floor(tonumber(shared and shared.fps) or 0)
		XLQPGen1._floatingStatsPing = math.floor(tonumber(shared and shared.ping) or 0)
	end

	 LabelFrame = AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(255,255,255), 0, 7), {
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(0, 0, 0, 0),
		Position = UDim2.new(0, 12, 0, 12),
		ZIndex = 25,
		Parent = XLQPGen1Gui
	}), {
		Create("UIPadding", {
			PaddingTop = UDim.new(0, 7),
			PaddingBottom = UDim.new(0, 7),
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 14)
		}),
		AddThemeObject(MakeElement("Stroke"), "Stroke")
	}), "Second")

	 Label = AddThemeObject(SetProps(MakeElement("Label", labelText, 15), {
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 26,
		Font = Enum.Font.GothamSemibold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = LabelFrame
	}), "Text")

	MakeDraggable(LabelFrame, LabelFrame)

	local LabelGui = {
		Frame = LabelFrame,
		Label = Label,
		BaseText = labelText,
		ShowStats = showStats
	}

	function LabelGui:RefreshStyle()
		local themeTable = XLQPGen1.Themes[XLQPGen1.SelectedTheme] or XLQPGen1.Themes.Default
		local stroke = LabelFrame:FindFirstChildOfClass("UIStroke")
		local corner = LabelFrame:FindFirstChildOfClass("UICorner")
		local isNewUI = XLQPGen1._newUIEnabled == true
		if corner then
			corner.CornerRadius = UDim.new(0, isNewUI and 12 or 8)
		end
		if isNewUI then
			LabelFrame.BackgroundColor3 = Color3.fromRGB(30, 35, 43)
			LabelFrame.BackgroundTransparency = 0.12
			if stroke then
				stroke.Enabled = true
				stroke.Color = Color3.fromRGB(187, 198, 216)
				stroke.Transparency = 0.38
				stroke.Thickness = 1.15
			end
		else
			LabelFrame.BackgroundColor3 = (themeTable.Second or Color3.fromRGB(28, 28, 28)):Lerp(themeTable.Main or Color3.fromRGB(10, 10, 10), 0.2)
			LabelFrame.BackgroundTransparency = 0
			if stroke then
				stroke.Enabled = true
				stroke.Color = themeTable.Stroke or Color3.fromRGB(110, 110, 110)
				stroke.Transparency = 0.15
				stroke.Thickness = 1
			end
		end
		Label.TextColor3 = themeTable.Text or Color3.fromRGB(255, 255, 255)
	end

	function LabelGui:UpdateDisplay()
		local composed = self.BaseText or ""
		if self.ShowStats then
			local statsText = string.format("%d FPS | %d ms", XLQPGen1._floatingStatsFPS or 0, XLQPGen1._floatingStatsPing or 0)
			if composed ~= "" then
				composed = composed .. " | " .. statsText
			else
				composed = statsText
			end
		end
		Label.Text = composed
	end

	function LabelGui:SetText(NewText)
		self.BaseText = tostring(NewText or "")
		self:UpdateDisplay()
	end

	function LabelGui:SetStatsVisible(Visible)
		self.ShowStats = Visible == true
		self:UpdateDisplay()
	end

	function LabelGui:SetVisible(Visible)
		LabelFrame.Visible = Visible == true
	end

	function LabelGui:Destroy()
		for index, floatingLabel in ipairs(XLQPGen1._floatingLabels or {}) do
			if floatingLabel == self then
				table.remove(XLQPGen1._floatingLabels, index)
				break
			end
		end
		if LabelFrame then
			LabelFrame:Destroy()
		end
	end
	LabelGui.Remove = LabelGui.Destroy

	XLQPGen1._floatingLabels = XLQPGen1._floatingLabels or {}
	table.insert(XLQPGen1._floatingLabels, LabelGui)
	LabelGui:UpdateDisplay()
	LabelGui:RefreshStyle()

	return LabelGui
end

