end
local function XLQPSetupDecodeState(state)
	local copy=XLQPSetupClone(state)
	if type(copy)=="table" and type(copy.Accent)=="table" and copy.Accent.__type=="Color3" then
		local accent=copy.Accent
		copy.Accent=Color3.new(tonumber(accent.R) or 0,tonumber(accent.G) or 0,tonumber(accent.B) or 0)
	end
	return copy
