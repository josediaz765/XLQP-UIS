			local function readLatencyMs()
				local value
				pcall(function()
					local item=statsService.Network and statsService.Network.ServerStatsItem and statsService.Network.ServerStatsItem["Data Ping"]
					if item then value=item:GetValue() end
				end)
				value=tonumber(value)
				if value and value>0 and value<10000 then return math.floor(value+0.5) end
				pcall(function()
					if LocalPlayer and LocalPlayer.GetNetworkPing then value=LocalPlayer:GetNetworkPing()*2000 end
				end)
				value=tonumber(value)
				if value and value>0 and value<10000 then return math.floor(value+0.5) end
				return nil
			end
			local function latencyColor(value)
				if not value then return Color3.fromRGB(122,130,148) end
				if value<=80 then return Color3.fromRGB(72,220,148) end
				if value<=150 then return Color3.fromRGB(255,190,92) end
				return Color3.fromRGB(255,104,116)
			end
			local function latencyWord(value)
				if not value then return "waiting for ping" end
				if value<=80 then return "stable connection" end
				if value<=150 then return "playable connection" end
				return "high latency"
			end
			local sessionWorkerToken=0
			local function sessionIsVisible()
				if not alive or not frame.Parent then return false end
				local state=WindowConfig._LocalRegisterState
				if state and type(state.isGuiBranchVisible)=="function" then
					local ok,visible=pcall(state.isGuiBranchVisible,frame)
					if ok then return visible==true end
				end
				local current=frame
				while current do
					if current:IsA("GuiObject") and current.Visible==false then return false end
					current=current.Parent
				end
				return true
			end
			local function updateSessionLatency()
				local ping=readLatencyMs()
				local valueText=ping and (tostring(ping).." ms") or "-- ms"
				if latencyValue.Text~=valueText then latencyValue.Text=valueText end
				local valueColor=latencyColor(ping)
				if latencyValue.TextColor3~=valueColor then latencyValue.TextColor3=valueColor end
				local qualityText=latencyWord(ping)
				if latencyQuality.Text~=qualityText then latencyQuality.Text=qualityText end
				if ping then
					if #Session.LatencySamples>=42 then table.remove(Session.LatencySamples,1) end
					Session.LatencySamples[#Session.LatencySamples+1]=ping
				end
				local min,max,total=nil,nil,0
				for _,value in ipairs(Session.LatencySamples) do
					min=math.min(min or value,value)
					max=math.max(max or value,value)
					total+=value
				end
				local statsText
				if #Session.LatencySamples>0 then
					statsText="avg "..tostring(math.floor(total/#Session.LatencySamples+0.5)).."  |  min "..tostring(min).."  |  max "..tostring(max)
				else
					statsText="avg --  |  min --  |  max --"
				end
				if latencyStats.Text~=statsText then latencyStats.Text=statsText end
				local sampleCount=#Session.LatencySamples
				local denominator=math.max(1,sampleCount-1)
				for index=1,sampleCount do
					local value=Session.LatencySamples[index]
					local sample=getChartSample(index)
					local sampleHeight=math.clamp((value/260)*50,3,50)
					local nextPosition=UDim2.new((index-1)/denominator,0,1,0)
					local nextSize=UDim2.new(0,4,0,sampleHeight)
					local nextColor=latencyColor(value)
					if sample.Position~=nextPosition then sample.Position=nextPosition end
					if sample.Size~=nextSize then sample.Size=nextSize end
					if sample.BackgroundColor3~=nextColor then sample.BackgroundColor3=nextColor end
					if not sample.Visible then sample.Visible=true end
				end
				for index=sampleCount+1,#chartSamples do
					local sample=chartSamples[index]
					if sample and sample.Visible then sample.Visible=false end
				end
			end
			local function refreshSessionWorker()
				sessionWorkerToken+=1
				if not sessionIsVisible() then return end
				local token=sessionWorkerToken
				task.spawn(function()
					updateSessionLatency()
					while alive and frame.Parent and token==sessionWorkerToken do
						task.wait(1)
						if token~=sessionWorkerToken or not sessionIsVisible() then return end
						updateSessionLatency()
					end
				end)
			end
			do
				local current=frame
				while current do
					if current:IsA("GuiObject") then
						AddConnection(current:GetPropertyChangedSignal("Visible"),refreshSessionWorker)
					end
					current=current.Parent
				end
			end
