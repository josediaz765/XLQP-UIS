			self.Container:SetAttribute("XLQPDetachedLayout",false)
			self.Container.Visible=false
			self.Container.Parent=self.OriginalParent
			self.Container.AnchorPoint=self.OriginalAnchorPoint
			self.Container.Position=self.OriginalPosition
			self.Container.Size=self.OriginalSize
			self.Container.ZIndex=self.OriginalZIndex
			self.Container.CanvasPosition=self.OriginalCanvasPosition or Vector2.new(0,0)
		end
		if self.Gui then self.Gui.Enabled=false end
		return window
	end

