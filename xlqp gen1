function XLQPGen1:_SetQuickActivePanelVisible(value)
	local config=self:_GetTopBarQuickPanelsConfig()
	if not config or config.Toggles==false then return end
	value=value==true
	if value and self._QuickNotificationsPanelOpen then self:_SetQuickNotificationsPanelVisible(false) end
	local panel=self:_BuildQuickPanelShell("toggles",tostring(config.TogglesTitle or "Active Toggles"),math.clamp(tonumber(config.PanelWidth) or 320,260,520),math.clamp(tonumber(config.PanelHeight) or 360,220,620),self._QuickToggleButton)
	if not panel then return end
	self._QuickActivePanelOpen=value
	if value then
		self:_RefreshQuickActiveToggles()
		self:_RaiseQuickPanelZ(panel)
		self:_QuickPanelPosition(panel,self._QuickToggleButton)
		panel.Visible=true
		panel.GroupTransparency=1
		TweenService:Create(panel,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{GroupTransparency=0}):Play()
	else
		TweenService:Create(panel,TweenInfo.new(.14,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{GroupTransparency=1}):Play()
		task.delay(.15,function() if panel and panel.Parent and not self._QuickActivePanelOpen then panel.Visible=false end end)
	end
end

function XLQPGen1:_SetQuickNotificationsPanelVisible(value)
	local config=self:_GetTopBarQuickPanelsConfig()
	if not config or config.Notifications==false then return end
	value=value==true
	if value and self._QuickActivePanelOpen then self:_SetQuickActivePanelVisible(false) end
	local panel=self:_BuildQuickPanelShell("notifications",tostring(config.NotificationsTitle or "Notifications"),math.clamp(tonumber(config.NotificationPanelWidth or config.PanelWidth) or 340,280,560),math.clamp(tonumber(config.NotificationPanelHeight or config.PanelHeight) or 380,240,660),self._QuickNotificationButton)
	if not panel then return end
	self._QuickNotificationsPanelOpen=value
	if value then
		self._QuickNotificationUnread=0
		self:_RefreshQuickNotifications()
		self:_RaiseQuickPanelZ(panel)
		self:_UpdateQuickPanelBadges()
		self:_QuickPanelPosition(panel,self._QuickNotificationButton)
		panel.Visible=true
		panel.GroupTransparency=1
		TweenService:Create(panel,TweenInfo.new(.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{GroupTransparency=0}):Play()
	else
		TweenService:Create(panel,TweenInfo.new(.14,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{GroupTransparency=1}):Play()
		task.delay(.15,function() if panel and panel.Parent and not self._QuickNotificationsPanelOpen then panel.Visible=false end end)
	end
end

