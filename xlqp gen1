		local ok,list,nextToken,prevToken=pcall(XLQPYouTubeMusic.search,query.Text,apiKey,token)
		self.Busy=false
		if not ok then setStatus(list,true) return end
		self.Results=list self.NextToken=nextToken self.PrevToken=prevToken
		if direction=="next" then self.Page+=1 elseif direction=="prev" then self.Page=math.max(1,self.Page-1) else self.Page=1 self.PageTokens={[1]=""} end
		self.PageTokens[self.Page]=token or ""
		self.PageTokens[self.Page+1]=nextToken or ""
		setStatus("Showing "..#list.." results")
		render()
	end
	function controller:Open(defaultQuery)
		overlay.Visible=true
		if defaultQuery and tostring(defaultQuery)~="" then query.Text=tostring(defaultQuery) self:Search("",nil) else query:CaptureFocus() end
		return self
	end
	function controller:Close() overlay.Visible=false return self end
	function controller:SetAPIKey(value) apiKey=tostring(value or "") return self end
	function controller:GetAPIKey() return apiKey end
	openButton.Activated:Connect(function() controller:Open() end)
	close.Activated:Connect(function() controller:Close() end)
	searchButton.Activated:Connect(function() task.spawn(function() controller:Search("",nil) end) end)
	query.FocusLost:Connect(function(enterPressed) if enterPressed then task.spawn(function() controller:Search("",nil) end) end end)
	prev.Activated:Connect(function() if controller.Page>1 then task.spawn(function() controller:Search(controller.PageTokens[controller.Page-1] or "","prev") end) end end)
	nextButton.Activated:Connect(function() if controller.NextToken~="" then task.spawn(function() controller:Search(controller.NextToken,"next") end) end end)
	mediaPlayer:SetYouTubeResolver(function(url,playlistIndex) return controller:ResolveURL(url,playlistIndex) end)
	mediaPlayer:Subscribe(function(state)
		controller.Playing=state and state.Playing==true or false
		local item=state and state.Index and state.Playlist and state.Playlist[state.Index] or nil
		controller.CurrentVideoId=item and item.VideoId or nil
		controller.CurrentFrames=controller.CurrentVideoId and controller.FrameCache[controller.CurrentVideoId] or nil
		local image=resolveImage(item)
		if options.DiscArt then
			options.DiscArt.Visible=image~=""
			if image~="" then options.DiscArt.Image=image options.DiscArt.ImageRectSize=Vector2.new() options.DiscArt.ImageRectOffset=Vector2.new() end
		end
	end)
	local accumulator=0
	controller.Connection=RunService.Heartbeat:Connect(function(delta)
		if not controller.Playing or not controller.CurrentFrames or #controller.CurrentFrames==0 then return end
		accumulator+=delta
		if accumulator<0.1 then return end
		accumulator=0
		local sound=mediaPlayer:GetSound()
		local frameIndex=sound and math.floor((sound.TimePosition or 0)*2)%#controller.CurrentFrames+1 or controller.FrameIndex%#controller.CurrentFrames+1
		controller.FrameIndex=frameIndex
		local frame=controller.CurrentFrames[frameIndex]
		if options.DiscArt and options.DiscArt.Parent then
			options.DiscArt.Image=frame.Asset or ""
			options.DiscArt.ImageRectSize=Vector2.new(frame.Width,frame.Height)
			options.DiscArt.ImageRectOffset=Vector2.new(frame.X,frame.Y)
			options.DiscArt.Rotation=(options.DiscArt.Rotation+1.4)%360
		end
		local island=XLQPGen1._DynamicIsland
		if island and island.SetArtwork then island:SetArtwork(frame.Asset,Vector2.new(frame.Width,frame.Height),Vector2.new(frame.X,frame.Y)) end
	end)
	table.insert(XLQPGen1.Connections,controller.Connection)
	controller.Button=openButton controller.Overlay=overlay controller.Query=query controller.ResultsFrame=results
	center.YouTubeSearch=controller
	return controller
end

