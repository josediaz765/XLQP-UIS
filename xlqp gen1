function XLQPGen1.BytebeatTools:Program(src)
	local lines,declared,last={}, {t=true,s=true}, nil
	for _,part in ipairs(self:SplitTop(src)) do
		part=part:gsub("^var%s+",""):gsub("^let%s+",""):gsub("^const%s+",""):gsub("^local%s+",""):gsub("^%s+",""):gsub("%s+$","")
		if part:sub(1,6)=="return" then
			last=self:Expr(part:sub(7))
		else
			local pos,op=self:FindAssign(part)
			if pos then
				local lhs=part:sub(1,pos-1):gsub("^%s+",""):gsub("%s+$","")
				local rhs=part:sub(pos+#op):gsub("^%s+",""):gsub("%s+$","")
				if lhs:match("^[%a_][%w_]*$") then
					local expr=self:Expr(rhs)
					if op~="=" then
						local b=op:sub(1,1)
						expr=({["&"]="BB("..lhs..","..expr..")",["|"]="BO("..lhs..","..expr..")",["^"]="BX("..lhs..","..expr..")"})[b] or "(("..lhs..")"..b.."("..expr.."))"
					end
					if declared[lhs] then
						lines[#lines+1]=lhs.."="..expr
					else
						declared[lhs]=true
						lines[#lines+1]="local "..lhs.."="..expr
					end
					last=lhs
				else
					last=self:Expr(part)
				end
			else
				last=self:Expr(part)
			end
		end
	end
	lines[#lines+1]="return "..(last or "0")
	return table.concat(lines,";")
