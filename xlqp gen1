local UltraAICompanion = {Model=nil,Connections={},Tracks={},CurrentTrack=nil,LastPromptTime=0}

function ultraAICleanupConnections(list)
	for _,connection in ipairs(list or {}) do pcall(function() connection:Disconnect() end) end
	table.clear(list)
end

function SharedAIService:DestroyCompanion()
