function sharedAIPath(data, path)
	path = sharedAIClean(path)
	if path == "" then return nil end
	local current = data
	for piece in path:gmatch("[^%.%[%]]+") do
		if type(current) ~= "table" then return nil end
		local index = tonumber(piece)
		current = current[index or piece]
	end
	if type(current) == "string" then return sharedAIClean(current) end
	if current ~= nil then
		local ok, encoded = pcall(function() return HttpService:JSONEncode(current) end)
		return ok and encoded or tostring(current)
	end
	return nil
end

local function sharedAIJSONEscape(value)
	local encoded = HttpService:JSONEncode(tostring(value or ""))
	return encoded:sub(2, -2)
end

function SharedAIService:IsProvider(name)
	for _, provider in ipairs(self.ProviderNames) do
		if provider == name then return true end
	end
	return false
end

function SharedAIService:Load()
	if self.Loaded then return self.Config end
	self.Config = sharedAICopy(self.Defaults)
	if isfile and readfile and isfile(self.ConfigPath) then
		local ok, data = pcall(function() return HttpService:JSONDecode(readfile(self.ConfigPath)) end)
		if ok and type(data) == "table" then
			for key, value in pairs(data) do
				if self.Config[key] ~= nil then self.Config[key] = value end
			end
		end
	end
	if not self:IsProvider(self.Config.Provider) then self.Config.Provider = self.Defaults.Provider end
	self.Config.CustomEnabled = self.Config.CustomEnabled == true
	self.Config.APIMethod = tostring(self.Config.APIMethod or "AUTO"):upper()
	if self.Config.APIMethod ~= "GET" and self.Config.APIMethod ~= "POST" then self.Config.APIMethod = "AUTO" end
	self.Config.Temperature = tonumber(self.Config.Temperature) or self.Defaults.Temperature
	self.Config.MaxTokens = math.clamp(tonumber(self.Config.MaxTokens) or self.Defaults.MaxTokens, 64, 4096)
	self.Loaded = true
	return self.Config
end

function SharedAIService:Save()
	self:Load()
	if not writefile then return false end
	pcall(function()
		if makefolder and (not isfolder or not isfolder(self.ConfigFolder)) then makefolder(self.ConfigFolder) end
	end)
	return pcall(function() writefile(self.ConfigPath, HttpService:JSONEncode(self.Config)) end)
end

function SharedAIService:Notify()
	for index = #self.Listeners, 1, -1 do
		local listener = self.Listeners[index]
		if type(listener) ~= "function" then
			table.remove(self.Listeners, index)
		else
			pcall(listener, self.Config)
		end
	end
end

function SharedAIService:Subscribe(callback)
	if type(callback) == "function" then
		self.Listeners[#self.Listeners + 1] = callback
		pcall(callback, self:Load())
	end
	return callback
end

