			local function setVisual(mode)
				local info=TweenInfo.new(mode=="active" and .1 or .18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
				local glowTransparency=mode=="active" and .68 or mode=="hover" and .84 or 1
