				local avatarHolder = Create("Frame", {Name="AvatarHolder", Size=UDim2.fromOffset(56,56), Position=UDim2.new(0,12,0.5,-28), BackgroundColor3=accent, BackgroundTransparency=0.72, BorderSizePixel=0, ZIndex=3, Parent=card}, {Create("UICorner",{CornerRadius=UDim.new(1,0)})})
				local avatar = Create("ImageLabel", {
					Name = "Avatar",
					Size = UDim2.new(1,-4,1,-4),
					Position = UDim2.fromOffset(2,2),
					BackgroundTransparency = 1,
					Image = userId > 0 and ("rbxthumb://type=AvatarHeadShot&id="..tostring(userId).."&w=150&h=150") or "",
					ZIndex = 4,
					Parent = avatarHolder
				}, {Create("UICorner",{CornerRadius=UDim.new(1,0)})})
				avatar:SetAttribute("PreserveImageColor", true)
				avatar:SetAttribute("NoLiquidGlassIcon", true)
				local nameLabel = AddThemeObject(SetProps(MakeElement("Label", displayName, 13), {
					Name = "Content",
					Size = UDim2.new(1, -84, 0, 19),
					Position = UDim2.new(0, 78, 0, 20),
					Font = Enum.Font.GothamBold,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					BackgroundTransparency = 1,
					ZIndex = 3,
					Parent = card
				}), "Text")
				local subtitleText = info.Subtitle
				if subtitleText == nil then
					subtitleText = userId > 0 and ("@"..userName.."  ·  "..tostring(userId)) or ("@"..userName)
				end
				local subLabel = AddThemeObject(SetProps(MakeElement("Label", tostring(subtitleText), 10), {
					Name = "Description",
					Size = UDim2.new(1, -84, 0, 16),
					Position = UDim2.new(0, 78, 0, 40),
					Font = Enum.Font.Gotham,
