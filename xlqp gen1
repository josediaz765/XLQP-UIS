		local baseSize=targetFrame.Size
		local anchor=targetFrame.AnchorPoint
		for _,l in ipairs(layers) do
			local pad=math.clamp(l.Pad,0,150)
			l.Frame.AnchorPoint=anchor
			l.Frame.Position=UDim2.new(
				basePosition.X.Scale,
				basePosition.X.Offset-pad+math.floor(anchor.X*pad*2+0.5),
				basePosition.Y.Scale,
				basePosition.Y.Offset-pad+math.floor(anchor.Y*pad*2+0.5)
			)
			l.Frame.Size=UDim2.new(baseSize.X.Scale,baseSize.X.Offset+pad*2,baseSize.Y.Scale,baseSize.Y.Offset+pad*2)
		end
	end
	AddConnection(targetFrame:GetPropertyChangedSignal("Position"),weldGlowLayers)
	AddConnection(targetFrame:GetPropertyChangedSignal("Size"),weldGlowLayers)
	AddConnection(targetFrame:GetPropertyChangedSignal("AnchorPoint"),weldGlowLayers)
