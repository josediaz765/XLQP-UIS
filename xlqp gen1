local function cleanConfigCloudWebhook(url)
	url = tostring(url or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("[\r\n\t]", "")
	url = url:gsub("^<", ""):gsub(">$", "")
	return url
end

local function isDiscordConfigCloudWebhook(url)
	url = cleanConfigCloudWebhook(url)
	return url:match("^https://[%w%-%.]*discord%.com/api/[%w/]-webhooks/%d+/[%w%-%._]+") ~= nil
		or url:match("^https://[%w%-%.]*discordapp%.com/api/[%w/]-webhooks/%d+/[%w%-%._]+") ~= nil
end

function configCloudRequester()
	return XLQPResolveRequest()
end

local function configCloudValueText(value, depth)
	depth = tonumber(depth) or 0
	if depth > 3 then return "..." end
	local valueType = typeof and typeof(value) or type(value)
	if valueType == "Color3" then
		return string.format("rgb(%d, %d, %d)", math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5))
	elseif valueType == "EnumItem" then
		return value.Name
	elseif type(value) == "table" then
		local parts = {}
		for key, nested in pairs(value) do
			parts[#parts + 1] = tostring(key) .. ": " .. configCloudValueText(nested, depth + 1)
			if #parts >= 24 then parts[#parts + 1] = "..." break end
		end
		table.sort(parts)
		return table.concat(parts, "\n")
	end
	return tostring(value == nil and "nil" or value)
end

