	function widget:AddElement()
		return nil
	end

	function widget:Clear()
		return self
	end

	function widget:Destroy()
		self._Destroyed=true
		if XLQPGen1._Widgets then XLQPGen1._Widgets[widgetKey]=nil end
		for index,item in ipairs(XLQPGen1._WidgetOrder or {}) do
			if item==self then table.remove(XLQPGen1._WidgetOrder,index) break end
		end
		pcall(function() card:Destroy() end)
	end

	self._Widgets[widgetKey]=widget
	table.insert(self._WidgetOrder,widget)

	local function requestText(url)
		local ok,raw=pcall(function() return game:HttpGet(url) end)
		if ok and type(raw)=="string" and raw~="" then return raw end
		local requester=XLQPResolveRequest()
		if type(requester)=="function" then
			local requestOk,response=pcall(requester,{Url=url,Method="GET",Headers={["Accept"]="application/json"}})
			if requestOk and type(response)=="table" then
				local body=tostring(response.Body or response.body or "")
				if body~="" then return body end
			end
		end
	end

	local function decodeUrl(url)
		local raw=requestText(url)
		if not raw then return nil end
		local ok,data=pcall(HttpService.JSONDecode,HttpService,raw)
		if ok and type(data)=="table" then return data end
	end

	local function setCachedGameImage(imageUrl,cacheId)
		if not (hero and hero.Parent) or tostring(imageUrl or "")=="" then return false end
		local requester=XLQPResolveRequest()
		local customAsset=getcustomasset or getsynasset
		if type(requester)=="function" and type(writefile)=="function" and type(customAsset)=="function" then
			local folder="XLQPGen1"
			local cacheFolder=folder.."/WidgetCache"
			pcall(function()
				if makefolder then
					if not isfolder or not isfolder(folder) then pcall(makefolder,folder) end
					if not isfolder or not isfolder(cacheFolder) then pcall(makefolder,cacheFolder) end
				end
			end)
			local path=cacheFolder.."/game_"..tostring(cacheId)..".png"
			if type(isfile)=="function" and isfile(path) then
				local ok,asset=pcall(customAsset,path)
				if ok and asset then
					hero.Image=asset
					hero.ImageTransparency=0
					return true
				end
			end
			local ok,response=pcall(requester,{Url=imageUrl,Method="GET",Headers={["Accept"]="image/png,image/*"}})
			if ok and type(response)=="table" then
				local body=response.Body or response.body
				if type(body)=="string" and #body>32 then
					local wrote=pcall(writefile,path,body)
					if wrote then
						local assetOk,asset=pcall(customAsset,path)
						if assetOk and asset then
							hero.Image=asset
							hero.ImageTransparency=0
							return true
						end
					end
				end
			end
		end
		pcall(function()
			hero.Image=tostring(imageUrl)
			hero.ImageTransparency=0
		end)
		return hero.Image~=""
	end

	task.spawn(function()
		local placeId=tonumber(game.PlaceId) or 0
		local universeId=tonumber(game.GameId) or 0
		local gameName=""
		local creatorName=""

		if universeId>0 then
			local gamesData=decodeUrl("https://games.roblox.com/v1/games?universeIds="..tostring(universeId))
			if type(gamesData)=="table" and type(gamesData.data)=="table" and type(gamesData.data[1])=="table" then
				local info=gamesData.data[1]
				gameName=tostring(info.name or "")
				if type(info.creator)=="table" then creatorName=tostring(info.creator.name or "") end
			end
		end

		if gameName=="" or creatorName=="" then
			local marketplace=game:GetService("MarketplaceService")
			for attempt=1,3 do
				local ok,info=pcall(function() return marketplace:GetProductInfo(placeId) end)
				if ok and type(info)=="table" then
					if gameName=="" then gameName=tostring(info.Name or "") end
					if creatorName=="" and type(info.Creator)=="table" then creatorName=tostring(info.Creator.Name or "") end
					if gameName~="" and creatorName~="" then break end
				end
				task.wait(0.15*attempt)
			end
		end

		if gameName=="" then gameName=tostring(gameInfo.FallbackName or widgetConfig.FallbackName or game.Name or "Current game") end
		if creatorName=="" then
			local creatorId=tonumber(game.CreatorId) or 0
			local creatorType=tostring(game.CreatorType or "")
			if creatorId>0 and creatorType:find("User") then
				pcall(function() creatorName=Players:GetNameFromUserIdAsync(creatorId) end)
			elseif creatorId>0 and creatorType:find("Group") then
				pcall(function()
					local groupInfo=game:GetService("GroupService"):GetGroupInfoAsync(creatorId)
					if type(groupInfo)=="table" then creatorName=tostring(groupInfo.Name or "") end
				end)
			end
		end
		if creatorName=="" then creatorName="Roblox experience" end

		if not (card and card.Parent) then return end
		title.Text=gameName
		if creator and creator.Parent then creator.Text=creatorName=="Roblox experience" and creatorName or ("@"..creatorName) end
		widget.Config.GameName=gameName
		widget.Config.GameCreator=creatorName

		if hero and hero.Parent and imageEnabled then
			local customImage=widgetConfig.Image or widgetConfig.Thumbnail or gameInfo.ImageAsset or (type(gameInfo.Image)=="string" and gameInfo.Image or nil)
			if customImage and tostring(customImage)~="" then
				hero.Image=tostring(customImage)
			else
				local imageUrl
				if placeId>0 then
					local placeThumb=decodeUrl("https://thumbnails.roblox.com/v1/places/gameicons?placeIds="..tostring(placeId).."&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false")
					if type(placeThumb)=="table" and type(placeThumb.data)=="table" and type(placeThumb.data[1])=="table" then
						imageUrl=tostring(placeThumb.data[1].imageUrl or "")
					end
				end
				if (not imageUrl or imageUrl=="") and universeId>0 then
					local universeThumb=decodeUrl("https://thumbnails.roblox.com/v1/games/icons?universeIds="..tostring(universeId).."&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false")
					if type(universeThumb)=="table" and type(universeThumb.data)=="table" and type(universeThumb.data[1])=="table" then
						imageUrl=tostring(universeThumb.data[1].imageUrl or "")
					end
				end

				local loaded=false
				if imageUrl and imageUrl~="" then
					loaded=setCachedGameImage(imageUrl,universeId>0 and universeId or placeId)
				end
				if not loaded then
					if universeId>0 then
						hero.Image="rbxthumb://type=GameIcon&id="..tostring(universeId).."&w=150&h=150"
					elseif placeId>0 then
						hero.Image="rbxthumb://type=GameIcon&id="..tostring(placeId).."&w=150&h=150"
					end
					hero.ImageTransparency=0
				end
			end
			pcall(function() game:GetService("ContentProvider"):PreloadAsync({hero}) end)
		end
	end)

	if widgetConfig.OnCreate then pcall(widgetConfig.OnCreate,widget) end
	return widget
end

function XLQPGen1:AddWidget(widgetConfig)
	if not self._WidgetsEnabled then return nil end
	widgetConfig=type(widgetConfig)=="table" and widgetConfig or {Name=tostring(widgetConfig or "Widget")}
	local specialGameInfo=widgetConfig.GameInfo==true or widgetConfig.CurrentGame==true or (type(widgetConfig.GameInfo)=="table" and widgetConfig.GameInfo.Enabled~=false)
	if specialGameInfo then return self:_AddDedicatedGameInfoWidget(widgetConfig) end
	local dashboard=self:_BuildWidgetDashboard()
	if not dashboard then return nil end
	local canvas=self._WidgetDashboardCanvas
	local factoryTab=self:_EnsureWidgetFactory()
	if not (canvas and factoryTab and type(factoryTab.AddLeftGroupbox)=="function") then return nil end
	local gameInfoConfig=type(widgetConfig.GameInfo)=="table" and widgetConfig.GameInfo or nil
	local gameInfoEnabled=widgetConfig.GameInfo==true or widgetConfig.CurrentGame==true or (gameInfoConfig and gameInfoConfig.Enabled~=false)
	local showGameImage=not gameInfoConfig or gameInfoConfig.Image~=false
	local showGameCreator=not gameInfoConfig or gameInfoConfig.Creator~=false
	local gameAutoFit=not gameInfoConfig or gameInfoConfig.AutoFit~=false
	local name=tostring(gameInfoEnabled and (widgetConfig.LoadingTitle or "Loading game...") or widgetConfig.Name or widgetConfig.Title or ("Widget "..tostring(#(self._WidgetOrder or {})+1)))
	local widgetImage=widgetConfig.Image or widgetConfig.Thumbnail or widgetConfig.IconImage
	if gameInfoEnabled and showGameImage and (not widgetImage or tostring(widgetImage)=="") then
		local universeId=tonumber(game.GameId) or 0
		local placeId=tonumber(game.PlaceId) or 0
		if universeId>0 then
			widgetImage="rbxthumb://type=GameIcon&id="..tostring(universeId).."&w=420&h=420"
		elseif placeId>0 then
			widgetImage="rbxthumb://type=GameIcon&id="..tostring(placeId).."&w=420&h=420"
		end
	end
	if self._Widgets[name] then pcall(function() self._Widgets[name]:Destroy() end) end
	local defaultWidth=tonumber(widgetConfig.Width) or 280
	local defaultHeight=tonumber(widgetConfig.Height) or 180
	local position=widgetConfig.Position
	if typeof(position)~="UDim2" then
		position=UDim2.new(tonumber(widgetConfig.XScale) or 0,tonumber(widgetConfig.X) or 0,tonumber(widgetConfig.YScale) or 0,tonumber(widgetConfig.Y) or 0)
	end
	local size=widgetConfig.Size
	if typeof(size)~="UDim2" then
		size=UDim2.fromOffset(defaultWidth,defaultHeight)
	end
	if gameInfoEnabled and gameAutoFit and size.Y.Scale==0 then
		size=UDim2.new(size.X.Scale,size.X.Offset,0,112)
	end
	local radius=math.clamp(tonumber(widgetConfig.CornerRadius) or tonumber(self._WidgetConfig and self._WidgetConfig.CornerRadius) or tonumber(self._WindowConfig and self._WindowConfig.NewUICornerRadius) or 14,0,32)
	local card=AddThemeObject(Create("Frame",{
		Name="Widget_"..name,
		Position=position,
		Size=size,
		BackgroundColor3=Color3.fromRGB(255,255,255),
		BackgroundTransparency=math.clamp(tonumber(widgetConfig.Transparency) or 0.08,0,1),
		BorderSizePixel=0,
		ClipsDescendants=true,
		Active=true,
		Selectable=false,
		ZIndex=72020+(#self._WidgetOrder or 0),
		Visible=widgetConfig.Visible~=false,
		Parent=canvas
	},{
		Create("UICorner",{Name="WidgetCorner",CornerRadius=UDim.new(0,radius)}),
		AddThemeObject(SetProps(MakeElement("Stroke"),{Transparency=0.58,Thickness=1}),"Stroke")
	}),"Second")
	card:SetAttribute("LiquidGlassSurface",true)
	local imageSize=math.clamp(tonumber(widgetConfig.ImageSize) or (gameInfoEnabled and 66 or 44),24,96)
	local headerHeight=gameInfoEnabled and math.max(96,size.Y.Offset) or ((widgetConfig.Header==false or widgetConfig.ShowHeader==false) and 0 or math.max(((widgetImage and tostring(widgetImage)~="") and 72 or 30),tonumber(widgetConfig.HeaderHeight) or 38))
	local header=Create("Frame",{
		Name="Header",
		Size=UDim2.new(1,0,0,headerHeight),
		BackgroundTransparency=1,
		Active=widgetConfig.Moveable==true,
		ZIndex=card.ZIndex+2,
		Parent=card
	})
	local iconAsset=widgetConfig.Icon and (GetIcon(widgetConfig.Icon) or normalizeIconAsset(widgetConfig.Icon)) or nil
	local titleX=14
	local heroImage
	if showGameImage and widgetImage and tostring(widgetImage)~="" and headerHeight>0 then
		heroImage=Create("ImageLabel",{
			Name="WidgetImage",
			Size=UDim2.fromOffset(imageSize,imageSize),
			AnchorPoint=Vector2.new(0,0),
			Position=UDim2.fromOffset(10,10),
			BackgroundColor3=Color3.fromRGB(255,255,255),
			BackgroundTransparency=0.96,
			BorderSizePixel=0,
			Image=tostring(widgetImage),
			ImageTransparency=0,
			ScaleType=widgetConfig.ImageScaleType or Enum.ScaleType.Crop,
			ZIndex=header.ZIndex+1,
			Parent=header
		})
		pcall(function() heroImage.Image=tostring(widgetImage) end)
		pcall(function() game:GetService("ContentProvider"):PreloadAsync({heroImage}) end)
		Create("UICorner",{CornerRadius=UDim.new(0,math.min(radius,14)),Parent=heroImage})
