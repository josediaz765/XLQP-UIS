	WindowConfig._LocalRegisterState.backgroundAssetToken=(WindowConfig._LocalRegisterState.backgroundAssetToken or 0)+1
	local token=WindowConfig._LocalRegisterState.backgroundAssetToken
	if videoStatusLabel then videoStatusLabel.Text="Loading background..." end
	task.spawn(function()
