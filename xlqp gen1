WindowConfig._LocalRegisterState.SettingsSliderElementsReady=false
 function addSettingsSlider(parent,config)
config=config or {}
config.Name=config.Name or "Slider"
config.Description=config.Description or ""
config.Min=tonumber(config.Min) or 0
config.Max=tonumber(config.Max) or 100
config.Increment=tonumber(config.Increment) or 1
config.Default=tonumber(config.Default) or config.Min
local host=Create("Frame",{Name="SettingsSliderHost",Size=UDim2.new(1,-16,0,config.Description~="" and 92 or 74),BackgroundTransparency=1,BorderSizePixel=0,Parent=parent})
local api={Value=config.Default,Wrapper=host,Control=nil}
function api:Set(value,silent)
	if self.Control then
		self.Control:Set(value,true,silent==true)
		self.Value=self.Control.Value
	else
		self.Value=math.clamp(tonumber(value) or self.Value,config.Min,config.Max)
		if not silent then SafeCallback(config.Callback,config.Name,self.Value) end
	end
	return self
end
task.spawn(function()
	while host.Parent and not WindowConfig._LocalRegisterState.SettingsSliderElementsReady do task.wait() end
	if not host.Parent then return end
	local initializing=true
	local control=WindowConfig._LocalRegisterState.GetElements(host):AddSlider({
		Name=config.Name,Description=config.Description,Min=config.Min,Max=config.Max,
		Increment=config.Increment,Default=api.Value,Color=config.Color,
		ValueName=config.Suffix or "",FormatValue=config.ValueText,input=true,
		Callback=function(value)
			api.Value=value
			if not initializing then SafeCallback(config.Callback,config.Name,value) end
		end
	})
	api.Control=control
	api.Value=control.Value
	initializing=false
end)
return api
end
