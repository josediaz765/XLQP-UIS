			local matches = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput or activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1
			if matches then finishDrag(lastPosition or input.Position) end
		end)
		Frame.AncestryChanged:Connect(function(_, parent)
			if not parent then
