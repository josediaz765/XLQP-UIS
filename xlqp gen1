	local function RefreshGradientVisuals()
		if not GradientMode then
			BoxGradient.Enabled = false
			PreviewGradient.Enabled = false
			return
		end
		local gradientColor = BuildGradientColor()
		local gradientTransparency = BuildGradientTransparency()
		Colorpicker.Value = gradientColor
		Colorpicker.Transparency = gradientTransparency
		Colorpicker.Alpha = gradientTransparency
		BoxGradient.Enabled = true
		BoxGradient.Color = gradientColor
		BoxGradient.Transparency = gradientTransparency
		BoxGradient.Rotation = tonumber(ColorpickerConfig.Rotation) or 0
		PreviewGradient.Enabled = true
		PreviewGradient.Color = gradientColor
		PreviewGradient.Transparency = gradientTransparency
		if GradientTrackGradient then
			GradientTrackGradient.Color=gradientColor
			GradientTrackGradient.Transparency=gradientTransparency
		end
		for _,marker in ipairs(GradientMarkers) do
			if marker.Button and marker.Button.Parent and marker.Stop then
				marker.Button.Position=UDim2.fromScale(marker.Stop.Time,0.5)
				marker.Button.BackgroundColor3=marker.Stop.Color
				local selected=GradientStops[SelectedGradientStop]==marker.Stop
				marker.Button.Size=UDim2.fromOffset(selected and 21 or 17,selected and 21 or 17)
			end
		end
		ColorpickerBox.BackgroundColor3 = Color3.new(1, 1, 1)
		PreviewBox.BackgroundColor3 = Color3.new(1, 1, 1)
	end

	local function UpdateColorPicker(updatePositions)
		local newColor = Color3.fromHSV(ColorH, ColorS, ColorV)
		ColorpickerBoxContainer.BackgroundColor3 = newColor
		ColorpickerBoxContainer.BackgroundTransparency = 0
		if not GradientMode then ColorpickerBox.BackgroundColor3 = newColor end
		ColorpickerBox.BackgroundTransparency = 0
		if not GradientMode then PreviewBox.BackgroundColor3 = newColor end
		PreviewBox.BackgroundTransparency = GradientMode and 0 or ColorA
		AlphaFill.BackgroundColor3 = newColor
		
		if updatePositions then
			ColorSelection.Position = UDim2.fromScale(math.clamp(ColorS,0,1), math.clamp(1-ColorV,0,1))
			HueSelection.Position = UDim2.fromScale(0.5, math.clamp(ColorH,0,1))
			AlphaSelection.Position = UDim2.fromScale(0.5, math.clamp(ColorA,0,1))
		end
		
		ColorImageDisplay.BackgroundColor3 = Color3.fromHSV(ColorH, 1, 1)
		
		RGBInput.Text = string.format("%d, %d, %d", math.floor(newColor.R * 255), math.floor(newColor.G * 255), math.floor(newColor.B * 255))
		HexInput.Text = ColorToHex(newColor)
		
		if GradientMode then
			local stop = GradientStops[SelectedGradientStop]
			stop.Color = newColor
			stop.Transparency = ColorA
			RefreshGradientVisuals()
		else
			if Colorpicker.Value ~= newColor then Colorpicker.Value = newColor end
			Colorpicker.Transparency = ColorA
			Colorpicker.Alpha = ColorA
		end
		if not suppressColorCallback and Colorpicker.Toggled and ColorpickerConfig.Live ~= false and os.clock()-lastLiveCallback > liveDelay then
			lastLiveCallback = os.clock()
			SafeCallback(ColorpickerConfig.Callback, ColorpickerConfig.Name or "Colorpicker", Colorpicker.Value, Colorpicker.Transparency, Colorpicker)
		end
	end

	RebuildGradientMarkers=function()
		for _,marker in ipairs(GradientMarkers) do if marker.Button and marker.Button.Parent then marker.Button:Destroy() end end
		table.clear(GradientMarkers)
		if not GradientMode or not GradientTrack then return end
		for index,stop in ipairs(GradientStops) do
			local marker=Create("TextButton",{
				Name="Stop"..index,AnchorPoint=Vector2.new(0.5,0.5),Size=UDim2.fromOffset(index==SelectedGradientStop and 21 or 17,index==SelectedGradientStop and 21 or 17),
				Position=UDim2.fromScale(stop.Time,0.5),BackgroundColor3=stop.Color,BorderSizePixel=0,Text="",AutoButtonColor=false,
				ZIndex=8,Parent=GradientTrack
			},{Create("UICorner",{CornerRadius=UDim.new(1,0)}),Create("UIStroke",{Color=Color3.new(1,1,1),Thickness=3,Transparency=0.02,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})})
			table.insert(GradientMarkers,{Button=marker,Stop=stop})
			AddConnection(marker.InputBegan,function(input)
				if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
				activePickerInput=input
				GetPickerPointer(input)
				for stopIndex,candidate in ipairs(GradientStops) do if candidate==stop then SelectedGradientStop=stopIndex break end end
				ColorH,ColorS,ColorV=Color3.toHSV(stop.Color)
				ColorA=stop.Transparency or 0
				suppressColorCallback=true
				UpdateColorPicker(true)
				suppressColorCallback=false
				if SelectedGradientStop>1 and SelectedGradientStop<#GradientStops then draggingGradientStop=stop end
			end)
		end
	end

