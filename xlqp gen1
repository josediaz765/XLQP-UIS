for _,keyValue in ipairs(keyRawList) do XLQPGen1KeyCrypt.fingerprint=XLQPGen1KeyCrypt.fingerprint.."|r:"..XLQPGen1KeyCrypt.sign(keyValue) end
keyHashList=settings.KeyHashes or settings.HashedKeys or settings.KeyHash or {}
