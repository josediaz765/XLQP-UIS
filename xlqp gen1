 function packTheme(theme)
	local packed={}
	for key,value in pairs(theme or {}) do
		if typeof(value)=="Color3" then
			packed[key]=PackColor(value)
		else
			packed[key]=value
		end
	end
	return packed
end

 function encodeTheme(theme)
	return HttpService:JSONEncode(packTheme(theme))
end

 function unpackTheme(data)
	if type(data)~="table" then return nil end
	local theme={}
	for key,value in pairs(XLQPGen1.Themes.Default or {}) do
		theme[key]=value
	end
	for key,value in pairs(data) do
		if type(value)=="table" and value.R and value.G and value.B then
			theme[key]=UnpackColor(value)
		else
			theme[key]=value
		end
	end
	return theme
end

 function decodeTheme(text)
	local ok,data=pcall(function() return HttpService:JSONDecode(text or "") end)
	if not ok then return nil end
	return unpackTheme(data)
end

 function applyThemeByName(name)
	local path=themePath(name)
	local data=readTextFile(path)
	local theme=decodeTheme(data)
	if not theme then
		WindowConfig._LocalRegisterState.notifySettings("Theme","Could not load theme.")
		return false
	end
	XLQPGen1.Themes.Custom=theme
	XLQPGen1.SelectedTheme="Custom"
	SetTheme()
	if applyNewUIStyle then applyNewUIStyle() end
	if applyNewUITransparency then applyNewUITransparency() end
	WindowConfig._LocalRegisterState.notifySettings("Theme","Loaded "..WindowConfig._LocalRegisterState.cleanFileName(name,"Default"))
	return true
end

