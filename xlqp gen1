local XLQPElementCompatMethods={"AddToggle","AddSlider","AddDropdown","AddTextbox","AddInput","AddButton","AddLabel","AddParagraph","AddColorpicker","AddColorPicker","AddKeybind","AddKeyPicker","AddBind","AddLeftGroupbox","AddRightGroupbox","AddLeftTabbox","AddRightTabbox"}
local function XLQPEnsureElementApi(target,host)
	if type(target)~="table" then return target end
	local nested=type(target.Elements)=="table" and target.Elements or nil
	local resolved
	local function resolve()
		if nested then return nested end
		if resolved then return resolved end
		local container=host
		if typeof(container)~="Instance" then
			container=target.Container or target.Page or target.Frame or target.Wrapper
		end
		if typeof(container)=="Instance" and type(GetElements)=="function" then
			local ok,value=pcall(GetElements,container)
			if ok and type(value)=="table" and value~=target then resolved=value end
		end
		return resolved
	end
	for _,methodName in ipairs(XLQPElementCompatMethods) do
		local name=methodName
		if type(target[name])~="function" then
			target[name]=function(self,...)
				local api=resolve()
				local method=api and api[name]
				if type(method)=="function" then return method(api,...) end
				return nil
			end
		end
	end
	return target
end

