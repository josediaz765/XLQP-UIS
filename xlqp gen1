			frame.Draggable=true
			self.Detached=true
			local label=popButton:FindFirstChildWhichIsA("TextLabel")
			if label then label.Text="Dock" end
		end
	end
	AddConnection(globalTab.Activated,function() Chat.Tab="global" Chat.StickToBottom=true updateTabs() Chat:Refresh(true) end)
	AddConnection(dmTab.Activated,function() Chat.Tab="dm" Chat.StickToBottom=true updateTabs() Chat:Refresh(true) end)
