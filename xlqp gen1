		return plain ~= "" and plain or nil, plain == "" and "Invalid response" or nil
	end
	if type(data.choices) == "table" and data.choices[1] then
		local choice = data.choices[1]
		if type(choice.message) == "table" then
			local content = choice.message.content
			if type(content) == "string" then return sharedAIClean(content) end
			if type(content) == "table" then
				local parts = {}
				for _, item in ipairs(content) do
					if type(item) == "string" then
						parts[#parts + 1] = item
					elseif type(item) == "table" and type(item.text or item.content) == "string" then
						parts[#parts + 1] = item.text or item.content
					end
				end
				if #parts > 0 then return sharedAIClean(table.concat(parts, "\n")) end
			end
			if choice.message.tool_calls or choice.message.function_call then
				return nil, "Provider returned a tool call without a final written answer"
