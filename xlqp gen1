               if ps and pr and pr.userPresences then
                   local pm = {}
                   for _, pd in ipairs(pr.userPresences) do
                       pm[pd.userId] = pd
                   end
                   for _, fr in ipairs(allFriendsData) do
                       fr.presence = pm[fr.id]
