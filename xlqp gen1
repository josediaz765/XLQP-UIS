		local body=panel.Container
		local columns=Create("Frame",{Name="ControlListColumns",Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,LayoutOrder=-1000,Parent=body})
		AddThemeObject(Create("TextLabel",{Size=UDim2.new(.52,0,1,0),BackgroundTransparency=1,Text="Function",Font=Enum.Font.GothamBold,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,Parent=columns}),"TextDark")
		AddThemeObject(Create("TextLabel",{Size=UDim2.new(.22,0,1,0),Position=UDim2.new(.52,0,0,0),BackgroundTransparency=1,Text="Hotkey",Font=Enum.Font.GothamBold,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,Parent=columns}),"TextDark")
		AddThemeObject(Create("TextLabel",{Size=UDim2.new(.26,0,1,0),Position=UDim2.new(.74,0,0,0),BackgroundTransparency=1,Text="Status",Font=Enum.Font.GothamBold,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,Parent=columns}),"TextDark")
		local controlSnapshot=setmetatable({},{__mode="k"})
		local refreshGeneration=0
		local function keyName(value)
			if typeof(value)=="EnumItem" then return value.Name end
			local valueType=type(value)
			if valueType=="string" then
				if value=="" or value=="Unknown" or value=="None" then return "—" end
				return value
			end
			if value==nil then return "—" end
			local valueText=tostring(value)
			if valueText=="" or valueText=="Unknown" or valueText=="None" then return "—" end
			return valueText
		end
		function panel:RefreshControls(force)
			refreshGeneration+=1
			local generation=refreshGeneration
			local changed=force==true
			for index=1,#(XLQPGen1.AllElements or {}) do
				local element=XLQPGen1.AllElements[index]
				if element and element.Wrapper and element.Wrapper.Parent then
					local name,key,status,active
					if element.Type=="Toggle" then
						key=keyName(element.BindValue)
						if element.Value==true or key~="—" then
							name=tostring(element.Name or "Toggle")
							status=element.Value==true and "Enabled" or "Toggle"
							active=element.Value==true
						end
					elseif element.Type=="Bind" then
						key=keyName(element.Value)
						if key~="—" then
							name=tostring(element.Name or "Bind")
							status=element.Hold and "Hold" or "Hotkey"
							active=false
						end
					end
					if name then
						local entry=controlSnapshot[element]
						if not entry then
							entry={}
							controlSnapshot[element]=entry
							changed=true
						elseif entry.Name~=name or entry.Key~=key or entry.Status~=status or entry.Active~=active then
							changed=true
						end
						entry.Name=name
						entry.Key=key
						entry.Status=status
						entry.Active=active
						entry.Generation=generation
					end
				end
			end
			for element,entry in pairs(controlSnapshot) do
				if entry.Generation~=generation then
					controlSnapshot[element]=nil
					changed=true
				end
			end
			if not changed then return self end
			local rows={}
			for _,entry in pairs(controlSnapshot) do
				rows[#rows+1]=entry
			end
			table.sort(rows,function(a,b) return a.Name:lower()<b.Name:lower() end)
			for _,child in ipairs(body:GetChildren()) do
				if child:IsA("GuiObject") and child.Name=="ControlListRow" then child:Destroy() end
			end
			if #rows==0 then
				AddThemeObject(Create("TextLabel",{Name="ControlListRow",Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Text="No keybinds or enabled toggles",Font=Enum.Font.GothamSemibold,TextSize=11,TextWrapped=true,Parent=body}),"TextDark")
			else
				for index,row in ipairs(rows) do
					local rowFrame=AddThemeObject(SetProps(MakeElement("RoundFrame",Color3.fromRGB(255,255,255),index%2==0 and .12 or .3,7),{Name="ControlListRow",Size=UDim2.new(1,0,0,30),LayoutOrder=index,Parent=body}),"Second")
					AddThemeObject(Create("TextLabel",{Size=UDim2.new(.52,-8,1,0),Position=UDim2.new(0,8,0,0),BackgroundTransparency=1,Text=row.Name,Font=Enum.Font.GothamBold,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=rowFrame}),"Text")
					AddThemeObject(Create("TextLabel",{Size=UDim2.new(.22,0,1,0),Position=UDim2.new(.52,0,0,0),BackgroundTransparency=1,Text=row.Key,Font=Enum.Font.GothamBlack,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=rowFrame}),"TextDark")
					local statusLabel=AddThemeObject(Create("TextLabel",{Size=UDim2.new(.26,-6,1,0),Position=UDim2.new(.74,0,0,0),BackgroundTransparency=1,Text=row.Status,Font=Enum.Font.GothamBold,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=rowFrame}),row.Active and "Text" or "TextDark")
					if row.Active then statusLabel.TextColor3=Color3.fromRGB(92,220,142) end
				end
			end
			task.defer(function() if self and self.Refresh then self:Refresh() end end)
			return self
		end
		panel.RefreshList=panel.RefreshControls
		self.ControlPanel=panel
		panel:RefreshControls(true)
		local function queueVisibleRefresh()
			if XLQPGen1._QueueControlPanelRefresh then XLQPGen1:_QueueControlPanelRefresh(true) end
		end
		if root and root.GetPropertyChangedSignal then AddConnection(root:GetPropertyChangedSignal("Visible"),queueVisibleRefresh) end
		if panel.Gui and panel.Gui.GetPropertyChangedSignal then AddConnection(panel.Gui:GetPropertyChangedSignal("Enabled"),queueVisibleRefresh) end
		return panel
	end
