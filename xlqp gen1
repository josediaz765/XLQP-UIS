	end
	function window:UsePrivateTabRoot(target)
		local record=target and (type(target)=="table" and target or window:GetPrivateTab(target)) or activeRecord
		if not record then return nil,"Create or select a private tab first" end
		activeRecord=record
		activeGroup=nil
		activeMiniPage=nil
		updateStatus("Editing "..record.Name.." / tab root")
		return record.Elements,record
	end
	function window:RenamePrivateTab(target,newName)
		if newName==nil then newName=target target=activeRecord end
		local record=type(target)=="table" and target or window:GetPrivateTab(target)
		if not record then return false,"Create or select a private tab first" end
		local name=tostring(newName or ""):gsub("^%s+",""):gsub("%s+$","")
		if name=="" then return false,"Tab name cannot be empty" end
		local existing=recordByName[name:lower()]
		if existing and existing~=record then return false,"A private tab named "..name.." already exists" end
		recordByName[record.Name:lower()]=nil
		record.Name=name
		recordByName[name:lower()]=record
		record.Config.Name=name
		local tabInfo=record.Elements and record.Elements.Tab
		if tabInfo then
			tabInfo.Name=name
			if tabInfo.Config then tabInfo.Config.Name=name end
			if tabInfo.Button and tabInfo.Button:FindFirstChild("Title") then tabInfo.Button.Title.Text=name end
			if tabInfo.Container then tabInfo.Container:SetAttribute(record.Kind=="Top" and "TopTabName" or "SideTabName",name) end
			stylePrivateTabVisual(record.Elements,name)
		end
		editorState.Name=name
		if tabNameInput and tabNameInput.Set then tabNameInput:Set(name,true) end
		refreshTargets()
		updateStatus("Renamed private tab to "..name)
		notify("Private Tab",name.." renamed")
		return true,record
	end
	function window:CreatePrivateTab(tabConfig)
		tabConfig=type(tabConfig)=="table" and tabConfig or {Name=tostring(tabConfig or editorState.Name)}
		if not unlocked and tabConfig.BypassLock~=true then return nil,"Private editor is locked" end
		if creatingPrivateTab then return nil,"Private tab creation is already running" end
		creatingPrivateTab=true
		local ok,result=pcall(function()
			local name=tostring(tabConfig.Name or tabConfig.Title or editorState.Name):gsub("^%s+",""):gsub("%s+$","")
			if name=="" then name="Private Tab " .. tostring(#records+1) end
			local baseName=name
			local serial=2
			while recordByName[name:lower()] do name=baseName.." "..serial serial+=1 end
			local kind=tostring(tabConfig.Kind or tabConfig.Type or editorState.Kind):lower()
			local elements
			local popupWasOpen=editorPopupState.Open==true
			local creationTopBefore=currentTopTabForCreation
			if popupWasOpen and editorPopupState.Container then editorPopupState.Container:SetAttribute("XLQPDetachedLayout",true) end
			local createdOk,createdResult=pcall(function()
				if kind:find("top",1,true) then
					return window:AddTopTab({Name=name,Icon=tabConfig.Icon or editorState.Icon,MultiTab=false,AutoSelect=false,LayoutOrder=tonumber(tabConfig.LayoutOrder) or (910000+#records)})
				end
				currentTopTabForCreation=privateTop
				return window:AddTab({Name=name,Icon=tabConfig.Icon or editorState.Icon,Group=tabConfig.Group or editorState.Group,GroupIcon=tabConfig.GroupIcon or "lock",ParentTopTab=privateTop,AutoSelect=false,LayoutOrder=tonumber(tabConfig.LayoutOrder) or (#records+1)})
			end)
			currentTopTabForCreation=creationTopBefore
			if not createdOk then error(createdResult) end
			elements=createdResult
			kind=kind:find("top",1,true) and "Top" or "Side"
			stylePrivateTabVisual(elements,name)
			task.defer(function() stylePrivateTabVisual(elements,name) end)
			if popupWasOpen then task.defer(function() if editorPopupState.Open then editorPopupState:Refresh() end end) end
			local record={Name=name,Kind=kind,Elements=elements,Groups={},MiniTabs={},Config=tabConfig,Private=true}
			records[#records+1]=record
			recordByName[name:lower()]=record
			local navigate=tabConfig.SelectOnCreate==true or tabConfig.Select==true
			if navigate and editorPopupState.Open then editorPopupState:Close() end
			selectRecord(record,navigate)
			if editorPopupState.Open then editorPopupState:Refresh() end
			refreshTargets()
			notify("Private Tab",name.." created")
			return record
		end)
		creatingPrivateTab=false
		if not ok then updateStatus("Private tab error: "..tostring(result)) return nil,tostring(result) end
		return result
	end
	function window:AddPrivateGroupbox(groupConfig)
		groupConfig=type(groupConfig)=="table" and groupConfig or {Name=tostring(groupConfig or editorState.Groupbox)}
		local record=groupConfig.Tab and (type(groupConfig.Tab)=="table" and groupConfig.Tab or window:GetPrivateTab(groupConfig.Tab)) or activeRecord
		if not record then return nil,"Create or select a private tab first" end
		local host=activeMiniPage or record.Elements
		if not host then return nil,"Private tab has no element host" end
		local side=tostring(groupConfig.Side or editorState.Side):lower()
		local payload={Name=groupConfig.Name or editorState.Groupbox,Icon=groupConfig.Icon or "box",Pinnable=groupConfig.Pinnable==true,Popout=groupConfig.Popout==true,Dockable=groupConfig.Dockable==true,DockSnapDistance=groupConfig.DockSnapDistance,DockHoldTime=groupConfig.DockHoldTime,DockDragThreshold=groupConfig.DockDragThreshold,DockClampToScreen=groupConfig.DockClampToScreen,DockResizable=groupConfig.DockResizable,DockMinWidth=groupConfig.DockMinWidth,DockMinHeight=groupConfig.DockMinHeight,DockMaxWidth=groupConfig.DockMaxWidth,DockMaxHeight=groupConfig.DockMaxHeight,Width=groupConfig.Width,Height=groupConfig.Height}
		local group=side=="right" and host:AddRightGroupbox(payload) or host:AddLeftGroupbox(payload)
		if host.SetColumnRatio then host:SetColumnRatio((tonumber(groupConfig.Ratio) or editorState.Ratio)/100) end
		record.Groups[#record.Groups+1]=group
		activeRecord=record
		activeGroup=group
		updateStatus("Editing "..record.Name.." / "..tostring(payload.Name).." ("..(side=="right" and "right" or "left")..")")
