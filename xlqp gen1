local function XLQPResolveTextColor(value)
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "table" then
		local red = tonumber(value.R or value.r or value[1])
		local green = tonumber(value.G or value.g or value[2])
		local blue = tonumber(value.B or value.b or value[3])
		if red and green and blue then
			if red <= 1 and green <= 1 and blue <= 1 then
				return Color3.new(math.clamp(red, 0, 1), math.clamp(green, 0, 1), math.clamp(blue, 0, 1))
			end
			return Color3.fromRGB(math.clamp(red, 0, 255), math.clamp(green, 0, 255), math.clamp(blue, 0, 255))
		end
	end
	if type(value) ~= "string" then
		return nil
	end
	local text = value:lower():gsub("^%s+", ""):gsub("%s+$", "")
	local named = XLQPTextColorNames[text]
	if named then
		return named
	end
	local hex = text:gsub("^#", ""):gsub("^0x", "")
	if #hex == 6 and hex:match("^[%da-f]+$") then
		local number = tonumber(hex, 16)
		if number then
			return Color3.fromRGB(math.floor(number / 65536) % 256, math.floor(number / 256) % 256, number % 256)
		end
	end
	return nil
end
