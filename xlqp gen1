				writefile(file,(mode=="Floatbeat" and wav16 or wav)(table.concat(out),rate))
				return (getcustomasset or getsynasset)(file)
			end)
			if token~=self.Token then return end
			if ok and asset then
				self.Asset=asset
				self.AssetSource=source
				self.AssetSettings=generationSettings
				self.GeneratedHz=self.Hz.Value
				status.Text="Ready at "..tostring(self.GeneratedHz).." Hz"
				if autoPlay then playAsset(asset) end
				SafeCallback(BytebeatConfig.Callback,BytebeatConfig.Name,self)
