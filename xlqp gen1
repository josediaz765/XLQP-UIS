	local function resolveWindowCompatElements()
		if activeSideTabObject and activeSideTabObject.Container then return GetElements(activeSideTabObject.Container) end
		if activeTopTabObject and activeTopTabObject.Container then return GetElements(activeTopTabObject.Container) end
		if currentTopTabForCreation then
			if currentTopTabForCreation.Container then return GetElements(currentTopTabForCreation.Container) end
			local first=currentTopTabForCreation.SideTabs and currentTopTabForCreation.SideTabs[1]
			if first and first.Container then return GetElements(first.Container) end
		end
		local created=TabFunction:newmaketabtop({Name="Main",MultiTab=false,AutoSelect=true})
		return created
	end
	for _,methodName in ipairs({"AddToggle","AddSlider","AddDropdown","AddTextbox","AddInput","AddButton","AddLabel","AddParagraph","AddColorpicker","AddKeybind","AddKeyPicker","AddLeftGroupbox","AddRightGroupbox"}) do
		if TabFunction[methodName]==nil then
			TabFunction[methodName]=function(self,...)
				local elements=resolveWindowCompatElements()
				local method=elements and elements[methodName]
				if type(method)=="function" then return method(elements,...) end
				return nil
			end
		end
	end

	XLQPGen1._ActiveWindow = TabFunction
	task.defer(function()
		local code = XLQPGen1._PendingLanguage or XLQPGen1:GetSavedLanguage()
		if code and code ~= "" and code ~= "en" then
			pcall(function() XLQPGen1:SetLanguage(code) end)
		elseif code then
			XLQPGen1._SelectedLanguage = code
		end
	end)
	return TabFunction
end



