function ElementFunction:AddXLQPGen1AI(AIConfig)
	AIConfig = AIConfig or {}
	AIConfig.Name = AIConfig.Name or "XLQP Gen1 AI"
	AIConfig.Height = AIConfig.Height or 520
	AIConfig.Ai = true
	AIConfig.Gui = AIConfig.Gui ~= false
	if AIConfig.UltraAI ~= nil or AIConfig.ultraai ~= nil then
		XLQPGen1.AIService.Config.UltraAI = (AIConfig.UltraAI == true or AIConfig.ultraai == true)
	end
	for configKey, serviceKey in pairs({CompanionEnabled="CompanionEnabled",FollowEnabled="FollowEnabled",UsePlayerAnimations="UsePlayerAnimations",BubbleResponses="BubbleResponses",ChatPromptsOnly="ChatPromptsOnly",WorldToolsEnabled="WorldToolsEnabled",ThemeToolsEnabled="ThemeToolsEnabled",FollowDistance="FollowDistance",WalkSpeed="WalkSpeed",CompanionName="CompanionName"}) do
		if AIConfig[configKey] ~= nil then XLQPGen1.AIService.Config[serviceKey] = AIConfig[configKey] end
	end
	XLQPGen1.AIService:Save()
	if XLQPGen1.AIService.Config.UltraAI then task.defer(function() XLQPGen1.AIService:EnsureCompanion() end) end

	local function mountAI(result)
		local wrapper = result and result.Wrapper
		if typeof(wrapper) ~= "Instance" or not wrapper:IsA("GuiObject") then return nil end
		wrapper.Parent = ItemParent
		wrapper.Visible = true
		wrapper.LayoutOrder = tonumber(AIConfig.LayoutOrder) or wrapper.LayoutOrder
		wrapper.Size = UDim2.new(1, 0, 0, math.clamp(tonumber(AIConfig.Height) or 520, 360, 760))
		wrapper.ZIndex = 10
		local function lift(gui)
			if not gui:IsA("GuiObject") then return end
			local baseZIndex = gui:GetAttribute("XLQPAIBaseZIndex")
			if type(baseZIndex) ~= "number" then
				baseZIndex = gui.ZIndex
				gui:SetAttribute("XLQPAIBaseZIndex", baseZIndex)
			end
			gui.ZIndex = wrapper.ZIndex + math.max(1, math.floor(baseZIndex))
		end
		for _, descendant in ipairs(wrapper:GetDescendants()) do lift(descendant) end
		wrapper.DescendantAdded:Connect(function(descendant) task.defer(lift, descendant) end)
		if ItemParent:IsA("ScrollingFrame") then ItemParent.CanvasPosition = Vector2.new(0, 0) end
		if not result._XLQPAIVisibilityConnection then
			result._XLQPAIVisibilityConnection = ItemParent:GetPropertyChangedSignal("Visible"):Connect(function()
				if ItemParent.Visible and wrapper.Parent == ItemParent then wrapper.Visible = true end
			end)
		end
		result.Show = function(self)
			if wrapper.Parent ~= ItemParent then wrapper.Parent = ItemParent end
			wrapper.Visible = true
			if ItemParent:IsA("ScrollingFrame") then ItemParent.CanvasPosition = Vector2.new(0, 0) end
			return self
		end
		result.Hide = function(self) wrapper.Visible = false return self end
		return result
	end

	local built, result = pcall(function() return self:AddTextbox(AIConfig) end)
	if built and mountAI(result) then return result end
	for _, child in ipairs(ItemParent:GetChildren()) do
		if child:IsA("GuiObject") and child.Name == "VerbalAI" then child:Destroy() end
	end

	local fallback = {Value = "", Type = "XLQPGen1AI", Save = false, Name = AIConfig.Name}
	local frame = Create("Frame", {
		Name = "VerbalAI", Size = UDim2.new(1, 0, 0, math.clamp(tonumber(AIConfig.Height) or 520, 360, 760)),
		BackgroundColor3 = Color3.fromRGB(16, 16, 21), BorderSizePixel = 0, ClipsDescendants = true, Parent = ItemParent
	})
	frame:SetAttribute("NoLiquidGlass", true)
	Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = frame})
	Create("UIStroke", {Color = Color3.fromRGB(70, 74, 88), Transparency = 0.15, Parent = frame})
	local header = Create("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Color3.fromRGB(22, 23, 29), BorderSizePixel = 0, Parent = frame})
	Create("TextLabel", {Size = UDim2.new(1, -150, 1, 0), Position = UDim2.new(0, 14, 0, 0), BackgroundTransparency = 1, Text = tostring(AIConfig.Name), TextColor3 = Color3.fromRGB(245, 246, 252), Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = header})
	local status = Create("TextLabel", {Size = UDim2.new(0, 100, 1, 0), Position = UDim2.new(1, -148, 0, 0), BackgroundTransparency = 1, Text = "ready", TextColor3 = Color3.fromRGB(160, 166, 184), Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Parent = header})
	local settings = Create("TextButton", {Size = UDim2.new(0, 38, 0, 28), Position = UDim2.new(1, -46, 0.5, -14), BackgroundColor3 = Color3.fromRGB(42, 45, 56), Text = "AI", TextColor3 = Color3.fromRGB(245, 246, 252), Font = Enum.Font.GothamBold, TextSize = 11, Parent = header})
	Create("UICorner", {CornerRadius = UDim.new(0, 7), Parent = settings})
	local history = Create("ScrollingFrame", {Size = UDim2.new(1, -20, 1, -122), Position = UDim2.new(0, 10, 0, 54), BackgroundColor3 = Color3.fromRGB(19, 20, 26), BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(), Parent = frame})
	Create("UICorner", {CornerRadius = UDim.new(0, 9), Parent = history})
	local output = Create("TextLabel", {Size = UDim2.new(1, -20, 0, 0), Position = UDim2.new(0, 10, 0, 10), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = "XLQP Gen1 AI is ready.", TextColor3 = Color3.fromRGB(228, 230, 240), Font = Enum.Font.Gotham, TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = history})
	local input = Create("TextBox", {Size = UDim2.new(1, -104, 0, 44), Position = UDim2.new(0, 10, 1, -56), BackgroundColor3 = Color3.fromRGB(29, 31, 39), Text = "", PlaceholderText = "Ask XLQP Gen1 AI...", TextColor3 = Color3.fromRGB(242, 243, 248), PlaceholderColor3 = Color3.fromRGB(135, 139, 154), Font = Enum.Font.Gotham, TextSize = 13, ClearTextOnFocus = false, Parent = frame})
	Create("UICorner", {CornerRadius = UDim.new(0, 9), Parent = input})
	Create("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = input})
	local send = Create("TextButton", {Size = UDim2.new(0, 84, 0, 44), Position = UDim2.new(1, -94, 1, -56), BackgroundColor3 = Color3.fromRGB(88, 101, 242), Text = "Ask", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 13, Parent = frame})
	Create("UICorner", {CornerRadius = UDim.new(0, 9), Parent = send})
	local busy = false
	local function append(text)
		output.Text = output.Text .. "\n\n" .. tostring(text or "")
		task.defer(function() history.CanvasSize = UDim2.new(0, 0, 0, output.AbsoluteSize.Y + 24) history.CanvasPosition = Vector2.new(0, math.max(0, output.AbsoluteSize.Y)) end)
	end
	local function ask()
		local prompt = tostring(input.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if busy or prompt == "" then return end
		busy = true input.Text = "" status.Text = "thinking"
		append("You: " .. prompt)
		task.spawn(function()
			if XLQPGen1.AIService:IsThemeRequest(prompt) then
				local callOk,success,message=pcall(function() return XLQPGen1.AIService:CreateThemeFromPrompt(prompt) end)
				append("AI: "..tostring(callOk and message or success or "Theme request failed"))
				status.Text=callOk and success and "theme applied" or "error"
			else
				local callOk, success, answer, provider = pcall(function() return XLQPGen1.AIService:Prompt(prompt) end)
				append(callOk and success and ("AI: " .. tostring(answer)) or ("AI: " .. tostring(callOk and answer or success or "Request failed")))
				status.Text = callOk and success and tostring(provider or "ready") or "error"
			end
			busy = false
		end)
	end
	settings.Activated:Connect(function() XLQPGen1:OpenAISettings(AIConfig.Name) end)
	send.Activated:Connect(ask)
	input.FocusLost:Connect(function(enterPressed) if enterPressed then ask() end end)
	fallback.Wrapper = frame fallback.InputBox = input fallback.SendButton = send fallback.Output = output
	function fallback:Set(value) self.Value = tostring(value or "") input.Text = self.Value return self end
	WindowConfig._LocalRegisterState.SetupElement(AIConfig,frame,frame,fallback)
	table.insert(XLQPGen1.AllElements, fallback)
	return mountAI(fallback)
end

		function ElementFunction:AddColorpicker(ColorpickerConfig)
	ColorpickerConfig = ColorpickerConfig or {}
	ColorpickerConfig.Name = ColorpickerConfig.Name or "Colorpicker"
	ColorpickerConfig.Default = ColorpickerConfig.Default or Color3.fromRGB(255,255,255)
	ColorpickerConfig.Callback = ColorpickerConfig.Callback or function() end
	ColorpickerConfig.Flag = ColorpickerConfig.Flag or nil
	ColorpickerConfig.Save = ColorpickerConfig.Save or false
	ColorpickerConfig.Locked = ColorpickerConfig.Locked or false
	ColorpickerConfig.Image = ColorpickerConfig.Image or nil
	local GradientMode = ColorpickerConfig.Gradient == true or typeof(ColorpickerConfig.Default) == "ColorSequence"
	local RawTransparency = ColorpickerConfig.Transparency
	if RawTransparency == nil then RawTransparency = ColorpickerConfig.Alpha end
	local DefaultAlpha = typeof(RawTransparency) == "number" and math.clamp(RawTransparency, 0, 1) or 0
	local DefaultGradient = typeof(ColorpickerConfig.Default) == "ColorSequence" and ColorpickerConfig.Default or ColorSequence.new(ColorpickerConfig.Default)
	local DefaultGradientTransparency = typeof(RawTransparency) == "NumberSequence" and RawTransparency or NumberSequence.new(DefaultAlpha)
	local GradientStops = {}
	local SelectedGradientStop = 1
	local GradientStopSerial = 0
	local function SampleTransparency(sequence, position)
		local keypoints = sequence.Keypoints
		if position <= keypoints[1].Time then return keypoints[1].Value end
		for index = 2, #keypoints do
			local right = keypoints[index]
			if position <= right.Time then
				local left = keypoints[index - 1]
				local span = right.Time - left.Time
				local amount = span > 0 and (position - left.Time) / span or 0
				return left.Value + (right.Value - left.Value) * amount
			end
		end
		return keypoints[#keypoints].Value
	end
	local function LoadGradientStops(sequence, transparency)
		table.clear(GradientStops)
		for _, keypoint in ipairs(sequence.Keypoints) do
			GradientStopSerial += 1
			GradientStops[#GradientStops + 1] = {
				Id = GradientStopSerial,
				Time = keypoint.Time,
				Color = keypoint.Value,
				Transparency = SampleTransparency(transparency, keypoint.Time)
			}
		end
		if #GradientStops == 1 then
			GradientStopSerial += 1
