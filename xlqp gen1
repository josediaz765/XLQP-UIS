			freeHost:SetAttribute("NoLiquidGlass",true)
			local hitbox=SetProps(MakeElement("Button"),{Name="DrawHitbox",Size=UDim2.fromScale(1,1),Text="",BackgroundTransparency=1,AutoButtonColor=false,Active=true,ZIndex=120,Parent=canvas})
			hitbox:SetAttribute("NoLiquidGlass",true)
			local function syncCellSize()
				local size=gridHost.AbsoluteSize
				local availableW=math.max(1,size.X-(GridConfig.Columns-1)*cellPad)
				local availableH=math.max(1,size.Y-(GridConfig.Rows-1)*cellPad)
				cellW=math.max(2,availableW/GridConfig.Columns)
				cellH=math.max(2,availableH/GridConfig.Rows)
				for index,cell in pairs(cells) do
					local col=((index-1)%GridConfig.Columns)
					local row=math.floor((index-1)/GridConfig.Columns)
					cell.Size=UDim2.new(0,cellW,0,cellH)
					cell.Position=UDim2.new(0,col*(cellW+cellPad),0,row*(cellH+cellPad))
				end
			end
			local function updateStatus()
				status.Text=Grid.Tool.." • size "..tostring(Grid.BrushSize).." • boxes "..(Grid.Boxes and "on" or "off")
			end
			local function cleanGridObject(obj)
				obj:SetAttribute("NoLiquidGlass",true)
				for _,child in ipairs(obj:GetChildren()) do
					if child:IsA("UICorner") or child.Name=="LiquidGlassStroke" or child.Name=="LiquidGlassRim" or child.Name=="LiquidGlassGradient" then
						child:Destroy()
					end
				end
			end
			local function makeCell(index)
				local cell=SetProps(MakeElement("Frame"),{Name="Cell"..index,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.94,BorderSizePixel=0,ZIndex=11})
				cleanGridObject(cell)
				cell.Parent=gridHost
				return cell
			end
			for i=1,GridConfig.Columns*GridConfig.Rows do
				cells[i]=makeCell(i)
				if i%256==0 then task.wait() end
			end
			syncCellSize()
			task.defer(syncCellSize)
			AddConnection(canvas:GetPropertyChangedSignal("AbsoluteSize"),function()
				if WindowConfig._LocalRegisterState.resizeWorkPaused() then WindowConfig._LocalRegisterState.queueResizeFollowup(canvas,function() if WindowConfig._LocalRegisterState.isGuiBranchVisible(canvas) then syncCellSize() end end) return end
				if WindowConfig._LocalRegisterState.isGuiBranchVisible(canvas) then syncCellSize() end
			end)
			local function clampPoint(pos)
				local abs=canvas.AbsolutePosition
				local size=canvas.AbsoluteSize
				return math.clamp(pos.X-abs.X,0,size.X),math.clamp(pos.Y-abs.Y,0,size.Y)
			end
			local function paintCell(col,row,color,erase)
				if col<1 or row<1 or col>GridConfig.Columns or row>GridConfig.Rows then return end
				local index=(row-1)*GridConfig.Columns+col
				local cell=cells[index]
				if not cell then return end
				if erase then
					cell.BackgroundColor3=Color3.fromRGB(255,255,255)
					cell.BackgroundTransparency=0.94
					Grid.Value[index]=nil
