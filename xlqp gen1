function XLQPGen1:ResolveElement(target)
	if type(target) == "function" then
		local ok, value = pcall(target)
		if ok then target = value end
	end
	if typeof(target) == "Instance" then return target, nil end
	if type(target) == "table" then
		local frame = target._XLQPFrame or target.Wrapper or target.Frame or target.Instance or target.Container
		if typeof(frame) == "Instance" then return frame, target end
		return nil, target
	end
	if type(target) == "string" and target ~= "" then
		local object = self.CallbackTargets[target]
		if type(object) ~= "table" then
			local flag = self.Flags and self.Flags[target]
			if type(flag) == "table" then object = flag end
		end
		if type(object) ~= "table" then
			for _, element in ipairs(self.AllElements or {}) do
				if type(element) == "table" and tostring(element.Name or "") == target then object = element break end
			end
		end
		if type(object) == "table" then
			local frame = object._XLQPFrame or object.Wrapper or object.Frame
			if typeof(frame) == "Instance" then return frame, object end
		end
	end
	return nil, nil
end

function XLQPGen1:ScrollIntoView(target, padding)
	if typeof(target) ~= "Instance" or not target:IsA("GuiObject") then return false end
	padding = tonumber(padding) or 14
	local current = target.Parent
	while current do
		if current:IsA("ScrollingFrame") then
			local relativeX = target.AbsolutePosition.X - current.AbsolutePosition.X + current.CanvasPosition.X
			local relativeY = target.AbsolutePosition.Y - current.AbsolutePosition.Y + current.CanvasPosition.Y
			local canvasX, canvasY = current.CanvasPosition.X, current.CanvasPosition.Y
			if relativeX < canvasX then
				canvasX = math.max(0, relativeX - padding)
			elseif relativeX + target.AbsoluteSize.X > canvasX + current.AbsoluteWindowSize.X then
				canvasX = math.max(0, relativeX + target.AbsoluteSize.X - current.AbsoluteWindowSize.X + padding)
			end
			if relativeY < canvasY then
				canvasY = math.max(0, relativeY - padding)
			elseif relativeY + target.AbsoluteSize.Y > canvasY + current.AbsoluteWindowSize.Y then
				canvasY = math.max(0, relativeY + target.AbsoluteSize.Y - current.AbsoluteWindowSize.Y + padding)
			end
			local goal = Vector2.new(canvasX, canvasY)
			pcall(function()
				TweenService:Create(current, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {CanvasPosition = goal}):Play()
			end)
		end
		current = current.Parent
	end
	return true
end

function XLQPGen1:FlashElement(target, color, pulses)
	if type(target) == "table" then target = self:ResolveElement(target) end
	if typeof(target) ~= "Instance" or not target:IsA("GuiObject") then return false end
	local theme = self.Themes[self.SelectedTheme] or {}
	color = XLQPResolveTagColor(color, theme.Bloom or Color3.fromRGB(255, 255, 255))
	local highlight = target:FindFirstChild("XLQPFocusHighlight")
	if not highlight then
		highlight = Create("UIStroke", {
			Name = "XLQPFocusHighlight",
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			LineJoinMode = Enum.LineJoinMode.Round,
			Thickness = 2,
			Transparency = 1,
			Parent = target
		})
	end
	highlight.Color = color
	local token = (target:GetAttribute("XLQPFocusToken") or 0) + 1
	target:SetAttribute("XLQPFocusToken", token)
	task.spawn(function()
		for _ = 1, math.clamp(math.floor(tonumber(pulses) or 3), 1, 8) do
			if target:GetAttribute("XLQPFocusToken") ~= token or not highlight.Parent then return end
			TweenService:Create(highlight, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {Transparency = 0.05, Thickness = 2.6}):Play()
			task.wait(0.2)
			TweenService:Create(highlight, TweenInfo.new(0.26, Enum.EasingStyle.Quad), {Transparency = 1, Thickness = 2}):Play()
			task.wait(0.3)
		end
	end)
	return true
end

function XLQPGen1:FocusElement(target, options)
	options = type(options) == "table" and options or {}
	local frame, object = self:ResolveElement(target)
	if not frame then return false end

	local reveals = {}
	local node = frame
	while node do
		local reveal = self._FocusRevealers[node]
		if reveal then table.insert(reveals, 1, reveal) end
		node = node.Parent
	end
	for _, reveal in ipairs(reveals) do pcall(reveal) end

	local selected = false
	if type(AllSideTabObjects) == "table" and type(SelectSideTab) == "function" then
		node = frame
		while node and not selected do
			for _, sideTab in ipairs(AllSideTabObjects) do
				if sideTab.Container == node then
					pcall(SelectSideTab, sideTab)
					selected = true
					break
				end
			end
			node = node.Parent
		end
	end
	if not selected and type(AllTopTabObjects) == "table" and type(SelectTopTab) == "function" then
		node = frame
		while node and not selected do
			for _, topTab in ipairs(AllTopTabObjects) do
				if topTab.Container == node then
					pcall(SelectTopTab, topTab)
					selected = true
					break
				end
			end
			node = node.Parent
		end
	end

	task.defer(function()
		self:ScrollIntoView(frame, options.Padding)
		task.wait(0.08)
		self:ScrollIntoView(frame, options.Padding)
		if options.Flash ~= false then self:FlashElement(frame, options.Color, options.Pulses) end
	end)

	if options.Notify and self.MakeToast then
		pcall(function()
			self:MakeToast({
				Title = tostring(options.NotifyTitle or "Jumped to element"),
				Content = tostring(options.Notify == true and (object and object.Name or "Element") or options.Notify),
				Variant = "Info",
				Icon = "info",
				Time = 3
			})
		end)
	end
	if type(options.Callback) == "function" then
		SafeCallback(options.Callback, "FocusElement", object, frame)
	end
	return true, object, frame
end

