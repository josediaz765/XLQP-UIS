function XLQPGen1:_RepairCurrentSidebar()
if not (AllTopTabObjects and AllSideTabObjects) then return end
for _,topTab in ipairs(AllTopTabObjects) do
if topTab.Button then
topTab.Button.Visible=true
topTab.Button.ClipsDescendants=true
local title=topTab.Button:FindFirstChild("Title")
if title then title.Visible=true end
end
end
local isMulti=activeTopTabObject and activeTopTabObject.IsMultiTab==true
if TabHolder then TabHolder.Visible=isMulti end
local sidebarExpanded=(not WindowConfig or WindowConfig.ShowTabInfo~=false) and (not WindowStuff or WindowStuff.AbsoluteSize.X>96)
local normalSize
if WindowConfig and WindowConfig.ShowTabInfo==true then
normalSize=UDim2.new(1,-28,0,bigUIEnabled and 48 or 42)
else
normalSize=UDim2.new(1,-16,0,46)
end
for _,group in pairs(SideTabGroups or {}) do
if group.Button then
local visible=isMulti and group.ParentTopTab==activeTopTabObject
group.Button.Visible=visible
group.Button.Size=visible and UDim2.new(1,0,0,44) or UDim2.new(1,0,0,0)
group.Button.ClipsDescendants=true
local title=group.Button:FindFirstChild("Title")
if title then title.Visible=visible and sidebarExpanded end
local icon=group.Button:FindFirstChild("Ico")
if icon then icon.Visible=visible end
local arrow=group.Button:FindFirstChild("Arrow")
if arrow then arrow.Visible=visible and sidebarExpanded end
end
end
for _,sideTab in ipairs(AllSideTabObjects) do
local button=sideTab.Button
local belongs=isMulti and sideTab.ParentTopTab==activeTopTabObject
local collapsed=sideTab.Group and sideTab.Group.Collapsed==true
local visible=belongs and not collapsed
if button then
button.Visible=visible
button.Size=visible and normalSize or UDim2.new(1,0,0,0)
button.ClipsDescendants=true
local title=button:FindFirstChild("Title")
if title then
title.Visible=visible and sidebarExpanded
title.TextTruncate=Enum.TextTruncate.AtEnd
end
local icon=button:FindFirstChild("Ico")
if icon then icon.Visible=visible end
end
if sideTab.Container then
sideTab.Container.Visible=visible and sideTab==activeSideTabObject
end
end
if activeTopTabObject and not activeTopTabObject.IsMultiTab and activeTopTabObject.Container then
activeTopTabObject.Container.Visible=true
end
if TabHolder then
local layout=TabHolder:FindFirstChildOfClass("UIListLayout")
if layout then
TabHolder.CanvasSize=UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+16)
end
end
end

