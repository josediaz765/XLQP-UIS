	function MediaPlayerObject:AddToPlaylist(name, url)
		local incoming
		if type(name)=="table" then
			incoming=name
			url=incoming.url or incoming.Url or incoming.URL or incoming.SoundId or incoming.Asset
			name=incoming.name or incoming.Name or incoming.Title or extractFileName(tostring(url or ""))
		elseif not url then url = name name = extractFileName(tostring(url or "")) end
		if url and tostring(url):gsub("%s","") ~= "" then
			url=tostring(url)
			for index,item in ipairs(playlist) do
				local itemUrl=tostring(item.url or item.Url or item.URL or item.SoundId or "")
				if itemUrl==url or (incoming and incoming.VideoId and item.VideoId==incoming.VideoId) then
					item.name=tostring(name or item.name or extractFileName(url))
					if incoming then for key,value in pairs(incoming) do item[key]=value end end
					savePlaylist()
					updatePlaylistUI()
					return self,index
				end
			end
			local item=incoming or {name=tostring(name or extractFileName(url)),url=url}
			item.name=tostring(item.name or name or extractFileName(url))
			item.url=url
			table.insert(playlist,item)
			savePlaylist()
			updatePlaylistUI()
			return self,#playlist
		end
		return self,nil
	end
