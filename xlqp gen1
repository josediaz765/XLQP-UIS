				local y=math.clamp(input.Position.Y-frame.AbsolutePosition.Y+(tonumber(TagConfig.OffsetY) or 16),2,math.max(2,frame.AbsoluteSize.Y-math.max(chip.AbsoluteSize.Y,20)-2))
