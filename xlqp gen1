			local runToken=0
			local function format(value)
				local number=string.format("%."..ProgressConfig.Decimals.."f",value)
				return ProgressConfig.Prefix..number..ProgressConfig.Suffix
			end
			local function ratio(value)
				return math.clamp((value-Progress.Min)/(Progress.Max-Progress.Min),0,1)
			end
			function Progress:Set(value,text,silent,instant)
				value=math.clamp(tonumber(value) or self.Value,self.Min,self.Max)
				self.Value=value
				local percent=ratio(value)
				if tween then pcall(function() tween:Cancel() end) end
				if instant then
					fill.Size=UDim2.new(percent,0,1,0)
				else
					tween=TweenService:Create(fill,TweenInfo.new(ProgressConfig.TweenTime,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Size=UDim2.new(percent,0,1,0)})
					tween:Play()
				end
				valueLabel.Text=text or format(value)
				if not silent then SafeCallback(ProgressConfig.Callback,ProgressConfig.Name,value,percent,self) end
				if not silent and XLQPGen1.SaveCfg and ProgressConfig.Save then pcall(SaveCfg,game.GameId) end
				return self
			end
			function Progress:SetProgress(value,text) return self:Set(value,text) end
			function Progress:SetRange(minimum,maximum)
				minimum=tonumber(minimum) or self.Min
				maximum=tonumber(maximum) or self.Max
				if maximum<=minimum then maximum=minimum+1 end
				self.Min,self.Max=minimum,maximum
				ProgressConfig.Min,ProgressConfig.Max=minimum,maximum
				return self:Set(self.Value,nil,true,true)
			end
			function Progress:SetDescription(value)
				ProgressConfig.Description=tostring(value or "")
				desc.Text=ProgressConfig.Description
				desc.Visible=ProgressConfig.Description~=""
				frame.Size=UDim2.new(1,0,0,desc.Visible and 64 or 48)
				frame:SetAttribute("SearchName",ProgressConfig.Name.." "..ProgressConfig.Description)
				return self
			end
			function Progress:SetName(value)
				ProgressConfig.Name=tostring(value or "Progress")
				self.Name=ProgressConfig.Name
				title.Text=ProgressConfig.Name
				frame:SetAttribute("SearchName",ProgressConfig.Name.." "..ProgressConfig.Description)
				return self
			end
			function Progress:SetColor(color,color2)
				if typeof(color)=="Color3" then ProgressConfig.Color=color end
				if typeof(color2)=="Color3" then ProgressConfig.Color2=color2 else ProgressConfig.Color2=ProgressConfig.Color:Lerp(Color3.fromRGB(72,255,201),0.42) end
				fill.BackgroundColor3=ProgressConfig.Color
				local gradient=fill:FindFirstChildOfClass("UIGradient")
				if gradient then gradient.Color=ColorSequence.new(ProgressConfig.Color,ProgressConfig.Color2) end
				return self
			end
			function Progress:Increment(amount) return self:Set(self.Value+(tonumber(amount) or 1)) end
			function Progress:Reset(value) self:Stop() return self:Set(tonumber(value) or self.Min,nil,false,false) end
			function Progress:Complete() self:Stop() return self:Set(self.Max,nil,false,false) end
			function Progress:Pause() self.Paused=true return self end
			function Progress:Resume() self.Paused=false return self end
			function Progress:Stop()
				runToken=runToken+1
				self.Running=false
				self.Paused=false
				return self
			end
			function Progress:Start(options)
				options=type(options)=="table" and options or {Duration=tonumber(options)}
				self:Stop()
				runToken=runToken+1
				local token=runToken
				local startValue=tonumber(options.From) or self.Min
				local endValue=tonumber(options.To) or self.Max
				local duration=math.max(0.1,tonumber(options.Duration) or tonumber(ProgressConfig.DownloadTime) or 5)
				local step=math.max(0.02,tonumber(options.StepTime) or 0.08)
				local started=os.clock()
				self.Running=true
				self.Paused=false
				self:Set(startValue,nil,true,true)
				task.spawn(function()
					local pauseStarted=nil
					local pausedFor=0
					while token==runToken and self.Running and frame.Parent do
						if self.Paused then
							pauseStarted=pauseStarted or os.clock()
							task.wait(step)
						else
							if pauseStarted then pausedFor=pausedFor+(os.clock()-pauseStarted) pauseStarted=nil end
							local alpha=math.clamp((os.clock()-started-pausedFor)/duration,0,1)
							self:Set(startValue+(endValue-startValue)*alpha,nil,true,false)
							if alpha>=1 then break end
							task.wait(step)
						end
					end
					if token==runToken and self.Running then
						self.Running=false
						self:Set(endValue,nil,false,false)
						SafeCallback(options.Completed or ProgressConfig.Completed,ProgressConfig.Name,self)
					end
				end)
				return self
			end
			function Progress:Replay(options) self:Reset(self.Min) return self:Start(options) end
			Progress:Set(Progress.Value,nil,true,true)
			Progress.Wrapper=frame
			Progress.Frame=frame
			Progress.Track=track
			Progress.Fill=fill
			table.insert(XLQPGen1.AllElements,Progress)
			WindowConfig._LocalRegisterState.SetupElement(ProgressConfig,frame,frame,Progress)
			if ProgressConfig.Flag then XLQPGen1.Flags[ProgressConfig.Flag]=Progress end
			if ProgressConfig.AutoStart then task.defer(function() if frame.Parent then Progress:Start(ProgressConfig) end end) end
			return Progress
		end
		ElementFunction.AddProgress=ElementFunction.CreateProgress
		ElementFunction.CreateProgressBar=ElementFunction.CreateProgress

	end

	function XLQPGen1:_InstallDownloadProgressElement(ElementFunction,ItemParent)
		function ElementFunction:CreateDownloadProgress(DownloadConfig)
			DownloadConfig=type(DownloadConfig)=="table" and DownloadConfig or {Name=tostring(DownloadConfig or "Download")}
			DownloadConfig.Name=DownloadConfig.Name or "Download"
			DownloadConfig.Icon=DownloadConfig.Icon or "download"
			DownloadConfig.Min=tonumber(DownloadConfig.Min) or 0
			DownloadConfig.Max=tonumber(DownloadConfig.Max) or 100
			DownloadConfig.Suffix=DownloadConfig.Suffix or "%"
			DownloadConfig.Description=DownloadConfig.Description or DownloadConfig.Desc or "Download progress"
			local autoStart=DownloadConfig.AutoStart==true
			DownloadConfig.AutoStart=false
			local download=self:CreateProgress(DownloadConfig)
			DownloadConfig.AutoStart=autoStart
			download.Type="DownloadProgress"
			function download:Download(duration,completed)
				return self:Start({From=self.Min,To=self.Max,Duration=duration or DownloadConfig.Duration or DownloadConfig.DownloadTime or 5,Completed=completed or DownloadConfig.Completed})
			end
			function download:Cancel(reset)
				self:Stop()
				if reset~=false then self:Set(self.Min,nil,false,false) end
				SafeCallback(DownloadConfig.Cancelled,DownloadConfig.Name,self)
				return self
			end
			if autoStart then task.defer(function() if download.Wrapper and download.Wrapper.Parent then download:Download() end end) end
			return download
		end
		ElementFunction.AddDownloadProgress=ElementFunction.CreateDownloadProgress
		ElementFunction.CreateDownload=ElementFunction.CreateDownloadProgress
		ElementFunction.AddDownload=ElementFunction.CreateDownloadProgress
	end

