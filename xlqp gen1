			sender_display_name=msg.sender_display_name or msg.senderDisplayName or msg.display_name or msg.displayName or msg.author_display_name or msg.authorDisplayName or msg.sender_name or msg.username or (sender==player.UserId and player.DisplayName or self.TargetName),
