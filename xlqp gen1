function XLQPGen1:IsLoggerWhitelisted(url)
	url=tostring(url or ""):lower():gsub("%s+","")
	if url=="" then return false end
	if self.AntiLogger.Allowed[url] then return true end
	for allowed in pairs(self.AntiLogger.Allowed) do
		if allowed~="" and (url:find(allowed,1,true) or allowed:find(url,1,true)) then
			return true
		end
	end
	return false
end

function XLQPGen1:LoggerReason(url)
	url=tostring(url or ""):lower()
	if self:IsLoggerWhitelisted(url) then return nil end
	for _,pattern in ipairs(self.AntiLogger.Patterns) do
		if url:find(pattern) then
			if pattern:find("webhook") or pattern=="webhook.site" or pattern=="canarytokens.com" then
				return self.AntiLogger.BlockWebhooks and "Webhook" or nil
			end
			return self.AntiLogger.BlockIPLoggers and "IP Logger" or nil
		end
	end
	return nil
end

