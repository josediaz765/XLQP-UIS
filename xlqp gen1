	function XLQPGen1:CreatePluginFromSource(name,code,executeNow)
		local source=tostring(code or "")
		if source=="" then return false,"Plugin source is empty." end
		local valid,validationError=PluginsData:ValidateSource(source,name)
		if not valid then return false,"Plugin validation failed: "..tostring(validationError) end
		local saved,pathOrError=PluginsData:Save(source,name)
		if not saved then return false,tostring(pathOrError) end
		refreshPluginsList()
		local record
		for _,item in ipairs(PluginsData.Items) do if item.Path==pathOrError then record=item break end end
		if executeNow~=false and record then
			local ran,runError=PluginsData:Execute(record)
			if not ran then
				if delfile then pcall(delfile,pathOrError) end
				refreshPluginsList()
				return false,"Plugin runtime verification failed and the broken file was removed: "..tostring(runError)
			end
		end
		if record then selectPluginRecord(record) end
		return true,"Plugin saved"..(executeNow~=false and " and executed" or "")..".",pathOrError
	end
