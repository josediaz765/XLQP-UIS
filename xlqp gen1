	local function runLuaAction(tabId, scriptCode, process)
		scriptCode = tostring(scriptCode or "")
		if scriptCode == "" then return false, "empty script" end
		if not loadstring then return false, "loadstring is not available in this executor" end
		if process then process:Event({State = "start", Id = "execute_script", Tool = "execute_script", Detail = "Running the Lua action"}) end
		local func, err = loadstring(scriptCode)
		if not func then
			if process then process:Event({State = "fail", Id = "execute_script", Tool = "execute_script", Detail = tostring(err)}) end
			return false, tostring(err)
		end
		local captured = {}
		local baseEnv = nil
		pcall(function()
			baseEnv = getfenv and getfenv(0) or _G
		end)
		baseEnv = baseEnv or _G
		local oldPrint = print
		local function capturePrint(...)
			local parts = {}
			for index = 1, select("#", ...) do
				parts[index] = tostring(select(index, ...))
			end
			local line = table.concat(parts, "	")
			if #captured < 80 then
				captured[#captured + 1] = line
			end
			pcall(oldPrint, ...)
		end
		if setfenv then
			local env = setmetatable({print = capturePrint}, {
				__index = function(_, key)
					if key == "print" then return capturePrint end
					local value = baseEnv and baseEnv[key]
					if value ~= nil then return value end
					return _G and _G[key]
				end,
				__newindex = function(_, key, value)
					if baseEnv then
						baseEnv[key] = value
					elseif _G then
						_G[key] = value
					end
				end
			})
			pcall(setfenv, func, env)
		end
		local ok, execErr = pcall(func)
		if not ok then
			if process then process:Event({State = "fail", Id = "execute_script", Tool = "execute_script", Detail = tostring(execErr)}) end
			return false, tostring(execErr)
		end
		local output = table.concat(captured, "\n")
		if output ~= "" and #output > 4000 then
			output = output:sub(1, 4000) .. "\n..."
		end
		if process then process:Event({State = "done", Id = "execute_script", Tool = "execute_script", Detail = output ~= "" and "Action finished with output" or "Action finished"}) end
		return true, nil, output
	end


