				local result = {}
				local configExpected = DependencyConfig.Value
				if configExpected == nil then configExpected = DependencyConfig.Equals end
				for _, item in ipairs(source or {}) do
					if item ~= nil then
						if type(item) == "table" and (item.Element or item.Dependency) then
							local expected = item.Value
							if expected == nil then expected = item.Equals end
							result[#result+1] = {Element=item.Element or item.Dependency,Expected=expected,Operator=item.Operator,Predicate=item.Predicate,Invert=item.Invert==true}
						else
							result[#result+1] = {Element=item,Expected=configExpected,Operator=DependencyConfig.Operator,Predicate=DependencyConfig.Predicate,Invert=DependencyConfig.Invert==true}
						end
					end
				end
				return result
			end
			local function readValue(element)
				if type(element) ~= "table" then return element end
				if type(element.GetValue) == "function" then local ok,value=pcall(element.GetValue,element) if ok then return value end end
				if type(element.GetSelected) == "function" then local ok,value=pcall(element.GetSelected,element) if ok then return value end end
