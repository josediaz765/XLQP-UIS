function liquidGlassShine:Update(deltaTime)
	if not liquidGlassEnabled or XLQPGen1._ReduceLagEnabled then return end
	if (tonumber(XLQPGen1._WindowMotionPausedUntil) or 0)>os.clock() then return end
	local camera=workspace.CurrentCamera
	if not camera then return end
	local viewport=camera.ViewportSize
	if viewport.X<=1 or viewport.Y<=1 then return end
	local look=camera.CFrame.LookVector
	local right=camera.CFrame.RightVector
	local up=camera.CFrame.UpVector
	local yaw=math.atan2(look.X,-look.Z)/math.pi
	local pitch=math.asin(math.clamp(look.Y,-1,1))/(math.pi*0.5)
	local roll=math.atan2(right.Y,up.Y)/math.pi
	local response=1-math.exp(-self.Tracking*math.max(deltaTime,1/120))
	for target,state in pairs(self.Surfaces) do
		local overlay=state and state.Overlay
		local gradient=state and state.Gradient
		local baseGradient=state and state.BaseGradient
		local edgeGradient=state and state.EdgeGradient
		local haze=state and state.Haze
		local caustic=state and state.Caustic
		if not (target and target.Parent and overlay and overlay.Parent and gradient and gradient.Parent) then
			self.Surfaces[target]=nil
		else
			local visible=self:IsVisible(target)
			if overlay.Visible~=visible then overlay.Visible=visible end
			if haze and haze.Parent and haze.Visible~=visible then haze.Visible=visible end
			if caustic and caustic.Parent and caustic.Visible~=visible then caustic.Visible=visible end
			if visible then
				local absolutePosition=target.AbsolutePosition
				local absoluteSize=target.AbsoluteSize
				local center=absolutePosition+absoluteSize*0.5
				local screenX=center.X/viewport.X-0.5
				local screenY=center.Y/viewport.Y-0.5
				local velocity=Vector2.new(0,0)
				if state.LastCenter then velocity=(center-state.LastCenter)/math.max(deltaTime,1/120) end
				state.LastCenter=center
				local movementX=math.clamp((velocity.X/viewport.X)*0.32,-0.16,0.16)
				local movementY=math.clamp((velocity.Y/viewport.Y)*0.24,-0.12,0.12)
				local desired=Vector2.new(
					math.clamp(yaw*0.72-screenX*0.58+movementX,-0.94,0.94),
					math.clamp(-pitch*0.5-screenY*0.3+movementY,-0.68,0.68)
				)
				state.Offset=state.Offset:Lerp(desired,response)
				if (gradient.Offset-state.Offset).Magnitude>0.001 then gradient.Offset=state.Offset end
				local shineRotation=112+roll*34+pitch*10
				if math.abs(gradient.Rotation-shineRotation)>0.05 then gradient.Rotation=shineRotation end
				if baseGradient and baseGradient.Parent and baseGradient.Enabled then
					baseGradient.Offset=Vector2.new(state.Offset.X*0.13,state.Offset.Y*0.1)
					baseGradient.Rotation=112+roll*15+pitch*5
				end
				local drift=os.clock()*0.34+(state.Phase or 0)
				if edgeGradient and edgeGradient.Parent and edgeGradient.Enabled then
					edgeGradient.Offset=Vector2.new(math.clamp(state.Offset.X*0.2+math.sin(drift)*0.08,-0.4,0.4),math.clamp(state.Offset.Y*0.16+math.cos(drift*0.73)*0.06,-0.3,0.3))
					edgeGradient.Rotation=18+roll*28+pitch*9+math.sin(drift*0.55)*5
				end
				if caustic and caustic.Parent then
					caustic.Position=UDim2.new(0.5,math.floor(state.Offset.X*26),0,math.floor(5+state.Offset.Y*4))
					local causticGradient=caustic:FindFirstChild("CausticGradient")
					if causticGradient then causticGradient.Offset=Vector2.new(math.clamp(state.Offset.X*0.3+math.sin(drift*0.6)*0.07,-0.35,0.35),0) end
				end
				local shineTransparency=math.clamp(0.08+math.abs(pitch)*0.06,0.08,0.16)
				if math.abs(overlay.BackgroundTransparency-shineTransparency)>0.002 then overlay.BackgroundTransparency=shineTransparency end
			end
		end
	end
end
