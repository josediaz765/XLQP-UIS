			local function setFromPosition(position)
				if SliderConfig.Locked or track.AbsoluteSize.X <= 0 then return end
				if inputBox and inputBox:IsFocused() then return end
				local percent = math.clamp((position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
