function XLQPResolveTagColor(value, fallback)
	if typeof(value) == "Color3" then return value end
	if type(value) == "string" and value ~= "" then
		local named = XLQPTagColorNames[value:lower()]
		if named then return named end
		local theme = XLQPGen1.Themes[XLQPGen1.SelectedTheme]
		if theme and typeof(theme[value]) == "Color3" then return theme[value] end
		local hex = value:match("^#(%x%x%x%x%x%x)$") or value:match("^(%x%x%x%x%x%x)$")
		if hex then
			local ok, color = pcall(function() return Color3.fromHex(hex) end)
			if ok and color then return color end
		end
	end
	return fallback
end

function XLQPCreateTag(Parent, TagInput, Defaults)
	if typeof(Parent) ~= "Instance" then return nil end
	TagInput = type(TagInput) == "table" and TagInput or {Text = tostring(TagInput or "TAG")}
	Defaults = type(Defaults) == "table" and Defaults or {}

	local variant = XLQPTagVariants[tostring(TagInput.Variant or TagInput.Style or Defaults.Variant or ""):lower():gsub("[%s%-_]", "")]
	local text = tostring(TagInput.Text or TagInput.Title or TagInput.Name or (variant and variant.Text) or "TAG")
	local uppercase = TagInput.Uppercase
	if uppercase == nil then uppercase = Defaults.Uppercase end
	if uppercase == nil then uppercase = true end

	local background = XLQPResolveTagColor(TagInput.Color or TagInput.BackgroundColor or TagInput.BackgroundColor3, variant and variant.Color or Defaults.Color or Color3.fromRGB(120, 46, 168))
	local foreground = XLQPResolveTagColor(TagInput.TextColor or TagInput.TextColor3, variant and variant.TextColor or Defaults.TextColor or Color3.fromRGB(255, 255, 255))
	local height = math.clamp(math.floor(tonumber(TagInput.Height or Defaults.Height) or 24), 14, 64)
	local textSize = math.clamp(math.floor(tonumber(TagInput.TextSize or Defaults.TextSize) or math.max(10, height - 13)), 6, 32)
	local iconSize = math.clamp(math.floor(tonumber(TagInput.IconSize or Defaults.IconSize) or (height - 10)), 8, 48)
	local zIndex = math.clamp(math.floor(tonumber(TagInput.ZIndex or Defaults.ZIndex) or 12), 1, 2000000)

	local Tag = {Type = "Tag", Text = text, Visible = true}

	local frame = Create("TextButton", {
		Name = "XLQPTag",
		Text = "",
		AutoButtonColor = false,
		Active = false,
		Selectable = false,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, height),
		BackgroundColor3 = background,
		BackgroundTransparency = math.clamp(tonumber(TagInput.Transparency or Defaults.Transparency) or 0, 0, 1),
		BorderSizePixel = 0,
		LayoutOrder = math.floor(tonumber(TagInput.LayoutOrder) or 0),
		ZIndex = zIndex,
		Parent = Parent
	}, {
		Create("UICorner", {CornerRadius = UDim.new(0, math.floor(tonumber(TagInput.CornerRadius or Defaults.CornerRadius) or math.floor(height / 2)))}),
		Create("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}),
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 5)
		})
	})
	frame:SetAttribute("NoLiquidGlass", true)
	frame:SetAttribute("XLQPTag", true)

	local icon = SetProps(MakeElement("Image", ""), {
		Name = "TagIcon",
		Size = UDim2.fromOffset(iconSize, iconSize),
		ImageColor3 = foreground,
		LayoutOrder = 0,
		Visible = false,
		ZIndex = zIndex + 1,
		Parent = frame
	})
	icon:SetAttribute("NoLiquidGlassIcon", true)

	local label = SetProps(MakeElement("Label", uppercase and text:upper() or text, textSize), {
		Name = "TagText",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Font = Enum.Font.GothamBlack,
		TextColor3 = foreground,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		BackgroundTransparency = 1,
		RichText = false,
		LayoutOrder = 1,
		ZIndex = zIndex + 1,
		Parent = frame
	})

	local stroke
	if TagInput.Stroke ~= false and Defaults.Stroke ~= false then
		stroke = Create("UIStroke", {
			Name = "TagStroke",
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = XLQPResolveTagColor(TagInput.StrokeColor, background:Lerp(Color3.fromRGB(255, 255, 255), 0.4)),
			Thickness = math.clamp(tonumber(TagInput.StrokeThickness) or 1, 0, 6),
			Transparency = math.clamp(tonumber(TagInput.StrokeTransparency) or 0.45, 0, 1),
			Parent = frame
		})
	end

	Tag.Frame = frame
	Tag.Wrapper = frame
	Tag.Chip = frame
	Tag.Label = label
	Tag.Icon = icon
	Tag.Stroke = stroke
	Tag.Color = background
	Tag.TextColor = foreground
	Tag.Uppercase = uppercase

	function Tag:SetText(value)
		self.Text = tostring(value or "")
		label.Text = self.Uppercase and self.Text:upper() or self.Text
		return self
	end
	Tag.Set = Tag.SetText
	Tag.SetTitle = Tag.SetText

	function Tag:SetIcon(value, size)
		if size ~= nil then
			local resolved = math.clamp(math.floor(tonumber(size) or iconSize), 8, 48)
			icon.Size = UDim2.fromOffset(resolved, resolved)
		end
		if value == nil or value == false or value == "" then
			self.IconValue = nil
			icon.Visible = false
			XLQPAssignProperty(icon, "Image", "")
			return self
		end
		if typeof(value) == "table" then
			return self:SetIcon(value.Icon or value.Image or value.Id, value.Size or value.IconSize)
		end
		local raw = value
		if type(raw) == "number" then raw = "rbxassetid://" .. tostring(raw) end
		raw = tostring(raw)
		if raw:match("^%d+$") then raw = "rbxassetid://" .. raw end
		local resolved = GetIcon(raw) or raw
		self.IconValue = raw
		XLQPAssignProperty(icon, "Image", resolved)
		icon.Visible = true
		return self
	end
	Tag.SetImage = Tag.SetIcon

	function Tag:SetColor(value)
		self.Color = XLQPResolveTagColor(value, self.Color)
		frame.BackgroundColor3 = self.Color
		if stroke then stroke.Color = self.Color:Lerp(Color3.fromRGB(255, 255, 255), 0.4) end
		return self
	end
	Tag.SetBackgroundColor = Tag.SetColor

	function Tag:SetTextColor(value)
		self.TextColor = XLQPResolveTagColor(value, self.TextColor)
		label.TextColor3 = self.TextColor
		icon.ImageColor3 = self.TextColor
		return self
	end

	function Tag:SetTransparency(value)
		frame.BackgroundTransparency = math.clamp(tonumber(value) or 0, 0, 1)
		return self
	end

	function Tag:SetUppercase(value)
		self.Uppercase = value == true
		return self:SetText(self.Text)
	end

	function Tag:SetVisible(value)
		self.Visible = value ~= false
		frame.Visible = self.Visible
		return self
	end
	function Tag:Show() return self:SetVisible(true) end
	function Tag:Hide() return self:SetVisible(false) end

	function Tag:SetTooltip(value)
		self.Tooltip = value and tostring(value) or nil
		frame:SetAttribute("XLQPTagTooltip", self.Tooltip)
		return self
	end

	function Tag:OnClick(callback)
		self.Callback = type(callback) == "function" and callback or nil
		frame.Active = self.Callback ~= nil
		frame.Selectable = self.Callback ~= nil
		if self.Callback and not self._ClickBound then
			self._ClickBound = true
			AddConnection(frame.Activated, function()
				if type(self.Callback) == "function" then
					SafeCallback(self.Callback, "Tag " .. tostring(self.Text), self)
				end
				if self.GotoTarget ~= nil then XLQPGen1:FocusElement(self.GotoTarget) end
			end)
		end
		return self
	end

	function Tag:SetGoto(target)
		self.GotoTarget = target
		if target ~= nil then self:OnClick(self.Callback or function() end) end
		return self
	end

	function Tag:Destroy()
		if type(self.Removed) == "function" then pcall(self.Removed, self) end
		if frame and frame.Parent then frame:Destroy() end
		self.Destroyed = true
		return nil
	end
	Tag.Remove = Tag.Destroy

	if TagInput.Icon ~= nil or (variant and variant.Icon) then
		Tag:SetIcon(TagInput.Icon ~= nil and TagInput.Icon or variant.Icon, TagInput.IconSize)
	end
	if TagInput.Tooltip or TagInput.Hint then Tag:SetTooltip(TagInput.Tooltip or TagInput.Hint) end
	if TagInput.Visible == false then Tag:SetVisible(false) end
	if type(TagInput.Callback) == "function" then Tag:OnClick(TagInput.Callback) end
	local gotoTarget = TagInput.Goto or TagInput.GoTo or TagInput.Redirect or TagInput.Target
	if gotoTarget ~= nil then Tag:SetGoto(gotoTarget) end

	return Tag
end

function XLQPCreateTagRow(Host, RowConfig)
	if typeof(Host) ~= "Instance" then return nil end
	RowConfig = type(RowConfig) == "table" and RowConfig or {}
	local mode = tostring(RowConfig.Position or RowConfig.Mode or "Right"):lower()
	if mode ~= "bottom" then mode = "right" end
	local gap = math.max(0, math.floor(tonumber(RowConfig.Gap) or 6))
	local edgeGap = math.max(0, math.floor(tonumber(RowConfig.EdgeGap) or 8))
	local zIndex = math.clamp(math.floor(tonumber(RowConfig.ZIndex) or 12), 1, 2000000)

	local row = Create("Frame", {
		Name = "XLQPTagRow",
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = zIndex,
		Parent = Host
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			HorizontalAlignment = mode == "bottom" and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, gap)
		})
	})
	row:SetAttribute("NoLiquidGlass", true)
	row:SetAttribute("XLQPTagRow", true)

	local Row = {Tags = {}, Frame = row, Wrapper = row, Mode = mode, Host = Host}

	local function measureRightReserve()
		if tonumber(RowConfig.Offset) then return math.max(0, math.floor(tonumber(RowConfig.Offset))) end
		local reserve = 10
		for _, child in ipairs(Host:GetChildren()) do
			if child ~= row and child:IsA("GuiObject") and child.Visible and child.Size.X.Scale == 0 and child.Position.X.Scale >= 1 then
				reserve = math.max(reserve, -child.Position.X.Offset + child.AnchorPoint.X * child.Size.X.Offset)
			end
		end
		return math.floor(reserve)
	end

	local function measureAnchorY()
		if tonumber(RowConfig.AnchorY) then return math.floor(tonumber(RowConfig.AnchorY)) end
		local height = Host.AbsoluteSize.Y
		if height <= 0 then height = Host.Size.Y.Offset end
		if height > 0 and height <= 64 then return math.floor(height / 2) end
		return math.floor(tonumber(RowConfig.HeaderHeight) or 30)
	end

	local function measureContentBottom()
		local bottom = 0
		for _, child in ipairs(Host:GetChildren()) do
			if child ~= row and child:IsA("GuiObject") and child.Visible and child.Position.Y.Scale == 0 and child.Size.Y.Scale == 0 then
				local height = child.Size.Y.Offset
				if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
					local bounds = 0
					pcall(function() bounds = child.TextBounds.Y end)
					height = math.max(height, bounds)
				elseif child.AbsoluteSize.Y > height then
					height = child.AbsoluteSize.Y
				end
				bottom = math.max(bottom, child.Position.Y.Offset - child.AnchorPoint.Y * height + height)
			end
		end
		return math.floor(bottom)
	end

	local applying = false
	local function apply()
		if applying or not row.Parent then return end
		applying = true
		if mode == "bottom" then
			row.AnchorPoint = Vector2.new(0, 0)
			row.Position = UDim2.new(0, math.floor(tonumber(RowConfig.Left) or 12), 0, measureContentBottom() + math.floor(tonumber(RowConfig.TopGap) or 8))
			if Host.AutomaticSize == Enum.AutomaticSize.None and Host.Size.Y.Scale == 0 then
				local needed = row.Position.Y.Offset + row.AbsoluteSize.Y + math.floor(tonumber(RowConfig.BottomGap) or 10)
				if needed > Host.Size.Y.Offset then
					Host.Size = UDim2.new(Host.Size.X.Scale, Host.Size.X.Offset, 0, math.ceil(needed))
				end
			end
		else
			row.AnchorPoint = Vector2.new(1, 0.5)
			row.Position = UDim2.new(1, -(measureRightReserve() + edgeGap), 0, measureAnchorY())
		end
		applying = false
	end

	local queued = false
	local function queue()
		if queued then return end
		queued = true
		task.defer(function()
			queued = false
			apply()
		end)
	end
	Row.Refresh = function(self) apply() return self end

	AddConnection(Host.ChildAdded, queue)
	AddConnection(Host.ChildRemoved, queue)
	AddConnection(Host:GetPropertyChangedSignal("AbsoluteSize"), queue)
	AddConnection(row:GetPropertyChangedSignal("AbsoluteSize"), queue)
	if mode == "bottom" then
		for _, child in ipairs(Host:GetChildren()) do
			if child:IsA("TextLabel") or child:IsA("TextBox") then
				AddConnection(child:GetPropertyChangedSignal("TextBounds"), queue)
			end
		end
	end
	queue()
	task.delay(0.08, function() if row.Parent then apply() end end)
	task.delay(0.4, function() if row.Parent then apply() end end)

	function Row:Add(tagConfig)
		local tag = XLQPCreateTag(row, tagConfig, RowConfig.TagDefaults)
		if not tag then return nil end
		tag.Row = self
		tag.Frame.LayoutOrder = #self.Tags + 1
		tag.Removed = function(removed)
			for index, existing in ipairs(self.Tags) do
				if existing == removed then table.remove(self.Tags, index) break end
			end
			queue()
		end
		table.insert(self.Tags, tag)
		queue()
		return tag
	end

	function Row:Clear()
		for index = #self.Tags, 1, -1 do
			local tag = self.Tags[index]
			if tag and tag.Frame and tag.Frame.Parent then tag.Frame:Destroy() end
			self.Tags[index] = nil
		end
		queue()
		return self
	end

	function Row:Get(index) return self.Tags[index] end
	function Row:Count() return #self.Tags end
	function Row:SetVisible(value) row.Visible = value ~= false return self end
	function Row:Destroy()
		self:Clear()
		if row and row.Parent then row:Destroy() end
		return nil
	end

	return Row
end

function XLQPInstallTags(Host, Config, Object, Defaults)
	if typeof(Host) ~= "Instance" then return Object end
	Config = type(Config) == "table" and Config or {}
	Object = type(Object) == "table" and Object or {}
	Defaults = type(Defaults) == "table" and Defaults or {}
	if Object._XLQPTagsInstalled then return Object end
	Object._XLQPTagsInstalled = true

	local rows = {}
	local function rowFor(mode)
		mode = tostring(mode or Defaults.Position or "Right"):lower()
		if mode ~= "bottom" then mode = "right" end
		if rows[mode] then return rows[mode] end
		local rowConfig = {}
		for key, value in pairs(Defaults) do rowConfig[key] = value end
		rowConfig.Position = mode
		if Config.TagOffset ~= nil then rowConfig.Offset = Config.TagOffset end
		if Config.TagGap ~= nil then rowConfig.Gap = Config.TagGap end
		if Config.TagAnchorY ~= nil then rowConfig.AnchorY = Config.TagAnchorY end
		if Config.TagZIndex ~= nil then rowConfig.ZIndex = Config.TagZIndex end
		if Config.TagHeight ~= nil then
			rowConfig.TagDefaults = type(rowConfig.TagDefaults) == "table" and rowConfig.TagDefaults or {}
			rowConfig.TagDefaults.Height = Config.TagHeight
		end
		rows[mode] = XLQPCreateTagRow(Host, rowConfig)
		return rows[mode]
	end

	function Object:AddTag(tagConfig)
		tagConfig = type(tagConfig) == "table" and tagConfig or {Text = tostring(tagConfig or "TAG")}
		local row = rowFor(tagConfig.Position or tagConfig.Placement or tagConfig.Align)
		return row and row:Add(tagConfig) or nil
	end
	Object.Tag = Object.AddTag
	Object.CreateTag = Object.AddTag

	function Object:GetTags()
		local out = {}
		for _, mode in ipairs({"right", "bottom"}) do
			local row = rows[mode]
			if row then
				for _, tag in ipairs(row.Tags) do table.insert(out, tag) end
			end
		end
		return out
	end

	function Object:GetTag(target)
		if type(target) == "number" then return self:GetTags()[target] end
		if target == nil then return self:GetTags()[1] end
		local key = tostring(target):lower()
		for _, tag in ipairs(self:GetTags()) do
			if tostring(tag.Text):lower() == key then return tag end
		end
		return nil
	end

	function Object:RemoveTag(target)
		local tag = type(target) == "table" and target or self:GetTag(target)
		if tag and type(tag.Destroy) == "function" then tag:Destroy() end
		return self
	end

	function Object:ClearTags()
		for _, row in pairs(rows) do row:Clear() end
		return self
	end

	function Object:SetTag(tagConfig)
		self:ClearTags()
		if tagConfig == nil or tagConfig == false then return nil end
		return self:AddTag(tagConfig)
	end

	function Object:SetTags(list)
		self:ClearTags()
		local created = {}
		if type(list) == "table" then
			for _, entry in ipairs(list) do table.insert(created, self:AddTag(entry)) end
		end
		return created
	end

	function Object:SetTagsVisible(value)
		for _, row in pairs(rows) do row:SetVisible(value) end
		return self
	end

	function Object:RefreshTags()
		for _, row in pairs(rows) do row:Refresh() end
		return self
	end

	local single = Config.Tag
	if single == nil then single = Config.tag end
	if single ~= nil and single ~= false then Object:AddTag(single) end

	local list = Config.ElementTags
	if list == nil and Config.__XLQPSkipElementTags ~= true then list = Config.Tags end
	if type(list) == "table" then
		if list.Text or list.Title or list.Variant or list.Color then
			Object:AddTag(list)
		else
			for _, entry in ipairs(list) do Object:AddTag(entry) end
		end
	elseif type(list) == "string" then
		Object:AddTag(list)
	end

	return Object
end

