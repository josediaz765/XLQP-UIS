			content.Size=UDim2.new(1,-(content.Position.X.Offset+12),0,contentHeight)
			local nextBase
			for _,child in ipairs(frame:GetChildren()) do
				if child:IsA("GuiObject") and child~=content and child~=title then
					local base=tonumber(child:GetAttribute("VHParagraphBaseY"))
					if not base then base=child.Position.Y.Offset child:SetAttribute("VHParagraphBaseY",base) end
					if base>baseContentY and (not nextBase or base<nextBase) then nextBase=base end
				end
			end
			local reserved=nextBase and math.max(16,nextBase-baseContentY-4) or contentHeight
			local shift=math.max(0,contentHeight-reserved)+(contentY-baseContentY)
			local maximum=contentY+contentHeight
			for _,child in ipairs(frame:GetChildren()) do
				if child:IsA("GuiObject") and child.Visible and child~=content and child~=title then
					local base=tonumber(child:GetAttribute("VHParagraphBaseY")) or child.Position.Y.Offset
					local y=base
					if base>baseContentY then y=base+shift child.Position=UDim2.new(child.Position.X.Scale,child.Position.X.Offset,0,y) end
					local height=child.AbsoluteSize.Y>0 and child.AbsoluteSize.Y or child.Size.Y.Offset
					maximum=math.max(maximum,y+math.max(0,height))
				end
			end
			local target=math.max(46,math.ceil(maximum+12))
			frame.Size=UDim2.new(frame.Size.X.Scale,frame.Size.X.Offset,0,target)
			local color=frame:FindFirstChild("ColorFrame")
			if color and color:IsA("GuiObject") then color.Size=UDim2.new(0,4,0,math.max(0,target-20)) end
		end
		local function queue()
			if startupAborted() or library._StartupBlocked then return end
			if resizeWorkPaused() then queueResizeFollowup(frame,queue) return end
			if queued or not isGuiBranchVisible(frame) then return end
			queued=true
			task.defer(function() queued=false if not startupAborted() and not library._StartupBlocked and not resizeWorkPaused() and isGuiBranchVisible(frame) then fit() end end)
		end
		local content=frame:FindFirstChild("Content")
		local title=frame:FindFirstChild("Title")
		if content and content:IsA("TextLabel") then AddConnection(content:GetPropertyChangedSignal("Text"),queue) AddConnection(content:GetPropertyChangedSignal("AbsoluteSize"),queue) end
		if title and title:IsA("TextLabel") then AddConnection(title:GetPropertyChangedSignal("Text"),queue) end
