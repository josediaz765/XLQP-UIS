local function ultraAIAnimationAsset(value)
	local id=tostring(value or ""):match("%d+")
	if not id or tonumber(id)==0 then return nil end
	return "rbxassetid://"..id
end

function ultraAIAnimationFromCharacter(character, aliases)
	local animate=character and character:FindFirstChild("Animate")
	if not animate then return nil end
	for _,animation in ipairs(animate:GetDescendants()) do
		if animation:IsA("Animation") then
			local node=animation
			while node and node~=animate do
				local nodeName=node.Name:lower()
				if table.find(aliases,nodeName) then
					local asset=ultraAIAnimationAsset(animation.AnimationId)
					if asset then return asset end
				end
				node=node.Parent
			end
		end
	end
	return nil
end

function ultraAIInstallR15Animations(service,sourceCharacter,clone,humanoid,root)
	if service.Config.UsePlayerAnimations==false or humanoid.RigType~=Enum.HumanoidRigType.R15 then return end
	local sourceHumanoid=sourceCharacter and sourceCharacter:FindFirstChildOfClass("Humanoid")
	local description
	if sourceHumanoid then pcall(function() description=sourceHumanoid:GetAppliedDescription() end) end
	local animator=humanoid:FindFirstChildOfClass("Animator")
	if not animator then animator=Instance.new("Animator") animator.Parent=humanoid end
	pcall(function() for _,track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end end)
	local animationFolder=Instance.new("Folder")
	animationFolder.Name="UltraAIAnimations"
	animationFolder.Parent=clone
	local definitions={
		Idle={{"idle"},"IdleAnimation",507766666,true,Enum.AnimationPriority.Idle},
		Walk={{"walk","walkanim"},"WalkAnimation",507777826,true,Enum.AnimationPriority.Movement},
		Run={{"run","runanim"},"RunAnimation",507767714,true,Enum.AnimationPriority.Movement},
		Jump={{"jump","jumpanim"},"JumpAnimation",507765000,false,Enum.AnimationPriority.Action},
		Fall={{"fall","fallanim"},"FallAnimation",507767968,true,Enum.AnimationPriority.Action},
		Climb={{"climb","climbanim"},"ClimbAnimation",507765644,true,Enum.AnimationPriority.Movement},
		Swim={{"swim","swimanim"},"SwimAnimation",507784897,true,Enum.AnimationPriority.Movement}
	}
	local tracks={}
	for state,definition in pairs(definitions) do
		local asset=ultraAIAnimationFromCharacter(sourceCharacter,definition[1])
		if not asset and description then pcall(function() asset=ultraAIAnimationAsset(description[definition[2]]) end) end
		asset=asset or ultraAIAnimationAsset(definition[3])
		if asset then
			local animation=Instance.new("Animation")
			animation.Name="UltraAI"..state
			animation.AnimationId=asset
			animation.Parent=animationFolder
			local ok,track=pcall(function() return animator:LoadAnimation(animation) end)
			if ok and track then
				track.Looped=definition[4]
				track.Priority=definition[5]
				tracks[state]=track
			end
		end
	end
	UltraAICompanion.Tracks=tracks
	local function play(state,speed)
		local track=tracks[state] or tracks.Idle
		if not track then return end
		if UltraAICompanion.CurrentTrack~=track then
			for _,other in pairs(tracks) do if other~=track and other.IsPlaying then other:Stop(.14) end end
			track:Play(.14,1,speed or 1)
			UltraAICompanion.CurrentTrack=track
		elseif not track.IsPlaying then
			track:Play(.12,1,speed or 1)
		elseif speed then
			track:AdjustSpeed(speed)
		end
	end
	local function groundedMovement(speed)
		local state=humanoid:GetState()
		if state==Enum.HumanoidStateType.Jumping or state==Enum.HumanoidStateType.Freefall or state==Enum.HumanoidStateType.Climbing or state==Enum.HumanoidStateType.Swimming then return end
		if speed>.35 then
			local running=speed>=math.max(9,(tonumber(humanoid.WalkSpeed) or 15)*.68)
			play(running and "Run" or "Walk",math.clamp(speed/(running and 16 or 8),.55,1.65))
		else
			play("Idle",1)
		end
	end
	table.insert(UltraAICompanion.Connections,humanoid.Running:Connect(groundedMovement))
	table.insert(UltraAICompanion.Connections,humanoid.Climbing:Connect(function(speed) play("Climb",math.clamp(math.abs(speed)/5,.5,1.7)) end))
	table.insert(UltraAICompanion.Connections,humanoid.Swimming:Connect(function(speed) play("Swim",math.clamp(math.abs(speed)/10,.5,1.7)) end))
	table.insert(UltraAICompanion.Connections,humanoid.StateChanged:Connect(function(_,state)
		if state==Enum.HumanoidStateType.Jumping then play("Jump",1)
		elseif state==Enum.HumanoidStateType.Freefall then play("Fall",1)
		elseif state==Enum.HumanoidStateType.Climbing then play("Climb",1)
		elseif state==Enum.HumanoidStateType.Swimming then play("Swim",1)
		elseif state==Enum.HumanoidStateType.Running or state==Enum.HumanoidStateType.RunningNoPhysics or state==Enum.HumanoidStateType.Landed or state==Enum.HumanoidStateType.GettingUp then
			local velocity=root.AssemblyLinearVelocity
			groundedMovement(Vector3.new(velocity.X,0,velocity.Z).Magnitude)
		end
	end))
	table.insert(UltraAICompanion.Connections,humanoid.Died:Connect(function()
		for _,track in pairs(tracks) do pcall(function() track:Stop(.1) end) end
	end))
	task.defer(function() if clone.Parent then play("Idle",1) end end)
end

function SharedAIService:EnsureCompanion()
	if not self.Config.UltraAI or not self.Config.CompanionEnabled then self:DestroyCompanion() return nil end
	local player=Players.LocalPlayer
	local character=player and player.Character
	if not character then return nil end
	if UltraAICompanion.Model and UltraAICompanion.Model.Parent then return UltraAICompanion.Model end
	self:DestroyCompanion()
	local oldArchivable=character.Archivable
	character.Archivable=true
	local clone=character:Clone()
	character.Archivable=oldArchivable
	clone.Name=tostring(self.Config.CompanionName or "UltraAI Companion")
	for _,object in ipairs(clone:GetDescendants()) do
		if object:IsA("LocalScript") or object:IsA("Script") or object:IsA("Tool") then object:Destroy() end
		if object:IsA("BasePart") then object.CanCollide=false object.Massless=true end
	end
	local humanoid=clone:FindFirstChildOfClass("Humanoid")
	local root=clone:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then clone:Destroy() return nil end
	humanoid.DisplayName=tostring(self.Config.CompanionName or "UltraAI")
	humanoid.WalkSpeed=tonumber(self.Config.WalkSpeed) or 15
	clone.Parent=workspace
	clone:PivotTo(character:GetPivot()*CFrame.new(4,0,5))
	UltraAICompanion.Model=clone
	ultraAIInstallR15Animations(self,character,clone,humanoid,root)
	local PathfindingService=game:GetService("PathfindingService")
	table.insert(UltraAICompanion.Connections, player.CharacterAdded:Connect(function() task.wait(1) self:DestroyCompanion() self:EnsureCompanion() end))
	task.spawn(function()
		local waypoints={}
		local waypointIndex=1
		local lastGoal=nil
		local lastComputed=0
		local stuckSince=0
		local lastPosition=root.Position
		local computing=false
		local function clearPath()
			waypoints={}
			waypointIndex=1
			lastGoal=nil
		end
		local function computePath(goal)
			if computing then return end
			computing=true
			local ok,path=pcall(function()
				local created=PathfindingService:CreatePath({AgentRadius=2.4,AgentHeight=5.5,AgentCanJump=true,AgentCanClimb=true,WaypointSpacing=4})
				created:ComputeAsync(root.Position,goal)
				return created
			end)
			computing=false
			lastComputed=os.clock()
			if ok and path and path.Status==Enum.PathStatus.Success then
				local list=path:GetWaypoints()
				if #list>1 then
					waypoints=list
					waypointIndex=2
					lastGoal=goal
					return true
				end
			end
			clearPath()
			return false
		end
		while clone.Parent and self.Config.UltraAI and self.Config.CompanionEnabled do
			task.wait(0.08)
			if humanoid.Health<=0 then break end
			local target=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not target or not self.Config.FollowEnabled then
				clearPath()
				humanoid:Move(Vector3.zero,false)
			else
				humanoid.WalkSpeed=tonumber(self.Config.WalkSpeed) or 15
				local desired=math.max(3,tonumber(self.Config.FollowDistance) or 7)
				local flatOffset=Vector3.new(root.Position.X-target.Position.X,0,root.Position.Z-target.Position.Z)
				local distance=flatOffset.Magnitude
				if distance<=desired then
					clearPath()
					humanoid:Move(Vector3.zero,false)
					local look=Vector3.new(target.Position.X,root.Position.Y,target.Position.Z)
					if (look-root.Position).Magnitude>0.5 then
						root.CFrame=root.CFrame:Lerp(CFrame.new(root.Position,look),0.18)
					end
				else
					local approach=flatOffset.Magnitude>0.1 and flatOffset.Unit or target.CFrame.LookVector
					local goal=target.Position+approach*(desired*0.85)
					local direct=(goal-root.Position)
					local blocked=false
					if direct.Magnitude>0.1 then
						local params=RaycastParams.new()
						params.FilterType=Enum.RaycastFilterType.Exclude
						params.FilterDescendantsInstances={clone,player.Character}
						local hit=workspace:Raycast(root.Position,Vector3.new(direct.X,0,direct.Z),params)
						blocked=hit~=nil and hit.Instance~=nil and hit.Instance.CanCollide==true
					end
					if not blocked and distance<70 then
						clearPath()
						humanoid:MoveTo(goal)
					else
						local stale=lastGoal==nil or (lastGoal-goal).Magnitude>6 or waypointIndex>#waypoints
						if stale and os.clock()-lastComputed>0.35 then computePath(goal) end
						local waypoint=waypoints[waypointIndex]
						if waypoint then
							local step=waypoint.Position
							local flatStep=Vector3.new(step.X-root.Position.X,0,step.Z-root.Position.Z)
							if flatStep.Magnitude<3.2 then
								waypointIndex+=1
								waypoint=waypoints[waypointIndex]
								step=waypoint and waypoint.Position or step
							end
							if waypoint and waypoint.Action==Enum.PathWaypointAction.Jump and humanoid.FloorMaterial~=Enum.Material.Air then
								humanoid.Jump=true
							end
							humanoid:MoveTo(step)
						else
							humanoid:MoveTo(goal)
						end
					end
					if (root.Position-lastPosition).Magnitude<0.35 then
						if stuckSince==0 then
							stuckSince=os.clock()
						elseif os.clock()-stuckSince>0.7 then
							stuckSince=0
							clearPath()
							if humanoid.FloorMaterial~=Enum.Material.Air then humanoid.Jump=true end
						end
					else
						stuckSince=0
					end
					lastPosition=root.Position
				end
			end
		end
		humanoid:Move(Vector3.zero,false)
	end)
	return clone
end

function SharedAIService:Speak(message)
	if not self.Config.UltraAI or not self.Config.BubbleResponses then return end
	local clone=self:EnsureCompanion()
	local head=clone and clone:FindFirstChild("Head")
	if not head then return end
	local clean=sharedAIClean(message):gsub("```.-```",""):sub(1,220)
	if clean=="" then return end
	local TextChatService=game:GetService("TextChatService")
	local ok=pcall(function() TextChatService:DisplayBubble(head,clean) end)
	if ok then return end
	local old=head:FindFirstChild("UltraAIBubble") if old then old:Destroy() end
	local bubble=Instance.new("BillboardGui",head)
