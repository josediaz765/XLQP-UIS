function XLQPGen1:IsPointerCoveredByForeground(target, point)
	if not (target and target.Parent and point) then return false end
	local targetRoot=target:FindFirstAncestorOfClass("ScreenGui")
	if not targetRoot then return false end
	local function containsVisibleSurface(object)
		if not (object and object:IsA("GuiObject") and object.Visible) then return false end
		local position,size=object.AbsolutePosition,object.AbsoluteSize
		local inside=size.X>0 and size.Y>0 and point.X>=position.X and point.X<position.X+size.X and point.Y>=position.Y and point.Y<position.Y+size.Y
		if inside and not xlqpLayerIsPassthroughHolder(object) and (object.Active or object.BackgroundTransparency<1) then return true end
		for _,child in ipairs(object:GetChildren()) do
			if child:IsA("GuiObject") and containsVisibleSurface(child) then return true end
		end
		return false
	end
	local settings=self._SettingsWindow
	if target:IsDescendantOf(self._MainWindow or target) and settings and settings.Parent and settings.Visible and not target:IsDescendantOf(settings) and containsVisibleSurface(settings) then return true end
	for _,popup in ipairs(self._PopupGuis or {}) do
		if popup and popup.Parent and popup~=targetRoot and popup~=mouseCaptureGui and popup~=self._CustomCursorGui then
			if popup:IsA("ScreenGui") and popup.Enabled and popup.DisplayOrder>targetRoot.DisplayOrder then
				for _,child in ipairs(popup:GetChildren()) do
					if child:IsA("GuiObject") and containsVisibleSurface(child) then return true end
				end
			elseif popup:IsA("GuiObject") and popup.Visible and not target:IsDescendantOf(popup) and popup:FindFirstAncestorOfClass("ScreenGui")==targetRoot and popup.ZIndex>target.ZIndex and containsVisibleSurface(popup) then
				return true
			end
		end
	end
	return false
end

function SetTheme()
	XLQPGen1._ThemeRevision=(tonumber(XLQPGen1._ThemeRevision) or 0)+1
	if os.clock()-(XLQPGen1._LastThemeCompaction or 0)>=5 then compactThemeObjects() XLQPGen1._LastThemeCompaction=os.clock() end
	local selectedTheme = XLQPGen1.Themes[XLQPGen1.SelectedTheme] or XLQPGen1.Themes.Default
	for Name, Type in pairs(XLQPGen1.ThemeObjects) do
		local baseColor=selectedTheme and selectedTheme[Name]
		local roleColor=baseColor and (GetEffectiveThemeColor and GetEffectiveThemeColor(Name,baseColor) or baseColor)
		for _, Object in pairs(Type) do
			local prop = ReturnProperty(Object)
			if prop and roleColor then
				local resolvedColor = roleColor
				local textOverride = Object:GetAttribute("XLQPTextColorOverride")
				if prop == "TextColor3" and textOverride ~= nil then
					resolvedColor = XLQPResolveTextColor(textOverride) or resolvedColor
				end
				pcall(function() if Object[prop]~=resolvedColor then Object[prop]=resolvedColor end end)
			end
		end
	end
	if XLQPGen1._RefreshLiveColors then pcall(function() XLQPGen1:_RefreshLiveColors() end) end
	if XLQPGen1._RefreshWindowLiveColor then pcall(function() XLQPGen1:_RefreshWindowLiveColor() end) end
end

