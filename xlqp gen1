function XLQPGen1:GetDiscordAuthHWID()
if self.DiscordAuthHWID and self.DiscordAuthHWID~="" then return self.DiscordAuthHWID end
local raw=""
local hwidGetters={}
if type(gethwid)=="function" then hwidGetters[#hwidGetters+1]=gethwid end
if type(get_hwid)=="function" then hwidGetters[#hwidGetters+1]=get_hwid end
if syn and type(syn.gethwid)=="function" then hwidGetters[#hwidGetters+1]=syn.gethwid end
for _,getter in ipairs(hwidGetters) do
if type(getter)=="function" then
local ok,value=pcall(getter)
if ok and value and tostring(value)~="" then raw=tostring(value) break end
end
end
if raw=="" then pcall(function() raw=tostring(game:GetService("RbxAnalyticsService"):GetClientId() or "") end) end
if raw=="" then
local player=Players.LocalPlayer
raw=tostring(player and player.UserId or 0).."-"..tostring(game.PlaceId)
end
local hashed=""
if syn and syn.crypto and type(syn.crypto.hash)=="function" then
pcall(function() hashed=tostring(syn.crypto.hash("sha256",raw) or "") end)
if hashed=="" then pcall(function() hashed=tostring(syn.crypto.hash(raw) or "") end) end
elseif crypt and type(crypt.hash)=="function" then
pcall(function() hashed=tostring(crypt.hash(raw,"sha256") or "") end)
elseif crypto and type(crypto.hash)=="function" then
pcall(function() hashed=tostring(crypto.hash("sha256",raw) or "") end)
end
self.DiscordAuthHWID=hashed~="" and hashed or raw
return self.DiscordAuthHWID
end
function XLQPGen1:_DiscordAuthBaseUrl()
local link=XLQPDiscordAuthUrl
return link:gsub("[?#].*$",""):gsub("/api/login/?$",""):gsub("/+$","")
end
function XLQPGen1:_DiscordAuthSend(options)
options=type(options)=="table" and options or {}
local req=self:_DiscordAuthRequest()
if req then
local ok,response=pcall(function() return req(options) end)
if ok and response then
local body=tostring(response.Body or response.body or response.ResponseBody or "")
local code=tonumber(response.StatusCode or response.Status or response.status) or (body~="" and 200 or 0)
local data=self:_DiscordAuthDecode(body)
if code>=200 and code<300 then return data,nil,response end
return data,tostring(data and (data.error or data.message) or ("HTTP "..tostring(code))),response
end
end
local ok,response=pcall(function()
return HttpService:RequestAsync({Url=tostring(options.Url or ""),Method=tostring(options.Method or "GET"),Headers=options.Headers or {},Body=options.Body})
end)
if not ok or type(response)~="table" then return nil,tostring(response) end
local data=self:_DiscordAuthDecode(response.Body or "")
if response.Success then return data,nil,response end
return data,tostring(data and (data.error or data.message) or ("HTTP "..tostring(response.StatusCode))),response
end
function XLQPGen1:StartDiscordHWIDAuth(callbacks)
callbacks=type(callbacks)=="table" and callbacks or {}
if self._DiscordHWIDAuthBusy then
if type(callbacks.OnStatus)=="function" then pcall(callbacks.OnStatus,"Authentication already running","busy",self._DiscordHWIDAuthSession) end
return false
end
self._DiscordHWIDAuthBusy=true
self._DiscordHWIDAuthGeneration=(self._DiscordHWIDAuthGeneration or 0)+1
local generation=self._DiscordHWIDAuthGeneration
task.spawn(function()
local function emit(text,state,data)
if type(callbacks.OnStatus)=="function" then pcall(callbacks.OnStatus,text,state,data) end
end
local function finish()
if self._DiscordHWIDAuthGeneration==generation then self._DiscordHWIDAuthBusy=false end
end
local base=self:_DiscordAuthBaseUrl()
local hwid=self:GetDiscordAuthHWID()
if tostring(hwid or "")=="" then emit("A device identifier could not be created","error") finish() return end
local player=Players.LocalPlayer
if not player then emit("Local player is unavailable","error") finish() return end
emit("Checking authentication service","health")
local health,healthError=self:_DiscordAuthSend({Url=base.."/api/health",Method="GET",Headers={["Accept"]="application/json",["Cache-Control"]="no-cache"}})
if not health or health.success~=true then emit("Authentication service is offline: "..tostring(healthError or health and health.error or "Unknown error"),"error") finish() return end
emit("Creating a device-bound login","creating")
local sessionData,sessionError=self:_DiscordAuthSend({Url=base.."/api/session/create",Method="POST",Headers={["Content-Type"]="application/json",["Accept"]="application/json"},Body=HttpService:JSONEncode({robloxUserId=player.UserId,robloxUsername=player.Name,robloxDisplayName=player.DisplayName,placeId=game.PlaceId,jobId=game.JobId,hwid=hwid})})
if not sessionData or sessionData.success~=true then emit("Session creation failed: "..tostring(sessionError or sessionData and sessionData.error or "Unknown error"),"error") finish() return end
local sessionId=tostring(sessionData.sessionId or "")
local pollToken=tostring(sessionData.pollToken or "")
local loginUrl=tostring(sessionData.loginUrl or "")
local statusUrl=tostring(sessionData.statusUrl or "")
local expiresAt=tonumber(sessionData.expiresAt) or 0
if sessionId=="" or pollToken=="" or loginUrl=="" or statusUrl=="" then emit("The authentication server returned an incomplete session","error") finish() return end
self._DiscordHWIDAuthSession={sessionId=sessionId,pollToken=pollToken,loginUrl=loginUrl,statusUrl=statusUrl,expiresAt=expiresAt,hwid=hwid}
if type(callbacks.OnLogin)=="function" then pcall(callbacks.OnLogin,loginUrl,self._DiscordHWIDAuthSession) end
local copied=false
if setclipboard then copied=pcall(setclipboard,loginUrl) elseif toclipboard then copied=pcall(toclipboard,loginUrl) end
if callbacks.OpenLogin~=false then pcall(openUrl,loginUrl) end
emit(copied and "Login opened and copied. Finish Discord authentication." or "Open the Discord login link to continue.","pending",self._DiscordHWIDAuthSession)
local started=os.clock()
local previous=""
while self._DiscordHWIDAuthGeneration==generation and os.clock()-started<WindowConfig.discordauthtimeout do
task.wait(WindowConfig.discordauthpollinterval)
local statusData,statusError=self:_DiscordAuthSend({Url=statusUrl,Method="GET",Headers={["Accept"]="application/json",["Cache-Control"]="no-cache",["x-xlqp-poll-token"]=pollToken}})
if not statusData then
emit("Status check failed: "..tostring(statusError or "Unknown error"),"retry")
continue
end
local state=tostring(statusData.state or "pending")
if state~=previous then emit(state=="pending" and "Waiting for Discord login" or ("Authentication "..state),state,statusData) previous=state end
if state=="verified" and statusData.verified==true and statusData.authenticated==true then
local consumed,consumeError=self:_DiscordAuthSend({Url=base.."/api/session/consume",Method="POST",Headers={["Content-Type"]="application/json",["Accept"]="application/json",["x-xlqp-poll-token"]=pollToken},Body=HttpService:JSONEncode({sessionId=sessionId,hwid=hwid})})
if not consumed or consumed.success~=true then emit("Verified, but session consumption failed: "..tostring(consumeError or consumed and consumed.error or "Unknown error"),"error") finish() return end
local discord=consumed.discord or statusData.discord or {}
local profile={id=tostring(discord.id or ""),username=tostring(discord.username or "Unknown"),displayName=tostring(discord.displayName or discord.username or "Discord User"),avatar=tostring(discord.avatar or ""),verifiedAt=consumed.verifiedAt or statusData.verifiedAt}
if profile.id=="" then emit("Discord ID was missing from the verified response","error") finish() return end
profile.avatarAsset=self:DownloadDiscordAuthAvatar(profile)
self:SaveDiscordAuthProfile(profile)
local env=getgenv and getgenv() or _G
env.XLQPDiscordAuth={Authenticated=true,Id=profile.id,Username=profile.username,DisplayName=profile.displayName,Avatar=profile.avatar,HWID=hwid,VerifiedAt=profile.verifiedAt}
emit("Connected as @"..profile.username,"verified",profile)
if type(callbacks.OnVerified)=="function" then pcall(callbacks.OnVerified,profile,consumed) end
finish()
return
end
if state=="denied" or state=="expired" or state=="revoked" then emit("Authentication "..state,state,statusData) finish() return end
if expiresAt>0 and os.time()>=expiresAt then emit("Authentication session expired","expired",statusData) finish() return end
end
if self._DiscordHWIDAuthGeneration==generation then emit("Authentication timed out","expired") end
finish()
end)
return true
end
