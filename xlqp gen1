	function Chat:RememberDM(id,name,thumb,last)
		id=tonumber(id) or 0
		if id<=0 or id==player.UserId then return end
		for _,conv in ipairs(self.Conversations or {}) do
			if tonumber(conv.id)==id then
				conv.name=tostring(name or conv.name or ("User "..id))
				conv.thumb=tostring(thumb or conv.thumb or "")
				conv.last=tostring(last or conv.last or "")
				conv.time=os.time()
				self:SaveDMList()
				return
			end
		end
		table.insert(self.Conversations,1,{id=id,name=tostring(name or ("User "..id)),thumb=tostring(thumb or ""),last=tostring(last or ""),time=os.time()})
