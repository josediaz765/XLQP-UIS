	ctx.Force=force==true
	if ctx.Force then
		self._GuideRunning=false
		if self._MainWindowMinimized==true then return end
		if ctx.MainWindow and ctx.MainWindow.Parent then
			pcall(function() ctx.MainWindow.Visible=true end)
		end
	end
	self:_StartWindowGuide(ctx)
end


