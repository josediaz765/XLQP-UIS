        library._ActiveWindowConfig._LocalRegisterState=runtimeState
    end
    if type(library._WindowConfig)=="table" and type(library._WindowConfig._LocalRegisterState)~="table" then
        library._WindowConfig._LocalRegisterState=runtimeState
