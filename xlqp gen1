   local function createPulse(dot)
       if XLQPGen1._ReduceLagEnabled then
           return
       end
       local pulse = Instance.new("Frame", dot)
       pulse.Size = UDim2.fromScale(1, 1)
       pulse.AnchorPoint = Vector2.new(0.5, 0.5)
       pulse.Position = UDim2.fromScale(0.5, 0.5)
       pulse.BackgroundColor3 = dot.BackgroundColor3
       pulse.BackgroundTransparency = 0.5
       local c = Instance.new("UICorner", pulse)
       c.CornerRadius = UDim.new(1, 0)
       task.spawn(function()
           while pulse and pulse.Parent do
               local visibilityCheck = WindowConfig._LocalRegisterState.isGuiBranchVisible
               if XLQPGen1._ReduceLagEnabled or (type(visibilityCheck) == "function" and not visibilityCheck(pulse)) then
                   pulse.Size = UDim2.fromScale(1, 1)
                   pulse.BackgroundTransparency = 1
                   task.wait(0.5)
                   continue
               end
               local tween1 = TweenService:Create(pulse, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Size = UDim2.fromScale(2.5, 2.5), BackgroundTransparency = 1 })
               tween1:Play()
               tween1.Completed:Wait()
               pulse.Size=UDim2.fromScale(0,0)
               pulse.BackgroundTransparency=0.5
               task.wait(XLQPGen1._PerformanceMode and 0.8 or 0.5)
           end
       end)
   end

