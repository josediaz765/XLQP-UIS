		local function attachLiveColorElementBackgroundController(Frame,Config,ReturnedObject)
			Config=Config or {}
			ReturnedObject=ReturnedObject or {}
			local function raiseElementBackgroundForeground(object,layer,host)
				if not object or not layer or not layer.Parent or not object:IsA("GuiObject") then return end
				local isLayerObject=object==layer or (host and object:IsDescendantOf(host))
				if not isLayerObject and object.ZIndex<=layer.ZIndex then object.ZIndex=layer.ZIndex+1 end
			end
			function ReturnedObject:_SetLiveColorElementBackground(enabled,asset,transparency)
				if not Frame or not Frame.Parent then return self end
				local directLayer=Config.DirectLayer==true
				local host=not directLayer and Frame:FindFirstChild("XLQPLiveColorElementBackgroundHost") or nil
				local layer=directLayer and Frame:FindFirstChild("XLQPLiveColorElementBackground") or (host and host:FindFirstChild("XLQPLiveColorElementBackground"))
				local allowed=enabled==true and Config.LiveColorElementBackground~=false and tostring(asset or "")~=""
				if not allowed then
					if directLayer then
						if layer then layer:Destroy() end
					elseif host then
						host:Destroy()
					end
					self.LiveColorElementBackground=nil
					return self
				end
				if not layer then
					if not directLayer and not host then
						host=Instance.new("Folder")
						host.Name="XLQPLiveColorElementBackgroundHost"
						host.Parent=Frame
					end
					layer=Create("ImageLabel",{
						Name="XLQPLiveColorElementBackground",
						Size=UDim2.fromScale(1,1),
						Position=UDim2.fromScale(0,0),
						BackgroundTransparency=1,
						BorderSizePixel=0,
						ScaleType=Enum.ScaleType.Crop,
						Active=false,
						ZIndex=Frame.ZIndex+1,
						Parent=directLayer and Frame or host
					})
				end
				local padding=directLayer and Frame:FindFirstChildOfClass("UIPadding") or nil
				local paddingLeft=padding and padding.PaddingLeft.Offset or 0
				local paddingRight=padding and padding.PaddingRight.Offset or 0
				local paddingTop=padding and padding.PaddingTop.Offset or 0
				local paddingBottom=padding and padding.PaddingBottom.Offset or 0
				layer.Size=UDim2.new(1,paddingLeft+paddingRight,1,paddingTop+paddingBottom)
				layer.Position=UDim2.new(0,-paddingLeft,0,-paddingTop)
				layer.AnchorPoint=Vector2.new(0,0)
				layer.ZIndex=Frame.ZIndex+1
				local frameCorner=Frame:FindFirstChildOfClass("UICorner")
				local layerCorner=layer:FindFirstChildOfClass("UICorner") or Create("UICorner",{Parent=layer})
				layerCorner.CornerRadius=frameCorner and frameCorner.CornerRadius or UDim.new(0,WindowConfig.ElementCornerRadius or 8)
				layer.Image=tostring(asset)
				layer.ImageColor3=Color3.new(1,1,1)
				layer.ImageTransparency=math.clamp(tonumber(transparency) or .48,0,1)
				layer.Visible=true
				self.LiveColorElementBackground=layer
				for _,object in ipairs(Frame:GetDescendants()) do raiseElementBackgroundForeground(object,layer,host) end
				if not self._LiveColorElementBackgroundZHooked then
					self._LiveColorElementBackgroundZHooked=true
					AddConnection(Frame.DescendantAdded,function(object)
						task.defer(function()
							if not Frame.Parent then return end
							local currentHost=not directLayer and Frame:FindFirstChild("XLQPLiveColorElementBackgroundHost") or nil
							local currentLayer=directLayer and Frame:FindFirstChild("XLQPLiveColorElementBackground") or (currentHost and currentHost:FindFirstChild("XLQPLiveColorElementBackground"))
							raiseElementBackgroundForeground(object,currentLayer,currentHost)
						end)
					end)
				end
				return self
			end
			if WindowConfig.LiveColorElementBackground==true then
				local cachedAsset=XLQPGen1._LiveColorElementBackgroundAsset
				if cachedAsset and cachedAsset~="" then
					ReturnedObject:_SetLiveColorElementBackground(true,cachedAsset,XLQPGen1._LiveColorElementBackgroundTransparency)
				elseif XLQPGen1._RefreshElementBackgroundImages then
					task.defer(function()
						if Frame.Parent then XLQPGen1:_RefreshElementBackgroundImages(WindowConfig.LiveColorTheme or "Cold Heat") end
					end)
				end
			end
			if not ReturnedObject._LiveColorElementBackgroundRegistered then
				ReturnedObject._LiveColorElementBackgroundRegistered=true
				table.insert(XLQPGen1._LiveColorElementBackgroundTargets,ReturnedObject)
			end
			return ReturnedObject
		end

