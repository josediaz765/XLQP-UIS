    window.TabListFavorites = favorites

    local function getTabListObjects()
        local mainWindow = context.MainWindow or library._ActiveMainWindow or library._MainWindow
        local sideFrame = context.WindowStuff
        local holder = context.TabHolder
        return mainWindow, sideFrame, holder
