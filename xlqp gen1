local function resolveCustomBackgroundAsset(link)
local asset=tostring(link or ""):gsub("%s+","")
if asset=="" then return "","" end
local sourceAsset=asset
WindowConfig._LocalRegisterState.customAssetCache=WindowConfig._LocalRegisterState.customAssetCache or {}
if WindowConfig._LocalRegisterState.customAssetCache[sourceAsset] then return WindowConfig._LocalRegisterState.customAssetCache[sourceAsset],sourceAsset end
if not asset:match("^https?://") and not XLQPAssetId(asset) and isfile and XLQPGetCustomAsset and isfile(asset) then
	local ok,resolved=pcall(XLQPGetCustomAsset,asset)
	if ok and resolved then asset=resolved end
end
local assetId=XLQPAssetId(asset)
if assetId then
	asset="rbxassetid://"..assetId
	sourceAsset=asset
	XLQPRegisterSecureBuiltin(asset)
end
if asset:match("^https?://") and not assetId and XLQPPrepareSecureFolder() then
	local hash=5381
	for index=1,#asset do hash=(hash*33+asset:byte(index))%2147483647 end
	local explicitExtension=asset:lower():match("%.(png)") or asset:lower():match("%.(jpe?g)") or asset:lower():match("%.(webp)")
	local extension=explicitExtension or "png"
	local path=XLQPSecureCacheFolder.."/background_url_"..tostring(hash).."."..extension
	if isfile and isfile(path) then
		local ok,resolved=pcall(XLQPGetCustomAsset,path)
		if ok and resolved then asset=resolved end
	else
		local body=XLQPSecureHttpGet(asset)
		if XLQPIsImageBody(body) then
			if not explicitExtension then
				if body:sub(1,3)=="\255\216\255" then extension="jpg" elseif body:sub(1,4)=="RIFF" and body:sub(9,12)=="WEBP" then extension="webp" elseif body:sub(1,4)=="GIF8" then extension="gif" end
				path=XLQPSecureCacheFolder.."/background_url_"..tostring(hash).."."..extension
			end
		end
		if XLQPIsImageBody(body) and pcall(writefile,path,body) then
			local ok,resolved=pcall(XLQPGetCustomAsset,path)
			if ok and resolved then asset=resolved end
		end
	end
end
if asset~="" and (asset:match("^rbxasset") or asset:match("^rbxthumb://") or asset:match("^synasset://") or asset:match("^content://")) then WindowConfig._LocalRegisterState.customAssetCache[sourceAsset]=asset end
return asset,sourceAsset
end

