		function ElementFunction:AddSlider(SliderConfig,CompatConfig)
			if type(SliderConfig)~="table" then
				local key=tostring(SliderConfig or "")
				local source=type(CompatConfig)=="table" and CompatConfig or {}
				SliderConfig={}
				for k,v in pairs(source) do SliderConfig[k]=v end
				SliderConfig.Flag=SliderConfig.Flag or (key~="" and key or nil)
				SliderConfig.Name=SliderConfig.Name or SliderConfig.Text or SliderConfig.Title or key
			end
			SliderConfig = SliderConfig or {}
			local sliderTheme=XLQPGen1.Themes[XLQPGen1.SelectedTheme] or XLQPGen1.Themes.Default
			SliderConfig.Name = SliderConfig.Name or SliderConfig.Text or SliderConfig.Title or "Slider"
			SliderConfig.ValueName = SliderConfig.ValueName or SliderConfig.Suffix or ""
			if SliderConfig.Increment==nil and tonumber(SliderConfig.Rounding) then SliderConfig.Increment=10^(-math.max(0,tonumber(SliderConfig.Rounding))) end
			SliderConfig.Min = tonumber(SliderConfig.Min) or 0
			SliderConfig.Max = tonumber(SliderConfig.Max) or 100
			SliderConfig.Increment = tonumber(SliderConfig.Increment) or 1
			SliderConfig.Default = tonumber(SliderConfig.Default) or SliderConfig.Min
			SliderConfig.Callback = SliderConfig.Callback or function() end
			SliderConfig.ValueName = SliderConfig.ValueName or ""
			SliderConfig.Color = typeof(SliderConfig.Color) == "Color3" and SliderConfig.Color or sliderTheme.Bloom or sliderTheme.Stroke or Color3.fromRGB(106,92,255)
			SliderConfig.Color2 = typeof(SliderConfig.Color2) == "Color3" and SliderConfig.Color2 or (sliderTheme.Stroke or SliderConfig.Color):Lerp(Color3.fromRGB(72,220,180),0.28)
			SliderConfig.Flag = SliderConfig.Flag or nil
