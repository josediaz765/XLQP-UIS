local function XLQPSetupResolveConfig(self,setupConfig)
	if setupConfig==true then return {Enabled=true} end
	if type(setupConfig)=="table" then
		local clone=XLQPSetupClone(setupConfig)
		if clone.Enabled==nil then clone.Enabled=true end
		return clone
	end
	local cfg=type(self)=="table" and self._WindowConfig or nil
	local candidate=cfg and cfg.Setup or nil
	if candidate==true then return {Enabled=true} end
	if type(candidate)=="table" then
		local clone=XLQPSetupClone(candidate)
		if clone.Enabled==nil then clone.Enabled=true end
		return clone
	end
	if cfg and cfg.SetupEnabled==true then return {Enabled=true} end
	return nil
end
