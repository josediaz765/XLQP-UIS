			end
			function Tag:Show(input)
				hideToken+=1
				self.Visible=true
				chip.Visible=true
				if input then move(input) else chip.Position=UDim2.fromScale(0.5,0.5) chip.AnchorPoint=Vector2.new(0.5,0.5) end
				TweenService:Create(chip,TweenInfo.new(0.14,Enum.EasingStyle.Quad),{BackgroundTransparency=0,TextTransparency=0}):Play()
				SafeCallback(TagConfig.Callback,true,self)
				return self
			end
			function Tag:Hide()
				hideToken+=1
				local current=hideToken
				self.Visible=false
				TweenService:Create(chip,TweenInfo.new(0.14,Enum.EasingStyle.Quad),{BackgroundTransparency=1,TextTransparency=1}):Play()
				task.delay(0.15,function() if current==hideToken and not self.Visible and chip.Parent then chip.Visible=false end end)
				SafeCallback(TagConfig.Callback,false,self)
				return self
			end
			function Tag:Set(value) TagConfig.Text=tostring(value or "Tag") self.Name=TagConfig.Text chip.Text=TagConfig.Text frame:SetAttribute("SearchName",TagConfig.Text.." "..TagConfig.Hint) return self end
			function Tag:SetHint(value) TagConfig.Hint=tostring(value or "") hint.Text=TagConfig.Hint frame:SetAttribute("SearchName",TagConfig.Text.." "..TagConfig.Hint) return self end
			function Tag:SetIcon(value,size)
				if value==nil or value==false or value=="" then
					if self.IconLabel then self.IconLabel.Visible=false end
					chip:FindFirstChildOfClass("UIPadding").PaddingLeft=UDim.new(0,8)
					self.IconValue=nil
					return self
				end
				if not self.IconLabel then
					self.IconLabel=SetProps(MakeElement("Image",""),{Name="CursorChipIcon",AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(0,-4,0.5,0),Size=UDim2.fromOffset(14,14),ImageColor3=chip.TextColor3,ZIndex=26,Parent=chip})
					self.IconLabel:SetAttribute("NoLiquidGlassIcon",true)
				end
				local resolvedSize=math.clamp(math.floor(tonumber(size) or 14),8,32)
				self.IconLabel.Size=UDim2.fromOffset(resolvedSize,resolvedSize)
				local raw=value
				if type(raw)=="number" then raw="rbxassetid://"..tostring(raw) end
				raw=tostring(raw)
				if raw:match("^%d+$") then raw="rbxassetid://"..raw end
				XLQPAssignProperty(self.IconLabel,"Image",GetIcon(raw) or raw)
				self.IconLabel.Visible=true
				self.IconValue=raw
				chip:FindFirstChildOfClass("UIPadding").PaddingLeft=UDim.new(0,resolvedSize+12)
				return self
			end
			Tag.SetImage=Tag.SetIcon
			function Tag:SetColor(value)
				chip.BackgroundColor3=XLQPResolveTagColor(value,chip.BackgroundColor3)
				return self
			end
			function Tag:SetTextColor(value)
				chip.TextColor3=XLQPResolveTagColor(value,chip.TextColor3)
				if self.IconLabel then self.IconLabel.ImageColor3=chip.TextColor3 end
				return self
			end
			if TagConfig.Icon~=nil then Tag:SetIcon(TagConfig.Icon,TagConfig.IconSize) end
			AddConnection(frame.MouseEnter,function() Tag:Show() end)
			AddConnection(frame.MouseLeave,function() Tag:Hide() end)
			AddConnection(frame.InputChanged,function(input) if input.UserInputType==Enum.UserInputType.MouseMovement then chip.AnchorPoint=Vector2.new(0,0) if not Tag.Visible then Tag:Show(input) else move(input) end end end)
			AddConnection(frame.InputBegan,function(input) if input.UserInputType==Enum.UserInputType.Touch then chip.AnchorPoint=Vector2.new(0,0) Tag:Show(input) task.delay(1.4,function() if frame.Parent then Tag:Hide() end end) end end)
			Tag.Hover=WindowConfig._LocalRegisterState.AttachHoverEffect(frame,frame,TagConfig)
			Tag.Wrapper=frame Tag.Frame=frame Tag.Chip=chip
			table.insert(XLQPGen1.AllElements,Tag)
			WindowConfig._LocalRegisterState.SetupElement(TagConfig,frame,frame,Tag)
			return Tag
		end
		ElementFunction.AddCursorTag=ElementFunction.CreateCursorTag
