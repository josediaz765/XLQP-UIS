				local name=tostring(data.Name or fileName:gsub("%.luau?$",""):gsub("%.json$",""):gsub("%.txt$",""))
				local colors={}
				local sourceColors=data.Colors or data.LiveColors
				if type(sourceColors)=="function" then
					local colorOk,result=pcall(sourceColors,data)
					if colorOk then sourceColors=result end
				end
				if typeof(sourceColors)=="ColorSequence" then
					local converted={}
					for _,keypoint in ipairs(sourceColors.Keypoints) do converted[#converted+1]=keypoint.Value end
					sourceColors=converted
				end
				for _,value in ipairs(type(sourceColors)=="table" and sourceColors or {}) do
					local color=XLQPParseLiveColor(value)
					if color then colors[#colors+1]=color end
				end
				local liveScript=data
				local isLiveScript=type(liveScript.OnEnable)=="function" or type(liveScript.Run)=="function" or type(liveScript.Code)=="function" or type(liveScript.OnUpdate)=="function" or type(liveScript.OnDisable)=="function"
				if #colors>=2 or isLiveScript then
					XLQPLiveColorThemes[name]=#colors>=2 and colors or XLQPLiveColorThemes.Thermal
					self.LiveColorThemeData[name]=data
					self.LiveColorScripts[name]=isLiveScript and liveScript or nil
					self._CustomLiveThemeNames[name]=true
				end
			end
		end
	end
	if self._WindowConfig and self._RefreshWindowLiveColor then
		task.defer(function()
			if not self._Destroyed and self._RefreshWindowLiveColor then self:_RefreshWindowLiveColor() end
		end)
	end
	if self._RefreshLiveColorDropdowns then self:_RefreshLiveColorDropdowns() end
	return self:GetLiveColorThemes()
end

function XLQPGen1:GetLiveColorThemeData(name)
	return self.LiveColorThemeData and self.LiveColorThemeData[tostring(name or "")] or nil
end

function XLQPLiveColorSequence(colors)
	if typeof(colors)=="ColorSequence" then return colors end
	if typeof(colors)=="Color3" then
		colors={colors,colors:Lerp(Color3.fromRGB(185,45,255),.55),colors:Lerp(Color3.fromRGB(65,105,255),.65),colors}
	end
	if type(colors)~="table" or #colors<2 then colors=XLQPLiveColorThemes.Thermal end
	local seamlessColors={}
	for _,color in ipairs(colors) do if typeof(color)=="Color3" then seamlessColors[#seamlessColors+1]=color end end
	if #seamlessColors>=2 and seamlessColors[#seamlessColors]~=seamlessColors[1] then seamlessColors[#seamlessColors+1]=seamlessColors[1] end
	local keypoints={}
	for index,color in ipairs(seamlessColors) do
		keypoints[#keypoints+1]=ColorSequenceKeypoint.new((index-1)/math.max(1,#seamlessColors-1),color)
	end
	if #keypoints<2 then return ColorSequence.new(Color3.fromRGB(255,48,92),Color3.fromRGB(85,80,255)) end
	return ColorSequence.new(keypoints)
end

local function XLQPResolveLiveColorTheme(config)
	config=type(config)=="table" and config or {}
	local selected=XLQPGen1.Themes and XLQPGen1.Themes[XLQPGen1.SelectedTheme or "Default"]
	local themeName=tostring(config.Theme or config.LiveColorTheme or (selected and selected.LiveColorTheme) or "Thermal")
	local colors=config.Colors or config.LiveColors or XLQPLiveColorThemes[themeName] or XLQPLiveColorThemes.Thermal
	return themeName,colors,XLQPGen1:GetLiveColorThemeData(themeName)
end

