		local function raiseNativeElement(root,minimumZ)
			if typeof(root)~="Instance" then return root end
			minimumZ=math.max(1,math.floor(tonumber(minimumZ) or 1))
			local guiObjects={}
			if root:IsA("GuiObject") then guiObjects[#guiObjects+1]=root end
			for _,descendant in ipairs(root:GetDescendants()) do
				if descendant:IsA("GuiObject") then guiObjects[#guiObjects+1]=descendant end
			end
			if #guiObjects==0 then return root end
			local lowest
			for _,object in ipairs(guiObjects) do
				local zIndex=tonumber(object.ZIndex) or 1
				lowest=lowest and math.min(lowest,zIndex) or zIndex
			end
			local offset=math.max(0,minimumZ-(lowest or minimumZ))
			if offset>0 then
				for _,object in ipairs(guiObjects) do
					pcall(function() object.ZIndex=(tonumber(object.ZIndex) or 1)+offset end)
				end
			end
			return root
		end

		local function ensureNativeElementZ(root,minimumZ)
			if typeof(root)~="Instance" then return root end
			minimumZ=math.max(1,math.floor(tonumber(minimumZ) or 1))
			local function lift(object)
				if not object:IsA("GuiObject") then return end
				local depth=0
				local parent=object.Parent
				while parent and parent~=root and depth<12 do depth+=1 parent=parent.Parent end
				local desired=minimumZ+math.min(depth,12)
				if (tonumber(object.ZIndex) or 1)<desired then pcall(function() object.ZIndex=desired end) end
			end
			if root:IsA("GuiObject") then lift(root) end
			for _,descendant in ipairs(root:GetDescendants()) do lift(descendant) end
			return root
		end

