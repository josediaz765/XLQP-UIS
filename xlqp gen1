	savePlaylist = function()
		if writefile and (not isfolder("XLQP Gen1") and makefolder("XLQP Gen1") or isfolder("XLQP Gen1")) then
			local success, err = pcall(writefile, playlistFile, HttpService:JSONEncode(playlist))
			if not success then XLQPGen1:MakeNotification({Name="Media Player", Content="Failed to save playlist"}) end
		end
	end

	loadPlaylist = function()
		if isfile and readfile and isfile(playlistFile) then
			local success, result = pcall(readfile, playlistFile)
			if success and result then
				local decodeSuccess, decoded = pcall(HttpService.JSONDecode, HttpService, result)
				if decodeSuccess and type(decoded) == "table" then
					if #decoded > 0 and type(decoded[1]) == "string" then
						XLQPGen1:MakeNotification({Name="Media Player", Content="Updating playlist format..."})
						local newPlaylist = {}
						for _, url in ipairs(decoded) do
							table.insert(newPlaylist, { name = extractFileName(url), url = url })
						end
						playlist = newPlaylist
						savePlaylist()
					else
						playlist = decoded
					end
				end
			end
		end
		for index, item in ipairs(playlist) do
			if type(item) == "string" then
				playlist[index] = {name = extractFileName(item), url = item}
			elseif type(item) == "table" then
				item.url = item.url or item.Url or item.URL or item.SoundId or item.Asset
				item.name = item.name or item.Name or item.Title or extractFileName(tostring(item.url or ""))
				if (not item.Image or tostring(item.Image)=="") and item.ImagePath and isfile and isfile(item.ImagePath) and (getcustomasset or getsynasset) then
					local ok,asset=pcall(getcustomasset or getsynasset,item.ImagePath)
					if ok then item.Image=asset end
				end
			end
		end
		updatePlaylistUI()
	end
	
