	function XLQPGen1:ReturnMoveableToOrigin(Frame, Silent, Reveal)
		if typeof(Frame) ~= "Instance" or not Frame:IsA("GuiObject") then return false end
		local origins = self._MoveableOrigins
		local origin = origins and origins[Frame]
		if not origin then return false end
		local destination
		if origin.Anchor and origin.Anchor.Parent and origin.Anchor.Parent:IsA("GuiObject") then
			destination=origin.Anchor.Parent
		elseif origin.Parent and origin.Parent.Parent and origin.Parent:IsA("GuiObject") then
			destination=origin.Parent
		else
			destination=self:ResolveMoveableOrigin(Frame)
		end
		if not destination then
			if not Silent and self.MakeNotification then
				self:MakeNotification({Name="Editable Layout",Content="The original slot could not be found, so the element was left where it is.",Image="triangle-alert",Time=3})
			end
			return false
		end
		local oldContainer = Frame.Parent and self:GetMoveableContainer(Frame.Parent) or nil
		local wasParent = Frame.Parent
		Frame.Parent = destination
		Frame.Visible = origin.Visible ~= false
		Frame.LayoutOrder = (origin.Anchor and origin.Anchor.Parent==destination and origin.Anchor.LayoutOrder) or tonumber(origin.LayoutOrder) or Frame.LayoutOrder
