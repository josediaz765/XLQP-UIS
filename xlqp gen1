		local function compact(value, limit)
			value = tostring(value or ""):gsub("%s+", " ")
			limit = limit or 110
			if #value > limit then
				return value:sub(1, limit) .. "..."
			end
			return value
		end

		local function randomPick(list)
			return list[math.random(1, #list)]
		end

		local function countFrom(detail)
			local count = tostring(detail or ""):match("(%d+)%s+results") or tostring(detail or ""):match("Found%s+(%d+)") or tostring(detail or ""):match("Selected%s+(%d+)")
			return tonumber(count) or 0
		end

		local function nextAIEventText(event)
			if not aiStepMode or #aiStepQueue == 0 then return nil end
			local state = event.State or event.state or "status"
			if state ~= "done" and state ~= "start" then return nil end
			if event.__AIEventText then return event.__AIEventText end
			local text = aiStepQueue[math.min(aiStepCursor, #aiStepQueue)]
			aiStepCursor = math.min(aiStepCursor + 1, #aiStepQueue + 1)
			if type(text) == "string" and text ~= "" then
				event.__AIEventText = compact(text, 125)
				return event.__AIEventText
			end
			return nil
		end

		local function setLive(text)
			text = compact(text, 135)
			if text == "" or text == lastStatus then return end
			lastStatus = text
			local old = live:GetAttribute("Generation") or 0
			local generation = old + 1
			live:SetAttribute("Generation", generation)
			task.spawn(function()
				local chars = aiGraphemes(text)
				live.Text = ""
				for index, char in ipairs(chars) do
					if live:GetAttribute("Generation") ~= generation or not live.Parent then return end
					live.Text ..= char
					if index % 14 == 0 then resize() end
					task.wait(0.007)
				end
				resize()
			end)
		end

		local function phaseFromEvent(event)
			local tool = tostring(event.Tool or event.tool or "")
			if tool == "analyze_request" then return "analyze", "analyze request" end
			if tool == "decide_web_search" then return "web_decide", "decide web search" end
			if tool == "ai_live_plan" then return "ai_plan", "ask model for live steps" end
			if tool == "plan_search_queries" then return "web_plan", "prepare searches" end
			if tool == "search_web" or tool == "open_search_results" or tool == "fetch_url" then return "web_search", "search web" end
			if tool == "read_search_results" then return "web_read", "read web results" end
			if tool == "fetch_image" then return "image", "fetch image preview" end
			if tool == "prepare_context" then return "context", "prepare context" end
			if tool == "execute_provider" or tool == "generate_response" then return "model", "ask model" end
			if tool == "parse_response" or tool == "parse_answer" then return "parse", "parse answer" end
			if tool == "execute_script" then return "execute", "execute action" end
			if tool == "compose_answer" then return "compose", "compose answer" end
			if tool ~= "" then return tool:gsub("%W", "_"):lower(), tool:gsub("_", " ") end
			return "work", "working"
		end

		local function rawEventText(event, limit)
			local detail = tostring(event.Detail or event.detail or event.Status or event.status or "")
			if detail ~= "" then
				return compact(detail, limit or 120)
			end
			local tool = tostring(event.Tool or event.tool or "")
			if tool ~= "" then
				return compact(tool:gsub("_", " "), limit or 120)
			end
			return nil
		end

		local function visibleEventText(event, limit)
			local tool = tostring(event.Tool or event.tool or "")
			local state = event.State or event.state or "status"
			local detail = tostring(event.Detail or event.detail or event.Status or event.status or "")
			limit = limit or 110
			if tool == "analyze_request" then
				return state == "done" and "Read and understood the request." or "Reading the request."
			end
			if tool == "decide_web_search" then
				if detail:lower():find("skipped", 1, true) then return "No web lookup needed for this request." end
				return "Checked whether fresh web results are needed."
			end
			if tool == "plan_search_queries" then
				return "Prepared web search queries."
			end
			if tool == "search_web" or tool == "open_search_results" or tool == "fetch_url" then
				local count = countFrom(detail)
				if count > 0 then return "Found " .. tostring(count) .. " useful web results." end
				return compact(detail ~= "" and detail or "Searched the web for useful results.", limit)
			end
			if tool == "read_search_results" then
				return "Reviewed and selected useful web snippets."
			end
			if tool == "fetch_image" then
				return state == "fail" and "Image preview was unavailable." or "Fetched a relevant image preview."
			end
			if tool == "prepare_context" then
				return detail:lower():find("web", 1, true) and "Added web results to the request context." or "Prepared the conversation context."
			end
			if tool == "execute_provider" or tool == "generate_response" then
				local provider = detail:gsub("provider:%s*", ""):gsub("Generated with%s+", "")
				provider = sharedAIClean(provider)
				return provider ~= "" and ("Generated a response with " .. provider .. ".") or "Generated a response with the selected model."
			end
			if tool == "parse_response" or tool == "parse_answer" then
				return "Parsed and cleaned the model response."
			end
			if tool == "execute_script" then
				return state == "fail" and "The Lua action failed to run." or "Executed the requested Lua action."
			end
			if tool == "compose_answer" then
				return "Displayed the final answer."
			end
			return rawEventText(event, limit) or "Working..."
		end

		local function statusText(event)
			local state = event.State or event.state or "status"
			local tool = tostring(event.Tool or event.tool or "")
			local detail = tostring(event.Detail or event.detail or event.Status or event.status or "")
			if tool == "search_web" then
				local count = countFrom(detail)
				if state == "done" and count > 0 then
					foundSearchResults += count
				end
			end
			if tool == "execute_provider" or tool == "generate_response" then
				if detail ~= "" then
					lastProvider = detail:gsub("Generated with%s+", "")
				end
			end
			local aiLive = nextAIEventText(event)
			if aiLive then return aiLive end
			if state == "fail" then
				return rawEventText(event, 125) or "This step failed."
			end
			return visibleEventText(event, 125)
		end

		local function stepText(event)
			local state = event.State or event.state or "status"
			local aiLive = event.__AIEventText or nextAIEventText(event)
			if aiLive then return aiLive end
			if state == "fail" then
				return rawEventText(event, 92) or "Step failed."
			end
			return visibleEventText(event, 92)
		end

		local function updateProgress()
			local target = done and 1 or math.clamp(0.08 + completedSteps * 0.14, 0.08, 0.92)
			pcall(function()
				TweenService:Create(progressFill, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(target, 0, 1, 0)}):Play()
			end)
		end

		local function setRowState(data, state, text)
			data.State = state
			if text and text ~= "" then data.Text.Text = text end
			if state == "working" then
				data.Glyph.Text = spinner[spinnerIndex]
				data.Glyph.TextColor3 = Color3.fromRGB(178, 184, 210)
				data.Text.TextColor3 = Color3.fromRGB(198, 202, 220)
			elseif state == "fail" then
				data.Glyph.Text = "×"
				data.Glyph.TextColor3 = Color3.fromRGB(255, 126, 138)
				data.Text.TextColor3 = Color3.fromRGB(255, 155, 165)
			else
				data.Glyph.Text = "✓"
				data.Glyph.TextColor3 = Color3.fromRGB(110, 235, 155)
				data.Text.TextColor3 = Color3.fromRGB(185, 190, 208)
			end
		end

		local function trimRows()
			local maxVisible = 5
			for index, phaseId in ipairs(phaseOrder) do
				local data = phaseRows[phaseId]
				if data and data.Row then
					data.Row.Visible = index > math.max(0, #phaseOrder - maxVisible)
				end
			end
		end

		local function getRow(phaseId, label)
			local data = phaseRows[phaseId]
			if data then return data end
			phaseOrder[#phaseOrder + 1] = phaseId
			local row = Create("Frame", {LayoutOrder = #phaseOrder, Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Parent = stepsFrame})
			local glyph = Create("TextLabel", {Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, 0, 0, 1), BackgroundTransparency = 1, Text = "○", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Color3.fromRGB(178, 184, 210), Parent = row})
			local textLabel = Create("TextLabel", {Size = UDim2.new(1, -25, 1, 0), Position = UDim2.new(0, 25, 0, 0), BackgroundTransparency = 1, Text = compact(label, 88), Font = Enum.Font.Gotham, TextSize = 10, TextWrapped = true, TextColor3 = Color3.fromRGB(185, 190, 208), TextXAlignment = Enum.TextXAlignment.Left, Parent = row})
			data = {Row = row, Glyph = glyph, Text = textLabel, State = "working"}
			phaseRows[phaseId] = data
			trimRows()
			resize()
			return data
		end

		task.spawn(function()
			while not done and card.Parent do
				local elapsed = math.floor(os.clock() - startedAt)
				title.Text = expanded and ("Working for " .. tostring(elapsed) .. "s") or ("Working • " .. compact(lastStatus ~= "" and lastStatus or activePhase, 48))
				icon.Text = spinner[spinnerIndex]
				for _, data in pairs(phaseRows) do
					if data.State == "working" then
						data.Glyph.Text = spinner[spinnerIndex]
					end
				end
				spinnerIndex = spinnerIndex % #spinner + 1
				task.wait(0.35)
			end
		end)

		local controller = {}
		function controller:Event(event)
			if not card.Parent or type(event) ~= "table" then return end
			local toolName = tostring(event.Tool or event.tool or "")
			if toolName == "ai_live_plan" then
				return
			end
			setLive(statusText(event))
			local state = event.State or event.state or "status"
			local detail = tostring(event.Detail or event.detail or event.Status or event.status or "")
			if toolName == "decide_web_search" and state ~= "status" and detail:lower():find("skipped", 1, true) and not expanded then
				return
			end
			if state ~= "status" then
				local phaseId, label = phaseFromEvent(event)
				activePhase = label
				local rowText = stepText(event) or label
				local data = getRow(phaseId, rowText)
				if state == "start" then
					setRowState(data, "working", rowText)
				elseif state == "fail" then
					setRowState(data, "fail", rowText)
				else
					if data.State ~= "done" then completedSteps += 1 end
					setRowState(data, "done", rowText)
					updateProgress()
				end
				trimRows()
			end
			resize()
		end

		function controller:SetAIPlan(steps)
			aiStepQueue = {}
			aiStepCursor = 1
			if type(steps) == "table" then
				for _, step in ipairs(steps) do
					step = compact(step, 120)
					if step ~= "" then aiStepQueue[#aiStepQueue + 1] = step end
				end
			end
			aiStepMode = #aiStepQueue > 0
		end

		function controller:Finish(success, text)
			done = true
			local elapsed = math.max(0, math.floor(os.clock() - startedAt))
			icon.Text = success and "✓" or "×"
			icon.BackgroundColor3 = success and Color3.fromRGB(25, 68, 47) or Color3.fromRGB(72, 38, 44)
			icon.TextColor3 = success and Color3.fromRGB(100, 235, 155) or Color3.fromRGB(255, 125, 140)
			title.Text = (success and "Worked for " or "Stopped after ") .. tostring(elapsed) .. "s"
			title.TextColor3 = success and Color3.fromRGB(120, 235, 165) or Color3.fromRGB(255, 140, 150)
			setLive(success and (text or "Finished the answer.") or (text or "Stopped."))
			progressFill.Size = success and UDim2.new(1, 0, 1, 0) or progressFill.Size
			resize()
		end

		resize()
		return controller
	end

	local function aiStripHtml(value)
		local text = tostring(value or "")
		text = text:gsub("<script.-</script>", " ")
		text = text:gsub("<style.-</style>", " ")
		text = text:gsub("<[^>]->", " ")
		text = text:gsub("&nbsp;", " ")
		text = text:gsub("&quot;", "\"")
		text = text:gsub("&#39;", "'")
		text = text:gsub("&apos;", "'")
		text = text:gsub("&lt;", "<")
		text = text:gsub("&gt;", ">")
		text = text:gsub("&amp;", "&")
		text = text:gsub("%s+", " ")
		return sharedAIClean(text)
	end

	local function aiShouldSearchWeb(prompt)
		local text = tostring(prompt or ""):lower()
		for _, term in ipairs({"search the web", "search web", "look up", "lookup", "browse", "latest", "today", "current", "right now", "news", "recent", "price", "release date", "updated", "who is the current", "who is", "what is", "tell me about", "image", "picture", "photo", "score", "weather"}) do
			if text:find(term, 1, true) then return true end
		end
		return false
	end

	local function aiBuildSearchQueries(prompt)
		local base = sharedAIClean(prompt):gsub("[?!.]+$", "")
		base = base:gsub("^[Pp]lease%s+", ""):gsub("^[Cc]an you%s+", ""):gsub("^[Ss]earch%s+the%s+web%s+for%s+", ""):gsub("^[Ll]ook%s+up%s+", "")
		base = sharedAIClean(base)
		local queries, seen = {}, {}
		local function add(value)
			value = sharedAIClean(value):sub(1, 160)
			local key = value:lower()
			if value ~= "" and not seen[key] then
				seen[key] = true
				queries[#queries + 1] = value
			end
		end
		add(base)
		local lower = base:lower()
		if lower:find("latest", 1, true) or lower:find("today", 1, true) or lower:find("current", 1, true) or lower:find("news", 1, true) then add(base .. " latest current information") end
		if lower:find("fix", 1, true) or lower:find("error", 1, true) then add(base .. " troubleshooting guide") end
		while #queries > 3 do table.remove(queries) end
		return queries
	end

	local function aiCollectDuckTopics(list, output, limit)
		if type(list) ~= "table" or #output >= limit then return end
		for _, item in ipairs(list) do
			if #output >= limit then break end
			if type(item) == "table" then
				if type(item.Text) == "string" and sharedAIClean(item.Text) ~= "" then
					output[#output + 1] = sharedAIClean(item.Text)
				elseif type(item.Topics) == "table" then
					aiCollectDuckTopics(item.Topics, output, limit)
				end
			end
		end
	end

	local function aiParseDuck(body, output, limit)
		local data = sharedAIDecode(body)
		if type(data) ~= "table" then return end
		local function add(text, source)
			text = sharedAIClean(text)
			if text ~= "" and #output < limit then
				output[#output + 1] = {Text = text, Source = sharedAIClean(source or "DuckDuckGo")}
			end
		end
		add(data.Answer, data.AnswerType)
		add(data.AbstractText, data.AbstractSource)
		add(data.Definition, data.DefinitionSource)
		local topics = {}
		aiCollectDuckTopics(data.RelatedTopics, topics, limit)
		for _, topic in ipairs(topics) do add(topic, "Related topic") end
	end

	local function aiFetchImagePreview(prompt, process, tabId)
		if not aiShouldFetchImage(prompt) then return nil end
		local query = aiCleanImageQuery(prompt)
		if query == "" then return nil end
		process:Event({State = "start", Id = "fetch_image", Tool = "fetch_image", Detail = "Looking for an image preview for " .. query})
		local imageUrl = ""
		local duckUrl = "https://api.duckduckgo.com/?q=" .. HttpService:UrlEncode(query) .. "&format=json&no_html=1&no_redirect=1&skip_disambig=1"
		local body, code = sharedAIRawRequest("GET", duckUrl, { ["Accept"] = "application/json", ["User-Agent"] = "Mozilla/5.0" }, nil, 35)
		if body ~= "" and (code == 0 or (code >= 200 and code < 300)) then
			local data = sharedAIDecode(body)
			if type(data) == "table" then
				imageUrl = normalizeImageUrl(data.Image or data.ImageUrl or data.Thumbnail or "")
			end
		end
		if imageUrl == "" then
			local openUrl = "https://en.wikipedia.org/w/api.php?action=opensearch&limit=1&namespace=0&format=json&search=" .. HttpService:UrlEncode(query)
			local openBody, openCode = sharedAIRawRequest("GET", openUrl, { ["Accept"] = "application/json", ["User-Agent"] = "Mozilla/5.0" }, nil, 35)
			local title
			if openBody ~= "" and (openCode == 0 or (openCode >= 200 and openCode < 300)) then
				local data = sharedAIDecode(openBody)
				if type(data) == "table" and type(data[2]) == "table" and data[2][1] then title = tostring(data[2][1]) end
			end
			if title and title ~= "" then
				local summaryUrl = "https://en.wikipedia.org/api/rest_v1/page/summary/" .. HttpService:UrlEncode(title)
				local summaryBody, summaryCode = sharedAIRawRequest("GET", summaryUrl, { ["Accept"] = "application/json", ["User-Agent"] = "Mozilla/5.0" }, nil, 35)
				if summaryBody ~= "" and (summaryCode == 0 or (summaryCode >= 200 and summaryCode < 300)) then
					local data = sharedAIDecode(summaryBody)
					if type(data) == "table" then
						if type(data.thumbnail) == "table" and data.thumbnail.source then imageUrl = normalizeImageUrl(data.thumbnail.source) end
						if imageUrl == "" and type(data.originalimage) == "table" and data.originalimage.source then imageUrl = normalizeImageUrl(data.originalimage.source) end
					end
				end
			end
		end
		if imageUrl ~= "" then
			local asset = assetFromImageUrl(imageUrl)
			if asset then
				addImageToLog(tabId, "Image preview: " .. query, asset, imageUrl)
				process:Event({State = "done", Id = "fetch_image", Tool = "fetch_image", Detail = "Image preview loaded"})
				return imageUrl
			end
		end
		process:Event({State = "fail", Id = "fetch_image", Tool = "fetch_image", Detail = "No usable image preview found"})
		return nil
	end


	local function aiSearchWeb(prompt, process)
		local queries = aiBuildSearchQueries(prompt)
		process:Event({State = "start", Id = "plan_search", Tool = "plan_search_queries", Detail = tostring(#queries) .. " search quer" .. (#queries == 1 and "y" or "ies")})
		process:Event({State = "status", Status = "Preparing search queries"})
		process:Event({State = "done", Id = "plan_search", Tool = "plan_search_queries", Detail = table.concat(queries, " | ")})
		local allResults = {}
		for index, query in ipairs(queries) do
			local id = "search_web_" .. tostring(index)
			process:Event({State = "start", Id = id, Tool = "search_web", Detail = 'Query: "' .. query .. '"'})
			process:Event({State = "status", Status = 'Searching for "' .. query .. '"'})
			local results = {}
			local instantUrl = "https://api.duckduckgo.com/?q=" .. HttpService:UrlEncode(query) .. "&format=json&no_html=1&no_redirect=1&skip_disambig=1"
			local body, code = sharedAIRawRequest("GET", instantUrl, {["Accept"] = "application/json", ["User-Agent"] = "Mozilla/5.0"}, nil, 35)
			if body ~= "" and (code == 0 or (code >= 200 and code < 300)) then
				aiParseDuck(body, results, 5)
			end
			if #results == 0 then
				process:Event({State = "status", Status = 'No instant answer; opening search result page'})
				local htmlUrl = "https://html.duckduckgo.com/html/?q=" .. HttpService:UrlEncode(query)
				local html, htmlCode = sharedAIRawRequest("GET", htmlUrl, {["Accept"] = "text/html", ["User-Agent"] = "Mozilla/5.0"}, nil, 35)
				if html ~= "" and (htmlCode == 0 or (htmlCode >= 200 and htmlCode < 300)) then
					for href, titleText, snippet in html:gmatch('<a[^>]-class="result__a"[^>]-href="([^"]+)"[^>]*>(.-)</a>.-class="result__snippet"[^>]*>(.-)</') do
						local cleanTitle = aiStripHtml(titleText)
						local cleanSnippet = aiStripHtml(snippet)
						if cleanTitle ~= "" or cleanSnippet ~= "" then
							results[#results + 1] = {Text = cleanTitle .. (cleanSnippet ~= "" and (" — " .. cleanSnippet) or ""), Source = href}
						end
						if #results >= 5 then break end
					end
				end
			end
			if #results > 0 then
				process:Event({State = "done", Id = id, Tool = "search_web", Detail = tostring(#results) .. " results | " .. results[1].Text:sub(1, 100)})
				for _, result in ipairs(results) do allResults[#allResults + 1] = result end
			else
				process:Event({State = "fail", Id = id, Tool = "search_web", Detail = 'No usable results for "' .. query .. '"'})
			end
		end
		if #allResults == 0 then return nil end
		process:Event({State = "start", Id = "read_results", Tool = "read_search_results", Detail = "Reviewing " .. tostring(#allResults) .. " retrieved results"})
		local lines = {}
		for index, result in ipairs(allResults) do
			if index > 10 then break end
			lines[#lines + 1] = "[" .. tostring(index) .. "] " .. result.Text .. " (Source: " .. result.Source .. ")"
		end
		process:Event({State = "done", Id = "read_results", Tool = "read_search_results", Detail = "Selected " .. tostring(#lines) .. " useful result snippets"})
		return "Web search results:\n" .. table.concat(lines, "\n")
	end

