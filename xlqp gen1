			makeText(option,kind,UDim2.fromOffset(60,20),UDim2.new(1,-70,.5,-10),9,palette.Muted,Enum.Font.Gotham,75,Enum.TextXAlignment.Right)
			option.MouseEnter:Connect(function()
				TweenService:Create(option,TweenInfo.new(.1),{BackgroundTransparency=.9}):Play()
			end)
			option.MouseLeave:Connect(function()
