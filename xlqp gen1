 function normalizeBackgroundLink(link)
	local normalized=tostring(link or ""):gsub("%s+","")
	if normalized:match("^%d+$") then normalized="rbxassetid://"..normalized end
	return normalized
end

 function applyBackgroundData(data, notifyText)
	if type(data)~="table" then return false end
	if data.Theme then
		applyThemeTable(data.Theme)
	end
	if data.Enabled~=nil then
		WindowConfig.URLBackgroundEnabled=data.Enabled==true
		WindowConfig.BackgroundEnabled=data.Enabled==true
	end
	local gifLink=XLQPGifTrim(data.GifUrl or data.GIFUrl or data.GifBackgroundUrl or "")
	WindowConfig.GifBackgroundUrl=gifLink
	WindowConfig._LocalRegisterState.currentGifBackgroundUrl=gifLink
	WindowConfig.GifBackgroundTransparency=math.clamp(tonumber(data.GifTransparency) or tonumber(data.GIFTransparency) or tonumber(data.Transparency) or WindowConfig.GifBackgroundTransparency or 0.18,0,1)
	WindowConfig.GifBackgroundEnabled=data.GifEnabled==true or data.GIFEnabled==true
	if WindowConfig.GifBackgroundEnabled and gifLink~="" then
		WindowConfig.BackgroundEnabled=true
		XLQPGen1:SetGifBackground(gifLink,WindowConfig.GifBackgroundTransparency)
		if notifyText then WindowConfig._LocalRegisterState.notifySettings("Background",notifyText) end
		return true
	elseif XLQPGen1._GifRuntime and XLQPGen1._GifRuntime.Active then
		XLQPGen1._GifRuntime:Stop(true)
	end
	local link=normalizeBackgroundLink(data.Link or data.Background or "")
	if link~="" and applyCustomBackgroundAsset then
		WindowConfig._LocalRegisterState.currentBackgroundLink=link
		if WindowConfig.BackgroundEnabled==false then
			if cleanupCurrentMedia then cleanupCurrentMedia() end
			if notifyText then WindowConfig._LocalRegisterState.notifySettings("Background",notifyText.." Rendering is off.") end
			return true
		end
		applyCustomBackgroundAsset(link, tonumber(data.Transparency) or WindowConfig.BackgroundTransparency or 0)
	end
	if notifyText then WindowConfig._LocalRegisterState.notifySettings("Background",notifyText) end
	return link~=""
end

XLQPGen1._ApplyAutoloadVisuals=function(showNotify)
	if XLQPGen1._VisualAutoloadApplied then return end
	XLQPGen1._VisualAutoloadApplied=true
	local data=readTextFile(themePath("autoload"))
	local theme=decodeTheme(data)
	if theme then
		XLQPGen1.Themes.Custom=theme
		XLQPGen1.SelectedTheme="Custom"
		SetTheme()
		if applyNewUIStyle then applyNewUIStyle() end
		if applyNewUITransparency then applyNewUITransparency() end
		if showNotify then WindowConfig._LocalRegisterState.notifySettings("Theme","Auto-loaded theme.") end
	end
	local bgData=readTextFile(backgroundPath("autoload"))
	local ok,bg=pcall(function() return HttpService:JSONDecode(bgData or "") end)
	if ok and type(bg)=="table" then
		applyBackgroundData(bg,showNotify and "Auto-loaded background." or nil)
	end
end

