				Name = "Grid",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 2,
				Parent = wrapper
			}), {
				Create("UIGridLayout", {
					CellSize = UDim2.new(1/columns, -8, 0, 92),
					CellPadding = UDim2.fromOffset(8, 8),
					SortOrder = Enum.SortOrder.LayoutOrder,
					FillDirectionMaxCells = columns
				})
			})
			local function resolveProfile(entry)
				if typeof(entry) == "Instance" and entry:IsA("Player") then
					return {UserId=entry.UserId, Name=entry.Name, DisplayName=entry.DisplayName, Player=entry}
				end
				if type(entry) == "number" then return {UserId=entry} end
				if type(entry) == "string" then
					local found = Players:FindFirstChild(entry)
					if found then return {UserId=found.UserId, Name=found.Name, DisplayName=found.DisplayName, Player=found} end
					return {Name=entry}
				end
				if type(entry) == "table" then
					local player = entry.Player
					if typeof(player) == "Instance" and player:IsA("Player") then
						return {UserId=entry.UserId or player.UserId, Name=entry.Name or player.Name, DisplayName=entry.DisplayName or player.DisplayName, Player=player, Subtitle=entry.Subtitle, Color=entry.Color, Tag=entry.Tag, Callback=entry.Callback, LockedTo=entry.LockedTo}
					end
					return entry
				end
				return {Name=tostring(entry)}
			end
			local function addProfile(entry)
				local info = resolveProfile(entry)
				local displayName = tostring(info.DisplayName or info.Name or "Player")
				local userName = tostring(info.Name or displayName)
				local userId = tonumber(info.UserId) or 0
