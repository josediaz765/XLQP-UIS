	local result, err = configCloudRequest("GET", "/api/configs", nil)
	if not result then return nil, err end
	local configs = type(result.configs) == "table" and result.configs or result
	if type(configs) ~= "table" then return {}, nil end
	query = tostring(query or ""):lower()
	local filtered = {}
	for _, item in ipairs(configs) do
		if type(item) == "table" then
			local name = tostring(item.config_name or item.name or item.title or "Untitled config")
			local username = tostring(item.username or item.user_name or "")
			local displayName = tostring(item.display_name or item.displayName or username)
			local gameName = tostring(item.game_name or item.gameName or "Unknown game")
			local tags = tostring(item.tags or "")
			local haystack = (name .. " " .. username .. " " .. displayName .. " " .. gameName .. " " .. tags):lower()
			if query == "" or haystack:find(query, 1, true) then
				item.config_name = name
				item.username = username
				item.display_name = displayName
				item.game_name = gameName
				filtered[#filtered + 1] = item
			end
		end
	end
	return filtered, nil
end

function XLQPGen1:GetOwnPublicConfigCloud(query)
	local player = Players.LocalPlayer
	if not player then return {}, "LocalPlayer is unavailable." end
	local ownerId = tostring(player.UserId)
	local mine, mineError = configCloudRequest("GET", "/api/configs/mine?owner_id=" .. HttpService:UrlEncode(ownerId), nil)
	if not mine then return nil, mineError end
	local results = {}
	for _, configName in ipairs(type(mine.names) == "table" and mine.names or {}) do
		configName = tostring(configName or "")
		if configName ~= "" then
			local fetched = configCloudRequest("GET", "/api/configs/" .. HttpService:UrlEncode(ownerId) .. "/" .. HttpService:UrlEncode(configName), nil)
			local item = fetched and (fetched.config or fetched)
			if type(item) == "table" and configCloudPublicItemMatches(item, query) then
				results[#results + 1] = item
			end
		end
	end
	return results, nil
end

function XLQPGen1:DecodeConfigCloudExportCode(code)
	code = tostring(code or ""):gsub("%s+", "")
	if code == "" then return false, "Enter an export code." end
	local decodeOk, raw = pcall(configCloudBase64Decode, code)
	if not decodeOk or raw == "" then return false, "Incorrect code. Check it and try again." end
	local jsonOk, config = pcall(HttpService.JSONDecode, HttpService, raw)
	if not jsonOk or type(config) ~= "table" then return false, "Incorrect code. Check it and try again." end
	if tostring(config.config_name or "") == "" or config.elements_json == nil or tostring(config.share_code or "") == "" then
		return false, "Incorrect code. This is not a valid Config Cloud export."
	end
	return true, config
end

function XLQPGen1:CreateConfigCloudExportCode(item)
	item = type(item) == "table" and item or {}
	local ownerId = tostring(item.owner_id or item.user_id or "")
	local configName = tostring(item.config_name or item.name or "")
	if ownerId == "" or configName == "" then return false, "Select a config to export." end
	local localOwner = tostring(Players.LocalPlayer and Players.LocalPlayer.UserId or "")
	if localOwner == "" or ownerId ~= localOwner then return false, "Only the config owner can export this config." end
	local full = item
	if full.elements_json == nil or tostring(full.share_code or "") == "" then
		local fetched, fetchError = configCloudRequest("GET", "/api/configs/" .. HttpService:UrlEncode(ownerId) .. "/" .. HttpService:UrlEncode(configName), nil)
		if not fetched then return false, fetchError end
		full = fetched.config or fetched
	end
	if type(full) ~= "table" or full.elements_json == nil then return false, "The server did not return this config's saved values." end
	if tostring(full.share_code or "") == "" then return false, "This config has no share code yet. Upload it again to generate one." end
	local export = {
		config_name = tostring(full.config_name or configName),
		game_name = tostring(full.game_name or ""),
		description = tostring(full.description or ""),
		elements_json = full.elements_json,
		share_code = tostring(full.share_code),
		display_name = tostring(full.display_name or full.roblox_display_name or ""),
		original_owner_id = ownerId
	}
	local encodedOk, json = pcall(HttpService.JSONEncode, HttpService, export)
	if not encodedOk then return false, "The export code could not be generated." end
	return true, configCloudBase64Encode(json), full
end

function XLQPGen1:SetPublicConfigCloudVisibility(item, isPublic)
	item = type(item) == "table" and item or {}
	local ownerId = tostring(item.owner_id or item.user_id or "")
	local configName = tostring(item.config_name or item.name or "")
	local localOwner = tostring(Players.LocalPlayer and Players.LocalPlayer.UserId or "")
	if ownerId == "" or configName == "" then return false, "Select a config first." end
	if ownerId ~= localOwner then return false, "Only the config owner can change visibility." end
