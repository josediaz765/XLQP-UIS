 function reportCallbackError(Context, Error)
	if XLQPSecureMode then return end
	local Message = tostring(Error or "Unknown callback error")
	local Name = type(Context) == "table" and tostring(Context.Name or "Callback") or tostring(Context or "Callback")
	local ShortMessage = Message:gsub("\n"," ")
	if #ShortMessage > 220 then ShortMessage = ShortMessage:sub(1,217) .. "..." end
	local Target = type(Context) == "table" and Context.Element or XLQPGen1.CallbackTargets[Name]
	local Now = os.clock()
	local ErrorKey = Name .. ":" .. Message:sub(1, 180)
	XLQPGen1._CallbackErrorLast = XLQPGen1._CallbackErrorLast or {}
	if XLQPGen1._CallbackErrorLast[ErrorKey] and Now - XLQPGen1._CallbackErrorLast[ErrorKey] < 3 then
		return
	end
	XLQPGen1._CallbackErrorLast[ErrorKey] = Now
	XLQPGen1.LibErrors[#XLQPGen1.LibErrors + 1] = {Name = Name, Message = Message, Time = os.clock()}
	XLQPGen1._HasLibErrors = true
	XLQPGen1._LastLibError = Name .. ": " .. Message
	if XLQPGen1._LoadingIssueLabel then
		XLQPGen1._LoadingIssueLabel.Text = "Library issue detected: " .. XLQPGen1._LastLibError .. ". Your script is fine, but the UI library needs a fix. Contact Itsjose4 on Discord."
		XLQPGen1._LoadingIssueLabel.Visible = true
	end
	XLQPWarn(("XLQPGen1 Callback Error [%s]: %s"):format(Name, Message))
	if Target and type(Target.ShowCallbackError) == "function" then
		pcall(function() Target:ShowCallbackError(Message) end)
	end
	if XLQPGen1 and type(XLQPGen1.MakeNotification) == "function" then
		task.defer(function()
			pcall(function()
				XLQPGen1:MakeNotification({
					Name = "Callback Error",
					Content = Name .. ": " .. ShortMessage,
					Image = "triangle-alert",
					Time = 6
				})
			end)
		end)
	end
end

