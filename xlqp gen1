			local function trimAIText(value)
				return tostring(value or ""):gsub("\r\n","\n"):gsub("\r","\n"):gsub("^%s+",""):gsub("%s+$","")
			end
			local function looksLikeExecutorLua(value)
				local source=trimAIText(value)
				if source=="" then return false end
				local hits=0
				for _,pattern in ipairs({"local%s+[%w_]+%s*=","game:GetService","function%s+[%w_%.:]*%s*%(","Instance%.new","workspace[%.:]","task%.","Enum%.","return%s+","if%s+.-%s+then","for%s+.-%s+do"}) do
					if source:find(pattern) then hits+=1 end
				end
				return hits>=2 or (hits>=1 and #source>45)
			end
			local function extractAICode(answer)
				local source=trimAIText(answer)
				local fenced=source:match("```[Ll][Uu][Aa][Uu]?%s*\n?(.-)%s*```") or source:match("```%s*\n(.-)%s*```") or source:match("```%s*(.-)%s*```")
				if fenced and trimAIText(fenced)~="" then return trimAIText(fenced) end
				local cleaned=source:gsub("^%s*[Ll][Uu][Aa][Uu]?%s*[:%-]?%s*\n","")
				if looksLikeExecutorLua(cleaned) then return cleaned end
				return nil
			end
