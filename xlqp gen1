					ZIndex = 3,
					Parent = card
				}), "TextDark")
				local Profile = {Name=displayName, UserName=userName, UserId=userId, Frame=card, Wrapper=card, Type="ProfileCard", Player=info.Player}
				local click = SetProps(MakeElement("Button"), {Name="ProfileClick", Size=UDim2.fromScale(1,1), ZIndex=6, Parent=card})
				XLQPAttachCursorGlow(card, click, info)
				AddConnection(click.Activated, function()
					SafeCallback(info.Callback, displayName, Profile, Profiles)
					SafeCallback(ProfileConfig.Callback, ProfileConfig.Name, Profile, Profiles)
				end)
				XLQPInstallTags(card, info, Profile, {AnchorY = 18})
				function Profile:SetSubtitle(text) subLabel.Text = tostring(text or "") return self end
				function Profile:SetName(text) self.Name = tostring(text or "") nameLabel.Text = self.Name return self end
				function Profile:Destroy()
					for index, existing in ipairs(Profiles.Items) do
						if existing == self then table.remove(Profiles.Items, index) break end
					end
					if card and card.Parent then card:Destroy() end
				end
				if not XLQPGen1:_ResolveLock(info) then
					card.Visible = false
					card.Parent = XLQPGen1:_LockedVault()
					Profile.LockedOut = true
				end
				table.insert(Profiles.Items, Profile)
				return Profile
			end
			function Profiles:Add(entry) return addProfile(entry) end
			function Profiles:Clear()
				for index = #self.Items, 1, -1 do
					local profile = self.Items[index]
					if profile and profile.Frame and profile.Frame.Parent then profile.Frame:Destroy() end
					self.Items[index] = nil
				end
				return self
			end
			function Profiles:SetItems(list)
				self:Clear()
				for _, entry in ipairs(type(list) == "table" and list or {}) do addProfile(entry) end
				return self
			end
			function Profiles:LoadServer()
				self:Clear()
				for _, player in ipairs(Players:GetPlayers()) do addProfile(player) end
				return self
			end
			function Profiles:Get(target)
				if type(target) == "number" then
					for _, profile in ipairs(self.Items) do
						if profile.UserId == target then return profile end
					end
					return self.Items[target]
				end
				local key = tostring(target or ""):lower()
				for _, profile in ipairs(self.Items) do
					if tostring(profile.UserName):lower() == key or tostring(profile.Name):lower() == key then return profile end
				end
				return nil
			end
			if ProfileConfig.LoadServer == true then
				Profiles:LoadServer()
			else
				for _, entry in ipairs(ProfileConfig.Items) do addProfile(entry) end
			end
			if ProfileConfig.AutoRefresh == true then
				AddConnection(Players.PlayerAdded, function() task.defer(function() if wrapper.Parent then Profiles:LoadServer() end end) end)
				AddConnection(Players.PlayerRemoving, function() task.defer(function() if wrapper.Parent then Profiles:LoadServer() end end) end)
			end
			Profiles.Wrapper = wrapper
			Profiles.Grid = grid
			table.insert(XLQPGen1.AllElements, Profiles)
			WindowConfig._LocalRegisterState.SetupElement(ProfileConfig, wrapper, wrapper, Profiles)
			return Profiles
		end
