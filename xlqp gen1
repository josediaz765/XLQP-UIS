 function XLQPCompactConnections()
	local list = XLQPGen1.Connections
	local write = 1
	for read = 1, #list do
		local connection = list[read]
		local alive = connection ~= nil
		if alive then
			local ok, connected = pcall(function() return connection.Connected end)
			if ok and connected == false then alive = false end
		end
		if alive then
			list[write] = connection
			write += 1
		end
	end
	for index = write, #list do list[index] = nil end
	XLQPGen1._ConnectionsSinceCompact = 0
end

 function AddConnection(Signal, Function)
	if (not XLQPGen1:IsRunning()) then
		return
	end
	local connectionRunning=false
	local SafeFunction = function(...)
		if not XLQPGen1:IsRunning() or connectionRunning then return end
		connectionRunning=true
		SafeCallback(Function, "Connection", ...)
		connectionRunning=false
	end
	local SignalConnect = Signal:Connect(SafeFunction)
	local list = XLQPGen1.Connections
	list[#list + 1] = SignalConnect
	local since = (XLQPGen1._ConnectionsSinceCompact or 0) + 1
	XLQPGen1._ConnectionsSinceCompact = since
	if since >= 512 and #list >= 1024 then XLQPCompactConnections() end
	return SignalConnect
end

function CreateXLQPSignal()
	local signal = {Listeners = {}, NextId = 0, Destroyed = false}
	function signal:Connect(callback)
		if self.Destroyed or type(callback) ~= "function" then
			return {Connected = false, Disconnect = function() end}
		end
		self.NextId += 1
		local id = self.NextId
		self.Listeners[id] = callback
		local connection = {Connected = true}
		function connection:Disconnect()
			if not self.Connected then return end
			self.Connected = false
			signal.Listeners[id] = nil
		end
		return connection
	end
	function signal:Once(callback)
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			callback(...)
		end)
		return connection
	end
	function signal:Fire(...)
		if self.Destroyed then return {} end
		local results = {}
		local snapshot = {}
		for id, callback in pairs(self.Listeners) do snapshot[#snapshot + 1] = {id, callback} end
		for _, entry in ipairs(snapshot) do
			if self.Listeners[entry[1]] == entry[2] then
				local ok, result = pcall(entry[2], ...)
				if ok then
					results[#results + 1] = result
				else
					warn("XLQP Gen1 event error: " .. tostring(result))
				end
			end
		end
		return results
	end
	function signal:HasConnections()
		return next(self.Listeners) ~= nil
	end
	function signal:Destroy()
		self.Destroyed = true
		table.clear(self.Listeners)
	end
	return signal
end

function XLQPGen1:SetHapticsEnabled(value)
	self.HapticsEnabled = value == true
	self._HapticsEnabled = self.HapticsEnabled
	return self.HapticsEnabled
