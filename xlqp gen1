 WindowConfig._LocalRegisterState.periodicEntries=setmetatable({},{__mode="k"})
 WindowConfig._LocalRegisterState.periodicWorkerRunning=false
 WindowConfig._LocalRegisterState.periodicWorkerToken=0
 WindowConfig._LocalRegisterState.startPeriodicWorker=function()
 	local state=WindowConfig._LocalRegisterState
 	if state.periodicWorkerRunning or next(state.periodicEntries)==nil then return end
 	state.periodicWorkerRunning=true
 	state.periodicWorkerToken=(tonumber(state.periodicWorkerToken) or 0)+1
 	local token=state.periodicWorkerToken
 	task.spawn(function()
 		while XLQPGen1:IsRunning() and token==state.periodicWorkerToken do
 			local now=os.clock()
 			local nextDue
 			local hasEntries=false
 			for key,entry in pairs(state.periodicEntries) do
 				local object=type(entry)=="table" and entry.Object or nil
 				if type(entry)~="table" or type(entry.Callback)~="function" or (object and not object.Parent) then
 					state.periodicEntries[key]=nil
 				else
 					hasEntries=true
 					local due=tonumber(entry.Next) or now
 					if due<=now then
 						entry.Next=now+math.max(0.05,tonumber(entry.Interval) or 1)
 						local shouldRun=entry.RunWhenHidden==true or object==nil or state.isGuiBranchVisible(object)
 						if shouldRun then pcall(entry.Callback,now) end
 						due=entry.Next
 					end
 					if not nextDue or due<nextDue then nextDue=due end
 				end
 			end
 			if not hasEntries or next(state.periodicEntries)==nil then break end
 			now=os.clock()
 			task.wait(math.clamp((nextDue or now+0.25)-now,0.05,1))
 		end
 		if token==state.periodicWorkerToken then state.periodicWorkerRunning=false end
 	end)
 end
 WindowConfig._LocalRegisterState.registerPeriodic=function(key,interval,callback,object,runWhenHidden,immediate)
 	if key==nil or type(callback)~="function" then return end
 	local state=WindowConfig._LocalRegisterState
 	local resolvedInterval=math.max(0.05,tonumber(interval) or 1)
 	local now=os.clock()
 	local entry={Interval=resolvedInterval,Callback=callback,Object=object,RunWhenHidden=runWhenHidden==true,Next=now+resolvedInterval}
 	state.periodicEntries[key]=entry
 	if immediate==true then
 		local shouldRun=entry.RunWhenHidden==true or object==nil or state.isGuiBranchVisible(object)
 		if shouldRun then pcall(callback,now) end
 	end
 	state.startPeriodicWorker()
 end
