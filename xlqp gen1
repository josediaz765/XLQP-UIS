function XLQPGen1:SetDynamicIslandEnabled(value)
	self.DynamicIslandEnabled = value ~= false
	if not self.DynamicIslandEnabled and self._DynamicIsland then
		self._DynamicIsland:Hide()
	elseif self.DynamicIslandEnabled then
		self:_EnsureDynamicIsland()
		if self._MediaPlayer then
			self._DynamicIslandBound=nil
			self:BindDynamicIsland(self._MediaPlayer)
		end
	end
	return self.DynamicIslandEnabled
end

function XLQPGen1:GetDynamicIslandEnabled()
	return self.DynamicIslandEnabled ~= false
end

function XLQPGen1:SetDynamicIslandNotificationsEnabled(value)
	self.DynamicIslandNotificationsEnabled=value==true
	return self.DynamicIslandNotificationsEnabled
end

function XLQPGen1:GetDynamicIslandNotificationsEnabled()
	return self.DynamicIslandNotificationsEnabled==true
end

function XLQPGen1:_EnsureDynamicIsland()
	if self._DynamicIsland and self._DynamicIsland.Gui and self._DynamicIsland.Gui.Parent then return self._DynamicIsland end
	local gui = Instance.new("ScreenGui")
	gui.Name = "XLQPDynamicIsland"
	gui:SetAttribute("XLQPPersistent", true)
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	gui.DisplayOrder = math.min(2147483647, (self:GetZIndex() or 9999) + 30)
	gui.Parent = XLQPGetGuiParent()
	self:RegisterPopupGui(gui)

	local collapsedWidth = 210
	local expandedWidth = 330
	local collapsedHeight = 42
	local expandedHeight = 96

	local pill = Create("Frame", {
		Name = "Island",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -70),
		Size = UDim2.fromOffset(collapsedWidth, collapsedHeight),
		BackgroundColor3 = Color3.fromRGB(8, 8, 10),
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 5,
		Parent = gui
	}, {Create("UICorner", {CornerRadius = UDim.new(0, 21)}),Create("UIStroke",{Color=Color3.new(1,1,1),Transparency=.84,Thickness=1})})
	pill:SetAttribute("NoLiquidGlass", true)

	local art = Create("ImageLabel", {
		Name = "Art",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0, 21),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Color3.fromRGB(26, 26, 30),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = 6,
		Parent = pill
	}, {Create("UICorner", {CornerRadius = UDim.new(0, 9)})})
	art:SetAttribute("PreserveImageColor", true)
	art:SetAttribute("NoLiquidGlassIcon", true)

	local trackLabel = Create("TextLabel", {
		Name = "Track",
		Position = UDim2.new(0, 44, 0, 6),
		Size = UDim2.new(1, -110, 0, 18),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.fromRGB(240, 240, 245),
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
		ZIndex = 6,
		Parent = pill
	})
	local subLabel = Create("TextLabel", {
		Name = "Subtitle",
		Position = UDim2.new(0, 44, 0, 23),
		Size = UDim2.new(1, -110, 0, 14),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.fromRGB(150, 150, 158),
		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
		ZIndex = 6,
		Parent = pill
	})

	local bars = {}
	local waveHolder = Create("Frame", {
		Name = "Wave",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0, 21),
		Size = UDim2.fromOffset(34, 20),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = pill
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 3)
		})
	})
	for index = 1, 5 do
		local bar = Create("Frame", {
			Name = "Bar",
			Size = UDim2.fromOffset(3, 6),
			BackgroundColor3 = Color3.fromRGB(226, 210, 170),
			BorderSizePixel = 0,
			LayoutOrder = index,
			ZIndex = 7,
			Parent = waveHolder
		}, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
		bars[index] = {Frame = bar, Phase = index * 0.7}
	end

	local controls = Create("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(180, 32),
		BackgroundTransparency = 1,
		Visible = false,
		Active = false,
		ZIndex = 20,
		Parent = pill
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 12)
		})
	})
	local function makeControl(iconName, order)
		local button = Create("TextButton", {
			Name = iconName,
			Size = UDim2.fromOffset(32, 32),
			BackgroundColor3 = Color3.fromRGB(30, 30, 34),
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = order,
			ZIndex = 21,
			Parent = controls
		}, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
		local icon = Create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(15, 15),
			BackgroundTransparency = 1,
			Image = GetIcon(iconName) or "",
			ImageColor3 = Color3.fromRGB(240, 240, 245),
			ZIndex = 22,
			Parent = button
		})
		icon:SetAttribute("NoLiquidGlassIcon", true)
		return button, icon
	end
	local prevButton = makeControl("skip-back", 1)
	local playButton, playIcon = makeControl("play", 2)
	local nextButton = makeControl("skip-forward", 3)

	local Island = {Gui = gui, Frame = pill, Expanded = false, Visible = false, Playing = false, Level = 0, Mode = "Music", MusicState = nil, NotificationToken = 0}
	local hideToken = 0

	function Island:Show()
		if XLQPGen1.DynamicIslandEnabled == false then return self end
		hideToken += 1
		self.Visible = true
		pcall(function() gui.Enabled=true end)
		pcall(function() gui.DisplayOrder=math.min(2147483647,(XLQPGen1:GetZIndex() or 9999)+900) end)
		pill.Visible = true
		pill.Position = UDim2.new(0.5, 0, 0, -70)
		TweenService:Create(pill, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0, 12)}):Play()
		TweenService:Create(trackLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
		TweenService:Create(subLabel, TweenInfo.new(0.3), {TextTransparency = 0.15}):Play()
		return self
	end

	function Island:Hide()
		hideToken += 1
		local current = hideToken
		self.Visible = false
		self:Collapse()
		TweenService:Create(pill, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Position = UDim2.new(0.5, 0, 0, -70)}):Play()
		TweenService:Create(trackLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
		TweenService:Create(subLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
		task.delay(0.34, function()
			if hideToken == current and not self.Visible then pill.Visible = false end
		end)
		return self
	end

	function Island:Expand()
		if self.Expanded then return self end
		self.Expanded = true
		controls.Visible = true
		TweenService:Create(pill, TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(expandedWidth, expandedHeight)}):Play()
		TweenService:Create(art, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(42, 42), Position = UDim2.new(0, 10, 0, 27)}):Play()
		TweenService:Create(trackLabel, TweenInfo.new(0.3), {Position = UDim2.new(0, 60, 0, 14)}):Play()
		TweenService:Create(subLabel, TweenInfo.new(0.3), {Position = UDim2.new(0, 60, 0, 33)}):Play()
		TweenService:Create(waveHolder, TweenInfo.new(0.3), {Position = UDim2.new(1, -14, 0, 27)}):Play()
		return self
	end

	function Island:Collapse()
		if not self.Expanded then return self end
		self.Expanded = false
		TweenService:Create(pill, TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(collapsedWidth, collapsedHeight)}):Play()
		TweenService:Create(art, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 6, 0, 21)}):Play()
		TweenService:Create(trackLabel, TweenInfo.new(0.3), {Position = UDim2.new(0, 44, 0, 6)}):Play()
		TweenService:Create(subLabel, TweenInfo.new(0.3), {Position = UDim2.new(0, 44, 0, 23)}):Play()
		TweenService:Create(waveHolder, TweenInfo.new(0.3), {Position = UDim2.new(1, -14, 0, 21)}):Play()
		controls.Visible = false
		return self
	end

	function Island:Toggle()
		if self.Expanded then return self:Collapse() end
		return self:Expand()
	end

	function Island:SetTrack(state)
		state = type(state) == "table" and state or {}
		self.Mode="Music"
		waveHolder.Visible=true
		local name = tostring(state.TrackName or state.Name or "Unknown track")
		trackLabel.Text = name
		subLabel.Text = tostring(state.Subtitle or (state.Playing and "Now playing" or "Paused"))
		self.Playing = state.Playing == true
		XLQPAssignProperty(playIcon, "Image", GetIcon(self.Playing and "pause" or "play") or playIcon.Image)
		local image = state.Image
		if image ~= nil and tostring(image) ~= "" then
			local resolved = tostring(image)
			if resolved:match("^%d+$") then resolved = "rbxassetid://" .. resolved end
			XLQPAssignProperty(art, "Image", resolved)
			art.ImageRectSize=Vector2.new()
			art.ImageRectOffset=Vector2.new()
		end
