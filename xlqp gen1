		end
		if type(choice.text) == "string" then return sharedAIClean(choice.text) end
	end
	local err = sharedAIExtractError(data)
	if err and err ~= "" then return nil, err end
	local found = sharedAIFindText(data)
	if found then return found end
	return nil, "No answer returned"
