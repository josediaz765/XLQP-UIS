	local function normAIResponse(res)
		if not res then return 0,"" end
		local code = tonumber(res.StatusCode or res.status_code or res.Status or res.status or 200) or 200
		local body = tostring(res.Body or res.body or res.ResponseBody or res.responseBody or res.Data or res.data or "")
