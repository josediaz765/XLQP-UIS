		function ElementFunction:CreateFAQ(FAQConfig)
			FAQConfig = type(FAQConfig) == "table" and FAQConfig or {}
			FAQConfig.Name = tostring(FAQConfig.Name or "FAQ")
			FAQConfig.Items = type(FAQConfig.Items) == "table" and FAQConfig.Items or {}
			FAQConfig.Exclusive = FAQConfig.Exclusive ~= false and FAQConfig.AllowMultiple ~= true
			FAQConfig.AnimationTime = math.clamp(tonumber(FAQConfig.AnimationTime) or 0.28,0.08,0.8)
			FAQConfig.QuestionSize = math.clamp(tonumber(FAQConfig.QuestionSize) or 14,10,24)
			FAQConfig.AnswerSize = math.clamp(tonumber(FAQConfig.AnswerSize) or 13,9,22)
			FAQConfig.Gap = math.clamp(tonumber(FAQConfig.Gap) or 8,0,24)
			FAQConfig.Callback = FAQConfig.Callback or function() end
			local FAQ={Name=FAQConfig.Name,Type="FAQ",Items={},OpenIndex=nil}
			local container=SetProps(MakeElement("TFrame"),{Name="FAQ",Size=UDim2.new(1,0,0,0),Parent=ItemParent,ClipsDescendants=false})
			container:SetAttribute("SearchName",FAQConfig.Name)
			local list=Create("UIListLayout",{Padding=UDim.new(0,FAQConfig.Gap),SortOrder=Enum.SortOrder.LayoutOrder,Parent=container})
			local itemSerial=0
			local resizeToken=0
			local function measure(textValue,textSize,font,width)
				local ok,result=pcall(function()
					return TextService:GetTextSize(tostring(textValue or ""),textSize,font,Vector2.new(math.max(40,width),100000))
				end)
				return ok and math.ceil(result.Y) or math.ceil(#tostring(textValue or "")/math.max(1,math.floor(math.max(40,width)/(textSize*0.52))))*(textSize+4)
			end
			local function resizeContainer()
				resizeToken=resizeToken+1
				local token=resizeToken
				task.defer(function()
					if token~=resizeToken or not container.Parent then return end
					container.Size=UDim2.new(1,0,0,math.max(0,list.AbsoluteContentSize.Y))
				end)
			end
			AddConnection(list:GetPropertyChangedSignal("AbsoluteContentSize"),resizeContainer)
			local function resolveItem(value)
				if type(value)=="number" then return FAQ.Items[value],value end
				local wanted=tostring(value or ""):lower()
				for index,data in ipairs(FAQ.Items) do
					if tostring(data.Question or ""):lower()==wanted then return data,index end
				end
				return nil,nil
			end
			local function closeOthers(except)
				if not FAQConfig.Exclusive then return end
				for _,data in ipairs(FAQ.Items) do
					if data~=except and data.Open then data:SetOpen(false) end
				end
			end
			function FAQ:AddItem(ItemConfig)
				ItemConfig=type(ItemConfig)=="table" and ItemConfig or {Question=tostring(ItemConfig or "Question"),Answer=""}
				itemSerial=itemSerial+1
				local question=tostring(ItemConfig.Question or ItemConfig.Name or "Question")
				local answer=tostring(ItemConfig.Answer or ItemConfig.Content or "")
				local index=#FAQ.Items+1
				local item={Question=question,Answer=answer,Open=false,Index=index}
				local stroke=AddThemeObject(MakeElement("Stroke"),"Stroke")
				stroke.Transparency=tonumber(ItemConfig.StrokeTransparency) or 0.55
				local card=AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame",Color3.fromRGB(255,255,255),0,12),{Name="FAQItem",Size=UDim2.new(1,0,0,54),Parent=container,ClipsDescendants=true,LayoutOrder=itemSerial}),{stroke}),"Second")
				card:SetAttribute("SearchName",question.." "..answer)
				local hoverWash=AddThemeObject(SetProps(MakeElement("Frame"),{Name="HoverWash",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,Parent=card,ZIndex=0}),"Bloom")
				MakeElement("Corner",0,12).Parent=hoverWash
				local questionLabel=AddThemeObject(SetProps(MakeElement("Label",question,FAQConfig.QuestionSize),{Name="Question",Size=UDim2.new(1,-70,0,54),Position=UDim2.new(0,16,0,0),BackgroundTransparency=1,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,TextWrapped=true,ZIndex=2,Parent=card}),"Text")
				local answerLabel=AddThemeObject(SetProps(MakeElement("Label",answer,FAQConfig.AnswerSize),{Name="Answer",Size=UDim2.new(1,-32,0,0),Position=UDim2.new(0,16,0,54),BackgroundTransparency=1,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,TextWrapped=true,TextTransparency=1,RichText=ItemConfig.RichText==true or FAQConfig.RichText==true,ZIndex=2,Parent=card}),"TextDark")
				local indicator=AddThemeObject(Create("TextLabel",{Name="Indicator",Size=UDim2.new(0,34,0,34),Position=UDim2.new(1,-48,0,10),BackgroundTransparency=1,Text="+",TextSize=24,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Center,TextYAlignment=Enum.TextYAlignment.Center,Rotation=0,ZIndex=4,Parent=card}),"TextDark")
				local clicker=Create("TextButton",{Name="FAQButton",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,Text="",AutoButtonColor=false,Active=true,Selectable=true,ZIndex=5,Parent=card})
				local geometryToken=0
				local headerHeight=54
				local answerHeight=0
				local function computeGeometry(instant)
					geometryToken=geometryToken+1
					local width=math.max(card.AbsoluteSize.X,container.AbsoluteSize.X,280)
					headerHeight=math.max(54,measure(item.Question,FAQConfig.QuestionSize,Enum.Font.GothamBold,width-88)+22)
					answerHeight=math.max(18,measure(item.Answer,FAQConfig.AnswerSize,Enum.Font.Gotham,width-40)+4)
					questionLabel.Size=UDim2.new(1,-70,0,headerHeight)
					indicator.Position=UDim2.new(1,-48,0,math.floor((headerHeight-34)/2))
					answerLabel.Position=UDim2.new(0,16,0,headerHeight+1)
					answerLabel.Size=UDim2.new(1,-32,0,answerHeight)
					local target=item.Open and (headerHeight+answerHeight+18) or headerHeight
					if instant then
						card.Size=UDim2.new(1,0,0,target)
					else
						TweenService:Create(card,TweenInfo.new(FAQConfig.AnimationTime,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Size=UDim2.new(1,0,0,target)}):Play()
					end
					resizeContainer()
				end
				function item:SetOpen(state,instant)
					state=state==true
					if item.Open==state then return item end
					if state then closeOthers(item) end
					item.Open=state
					if state then FAQ.OpenIndex=item.Index elseif FAQ.OpenIndex==item.Index then FAQ.OpenIndex=nil end
					answerLabel.Visible=true
					computeGeometry(instant==true)
					local info=TweenInfo.new(FAQConfig.AnimationTime,Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
					TweenService:Create(indicator,info,{Rotation=state and 45 or 0}):Play()
					TweenService:Create(answerLabel,TweenInfo.new(math.max(0.1,FAQConfig.AnimationTime*0.75),Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=state and 0 or 1}):Play()
					TweenService:Create(hoverWash,info,{BackgroundTransparency=state and 0.9 or 1}):Play()
					if typeof(ItemConfig.OpenColor)=="Color3" and state then stroke.Color=ItemConfig.OpenColor end
					SafeCallback(ItemConfig.Callback or FAQConfig.Callback,FAQConfig.Name,item.Index,state,item,FAQ)
					return item
				end
				function item:OpenItem() return self:SetOpen(true) end
				function item:CloseItem() return self:SetOpen(false) end
				function item:Toggle() return self:SetOpen(not self.Open) end
				function item:Set(NewConfig)
					NewConfig=type(NewConfig)=="table" and NewConfig or {Question=tostring(NewConfig or item.Question)}
					if NewConfig.Question~=nil or NewConfig.Name~=nil then item.Question=tostring(NewConfig.Question or NewConfig.Name) questionLabel.Text=item.Question end
					if NewConfig.Answer~=nil or NewConfig.Content~=nil then item.Answer=tostring(NewConfig.Answer or NewConfig.Content) answerLabel.Text=item.Answer end
					card:SetAttribute("SearchName",item.Question.." "..item.Answer)
					computeGeometry(true)
					return item
				end
				function item:Destroy()
					if card then card:Destroy() end
					for i,data in ipairs(FAQ.Items) do if data==item then table.remove(FAQ.Items,i) break end end
					for i,data in ipairs(FAQ.Items) do data.Index=i end
					resizeContainer()
				end
				clicker.Activated:Connect(function() item:Toggle() end)
				clicker.MouseEnter:Connect(function()
					TweenService:Create(hoverWash,TweenInfo.new(0.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=item.Open and 0.88 or 0.94}):Play()
				end)
				clicker.MouseLeave:Connect(function()
					TweenService:Create(hoverWash,TweenInfo.new(0.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=item.Open and 0.9 or 1}):Play()
				end)
				local lastWidth=0
				AddConnection(card:GetPropertyChangedSignal("AbsoluteSize"),function()
					if WindowConfig._LocalRegisterState.resizeWorkPaused() then WindowConfig._LocalRegisterState.queueResizeFollowup(card,function() if card.Parent and WindowConfig._LocalRegisterState.isGuiBranchVisible(card) then computeGeometry(true) end end) return end
					if not WindowConfig._LocalRegisterState.isGuiBranchVisible(card) then return end
					local width=math.floor(card.AbsoluteSize.X+0.5)
					if width==lastWidth then return end
					lastWidth=width
					local token=geometryToken+1
					geometryToken=token
					task.delay(0.06,function()
						if token==geometryToken and card.Parent then computeGeometry(true) end
					end)
				end)
				item.Frame=card
				item.Wrapper=card
				table.insert(FAQ.Items,item)
				task.defer(function() if card.Parent then computeGeometry(true) end end)
				resizeContainer()
				return item
			end
