function XLQPGen1:_InstallPerformanceOptimizations(window)
if self._PerformanceOptimizationsInstalled then return end
self._PerformanceOptimizationsInstalled=true
self._AutoFitTextObjects=self._TextObjectRegistry or setmetatable({},{__mode="k"})
local cfg=self._WindowConfig or {}
if cfg.AutoResizeText~=nil or cfg.AutoTextResize~=nil or cfg.TextAutoResize~=nil or cfg.ResizeText~=nil then self.AutoResizeTextEnabled=cfg.AutoResizeText==true or cfg.AutoTextResize==true or cfg.TextAutoResize==true or cfg.ResizeText==true elseif self.AutoResizeTextEnabled==nil then self.AutoResizeTextEnabled=false end
function self:_RestoreAutoTextFit()
self._AutoTextFitGeneration=(self._AutoTextFitGeneration or 0)+1
local generation=self._AutoTextFitGeneration
task.spawn(function()
local count=0
for obj in pairs(self._AutoFitTextObjects or {}) do
if generation~=self._AutoTextFitGeneration then return end
if obj and obj.Parent then
local base=tonumber(obj:GetAttribute("VHBaseTextSize"))
if base and base>0 then pcall(function() obj.TextScaled=false obj.TextSize=base end) end
end
count+=1
if count%220==0 then task.wait() end
end
end)
end
function self:SetAutoResizeText(value)
self.AutoResizeTextEnabled=value==true
if self.AutoResizeTextEnabled then self:_QueueAutoTextFit(0.04) else self:_RestoreAutoTextFit() end
for _,refresh in ipairs(settingsSimpleToggleRefreshers or {}) do pcall(refresh) end
return self
end
self.SetAutoTextResize=self.SetAutoResizeText
self.SetTextAutoResize=self.SetAutoResizeText
function self:GetAutoResizeText() return self.AutoResizeTextEnabled==true end
function self:_ApplyAutoTextFit()
if self.AutoResizeTextEnabled~=true or Minimized==true or settingsMinimized==true or resizing or settingsResizing or self._LayoutSuspended then return end
self._AutoTextFitGeneration=(self._AutoTextFitGeneration or 0)+1
local generation=self._AutoTextFitGeneration
local root=MainWindow or self._ActiveMainWindow
if not root then return end
local baseW=(cfg.Size and cfg.Size.X.Offset>0 and cfg.Size.X.Offset) or 860
local baseH=(cfg.Size and cfg.Size.Y.Offset>0 and cfg.Size.Y.Offset) or 560
local scale=math.clamp(math.min(math.max(1,root.AbsoluteSize.X)/baseW,math.max(1,root.AbsoluteSize.Y)/baseH),0.62,1)
if self._LastAutoTextFitScale==scale then return end
self._LastAutoTextFitScale=scale
task.spawn(function()
local count=0
for obj in pairs(self._AutoFitTextObjects or {}) do
if generation~=self._AutoTextFitGeneration then return end
if obj and obj.Parent and obj:GetAttribute("VHNoAutoTextFit")~=true then
if obj:GetAttribute("VHBaseTextSize")==nil then pcall(function() obj:SetAttribute("VHBaseTextSize",obj.TextSize) end) end
local base=tonumber(obj:GetAttribute("VHBaseTextSize")) or obj.TextSize or 14
local size=math.clamp(math.floor(base*scale+0.5),8,base)
pcall(function() obj.TextScaled=false obj.TextSize=size end)
end
count+=1
if count%220==0 then task.wait() end
end
end)
end
function self:_QueueAutoTextFit(delayTime)
if self.AutoResizeTextEnabled~=true then return end
self._AutoTextFitRequest=(self._AutoTextFitRequest or 0)+1
local token=self._AutoTextFitRequest
task.delay(delayTime or 0.12,function()
if token~=self._AutoTextFitRequest or resizing or settingsResizing or self._LayoutSuspended then return end
self:_ApplyAutoTextFit()
end)
end
	local function watch(root)
	if not root or root:GetAttribute("XLQPPerformanceState") then return end
	root:SetAttribute("XLQPPerformanceState",true)
	registerPerformanceConnection(self,root.DescendantAdded:Connect(function(obj)
	XLQPApplyTextObject(obj)
	if XLQPIsTextObject(obj) and obj:GetAttribute("VHBaseTextSize")==nil then obj:SetAttribute("VHBaseTextSize",obj.TextSize) end
	end))
	task.defer(function()
		if not root.Parent then return end
		local processed=0
		for _,obj in ipairs(root:GetDescendants()) do
			XLQPApplyTextObject(obj)
			if XLQPIsTextObject(obj) and obj:GetAttribute("VHBaseTextSize")==nil then obj:SetAttribute("VHBaseTextSize",obj.TextSize) end
			processed+=1
			if processed%240==0 then task.wait() end
		end
	end)
	end
watch(MainWindow or self._ActiveMainWindow)
watch(SettingsWindow)
if self.AutoResizeTextEnabled then self:_QueueAutoTextFit(0.2) else self:_RestoreAutoTextFit() end
end


