function XLQPGen1:SaveConfigCloudProfile(profile)
	profile = type(profile) == "table" and profile or {}
	local name = tostring(profile.Name or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then return false, "Profile name is required." end
	local webhook = cleanConfigCloudWebhook(profile.Webhook)
	if webhook ~= "" and not isDiscordConfigCloudWebhook(webhook) then return false, "Enter a valid Discord webhook URL." end
	self.ConfigCloud.Profiles[name] = {
		Name = name,
		Description = tostring(profile.Description or ""),
		Tags = tostring(profile.Tags or ""),
		Webhook = webhook,
		Username = tostring(profile.Username or "XLQP Config Cloud"),
		UpdatedAt = os.time()
	}
	return configCloudSaveStore()
end

function XLQPGen1:DeleteConfigCloudProfile(name)
	name = tostring(name or "")
	self.ConfigCloud.Profiles[name] = nil
	for key, assigned in pairs(self.ConfigCloud.Assignments) do
		if assigned == name then self.ConfigCloud.Assignments[key] = nil end
	end
	return configCloudSaveStore()
end

function XLQPGen1:AssignConfigCloudProfile(elementKey, profileName)
	elementKey, profileName = tostring(elementKey or ""), tostring(profileName or "")
	if elementKey == "" then return false, "Element key is missing." end
	if profileName ~= "" and not self.ConfigCloud.Profiles[profileName] then return false, "Profile was not found." end
	self.ConfigCloud.Assignments[elementKey] = profileName ~= "" and profileName or nil
	for _, element in ipairs(self.ConfigCloud.Elements) do
		if element.ConfigCloudKey == elementKey then element.ConfigCloudProfile = profileName ~= "" and profileName or nil end
	end
	return configCloudSaveStore()
end

function XLQPGen1:SendConfigCloud(profileName, title, data, options)
	options = type(options) == "table" and options or {}
	local profile = self.ConfigCloud.Profiles[tostring(profileName or "")]
	if not profile then return false, "Choose a Config Cloud profile first." end
	local webhook = cleanConfigCloudWebhook(profile.Webhook)
	if webhook == "" then return false, "Add a Discord webhook URL to this profile first." end
	if not isDiscordConfigCloudWebhook(webhook) then return false, "That webhook URL is not a Discord webhook. It must look like https://discord.com/api/webhooks/ID/TOKEN" end
	local requester = configCloudRequester()
	if type(requester) ~= "function" then return false, "Your executor does not expose a request function." end
	if self.WhitelistLoggerUrl then pcall(function() self:WhitelistLoggerUrl(webhook) end) end
	local fields = {}
	if type(data) == "table" then
		for key, value in pairs(data) do
			local fieldValue = configCloudValueText(value):sub(1, 1024)
			fields[#fields + 1] = {name = tostring(key):sub(1, 256), value = fieldValue ~= "" and fieldValue or "—", inline = options.Inline == true}
			if #fields >= 25 then break end
		end
	else
		fields[1] = {name = "Value", value = configCloudValueText(data):sub(1, 1024), inline = false}
	end
	table.sort(fields, function(a, b) return a.name:lower() < b.name:lower() end)
	local payload = {
		username = tostring(options.Username or profile.Username or "XLQP Config Cloud"):sub(1, 80),
		embeds = {{
			title = tostring(title or "XLQP Stats"):sub(1, 256),
			description = tostring(options.Description or profile.Description or ""):sub(1, 4096),
			color = tonumber(options.Color) or 10051839,
			fields = fields,
			footer = {text = "XLQP Gen1 • " .. os.date("%I:%M %p")}
		}}
	}
	local encodeOk, body = pcall(function() return HttpService:JSONEncode(payload) end)
	if not encodeOk then return false, "Could not encode the webhook payload." end
	local ok, response = pcall(requester, {
		Url = webhook, Method = "POST",
		Headers = {["Content-Type"] = "application/json", ["User-Agent"] = "XLQPGen1"},
		Body = body
	})
	if not ok then return false, "Request blocked: " .. tostring(response) end
	if type(response) ~= "table" then return false, "Your executor returned no response for this request." end
	local code = tonumber(response.StatusCode or response.Status or response.status_code) or 0
	if code == 200 or code == 204 then return true, "Webhook sent." end
	local raw = tostring(response.Body or response.body or "")
	local detail = ""
	if raw ~= "" then
		local decodeOk, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if decodeOk and type(decoded) == "table" then
			detail = tostring(decoded.message or decoded.error or "")
		end
		if detail == "" then detail = raw:sub(1, 140) end
	end
	if code == 401 or code == 403 or code == 404 then
		return false, "Discord rejected the webhook (HTTP " .. tostring(code) .. "). It was deleted or the URL is wrong."
	end
	if code == 429 then return false, "Discord rate limited this webhook. Wait a moment and try again." end
	if code == 0 then return false, "No status returned. Your executor may be blocking Discord requests." end
	return false, "Discord returned HTTP " .. tostring(code) .. (detail ~= "" and (" — " .. detail) or ".")
end

local function configCloudRequest(method, path, payload)
	local requester = XLQPResolveRequest()
	if type(requester) ~= "function" then return nil, "Your executor does not support HTTP requests.", 0 end
	local base = tostring(XLQPGen1.ConfigCloud.PublicBaseUrl or ""):gsub("/+$", "")
	if base == "" then return nil, "The public Config Cloud endpoint is missing.", 0 end
	if XLQPGen1.WhitelistLoggerUrl then pcall(function() XLQPGen1:WhitelistLoggerUrl(base) end) end
	local requestData = {
		Url = base .. tostring(path or ""),
		Method = tostring(method or "GET"),
		Headers = {["Content-Type"] = "application/json",["Accept"] = "application/json"}
	}
	if payload ~= nil then requestData.Body = HttpService:JSONEncode(payload) end
	local ok, response = pcall(requester, requestData)
	if not ok then return nil, tostring(response), 0 end
	local code = tonumber(type(response) == "table" and (response.StatusCode or response.Status) or 0) or 0
	local raw = type(response) == "table" and tostring(response.Body or response.body or "") or ""
	local decoded = {}
	if raw ~= "" then
		local decodeOk, result = pcall(HttpService.JSONDecode, HttpService, raw)
		if decodeOk and type(result) == "table" then decoded = result end
	end
	if code < 200 or code >= 300 then
		local message=tostring(decoded.error or decoded.message or "")
		if code == 429 then
			message="You are out of tokens to upload. Delete one of your public configs to free a token."
		elseif message=="" then
			local lower=raw:lower()
			if lower:find("<!doctype html",1,true) or lower:find("<html",1,true) or lower:find("this page could not be found",1,true) then
				message=code==404 and "Config Cloud API route not found." or ("Config Cloud HTTP "..tostring(code)..".")
			else
				message=raw:gsub("<[^>]->"," "):gsub("%s+"," "):match("^%s*(.-)%s*$")
				if #message>220 then message=message:sub(1,220).."..." end
			end
		end
		if message=="" then message="Config Cloud HTTP "..tostring(code).."." end
		return nil,message,code
	end
	return decoded,nil,code
end

local configCloudBase64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function configCloudBase64Encode(value)
	local data = tostring(value or "")
	return ((data:gsub(".", function(character)
		local byte = string.byte(character)
		local bits = ""
		for index = 8, 1, -1 do
			bits = bits .. ((byte % 2 ^ index - byte % 2 ^ (index - 1) > 0) and "1" or "0")
		end
		return bits
	end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(chunk)
		if #chunk < 6 then return "" end
		local number = 0
		for index = 1, 6 do
			if chunk:sub(index, index) == "1" then number += 2 ^ (6 - index) end
		end
		return configCloudBase64Alphabet:sub(number + 1, number + 1)
	end) .. ({"", "==", "="})[#data % 3 + 1])
end

function configCloudBase64Decode(value)
	local data = tostring(value or ""):gsub("%s+", ""):gsub("[^" .. configCloudBase64Alphabet .. "=]", "")
	return (data:gsub(".", function(character)
		if character == "=" then return "" end
		local position = configCloudBase64Alphabet:find(character, 1, true)
		if not position then return "" end
		local number = position - 1
		local bits = ""
		for index = 6, 1, -1 do
			bits = bits .. ((number % 2 ^ index - number % 2 ^ (index - 1) > 0) and "1" or "0")
		end
		return bits
	end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(chunk)
		if #chunk ~= 8 then return "" end
		local number = 0
		for index = 1, 8 do
			if chunk:sub(index, index) == "1" then number += 2 ^ (8 - index) end
		end
		return string.char(number)
	end))
end

function configCloudPublicItemMatches(item, query)
	query = tostring(query or ""):lower()
	if query == "" then return true end
	local text = table.concat({
		tostring(item.config_name or item.name or item.title or ""),
		tostring(item.username or item.user_name or ""),
		tostring(item.display_name or item.displayName or ""),
		tostring(item.game_name or item.gameName or ""),
		tostring(item.tags or "")
	}, " "):lower()
	return text:find(query, 1, true) ~= nil
end

local function configCloudPublicSafeValue(value, seen)
	local valueType = typeof and typeof(value) or type(value)
	if valueType == "Color3" then return {__type="Color3",R=value.R,G=value.G,B=value.B} end
	if valueType == "Vector2" then return {__type="Vector2",X=value.X,Y=value.Y} end
	if valueType == "Vector3" then return {__type="Vector3",X=value.X,Y=value.Y,Z=value.Z} end
	if valueType == "UDim" then return {__type="UDim",Scale=value.Scale,Offset=value.Offset} end
	if valueType == "UDim2" then return {__type="UDim2",XS=value.X.Scale,XO=value.X.Offset,YS=value.Y.Scale,YO=value.Y.Offset} end
	if valueType == "EnumItem" then return {__type="EnumItem",Value=tostring(value)} end
	if type(value) == "string" then
		local lower = value:lower()
		if lower:find("discord.com/api/webhooks/",1,true) or lower:find("discordapp.com/api/webhooks/",1,true) then return nil end
	end
	if type(value) ~= "table" then return value end
	seen = seen or {}
	if seen[value] then return nil end
	seen[value] = true
	local safe = {}
	for key, nested in pairs(value) do
		local keyText = tostring(key)
		if not keyText:lower():find("webhook",1,true) then
			local cleaned = configCloudPublicSafeValue(nested, seen)
			if cleaned ~= nil then safe[type(key)=="number" and key or keyText] = cleaned end
		end
	end
	seen[value] = nil
	return safe
end

