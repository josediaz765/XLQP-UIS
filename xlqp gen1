			local delBtn=SetChildren(SetProps(MakeElement("Button"),{Size=UDim2.new(0,22,0,22),Position=UDim2.new(1,-26,0.5,-11),BackgroundTransparency=1}),{SetProps(MakeElement("Image",GetIcon("x") or "rbxassetid://7072725342"),{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0.5,0,0.5,0),Size=UDim2.new(0,14,0,14),ImageColor3=Color3.fromRGB(230,90,90)})})
			local rowStroke=AddThemeObject(SetProps(MakeElement("Stroke"),{Transparency=0.75}),"Stroke")
			local rowFrame=AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame",Color3.fromRGB(255,255,255),0,6),{Size=UDim2.new(1,0,0,32),BackgroundTransparency=0.35,LayoutOrder=index}),{nameLabel,execBtn,delBtn,rowStroke}),"Second")
			rowFrame.Parent=PluginsListScroll
			local row={Frame=rowFrame,Record=record,Stroke=rowStroke}
			table.insert(pluginRows,row)
			AddConnection(rowFrame.MouseEnter,function()
				if PluginsData.Selected~=record then TweenService:Create(rowFrame,TweenInfo.new(0.12),{BackgroundTransparency=0.2}):Play() end
			end)
			AddConnection(rowFrame.MouseLeave,function()
				if PluginsData.Selected~=record then TweenService:Create(rowFrame,TweenInfo.new(0.16),{BackgroundTransparency=0.35}):Play() end
			end)
			AddConnection(rowFrame.InputBegan,function(inp)
				if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
					selectPluginRecord(record)
				end
			end)
			AddConnection(execBtn.MouseButton1Click,function()
				selectPluginRecord(record)
				local ok,err=PluginsData:Execute(record)
				if ok then pluginsNotify("Plugin executed",record.Name) else pluginsNotify("Plugin error",tostring(err)) end
			end)
			AddConnection(delBtn.MouseButton1Click,function()
				local ok,err=PluginsData:Delete(record)
				if ok then
					pluginsNotify("Plugin deleted",record.Name)
					refreshPluginsList()
				else
					pluginsNotify("Delete failed",tostring(err))
				end
			end)
		end
		if PluginsData.Selected then
			local stillExists=false
			for _,record in ipairs(PluginsData.Items) do
				if record==PluginsData.Selected then stillExists=true break end
			end
			if not stillExists then selectPluginRecord(nil) end
		end
		raisePluginsZIndex()
	end

