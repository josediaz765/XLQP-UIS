	local function changePage(targetPage,direction)
		if transitioning or finished or targetPage<1 or targetPage>5 then return end
		transitioning=true
		local outX=(direction or 1)*-18
		local outTween=TweenService:Create(content,TweenInfo.new(0.13,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.new(0,outX,0,46)})
		outTween:Play()
		outTween.Completed:Connect(function()
			if finished then transitioning=false return end
			currentPage=targetPage
			renderPage()
			content.Position=UDim2.new(0,-outX,0,46)
			local inTween=TweenService:Create(content,TweenInfo.new(0.24,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,0,46)})
			inTween:Play()
			inTween.Completed:Connect(function() transitioning=false end)
		end)
