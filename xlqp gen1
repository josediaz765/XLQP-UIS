		local function getPrompts(config)
			local messagesConfig = config.messages
			local promptsList = {}

			
			if type(messagesConfig) == "table" then
				
				for _, text in ipairs(messagesConfig) do
					if type(text) == "string" then
						table.insert(promptsList, {Label = AnimatedTextLabel, Text = text, Speed = 0.06})
					end
				end
			elseif type(messagesConfig) == "string" and messagesConfig:lower() ~= "default" then
				
				
				table.insert(promptsList, {Label = AnimatedTextLabel, Text = messagesConfig, Speed = 0.06})
				for _, text in ipairs(config) do
					if type(text) == "string" then
						table.insert(promptsList, {Label = AnimatedTextLabel, Text = text, Speed = 0.06})
					end
				end
			end

			
			local useDefault = (messagesConfig == nil or messagesConfig == true or (type(messagesConfig) == "string" and messagesConfig:lower() == "default"))
			if #promptsList == 0 and useDefault then
				promptsList = {
					{Label = AnimatedTextLabel, Text = "Add some elements to get started", Speed = 0.06},
					{Label = AnimatedTextLabel, Text = "Made by Verbal Hub with love ❤️", Speed = 0.05}
				}
			end

			
			if config.Discord == true then
				local link = config.DiscordLink or ""
				table.insert(promptsList, {Label = DiscordLabel, Text = "Join " .. link, Speed = 0.06})
			end

			return promptsList
		end

		local prompts = getPrompts(tabConfig)
		if XLQPGen1._ReduceLagEnabled then
			local prompt = prompts[1]
			if prompt and prompt.Label and prompt.Label.Parent then
				prompt.Label.Text = tostring(prompt.Text or "")
				prompt.Label.TextTransparency = 0
				if prompt.Label == DiscordLabel then
					DiscordLabel.Visible = true
					CopyButton.Visible = true
				end
			end
			return
		end

		while EmptyState and EmptyState.Parent do
			local visibilityCheck = WindowConfig._LocalRegisterState.isGuiBranchVisible
			if type(visibilityCheck) == "function" and not visibilityCheck(EmptyState) then
				task.wait(0.5)
				continue
			end
			for _, prompt in ipairs(prompts) do
				if not EmptyState or not EmptyState.Parent then break end
				
				if prompt.Label == DiscordLabel then
					DiscordLabel.Visible = true
					CopyButton.Visible = true
					ts:Create(DiscordLabel, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {TextTransparency = 0.4}):Play()
					ts:Create(CopyButton, TweenInfo.new(0.8, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {BackgroundTransparency = 0.9}):Play()
					ts:Create(CopyButton.Title, TweenInfo.new(0.8, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {TextTransparency = 0.4}):Play()
				end
				
				if showFlameEffects then manageFireEffect(prompt.Label, true) end
				typeText(prompt.Label, prompt.Text, prompt.Speed)
				if showFlameEffects then manageFireEffect(prompt.Label, false) end
				if showFlameEffects and showFlameCover then startInfernoEffect() end
				
				task.wait(3.5)
				
				local fadeOutDuration = 0.8
				local fadeOutInfo = TweenInfo.new(fadeOutDuration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

				if showFlameEffects and showFlameCover then stopInfernoEffect(fadeOutDuration) end

				if prompt.Label == DiscordLabel then
					if DiscordLabel and DiscordLabel.Parent then
						ts:Create(DiscordLabel, fadeOutInfo, {TextTransparency = 1}):Play()
					end
					if CopyButton and CopyButton.Parent then
						ts:Create(CopyButton, fadeOutInfo, {BackgroundTransparency = 1}):Play()
						if CopyButton.Title then
							ts:Create(CopyButton.Title, fadeOutInfo, {TextTransparency = 1}):Play()
						end
					end
				else
					if prompt.Label and prompt.Label.Parent then
						ts:Create(prompt.Label, fadeOutInfo, {TextTransparency = 1}):Play()
					end
				end

				task.wait(fadeOutDuration)

				if prompt.Label == DiscordLabel then
					if DiscordLabel then DiscordLabel.Visible = false end
					if CopyButton then CopyButton.Visible = false end
				end
				
				if prompt.Label and prompt.Label.Parent then
					prompt.Label.Text = ""
					prompt.Label.TextTransparency = 1
				end
				
				task.wait(0.5)
			end
			task.wait(1)
		end
	end)

	return EmptyState
end
function TabFunction:newmaketabtop(TabConfig)
	TabConfig = TabConfig or {}
	TabConfig.Name = TabConfig.Name or "Top Tab"
	if not XLQPGen1:_ResolveLock(TabConfig) then
		local lockedTop = {LockedOut = true, Name = TabConfig.Name, Tab = false, Button = false, Container = false, Elements = false, Wrapper = false}
		setmetatable(lockedTop, {__index = function(_, key)
			if type(key) ~= "string" then return nil end
			return function() return lockedTop end
		end})
		return lockedTop
	end
	local isMultiTab = TabConfig.MultiTab or false
	
	local isMobile = game:GetService("UserInputService").TouchEnabled and not game:GetService("UserInputService").KeyboardEnabled
	
	if isMobile and TopTabHolder and TopTabHolder:FindFirstChildOfClass("UIListLayout") then
		local layout = TopTabHolder:FindFirstChildOfClass("UIListLayout")
		layout.Padding = UDim.new(0, 8)
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.SortOrder = Enum.SortOrder.LayoutOrder
	end
	
	local paddingX = isMobile and 12 or 8
	local paddingY = isMobile and 6 or 0
	
	local TopButton = AddThemeObject(SetChildren(SetProps(MakeElement("Button"), {
		Size = UDim2.new(0, 0, 1, -6),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = TopTabHolder,
		BackgroundTransparency = 1,
		ZIndex = 10,
		Active = true,
	}), {
		AddThemeObject(MakeElement("Stroke"),"Stroke"),
		MakeElement("Corner", 0, 5),
		Create("UIPadding", {
			PaddingLeft = UDim.new(0, paddingX),
			PaddingRight = UDim.new(0, paddingX),
			PaddingTop = UDim.new(0, paddingY),
			PaddingBottom = UDim.new(0, paddingY)
		}),
		AddThemeObject(SetProps(MakeElement("Label", TabConfig.Name, isMobile and 11 or 14), {
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = Enum.Font.GothamSemibold,
			Name = "Title",
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false
		}), "TextDark")
	}), "Second")
	TopButton:SetAttribute("NoLiquidGlass", true)
	if TopButton:FindFirstChild("Title") then pcall(function() TopButton.Title.FontFace=Font.fromEnum(Enum.Font.GothamSemibold) end) end
	for _,child in ipairs(TopButton:GetChildren()) do
		if child:IsA("UIStroke") then
			child.Name="TopTabSelectionStroke"
			child.Enabled=false
			child.Transparency=1
		end
	end
	ensureTopTabSelectionStroke(TopButton)
	ensureTopTabActiveLine(TopButton)
	
	MakeShineOnHover(TopButton, TopButton.Title)
	if newUIEnabled and styleNewUITopTabs then
		task.defer(styleNewUITopTabs)
	end
	
	local topTabInfo = {
		Button = TopButton,
		Name = TabConfig.Name,
		SideTabs = {},
		SideGroups = {},
		IsMultiTab = isMultiTab,
		Container = nil,
		Config = TabConfig,
		OnSelect = CreateXLQPSignal()
	}
	if type(TabConfig.OnSelect) == "function" then topTabInfo.OnSelect:Connect(TabConfig.OnSelect) end
	function topTabInfo:Select(bypass) SelectTopTab(self,false,bypass==true) return self end
	
	if not isMultiTab then
		local directInset=isMobile and 10 or 14
		local containerSize = UDim2.new(1, -(directInset*2), 1, -95-directInset)
		local containerPos = UDim2.new(0, directInset, 0, 95)
		
		topTabInfo.Container = AddThemeObject(SetChildren(SetProps(MakeElement("ScrollFrame", nil, 5), {
			Size = containerSize,
			Position = containerPos,
			Parent = MainWindow,
			Visible = false,
			Name = "ItemContainer_Direct",
			ScrollBarThickness = isMobile and 5 or 3,
			VerticalScrollBarInset = Enum.ScrollBarInset.None,
			ScrollBarImageTransparency = 1,
			ZIndex = 1,
			Active = true,
			ScrollingEnabled = true,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			ScrollBarImageTransparency = isMobile and 0.3 or 0.5,
		}), {
			MakeElement("List", 0, 6),
			MakeElement("Padding", isMobile and 10 or 15, 10, 10, isMobile and 10 or 15)
		}), "Divider")
		topTabInfo.Container:SetAttribute("TopTabName", tostring(TabConfig.Name or ""))
		topTabInfo.Container:SetAttribute("SideTabName", "")
		topTabInfo.Container:SetAttribute("ProtectedMoveDrop", tostring(TabConfig.Name or ""):lower() == "home" or tostring(TabConfig.Name or ""):lower() == "script hub" or tostring(TabConfig.Name or ""):lower() == "scripthub")
		
		XLQPGen1:_BindScrollCanvas(topTabInfo.Container, 30)
		applyMainSidebarLayout(false)
		
		local emptyState = createEmptyState(topTabInfo.Container, topTabInfo.Config)
		AddConnection(topTabInfo.Container.ChildAdded, function(child)
			if child ~= emptyState and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
				emptyState.Visible = false
			end
		end)
	end
	
	table.insert(AllTopTabObjects, topTabInfo)
	if isMultiTab then
		currentTopTabForCreation = topTabInfo
	end
	
	AddConnection(TopButton.Activated, function()
		SelectTopTab(topTabInfo)
	end)
	
	if not activeTopTabObject and TabConfig.AutoSelect~=false and TabConfig.SelectOnCreate~=false then
		SelectTopTab(topTabInfo,false,true)
	end
	
	if not isMultiTab then
		local elements=GetElements(topTabInfo.Container)
		topTabInfo.Elements=elements
		for _,methodName in ipairs({"AddToggle","AddSlider","AddDropdown","AddTextbox","AddInput","AddButton","AddLabel","AddParagraph","AddColorpicker","AddColorPicker","AddKeybind","AddKeyPicker","AddBind","AddLeftGroupbox","AddRightGroupbox"}) do
			local name=methodName
			if type(topTabInfo[name])~="function" then
				topTabInfo[name]=function(self,...)
					local method=elements and elements[name]
					if type(method)=="function" then return method(elements,...) end
					return nil
				end
			end
		end
		elements.OnSelect=topTabInfo.OnSelect
		elements.Tab=topTabInfo
		function elements:Select(bypass) SelectTopTab(topTabInfo,false,bypass==true) return self end
		return elements
	else
		local function resolveCompatElements()
			if topTabInfo._CompatElements then return topTabInfo._CompatElements end
			local first=topTabInfo.SideTabs and topTabInfo.SideTabs[1]
			if first and first.Container then
				topTabInfo._CompatElements=GetElements(first.Container)
				return topTabInfo._CompatElements
			end
			local created=TabFunction:MakeTab({Name=topTabInfo.Name or "Main",Icon=TabConfig.Icon or "layout-grid",ParentTopTab=topTabInfo,AutoSelect=true})
			topTabInfo._CompatElements=created
			return created
		end
		for _,methodName in ipairs({"AddToggle","AddSlider","AddDropdown","AddTextbox","AddInput","AddButton","AddLabel","AddParagraph","AddColorpicker","AddKeybind","AddKeyPicker","AddLeftGroupbox","AddRightGroupbox"}) do
			if topTabInfo[methodName]==nil then
				topTabInfo[methodName]=function(self,...)
					local elements=resolveCompatElements()
					local method=elements and elements[methodName]
					if type(method)=="function" then return method(elements,...) end
					return nil
				end
			end
		end
		return topTabInfo
	end
end


