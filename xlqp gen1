	local function getRenderedLogoHeight(sideFrame, logo)
		if not sideFrame or not logo or not logo.Visible then return 0 end
		local fallback = math.max(48, logo.Size.Y.Offset)
		local sideTop = sideFrame.AbsolutePosition.Y
		local renderedBottom = logo.AbsolutePosition.Y + logo.AbsoluteSize.Y - sideTop
		if renderedBottom > 0 then fallback = math.max(fallback, renderedBottom) end
		for _, gui in ipairs(logo:GetDescendants()) do
			if gui:IsA("GuiObject") and gui.Visible then
				local bottom = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y - sideTop
				if bottom > 0 and bottom <= math.max(sideFrame.AbsoluteSize.Y, fallback + 160) then
					fallback = math.max(fallback, bottom)
				end
			end
		end
		return math.ceil(fallback)
	end

    local function setTabListDockDecorations(sideFrame, detached)
        if not sideFrame then return end
        for _, name in ipairs({"DockTopFill", "DockRightFill", "DockDivider"}) do
            local decoration = sideFrame:FindFirstChild(name)
            if decoration and decoration:IsA("GuiObject") then decoration.Visible = not detached end
        end
        sideFrame.ClipsDescendants = true
        local corner = sideFrame:FindFirstChildOfClass("UICorner")
        if not corner then corner = XLQPCreateCorner(sideFrame, tonumber(config.SidebarCornerRadius) or 14) end
        local radius = tonumber(config.SidebarCornerRadius)
            or tonumber(config.NewUICornerRadius)
            or tonumber(config.CornerRadius)
            or 14
        radius=math.clamp(radius,0,32)
        corner.CornerRadius = UDim.new(0,radius)
		for _,imageName in ipairs({"XLQPTabListBackground","XLQPDetachedTabListBackground"}) do
			local backgroundImage=sideFrame:FindFirstChild(imageName)
			if backgroundImage and backgroundImage:IsA("ImageLabel") then
				backgroundImage.Size=UDim2.fromScale(1,1)
				backgroundImage.Position=UDim2.fromScale(0,0)
				backgroundImage.ClipsDescendants=true
				local imageCorner=backgroundImage:FindFirstChild("XLQPBackgroundCorner") or backgroundImage:FindFirstChildOfClass("UICorner")
				if not imageCorner then imageCorner=Create("UICorner",{Name="XLQPBackgroundCorner",Parent=backgroundImage}) end
				imageCorner.CornerRadius=UDim.new(0,radius)
			end
		end
		local headerShield = sideFrame:FindFirstChild("XLQPTabListHeaderShield")
		if headerShield then
			local headerCorner = headerShield:FindFirstChild("XLQPHeaderCorner") or Instance.new("UICorner")
			headerCorner.Name = "XLQPHeaderCorner"
			headerCorner.CornerRadius = corner.CornerRadius
			headerCorner.Parent = headerShield
			local bottomFill = sideFrame:FindFirstChild("XLQPTabListHeaderBottomFill")
			if bottomFill then
				local fillHeight = math.max(2, math.clamp(radius, 0, 32))
				bottomFill.Position = UDim2.new(0, 0, 0, math.max(0, headerShield.Size.Y.Offset - fillHeight))
				bottomFill.Size = UDim2.new(1, 0, 0, fillHeight)
			end
		end
        local stroke = sideFrame:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.LineJoinMode = Enum.LineJoinMode.Round
        end
    end

    local function fitLogoLabel(label, baseSize, room)
        if not label then return baseSize end
        local size = math.clamp(math.floor(tonumber(baseSize) or 14), 9, 40)
        room = math.max(24, math.floor(room or 24))
        local text = tostring(label.Text or "")
        if text == "" then return size end
        while size > 9 do
            local ok, measured = pcall(function()
                return TextService:GetTextSize(text, size, label.Font, Vector2.new(10000, 10000))
            end)
            if not ok or measured.X <= room then break end
            size -= 1
        end
        label.TextSize = size
        label.TextTruncate = Enum.TextTruncate.AtEnd
        return size
    end

    local function layoutTabListLogo(logoButton, widthHint)
        if not logoButton or not logoButton.Parent then return end
        local image = logoButton:FindFirstChild("LogoImage")
        local title = logoButton:FindFirstChild("LogoText")
        local subtitle = logoButton:FindFirstChild("LogoSubtitle")
        local host = logoButton.Parent
        local width = tonumber(widthHint)
        if not width or width <= 0 then width = host and host.AbsoluteSize.X or 0 end
        if width <= 0 then width = logoButton.AbsoluteSize.X end
        if width <= 0 then width = math.clamp(tonumber(config.SidebarWidth) or 168, 112, 300) end
        local collapsedWidth = math.clamp(tonumber(config.SidebarCollapsedWidth) or 76, 64, 104)
        local compactBreakpoint=tonumber(config.SidebarCompactBreakpoint) or 132
        local collapsed = width < math.max(compactBreakpoint, collapsedWidth + 44) or config.ShowTabInfo == false
        local horizontal = logoButton:GetAttribute("XLQPLogoHorizontal") == true
        local paddingLeft = math.clamp(tonumber(logoButton:GetAttribute("XLQPLogoPaddingLeft")) or 14, 4, 40)
        local baseImageSize = math.clamp(tonumber(logoButton:GetAttribute("XLQPLogoImageSize")) or 42, 14, 96)
        local baseTitleSize = math.clamp(tonumber(logoButton:GetAttribute("XLQPLogoTextSize")) or 14, 9, 40)
        local baseSubtitleSize = math.clamp(tonumber(logoButton:GetAttribute("XLQPLogoSubtitleSize")) or 10, 8, 30)
        local expandedHeight = tonumber(logoButton:GetAttribute("XLQPExpandedHeight")) or math.max(64, logoButton.Size.Y.Offset)
        local showText = not collapsed and title ~= nil
        if title then title.Visible = showText end
        if subtitle then subtitle.Visible = showText end
        if not showText then
            local height = collapsed and math.max(56, math.min(64, expandedHeight)) or expandedHeight
            logoButton.Size = UDim2.new(1, 0, 0, height)
            logoButton.ClipsDescendants = true
            if image then
                local size = math.clamp(math.min(baseImageSize, height - 12, width - 20), 14, 96)
                image.Size = UDim2.fromOffset(size, size)
                image.AnchorPoint = Vector2.new(0.5, 0.5)
                image.Position = UDim2.new(0.5, 0, 0.5, 0)
            end
            return
        end
        local imageSize = math.clamp(math.min(baseImageSize, expandedHeight - 12), 14, 96)
        local textRoom = width - (paddingLeft + imageSize + 10) - 10
        local stacked = not horizontal or textRoom < 62
        if stacked then
            local titleSize = fitLogoLabel(title, baseTitleSize, width - 16)
            local subtitleSize = subtitle and fitLogoLabel(subtitle, baseSubtitleSize, width - 16) or 0
            local titleHeight = math.max(14, titleSize + 6)
            local subtitleHeight = subtitle and math.max(11, subtitleSize + 4) or 0
            local textHeight = titleHeight + subtitleHeight
            imageSize = math.clamp(math.min(baseImageSize, width - 24), 14, 96)
            local height = math.clamp(math.max(expandedHeight, imageSize + textHeight + 22), 48, 190)
            logoButton.Size = UDim2.new(1, 0, 0, height)
            logoButton.ClipsDescendants = true
            local textTop = math.max(0, height - 6 - textHeight)
            title.Position = UDim2.new(0, 8, 0, textTop)
            title.Size = UDim2.new(1, -16, 0, titleHeight)
            title.TextXAlignment = Enum.TextXAlignment.Center
            if subtitle then
                subtitle.Position = UDim2.new(0, 8, 0, textTop + titleHeight)
                subtitle.Size = UDim2.new(1, -16, 0, subtitleHeight)
                subtitle.TextXAlignment = Enum.TextXAlignment.Center
            end
            if image then
                local area = math.max(18, textTop - 2)
                local size = math.clamp(math.min(imageSize, area - 8), 14, 96)
                image.Size = UDim2.fromOffset(size, size)
                image.AnchorPoint = Vector2.new(0.5, 0.5)
                image.Position = UDim2.new(0.5, 0, 0, math.floor(area / 2) + 2)
            end
            return
        end
        local titleSize = fitLogoLabel(title, baseTitleSize, textRoom)
        local subtitleSize = subtitle and fitLogoLabel(subtitle, baseSubtitleSize, textRoom) or 0
        local titleHeight = math.max(14, titleSize + 6)
        local subtitleHeight = subtitle and math.max(11, subtitleSize + 4) or 0
        local textHeight = titleHeight + subtitleHeight
        local height = math.clamp(math.max(expandedHeight, imageSize + 12, textHeight + 16), 48, 190)
        logoButton.Size = UDim2.new(1, 0, 0, height)
        logoButton.ClipsDescendants = true
        local textLeft = paddingLeft + imageSize + 10
        local textTop = math.max(2, math.floor((height - textHeight) / 2))
        if image then
            image.Size = UDim2.fromOffset(imageSize, imageSize)
            image.AnchorPoint = Vector2.new(0, 0.5)
            image.Position = UDim2.new(0, paddingLeft, 0.5, 0)
        end
        title.Position = UDim2.new(0, textLeft, 0, textTop)
        title.Size = UDim2.new(1, -(textLeft + 10), 0, titleHeight)
        title.TextXAlignment = Enum.TextXAlignment.Left
        if subtitle then
            subtitle.Position = UDim2.new(0, textLeft, 0, textTop + titleHeight)
            subtitle.Size = UDim2.new(1, -(textLeft + 10), 0, subtitleHeight)
            subtitle.TextXAlignment = Enum.TextXAlignment.Left
        end
    end

    local function createTabListLogo(logoConfig)
        local mainWindow, sideFrame, holder = getTabListObjects()
        if not mainWindow or not sideFrame or not holder then return nil end
        local existing = sideFrame:FindFirstChild("XLQPTabListLogo") or sideFrame:FindFirstChild("XLQPSidebarLogo")
        if existing then existing:Destroy() end
        if logoConfig == nil or logoConfig == false then
            local shield = sideFrame:FindFirstChild("XLQPTabListHeaderShield")
            if shield then shield:Destroy() end
			local bottomFill = sideFrame:FindFirstChild("XLQPTabListHeaderBottomFill")
			if bottomFill then bottomFill:Destroy() end
            local profile = sideFrame:FindFirstChild("ProfileBar")
            local profileHeight = profile and profile.Visible and 50 or 0
            holder.Position = UDim2.new(0, 0, 0, 0)
            holder.Size = UDim2.new(1, 0, 1, -profileHeight)
            return nil
        end
        if type(logoConfig) ~= "table" then logoConfig = {Image = logoConfig} end
        local imageSize = math.clamp(tonumber(logoConfig.Size) or 42, 24, 72)
        local hasText = logoConfig.Text ~= nil and tostring(logoConfig.Text) ~= ""
        local horizontal = tostring(logoConfig.Layout or (hasText and "Horizontal" or "Centered")):lower() == "horizontal"
        local titleHeight = math.max(16, math.ceil((tonumber(logoConfig.TextSize) or 14) + 6))
        local subtitleHeight = logoConfig.Subtitle and math.max(12, math.ceil((tonumber(logoConfig.SubtitleSize) or 10) + 4)) or 0
        local stackedMinimum = (hasText and not horizontal) and (imageSize + titleHeight + subtitleHeight + 22) or (imageSize + 24)
        local logoHeight = math.clamp(math.max(tonumber(logoConfig.Height) or 78, stackedMinimum), 48, 176)
        local headerGap = math.clamp(tonumber(logoConfig.TabGap or logoConfig.HeaderGap) or 14, 8, 32)
        local headerShield = sideFrame:FindFirstChild("XLQPTabListHeaderShield")
        if not headerShield then
            headerShield = Instance.new("Frame")
            headerShield.Name = "XLQPTabListHeaderShield"
            headerShield.BorderSizePixel = 0
            headerShield.Parent = sideFrame
        end
        headerShield.Position = UDim2.fromOffset(0, 0)
        headerShield.Size = UDim2.new(1, 0, 0, logoHeight + headerGap)
        headerShield.BackgroundColor3 = sideFrame.BackgroundColor3
        headerShield.BackgroundTransparency = sideFrame.BackgroundTransparency
        headerShield.ZIndex = sideFrame.ZIndex + 240
		headerShield.ClipsDescendants = true
        headerShield.Visible = true
		local headerCorner = headerShield:FindFirstChild("XLQPHeaderCorner") or Instance.new("UICorner")
		headerCorner.Name = "XLQPHeaderCorner"
		headerCorner.CornerRadius = UDim.new(0, math.clamp(tonumber(config.SidebarCornerRadius) or 14, 0, 32))
		headerCorner.Parent = headerShield
		local headerBottomFill = sideFrame:FindFirstChild("XLQPTabListHeaderBottomFill") or Instance.new("Frame")
		headerBottomFill.Name = "XLQPTabListHeaderBottomFill"
		headerBottomFill.BorderSizePixel = 0
		headerBottomFill.BackgroundColor3 = headerShield.BackgroundColor3
		headerBottomFill.BackgroundTransparency = headerShield.BackgroundTransparency
		headerBottomFill.Position = UDim2.new(0, 0, 0, math.max(0, logoHeight + headerGap - 14))
		headerBottomFill.Size = UDim2.new(1, 0, 0, 14)
		headerBottomFill.ZIndex = headerShield.ZIndex
		headerBottomFill.Parent = sideFrame
        local logoButton = Instance.new("TextButton")
        logoButton.Name = "XLQPTabListLogo"
        logoButton.Text = ""
        logoButton.AutoButtonColor = false
        logoButton.BackgroundTransparency = 1
        logoButton.Size = UDim2.new(1, 0, 0, logoHeight)
        logoButton.Position = UDim2.new(0, 0, 0, 0)
        logoButton.ZIndex = headerShield.ZIndex + 1
        logoButton.ClipsDescendants = true
        logoButton:SetAttribute("XLQPHeaderGap", headerGap)
        logoButton:SetAttribute("XLQPExpandedHeight", logoHeight)
        logoButton:SetAttribute("XLQPLogoHorizontal", horizontal)
        logoButton:SetAttribute("XLQPLogoHasText", hasText)
        logoButton:SetAttribute("XLQPLogoImageSize", imageSize)
        logoButton:SetAttribute("XLQPLogoTextSize", tonumber(logoConfig.TextSize) or 14)
        logoButton:SetAttribute("XLQPLogoSubtitleSize", tonumber(logoConfig.SubtitleSize) or 10)
        logoButton:SetAttribute("XLQPLogoPaddingLeft", tonumber(logoConfig.PaddingLeft) or 14)
        logoButton.Parent = sideFrame

        local image = Instance.new("ImageLabel")
        image.Name = "LogoImage"
        image.BackgroundTransparency = 1
        image.Size = UDim2.fromOffset(imageSize, imageSize)
        image.ScaleType = Enum.ScaleType.Fit
        XLQPAssignProperty(image, "Image", XLQPResolveAsset(logoConfig.Image or logoConfig.Icon or config.Icon or "home"))
        image.ImageColor3 = logoConfig.Color or Color3.fromRGB(245, 245, 250)
        image.ZIndex = logoButton.ZIndex + 1
        image.Parent = logoButton

        if hasText then
            local textLeft = horizontal and ((tonumber(logoConfig.PaddingLeft) or 14) + imageSize + 10) or 8
            local title = Instance.new("TextLabel")
            title.Name = "LogoText"
            title.BackgroundTransparency = 1
            title.Position = horizontal and UDim2.new(0, textLeft, 0, 14) or UDim2.new(0, 8, 1, -31)
            title.Size = horizontal and UDim2.new(1, -(textLeft + 10), 0, 24) or UDim2.new(1, -16, 0, 20)
            title.Font = Enum.Font.GothamBold
            title.Text = tostring(logoConfig.Text)
            title.TextColor3 = logoConfig.TextColor or Color3.fromRGB(238, 238, 244)
            title.TextSize = tonumber(logoConfig.TextSize) or 14
            title.TextXAlignment = horizontal and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
            title.TextTruncate = Enum.TextTruncate.AtEnd
            title.ZIndex = logoButton.ZIndex + 1
            title.Parent = logoButton

            if logoConfig.Subtitle then
                local subtitle = Instance.new("TextLabel")
                subtitle.Name = "LogoSubtitle"
                subtitle.BackgroundTransparency = 1
                subtitle.Position = horizontal and UDim2.new(0, textLeft, 0, 38) or UDim2.new(0, 8, 1, -14)
                subtitle.Size = horizontal and UDim2.new(1, -(textLeft + 10), 0, 16) or UDim2.new(1, -16, 0, 14)
                subtitle.Font = Enum.Font.GothamMedium
                subtitle.Text = tostring(logoConfig.Subtitle)
