function XLQPGen1:_RegisterLiveColorDropdown(dropdown)
	if type(dropdown)~="table" then return dropdown end
	self._LiveColorDropdowns=self._LiveColorDropdowns or {}
	for _,existing in ipairs(self._LiveColorDropdowns) do if existing==dropdown then return dropdown end end
	self._LiveColorDropdowns[#self._LiveColorDropdowns+1]=dropdown
	local options=self:GetLiveColorThemes()
	if type(dropdown.Refresh)=="function" then pcall(function() dropdown:Refresh(options,true,true) end) end
	local selected=self._WindowConfig and self._WindowConfig.LiveColorTheme
	if selected and dropdown.Value~=selected and type(dropdown.Set)=="function" then pcall(function() dropdown:Set(selected,true) end) end
	return dropdown
end

function XLQPGen1:_RefreshLiveColorDropdowns()
	local options=self:GetLiveColorThemes()
	local selected=self._WindowConfig and self._WindowConfig.LiveColorTheme
	for index=#(self._LiveColorDropdowns or {}),1,-1 do
		local dropdown=self._LiveColorDropdowns[index]
		if type(dropdown)~="table" or type(dropdown.Refresh)~="function" then
			table.remove(self._LiveColorDropdowns,index)
		else
			local existingOptions=dropdown.Options or {}
			local optionsChanged=#existingOptions~=#options
			if not optionsChanged then
				for i,opt in ipairs(options) do
					if existingOptions[i]~=opt then optionsChanged=true break end
				end
			end
			local ok=pcall(function()
				if optionsChanged then
					dropdown:Refresh(options,true,true)
				elseif selected and dropdown.Value~=selected and type(dropdown.Set)=="function" then
					dropdown:Set(selected,true)
				end
			end)
			if not ok then table.remove(self._LiveColorDropdowns,index) end
		end
	end
	return options
end

function XLQPGen1:_StartLiveColorThemeWatcher()
	if self._StartupBuildActive and not self._StartupFinalizing then
		self._StartupPendingLiveColorWatcher=true
		return self
	end
	if self._LiveColorWatcherRunning or not listfiles then return self end
	self._LiveColorWatcherRunning=true
	self._LiveColorWatcherToken=(tonumber(self._LiveColorWatcherToken) or 0)+1
	local token=self._LiveColorWatcherToken
	task.spawn(function()
		local lastSignature=self._LiveColorFileSignature or ""
		local emptyPasses=0
		while self._LiveColorWatcherRunning and token==self._LiveColorWatcherToken and not self._Destroyed do
			local folder=tostring(self.LiveColorFolder or "XLQPGen1/LiveColors")
			local ok,files=pcall(listfiles,folder)
			local supportedCount=0
			if ok and type(files)=="table" then
				local supported={}
				for _,path in ipairs(files) do
					local lower=tostring(path):lower()
					if lower:sub(-4)==".txt" or lower:sub(-5)==".json" or lower:sub(-4)==".lua" or lower:sub(-5)==".luau" then
						supportedCount+=1
						supported[supportedCount]=lower
					end
				end
				if supportedCount>1 then table.sort(supported) end
				local signature=table.concat(supported,"|")
				if lastSignature~="" and signature~=lastSignature then
					pcall(function() self:ReloadLiveColorThemes() end)
				end
				lastSignature=signature
				self._LiveColorFileSignature=signature
			end
			if supportedCount==0 then
				emptyPasses=math.min(emptyPasses+1,3)
			else
				emptyPasses=0
			end
			local visible=(SettingsWindow and SettingsWindow.Visible) or (MainWindow and MainWindow.Visible)
			local interval
			if supportedCount==0 then
				interval=visible and 45 or 90
			else
				interval=visible and 15 or 45
			end
			if emptyPasses>=3 then interval=math.max(interval,90) end
			local deadline=os.clock()+interval
			while self._LiveColorWatcherRunning and token==self._LiveColorWatcherToken and not self._Destroyed and os.clock()<deadline do
				task.wait(math.min(1,math.max(.1,deadline-os.clock())))
			end
		end
		if token==self._LiveColorWatcherToken then self._LiveColorWatcherRunning=false end
	end)
	return self
end

local XLQPLiveColorWhite=Color3.new(1,1,1)
function XLQPLiveColorForceWhite(object,property)
	if object[property]~=XLQPLiveColorWhite then object[property]=XLQPLiveColorWhite end
end
function XLQPGen1:BindLiveColor(target,config)
	if typeof(target)~="Instance" then return nil end
	if self._ReduceLagEnabled and not self._LiveColorAllowedInReduceLag then self:UnbindLiveColor(target) return nil end
	if config==false then self:UnbindLiveColor(target) return nil end
	if type(config)=="string" then config={Theme=config} elseif type(config)~="table" then config={} end
	self:UnbindLiveColor(target)
	local selectedTheme=self.Themes and self.Themes[self.SelectedTheme or "Default"] or nil
	local _,_,liveThemeData=XLQPResolveLiveColorTheme(config)
	local gradientTransparency=config.GradientTransparency
	if gradientTransparency==nil then gradientTransparency=liveThemeData and (liveThemeData.Transparency or liveThemeData.GradientTransparency) or (selectedTheme and selectedTheme.LiveColorTransparency) end
	local liveRotation=tonumber(config.Rotation) or tonumber(liveThemeData and liveThemeData.Rotation) or tonumber(selectedTheme and selectedTheme.LiveColorRotation) or 8
	local liveSpeed=tonumber(self._LiveColorSpeedOverride) or tonumber(config.Speed) or tonumber(liveThemeData and liveThemeData.Speed) or tonumber(selectedTheme and selectedTheme.LiveColorSpeed) or .32
	local suspendedGradients={}
	for _,child in ipairs(target:GetChildren()) do
		if child:IsA("UIGradient") and child.Name~="XLQPLiveColor" and child.Enabled then
			child.Enabled=false
			suspendedGradients[#suspendedGradients+1]=child
		end
	end
	local gradient=Instance.new("UIGradient")
	gradient.Name="XLQPLiveColor"
	gradient.Rotation=liveRotation
	gradient.Offset=Vector2.new(-1,0)
	gradient.Transparency=typeof(config.Transparency)=="NumberSequence" and config.Transparency or NumberSequence.new(tonumber(gradientTransparency) or 0)
	gradient.Parent=target
	local property=config.Property
	if not property then
		if target:IsA("UIStroke") then property="Color"
		elseif target:IsA("ImageLabel") or target:IsA("ImageButton") then property="ImageColor3"
		elseif target:IsA("TextLabel") or target:IsA("TextButton") or target:IsA("TextBox") then property="TextColor3"
		elseif target:IsA("GuiObject") then property="BackgroundColor3" end
	end
	local originalColor
	if property then pcall(function() originalColor=target[property] target[property]=Color3.new(1,1,1) end) end
	local binding={Target=target,Gradient=gradient,Property=property,OriginalColor=originalColor,SuspendedGradients=suspendedGradients,Theme=config.Theme or config.LiveColorTheme,Colors=config.Colors or config.LiveColors,Speed=math.clamp(liveSpeed,0.03,3),Phase=tonumber(config.Phase) or math.random(),Rotation=liveRotation,Enabled=true,FollowThemeSpeed=self._LiveColorSpeedOverride==nil and config.Speed==nil,FollowThemeRotation=config.Rotation==nil,FollowThemeTransparency=config.GradientTransparency==nil and typeof(config.Transparency)~="NumberSequence"}
	pcall(function() target:SetAttribute("XLQPLiveColorBound",true) end)
	function binding:SetTheme(theme)
		self.Theme=tostring(theme or "Thermal")
		self.Colors=nil
		XLQPGen1:_RefreshLiveColors()
		return self
	end
	function binding:SetColors(colors)
		self.Colors=colors
		XLQPGen1:_RefreshLiveColors()
		return self
	end
	function binding:SetSpeed(speed) self.Speed=math.clamp(tonumber(speed) or self.Speed,.03,3) self.FollowThemeSpeed=false return self end
	function binding:SetEnabled(value)
		self.Enabled=value~=false
		self.Gradient.Enabled=self.Enabled
		if self.Property then pcall(function() self.Target[self.Property]=self.Enabled and Color3.new(1,1,1) or self.OriginalColor end) end
		return self
	end
	function binding:Destroy() XLQPGen1:UnbindLiveColor(self.Target) end
	XLQPLiveColorBindings[target]=binding
	self:_RefreshLiveColors()
	if self._StartupBuildActive and not self._StartupFinalizing then
		self._StartupPendingLiveColor=true
		return binding
	end
	if not self._LiveColorConnection then
		local liveColorElapsed=0
		local liveColorInterval=1/(tonumber(self:GetLiveColorFPS()) or 30)
		self._LiveColorConnection=RunService.Heartbeat:Connect(function(deltaTime)
			liveColorElapsed+=tonumber(deltaTime) or 0
			if liveColorElapsed<liveColorInterval then return end
			if XLQPGen1._ReduceLagEnabled and not XLQPGen1._LiveColorAllowedInReduceLag then liveColorElapsed=0 return end
			local now=os.clock()
			if (tonumber(XLQPGen1._WindowMotionPausedUntil) or 0)>now then liveColorElapsed=0 return end
			if XLQPGen1._MainWindowMinimized==true then liveColorElapsed=0 return end
			if not ((MainWindow and MainWindow.Visible) or (SettingsWindow and SettingsWindow.Visible)) then liveColorElapsed=0 return end
			liveColorInterval=1/XLQPGen1:GetLiveColorFPS()
			liveColorElapsed=0
			local runtimeState=self._WindowConfig and self._WindowConfig._LocalRegisterState
			local visibilityCheck=runtimeState and runtimeState.isGuiBranchVisible
			if type(visibilityCheck)~="function" then visibilityCheck=nil end
			for object,item in pairs(XLQPLiveColorBindings) do
				if not object.Parent or not item.Gradient or not item.Gradient.Parent then
					XLQPLiveColorBindings[object]=nil
			elseif item.Enabled then
				if object:IsA("GuiObject") and object.Visible==false then continue end
				if visibilityCheck and not visibilityCheck(object) then continue end
					if item.Property then
						pcall(XLQPLiveColorForceWhite,object,item.Property)
					end
					local wave=now*item.Speed+item.Phase
					local cycle=(wave%2)/2
					local easedCycle=cycle*cycle*(3-2*cycle)
					local travel=-1+2*easedCycle
					local nextOffset=Vector2.new(travel,math.sin(wave*1.7)*.08)
					local nextRotation=item.Rotation+math.sin(wave*1.15)*10
					local gradient=item.Gradient
					if gradient.Offset~=nextOffset then gradient.Offset=nextOffset end
					if gradient.Rotation~=nextRotation then gradient.Rotation=nextRotation end
				end
			end
		end)
		table.insert(self.Connections,self._LiveColorConnection)
	end
	return binding
end

function XLQPGen1:UnbindLiveColor(target)
	local binding=XLQPLiveColorBindings[target]
	if not binding then
		if typeof(target)=="Instance" then pcall(function() target:SetAttribute("XLQPLiveColorBound",nil) end) end
		return self
	end
	XLQPLiveColorBindings[target]=nil
	if binding.Gradient then pcall(function() binding.Gradient:Destroy() end) end
	if binding.Property and binding.OriginalColor~=nil and target and target.Parent then pcall(function() target[binding.Property]=binding.OriginalColor end) end
	for _,gradient in ipairs(binding.SuspendedGradients or {}) do
		if gradient and gradient.Parent then pcall(function() gradient.Enabled=not (self._PerformanceMode or self._ReduceLagEnabled) end) end
	end
	if target then pcall(function() target:SetAttribute("XLQPLiveColorBound",nil) end) end
	local hasLiveBindings=false
	for object,item in pairs(XLQPLiveColorBindings) do
		if object and object.Parent and item and item.Gradient and item.Gradient.Parent then
			hasLiveBindings=true
			break
		else
			XLQPLiveColorBindings[object]=nil
		end
	end
	if not hasLiveBindings and self._LiveColorConnection then
		pcall(function() self._LiveColorConnection:Disconnect() end)
		self._LiveColorConnection=nil
	end
	return self
end

function XLQPGen1:IsLiveColorBound(target)
	return typeof(target)=="Instance" and XLQPLiveColorBindings[target]~=nil
end

function XLQPGen1:_RefreshLiveColors()
	if self._SetupPassivePreset==true then return self end
	local selectedTheme=self.Themes and self.Themes[self.SelectedTheme or "Default"] or nil
	local globalLiveSpeed=tonumber(self._LiveColorSpeedOverride)
	for target,binding in pairs(XLQPLiveColorBindings) do
		if target.Parent and binding.Gradient then
