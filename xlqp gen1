		PanelConfig.Icon=PanelConfig.Icon or "list"
		PanelConfig.Width=tonumber(PanelConfig.Width) or 286
		PanelConfig.Height=tonumber(PanelConfig.Height) or 236
		PanelConfig.Position=PanelConfig.Position or UDim2.new(0,18,0,82)
		local dockParent=typeof(PanelConfig.Parent)=="Instance" and PanelConfig.Parent or nil
		local ownedDockHost
		if not dockParent and PanelConfig.Detached~=true then
			local activeMain=self._ActiveMainWindow or self._MainWindow
			local bestScore=-math.huge
			for _,container in ipairs(self.EditableContainers or {}) do
				if container and container.Parent and container:IsA("GuiObject") and container.Visible and container.AbsoluteSize.X>40 and container.AbsoluteSize.Y>40 and (not activeMain or container:IsDescendantOf(activeMain)) and container:FindFirstChildOfClass("UIListLayout") then
					local topLevel=container.Name=="ItemContainer_Direct" or container.Name=="ItemContainer_Side"
					local score=(topLevel and 1000000000 or 0)+(container.AbsoluteSize.X*container.AbsoluteSize.Y)
					if score>bestScore then dockParent=container bestScore=score end
				end
			end
			if not dockParent and activeMain and activeMain.Parent then
				ownedDockHost=Create("Frame",{Name="XLQPKeybindDockHost",Size=UDim2.fromOffset(PanelConfig.Width,math.clamp(tonumber(PanelConfig.DockHeight) or PanelConfig.Height,120,620)),Position=UDim2.new(1,-(PanelConfig.Width+14),0,82),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=300,Parent=activeMain})
				dockParent=ownedDockHost
			end
		end
		PanelConfig.Parent=dockParent
		local panel=self:CreatePanel(PanelConfig.Name or "XLQPControlList",PanelConfig)
		if ownedDockHost then
			panel.OwnedDockHost=ownedDockHost
			local originalDestroy=panel.Destroy
			function panel:Destroy()
				originalDestroy(self)
				if ownedDockHost and ownedDockHost.Parent then ownedDockHost:Destroy() end
			end
		end
		if dockParent then
			local root=panel.Wrapper
			local header=panel.Header
			local showPin=PanelConfig.Pin==true or PanelConfig.Pinnable==true
			local showPopout=PanelConfig.Popout==true or PanelConfig.PopOut==true or PanelConfig.Detachable==true
			local floatingSize=UDim2.fromOffset(PanelConfig.Width,PanelConfig.Height)
			local dockHeight=math.clamp(tonumber(PanelConfig.DockHeight) or PanelConfig.Height,120,620)
			local dockSize=UDim2.new(1,0,0,dockHeight)
			local floatingPosition=typeof(PanelConfig.PopoutPosition)=="UDim2" and PanelConfig.PopoutPosition or PanelConfig.Position
			panel.DockParent=dockParent
			panel.DockSize=dockSize
			panel.FloatingSize=floatingSize
			panel.FloatingPosition=floatingPosition
			panel.DockLayoutOrder=tonumber(PanelConfig.LayoutOrder) or 0
			panel.Detached=false
			panel.Docked=true

			if panel.TitleLabel then panel.TitleLabel.Size=UDim2.new(1,-(76+(showPin and 32 or 0)+(showPopout and 32 or 0)),1,0) end
			if panel.PinButton then panel.PinButton.Visible=showPin panel.PinButton.Position=UDim2.new(1,showPopout and -100 or -68,.5,-15) end
			local popButton=SetProps(MakeElement("Button"),{Name="Popout",Size=UDim2.fromOffset(30,30),Position=UDim2.new(1,-68,.5,-15),BackgroundTransparency=1,Text="",AutoButtonColor=false,Parent=header})
			popButton.Visible=showPopout
			local popIcon=AddThemeObject(SetProps(MakeElement("Image",GetIcon("maximize-2") or normalizeIconAsset("maximize-2")),{Name="Icon",Size=UDim2.fromOffset(16,16),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Parent=popButton}),"TextDark")
			panel.PopoutButton=popButton
			panel.PopoutIcon=popIcon

			local function applyExpandedSize(size)
				panel.ExpandedSize=size
				if not panel.Collapsed then root.Size=size else root.Size=UDim2.new(size.X.Scale,size.X.Offset,0,44) end
			end
			function panel:SetDetached(value)
				if not showPopout then return self end
				local detached=value==true
				if detached then
					if not (self.Gui and self.Gui.Parent) then return self end
					self.Detached=true
					self.Docked=false
					root.Parent=self.Gui
					root.LayoutOrder=0
					root.Position=self.FloatingPosition
					root.Visible=true
					self.Gui.Enabled=true
					applyExpandedSize(self.FloatingSize)
					XLQPAssignProperty(popIcon,"Image",GetIcon("minimize-2") or normalizeIconAsset("minimize-2"))
					popButton:SetAttribute("Action","PopIn")
				else
					if not (self.DockParent and self.DockParent.Parent) then return self end
					self.Detached=false
					self.Docked=true
					root.Parent=self.DockParent
					root.LayoutOrder=self.DockLayoutOrder
					root.Position=UDim2.new()
					root.Visible=true
					applyExpandedSize(self.DockSize)
					XLQPAssignProperty(popIcon,"Image",GetIcon("maximize-2") or normalizeIconAsset("maximize-2"))
					popButton:SetAttribute("Action","PopOut")
				end
				task.defer(function() if self.Refresh then self:Refresh() end end)
				return self
			end
			function panel:TogglePopout() return self:SetDetached(not self.Detached) end
			panel.ToggleDetach=panel.TogglePopout
			AddConnection(popButton.Activated,function() panel:TogglePopout() end)
