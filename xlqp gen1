function XLQPGen1:_RefreshQuickActiveToggles()
	local config=self:_GetTopBarQuickPanelsConfig()
	if not config or config.Toggles==false then return end
	local panel=self:_BuildQuickPanelShell("toggles",tostring(config.TogglesTitle or "Active Toggles"),math.clamp(tonumber(config.PanelWidth) or 320,260,520),math.clamp(tonumber(config.PanelHeight) or 360,220,620),self._QuickToggleButton)
	if not panel then return end
	local scroller=self._QuickActiveScroller
	if not scroller then return end
	self._QuickActiveMirrorMap=self._QuickActiveMirrorMap or setmetatable({},{__mode="k"})
	local active=self:_GetActiveQuickToggles()
	local activeSet={}
	for _,original in ipairs(active) do
		activeSet[original]=true
		local entry=self._QuickActiveMirrorMap[original]
		if not entry or not entry.Mirror or not entry.Mirror.Wrapper or not entry.Mirror.Wrapper.Parent then
			if type(GetElements)~="function" then continue end
			local elements=GetElements(scroller)
			if type(elements)~="table" or type(elements.AddToggle)~="function" then continue end
			local mirror=elements:AddToggle({Name=tostring(original.Name or "Toggle"),Default=true,Color=(self.Themes[self.SelectedTheme] or self.Themes.Default).Bloom or Color3.fromRGB(110,92,255),Save=false,_InternalQuickPanel=true,Callback=function(value)
				if value==false and original and original.Set then
					pcall(function() original:Set(false) end)
					task.defer(function() if self._QuickActivePanelOpen then self:_RefreshQuickActiveToggles() end end)
				end
			end})
			entry={Mirror=mirror}
			self._QuickActiveMirrorMap[original]=entry
			if mirror and mirror.Wrapper then
				mirror.Wrapper.ZIndex=250010
				for _,gui in ipairs(mirror.Wrapper:GetDescendants()) do if gui:IsA("GuiObject") then gui.ZIndex=math.max(250011,gui.ZIndex) end end
			end
		end
		if entry.Mirror and entry.Mirror.Wrapper then
			entry.Mirror.Wrapper.Visible=true
			if entry.Mirror.Value~=true then pcall(function() entry.Mirror:Set(true,true) end) end
			if entry.Mirror.SetName then pcall(function() entry.Mirror:SetName(tostring(original.Name or "Toggle")) end) end
		end
	end
	for original,entry in pairs(self._QuickActiveMirrorMap) do
		if not activeSet[original] and entry and entry.Mirror and entry.Mirror.Wrapper and entry.Mirror.Wrapper.Parent then entry.Mirror.Wrapper.Visible=false end
	end
	local empty=scroller:FindFirstChild("XLQPQuickEmpty")
	if #active==0 then
		if not empty then empty=AddThemeObject(Create("TextLabel",{Name="XLQPQuickEmpty",Size=UDim2.new(1,0,0,72),BackgroundTransparency=1,Text="No toggles are currently enabled.",TextWrapped=true,Font=Enum.Font.GothamSemibold,TextSize=13,TextXAlignment=Enum.TextXAlignment.Center,ZIndex=87003,Parent=scroller}),"TextDark") end
		empty.Visible=true
	elseif empty then empty.Visible=false end
	self:_RaiseQuickPanelZ(panel)
	self:_UpdateQuickPanelBadges()
end

