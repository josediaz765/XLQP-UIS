	function window:RunPrivateTabFunction(source,target)
		if not unlocked then return false,"Private editor is locked" end
		local code=tostring(source or "")
		local elementTarget=target or window:GetPrivateTarget()
		if not elementTarget then return false,"Create or select a private tab first" end
		if type(loadstring)~="function" then return false,"loadstring is unavailable" end
		local chunk,compileError=loadstring(code,"XLQPPrivateTabFunction")
		if not chunk then return false,tostring(compileError) end
		local baseEnvironment=getfenv and getfenv(chunk) or _G
		local environment=setmetatable({Target=elementTarget,Tab=elementTarget,Groupbox=activeGroup,Record=activeRecord,Window=window,Library=library,print=function(...) if functionConsole then local values={...} for i=1,#values do values[i]=tostring(values[i]) end functionConsole:Log(table.concat(values,"\t")) end end,warn=function(...) if functionConsole then local values={...} for i=1,#values do values[i]=tostring(values[i]) end functionConsole:Warn(table.concat(values,"\t")) end end},{__index=baseEnvironment})
		if setfenv then pcall(setfenv,chunk,environment) end
		local ok,result=xpcall(chunk,function(err) return debug.traceback(tostring(err),2) end)
		if not ok then return false,result end
		if type(result)=="function" then
			local called,callError=xpcall(function() return result(elementTarget,activeRecord,window,library) end,function(err) return debug.traceback(tostring(err),2) end)
			if not called then return false,callError end
		end
		return true,result
	end

