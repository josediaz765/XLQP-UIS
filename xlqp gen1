local function XLQPSetupClone(value)
	if type(value)~="table" then return value end
	local copied={}
	for key,item in pairs(value) do copied[key]=XLQPSetupClone(item) end
	return copied
end
local function XLQPSetupSlug(value)
	value=tostring(value or "setup")
	value=value:gsub("[^%w_%-.]","_")
	value=value:gsub("_+","_")
	value=value:gsub("^_+","")
	value=value:gsub("_+$","")
	if value=="" then value="setup" end
	return value
end
local function XLQPSetupEnsureFolder(path)
	if type(path)~="string" or path=="" or not makefolder then return end
	path=path:gsub("\\","/"):gsub("/+$","")
	if path=="" then return end
	local built=""
	for segment in path:gmatch("[^/]+") do
		built=built=="" and segment or (built.."/"..segment)
		if not isfolder or not isfolder(built) then pcall(makefolder,built) end
	end
end
local function XLQPSetupRuntimeStore()
