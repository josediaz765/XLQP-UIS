function XLQPGen1:RegisterTheme(name,ThemeConfig,applyNow)
	ThemeConfig=type(ThemeConfig)=="table" and ThemeConfig or {}
	name=tostring(name or ThemeConfig.Name or ThemeConfig.Title or "Custom")
	local source=type(ThemeConfig.Theme)=="table" and ThemeConfig.Theme or ThemeConfig
	local theme={}
	for key,value in pairs((self.Themes and self.Themes.Default) or {}) do theme[key]=value end
	local function colorValue(value)
		if typeof(value)=="Color3" then return value end
		if type(value)=="string" then
			local hex=value:gsub("#",""):match("^%x%x%x%x%x%x$") and value:gsub("#","") or nil
			if hex then return Color3.fromRGB(tonumber(hex:sub(1,2),16),tonumber(hex:sub(3,4),16),tonumber(hex:sub(5,6),16)) end
		elseif type(value)=="table" then
			local r=tonumber(value.R or value.r or value[1])
			local g=tonumber(value.G or value.g or value[2])
			local b=tonumber(value.B or value.b or value[3])
			if r and g and b then
				if math.max(r,g,b)<=1 then return Color3.new(r,g,b) end
				return Color3.fromRGB(r,g,b)
			end
		end
		return nil
	end
	local keys={"Main","Second","Stroke","Divider","Text","TextDark","Bloom","Accent"}
	for _,key in ipairs(keys) do
		local lower=key:sub(1,1):lower()..key:sub(2)
		local color=colorValue(source[key] or source[lower])
		if color then theme[key]=color end
	end
	local palette=type(source.Colors)=="table" and source.Colors or type(source.Palette)=="table" and source.Palette or nil
	if palette then
		local mapped={"Main","Second","Stroke","Bloom","Text","TextDark"}
		for index,key in ipairs(mapped) do local color=colorValue(palette[index]) if color then theme[key]=color end end
	end
	theme.Divider=theme.Divider or theme.Stroke:Lerp(theme.Main,.45)
	theme.Bloom=theme.Bloom or theme.Stroke
	theme.Accent=theme.Accent or theme.Bloom
	for key,value in pairs(source) do
		if theme[key]==nil and key~="Name" and key~="Title" and key~="Theme" and key~="Colors" and key~="Palette" then theme[key]=value end
	end
	self.Themes=self.Themes or {}
	self.Themes[name]=theme
	if applyNow==true or ThemeConfig.Apply==true or ThemeConfig.Selected==true then self:SetTheme(name) end
	if ThemeConfig.Save==true and self.SaveTheme then pcall(function() self:SaveTheme(name) end) end
	return theme
end

