		alpha=math.clamp(alpha,0,1)
		scaleFill.Size=UDim2.new(alpha,0,1,0)
		scaleKnob.Position=UDim2.new(alpha,0,0.5,0)
		scaleValueLabel.Text=tostring(math.floor(result.Scale*100+0.5)).."%"
