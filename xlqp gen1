			local success, result = pollinationsAI(messagesForAPI, system_prompt .. "\nCURRENT_USER_QUESTION: " .. tostring(augmentedPrompt or ""), function(candidate)
				if userActionIntent then
					if not responseHasLuaCodeBlock(candidate) then return false,"action answer did not contain a complete Lua code block" end
