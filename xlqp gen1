	local function SetPickerFromPointer(frame, input, axis)
		if not frame or frame.AbsoluteSize.X <= 0 or frame.AbsoluteSize.Y <= 0 then return end
		local pointer = GetPickerPointer(input)
		local absolutePosition = frame.AbsolutePosition
		local absoluteSize = frame.AbsoluteSize
		local localX = math.clamp(pointer.X - absolutePosition.X, 0, absoluteSize.X)
		local localY = math.clamp(pointer.Y - absolutePosition.Y, 0, absoluteSize.Y)
		local xAlpha = absoluteSize.X > 0 and localX / absoluteSize.X or 0
		local yAlpha = absoluteSize.Y > 0 and localY / absoluteSize.Y or 0
		if axis == "Color" then
			ColorS = xAlpha
			ColorV = 1 - yAlpha
		elseif axis == "Hue" then
			ColorH = yAlpha
		elseif axis == "Alpha" then
			ColorA = yAlpha
		end
		UpdateColorPicker(true)
	end

