	return true, result
end

function XLQPGen1:GetPublicConfigCloudQuota()
	local limit=math.max(1,math.floor(tonumber(self.ConfigCloud and self.ConfigCloud.PublicUploadLimit) or 5))
	local mine,err=self:GetOwnPublicConfigCloud("")
	if type(mine)~="table" then return nil,limit,err or "Could not check upload tokens." end
	local seen={}
	local count=0
	for _,item in ipairs(mine) do
		local key=tostring(item.owner_id or item.user_id or "").."\0"..tostring(item.config_name or item.name or "")
		if not seen[key] then seen[key]=true count+=1 end
	end
	return count,limit,nil,mine
end

function XLQPGen1:DeletePublicConfigCloud(item)
	item=type(item)=="table" and item or {}
	local player=Players.LocalPlayer
	if not player then return false,"LocalPlayer is unavailable." end
	local localOwner=tostring(player.UserId)
	local ownerId=tostring(item.owner_id or item.user_id or "")
	local configName=tostring(item.config_name or item.name or "")
	if ownerId=="" or configName=="" then return false,"Select one of your public configs first." end
	if ownerId~=localOwner then return false,"Only the config owner can delete this config." end
	local encodedOwner=HttpService:UrlEncode(ownerId)
	local encodedName=HttpService:UrlEncode(configName)
	local payload={
		requesting_owner_id=localOwner,
		requester_id=localOwner,
		owner_id=ownerId,
		config_name=configName
	}
	local result,err,code=configCloudRequest("POST","/api/configs/delete",payload)
	if result then return true,result end
	if code~=404 and code~=405 then return false,err end

	result,err,code=configCloudRequest("DELETE","/api/configs/"..encodedOwner.."/"..encodedName,payload)
	if result then return true,result end
	if code~=404 and code~=405 then return false,err end

	result,err,code=configCloudRequest("POST","/api/configs/"..encodedOwner.."/"..encodedName.."/delete",payload)
	if result then return true,result end
	if code~=404 and code~=405 then return false,err end

	return false,"Delete API is not installed on the Config Cloud backend yet. Add POST /api/configs/delete or DELETE /api/configs/:ownerId/:configName."
end

function XLQPGen1:EditPublicConfigCloud(item,options)
	item=type(item)=="table" and item or {}
	options=type(options)=="table" and options or {}
	local player=Players.LocalPlayer
	if not player then return false,"LocalPlayer is unavailable." end
	local localOwner=tostring(player.UserId)
	local ownerId=tostring(item.owner_id or item.user_id or "")
	local oldName=tostring(item.config_name or item.name or "")
	if ownerId=="" or oldName=="" then return false,"Select one of your public configs first." end
	if ownerId~=localOwner then return false,"Only the config owner can edit this config." end
	local newName=tostring(options.Name or options.Title or oldName):match("^%s*(.-)%s*$")
	if newName=="" then return false,"A config title is required." end
	local description=tostring(options.Description~=nil and options.Description or item.description or "")
	local tags=tostring(options.Tags~=nil and options.Tags or item.tags or "")
	local payload={
		requesting_owner_id=localOwner,
		owner_id=localOwner,
		config_name=oldName,
		new_config_name=newName,
		title=newName,
		description=description,
		tags=tags
	}
	if type(options.Data)=="table" then
		local safe=configCloudPublicSafeValue(options.Data)
		local ok,encoded=pcall(HttpService.JSONEncode,HttpService,safe)
		if not ok then return false,"The edited config values could not be encoded." end
		payload.elements_json=encoded
	end
	local path="/api/configs/"..HttpService:UrlEncode(ownerId).."/"..HttpService:UrlEncode(oldName)
	local result,err=configCloudRequest("PATCH",path,payload)
	if result then
		item.config_name=newName
		item.name=newName
		item.description=description
		item.tags=tags
		if payload.elements_json then item.elements_json=payload.elements_json end
		return true,result
	end

	local full=item
	if full.elements_json==nil then
		local fetched,fetchErr=configCloudRequest("GET",path,nil)
		if not fetched then return false,err or fetchErr end
		full=fetched.config or fetched
	end
	local data=options.Data
	if type(data)~="table" then
		local encoded=full and full.elements_json
		if type(encoded)=="string" then
			local decodeOk,decoded=pcall(HttpService.JSONDecode,HttpService,encoded)
			if decodeOk and type(decoded)=="table" then data=decoded end
		elseif type(encoded)=="table" then
			data=encoded
		end
	end
	if type(data)~="table" then return false,err or "The current config values could not be read for editing." end
	local published,publishResult=self:PublishPublicConfig({
		Name=newName,
		Description=description,
		Tags=tags,
		Data=data,
		SkipLimitCheck=true
	})
	if not published then return false,publishResult or err end
	if newName~=oldName then
		local deleted,deleteErr=self:DeletePublicConfigCloud(item)
		if not deleted then return false,"The edited copy uploaded, but the old config could not be deleted: "..tostring(deleteErr) end
	end
	item.config_name=newName
	item.name=newName
	item.description=description
	item.tags=tags
	return true,publishResult
end

function XLQPGen1:VotePublicConfigCloud(item,vote)
	item=type(item)=="table" and item or {}
	local player=Players.LocalPlayer
	if not player then return false,"LocalPlayer is unavailable." end
	vote=tonumber(vote) or 0
	if vote>0 then vote=1 elseif vote<0 then vote=-1 else vote=0 end
	local ownerId=tostring(item.owner_id or item.user_id or "")
	local configName=tostring(item.config_name or item.name or "")
	if ownerId=="" or configName=="" then return false,"Select a public config first." end
	local voterId=tostring(player.UserId)
	local path="/api/configs/"..HttpService:UrlEncode(ownerId).."/"..HttpService:UrlEncode(configName).."/vote"
	local result,err=configCloudRequest("POST",path,{
		voter_id=voterId,
		vote=vote
	})
	if not result then
		result,err=configCloudRequest("POST","/api/configs/vote",{
			owner_id=ownerId,
			config_name=configName,
			voter_id=voterId,
			vote=vote
		})
	end
	if not result then return false,err or "Vote failed." end
	local source=type(result.config)=="table" and result.config or result
	local likes=tonumber(source.likes or source.like_count or source.upvotes)
	local dislikes=tonumber(source.dislikes or source.dislike_count or source.downvotes)
	local currentVote=tonumber(source.user_vote or source.my_vote or source.current_vote or source.vote)
	if likes~=nil then item.likes=likes item.like_count=likes end
	if dislikes~=nil then item.dislikes=dislikes item.dislike_count=dislikes end
	item.user_vote=currentVote~=nil and currentVote or vote
	item.my_vote=item.user_vote
	return true,result
end

function XLQPGen1:PublishPublicConfig(options)
	options = type(options) == "table" and options or {}
	local player = Players.LocalPlayer
	if not player then return false, "LocalPlayer is unavailable." end
	local name = tostring(options.Name or options.Title or ""):match("^%s*(.-)%s*$")
	if name == "" then return false, "A config title is required." end
	if options.SkipLimitCheck~=true then
		local used,limit,quotaError=self:GetPublicConfigCloudQuota()
		if used and used>=limit then
			return false,"You are out of tokens to upload. Delete one of your public configs to free a token. ("..tostring(used).."/"..tostring(limit)..")"
		end
		if quotaError then
			self._ConfigCloudLastQuotaError=tostring(quotaError)
		end
	end
	local safeData = configCloudPublicSafeValue(type(options.Data) == "table" and options.Data or {})
	local encodedOk, encoded = pcall(HttpService.JSONEncode, HttpService, safeData)
	if not encodedOk then return false, "The selected config could not be encoded." end
	local gameName = tostring(game.Name or "Unknown game")
	pcall(function()
		local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
		if info and info.Name then gameName = tostring(info.Name) end
	end)
	local payload = {
		owner_id = tostring(player.UserId),
		user_id = tostring(player.UserId),
		username = tostring(player.Name),
		display_name = tostring(player.DisplayName or player.Name),
		thumbnail = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(player.UserId) .. "&w=150&h=150",
		game_name = gameName,
		place_id = tostring(game.PlaceId),
		universe_id = tostring(game.GameId),
		config_name = name,
		description = tostring(options.Description or ""),
		tags = tostring(options.Tags or ""),
		elements_json = encoded,
		upload_limit = math.max(1,math.floor(tonumber(self.ConfigCloud and self.ConfigCloud.PublicUploadLimit) or 5))
	}
	local result, err = configCloudRequest("POST", "/api/configs/publish", payload)
	if not result then return false, err end
	return true, result
end

function XLQPGen1:LoadPublicConfigCloud(item, skipImportCount)
	item = type(item) == "table" and item or {}
	if skipImportCount ~= true and tostring(item.share_code or "") ~= "" then
		local ownerId = tostring(item.owner_id or item.user_id or "")
		local configName = tostring(item.config_name or item.name or "")
		local full = item
		if full.elements_json == nil and ownerId ~= "" and configName ~= "" then
			local fetched, fetchError = configCloudRequest("GET", "/api/configs/" .. HttpService:UrlEncode(ownerId) .. "/" .. HttpService:UrlEncode(configName), nil)
			if not fetched then return false, fetchError end
			full = fetched.config or fetched
		end
		if type(full) == "table" and full.elements_json ~= nil and tostring(full.share_code or "") ~= "" then
			local export = {
				config_name = tostring(full.config_name or configName),
				game_name = tostring(full.game_name or ""),
				description = tostring(full.description or ""),
				elements_json = full.elements_json,
				share_code = tostring(full.share_code),
				display_name = tostring(full.display_name or full.roblox_display_name or ""),
				original_owner_id = ownerId
			}
			local encodedOk, json = pcall(HttpService.JSONEncode, HttpService, export)
			if encodedOk then
				local imported, importError = configCloudRequest("POST", "/api/configs/import", {code = configCloudBase64Encode(json)})
				if not imported then return false, importError end
				item = type(imported.config) == "table" and imported.config or full
			end
		end
	end
	local name = tostring(item.config_name or item.name or "Public Config")
	local ownerId = tostring(item.owner_id or item.user_id or "")
	local raw = item.elements_json or item.config_json or item.data
	if raw == nil and ownerId ~= "" then
		local fetched, err = configCloudRequest("GET", "/api/configs/fetch?owner_id=" .. HttpService:UrlEncode(ownerId) .. "&config_name=" .. HttpService:UrlEncode(name), nil)
		if not fetched then return false, err end
		raw = fetched.elements_json or fetched.config_json or fetched.data
	end
	local data = raw
	if type(raw) == "string" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok or type(decoded) ~= "table" then return false, "This public config contains invalid JSON." end
		data = decoded
	end
	if type(data) ~= "table" then return false, "This public config has no saved values." end
	data = configCloudPublicSafeValue(data)
	local flagData = {}
	if #data > 0 then
		for _, entry in ipairs(data) do
			if type(entry) == "table" then
				local key = tostring(entry.key or entry.flag or entry.name or "")
				if key ~= "" then flagData[key] = entry.value end
			end
		end
	else
		flagData = configCloudPublicSafeValue(data)
	end
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, flagData)
	if not ok then return false, "The downloaded config could not be encoded." end
	if not (writefile and configCloudPrepareFolder()) then return false, "File APIs are unavailable." end
	local safeName = name:gsub("[^%w%s_%-]", ""):gsub("%s+", "_"):sub(1, 64)
	if safeName == "" then safeName = "Public_Config" end
	local path = self.ConfigCloud.PublicFolder .. "/" .. safeName .. ".json"
	local saved, saveErr = pcall(writefile, path, encoded)
	if not saved then return false, tostring(saveErr) end
	LoadCfg(encoded)
	return true, path
end

function XLQPGen1:ImportConfigCloudCode(code)
	local valid, decoded = self:DecodeConfigCloudExportCode(code)
	if not valid then return false, decoded end
	local result, err = configCloudRequest("POST", "/api/configs/import", {code = tostring(code or ""):gsub("%s+", "")})
	if not result then return false, err end
	local config = type(result.config) == "table" and result.config or decoded
	local loaded, loadResult = self:LoadPublicConfigCloud(config, true)
	if not loaded then return false, loadResult end
	return true, {
		config = config,
		path = loadResult,
		import_count = tonumber(result.import_count or config.import_count) or 0
	}
end

