function XLQPGen1:GetSetupState(setupConfig)
	setupConfig=XLQPSetupResolveConfig(self,setupConfig)
	if not setupConfig or setupConfig.Enabled==false then return nil end
	if type(self._SetupMemoryState)=="table" and (self._SetupMemoryState.completed==true or self._SetupMemoryState.Completed==true) then
		return XLQPSetupClone(self._SetupMemoryState)
	end
	local path=self:GetSetupStoragePath(setupConfig)
	local runtimeStore=XLQPSetupRuntimeStore()
	local runtimeState=path and runtimeStore[path] or nil
	if type(runtimeState)=="table" and (runtimeState.completed==true or runtimeState.Completed==true) then
		local decoded=XLQPSetupDecodeState(runtimeState)
		self._SetupMemoryState=XLQPSetupClone(decoded)
		return decoded
	end
	if path and isfile and readfile and isfile(path) then
		local ok,data=pcall(function() return HttpService:JSONDecode(readfile(path)) end)
		if ok and type(data)=="table" then
			local decoded=XLQPSetupDecodeState(data)
			if decoded.completed==true or decoded.Completed==true then
				self._SetupMemoryState=XLQPSetupClone(decoded)
				runtimeStore[path]=XLQPSetupEncodeState(decoded)
			end
			return decoded
		end
	end
	return nil
end
function XLQPGen1:SaveSetupState(state,setupConfig)
	setupConfig=XLQPSetupResolveConfig(self,setupConfig)
	if not setupConfig or setupConfig.Enabled==false or type(state)~="table" then return false end
	local copy=XLQPSetupClone(state)
	copy.completed=true
	copy.Completed=true
	copy.CompletedAt=copy.CompletedAt or os.time()
	copy.SetupVersion=setupConfig.Version or copy.SetupVersion or 1
	self._SetupMemoryState=XLQPSetupClone(copy)
	local path=self:GetSetupStoragePath(setupConfig)
	local encoded=XLQPSetupEncodeState(copy)
	local runtimeStore=XLQPSetupRuntimeStore()
	if path then runtimeStore[path]=XLQPSetupClone(encoded) end
	local wrote=false
	if path and writefile then
		local folder=path:match("^(.*)/[^/]+$")
		if folder then XLQPSetupEnsureFolder(folder) end
		local ok=pcall(function() writefile(path,HttpService:JSONEncode(encoded)) end)
		wrote=ok==true
	end
	return wrote or path~=nil
end
function XLQPGen1:ClearSetupState(setupConfig)
	setupConfig=XLQPSetupResolveConfig(self,setupConfig)
	self._SetupMemoryState=nil
	self._SetupFlowFinished=false
	local path=self:GetSetupStoragePath(setupConfig)
	local runtimeStore=XLQPSetupRuntimeStore()
	if path then runtimeStore[path]=nil end
	if path and delfile and isfile and isfile(path) then pcall(delfile,path) end
	return true
end
function XLQPGen1:_IsSetupOwnerAllowed(setupConfig)
	setupConfig=XLQPSetupResolveConfig(self,setupConfig)
	if not setupConfig then return false end
	if setupConfig.OwnerOnly~=true and setupConfig.Owner==nil and setupConfig.User==nil then return true end
	local player=Players.LocalPlayer
	if not player then return false end
	local owner=setupConfig.Owner or setupConfig.User or (self._WindowConfig and self._WindowConfig.Owner)
	if owner==nil or tostring(owner)=="" then return true end
	owner=tostring(owner)
	return tostring(player.UserId)==owner or tostring(player.Name):lower()==owner:lower() or tostring(player.DisplayName):lower()==owner:lower()
end
local function XLQPSetupStateMatchesConfig(state,setupConfig)
	if type(state)~="table" then return false end
	if not setupConfig or setupConfig.RequireVersionMatch~=true then return true end
	local required=setupConfig.Version
	if required==nil then return true end
	return tostring(state.SetupVersion or state.Version or "")==tostring(required)
end
function XLQPGen1:ShouldShowSetup(setupConfig)
	setupConfig=XLQPSetupResolveConfig(self,setupConfig)
	if not setupConfig or setupConfig.Enabled==false then return false,nil end
	if self._SetupFlowFinished or self._SetupFlowOpen then return false,setupConfig end
	if not self:_IsSetupOwnerAllowed(setupConfig) then return false,setupConfig end
	local saved=self:GetSetupState(setupConfig)
	if type(saved)=="table" and (saved.completed==true or saved.Completed==true) and XLQPSetupStateMatchesConfig(saved,setupConfig) then
		self._SetupMemoryState=XLQPSetupClone(saved)
		return false,setupConfig
	end
	return true,setupConfig
end
function XLQPGen1:_SetupWizardCanTranslate(object)
	if not object or not object.Parent then return false end
	if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return false end
	local current=object
	while current do
		if current:GetAttribute("XLQPSetupNoTranslate")==true then return false end
		current=current.Parent
	end
	return true
end
function XLQPGen1:_TranslateSetupWizard(root,language)
	if not root or not root.Parent then return end
	language=tostring(language or "en")
	if language=="Auto" then language=getAutoLanguageCode() end
	if not translatorLanguageNames[language] then language="en" end
	self._SetupWizardTranslationGeneration=(self._SetupWizardTranslationGeneration or 0)+1
	local generation=self._SetupWizardTranslationGeneration
	local sources={}
	local groups={}
	for _,object in ipairs(root:GetDescendants()) do
		if self:_SetupWizardCanTranslate(object) then
			if object:IsA("TextBox") then
				local source=object:GetAttribute("XLQPSetupOriginalPlaceholder")
				if source==nil then
					source=tostring(object.PlaceholderText or "")
					object:SetAttribute("XLQPSetupOriginalPlaceholder",source)
				end
				if language=="en" then
					object.PlaceholderText=tostring(source)
				elseif source~="" and not tostring(source):match("^%s*https?://") then
					if not groups[source] then groups[source]={} sources[#sources+1]=source end
					groups[source][#groups[source]+1]={Object=object,Property="PlaceholderText"}
				end
			else
				local source=object:GetAttribute("XLQPSetupOriginalText")
				if source==nil then
					source=tostring(object.Text or "")
					object:SetAttribute("XLQPSetupOriginalText",source)
				end
				if language=="en" then
					object.Text=tostring(source)
				elseif source~="" and not tostring(source):match("^%s*https?://") and not tostring(source):find("<",1,true) then
					if not groups[source] then groups[source]={} sources[#sources+1]=source end
					groups[source][#groups[source]+1]={Object=object,Property="Text"}
				end
			end
		end
	end
	if language=="en" or #sources==0 then return end
	task.spawn(function()
		local translated=translateTextBatch(sources,language)
		if generation~=self._SetupWizardTranslationGeneration then return end
		for index,source in ipairs(sources) do
			local value=tostring(translated[index] or source)
			for _,entry in ipairs(groups[source] or {}) do
				local object=entry.Object
				if object and object.Parent and generation==self._SetupWizardTranslationGeneration then
					pcall(function() object[entry.Property]=value end)
				end
			end
		end
	end)
end
