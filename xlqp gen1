pingLabel.TextColor3=Color3.fromRGB(240,200,90)

local function currentFps()
	return tonumber(statsState.fps) or 0
end

statsState.statusBarRefresh=function(sharedFps,sharedPing,force)
	if not statusAlive or not bar.Parent or not statusVisible or bar.Visible~=true then return end

	local now=os.clock()
	if force or now>=nextMemoryRead then
		nextMemoryRead=now+8
		local ok,memory=pcall(function()
			return game:GetService("Stats"):GetTotalMemoryUsageMb()
		end)
		if ok and type(memory)=="number" then statusMemory=memory end
	end

	local memoryText="Memory Usage: "..tostring(math.floor((tonumber(statusMemory) or 0)+0.5)).." MB"
	local pingText="Avg. Ping: "..tostring(math.floor(tonumber(sharedPing) or tonumber(statsState.ping) or 0)).." ms"
	local fpsText="FPS: "..string.format("%.1f",tonumber(sharedFps) or currentFps()).."/s"
	local regionText="Region: "..tostring(options.Region or "N/A")
	local errorCount=#(XLQPGen1.LibErrors or {})
	local hasErrors=XLQPGen1._HasLibErrors==true

	if memoryText~=lastMemoryText then lastMemoryText=memoryText memoryLabel.Text=memoryText end
	if pingText~=lastPingText then lastPingText=pingText pingLabel.Text=pingText end
	if fpsText~=lastFpsText then lastFpsText=fpsText fpsLabel.Text=fpsText end
	if regionText~=lastRegionText then lastRegionText=regionText regionLabel.Text=regionText end
	if errorCount~=lastErrorCount then
		lastErrorCount=errorCount
		errorIcon.ImageTransparency=errorCount>0 and 0 or 0.55
	end
	if hasErrors~=lastHasErrors then
		lastHasErrors=hasErrors
		warnIcon.ImageTransparency=hasErrors and 0 or 0.55
	end
end

AddConnection(bar:GetPropertyChangedSignal("Visible"),function()
	statusVisible=bar.Visible==true
	if statusVisible and type(statsState.statusBarRefresh)=="function" then
		statsState.statusBarRefresh(statsState.fps,statsState.ping,true)
	end
end)

AddConnection(bar.AncestryChanged,function(_,parent)
	if not parent then
		statusAlive=false
		if statsState.statusBarRefresh then statsState.statusBarRefresh=nil end
	end
end)

