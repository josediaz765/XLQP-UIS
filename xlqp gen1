	local function elementText(element,wrapper)
		local parts={} local seen={}
		local function push(value)
			if value==nil then return end
			local text=tostring(value):gsub("<[^>]->",""):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
			local key=text:lower()
			if text~="" and #text<=220 and not seen[key] then seen[key]=true parts[#parts+1]=text end
		end
		push(element and element.Name) push(element and element.Title) push(element and element.Type)
		push(element and element.Description) push(element and element.Content) push(element and element.Placeholder)
		if wrapper then
			push(wrapper:GetAttribute("SearchName"))
			local directCount=0
			for _,desc in ipairs(wrapper:GetChildren()) do
				if directCount>=8 then break end
				if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
					push(desc:GetAttribute("OriginalText")) push(desc.Text)
