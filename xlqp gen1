	local function performRefresh()
		if not searchOpen then return end
		clearResults()
		local query=tostring(searchInput.Text or ""):lower():gsub("^%s+",""):gsub("%s+$","")
		local groups={} local total=0
		for _,record in ipairs(indexRecords) do
			if belongsToCurrent(record) and (activeCategory=="All" or record.category==activeCategory) and (query=="" or record.search:find(query,1,true)) then
				groups[record.category]=groups[record.category] or {} groups[record.category][#groups[record.category]+1]=record total+=1
			end
		end
		for _,category in ipairs(categoryOrder) do
			local group=groups[category]
			if group and #group>0 then
				pendingEntries[#pendingEntries+1]={section=category,count=#group}
