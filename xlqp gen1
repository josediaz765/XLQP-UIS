function SharedAIService:RunHuggingFace(messages, fallbackPrompt)
	local endpoint = self:GetHuggingFaceEndpoint()
	local base = "https://qwen-qwen3-demo.hf.space"
	local session = HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
	local config = self:Load()
	local payload = HttpService:JSONEncode({
		data = {
			sharedAIMessagesToPrompt(messages, fallbackPrompt),
			{model = "qwen3-32b", sys_prompt = config.SystemPrompt, thinking_budget = 4},
			{enable_thinking = false},
			{conversation_contexts = {}, conversations = {}, conversation_id = ""}
		},
		session_hash = session
	})
	local candidates = {base .. "/gradio_api/call/" .. endpoint, base .. "/call/" .. endpoint, base .. "/gradio_api/call/add_message", base .. "/call/add_message"}
	local lastError = "Hugging Face Space request failed"
	for _, callUrl in ipairs(candidates) do
		local body, code = sharedAIRawRequest("POST", callUrl, {["Content-Type"] = "application/json", ["Accept"] = "application/json", ["User-Agent"] = "Mozilla/5.0"}, payload, 45)
		if body ~= "" and (code == 0 or (code >= 200 and code < 300)) then
			local response = sharedAIDecode(body)
			local eventId = type(response) == "table" and response.event_id
			if eventId then
				local eventBody, eventCode = sharedAIRawRequest("GET", callUrl .. "/" .. tostring(eventId), {["Accept"] = "text/event-stream", ["User-Agent"] = "Mozilla/5.0"}, nil, 120)
				if eventBody ~= "" and (eventCode == 0 or (eventCode >= 200 and eventCode < 300)) then
					local answer = sharedAIExtractSSE(eventBody)
					if answer and answer ~= "" then return answer end
					lastError = "Hugging Face returned no final answer"
				else
					lastError = "Hugging Face event request failed"
				end
			else
				local answer = sharedAIExtractSSE(body) or sharedAIFindHuggingFaceAnswer(response)
				if answer and answer ~= "" then return answer end
				lastError = sharedAIExtractError(response) or "Hugging Face returned no event ID"
			end
		elseif body ~= "" then
			lastError = sharedAIExtractError(sharedAIDecode(body)) or sharedAIClean(body)
		end
	end
	return nil, lastError
end

function SharedAIService:InterpretSource(source, useAI)
	source = tostring(source or "")
	local lower = source:lower()
	local result = {}
	local function firstMatch(patterns)
		for _, pattern in ipairs(patterns) do
			local value = source:match(pattern)
			if value and value ~= "" then return value end
		end
	end
	local model = firstMatch({
		"[Mm]odel%s*[:=]%s*[\"']([^\"']+)[\"']",
		"[Mm]odel%s*=%s*[\"']([^\"']+)[\"']",
		"%-%-model%s+[\"']?([^%s\"']+)",
		"[Mm]odel[_%-][Ii][Dd]%s*[:=]%s*[\"']([^\"']+)[\"']"
	})
	local baseUrl = firstMatch({
		"[Bb]ase[_%-]?[Uu][Rr][Ll]%s*[:=]%s*[\"']([^\"']+)[\"']",
		"[Bb]aseURL%s*:%s*[\"']([^\"']+)[\"']",
		"[Ee]ndpoint%s*[:=]%s*[\"']([^\"']+)[\"']"
	})
	local url = firstMatch({
		"fetch%s*%(%s*[\"']([^\"']+)[\"']",
		"axios%.%a+%s*%(%s*[\"']([^\"']+)[\"']",
		"requests%.%a+%s*%(%s*[\"']([^\"']+)[\"']",
		"[Uu][Rr][Ll]%s*[:=]%s*[\"']([^\"']+)[\"']",
		"[Ee]ndpoint%s*[:=]%s*[\"']([^\"']+)[\"']",
		"(https?://[^%s\"'<>]+)"
	})
	local relativePath = firstMatch({
		"chat%.completions",
		"[Pp]ath%s*[:=]%s*[\"']([^\"']+)[\"']"
	})
	if lower:find("puter.ai.chat", 1, true) or lower:find("js.puter.com", 1, true) or lower:find("api.puter.com/puterai/openai", 1, true) then
		result.APIUrl = "https://api.puter.com/puterai/openai/v1/chat/completions"
		result.APIMethod = "POST"
		result.CustomModel = model or "openai/gpt-5.5"
		result.CustomHeaders = "{}"
		result.CustomBody = '{"model":"{model}","messages":{messages},"temperature":{temperature},"max_tokens":{max_tokens},"stream":false}'
		result.ResponsePath = "choices.1.message.content"
		result.Kind = "Puter"
		result.Status = "Puter source detected. Roblox cannot execute Puter.js directly, so this uses Puter's OpenAI-compatible route and requires a Puter auth token."
		return result
	end
	if baseUrl and not url then url = baseUrl end
	if baseUrl and url and url:sub(1, 1) == "/" then url = baseUrl:gsub("/+$", "") .. url end
	if url and relativePath == "chat.completions" and not url:lower():find("chat/completions", 1, true) then
		url = url:gsub("/+$", "") .. "/chat/completions"
	end
	if url and url:sub(-1) == "/" and (lower:find("openai", 1, true) or lower:find("chat%.completions")) then
		url = url .. "chat/completions"
	end
	if url then result.APIUrl = url end
	if model then result.CustomModel = model end
	if lower:find("method%s*:%s*[\"']get", 1) or lower:find("%-x%s+get", 1) or lower:find("requests%.get", 1, true) or lower:find("axios%.get", 1, true) then
		result.APIMethod = "GET"
	elseif lower:find("method%s*:%s*[\"']post", 1) or lower:find("%-x%s+post", 1) or lower:find("requests%.post", 1, true) or lower:find("axios%.post", 1, true) or lower:find("chat%.completions") then
		result.APIMethod = "POST"
	end
	local authorization = source:match("[Aa]uthorization[\"']?%s*[:=]%s*[\"']([^\"']+)[\"']")
	local apiKeyHeader = source:match("[Xx][%-_][Aa][Pp][Ii][%-_][Kk][Ee][Yy][\"']?%s*[:=]%s*[\"']([^\"']+)[\"']")
	local headers = {}
	if authorization and not authorization:find("process.env", 1, true) and not authorization:find("os.getenv", 1, true) then headers.Authorization = authorization end
	if apiKeyHeader and not apiKeyHeader:find("process.env", 1, true) and not apiKeyHeader:find("os.getenv", 1, true) then headers["x-api-key"] = apiKeyHeader end
	if next(headers) then result.CustomHeaders = HttpService:JSONEncode(headers) end
	if result.APIMethod == "POST" and (lower:find("messages", 1, true) or lower:find("chat/completions", 1, true)) then
		result.CustomBody = '{"model":"{model}","messages":{messages},"temperature":{temperature},"max_tokens":{max_tokens},"stream":false}'
		result.ResponsePath = "choices.1.message.content"
	elseif result.APIMethod == "POST" and lower:find("prompt", 1, true) then
		result.CustomBody = '{"prompt":"{prompt}"}'
	end
	if lower:find("choices%[0%]%.message%.content") or lower:find("choices%.0%.message%.content") or lower:find("choices%[1%]%.message%.content") then result.ResponsePath = "choices.1.message.content" end
	if result.APIUrl and result.APIUrl ~= "" and not useAI then
		result.Status = "Manual parser implemented the source. Review the generated URL, method, headers, body, and response path before saving."
		return result
	end
	if not useAI then
		result.Status = "Manual parser could not find a complete endpoint. Fill the fields yourself or use Auto AI."
		return result
	end
	local partialOk, partialJson = pcall(function() return HttpService:JSONEncode(result) end)
	local prompt = table.concat({
		"Convert the following API example into a Roblox executor HTTP request configuration.",
		"Return only one strict JSON object with these keys: APIUrl, APIMethod, CustomModel, CustomHeaders, CustomBody, ResponsePath.",
		"APIMethod must be GET or POST.",
		"CustomHeaders and CustomBody must be JSON strings, not nested objects.",
		"Use placeholders {prompt}, {messages}, {model}, {temperature}, and {max_tokens} where appropriate.",
		"For OpenAI-compatible chat APIs use ResponsePath choices.1.message.content.",
		"Never invent an API key. Keep secret values out of the output.",
		"Partial parser result: " .. (partialOk and partialJson or "{}"),
		"Source:",
		source:sub(1, 12000)
	}, "\n")
	local messages = {
		{role = "system", content = "You are an API integration assistant. Output strict JSON only."},
		{role = "user", content = prompt}
	}
	local providerOrder = {self.Config and self.Config.Provider or self.Defaults.Provider, "Smart DevToolBox", "Hugging Face Qwen3", "Pollen", "Smart Horde", "GPT Mini Free"}
	local seen = {}
	local answer
	local usedProvider
	for _, provider in ipairs(providerOrder) do
		if not seen[provider] then
			seen[provider] = true
			local ok, value = pcall(function()
				if provider == "Smart DevToolBox" then return self:RunDevToolBox(messages, prompt) end
				if provider == "Pollen" then return self:RunPollen(messages, prompt) end
				if provider == "Smart Horde" then return self:RunHorde(messages, prompt) end
				if provider == "GPT Mini Free" then return self:RunGPTMini(messages, prompt) end
				if provider == "Hugging Face Qwen3" then return self:RunHuggingFace(messages, prompt) end
			end)
			if ok and value and sharedAIClean(value) ~= "" then
				answer = value
				usedProvider = provider
				break
			end
		end
	end
	if answer then
		local jsonText = tostring(answer):match("```json%s*(.-)%s*```") or tostring(answer):match("```%s*(.-)%s*```") or tostring(answer)
		local firstBrace = jsonText:find("{", 1, true)
		local lastBrace = jsonText:match(".*()}")
		if firstBrace and lastBrace and lastBrace >= firstBrace then jsonText = jsonText:sub(firstBrace, lastBrace) end
		local data = sharedAIDecode(jsonText)
		if type(data) == "table" then
			for _, key in ipairs({"APIUrl", "APIMethod", "CustomModel", "CustomHeaders", "CustomBody", "ResponsePath"}) do
				local value = data[key]
				if type(value) == "table" then
					local ok, encoded = pcall(function() return HttpService:JSONEncode(value) end)
					value = ok and encoded or ""
				end
				if value ~= nil and tostring(value) ~= "" then result[key] = tostring(value) end
			end
			result.APIMethod = tostring(result.APIMethod or "POST"):upper()
			if result.APIMethod ~= "GET" and result.APIMethod ~= "POST" then result.APIMethod = "POST" end
			result.Status = "Auto AI implemented the source with " .. tostring(usedProvider or "AI") .. ". Review and test it before saving."
			return result
		end
	end
	result.Status = result.APIUrl and "Auto AI was unavailable, so the manual parser result was kept." or "Auto AI could not implement this source. Try a clearer example or fill the fields manually."
	return result
end

function SharedAIService:ApplyImplementation(result)
	if type(result) ~= "table" then return false end
	for _, key in ipairs({"APIUrl", "APIMethod", "CustomModel", "CustomHeaders", "CustomBody", "ResponsePath"}) do
		if result[key] ~= nil and tostring(result[key]) ~= "" then self.Config[key] = result[key] end
	end
	return sharedAIClean(self.Config.APIUrl) ~= ""
end

function SharedAIService:RunCustom(messages, fallbackPrompt)
	local config = self:Load()
	local effective = sharedAICopy(config)
	local source = sharedAIClean(config.APISource)
	if source == "" and (tostring(config.APIUrl or ""):find("<html", 1, true) or tostring(config.APIUrl or ""):find("puter.ai.chat", 1, true)) then source = tostring(config.APIUrl or "") end
	if source ~= "" then
		local implemented = self:InterpretSource(source, false)
		for key, value in pairs(implemented) do
			if effective[key] ~= nil and tostring(value or "") ~= "" then effective[key] = value end
		end
	end
	local url = sharedAIClean(effective.APIUrl)
	if url == "" then return nil, "Custom API URL is empty" end
	if url:find("api.puter.com/puterai/openai/v1", 1, true) and not url:find("chat/completions", 1, true) then
		url = url:gsub("/+$", "") .. "/chat/completions"
	end
	local headers = { ["Accept"] = "application/json", ["User-Agent"] = "Mozilla/5.0" }
	local decodedHeaders = sharedAIDecode(effective.CustomHeaders)
	if type(decodedHeaders) == "table" then
		for key, value in pairs(decodedHeaders) do headers[tostring(key)] = tostring(value) end
	end
	local key = sharedAIClean(effective.APIKey)
	local token = sharedAIClean(effective.APIToken)
	if key ~= "" then
		headers["x-api-key"] = key
		headers["X-API-Key"] = key
		headers["api-key"] = key
	end
	if token ~= "" then
		headers["Authorization"] = token:lower():find("bearer ", 1, true) == 1 and token or ("Bearer " .. token)
	elseif key ~= "" then
		headers["Authorization"] = "Bearer " .. key
	end
	if url:find("api.puter.com/puterai/openai", 1, true) and token == "" and key == "" then
		return nil, "Puter.js browser code cannot run inside Roblox. Paste a Puter auth token into API Token so the official OpenAI-compatible endpoint can be used."
	end
	local method = tostring(effective.APIMethod or "AUTO"):upper()
	if method == "AUTO" then method = url:find("{prompt}", 1, true) and "GET" or "POST" end
	local prompt = sharedAIMessagesToPrompt(messages, fallbackPrompt)
	if url:find("{prompt}", 1, true) then url = url:gsub("{prompt}", HttpService:UrlEncode(prompt)) end
	local body
	if method == "POST" then
		headers["Content-Type"] = headers["Content-Type"] or "application/json"
		local template = tostring(effective.CustomBody or "")
		if sharedAIClean(template) ~= "" then
			body = template
			body = body:gsub("{messages}", function() return HttpService:JSONEncode(messages) end)
			body = body:gsub("{prompt}", function() return sharedAIJSONEscape(prompt) end)
			body = body:gsub("{model}", function() return sharedAIJSONEscape(sharedAIClean(effective.CustomModel) ~= "" and effective.CustomModel or effective.Provider) end)
			body = body:gsub("{temperature}", tostring(effective.Temperature))
			body = body:gsub("{max_tokens}", tostring(effective.MaxTokens))
		else
			body = HttpService:JSONEncode({
				model = sharedAIClean(effective.CustomModel) ~= "" and effective.CustomModel or effective.Provider,
				messages = messages,
				temperature = effective.Temperature,
				max_tokens = effective.MaxTokens,
				stream = false
			})
		end
	end
	local response, code = sharedAIRawRequest(method, url, headers, body, 100)
	if response == "" then return nil, "Custom API returned an empty response" end
	if code ~= 0 and (code < 200 or code >= 300) then
		local _, err = sharedAIParseResponse(response)
		return nil, err or ("Custom API HTTP " .. tostring(code))
	end
	local responsePath = sharedAIClean(effective.ResponsePath)
	if responsePath ~= "" then
		local value = sharedAIPath(sharedAIDecode(response), responsePath)
		if value and value ~= "" then return value end
	end
	return sharedAIParseResponse(response)
end

