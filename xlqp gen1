		for _, child in ipairs(destination:GetChildren()) do
			if child:IsA("GuiObject") and child ~= Frame and child:GetAttribute("__XLQPGen1MoveableFrame") == true then siblings[#siblings+1] = child end
		end
		table.sort(siblings,function(a,b)
			if a.LayoutOrder ~= b.LayoutOrder then return a.LayoutOrder < b.LayoutOrder end
			if math.abs(a.AbsolutePosition.Y-b.AbsolutePosition.Y)>2 then return a.AbsolutePosition.Y<b.AbsolutePosition.Y end
			return a.AbsolutePosition.X<b.AbsolutePosition.X
		end)
		local insertIndex = math.clamp(tonumber(origin.Index) or (#siblings+1),1,#siblings+1)
		table.insert(siblings,insertIndex,Frame)
		for index,child in ipairs(siblings) do child.LayoutOrder=index*10 end
		if oldContainer and oldContainer ~= destination then self:NormalizeMoveOrders(oldContainer) end
		self:UpdateEditableContainer(destination)
		local flash = Instance.new("Frame")
