	local function cleanElementQuery(value)
		local parts = {}
		for word in normalizeUICommand(value):gmatch("%S+") do
			if not uiStopWords[word] then
				table.insert(parts, word)
			end
		end
		return table.concat(parts, " ")
	end

	local function elementVisible(element)
		local object = element and element.Wrapper
		if not (object and object.Parent) then return false end
		local current = object
		while current do
			if current:IsA("GuiObject") and not current.Visible then return false end
			current = current.Parent
		end
		return true
	end

	local function elementSearchText(element)
		local pieces = {tostring(element.Name or ""), tostring(element.Type or "")}
		if element.Wrapper and element.Wrapper.Parent then
			for _, object in ipairs(element.Wrapper:GetDescendants()) do
				if object:IsA("TextLabel") or object:IsA("TextButton") then
					local value = tostring(object.Text or "")
					if value ~= "" then table.insert(pieces, value) end
				end
			end
		end
		return normalizeUICommand(table.concat(pieces, " "))
	end

	local function scoreElement(element, query, wantedType)
		if not (element and element.Wrapper and element.Wrapper.Parent) then return -math.huge end
		if wantedType and tostring(element.Type or "") ~= wantedType then return -math.huge end
		local normalizedQuery = cleanElementQuery(query)
		if normalizedQuery == "" then return -math.huge end
		local name = normalizeUICommand(element.Name or "")
		local haystack = elementSearchText(element)
		local compactQuery = compactUICommand(normalizedQuery)
		local compactName = compactUICommand(name)
		local score = 0
		if compactName == compactQuery then score = score + 160 end
		if name == normalizedQuery then score = score + 150 end
		if compactName:find(compactQuery, 1, true) then score = score + 105 end
		if compactQuery:find(compactName, 1, true) then score = score + 92 end
		if haystack:find(normalizedQuery, 1, true) then score = score + 80 end
		local matched = 0
		local total = 0
		for word in normalizedQuery:gmatch("%S+") do
			total = total + 1
			if haystack:find(word, 1, true) then matched = matched + 1 end
		end
		if total > 0 then score = score + (matched / total) * 70 end
		if elementVisible(element) then score = score + 24 end
		if element.Value ~= nil then score = score + 4 end
		return score
	end

	local function findUIElement(query, wantedType)
		local best
		local bestScore = -math.huge
		for _, element in ipairs(XLQPGen1.AllElements or {}) do
			local score = scoreElement(element, query, wantedType)
			if score > bestScore then
				best = element
				bestScore = score
			end
		end
		if bestScore < 58 then return nil, bestScore end
		return best, bestScore
	end

	local function listElementNames(elementType, limit)
		local names = {}
		local seen = {}
		for _, element in ipairs(XLQPGen1.AllElements or {}) do
			if tostring(element.Type or "") == elementType and element.Name and element.Wrapper and element.Wrapper.Parent then
				local key = normalizeUICommand(element.Name)
				if key ~= "" and not seen[key] then
					seen[key] = true
					table.insert(names, tostring(element.Name))
					if #names >= (limit or 6) then break end
				end
			end
		end
		return names
	end

	local function runElementSet(element, value)
