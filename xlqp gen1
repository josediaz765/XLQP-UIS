		end
	end
	if method == "GET" then
		local ok, response = pcall(function() return game:HttpGet(url, true) end)
		if ok then return tostring(response or ""), 200 end
	elseif method == "POST" then
		local ok, response = pcall(function() return game:HttpPost(url, body or "", Enum.HttpContentType.ApplicationJson) end)
