function XLQPGen1:_UILayoutPath()
	local folder=tostring(self.Folder or "XLQPGen1")
	pcall(function()
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end
	end)
	return folder.."/ui_layout_"..tostring(game.GameId or game.PlaceId or 0)..".json"
end

function XLQPGen1:_ReadUILayout()
	if type(readfile)~="function" or type(isfile)~="function" then return {} end
	local path=self:_UILayoutPath()
	if not isfile(path) then return {} end
	local ok,raw=pcall(readfile,path)
	if not ok or type(raw)~="string" then return {} end
	local decodedOk,data=pcall(HttpService.JSONDecode,HttpService,raw)
	if decodedOk and type(data)=="table" then return data end
	return {}
end

function XLQPGen1:_EncodeUDim2(value)
	if typeof(value)~="UDim2" then return nil end
	return {XS=value.X.Scale,XO=value.X.Offset,YS=value.Y.Scale,YO=value.Y.Offset}
end

function XLQPGen1:_DecodeUDim2(value)
	if type(value)~="table" then return nil end
	return UDim2.new(
		tonumber(value.XS) or 0,
		tonumber(value.XO) or 0,
		tonumber(value.YS) or 0,
		tonumber(value.YO) or 0
	)
end

function XLQPGen1:_WriteUILayout()
	if type(writefile)~="function" then return false end
	local current=self._UILayoutState or self:_ReadUILayout()
	self._UILayoutState=current
	current.SavePosition=self._SaveUIPosition==true
	current.SaveSize=self._SaveUISize==true
	if current.SavePosition then
		if self._MainWindow then current.MainPosition=self:_EncodeUDim2(self._MainWindow.Position) end
		if self._SettingsWindow then current.SettingsPosition=self:_EncodeUDim2(self._SettingsWindow.Position) end
	else
		current.MainPosition=nil
		current.SettingsPosition=nil
	end
	if current.SaveSize then
		if self._MainWindow then current.MainSize=self:_EncodeUDim2(self._MainWindow.Size) end
		if self._SettingsWindow then current.SettingsSize=self:_EncodeUDim2(self._SettingsWindow.Size) end
	else
		current.MainSize=nil
		current.SettingsSize=nil
	end
	local ok,encoded=pcall(HttpService.JSONEncode,HttpService,current)
	if not ok then return false end
	return pcall(writefile,self:_UILayoutPath(),encoded)
end

function XLQPGen1:_QueueUILayoutSave()
	if self._ApplyingUILayout then return self end
	self._UILayoutSaveToken=(tonumber(self._UILayoutSaveToken) or 0)+1
	local token=self._UILayoutSaveToken
	if self._UILayoutSaveQueued then return self end
	self._UILayoutSaveQueued=true
	task.delay(0.2,function()
		self._UILayoutSaveQueued=false
		if token~=self._UILayoutSaveToken then
			self:_QueueUILayoutSave()
			return
		end
		if self._SaveUIPosition==true or self._SaveUISize==true then
			pcall(function() self:_WriteUILayout() end)
		end
	end)
	return self
end

function XLQPGen1:SetSaveUIPosition(value)
	self._SaveUIPosition=value==true
	self:_WriteUILayout()
	return self._SaveUIPosition
end

function XLQPGen1:GetSaveUIPosition()
	if self._SaveUIPosition==nil then
		local data=self._UILayoutState or self:_ReadUILayout()
		self._UILayoutState=data
		self._SaveUIPosition=data.SavePosition==true
	end
	return self._SaveUIPosition==true
end

function XLQPGen1:SetSaveUISize(value)
	self._SaveUISize=value==true
	self:_WriteUILayout()
	return self._SaveUISize
end

function XLQPGen1:GetSaveUISize()
	if self._SaveUISize==nil then
		local data=self._UILayoutState or self:_ReadUILayout()
		self._UILayoutState=data
		self._SaveUISize=data.SaveSize==true
	end
	return self._SaveUISize==true
end

function XLQPGen1:_ApplySavedUILayout()
	if not (self._MainWindow and self._SettingsWindow) then return self end
	local data=self._UILayoutState or self:_ReadUILayout()
	self._UILayoutState=data
	if self._SaveUIPosition==nil then self._SaveUIPosition=data.SavePosition==true end
	if self._SaveUISize==nil then self._SaveUISize=data.SaveSize==true end
	self._ApplyingUILayout=true
	if self._SaveUIPosition==true then
		local mainPos=self:_DecodeUDim2(data.MainPosition)
		local settingsPos=self:_DecodeUDim2(data.SettingsPosition)
		if mainPos then self._MainWindow.Position=mainPos end
		if settingsPos then self._SettingsWindow.Position=settingsPos end
	end
	if self._SaveUISize==true then
		local mainSize=self:_DecodeUDim2(data.MainSize)
		local settingsSize=self:_DecodeUDim2(data.SettingsSize)
		if mainSize then self._MainWindow.Size=mainSize end
		if settingsSize then self._SettingsWindow.Size=settingsSize end
	end
	self._ApplyingUILayout=false
	return self
end

