    function Dropdown:Invert()
        if not self.MultiSelect then return self end
        local values = {}
        for _, option in ipairs(self.Options or {}) do
            local optionName = type(option) == "table" and option.Name or tostring(option)
            local optionId = type(option) == "table" and option.UserId and tostring(option.UserId) or nil
            if optionName and not (self.SelectedValues[optionName] or (optionId and self.SelectedValues[optionId])) then
                table.insert(values, option)
            end
        end
        self:Set(values)
        return self
    end

