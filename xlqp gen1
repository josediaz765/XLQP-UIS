	end

	function Island:RestoreMusicOrHide()
		self.NotificationToken+=1
		local state=self.MusicState
		if type(state)=="table" and (state.Playing or state.Paused) and tostring(state.URL or "")~="" and XLQPGen1.DynamicIslandEnabled~=false then
			self:SetTrack(state)
			waveHolder.Visible=true
			self:Show()
