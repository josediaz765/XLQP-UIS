	end

	function Island:SetArtwork(image,rectSize,rectOffset)
		if image~=nil and tostring(image)~="" then XLQPAssignProperty(art,"Image",tostring(image)) end
		art.ImageRectSize=typeof(rectSize)=="Vector2" and rectSize or Vector2.new()
		art.ImageRectOffset=typeof(rectOffset)=="Vector2" and rectOffset or Vector2.new()
		return self
	end

	local pillClick = Create("TextButton", {Name = "PillClick", Size = UDim2.new(1, 0, 0, collapsedHeight), Text = "", BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 4, Parent = pill})
	AddConnection(pillClick.Activated, function() if Island.Mode=="Notification" then Island:RestoreMusicOrHide() else Island:Toggle() end end)
	AddConnection(playButton.Activated, function()
		local player = XLQPGen1._MediaPlayer
		if player and player.TogglePlay then pcall(function() player:TogglePlay() end) end
	end)
	AddConnection(prevButton.Activated, function()
		local player = XLQPGen1._MediaPlayer
		if player and player.Previous then pcall(function() player:Previous() end) end
	end)
	AddConnection(nextButton.Activated, function()
		local player = XLQPGen1._MediaPlayer
		if player and player.Next then pcall(function() player:Next() end) end
	end)

	local waveAccumulator = 0
	table.insert(self.Connections, RunService.Heartbeat:Connect(function(delta)
		if not Island.Visible or not pill.Visible or not Island.Playing then return end
		waveAccumulator += delta
		if waveAccumulator < 1/(self._PerformanceMode and 15 or 24) then return end
		local clock = os.clock()
		waveAccumulator = 0
		local loudness = 0
		local player = XLQPGen1._MediaPlayer
		if player and type(player.GetSound) == "function" then
			local ok, sound = pcall(function() return player:GetSound() end)
			if ok and sound then
				local read, value = pcall(function() return sound.PlaybackLoudness end)
				if read and type(value) == "number" then loudness = math.clamp(value / 340, 0, 1) end
			end
		end
		Island.Level = Island.Level + ((loudness - Island.Level) * 0.35)
		for index, entry in ipairs(bars) do
			local height
			if Island.Playing then
				local weight = 0.55 + 0.45 * math.abs(math.sin(clock * 6 + entry.Phase))
				local spread = 1 - math.abs((index - 3) / 3) * 0.35
				height = 5 + Island.Level * 15 * weight * spread + math.abs(math.sin(clock * 3 + entry.Phase)) * 2
            else
				height = 5
			end
			entry.Frame.Size = UDim2.fromOffset(3, math.floor(math.clamp(height, 4, 20)))
		end
	end))

	self._DynamicIsland = Island
	return Island
end

function XLQPGen1:BindDynamicIsland(player)
	player = player or self._MediaPlayer
	if not player or type(player.Subscribe) ~= "function" then return false end
	if self._DynamicIslandBound == player then return true end
	if self._DynamicIslandUnsubscribe then pcall(self._DynamicIslandUnsubscribe) self._DynamicIslandUnsubscribe=nil end
	self._DynamicIslandBound = player
	local island = self:_EnsureDynamicIsland()
	self._DynamicIslandUnsubscribe=player:Subscribe(function(state)
		if not island or not island.Gui or not island.Gui.Parent then return end
		island.MusicState=type(state)=="table" and state or nil
		if self.DynamicIslandEnabled == false then
			if island.Visible then island:Hide() end
			return
		end
		if island.Mode=="Notification" then return end
		island:SetTrack(state)
		if state and (state.Playing or state.Paused) and tostring(state.URL or "") ~= "" then
			if not island.Visible then island:Show() end
		elseif island.Visible then
			island:Hide()
		end
	end)
	return true
end

function XLQPGen1:ShowDynamicIsland(state)
	if self._SetupPresentationLock==true or self._SetupFlowOpen==true then return nil end
	self.DynamicIslandEnabled=true
	local island = self:_EnsureDynamicIsland()
	local preview=type(state)=="table" and state or {TrackName="Dynamic Island",Subtitle="Music controls ready",Playing=false,Paused=true,URL="preview://dynamic-island"}
	island:SetTrack(preview)
	island:Show()
	return island
end

