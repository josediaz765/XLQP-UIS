local function clearLiveThemeEffects()
	if liveThemeEffectConnection then liveThemeEffectConnection:Disconnect() liveThemeEffectConnection=nil end
	for _,frame in ipairs(liveThemeEffectFrames) do if frame and frame.Parent then frame:Destroy() end end
	table.clear(liveThemeEffectFrames)
	liveThemeEffectSignature=""
end

local function buildLiveThemeEffects(data)
	local effect=tostring(data and data.Effect or "None"):lower()
	if effect~="stars" and effect~="dots" and effect~="rain" and effect~="rainfall" then clearLiveThemeEffects() return end
	local count=math.clamp(math.floor(tonumber(data.EffectCount) or 20),4,40)
	if XLQPGen1._PerformanceMode then count=math.min(count,12) end
	local speed=math.clamp(tonumber(data.EffectSpeed) or .35,.05,2.5)
	local color=XLQPParseLiveColor(data.EffectColor) or Color3.fromRGB(220,232,255)
	local signature=table.concat({effect,tostring(count),tostring(speed),tostring(color)},"|")
	if signature==liveThemeEffectSignature then return end
	clearLiveThemeEffects()
	liveThemeEffectSignature=signature
	local random=Random.new()
	local particles={}
	local function addRoot(root)
		if not root then return end
		local layer=Create("Frame",{Name="XLQPLiveThemeEffects",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,Active=false,ZIndex=0,Parent=root})
		layer:SetAttribute("NoLiquidGlass",true)
		liveThemeEffectFrames[#liveThemeEffectFrames+1]=layer
		for index=1,count do
			local size=(effect=="rain" or effect=="rainfall") and random:NextInteger(8,18) or random:NextInteger(2,5)
			local particle=Create("Frame",{
				Name="Particle",
				AnchorPoint=Vector2.new(.5,.5),
				Position=UDim2.fromScale(random:NextNumber(),random:NextNumber()),
				Size=(effect=="rain" or effect=="rainfall") and UDim2.fromOffset(1,size) or UDim2.fromOffset(size,size),
				Rotation=effect=="stars" and 45 or (effect=="rain" or effect=="rainfall") and -8 or 0,
				BackgroundColor3=color,
				BackgroundTransparency=(effect=="rain" or effect=="rainfall") and .42 or random:NextNumber(.24,.62),
				BorderSizePixel=0,
				ZIndex=0,
				Parent=layer
			})
			if effect=="dots" then Create("UICorner",{CornerRadius=UDim.new(1,0),Parent=particle}) end
			particles[#particles+1]={Object=particle,X=random:NextNumber(),Y=random:NextNumber(),Phase=random:NextNumber(0,math.pi*2),Rate=random:NextNumber(.65,1.35)}
		end
	end
	addRoot(MainWindow)
	addRoot(SettingsWindow)
	addRoot(WindowStuff)
	local effectElapsed=0
	local effectInterval=1/30
	local effectIsRain=(effect=="rain" or effect=="rainfall")
	local effectIsStars=(effect=="stars")
	liveThemeEffectConnection=RunService.Heartbeat:Connect(function(delta)
		effectElapsed+=tonumber(delta) or 0
		if effectElapsed<effectInterval then return end
		if XLQPGen1._ReduceLagEnabled then effectElapsed=0 return end
		local now=os.clock()
		if (tonumber(XLQPGen1._WindowMotionPausedUntil) or 0)>now then effectElapsed=0 return end
		local runtimeState=WindowConfig and WindowConfig._LocalRegisterState
		local visibilityCheck=runtimeState and runtimeState.isGuiBranchVisible
		if type(visibilityCheck)=="function" then
			local anyVisible=false
			for _,layer in ipairs(liveThemeEffectFrames) do
				if layer and layer.Parent and layer.Visible and visibilityCheck(layer) then anyVisible=true break end
			end
			if not anyVisible then effectElapsed=0 return end
		end
		effectInterval=1/XLQPGen1:GetLiveColorFPS()
		delta=effectElapsed
		effectElapsed=0
		local drift=effectIsRain and .42 or .12
		for _,particle in ipairs(particles) do
			local object=particle.Object
			if object and object.Parent then
				particle.Y+=delta*speed*particle.Rate*drift
				particle.X+=math.sin(now*speed+particle.Phase)*delta*.012
				if particle.Y>1.06 then particle.Y=-.06 particle.X=random:NextNumber() end
				if particle.X>1.04 then particle.X=-.04 elseif particle.X<-.04 then particle.X=1.04 end
				object.Position=UDim2.fromScale(particle.X,particle.Y)
				if effectIsStars then object.BackgroundTransparency=.28+math.abs(math.sin(now*1.8+particle.Phase))*.5 end
			end
		end
	end)
	table.insert(XLQPGen1.Connections,liveThemeEffectConnection)
end

local activeLiveColorScript
local activeLiveColorScriptName
local activeLiveColorScriptContext

local function cleanupLiveColorScript(reason)
	local liveScript=activeLiveColorScript
	local context=activeLiveColorScriptContext
	activeLiveColorScript=nil
	activeLiveColorScriptName=nil
	activeLiveColorScriptContext=nil
	if not context then return end
	context.Alive=false
	local disable=liveScript and (liveScript.OnDisable or liveScript.Stop)
	if type(disable)=="function" then pcall(disable,context,tostring(reason or "theme changed")) end
	for index=#context._Tracked,1,-1 do
		local item=context._Tracked[index]
		if type(item)=="function" then
			pcall(item)
		elseif typeof(item)=="RBXScriptConnection" then
			pcall(function() item:Disconnect() end)
		elseif typeof(item)=="Instance" then
			pcall(function() item:Destroy() end)
		elseif item then
			pcall(function() item:Cancel() end)
			pcall(function() item:Destroy() end)
		end
	end
	table.clear(context._Tracked)
end

local function createLiveColorScriptContext(themeName,data)
	local context={Name=themeName,Data=data,Colors=XLQPLiveColorThemes[themeName],Library=XLQPGen1,Config=WindowConfig,RootGui=XLQPGen1Gui,MainWindow=MainWindow,SettingsWindow=SettingsWindow,TabListWindow=WindowStuff,Services={RunService=RunService,TweenService=TweenService,UserInputService=UserInputService,HttpService=HttpService},Alive=true,_Tracked={}}
	local function addLayer(root,name)
		if not root or not root.Parent then return nil end
		local layer=Create("Frame",{Name=name,Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,Active=false,ZIndex=0,Parent=root})
		layer:SetAttribute("NoLiquidGlass",true)
		context._Tracked[#context._Tracked+1]=layer
		return layer
	end
	context.MainLayer=addLayer(MainWindow,"XLQPLiveScriptLayer")
	context.SettingsLayer=addLayer(SettingsWindow,"XLQPLiveScriptLayer")
	context.TabListLayer=addLayer(WindowStuff,"XLQPLiveScriptTabListLayer")
	function context:GetLayers()
		local layers={}
		if self.MainLayer then layers[#layers+1]=self.MainLayer end
		if self.SettingsLayer then layers[#layers+1]=self.SettingsLayer end
		if self.TabListLayer then layers[#layers+1]=self.TabListLayer end
		return layers
	end
	function context:GetLayer(name)
		local key=tostring(name or "Main"):lower()
		if key:find("setting",1,true) then return self.SettingsLayer end
		if key:find("tab",1,true) or key:find("side",1,true) then return self.TabListLayer end
		return self.MainLayer
	end
	function context:Track(item)
		if item~=nil then self._Tracked[#self._Tracked+1]=item end
		return item
	end
	function context:Create(className,properties,parent)
		if not self.Alive then return nil end
		local object=Instance.new(tostring(className))
		for property,value in pairs(type(properties)=="table" and properties or {}) do
			if property~="Parent" then pcall(function() object[property]=value end) end
		end
		object.Parent=parent or (type(properties)=="table" and properties.Parent) or self.MainLayer
		return self:Track(object)
	end
	function context:Connect(signal,callback)
		if not self.Alive or not signal or type(callback)~="function" then return nil end
		return self:Track(signal:Connect(function(...)
			if self.Alive then pcall(callback,...) end
		end))
	end
	function context:OnFrame(callback)
		local started=os.clock()
		local elapsed=0
		return self:Connect(RunService.Heartbeat,function(deltaTime)
			if (tonumber(XLQPGen1._WindowMotionPausedUntil) or 0)>os.clock() then return end
			local runtimeState=WindowConfig and WindowConfig._LocalRegisterState
			local visibilityCheck=runtimeState and runtimeState.isGuiBranchVisible
			if type(visibilityCheck)=="function" then
				local mainVisible=self.MainLayer and self.MainLayer.Parent and visibilityCheck(self.MainLayer)
				local settingsVisible=self.SettingsLayer and self.SettingsLayer.Parent and visibilityCheck(self.SettingsLayer)
				local tabListVisible=self.TabListLayer and self.TabListLayer.Parent and visibilityCheck(self.TabListLayer)
				if not mainVisible and not settingsVisible and not tabListVisible then return end
			end
			elapsed+=tonumber(deltaTime) or 0
			if elapsed<1/XLQPGen1:GetLiveColorFPS() then return end
			local frameDelta=elapsed
			elapsed=0
			callback(frameDelta,os.clock()-started,self)
		end)
	end
	function context:Tween(object,tweenInfo,properties)
		if not self.Alive or typeof(object)~="Instance" then return nil end
		local info=typeof(tweenInfo)=="TweenInfo" and tweenInfo or TweenInfo.new(tonumber(tweenInfo) or .25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
		local tween=TweenService:Create(object,info,properties or {})
		self:Track(tween)
		tween:Play()
		return tween
	end
	function context:Delay(seconds,callback)
		local cancelled=false
		self:Track(function() cancelled=true end)
		task.delay(math.max(0,tonumber(seconds) or 0),function()
			if self.Alive and not cancelled and type(callback)=="function" then pcall(callback,self) end
		end)
	end
	function context:Spawn(callback)
		if not self.Alive or type(callback)~="function" then return nil end
		local thread=task.spawn(function() pcall(callback,self) end)
		self:Track(function() pcall(task.cancel,thread) end)
		return thread
	end
	function context:BindElement(target,config)
		local binding=XLQPGen1:BindLiveColor(target,config or {Theme=self.Name})
		if binding then self:Track(function() if target and target.Parent then XLQPGen1:UnbindLiveColor(target) end end) end
		return binding
	end
	function context:SetBackground(image,transparency)
		return applyCustomBackgroundAsset(image,transparency)
	end
	function context:ParseColor(value)
		return XLQPParseLiveColor(value)
	end
	return context
end

local function runLiveColorScript(themeName,data)
	local liveScript=themeName and XLQPGen1.LiveColorScripts[themeName] or nil
	if not liveScript then cleanupLiveColorScript("theme changed") return false end
	if activeLiveColorScript==liveScript and activeLiveColorScriptName==themeName and activeLiveColorScriptContext and activeLiveColorScriptContext.Alive then
		if activeLiveColorScriptContext.SettingsLayer or not (SettingsWindow and SettingsWindow.Parent) then return true end
	end
	cleanupLiveColorScript("theme changed")
	local context=createLiveColorScriptContext(themeName,data)
	activeLiveColorScript=liveScript
	activeLiveColorScriptName=themeName
	activeLiveColorScriptContext=context
	local enable=liveScript.OnEnable or liveScript.Run or liveScript.Code
	if type(enable)=="function" then
		local ok,cleanup=pcall(enable,context)
		if ok and type(cleanup)=="function" then context:Track(cleanup) end
	end
	local update=liveScript.OnUpdate or liveScript.Update
	if type(update)=="function" then
		context:OnFrame(function(deltaTime,elapsed) update(context,deltaTime,elapsed) end)
	end
	return true
end

XLQPGen1._DeactivateLiveColorScript=function(self,reason)
	cleanupLiveColorScript(reason)
	return self
end

XLQPGen1._ApplyLiveThemeVisuals=function(self,themeName,backgroundEnabled)
	local passiveSetup=self._SetupPassivePreset==true
	if self._ReduceLagEnabled and not self._LiveColorAllowedInReduceLag then
		cleanupLiveColorScript("reduce-lag")
		clearLiveThemeEffects()
		return self
	end
	local performanceLive=self._ReduceLagEnabled==true or self._PerformanceMode==true
	local data=themeName and self:GetLiveColorThemeData(themeName) or nil
	if backgroundEnabled==nil then backgroundEnabled=WindowConfig.LiveColorBackground==true end
	if passiveSetup then backgroundEnabled=false end
	local liveEffectsEnabled=not passiveSetup and (backgroundEnabled or (self.LiveColorElementsEnabled~=false and WindowConfig.LiveColorElements~=false))
	if themeName and liveEffectsEnabled then runLiveColorScript(themeName,data) else cleanupLiveColorScript(passiveSetup and "setup-preset" or "disabled") end
	if not passiveSetup and WindowConfig.LiveColorThemeImages~=false and data and data.CustomMedia==true and tostring(data.MediaLink or "")~="" then
		if not liveThemePreviousBackground then
			liveThemePreviousBackground={Enabled=WindowConfig.URLBackgroundEnabled==true,Link=WindowConfig._LocalRegisterState.currentBackgroundLink or "",Transparency=WindowConfig.BackgroundTransparency or 0}
		end
		local customLink=tostring(data.MediaLink or "")
		local customType=tostring(data.MediaType or self:_DetectCustomLiveMediaType(customLink))
		local customSignature=customType.."|"..customLink
		liveThemeImageSource="__custom__"..customLink
		clearLiveThemeEffects()
		if self._AppliedCustomMediaSignature==customSignature then
			if self._SyncCustomLiveThemeSurfaces then pcall(function() self:_SyncCustomLiveThemeSurfaces() end) end
		else
			task.spawn(function()
				self:_ApplyCustomLiveThemeMedia(data)
			end)
		end
		return self
	end
	local image=WindowConfig.LiveColorThemeImages~=false and WindowConfig.URLBackgroundEnabled~=true and data and tostring(data.BackgroundImage or data.Image or "") or ""
	if performanceLive and image:find("images.unsplash.com",1,true) then image=image:gsub("w=%d+","w=900"):gsub("q=%d+","q=70") end
	if image~="" then
		if not liveThemePreviousBackground then
			liveThemePreviousBackground={Enabled=WindowConfig.URLBackgroundEnabled==true,Link=WindowConfig._LocalRegisterState.currentBackgroundLink or "",Transparency=WindowConfig.BackgroundTransparency or 0}
		end
		local needsImageLoad=liveThemeImageSource~=image or thumbnailOverlay.Image=="" or not thumbnailOverlay.Visible or tabListThumbnailOverlay.Image=="" or not tabListThumbnailOverlay.Visible
		if needsImageLoad then
			liveThemeImageSource=image
			local expected=image
			task.spawn(function()
				if liveThemeImageSource~=expected or WindowConfig.LiveColorThemeImages==false then return end
				local imageTransparency=math.clamp(tonumber(data.ImageTransparency) or .12,0,.28)
				applyCustomBackgroundAsset(expected,imageTransparency,true,true)
				thumbnailOverlay.ImageTransparency=imageTransparency
				settingsThumbnailOverlay.ImageTransparency=thumbnailOverlay.ImageTransparency
				tabListThumbnailOverlay.ImageTransparency=thumbnailOverlay.ImageTransparency
				tabListThumbnailOverlay.ImageColor3=Color3.new(1,1,1)
				tabListThumbnailOverlay.Visible=not performanceLive
				MainWindow.BackgroundTransparency=WindowConfig.LiveColorBackground==true and .82 or 1
				SettingsWindow.BackgroundTransparency=WindowConfig.LiveColorBackground==true and .82 or 1
			end)
		end
		MainWindow.BackgroundTransparency=backgroundEnabled and .82 or 1
		SettingsWindow.BackgroundTransparency=backgroundEnabled and .82 or 1
		if liveEffectsEnabled then buildLiveThemeEffects(data) else clearLiveThemeEffects() end
	else
		clearLiveThemeEffects()
		if liveThemePreviousBackground then
			local previous=liveThemePreviousBackground
			liveThemePreviousBackground=nil
			liveThemeImageSource=""
			cleanupCurrentMedia()
			WindowConfig.BackgroundEnabled=WindowConfig.URLBackgroundEnabled==true or previous.Enabled
			WindowConfig._LocalRegisterState.currentBackgroundLink=previous.Link
			WindowConfig.BackgroundTransparency=previous.Transparency
			if WindowConfig.BackgroundEnabled and previous.Link~="" then applyCustomBackgroundAsset(previous.Link,previous.Transparency) end
		end
	end
	return self
end

