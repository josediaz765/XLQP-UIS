function XLQPGen1:SafeCallback(Callback, Context, ...)
	if type(Callback) ~= "function" then
		return true
	end
	local Args = {...}
	local Traceback = debug and debug.traceback or function(Error)
		return tostring(Error)
	end
	local Success, Result = xpcall(function()
		return Callback(table.unpack(Args))
	end, Traceback)
	if not Success then
		local errorText=tostring(Result or "")
		if not errorText:find("re%-entrancy depth") and not errorText:find("Maximum event") then
			reportCallbackError(Context, Result)
		end
		return false, Result
	end
	return true, Result
end

