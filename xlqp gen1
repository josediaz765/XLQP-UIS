		for _,entry in ipairs(scalePresetButtons) do
			local selected=math.abs(result.Scale-entry.Scale)<=0.035
			entry.Button.BackgroundColor3=selected and selectedAccent:Lerp(palette.Surface,0.78) or palette.Surface
			entry.Mini.BackgroundColor3=selected and selectedAccent or palette.Inactive
			local stroke=entry.Button:FindFirstChildOfClass("UIStroke")
			if stroke then stroke.Color=selected and selectedAccent or palette.Stroke stroke.Thickness=selected and 1.7 or 1 end
		end
