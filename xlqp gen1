			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			beginDrag(input, false)
		end)
		userInputService.InputChanged:Connect(function(input)
			if not (pending or dragging) or not activeInput then return end
			local matches = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput or activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
			if not matches then return end
