	local function detectMediaType(url)
		url = tostring(url or "")
		if tostring(url):match("^rbxassetid://") or tostring(url):match("^%d+$") then return "MP3" end
		local lower=url:lower()
		if lower:find("youtube.com",1,true) or lower:find("youtu.be",1,true) or (#url==11 and url:match("^[%w_-]+$")) then return "YOUTUBE" end
		if lower:match("%.mp3[%?#]?") or lower:match("%.wav[%?#]?") or lower:match("%.ogg[%?#]?") or lower:match("%.flac[%?#]?") or lower:match("%.m4a[%?#]?") then return "MP3" end
		if lower:match("%.mp4[%?#]?") or lower:match("%.webm[%?#]?") or lower:match("%.mov[%?#]?") then return "MP4" end
		return nil
	end

	local function extractFileName(url)
		local matched = url:match(".+/([^/?#]+)%.%w+$") or url:match(".+/([^/?#]+)") or url:match(".+/([^/]+)$")
		return matched or ("mediafile_" .. string.sub(tostring(os.time()), -5))
	end

	local function getMediaState()
		local item=currentPlayingIndex>0 and playlist[currentPlayingIndex] or nil
		local url=tostring(item and (item.url or item.Url or item.URL or item.SoundId) or TextboxActual.Text or "")
		local stateIndex=currentPlayingIndex
		if not item and url~="" then
			for index,candidate in ipairs(playlist) do
				local candidateUrl=tostring(candidate.url or candidate.Url or candidate.URL or candidate.SoundId or "")
				if candidateUrl==url then item=candidate stateIndex=index break end
			end
		end
		return {
			Playing=currentMediaInstance~=nil and currentMediaInstance.Parent~=nil and not isPaused,
			Paused=isPaused,
			Index=stateIndex,
			TrackName=item and (item.name or item.Name or item.Title) or (url~="" and extractFileName(url) or "No song loaded"),
			URL=url,
			Image=item and (item.Image or item.image),
			Volume=currentVolume,
			Pitch=currentPitch,
			Loop=loopOne,
			AutoPlay=autoPlayNext,
			Preset=currentPreset,
			Playlist=playlist,
			Instance=currentMediaInstance
		}
	end
	
