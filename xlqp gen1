                subtitle.TextTruncate = Enum.TextTruncate.AtEnd
                subtitle.ZIndex = logoButton.ZIndex + 1
                subtitle.Parent = logoButton
            end
        end

        layoutTabListLogo(logoButton)

        if type(logoConfig.Callback) == "function" then
            logoButton.Activated:Connect(function()
                task.spawn(logoConfig.Callback, window, logoButton)
            end)
        end

        local profile = sideFrame:FindFirstChild("ProfileBar")
        local profileHeight = profile and profile.Visible and math.max(50, profile.AbsoluteSize.Y, profile.Size.Y.Offset) or 0
        holder.Position = UDim2.new(0, 0, 0, logoHeight + headerGap)
        holder.Size = UDim2.new(1, 0, 1, -(logoHeight + headerGap + profileHeight))
        holder.CanvasPosition = Vector2.new(0, 0)
        window.TabListLogoFrame = logoButton
        return logoButton
    end

