				MediaCtl.Effect2=Create("ReverbSoundEffect",{Name="XLQPGen1MediaEffect",DecayTime=2.4,Density=0.55,Diffusion=0.7,WetLevel=-14,DryLevel=0,Parent=currentMediaInstance})
			elseif currentPreset=="Slowed" then
