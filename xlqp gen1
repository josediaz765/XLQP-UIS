	function Bytebeat:Generate(autoPlay)
		if not writefile or not (getcustomasset or getsynasset) then status.Text="writefile/getcustomasset missing" XLQPGen1:MakeNotification({Name="Bytebeat",Content="Executor does not support bytebeat file playback.",Time=4}) return end
		local mode=tostring(self.CurrentMode or (self.Mode and self.Mode.Value) or BytebeatConfig.Mode or "Bytebeat")
		local source=self.Code:Get()
		local generationSettings=settingsSignature()
		local compact=tostring(source or ""):gsub("%s+","")
		if compact:find("111110000001111111",1,true) and compact:find("00055522227744440005552222774422",1,true) then
			mode="Floatbeat"
			self.ForceFloatbeat=true
			status.Text="Generating floatbeat..."
		else
			self.ForceFloatbeat=false
		end
		local fn,err=XLQPGen1.BytebeatTools:Compile(source,mode)
		if not fn then status.Text="Compile failed" XLQPGen1:MakeNotification({Name="Bytebeat",Content=tostring(err),Time=4}) return end
