function XLQPGen1:RefreshKeybindFrame()
	self:_EnsureKeybindFrame()
	local body = self.KeybindFrame and self.KeybindFrame:FindFirstChild("Body")
	if not body then return end
	for _, child in ipairs(body:GetChildren()) do
		if not child:IsA("UIListLayout") then child:Destroy() end
	end
	local count = 0
	for _, element in ipairs(self.AllElements or {}) do
		local key = element.Value or element.BindValue or element.Bind
		local name = element.Name or element.Title or element.Type or "Bind"
		local include = false
		if element.Type == "Bind" then include = true end
		if element.Type == "Toggle" and element.BindValue and element.BindValue ~= "" then include = true end
		if include and element.MenuVisible~=false then
			count += 1
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -4, 0, 24)
			row.BackgroundTransparency = 1
			row.LayoutOrder = count
			row.ZIndex = 9502
			row.Parent = body
			local text = createSettingsLabel(row, "[" .. tostring(key or "None") .. "] " .. tostring(name), 13, false)
			text.Size = UDim2.new(1, -10, 1, 0)
			text.Position = UDim2.new(0, 6, 0, 0)
			text.Font = Enum.Font.Code
			text.TextColor3 = Color3.fromRGB(170, 170, 175)
			text.TextTruncate = Enum.TextTruncate.AtEnd
			text.TextSize = 11
			text.ZIndex = 9503
		end
	end
	if count == 0 then
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -4, 0, 24)
		row.BackgroundTransparency = 1
		row.ZIndex = 9502
		row.Parent = body
		local text = createSettingsLabel(row, "No keybinds registered yet.", 11, false)
		text.Size = UDim2.new(1, -10, 1, 0)
		text.Position = UDim2.new(0, 6, 0, 0)
		text.Font = Enum.Font.Code
		text.TextColor3 = Color3.fromRGB(130, 130, 135)
	end
	local layout = body:FindFirstChildOfClass("UIListLayout")
	task.defer(function()
		if layout and body then body.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10) end
	end)
end

