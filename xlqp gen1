	function XLQPGen1:SetPluginsEnabled(enabled)
		enabled=enabled==true
		WindowConfig.PluginsEnabled=enabled
		if PluginsButtonFrame then PluginsButtonFrame.Visible=enabled end
		if not enabled and pluginsVisible then closePluginsWindow() end
		return self
	end
