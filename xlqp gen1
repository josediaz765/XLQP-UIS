function XLQPGen1:Haptic(strength, duration)
	if self.HapticsEnabled ~= true then return false end
	local now = os.clock()
	if now - (self._HapticLast or 0) < 0.055 then return false end
	self._HapticLast = now
	local power = tonumber(strength) or 0.45
	local length = tonumber(duration) or tonumber(self.HapticsDuration) or 0.035
	task.spawn(function()
		pcall(function()
			local inputType = Enum.UserInputType.Touch
			if not HapticService:IsVibrationSupported(inputType) then
				inputType = Enum.UserInputType.Gamepad1
			end
			if not HapticService:IsVibrationSupported(inputType) then return end
			local motor = Enum.VibrationMotor.Small
			pcall(function() HapticService:SetMotor(inputType, motor, power) end)
			task.wait(length)
			pcall(function() HapticService:SetMotor(inputType, motor, 0) end)
		end)
	end)
	return true
end

XLQPGen1.PlayHaptic = XLQPGen1.Haptic

local XLQPDragPending=setmetatable({},{__mode="k"})
local XLQPDragFlushBound=false
local function XLQPQueueDragPosition(main,position)
	if not main then return end
	local motionClock=os.clock()
	XLQPGen1._WindowDragActiveUntil=motionClock+0.14
	XLQPGen1._WindowMotionPausedUntil=math.max(tonumber(XLQPGen1._WindowMotionPausedUntil) or 0,motionClock+0.14)
	XLQPDragPending[main]=position
	if XLQPDragFlushBound then return end
	XLQPDragFlushBound=true
	local connection
	connection=AddConnection(RunService.RenderStepped,function()
		local moved=false
		for frame,pending in pairs(XLQPDragPending) do
			XLQPDragPending[frame]=nil
			if frame and frame.Parent and frame.Position~=pending then
				frame.Position=pending
				moved=true
			end
		end
		if moved then
			local now=os.clock()
			XLQPGen1._WindowDragActiveUntil=now+0.2
			XLQPGen1._WindowMotionPausedUntil=math.max(tonumber(XLQPGen1._WindowMotionPausedUntil) or 0,now+0.2)
		end
		if next(XLQPDragPending)==nil then
			XLQPDragFlushBound=false
			if connection then connection:Disconnect() connection=nil end
		end
	end)
end
 function MakeDraggable(DragPoint, Main)
	local s, e = pcall(function()
		if not DragPoint or not Main or not DragPoint:IsA("GuiObject") or not Main:IsA("GuiObject") then return end
		pcall(function()
			if Main:IsDescendantOf(DragPoint) then
				DragPoint, Main = Main, DragPoint
			end
		end)
		local state={Dragging=false,Mode=nil,Touch=nil,StartPointer=nil,StartPosition=nil,TouchChanged=nil}
		local boundSources=setmetatable({},{__mode="k"})
		local function rawPoint(position)
			return Vector2.new(position.X,position.Y)
		end
		local function visibleObject(object)
			local current=object
			while current do
				if current:IsA("GuiObject") and current.Visible==false then return false end
				if current:IsA("LayerCollector") and current.Enabled==false then return false end
				if current==DragPoint then break end
				current=current.Parent
			end
			return current==DragPoint
		end
		local function inside(object,point)
			if not object or not object.Parent or not visibleObject(object) then return false end
			local p=object.AbsolutePosition
			local z=object.AbsoluteSize
			return z.X>0 and z.Y>0 and point.X>=p.X and point.X<=p.X+z.X and point.Y>=p.Y and point.Y<=p.Y+z.Y
		end
		local function resolveHitPoint(position)
			local point=rawPoint(position)
			if inside(DragPoint,point) then return point end
			local ok,inset=pcall(function() return GuiService:GetGuiInset() end)
			if ok and typeof(inset)=="Vector2" then
				local minus=point-inset
				if inside(DragPoint,minus) then return minus end
				local plus=point+inset
				if inside(DragPoint,plus) then return plus end
			end
			return nil
		end
		local function blockedByControl(point)
			for _,object in ipairs(DragPoint:GetDescendants()) do
				if (object:IsA("GuiButton") or object:IsA("TextBox") or object:IsA("ScrollingFrame")) and inside(object,point) then
					return true
				end
			end
			return false
		end
		local function setMotionActive(duration)
			local now=os.clock()
			XLQPGen1._WindowDragActiveUntil=now+(duration or 0.2)
			XLQPGen1._WindowMotionPausedUntil=math.max(tonumber(XLQPGen1._WindowMotionPausedUntil) or 0,now+(duration or 0.2))
		end
		local function updateDrag(position)
			if not state.Dragging or not state.StartPointer or not state.StartPosition or not Main.Parent then return end
			local delta=rawPoint(position)-state.StartPointer
			Main.Position=UDim2.new(state.StartPosition.X.Scale,state.StartPosition.X.Offset+delta.X,state.StartPosition.Y.Scale,state.StartPosition.Y.Offset+delta.Y)
			setMotionActive(0.18)
		end
		local function finishDrag()
			if not state.Dragging then return end
			state.Dragging=false
			state.Mode=nil
			state.Touch=nil
			state.StartPointer=nil
			state.StartPosition=nil
			if state.TouchChanged then state.TouchChanged:Disconnect() state.TouchChanged=nil end
			setMotionActive(0.08)
			pcall(function() Main:SetAttribute("XLQPWindowDragging",false) end)
		end
		local function beginDrag(input,globalTouch)
			if state.Dragging then return end
			local inputType=input.UserInputType
			if inputType~=Enum.UserInputType.MouseButton1 and inputType~=Enum.UserInputType.Touch then return end
			local hitPoint=resolveHitPoint(input.Position)
			if not hitPoint then return end
			if blockedByControl(hitPoint) then return end
			state.Dragging=true
			state.Mode=inputType==Enum.UserInputType.Touch and "touch" or "mouse"
			state.Touch=state.Mode=="touch" and input or nil
			state.StartPointer=rawPoint(input.Position)
			if state.Mode=="mouse" then
				local location=UserInputService:GetMouseLocation()
				state.StartPointer=Vector2.new(location.X,location.Y)
			end
			state.StartPosition=Main.Position
			XLQPDragPending[Main]=nil
			setMotionActive(0.25)
			pcall(function() Main:SetAttribute("XLQPWindowDragging",true) end)
			if state.Touch then
				if state.TouchChanged then state.TouchChanged:Disconnect() end
				state.TouchChanged=AddConnection(state.Touch.Changed,function()
					if not state.Dragging or state.Touch~=input then return end
					if input.UserInputState==Enum.UserInputState.End or input.UserInputState==Enum.UserInputState.Cancel then
						finishDrag()
					else
						updateDrag(input.Position)
					end
				end)
			end
		end
		local function bindSource(object)
			if not object or boundSources[object] or not object:IsA("GuiObject") then return end
			if object:IsA("GuiButton") or object:IsA("TextBox") or object:IsA("ScrollingFrame") then return end
			boundSources[object]=true
			pcall(function() object.Active=true end)
			AddConnection(object.InputBegan,function(input)
				if input.UserInputType~=Enum.UserInputType.Touch then beginDrag(input,false) end
			end)
		end
		bindSource(DragPoint)
		for _,descendant in ipairs(DragPoint:GetDescendants()) do bindSource(descendant) end
		AddConnection(DragPoint.DescendantAdded,bindSource)
		AddConnection(UserInputService.InputBegan,function(input)
			if input.UserInputType==Enum.UserInputType.Touch then beginDrag(input,true) end
		end)
		AddConnection(UserInputService.InputChanged,function(input)
			if not state.Dragging then return end
			if state.Mode=="touch" then
				if input==state.Touch then updateDrag(input.Position) end
			elseif state.Mode=="mouse" and input.UserInputType==Enum.UserInputType.MouseMovement then
				updateDrag(input.Position)
			end
		end)
		pcall(function()
			AddConnection(UserInputService.TouchMoved,function(input)
				if state.Dragging and state.Mode=="touch" then
					if input==state.Touch then updateDrag(input.Position) end
				end
			end)
			AddConnection(UserInputService.TouchEnded,function(input)
				if state.Dragging and state.Mode=="touch" and input==state.Touch then finishDrag() end
			end)
		end)
		AddConnection(UserInputService.InputEnded,function(input)
			if not state.Dragging then return end
			if state.Mode=="mouse" and input.UserInputType==Enum.UserInputType.MouseButton1 then
				finishDrag()
			elseif state.Mode=="touch" and input.UserInputType==Enum.UserInputType.Touch and input==state.Touch then
				finishDrag()
			end
		end)
		AddConnection(RunService.RenderStepped,function()
			if state.Dragging and state.Mode=="mouse" then
				local location=UserInputService:GetMouseLocation()
				updateDrag(Vector3.new(location.X,location.Y,0))
			end
		end)
	end)
	if not s then warn("XLQPGen1 Error: ", e) end
end

function XLQPGen1:_BeginOptimizedStartupBuild(config)
	config=type(config)=="table" and config or {}
	if self._StartupBuildActive then return self end
	self._StartupBuildActive=true
	self._StartupFinalizing=false
	self._StartupBuildBudget=math.clamp(tonumber(config.BuildFrameBudget or config.StartupFrameBudget or config.LoadingFrameBudget) or 0.0024,0.0015,0.008)
	self._StartupBuildMinOps=math.max(4,math.floor(tonumber(config.BuildBatchMinOps or config.StartupBatchMinOps) or 8))
	self._StartupBuildSliceStarted=os.clock()
	self._StartupBuildOps=0
	self._StartupPendingText=false
	self._StartupPendingLiveColor=false
	self._StartupPendingLiveColorWatcher=false
	self._StartupPendingLiquidGlass=false
	self._StartupPendingSetupContrast=false
	self._StartupFinalizers={}
	self._StartupBuildYieldCount=0
	return self
end

function XLQPGen1:_StartupBuildCheckpoint(force)
	if not self._StartupBuildActive or self._StartupFinalizing then return false end
	self._StartupBuildOps=(self._StartupBuildOps or 0)+1
	local now=os.clock()
	local started=tonumber(self._StartupBuildSliceStarted) or now
	local elapsed=now-started
	if force~=true and ((self._StartupBuildOps or 0)<(self._StartupBuildMinOps or 8) or elapsed<(self._StartupBuildBudget or 0.0024)) then
		return false
	end
	self._StartupBuildOps=0
	local canYield=true
	if coroutine and type(coroutine.isyieldable)=="function" then canYield=coroutine.isyieldable() end
	if not canYield then return false end
	self._StartupBuildYieldCount=(self._StartupBuildYieldCount or 0)+1
	task.wait()
	self._StartupBuildSliceStarted=os.clock()
	return true
end

function XLQPGen1:_QueueStartupFinalizer(callback)
	if self._StartupBuildActive and type(callback)=="function" then
		self._StartupFinalizers=self._StartupFinalizers or {}
		self._StartupFinalizers[callback]=true
		return true
	end
	return false
end

function XLQPGen1:_AbortOptimizedStartupBuild()
	self._StartupBuildActive=false
	self._StartupFinalizing=false
	self._StartupFinalizers=nil
	self._StartupPendingText=false
	self._StartupPendingLiveColor=false
	self._StartupPendingLiveColorWatcher=false
	self._StartupPendingLiquidGlass=false
	self._StartupPendingSetupContrast=false
	return self
end

function XLQPGen1:_FinishOptimizedStartupBuild()
	if not self._StartupBuildActive then return self end
	self._StartupFinalizing=true
	self._StartupBuildActive=false
	local budget=math.clamp(tonumber(self._StartupBuildBudget) or 0.0024,0.0015,0.008)
	local slice=os.clock()
	local canYield=true
	pcall(function()
		if coroutine and type(coroutine.isyieldable)=="function" then canYield=coroutine.isyieldable() end
	end)
	local function yieldIfNeeded(force)
		if canYield and (force==true or os.clock()-slice>=budget) then
			task.wait()
			slice=os.clock()
		end
	end
	local finalizers=self._StartupFinalizers or {}
	self._StartupFinalizers=nil
	for callback in pairs(finalizers) do
		pcall(callback)
		yieldIfNeeded()
	end
	yieldIfNeeded(true)
	if self._TextObjectRegistry then
		for object in pairs(self._TextObjectRegistry) do
			if object and object.Parent then
				pcall(XLQPApplyTextObject,object)
			end
			yieldIfNeeded()
		end
	end
	yieldIfNeeded(true)
	if type(self.RefreshAdaptiveWindows)=="function" then
		pcall(function() self:RefreshAdaptiveWindows(true) end)
	end
	yieldIfNeeded(true)
	if type(self._RefreshWindowLiveColor)=="function" then
		pcall(function() self:_RefreshWindowLiveColor() end)
	end
	yieldIfNeeded(true)
	if self._StartupPendingLiveColorWatcher and type(self._StartLiveColorThemeWatcher)=="function" then
		pcall(function() self:_StartLiveColorThemeWatcher() end)
	end
	if self._StartupPendingLiquidGlass and type(self._ApplyLiquidGlassNow)=="function" then
		yieldIfNeeded(true)
		pcall(function() self:_ApplyLiquidGlassNow(true) end)
	end
	yieldIfNeeded(true)
	if type(self._SyncPerformanceGradients)=="function" then
		pcall(function() self:_SyncPerformanceGradients(self._ReduceLagEnabled==true) end)
	end
	if type(self._RefreshWidgetCorners)=="function" then
		pcall(function() self:_RefreshWidgetCorners() end)
	end
	if type(self._RefreshWidgetsBetaButton)=="function" then
		pcall(function() self:_RefreshWidgetsBetaButton() end)
	end
	yieldIfNeeded(true)
	if type(self._ApplyLayerOrders)=="function" then
		pcall(function() self:_ApplyLayerOrders() end)
	end
	yieldIfNeeded(true)
	if type(self.RefreshInputLayers)=="function" then
		pcall(function() self:RefreshInputLayers() end)
	end
	self._SearchIndexVersion=(self._SearchIndexVersion or 0)+1
	self._StartupPendingText=false
	self._StartupPendingLiveColor=false
	self._StartupPendingLiveColorWatcher=false
	self._StartupPendingLiquidGlass=false
	self._StartupFinalizing=false
	self._StartupBuildSliceStarted=nil
	self._StartupBuildOps=0
	if type(self._MarkUIBuildActivity)=="function" then pcall(function() self:_MarkUIBuildActivity() end) end
	return self
end

 function Create(Name, Properties, Children)
	local Object = Instance.new(Name)
	if Name == "TextBox" then
		Object.Text = ""
		Object.ClearTextOnFocus = false
		Object.Active = true
		Object.Selectable = true
		pcall(function() Object.TextEditable = true end)
	end
	if typeof(Properties) == "Instance" then
		Object.Parent = Properties
		Properties = nil
	end
	if typeof(Children) == "Instance" then
		Children = {Children}
	end
	if type(Properties) == "table" then
		for i, v in next, Properties do
			XLQPAssignProperty(Object, i, v)
		end
	end
	if type(Children) == "table" then
		for _, v in next, Children do
			if typeof(v) == "Instance" then
				v.Parent = Object
			end
		end
	end
	if XLQPIsTextObject(Object) and type(Properties) == "table" and Properties.RichText ~= nil then
		Object:SetAttribute("XLQPForceRichText", Properties.RichText == true)
	end
	if Name=="UIGradient" and XLQPGen1._ReduceLagEnabled and Object.Name~="XLQPLiveColor" then
		Object:SetAttribute("XLQPPerformanceRestoreEnabled",Object.Enabled==true)
		Object.Enabled=false
	end
	XLQPApplyTextObject(Object)
	if Object:IsA("UIStroke") and Object.Parent and XLQPIsTextObject(Object.Parent) and Object.ApplyStrokeMode ~= Enum.ApplyStrokeMode.Border then
		if Object.Parent:IsA("TextButton") then Object.ApplyStrokeMode=Enum.ApplyStrokeMode.Border else Object.Enabled=false end
	end
	if XLQPGen1._StartupBuildActive then XLQPGen1:_StartupBuildCheckpoint(false) end
	return Object
end

 function CreateElement(ElementName, ElementFunction)
