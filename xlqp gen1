local function XLQPSetupEncodeState(state)
	local copy=XLQPSetupClone(state)
	if type(copy)=="table" and typeof(copy.Accent)=="Color3" then
		copy.Accent={__type="Color3",R=copy.Accent.R,G=copy.Accent.G,B=copy.Accent.B}
