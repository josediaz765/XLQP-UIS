	local function extractAIText(res)
		local decoded
		if type(res)=="table" then
			decoded=res
		else
			pcall(function() decoded=HttpService:JSONDecode(tostring(res or "")) end)
		end
		if decoded then
			if decoded.choices and decoded.choices[1] and decoded.choices[1].message and decoded.choices[1].message.content then return tostring(decoded.choices[1].message.content) end
			if decoded.choices and decoded.choices[1] and decoded.choices[1].text then return tostring(decoded.choices[1].text) end
			if decoded.message and decoded.message.content then return tostring(decoded.message.content) end
			if decoded.content then return tostring(decoded.content) end
			if decoded.text then return tostring(decoded.text) end
			if decoded.response then return tostring(decoded.response) end
			if decoded.answer then return tostring(decoded.answer) end
			if decoded.reasoning and not decoded.tool_calls then return tostring(decoded.reasoning) end
			if decoded.output then
				if type(decoded.output)=="table" then return table.concat(decoded.output,"\n") end
				return tostring(decoded.output)
			end
			if type(decoded)=="table" then return "" end
		end
		return tostring(res or "")
	end
