 function typeWrite(label, text, delay)
    local token = XLQPGen1._TypewriterToken
    if typeof(text) ~= "string" then
        text = text == nil and "" or tostring(text)
    end
    if label == WindowName then setTypewriterTitleText("") else label.Text = "" end
    local sec = tonumber(WindowConfig.soundsec) or 0.035
    for i = 1, #text do
        if isTypewriterPaused() or token ~= XLQPGen1._TypewriterToken or not MainWindow.Visible then
            pcall(function() XLQPGen1._TypeSound:Stop() end)
            return
        end
        local ch = text:sub(i, i)
        if ch ~= " " and not muteTypewriter and XLQPGen1._TypeSound.SoundId ~= "" then
            XLQPGen1._TypeSound.TimePosition = 0
            XLQPGen1._TypeSound:Play()
            task.delay(sec, function() XLQPGen1._TypeSound:Stop() end)
        end
        if label == WindowName then
            setTypewriterTitleText(label.Text .. ch)
        else
            label.Text = label.Text .. ch
        end
        task.wait(sec)
    end
    XLQPGen1._TypeSound:Stop()
    if delay then
        local waited = 0
        while waited < delay do
            if isTypewriterPaused() or token ~= XLQPGen1._TypewriterToken or not MainWindow.Visible then return end
            local step = math.min(0.1, delay - waited)
            task.wait(step)
            waited += step
        end
    end
end
