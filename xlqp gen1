			if type(spec)=="table" then
				local size=math.clamp(tonumber(spec.Size) or 72,24,220)
				local frame=Instance.new("Frame")
				frame.Name="Sticker"
				frame.AnchorPoint=Vector2.new(0.5,0.5)
				frame.Size=UDim2.fromOffset(tonumber(spec.Width) or size,tonumber(spec.Height) or size)
				frame.BackgroundTransparency=1
				frame.BorderSizePixel=0
				frame.Rotation=tonumber(spec.Tilt) or 0
				frame.ZIndex=26001
				frame.Parent=self.Layer
				local glow
				if typeof(spec.Glow)=="Color3" then
					glow=Instance.new("ImageLabel")
					glow.Name="Glow"
					glow.AnchorPoint=Vector2.new(0.5,0.5)
					glow.Position=UDim2.fromScale(0.5,0.5)
					glow.Size=UDim2.new(1,24,1,24)
					glow.BackgroundTransparency=1
					glow.ImageColor3=spec.Glow
					glow.ImageTransparency=math.clamp(tonumber(spec.GlowTransparency) or 0.68,0,1)
					glow.ScaleType=Enum.ScaleType.Fit
					glow.ZIndex=26001
					glow.Parent=frame
				end
				local image=Instance.new("ImageLabel")
				image.Name="Image"
				image.Size=UDim2.fromScale(1,1)
				image.BackgroundTransparency=1
				image.ImageTransparency=math.clamp(tonumber(spec.Transparency) or 0,0,1)
				image.ImageColor3=typeof(spec.Tint)=="Color3" and spec.Tint or Color3.new(1,1,1)
				image.ScaleType=Enum.ScaleType.Fit
				image.ZIndex=26002
				image.Parent=frame
				local asset=self.Library:_ResolveDecorationAsset(spec.Image,function(resolved)
					self.Library:_ApplyDecorationAsset(image,resolved)
					if glow then self.Library:_ApplyDecorationAsset(glow,resolved) end
				end)
				self.Library:_ApplyDecorationAsset(image,asset)
				if glow then self.Library:_ApplyDecorationAsset(glow,asset) end
				table.insert(self.Slots,{Frame=frame,Image=image,Glow=glow,Spec=spec,Size=size})
			end
		end
		self:Sync()
		self:PlayEntrance()
	end
	function controller:Destroy()
		for _,connection in ipairs(self.Connections) do pcall(function() connection:Disconnect() end) end
		self:Clear()
		if self.Layer and self.Layer.Parent then self.Layer:Destroy() end
	end
	for _,property in ipairs({"AbsolutePosition","AbsoluteSize","Visible"}) do table.insert(controller.Connections,target:GetPropertyChangedSignal(property):Connect(function() controller:Sync() end)) end
	local animationBudget=0
	table.insert(controller.Connections,RunService.Heartbeat:Connect(function(delta)
		if XLQPGen1._ReduceLagEnabled or not target.Visible or XLQPGen1.WindowDesignsEnabled~=true or #controller.Animated==0 then return end
		animationBudget+=delta
		if animationBudget<0.08 then return end
		controller:Animate(animationBudget)
		animationBudget=0
	end))
	controller:Rebuild()
	self._DecorationController=controller
	return controller
end

