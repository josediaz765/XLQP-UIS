function XLQPGen1:_GetLayerBase()
	local order = tonumber(self._DisplayOrder)
	if not order then
		if WindowConfig and WindowConfig.AlwaysOnTop then
			order = XLQP_LAYER_TOP_BASE
		elseif XLQPGen1Gui then
			order = tonumber(XLQPGen1Gui.DisplayOrder)
		end
	end
	return math.clamp(math.floor(tonumber(order) or 9999), 0, XLQP_LAYER_TOP_BASE)
end




function XLQPGen1:_CaptureLayerTier(gui, base)
	local stored = gui:GetAttribute("XLQPLayerTier")
	if type(stored) == "number" then return stored end
	local order = tonumber(gui.DisplayOrder) or base
	local tier = math.clamp(math.floor(order - base), 1, XLQP_LAYER_TIER_CAP)
	pcall(function() gui:SetAttribute("XLQPLayerTier", tier) end)
	return tier
end

function XLQPGen1:_IsLayerManaged(gui)
	if not (gui and gui.Parent and gui:IsA("ScreenGui")) then return false end
	
	
	if gui == XLQPGen1Gui or gui == self._RootGui then return false end
	if gui == mouseCaptureGui or gui == self._CustomCursorGui then return false end
	if gui:GetAttribute("XLQPLayerPinned") == true then return false end
	return true
end



function XLQPGen1:_ApplyLayerOrders()
	local base = self:_GetLayerBase()
	if XLQPGen1Gui then
		pcall(function()
			XLQPGen1Gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
			XLQPGen1Gui.DisplayOrder = base
		end)
	end
	if mouseCaptureGui and mouseCaptureGui.Parent then
		pcall(function()
			mouseCaptureGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
			mouseCaptureGui.DisplayOrder = math.max(0, base - 1)
		end)
	end

	local entries = {}
	for index, gui in ipairs(self._PopupGuis or {}) do
		if self:_IsLayerManaged(gui) then
			local info = self._LayerInfo[gui]
			if not info then
				info = {tier = self:_CaptureLayerTier(gui, base), seq = 0}
				self._LayerInfo[gui] = info
			end
			entries[#entries + 1] = {gui = gui, tier = info.tier, seq = info.seq, index = index}
		end
	end
	table.sort(entries, function(a, b)
		if a.seq ~= b.seq then return a.seq < b.seq end
		if a.tier ~= b.tier then return a.tier < b.tier end
		return a.index < b.index
	end)

	local cursor = base + 1
	for _, entry in ipairs(entries) do
		local want = math.min(math.max(cursor, base + entry.tier), XLQP_LAYER_CEILING)
		pcall(function()
			entry.gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
			entry.gui.DisplayOrder = want
		end)
		cursor = want + 1
	end
	return self
end

function XLQPGen1:BringPopupToFront(gui)
	if not gui then return self end
	if gui:IsA("GuiObject") then
		gui = gui:FindFirstAncestorOfClass("ScreenGui") or gui
	end
	if not self:_IsLayerManaged(gui) then return self end
	local info = self._LayerInfo[gui]
	if not info then
		self:RegisterPopupGui(gui)
		info = self._LayerInfo[gui]
		if not info then return self end
	end
	
	if info.seq > 0 and info.seq == self._LayerSeq then return self end
	self._LayerSeq = (self._LayerSeq or 0) + 1
	info.seq = self._LayerSeq
	return self:_ApplyLayerOrders()
end

XLQPGen1.FocusPopupGui = XLQPGen1.BringPopupToFront

function xlqpLayerHasUILayout(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("UIGridStyleLayout") then return true end
	end
	return false
end



function xlqpLayerIsPassthroughHolder(frame)
	if not (frame:IsA("Frame") or frame:IsA("CanvasGroup")) then return false end
	if frame.BackgroundTransparency < 1 then return false end
	local size = frame.Size
	
	
	return size.X.Scale >= 1 and size.Y.Scale >= 1
		and size.X.Offset >= 0 and size.Y.Offset >= 0
end


function xlqpLayerIsShieldable(object)
	return object:IsA("Frame") or object:IsA("ScrollingFrame")
		or object:IsA("CanvasGroup") or object:IsA("TextButton") or object:IsA("ImageButton")
end

function XLQPGen1:_HookPopupFocus(frame)
	if not (frame and frame:IsA("GuiObject")) then return end
	if frame:GetAttribute("XLQPFocusHooked") == true then return end
	pcall(function() frame:SetAttribute("XLQPFocusHooked", true) end)
	AddConnection(frame.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.Touch then
			local root = frame:FindFirstAncestorOfClass("ScreenGui")
			if root then XLQPGen1:BringPopupToFront(root) end
		end
	end)
end



function XLQPGen1:_InstallInputShield(frame)
	if not (frame and frame:IsA("GuiObject")) then return end
	if not self:IsInputIsolationEnabled() then return end
	if frame.Name == XLQP_SHIELD_NAME then return end
	if frame:GetAttribute("XLQPNoInputShield") == true then return end
	if tostring(frame.Name):find("XLQPAmbientGlow", 1, true) then return end

	if xlqpLayerIsPassthroughHolder(frame) then
		for _, child in ipairs(frame:GetChildren()) do
			self:_InstallInputShield(child)
		end
		if frame:GetAttribute("XLQPShieldHooked") ~= true then
			pcall(function() frame:SetAttribute("XLQPShieldHooked", true) end)
			AddConnection(frame.ChildAdded, function(child)
				task.defer(function()
					if child and child.Parent then XLQPGen1:_InstallInputShield(child) end
				end)
			end)
		end
		return
	end

	if not xlqpLayerIsShieldable(frame) then return end

	
	
	pcall(function() frame.Active = true end)
	self:_HookPopupFocus(frame)

	
	
	if frame:GetAttribute("XLQPShowHooked") ~= true then
		pcall(function() frame:SetAttribute("XLQPShowHooked", true) end)
		AddConnection(frame:GetPropertyChangedSignal("Visible"), function()
			if frame.Visible then
				local root = frame:FindFirstAncestorOfClass("ScreenGui")
				if root then XLQPGen1:BringPopupToFront(root) end
			end
		end)
	end

	if frame:FindFirstChild(XLQP_SHIELD_NAME) then return end
	
	
	if frame:IsA("ScrollingFrame") or xlqpLayerHasUILayout(frame) then return end

	local minZ = frame.ZIndex
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then minZ = math.min(minZ, child.ZIndex) end
	end
	local shield = Create("TextButton", {
		Name = XLQP_SHIELD_NAME,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		Selectable = false,
		Modal = false,
		ZIndex = minZ - 1,
		Parent = frame
	})
	pcall(function()
		shield:SetAttribute("XLQPNoInputShield", true)
		shield:SetAttribute("NoLiquidGlassText", true)
	end)
end

function XLQPGen1:_ShieldGuiRoot(gui)
	if not (gui and gui:IsA("ScreenGui")) then return end
	if not self:IsInputIsolationEnabled() then return end
	if gui == mouseCaptureGui or gui == self._CustomCursorGui then return end
	if gui:GetAttribute("XLQPNoInputShield") == true then return end
	for _, child in ipairs(gui:GetChildren()) do
		self:_InstallInputShield(child)
	end
	if gui:GetAttribute("XLQPShieldHooked") ~= true then
		pcall(function() gui:SetAttribute("XLQPShieldHooked", true) end)
		AddConnection(gui.ChildAdded, function(child)
			task.defer(function()
				if child and child.Parent then XLQPGen1:_InstallInputShield(child) end
			end)
		end)
		
		
		if self:_IsLayerManaged(gui) then
			AddConnection(gui:GetPropertyChangedSignal("Enabled"), function()
				if gui.Enabled then XLQPGen1:BringPopupToFront(gui) end
			end)
		end
	end
end


function XLQPGen1:RefreshInputLayers()
	self:_ShieldGuiRoot(XLQPGen1Gui)
	for _, gui in ipairs(self._PopupGuis or {}) do
		if gui and gui.Parent and gui:IsA("ScreenGui") then
			self:_ShieldGuiRoot(gui)
		end
	end
	return self:_ApplyLayerOrders()
end

function XLQPGen1:RegisterPopupGui(gui)
	if not gui then return gui end
	self._PopupGuis = self._PopupGuis or {}
	for _, existing in ipairs(self._PopupGuis) do
		if existing == gui then
			return gui
		end
	end
	table.insert(self._PopupGuis, gui)
	if gui:IsA("ScreenGui") then
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
		if self:_IsLayerManaged(gui) then
			local base = self:_GetLayerBase()
			local info = self._LayerInfo[gui]
			if not info then
				info = {tier = self:_CaptureLayerTier(gui, base), seq = 0}
				self._LayerInfo[gui] = info
			end
			
			self._LayerSeq = (self._LayerSeq or 0) + 1
			info.seq = self._LayerSeq
		end
		self:_ShieldGuiRoot(gui)
		self:_ApplyLayerOrders()
	end
	if self._SetupPresentationLock==true and gui:IsA("ScreenGui") and gui.Name~="XLQPSetupWizard" then
		self._SetupSuppressedGuis=self._SetupSuppressedGuis or {}
		if self._SetupSuppressedGuis[gui]==nil then self._SetupSuppressedGuis[gui]=gui.Enabled end
		gui.Enabled=false
	end
	XLQPProtectGui(gui)
	XLQPProtectGuiAssets(gui)
	if UserInputService and UserInputService.TouchEnabled and gui:IsA("ScreenGui") then
		task.defer(function()
			if not gui.Parent then return end
			local vp=(workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(800,600)
			local touchLayout=not UserInputService.KeyboardEnabled or vp.X<=1600 or vp.Y<=900
			if not touchLayout then return end
			local function candidate(object)
				if not object:IsA("GuiObject") or object:GetAttribute("XLQPAdaptiveIgnore")==true then return false end
				if object.Size.X.Scale>=0.92 and object.Size.Y.Scale>=0.92 then return false end
				local size=object.AbsoluteSize
				return size.X>=260 and size.Y>=180 and (size.X>vp.X-16 or size.Y>vp.Y-16)
			end
			local queue={gui}
			local index=1
			local depth=setmetatable({[gui]=0},{__mode="k"})
			while index<=#queue do
				local parent=queue[index]
				index+=1
				local d=depth[parent] or 0
				if d<=2 then
					for _,child in ipairs(parent:GetChildren()) do
						depth[child]=d+1
						if candidate(child) then
							self:RegisterAdaptiveWindow(child,math.min(child.AbsoluteSize.X,vp.X-16),math.min(child.AbsoluteSize.Y,vp.Y-16),math.min(260,vp.X-16),math.min(190,vp.Y-16))
						elseif child:IsA("GuiObject") then
							queue[#queue+1]=child
						end
					end
				end
			end
		end)
	end
	return gui
end

function XLQPGen1:SetZIndex(value)
	local order = math.clamp(math.floor(tonumber(value) or 9999), 0, XLQP_LAYER_TOP_BASE)
	self._DisplayOrder = order
	return self:_ApplyLayerOrders()
end

function XLQPGen1:GetZIndex()
	if XLQPGen1Gui then return XLQPGen1Gui.DisplayOrder end
	return self._DisplayOrder or 9999
end

function XLQPGen1:ResetZIndex()
	self._DisplayOrder = nil
	return self:SetZIndex(9999)
end

