   local function requestHomeDiscordJson(inviteCode)
       local body
       local apiUrl = "https://discord.com/api/v10/invites/" .. inviteCode .. "?with_counts=true&with_expiration=true"
       local req = XLQPResolveRequest()
       if req then
           pcall(function()
               local response = req({
                   Url = apiUrl,
                   Method = "GET",
                   Headers = {
                       ["User-Agent"] = "VerbalUI/HomeDiscord",
                       ["Accept"] = "application/json"
                   }
               })
               body = response and (response.Body or response.body)
           end)
       end
       if not body then pcall(function() body = game:HttpGet(apiUrl, true) end) end
       local ok, data = pcall(function() return HttpService:JSONDecode(body or "") end)
       return ok and data or nil
   end
