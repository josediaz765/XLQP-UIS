	local function stylePrivateTabVisual(target,name)
		local tabInfo=target and (target.Tab or target) or nil
		local button=tabInfo and tabInfo.Button
		if not (button and button.Parent) then return end
		button:SetAttribute("NoLiquidGlass",true)
		local title=button:FindFirstChild("Title",true)
		if title and title:IsA("TextLabel") then
			title.Visible=true
			title.Text=tostring(name or tabInfo.Name or "Private")
			title.TextTransparency=.04
			title.TextStrokeTransparency=1
			title.TextColor3=Color3.fromRGB(244,247,252)
			title:SetAttribute("NoLiquidGlassText",true)
			title:SetAttribute("XLQPPreserveFont",true)
			title:SetAttribute("XLQPTextColorOverride",Color3.fromRGB(244,247,252))
		end
		local icon=button:FindFirstChild("Ico",true)
		if icon and icon:IsA("ImageLabel") then
			icon.Visible=true
			icon.ImageTransparency=.08
			icon.ImageColor3=Color3.fromRGB(225,231,241)
			icon:SetAttribute("NoLiquidGlassIcon",true)
		end
	end
	stylePrivateTabVisual(privateTop,tostring(privateConfig.TopName or "Private"))
	stylePrivateTabVisual(editor,tostring(privateConfig.EditorName or "Edit"))

	local function notify(name,message)
		pcall(function() library:MakeNotification({Name=tostring(name or "Private Tabs"),Content=tostring(message or ""),Image="lock",Time=3}) end)
	end
	local function updateStatus(message)
		if targetStatus and targetStatus.Set then targetStatus:Set(tostring(message or "")) end
		if functionConsole then functionConsole:Info(message) end
	end
	local function refreshTargets()
		local names={}
		for _,record in ipairs(records) do names[#names+1]=record.Name end
		if targetDropdown then
			pcall(function()
				if targetDropdown.Refresh then targetDropdown:Refresh(names,true,true) elseif targetDropdown.SetOptions then targetDropdown:SetOptions(names) elseif targetDropdown.SetValues then targetDropdown:SetValues(names) end
				if activeRecord and targetDropdown.Set then targetDropdown:Set(activeRecord.Name,true) end
			end)
		end
	end
	local function selectRecord(target,navigate)
		local record=type(target)=="table" and target or recordByName[tostring(target or ""):lower()]
		if not record then return nil end
		local needsSelection=navigate~=false and (activeRecord~=record or not (record.Elements and record.Elements.Tab and record.Elements.Tab.Container and record.Elements.Tab.Container.Visible))
		activeRecord=record
		activeGroup=nil
		activeMiniPage=nil
		editorState.Name=record.Name
		if tabNameInput and tabNameInput.Set then pcall(function() tabNameInput:Set(record.Name,true) end) end
		if targetDropdown and targetDropdown.Set then pcall(function() targetDropdown:Set(record.Name,true) end) end
		if needsSelection and record.Elements and record.Elements.Select then pcall(function() record.Elements:Select(true) end) end
		updateStatus("Editing "..record.Name.." / tab root")
		return record
	end
	function window:GetPrivateTab(name) return recordByName[tostring(name or ""):lower()] end
