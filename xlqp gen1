			local function buildWorldTag(head)
				local billboard=Create("BillboardGui",{Name=XLQPNames["XLQPGen1Nametag"],AlwaysOnTop=true,LightInfluence=0,ResetOnSpawn=false,MaxDistance=tonumber(TagConfig.MaxDistance) or 1000,Size=UDim2.new(0,190,0,54),StudsOffset=Vector3.new(0,tonumber(TagConfig.Height) or 3.1,0),Adornee=head,Parent=head})
