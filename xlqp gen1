				TweenService:Create(glowStroke,info,{Transparency=strokeTransparency,Thickness=mode=="active" and 2.5 or 1.5}):Play()
				TweenService:Create(scale,info,{Scale=mode=="active" and 1.13 or mode=="hover" and 1.07 or 1}):Play()
