function XLQPGen1:_TweenWindowVisibility(frame,scaleObject,show,callback)
if not frame then if callback then callback() end return end
if self._PerformanceMode or self._ReduceLagEnabled then
	self._WindowVisibilityTweens=self._WindowVisibilityTweens or setmetatable({},{__mode="k"})
	self._WindowVisibilityTweens[frame]=nil
	frame.Visible=show==true
	if show and scaleObject then scaleObject.Scale=1 end
	self._WindowMotionPausedUntil=os.clock()
	if callback then task.defer(callback) end
	return
end
self._WindowMotionPausedUntil=math.max(tonumber(self._WindowMotionPausedUntil) or 0,os.clock()+0.2)
self._WindowVisibilityTweens=self._WindowVisibilityTweens or setmetatable({},{__mode="k"})
local token={}
self._WindowVisibilityTweens[frame]=token
frame.Visible=show==true
if show then
	task.spawn(function()
		RunService.Heartbeat:Wait()
		if self._WindowVisibilityTweens[frame]~=token or not frame.Parent then return end
		self._WindowVisibilityTweens[frame]=nil
		if callback then callback() end
	end)
else
	self._WindowVisibilityTweens[frame]=nil
	if callback then task.defer(callback) end
end
end
function XLQPGen1:_AcquireSizeProxy(frame)
 self._WindowSizeProxies=self._WindowSizeProxies or setmetatable({},{__mode="k"})
 local signature=(tonumber(self._ThemeRevision) or 0)*7919
 for _,child in ipairs(frame:GetChildren()) do
	if child:IsA("UICorner") or child:IsA("UIStroke") or child:IsA("UIGradient") then
		signature+=3
	elseif child:IsA("GuiObject") and (child.Name=="TopBar" or child.Name=="MainHeaderFill" or child.Name=="SettingsHeaderFill") then
		signature+=1009+#child:GetDescendants()
	end
 end
 local entry=self._WindowSizeProxies[frame]
 if entry and entry.Proxy and entry.Proxy.Parent==nil and entry.Signature==signature then
	return entry.Proxy
 end
 if entry and entry.Proxy then entry.Proxy:Destroy() end
 local proxy=Instance.new("CanvasGroup")
 proxy.Name="XLQPSizeMotionProxy"
 proxy.ClipsDescendants=true
 proxy.Active=false
 proxy.Selectable=false
 proxy:SetAttribute("NoLiquidGlass",true)
 proxy:SetAttribute("NoAutoTextFit",true)
 for _,child in ipairs(frame:GetChildren()) do
	if child:IsA("UICorner") or child:IsA("UIStroke") or child:IsA("UIGradient") then
		local decoration=child:Clone()
		decoration.Parent=proxy
	elseif child:IsA("GuiObject") and (child.Name=="TopBar" or child.Name=="MainHeaderFill" or child.Name=="SettingsHeaderFill") then
		local header=child:Clone()
		header.Parent=proxy
	end
 end
 self._WindowSizeProxies[frame]={Proxy=proxy,Signature=signature}
 return proxy
end
function XLQPGen1:_TweenWindowSize(frame,size,callback,animate)
 if not frame then if callback then callback() end return end
 self._WindowSizeTweens=self._WindowSizeTweens or setmetatable({},{__mode="k"})
 local previous=self._WindowSizeTweens[frame]
 local wasVisible=previous and previous.OriginalVisible
 if wasVisible==nil then wasVisible=frame.Visible end
 if previous then
	previous.Cancelled=true
	if previous.RevealThread then pcall(function() task.cancel(previous.RevealThread) end) end
	if previous.FadeTween then pcall(function() previous.FadeTween:Cancel() end) end
	if previous.CompletedConnection then pcall(function() previous.CompletedConnection:Disconnect() end) end
	if previous.Tween then pcall(function() previous.Tween:Cancel() end) end
	if self._WindowSizeAnimationActive==frame then self._WindowSizeAnimationActive=nil end
	if previous.Proxy and previous.Proxy.Parent then
		local interruptedSize=previous.Proxy.AbsoluteSize
		previous.Proxy.Parent=nil
		if frame.Parent and interruptedSize.X>0 and interruptedSize.Y>0 then
			frame.Size=UDim2.fromOffset(interruptedSize.X,interruptedSize.Y)
		end
		frame.Visible=wasVisible
	end
	if previous.Mask and previous.Mask.Parent then
		local clippedSize=previous.Mask.AbsoluteSize
		if frame.Parent==previous.Mask and previous.OriginalParent and previous.OriginalParent.Parent then
			frame.Parent=previous.OriginalParent
			frame.AnchorPoint=previous.OriginalAnchorPoint or Vector2.new(0,0)
			frame.Position=previous.OriginalPosition
			frame.Size=UDim2.fromOffset(math.max(1,clippedSize.X),math.max(1,clippedSize.Y))
		end
		previous.Mask:Destroy()
	end
end
 local state={Cancelled=false,OriginalVisible=wasVisible}
 self._WindowSizeTweens[frame]=state
 if animate==true and (self._ReduceLagEnabled==true or self._PerformanceMode==true or (WindowConfig and WindowConfig.ReduceLag==true)) then
	animate=false
 end
 if animate~=true and (self._ReduceLagEnabled==true or self._PerformanceMode==true) then
	frame.Size=size
	if self._WindowSizeTweens[frame]==state then self._WindowSizeTweens[frame]=nil end
	if callback then task.defer(callback) end
	return
 end
 if animate==true then
	local originalParent=frame.Parent
	local originalPosition=frame.Position
	local originalAnchorPoint=frame.AnchorPoint
	local startPixels=frame.AbsoluteSize
	local parentPixels
	if originalParent and originalParent:IsA("GuiObject") then
		parentPixels=originalParent.AbsoluteSize
	else
		local camera=workspace.CurrentCamera
		parentPixels=camera and camera.ViewportSize or Vector2.new(1920,1080)
	end
	local targetPixels=Vector2.new(
		math.max(1,size.X.Scale*parentPixels.X+size.X.Offset),
		math.max(1,size.Y.Scale*parentPixels.Y+size.Y.Offset)
	)
	local proxy=self:_AcquireSizeProxy(frame)
	proxy.GroupTransparency=0
	proxy.AnchorPoint=originalAnchorPoint
	proxy.Position=originalPosition
	proxy.Size=UDim2.fromOffset(math.max(1,startPixels.X),math.max(1,startPixels.Y))
	proxy.BackgroundColor3=frame.BackgroundColor3
	proxy.BackgroundTransparency=frame.BackgroundTransparency
	proxy.BorderColor3=frame.BorderColor3
	proxy.BorderSizePixel=frame.BorderSizePixel
	proxy.ZIndex=frame.ZIndex
	proxy.Visible=wasVisible
	proxy.Parent=originalParent
	state.Proxy=proxy
	frame.Visible=false
	frame.Size=size
	self._WindowSizeAnimationActive=frame
	local duration=(self._ReduceLagEnabled==true or (WindowConfig and WindowConfig.ReduceLag==true)) and 0.14 or 0.26
	self._WindowMotionPausedUntil=math.max(tonumber(self._WindowMotionPausedUntil) or 0,os.clock()+duration+0.12)
	state.Tween=TweenService:Create(proxy,TweenInfo.new(duration,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(targetPixels.X,targetPixels.Y)})
	state.CompletedConnection=state.Tween.Completed:Connect(function(playbackState)
		if self._WindowSizeTweens[frame]~=state then return end
		self._WindowSizeTweens[frame]=nil
		if self._WindowSizeAnimationActive==frame then self._WindowSizeAnimationActive=nil end
		if state.CompletedConnection then state.CompletedConnection:Disconnect() state.CompletedConnection=nil end
		if state.RevealThread then pcall(function() task.cancel(state.RevealThread) end) state.RevealThread=nil end
		if state.FadeTween then pcall(function() state.FadeTween:Cancel() end) state.FadeTween=nil end
		if proxy and proxy.Parent then proxy.Parent=nil end
		if playbackState~=Enum.PlaybackState.Completed or not frame.Parent then return end
		frame.Visible=wasVisible
		if callback then task.defer(callback) end
	end)
	state.Tween:Play()
	local revealDelay=duration*0.5
	state.RevealThread=task.delay(revealDelay,function()
		if state.Cancelled or self._WindowSizeTweens[frame]~=state then return end
		if not frame.Parent then return end
		frame.Visible=wasVisible
		if proxy and proxy.Parent then
			state.FadeTween=TweenService:Create(proxy,TweenInfo.new(math.max(duration-revealDelay,0.06),Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{GroupTransparency=1})
			state.FadeTween:Play()
		end
	end)
	return
end
frame.Visible=false
task.spawn(function()
	RunService.Heartbeat:Wait()
	if state.Cancelled or not frame.Parent then return end
	frame.Size=size
	RunService.Heartbeat:Wait()
	if state.Cancelled or not frame.Parent then return end
	frame.Visible=wasVisible
	if self._WindowSizeTweens[frame]==state then self._WindowSizeTweens[frame]=nil end
	if callback then callback() end
end)
end


