		local function formatCount(value)
			local number=tonumber(value) or 0
			if number>=1000000 then
				local text=string.format("%.1f",number/1000000)
				text=text:gsub("%.0$","")
				return text.."M"
			end
			if number>=1000 then return string.format("%.0f",number/1000).."K" end
			return tostring(math.floor(number))
		end

		local function relativeAge(stamp)
			local text=tostring(stamp or "")
			local year,month,day=text:match("^(%d%d%d%d)-(%d%d)-(%d%d)")
			if not year then return "unknown" end
			local ok,seconds=pcall(function()
				return os.time()-os.time({year=tonumber(year),month=tonumber(month),day=tonumber(day),hour=12})
			end)
			if not ok or type(seconds)~="number" or seconds<0 then return "recently" end
			local days=math.floor(seconds/86400)
			if days<1 then return "today" end
			if days<30 then return tostring(days).."d ago" end
			if days<365 then return tostring(math.floor(days/30)).."mo ago" end
			return tostring(math.floor(days/365)).."y ago"
		end

