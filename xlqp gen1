		while key and key.Parent and (WindowConfig._LocalRegisterState.resizeWorkPaused() or WindowConfig._LocalRegisterState.resizeFollowupWorkerRunning) do task.wait(0.03) end
		if not key or not key.Parent or tokens[key]~=token then return end
		RunService.Heartbeat:Wait()
