function XLQPGen1:GetElementParameters(elementName)
	local requested=tostring(elementName or "")
	if requested=="" then return {} end
	local direct=self.ElementParameters and self.ElementParameters[requested]
	if not direct and requested:sub(1,3)~="Add" then
		direct=self.ElementParameters and self.ElementParameters["Add"..requested]
	end
	if not direct then
		local lower=requested:lower()
		for name,data in pairs(self.ElementParameters or {}) do
			if tostring(name):lower()==lower or tostring(name):lower()==("add"..lower) then
				direct=data
				break
			end
		end
	end
	if not direct then return {} end
	local result={
		Name=requested,
		Category=direct.Category,
		Count=#(direct.Parameters or {}),
		Parameters={}
	}
	for index,param in ipairs(direct.Parameters or {}) do
		local copy={}
		for key,value in pairs(param) do copy[key]=value end
		result.Parameters[index]=copy
	end
	return result
end

function XLQPGen1:GetAllElementParameters()
	local result={}
	for name in pairs(self.ElementParameters or {}) do
		result[name]=self:GetElementParameters(name)
	end
	return result
end

function XLQPGen1:GetElementParameterNames()
	local names={}
	for name in pairs(self.ElementParameters or {}) do
		names[#names+1]=name
	end
	table.sort(names,function(a,b) return tostring(a):lower()<tostring(b):lower() end)
	return names
end

function XLQPGen1:FormatElementParameters(elementName)
	local info=self:GetElementParameters(elementName)
	if not info or not info.Parameters or #info.Parameters==0 then
		return tostring(elementName or "Element").." has no table parameters."
	end
	local output={tostring(elementName).." parameters ("..tostring(#info.Parameters).."):"}
	for _,param in ipairs(info.Parameters) do
		local line="• "..tostring(param.Name).." : "..tostring(param.Type or "any")
		if param.Default~=nil and tostring(param.Default)~="" then
			line=line.." = "..tostring(param.Default)
		end
		output[#output+1]=line
	end
	return table.concat(output,"\n")
end

