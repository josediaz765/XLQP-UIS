	function XLQPGen1:_StopRoyalThemeMusic()
		self._RoyalThemeMusicGeneration=(self._RoyalThemeMusicGeneration or 0)+1
		self._RoyalThemeMusicLoading=false
		self._RoyalThemeMusicActive=false
		local player=self._RoyalThemeMediaPlayer or self._MediaPlayer
		if player and type(player.Stop)=="function" then pcall(function() player:Stop() end) end
		self._RoyalThemeMediaPlayer=nil
		return self
	end

	function XLQPGen1:_SyncRoyalThemeMusic(themeName,active)
		themeName=tostring(themeName or "")
		local shouldPlay=themeName=="Royal" and WindowConfig.LiveColorThemeMusic~=false and self._Initialized==true and self._LoadingActive~=true and self._ModuleLoadFailed~=true and self._StartupBlocked~=true
		if not shouldPlay then
			if self._RoyalThemeMusicActive or self._RoyalThemeMusicLoading then self:_StopRoyalThemeMusic() end
			return self
		end
		if self._RoyalThemeMusicActive or self._RoyalThemeMusicLoading then return self end
		self._RoyalThemeMusicGeneration=(self._RoyalThemeMusicGeneration or 0)+1
		local generation=self._RoyalThemeMusicGeneration
		self._RoyalThemeMusicLoading=true
		task.spawn(function()
			if generation~=self._RoyalThemeMusicGeneration or self._Destroyed then return end
			local center=self:_EnsureMediaCenter()
			local player=center and center.MediaPlayer
			if not player or generation~=self._RoyalThemeMusicGeneration then self._RoyalThemeMusicLoading=false return end
			self._RoyalThemeMediaPlayer=player
			if type(player.AddToPlaylist)=="function" then player:AddToPlaylist("Royal Theme - "..XLQPRoyalThemeMusicName,XLQPRoyalThemeMusicUrl) end
			if type(player.SetLoop)=="function" then player:SetLoop(true) end
			if type(player.SetVolume)=="function" then player:SetVolume(math.clamp(tonumber(WindowConfig.LiveColorThemeMusicVolume) or 0.4,0,1)) end
			if type(player.SetURL)=="function" then player:SetURL(XLQPRoyalThemeMusicUrl) end
			if center.MusicControls and center.MusicControls.Source and type(center.MusicControls.Source.Set)=="function" then
				pcall(function() center.MusicControls.Source:Set(XLQPRoyalThemeMusicUrl,true) end)
			elseif center.MediaInput then
				center.MediaInput.Text=XLQPRoyalThemeMusicUrl
			end
			if type(player.Load)=="function" then player:Load() end
			self._RoyalThemeMusicLoading=false
			self._RoyalThemeMusicActive=generation==self._RoyalThemeMusicGeneration
		end)
		return self
	end

	function XLQPGen1:_QueueRoyalThemeMusicSync(themeName,active)
		self._RoyalThemeMusicSyncToken=(self._RoyalThemeMusicSyncToken or 0)+1
		local token=self._RoyalThemeMusicSyncToken
		task.spawn(function()
			while token==self._RoyalThemeMusicSyncToken and not self._Destroyed and (self._Initialized~=true or self._LoadingActive==true) do
				task.wait(.05)
			end
			if token~=self._RoyalThemeMusicSyncToken or self._Destroyed or self._ModuleLoadFailed==true or self._StartupBlocked==true then return end
			self:_SyncRoyalThemeMusic(WindowConfig.LiveColorTheme or themeName,active)
		end)
		return self
	end

