			end
			AddConnection(grip.MouseEnter,function() hovered=true if not active then setVisual("hover") end end)
			AddConnection(grip.MouseLeave,function() hovered=false if not active then setVisual("idle") end end)
			AddConnection(grip.InputBegan,function(input)
				if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then active=true setVisual("active") end
			end)
			AddConnection(UserInputService.InputEnded,function(input)
