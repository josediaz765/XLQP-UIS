function XLQPGen1:_LanguagePath()
	return tostring(self.Folder or "XLQPGen1").."/language.txt"
end

function XLQPGen1:GetSavedLanguage()
	if not (readfile and isfile) then return nil end
	local ok,contents=pcall(function()
		local path=self:_LanguagePath()
		if isfile(path) then return readfile(path) end
		return nil
	end)
	if ok and type(contents)=="string" then
		contents=contents:gsub("^%s+",""):gsub("%s+$","")
		if contents~="" then return contents end
	end
	return nil
end

function XLQPGen1:SaveLanguage(code)
	if not (writefile and isfolder and makefolder) then return false end
	return (pcall(function()
		local folder=tostring(self.Folder or "XLQPGen1")
		if not isfolder(folder) then makefolder(folder) end
		writefile(self:_LanguagePath(),tostring(code or "en"))
	end))
end

function XLQPGen1:GetAutoLanguage()
	return getAutoLanguageCode()
end

