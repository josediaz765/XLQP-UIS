	local holder=Create("Folder",{Name="XLQPAmbientGlowHolder",Parent=targetFrame.Parent})
	local seedPosition=targetFrame.AbsolutePosition
	local seedSize=targetFrame.AbsoluteSize
	for i,step in ipairs(steps) do
		local layerFrame=Create("Frame",{
			Name="XLQPAmbientGlowLayer"..tostring(i),
			BackgroundColor3=color,
			BackgroundTransparency=step.Trans,
			BorderSizePixel=0,
			AnchorPoint=Vector2.new(0,0),
			Position=UDim2.fromOffset(seedPosition.X-step.Pad,seedPosition.Y-step.Pad),
			Size=UDim2.fromOffset(math.max(0,seedSize.X)+step.Pad*2,math.max(0,seedSize.Y)+step.Pad*2),
