local function XLQPResolveAsset(icon)
    if type(icon) == "number" then return "rbxassetid://" .. tostring(icon) end
    local value = tostring(icon or "")
    if value == "" then return "" end
    if value:find("rbxassetid://", 1, true) or value:find("http", 1, true) then return value end
    local ok, resolved = pcall(function() return GetIcon and GetIcon(value) end)
    if ok and resolved then return resolved end
    if tonumber(value) then return "rbxassetid://" .. value end
    return value
end

