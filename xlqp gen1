function XLQPGen1:SetWatermarkVisibility(Visible)
	local shouldShow = Visible == true
	if self._SetupPresentationLock==true or self._SetupFlowOpen==true then
		self._PendingWatermarkVisibility=shouldShow
		for _,floatingLabel in ipairs(self._floatingLabels or {}) do
			if floatingLabel and floatingLabel.SetVisible then floatingLabel:SetVisible(false) end
		end
		return
	end
	if not self._watermarkLabel then
		self._watermarkLabel = (self._floatingLabels and self._floatingLabels[1]) or self:AddDraggableLabel("")
	end
	for _, floatingLabel in ipairs(self._floatingLabels or {}) do
		if floatingLabel and floatingLabel.SetVisible then
			floatingLabel:SetVisible(shouldShow)
		end
	end
	self._watermarkLabel:SetVisible(shouldShow)
end

function XLQPGen1:Destroy()
	if self._Destroyed then return end
	if self._GifRuntime then pcall(function() self._GifRuntime:Stop(true) end) self._GifRuntime=nil end
	stopXLQPCustomCursor()
	if self._DestroyLiquidGlassLens then pcall(self._DestroyLiquidGlassLens) end
	if self._CustomCursorGui and self._CustomCursorGui.Parent then pcall(function() self._CustomCursorGui:Destroy() end) end
	if self._DynamicIslandUnsubscribe then pcall(self._DynamicIslandUnsubscribe) self._DynamicIslandUnsubscribe=nil end
	self._LiveColorWatcherRunning = false
	self._Destroyed = true
	if self._DeactivateLiveColorScript then pcall(function() self:_DeactivateLiveColorScript("ui destroyed") end) end
	pcall(function()
		local env = getgenv and getgenv() or _G
		if env.__VERBAL_HUB_ACTIVE__ == self then env.__VERBAL_HUB_ACTIVE__ = nil end
	end)
	for _, connection in ipairs(self.Connections or {}) do
		pcall(function() if connection then connection:Disconnect() end end)
	end
	if type(self._WindowDestructor) == "function" and not self._RunningDestructor then
		self._RunningDestructor = true
		pcall(self._WindowDestructor)
		self._RunningDestructor = false
	end
	if self._NotificationGui and self._NotificationGui.Parent then pcall(function() self._NotificationGui:Destroy() end) end
	if XLQPGen1Gui and XLQPGen1Gui.Parent then pcall(function() XLQPGen1Gui:Destroy() end) end
end



