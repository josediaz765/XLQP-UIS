function XLQPGen1:_QueueControlPanelRefresh(force)
	local panel=self.ControlPanel
	if not panel or type(panel.RefreshControls)~="function" then return self end
	panel._RefreshRequestedForce=panel._RefreshRequestedForce==true or force==true
	if panel._RefreshQueued then return self end
	panel._RefreshQueued=true
	task.delay(0.05,function()
		if not panel then return end
		panel._RefreshQueued=false
		local requestedForce=panel._RefreshRequestedForce==true
		panel._RefreshRequestedForce=false
		if self._Destroyed or not panel.Gui or not panel.Gui.Parent or not panel.Wrapper or not panel.Wrapper.Parent then return end
		local visible=panel.Gui.Enabled~=false and panel.Wrapper.Visible~=false
		local state=self._WindowConfig and self._WindowConfig._LocalRegisterState
		if visible and state and type(state.isGuiBranchVisible)=="function" then
			local ok,result=pcall(state.isGuiBranchVisible,panel.Wrapper)
			if ok then visible=result==true end
		end
		if visible then pcall(panel.RefreshControls,panel,requestedForce) end
	end)
	return self
end

