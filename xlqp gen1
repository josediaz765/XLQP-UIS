    function searchGames()
       local query = searchBox.Text
       if query == "" then
           return
       end
       gameSearchResults = {}
       currentGameSearchPage = 1
       clearSearchResults()
       local status = Instance.new("TextLabel", resultsFrame)
       status.Size = UDim2.new(1, 0, 0, 30)
       status.BackgroundTransparency = 1
       status.Font = Enum.Font.Gotham
       status.TextSize = 13
       status.TextColor3 = Color3.fromRGB(180, 180, 180)
       status.TextXAlignment = Enum.TextXAlignment.Center
       setTranslatedText(status, "Searching...")
       local ok, res = pcall(function()
           local url = "https://apis.roblox.com/discovery-api/omni-recommendation?numGames=50&keyword=" .. HttpService:UrlEncode(query)
           return game:HttpGet(url)
       end)
       status:Destroy()
       if not ok then
           displaySearchPage()
           return
       end
       local decoded = nil
       pcall(function()
           decoded = HttpService:JSONDecode(res)
       end)
       if not decoded then
           displaySearchPage()
           return
       end
       local list = decoded.data or decoded.games or decoded
       if type(list) ~= "table" then
           displaySearchPage()
           return
       end
       local added = 0
       for _, gData in pairs(list) do
           local placeId = gData.placeId or gData.rootPlaceId or gData.id
           if placeId then
               local name = gData.name or gData.title or "Game"
               local description = gData.description or ""
               table.insert(gameSearchResults, { placeId = placeId, name = name, description = description })
               added = added + 1
               if added >= 50 then
                   break
               end
           end
       end
       displaySearchPage()
   end

   searchBtn.Activated:Connect(searchGames)
   searchBox.FocusLost:Connect(function(enter)
       if enter then
           searchGames()
       end
   end)

   XLQPAssignProperty(aiToggleButton, "Image", icons.ArrowOpened)
   aiTabContainer.Visible = true
   aiBodyContainer.Visible = true
   aiControlsContainer.Visible = true
end

return Elements
end

	function TabFunction:MakeAdminTab(AdminConfig)
		AdminConfig=type(AdminConfig)=="table" and AdminConfig or {Name=tostring(AdminConfig or "Admin")}
		local password=tostring(AdminConfig.Password or AdminConfig.AdminPassword or "")
		assert(password~="", "MakeAdminTab requires Password")
		local config={}
		for key,value in pairs(AdminConfig) do config[key]=value end
		config.Admin=false
		config.AdminOnly=false
		config.Name=config.Name or config.Title or "Admin"
		config.Icon=config.Icon or "shield"
		config.AutoSelect=false
		config.SelectOnCreate=false
		local originalOnSelect=config.OnSelect
		local safeRememberName=tostring(config.RememberKey or config.Name):gsub("[^%w_%-]","_")
		local rememberFolder="XLQP Gen1/AdminRemember"
		local rememberFile=rememberFolder.."/"..safeRememberName..".remember"
		local function rememberSignature()
			local textValue=tostring(config.Name).."|"..password
			local hash=2166136261
			for index=1,#textValue do hash=(hash*31+textValue:byte(index))%4294967296 end
			return string.format("%08x",math.floor(hash))
		end
		local function ensureRememberFolder()
			if type(makefolder)~="function" or type(isfolder)~="function" then return false end
			pcall(function() if not isfolder("XLQP Gen1") then makefolder("XLQP Gen1") end end)
			pcall(function() if not isfolder(rememberFolder) then makefolder(rememberFolder) end end)
			return true
		end
		local function isRemembered()
			if config.Remember==false or type(isfile)~="function" or type(readfile)~="function" then return false end
			local ok,exists=pcall(isfile,rememberFile)
			if not ok or not exists then return false end
			local readOk,value=pcall(readfile,rememberFile)
			return readOk and tostring(value or "")==rememberSignature()
		end
		local function setRemembered(value)
			if value then
				if type(writefile)~="function" or not ensureRememberFolder() then return false end
				return pcall(writefile,rememberFile,rememberSignature())
			end
			if type(isfile)=="function" and type(delfile)=="function" then
				local ok,exists=pcall(isfile,rememberFile)
				if ok and exists then pcall(delfile,rememberFile) end
			end
			return true
		end
		local unlocked=isRemembered()
		local promptOpen=false
		local elements
		local badge
		config.OnSelect=function(request)
			if unlocked then
				if type(originalOnSelect)=="function" then return originalOnSelect(request) end
				return
			end
			request.Deferred=true
			if promptOpen then return end
			promptOpen=true
			local passwordBox
			local rememberToggle
			local dialog=self:AddDialog("AdminTab_"..tostring(config.Name),{
				Title=tostring(config.PromptTitle or "Admin access"),
				Description=tostring(config.PromptDescription or "Enter the password to open this tab."),
				OutsideClickDismiss=true,
				OnClose=function() promptOpen=false end,
				FooterButtons={
					Cancel={Title="Cancel",Variant="Ghost",Order=1,Callback=function(d) d:Dismiss() end},
					Unlock={Title="Unlock",Variant="Primary",Order=2,Callback=function(d)
						local entered=passwordBox and tostring(passwordBox.Text or "") or ""
						local valid=entered==password
						if type(config.ValidatePassword)=="function" then
							local ok,result=pcall(config.ValidatePassword,entered,elements)
							valid=ok and result==true
						end
						if not valid then
							if passwordBox then passwordBox.Text="" end
							d:SetDescription(tostring(config.IncorrectText or "Incorrect password. Try again."))
							return
						end
						unlocked=true
						if config.Remember~=false then setRemembered(rememberToggle and rememberToggle.Value==true) end
						if badge then badge.Visible=false end
						d:Dismiss()
						request:Continue()
					end}
				}
			})
			if dialog.Frame then dialog.Frame.Size=UDim2.new(0,math.clamp(tonumber(config.PromptWidth) or 350,270,480),0,0) end
			passwordBox=dialog:AddInput("Password",{Text="Password",Placeholder="Enter password"})
			if config.Remember~=false and dialog.AddToggle then
				rememberToggle=dialog:AddToggle("RememberAdmin",{Text=tostring(config.RememberText or "Remember this admin tab"),Default=false})
			end
			if dialog.Overlay then
				dialog.Overlay.ZIndex=159800
				for _,gui in ipairs(dialog.Overlay:GetDescendants()) do
					if gui:IsA("GuiObject") then gui.ZIndex+=150000 end
				end
			end
		end
		elements=self:MakeTab(config)
		if not (elements and elements.Tab and elements.Tab.Button) then return elements end
		local button=elements.Tab.Button
		badge=Create("ImageLabel",{Name="AdminLock",Size=UDim2.fromOffset(14,14),Position=UDim2.new(1,-24,0,5),BackgroundTransparency=1,Image=GetIcon("lock") or GetIcon("shield"),ImageColor3=typeof(config.LockColor)=="Color3" and config.LockColor or Color3.fromRGB(200,205,225),ZIndex=button.ZIndex+2,Visible=not unlocked,Parent=button})
		function elements:IsUnlocked() return unlocked end
		function elements:IsRemembered() return isRemembered() end
		function elements:SetRemembered(value) setRemembered(value==true) if value==true then unlocked=true if badge then badge.Visible=false end end return self end
		function elements:ForgetRemembered() setRemembered(false) return self end
		function elements:Lock(forget)
			unlocked=false
			if forget==true then setRemembered(false) end
			if badge then badge.Visible=true end
			return self
		end
		function elements:SetPassword(value)
			password=tostring(value or "")
			assert(password~="", "Admin tab password cannot be empty")
			setRemembered(false)
			return self:Lock(false)
		end
		return elements
	end
