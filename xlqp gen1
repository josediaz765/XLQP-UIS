	function XLQPGen1:_EditableDisplayName(Frame)
		if not (Frame and Frame.Parent) then return "Element" end
		return tostring(Frame:GetAttribute("__XLQPGen1MoveableName") or Frame:GetAttribute("SearchName") or Frame.Name or "Element")
	end

	function XLQPGen1:_EditableContainerName(Frame)
		local container = Frame and self:GetMoveableContainer(Frame.Parent)
		if not container then return "Unknown container" end
		local current = container
		while current and current ~= game do
			local title = current:GetAttribute("TabName") or current:GetAttribute("GroupName") or current:GetAttribute("SearchName")
			if title and tostring(title) ~= "" then return tostring(title) end
			if current.Name == "ItemContainer_Direct" then return "Direct page" end
			if current.Name == "ItemContainer_Side" then return "Side tab" end
			current = current.Parent
		end
		return tostring(container.Name or "Container")
	end

	function XLQPGen1:GetEditablePinItems()
		local result = {}
		for index = #(self.MoveableElements or {}), 1, -1 do
			local frame = self.MoveableElements[index]
			if frame and frame.Parent then
				table.insert(result, frame)
			else
				table.remove(self.MoveableElements, index)
			end
		end
		table.sort(result, function(a, b)
			local ap = a:GetAttribute("__XLQPGen1Pinned") == true
			local bp = b:GetAttribute("__XLQPGen1Pinned") == true
			if ap ~= bp then return ap end
			if ap then
				local as = tonumber(a:GetAttribute("__XLQPGen1PinStamp")) or math.huge
				local bs = tonumber(b:GetAttribute("__XLQPGen1PinStamp")) or math.huge
				if as ~= bs then return as < bs end
			end
			return self:_EditableDisplayName(a):lower() < self:_EditableDisplayName(b):lower()
		end)
		return result
	end

	function XLQPGen1:_RenderEditablePin(Frame, Animate)
		if not (Frame and Frame.Parent and Frame:IsA("GuiObject")) then return end
		local pinned = Frame:GetAttribute("__XLQPGen1Pinned") == true
		local pin = Frame:FindFirstChild("MoveablePin")
		if pin then
			pin:SetAttribute("NoLiquidGlass", true)
			local back = pin:FindFirstChild("PinBack")
			if not back then
				back = AddThemeObject(SetProps(MakeElement("RoundFrame", Color3.fromRGB(255,255,255), 0, 8), {
					Name = "PinBack",
					Size = UDim2.fromScale(1,1),
					BackgroundTransparency = 1,
					Parent = pin,
					ZIndex = math.max(1, pin.ZIndex - 1)
				}), "Main")
				back:SetAttribute("NoLiquidGlass", true)
			end
			local icon = pin:FindFirstChild("Icon")
			if icon and icon:IsA("ImageLabel") then
				XLQPAssignProperty(icon, "Image", GetIcon("pin") or icon.Image)
				local info = TweenInfo.new(Animate == false and 0 or 0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				TweenService:Create(back, info, {BackgroundTransparency = pinned and 0.12 or 1}):Play()
				TweenService:Create(icon, info, {ImageTransparency = pinned and 0 or 0.65, Rotation = pinned and -18 or 0}):Play()
				local scale=icon:FindFirstChild("PinScale") or Create("UIScale",{Name="PinScale",Parent=icon})
				scale.Scale=Animate==false and 1 or (pinned and 0.78 or 1.14)
				TweenService:Create(scale,TweenInfo.new(Animate==false and 0 or 0.24,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
			end
		end
		if self._EditableToolbar and self._EditableToolbar.PinIcon and self._EditableSelectedFrame == Frame then
			local toolbar = self._EditableToolbar
			local info = TweenInfo.new(Animate == false and 0 or 0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			XLQPAssignProperty(toolbar.PinIcon, "Image", GetIcon("pin") or toolbar.PinIcon.Image)
			TweenService:Create(toolbar.PinIcon, info, {ImageTransparency = pinned and 0 or 0.62, Rotation = pinned and -18 or 0}):Play()
			if toolbar.PinBack then TweenService:Create(toolbar.PinBack, info, {BackgroundTransparency = pinned and 0.12 or 1}):Play() end
			local scale=toolbar.PinIcon:FindFirstChild("PinScale") or Create("UIScale",{Name="PinScale",Parent=toolbar.PinIcon})
			scale.Scale=Animate==false and 1 or (pinned and 0.78 or 1.14)
			TweenService:Create(scale,TweenInfo.new(Animate==false and 0 or 0.24,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
		end
	end

	function XLQPGen1:SetEditablePinned(FrameOrName, Value, Silent)
		local frame = typeof(FrameOrName) == "Instance" and FrameOrName or nil
		if not frame and FrameOrName ~= nil then
			local wanted = tostring(FrameOrName):lower()
			for _, candidate in ipairs(self:GetEditablePinItems()) do
				if self:_EditableDisplayName(candidate):lower() == wanted then frame = candidate break end
			end
		end
		if not (frame and frame.Parent and frame:IsA("GuiObject")) then return false end
		local current = frame:GetAttribute("__XLQPGen1Pinned") == true
		local pinned = Value == nil and not current or Value == true
		if current == pinned then
			self:_RenderEditablePin(frame, false)
			self:_SyncEditablePinManager()
			return pinned
		end
		frame:SetAttribute("__XLQPGen1Pinned", pinned)
		if pinned then
			self._EditablePinSerial = (self._EditablePinSerial or 0) + 1
			frame:SetAttribute("__XLQPGen1PinStamp", self._EditablePinSerial)
			frame:SetAttribute("__XLQPGen1SavedOrder", frame.LayoutOrder)
		else
			local saved = tonumber(frame:GetAttribute("__XLQPGen1SavedOrder"))
			if saved then frame.LayoutOrder = saved end
			frame:SetAttribute("__XLQPGen1PinStamp", nil)
		end
		local container = self:GetMoveableContainer(frame.Parent)
		if container then self:NormalizeMoveOrders(container) end
		self:_RenderEditablePin(frame, true)
		self:_SyncEditablePinManager()
		if not Silent and self.MakeNotification then
			self:MakeNotification({Name = "Editable Layout", Content = (pinned and "Pinned " or "Unpinned ") .. self:_EditableDisplayName(frame) .. ".", Image = "pin", Time = 2.5})
		end
		return pinned
	end

	function XLQPGen1:GetPinnedEditableElements()
		local result = {}
		for _, frame in ipairs(self:GetEditablePinItems()) do
			if frame:GetAttribute("__XLQPGen1Pinned") == true then table.insert(result, frame) end
		end
		return result
	end

	function XLQPGen1:UnpinAllEditableElements(Silent)
		local containers = {}
		for _, frame in ipairs(self:GetEditablePinItems()) do
			if frame:GetAttribute("__XLQPGen1Pinned") == true then
				frame:SetAttribute("__XLQPGen1Pinned", false)
				frame:SetAttribute("__XLQPGen1PinStamp", nil)
				local saved = tonumber(frame:GetAttribute("__XLQPGen1SavedOrder"))
				if saved then frame.LayoutOrder = saved end
				local container = self:GetMoveableContainer(frame.Parent)
				if container then containers[container] = true end
				self:_RenderEditablePin(frame, true)
			end
		end
		for container in pairs(containers) do self:NormalizeMoveOrders(container) end
		self:_SyncEditablePinManager()
		if not Silent and self.MakeNotification then self:MakeNotification({Name = "Editable Layout", Content = "All editable elements were unpinned.", Image = "pin-off", Time = 3}) end
		return self
	end

	function XLQPGen1:_SyncEditablePinManager()
		local manager = self._EditablePinManager
		if not (manager and manager.Root and manager.Root.Parent and manager.Content and manager.Content.Parent) then return end
		self._EditablePinManagerToken = (self._EditablePinManagerToken or 0) + 1
		local token = self._EditablePinManagerToken
		task.defer(function()
			if token ~= XLQPGen1._EditablePinManagerToken then return end
			local frames = XLQPGen1:GetEditablePinItems()
			local alive = {}
			local pinnedCount = 0
			for index, frame in ipairs(frames) do
				alive[frame] = true
				local card = manager.Cards[frame]
				if not card then card = manager.CreateCard(frame) manager.Cards[frame] = card end
				local pinned = frame:GetAttribute("__XLQPGen1Pinned") == true
				if pinned then pinnedCount += 1 end
				card.Title.Text = XLQPGen1:_EditableDisplayName(frame)
				card.Description.Text = XLQPGen1:_EditableContainerName(frame)
				card.Root.LayoutOrder = pinned and (-100000 + (tonumber(frame:GetAttribute("__XLQPGen1PinStamp")) or index)) or (1000 + index)
				card.Root.Visible = true
				local selected = XLQPGen1._EditableSelectedFrame == frame
				card.Stroke.Thickness = selected and 2 or 1
				card.Stroke.Transparency = selected and 0.02 or 0.42
				local info = TweenInfo.new(0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				TweenService:Create(card.PinBack, info, {BackgroundTransparency = pinned and 0.12 or 1}):Play()
				TweenService:Create(card.PinIcon, info, {ImageTransparency = pinned and 0 or 0.65, Rotation = pinned and -18 or 0}):Play()
				local scale=card.PinIcon:FindFirstChild("PinScale") or Create("UIScale",{Name="PinScale",Parent=card.PinIcon})
				scale.Scale=pinned and 0.86 or 1.08
				TweenService:Create(scale,TweenInfo.new(0.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
			end
			for frame, card in pairs(manager.Cards) do
				if not alive[frame] then
					if card.Root and card.Root.Parent then card.Root:Destroy() end
					manager.Cards[frame] = nil
				end
			end
			manager.PinnedHeader.Visible = pinnedCount > 0
			manager.Empty.Visible = #frames == 0
			manager.AllHeader.Text = #frames > 0 and ("All elements  ·  " .. tostring(#frames)) or "All elements"
		end)
	end

