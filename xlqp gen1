		local Data=sharedAIDecode(Body)
		return type(Data)=="table" and (type(Data.events)=="table" or type(Data.leagues)=="table"),Data
	end
	local function TryGet(Url,Headers)
		local LastBody,LastCode="",0
		local Ok,Response=pcall(function() return game:HttpGet(Url,true) end)
		if Ok and type(Response)=="string" and Response~="" then
			local Valid,Data=ValidScoreboard(Response)
			if Valid then return true,Response,200,Data end
			LastBody,LastCode=Response,200
		end
		for _,Fn in ipairs(sharedAIGetRequestFunctions()) do
			local Request={Url=Url,Method="GET",Headers=Headers or {['Accept']="application/json",['User-Agent']="Mozilla/5.0"},Timeout=45}
			local Success,Result=pcall(function() return Fn(Request) end)
			if not Success then Request.Timeout=nil Success,Result=pcall(function() return Fn(Request) end) end
			if Success and Result then
				local Body=tostring(Result.Body or Result.body or Result.ResponseBody or Result.responseBody or "")
				local Code=tonumber(Result.StatusCode or Result.Status or Result.status) or (Body~="" and 200 or 0)
				local Valid,Data=ValidScoreboard(Body)
				if Valid and (Code==0 or (Code>=200 and Code<300)) then return true,Body,Code,Data end
				if Body~="" or Code~=0 then LastBody,LastCode=Body,Code end
			end
		end
		return false,LastBody,LastCode,nil
	end
	local function RequestScoreboard(Slug,Date,Offset)
		local Base="https://site.api.espn.com/apis/site/v2/sports/soccer/"..tostring(Slug).."/scoreboard"
		local Candidates={}
		if Offset==0 then table.insert(Candidates,Base) end
		table.insert(Candidates,Base.."?dates="..Date)
		table.insert(Candidates,Base.."?dates="..Date.."&limit=100")
		table.insert(Candidates,Base.."?limit=100&dates="..Date)
		local WebBase="https://site.web.api.espn.com/apis/site/v2/sports/soccer/"..tostring(Slug).."/scoreboard"
		table.insert(Candidates,WebBase.."?dates="..Date)
		local LastBody,LastCode="",0
		for _,Url in ipairs(Candidates) do
			local Ok,Body,Code,Data=TryGet(Url,{['Accept']="application/json,text/plain,*/*",['User-Agent']="Mozilla/5.0",['Cache-Control']="no-cache"})
			if Ok then return true,Body,Code,Data,Url end
			LastBody,LastCode=Body,Code
		end
		return false,LastBody,LastCode,nil,nil
	end
	local function LogoAsset(Url,Key)
		if not SoccerConfig.ShowLogos or type(Url)~="string" or Url=="" or not (writefile and getcustomasset) then return "" end
		if LogoCache[Url] then return LogoCache[Url] end
		local Folder="VerbalHubSoccerLogos"
		pcall(function() if makefolder and (not isfolder or not isfolder(Folder)) then makefolder(Folder) end end)
		local Path=Folder.."/"..SafeName(Key or Url)..".png"
		if isfile and isfile(Path) then local Good,Asset=pcall(getcustomasset,Path) if Good then LogoCache[Url]=Asset return Asset end end
		local Ok,Body=pcall(function() return game:HttpGet(Url,true) end)
		if not Ok or type(Body)~="string" or Body=="" then
			for _,Fn in ipairs(sharedAIGetRequestFunctions()) do
				local Good,Result=pcall(function() return Fn({Url=Url,Method="GET",Headers={['Accept']="image/png,image/jpeg,image/webp,*/*",['User-Agent']="Mozilla/5.0"}}) end)
				if Good and Result then Body=tostring(Result.Body or Result.body or "") if Body~="" then break end end
			end
		end
		if type(Body)=="string" and Body~="" and pcall(writefile,Path,Body) then local Good,Asset=pcall(getcustomasset,Path) if Good then LogoCache[Url]=Asset return Asset end end
		return ""
	end
