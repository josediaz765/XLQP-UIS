	function XLQPGen1:CanMoveIntoContainer(Container)
		if typeof(Container) ~= "Instance" or not Container:IsA("GuiObject") or not Container.Parent then return false end
		if Container:GetAttribute("ProtectedMoveDrop") == true then return false end
		local hasLayout = Container:FindFirstChildOfClass("UIListLayout") ~= nil
		if not hasLayout then return false end
		local allowed = Container.Name == "ItemContainer_Direct" or Container.Name == "ItemContainer_Side" or Container:GetAttribute("__XLQPGen1ElementContainer") == true or Container:GetAttribute("__XLQPGen1MoveDropDropdown") == true
		if not allowed and (Container.Name == "Body" or Container.Name == "TabPage") then
			local current = Container.Parent
			while current and current ~= game do
				if current.Name == "GroupboxFrame" or current.Name == "TabboxFrame" then allowed = true break end
				if current.Name == "ScriptHubContainer" or current:GetAttribute("ProtectedMoveDrop") == true then return false end
				current = current.Parent
			end
		end
		if not allowed then return false end
		local current = Container
		while current do
			if current.Name == "ScriptHubContainer" or current:GetAttribute("ProtectedMoveDrop") == true then return false end
			current = current.Parent
		end
		return true
	end

	function XLQPGen1:RegisterEditableContainer(Container)
		if not self:CanMoveIntoContainer(Container) then return Container end
		self.EditableContainers = self.EditableContainers or {}
		for _, existing in ipairs(self.EditableContainers) do
			if existing == Container then return Container end
		end
		table.insert(self.EditableContainers, Container)
		return Container
	end

	function XLQPGen1:GetMoveableContainer(Object)
		while Object and Object ~= game do
			if self:CanMoveIntoContainer(Object) then return Object end
			Object = Object.Parent
		end
	end

	function XLQPGen1:GetMoveableContainerKey(Container)
		if typeof(Container) ~= "Instance" then return nil end
		local parts = {}
		local current = Container
		local count = 0
		while current and current ~= game and count < 10 do
			count += 1
			local label = current:GetAttribute("TabName") or current:GetAttribute("GroupName") or current:GetAttribute("SearchName") or current.Name
			parts[#parts + 1] = tostring(label or current.ClassName)
			current = current.Parent
		end
		local reversed = {}
		for index = #parts, 1, -1 do reversed[#reversed + 1] = parts[index] end
		return table.concat(reversed, "/")
	end

	function XLQPGen1:ResolveMoveableOrigin(Frame)
		local origin = self._MoveableOrigins and self._MoveableOrigins[Frame]
		if not origin then return nil end
		local anchor = origin.Anchor
		if anchor and anchor.Parent and self:CanMoveIntoContainer(anchor.Parent) then
			origin.Parent = anchor.Parent
			return anchor.Parent
		end
		if origin.Parent and origin.Parent.Parent and self:CanMoveIntoContainer(origin.Parent) then return origin.Parent end
		if origin.Key then
			for _, container in ipairs(self.EditableContainers or {}) do
				if container and container.Parent and self:CanMoveIntoContainer(container) and self:GetMoveableContainerKey(container) == origin.Key then
					origin.Parent = container
					if not (origin.Anchor and origin.Anchor.Parent) then
						local newAnchor = Instance.new("Frame")
						newAnchor.Name = "MoveableOriginAnchor"
						newAnchor.Size = UDim2.fromOffset(0, 0)
						newAnchor.BackgroundTransparency = 1
						newAnchor.BorderSizePixel = 0
						newAnchor.Visible = false
						newAnchor.LayoutOrder = tonumber(origin.LayoutOrder) or 0
						newAnchor:SetAttribute("ProtectedMoveDrop", true)
						newAnchor.Parent = container
						origin.Anchor = newAnchor
					end
					return container
				end
			end
			local root = XLQPGen1Gui
			if root and root.Parent then
				for _, candidate in ipairs(root:GetDescendants()) do
					if candidate:IsA("GuiObject") and self:CanMoveIntoContainer(candidate) and self:GetMoveableContainerKey(candidate) == origin.Key then
						origin.Parent = candidate
						return candidate
					end
				end
			end
		end
		return nil
	end

	function XLQPGen1:_EditablePointInside(Object, X, Y)
		if not Object or not Object.Parent or not Object.Visible then return false end
		local current = Object
		while current and current ~= game do
			if current:IsA("GuiObject") and current.Visible == false then return false end
			current = current.Parent
		end
		local position = Object.AbsolutePosition
		local size = Object.AbsoluteSize
		if size.X < 4 or size.Y < 4 then return false end
		return X >= position.X and X <= position.X + size.X and Y >= position.Y and Y <= position.Y + size.Y
	end

	function XLQPGen1:_EditableDepth(Object)
		local depth = 0
		while Object and Object ~= game do
			depth += 1
			Object = Object.Parent
		end
		return depth
	end

	function XLQPGen1:GetEditableDropTarget(Frame, X, Y)
		local bestFrame
		local bestFrameArea = math.huge
		for index = #(self.MoveableElements or {}), 1, -1 do
			local candidate = self.MoveableElements[index]
			if candidate and candidate.Parent and candidate ~= Frame and not candidate:IsDescendantOf(Frame) and not Frame:IsDescendantOf(candidate) and self:_EditablePointInside(candidate, X, Y) then
				local area = math.max(1, candidate.AbsoluteSize.X * candidate.AbsoluteSize.Y)
				if area < bestFrameArea then bestFrame = candidate bestFrameArea = area end
			end
		end
		if bestFrame then return bestFrame end
		local bestContainer
		local bestScore = -math.huge
		for index = #(self.EditableContainers or {}), 1, -1 do
			local container = self.EditableContainers[index]
			if self:CanMoveIntoContainer(container) and not container:IsDescendantOf(Frame) and self:_EditablePointInside(container, X, Y) then
				local area = math.max(1, container.AbsoluteSize.X * container.AbsoluteSize.Y)
				local score = self:_EditableDepth(container) * 100000000 - area
				if score > bestScore then bestContainer = container bestScore = score end
			end
		end
		return bestContainer
	end

	function XLQPGen1:UpdateEditableContainer(Container)
		if not self:CanMoveIntoContainer(Container) then return end
		local layout = Container:FindFirstChildOfClass("UIListLayout")
		if not layout then return end
		if Container:IsA("ScrollingFrame") then
			Container.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 30)
		elseif Container.AutomaticSize == Enum.AutomaticSize.None then
			Container.Size = UDim2.new(Container.Size.X.Scale, Container.Size.X.Offset, 0, layout.AbsoluteContentSize.Y)
		end
	end

	function XLQPGen1:NormalizeMoveOrders(Container)
		if not self:CanMoveIntoContainer(Container) then return end
		local children = {}
		for _, child in ipairs(Container:GetChildren()) do
			if child:IsA("GuiObject") and child:GetAttribute("__XLQPGen1MoveableFrame") == true then table.insert(children, child) end
		end
		table.sort(children, function(A, B)
			local aPinned = A:GetAttribute("__XLQPGen1Pinned") == true
			local bPinned = B:GetAttribute("__XLQPGen1Pinned") == true
			if aPinned ~= bPinned then return aPinned end
			if aPinned then
				local aStamp = tonumber(A:GetAttribute("__XLQPGen1PinStamp")) or math.huge
				local bStamp = tonumber(B:GetAttribute("__XLQPGen1PinStamp")) or math.huge
				if aStamp ~= bStamp then return aStamp < bStamp end
			end
			if A.LayoutOrder ~= B.LayoutOrder then return A.LayoutOrder < B.LayoutOrder end
			if math.abs(A.AbsolutePosition.Y - B.AbsolutePosition.Y) > 2 then return A.AbsolutePosition.Y < B.AbsolutePosition.Y end
			return A.AbsolutePosition.X < B.AbsolutePosition.X
		end)
		local pinnedIndex = 0
		local normalIndex = 0
		for _, child in ipairs(children) do
			if child:GetAttribute("__XLQPGen1Pinned") == true then
				pinnedIndex += 1
				child.LayoutOrder = -100000 + pinnedIndex * 10
			else
				normalIndex += 1
				child.LayoutOrder = normalIndex * 10
			end
		end
		self:UpdateEditableContainer(Container)
	end

	function XLQPGen1:MoveElementFrame(Frame, Target, DropY)
		if typeof(Frame) ~= "Instance" or not Frame:IsA("GuiObject") or not Frame.Parent then return false end
		local oldContainer = self:GetMoveableContainer(Frame.Parent)
		local targetFrame
		local container
		if Target and Target:GetAttribute("__XLQPGen1MoveableFrame") == true then
			targetFrame = Target
			container = self:GetMoveableContainer(Target.Parent)
		else
			container = self:GetMoveableContainer(Target)
		end
		if not container and tonumber(DropY) and oldContainer then container = oldContainer end
		if not self:CanMoveIntoContainer(container) or container:IsDescendantOf(Frame) then return false end
		self:RegisterEditableContainer(container)
		local siblings = {}
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("GuiObject") and child ~= Frame and child:GetAttribute("__XLQPGen1MoveableFrame") == true then table.insert(siblings, child) end
		end
		table.sort(siblings, function(A, B)
			if A.LayoutOrder ~= B.LayoutOrder then return A.LayoutOrder < B.LayoutOrder end
			if math.abs(A.AbsolutePosition.Y - B.AbsolutePosition.Y) > 2 then return A.AbsolutePosition.Y < B.AbsolutePosition.Y end
			return A.AbsolutePosition.X < B.AbsolutePosition.X
		end)
		local insertIndex = #siblings + 1
		if targetFrame then
			for index, child in ipairs(siblings) do
				if child == targetFrame then
					insertIndex = index
					if tonumber(DropY) and DropY > child.AbsolutePosition.Y + child.AbsoluteSize.Y * 0.5 then insertIndex = index + 1 end
					break
				end
			end
		elseif tonumber(DropY) then
			for index, child in ipairs(siblings) do
				if DropY < child.AbsolutePosition.Y + child.AbsoluteSize.Y * 0.5 then insertIndex = index break end
			end
		end
		Frame.Parent = container
		Frame.Visible = true
		Frame:SetAttribute("__XLQPGen1MoveCurrentKey", self:GetMoveableContainerKey(container) or "")
		table.insert(siblings, math.clamp(insertIndex, 1, #siblings + 1), Frame)
		for index, child in ipairs(siblings) do child.LayoutOrder = index * 10 end
		if oldContainer and oldContainer ~= container then self:NormalizeMoveOrders(oldContainer) end
		self:NormalizeMoveOrders(container)
		local flash = Instance.new("Frame")
		flash.Name = "MoveableDropFlash"
		flash.Size = UDim2.fromScale(1, 1)
		flash.BackgroundColor3 = Color3.fromRGB(90, 160, 255)
		flash.BackgroundTransparency = 0.82
		flash.BorderSizePixel = 0
		flash.Active = false
		flash.ZIndex = 898
		flash:SetAttribute("NoLiquidGlass", true)
		flash.Parent = Frame
		MakeElement("Corner", 0, 12).Parent = flash
		local flashStroke = Instance.new("UIStroke")
		flashStroke.Color = Color3.fromRGB(145, 205, 255)
		flashStroke.Thickness = 2
		flashStroke.Transparency = 0.08
		flashStroke.Parent = flash
		TweenService:Create(flash, TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
		task.delay(0.35, function() if flash and flash.Parent then flash:Destroy() end end)
		self:_SyncEditablePinManager()
		return true
	end

