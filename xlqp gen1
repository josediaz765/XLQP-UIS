 function WindowConfig._LocalRegisterState.queueResizeCompletion(key,callback)
	if key==nil or type(callback)~="function" then return end
	local tokens=WindowConfig._LocalRegisterState.resizeCompletionTokens
	local token=(tonumber(tokens[key]) or 0)+1
	tokens[key]=token
