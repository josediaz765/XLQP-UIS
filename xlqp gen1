   function sanitizeAIContent(content, userPrompt)
       content = tostring(content or "")
       local luaBlock = content:match("```lua%s*(.-)%s*```") or content:match("```Lua%s*(.-)%s*```")
       if luaBlock and luaBlock ~= "" and resolveAssistantActionIntent(userPrompt) then
           if loadstring then
               local fn, compileErr = loadstring(luaBlock, "VerbalAIScript")
               if not fn then
                   return "<b>AI Script Error:</b> " .. tostring(compileErr)
               end
               local ok, runErr = pcall(fn)
               if ok then
                   return "<b>AI Script:</b> detected and executed."
               end
               return "<b>AI Script Error:</b> " .. tostring(runErr)
           end
           return "<b>AI Script Error:</b> loadstring is not available in this executor."
       elseif luaBlock and luaBlock ~= "" then
           content = content:gsub("```[%w_%-]*%s*.-%s*```", "")
           content = content:gsub("I couldn\'t find any specific Roblox Lua script[^\n]*\n?", "")
           content = content:gsub("If you\'re looking for a Roblox script[^\n]*\n?", "")
           content = content:gsub("Please note that this script[^\n]*\n?", "")
           content = tostring(content):gsub("^%s+", ""):gsub("%s+$", "")
           if content == "" then
               content = "I treated that as a normal question, not a Roblox script request. Please ask again and I’ll answer normally."
           end
       end
       return "<b>AI:</b> " .. content
   end
   function extractAIContent(res)
       local decoded
       if type(res) == "table" then
           decoded = res
       else
           pcall(function()
               decoded = HttpService:JSONDecode(tostring(res or ""))
           end)
       end
       if decoded then
           if decoded.choices and decoded.choices[1] and decoded.choices[1].message and decoded.choices[1].message.content then
               return tostring(decoded.choices[1].message.content)
           end
           if decoded.message and decoded.message.content then
               return tostring(decoded.message.content)
           end
           if decoded.content then return tostring(decoded.content) end
           if decoded.text then return tostring(decoded.text) end
           if decoded.response then return tostring(decoded.response) end
           if decoded.answer then return tostring(decoded.answer) end
           if decoded.output then
               if type(decoded.output) == "table" then
                   return table.concat(decoded.output, "\n")
               end
               return tostring(decoded.output)
           end
           if decoded.role or decoded.reasoning or decoded.tool_calls then return "" end
       end
       return tostring(res or "")
   end

   function fetchAutoResponse(api)
       if not api then return end
       if not activeAITabId or not aiTabs[activeAITabId] then
           createAITab("Chat 1")
       end
       appendAIMessage("<b>You:</b> " .. api.name)
       appendAIMessage("<b>" .. api.name .. ":</b> Loading...")
       task.spawn(function()
           local funcs = {}
           local code, body = 0, ""
           if homeHttpRequest then funcs[#funcs + 1] = homeHttpRequest end
           for _, candidate in ipairs(XLQPRequestFunctions()) do funcs[#funcs + 1] = candidate end
           for _, fn in ipairs(funcs) do
               local ok, res = pcall(function()
                   return fn({ Url = api.url, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0" } })
               end)
               code, body = normResponse(ok and res or nil)
               if code >= 200 and code < 300 and body ~= "" then
                   break
               end
           end
           if body == "" then
               pcall(function()
                   body = game:HttpGet(api.url, true)
                   code = 200
               end)
           end
           if code < 200 or code >= 300 or body == "" then
               replaceLastAIMessage("<b>" .. api.name .. ":</b> Could not load right now.")
               return
           end
           local decoded
           pcall(function()
               decoded = HttpService:JSONDecode(body)
           end)
