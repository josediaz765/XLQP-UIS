function XLQPGen1:_NotificationSlot()
	if self.NotificationLayout ~= "Paired" then return NotificationHolder, UDim2.new(1, 0, 0, 0) end
	local row = self._NotificationRow
	local occupied = 0
	if row and row.Parent then
		for _, child in ipairs(row:GetChildren()) do
			if child:IsA("GuiObject") then occupied += 1 end
		end
	else
		row = nil
	end
	if not row or occupied >= 2 then
		row = Create("Frame", {
			Name = "NotificationRow",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
