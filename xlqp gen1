			local autoPairing = { ["("] = ")", ["{"] = "}", ["["] = "]", ['"'] = '"', ["'"] = "'" }
		
			AddConnection(ActualTextbox:GetPropertyChangedSignal("Text"), function()
				updateSyntaxHighlight()
