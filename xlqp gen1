	local marqueeTween=nil
	local function stopMarquee()
		if marqueeTween then marqueeTween:Cancel() marqueeTween=nil end
		SongLabel.Position=UDim2.new(0,0,0,0)
	end
	local function startMarquee()
		stopMarquee()
		task.defer(function()
			local overflow=SongLabel.AbsoluteSize.X-InfoHolder.AbsoluteSize.X
			if overflow>4 then
				local duration=math.clamp(overflow/34,2,14)
				marqueeTween=TweenService:Create(SongLabel,TweenInfo.new(duration,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1,true,1.2),{Position=UDim2.new(0,-overflow,0,0)})
				marqueeTween:Play()
			end
		end)
	end

	local discSpinning=false
	local spinConnection=nil
	local shineRotation=tonumber(VinylSheenGradient.Rotation) or 24
	local spinElapsed=0
	local function stopSpin()
		if spinConnection then spinConnection:Disconnect() spinConnection=nil end
		spinElapsed=0
		discSpinning=false
	end
	local function startSpin()
		if discSpinning then return end
		discSpinning=true
		local spinSpeed=math.clamp(tonumber(Config.SpinSpeed) or 110,24,240)
		spinConnection=RunService.Heartbeat:Connect(function(deltaTime)
			if not (DiscHolder and DiscHolder.Parent and Disc.Playing) then stopSpin() return end
			if (tonumber(XLQPGen1._WindowMotionPausedUntil) or 0)>os.clock() then return end
			if WindowConfig._LocalRegisterState.isGuiBranchVisible and not WindowConfig._LocalRegisterState.isGuiBranchVisible(DiscHolder) then return end
			spinElapsed+=tonumber(deltaTime) or 0
			if spinElapsed<(XLQPGen1._PerformanceMode and 1/24 or 1/60) then return end
			deltaTime=spinElapsed
			spinElapsed=0
			local pitchMultiplier=math.clamp(tonumber(Disc.PlaybackPitch) or 1,0.5,2)
			local step=spinSpeed*pitchMultiplier*math.min(deltaTime,0.1)
			DiscHolder.Rotation=(DiscHolder.Rotation+step)%360
			shineRotation=(shineRotation-step*1.35)%360
			VinylSheenGradient.Rotation=shineRotation
			VinylSheenGradient.Offset=Vector2.new(math.sin(math.rad(shineRotation))*.08,0)
		end)
	end

	local function setPlayingVisual(isPlaying)
		PlayIcon.Visible=not isPlaying
		PauseBarLeft.Visible=isPlaying
		PauseBarRight.Visible=isPlaying
		StatusLabel.Text=isPlaying and "Playing" or "Paused"
		if isPlaying then startSpin() else stopSpin() end
	end

	local function matchingDiscTrack(state)
		local wanted=tostring(state and (state.URL or state.SoundId) or "")
		for index,track in ipairs(Disc.Playlist) do
			local trackUrl=tostring(track.SoundId or track.Url or track.URL or track.url or "")
			if wanted~="" and trackUrl==wanted then return track,index end
		end
		return Disc.Playlist[state and state.Index or Disc.Index],state and state.Index or Disc.Index
	end

	function Disc:_ApplyMediaState(state)
		state=type(state)=="table" and state or {}
		local fallback,index=matchingDiscTrack(state)
		self.Index=tonumber(state.Index) or index or self.Index
		SongLabel.Text=tostring(state.TrackName or fallback and (fallback.Name or fallback.name) or "No song loaded")
		local image=state.Image or fallback and (fallback.Image or fallback.image)
		XLQPAssignProperty(AlbumArt,"Image",image and (GetIcon(image) or image) or "")
		self.Playing=state.Playing==true
		self.PlaybackPitch=tonumber(state.Pitch) or 1
		setPlayingVisual(self.Playing)
		startMarquee()
	end

	function Disc:BindMediaPlayer(mediaPlayer)
		if self._MediaUnsubscribe then pcall(self._MediaUnsubscribe) self._MediaUnsubscribe=nil end
		self.MediaPlayer=mediaPlayer
		if mediaPlayer and type(mediaPlayer.Subscribe)=="function" then
			self._MediaUnsubscribe=mediaPlayer:Subscribe(function(state) self:_ApplyMediaState(state) end)
		elseif mediaPlayer and type(mediaPlayer.GetState)=="function" then
			self:_ApplyMediaState(mediaPlayer:GetState())
		end
		return self
	end

	function Disc:LoadTrack(index)
		if self.MediaPlayer and type(self.MediaPlayer.PlayIndex)=="function" then
			self.MediaPlayer:PlayIndex(index)
			return true
		end
		local track=self.Playlist[index]
		if not track then
			SongLabel.Text="No song loaded"
			AlbumArt.Image=""
			return false
		end
		self.Index=index
		SongLabel.Text=tostring(track.Name or "Unknown Track")
		AlbumArt.Image=track.Image and (GetIcon(track.Image) or track.Image) or ""
		SoundInstance.SoundId=tostring(track.SoundId or "")
		startMarquee()
		return true
	end

	function Disc:Play()
		if XLQPGen1._SetupPresentationLock==true or XLQPGen1._SetupFlowOpen==true or XLQPGen1._StartupBlocked==true then
			self._SetupPlayPending=true
			return false
		end
		self._SetupPlayPending=nil
		if self.MediaPlayer and type(self.MediaPlayer.Play)=="function" then return self.MediaPlayer:Play() end
		if #self.Playlist==0 then return false end
		if SoundInstance.SoundId=="" then self:LoadTrack(self.Index) end
		SoundInstance:Play()
		self.Playing=true
		setPlayingVisual(true)
		startSpin()
		return true
	end

	function Disc:Pause()
		self._SetupPlayPending=nil
		if self.MediaPlayer and type(self.MediaPlayer.Pause)=="function" then self.MediaPlayer:Pause() return end
		SoundInstance:Pause()
		self.Playing=false
		setPlayingVisual(false)
	end

	function Disc:TogglePlay()
		if self.MediaPlayer and type(self.MediaPlayer.TogglePlay)=="function" then self.MediaPlayer:TogglePlay() return end
		if self.Playing then self:Pause() else self:Play() end
	end

	function Disc:Next()
		if self.MediaPlayer and type(self.MediaPlayer.Next)=="function" then self.MediaPlayer:Next() return end
		if #self.Playlist==0 then return end
		local nextIndex=self.Index+1
		if nextIndex>#self.Playlist then nextIndex=1 end
		self:LoadTrack(nextIndex)
		if self.Playing then self:Play() end
	end

	function Disc:Previous()
		if self.MediaPlayer and type(self.MediaPlayer.Previous)=="function" then self.MediaPlayer:Previous() return end
		if #self.Playlist==0 then return end
		local prevIndex=self.Index-1
		if prevIndex<1 then prevIndex=#self.Playlist end
		self:LoadTrack(prevIndex)
		if self.Playing then self:Play() end
	end

	function Disc:Show()
		self.Visible=true
		Root:SetAttribute("XLQPSetupDesiredVisible",true)
		if XLQPGen1._SetupPresentationLock==true or XLQPGen1._SetupFlowOpen==true or XLQPGen1._StartupBlocked==true then
			Root.Visible=false
		else
			Root.Visible=true
		end
		return self
	end

	function Disc:Hide()
		self.Visible=false
		Root:SetAttribute("XLQPSetupDesiredVisible",false)
		Root.Visible=false
		return self
	end

	function Disc:Toggle()
		if self.Visible then self:Hide() else self:Show() end
		return self
	end

	function Disc:Destroy()
		if self.MediaPlayer then stopSpin() else self:Pause() end
		if self._MediaUnsubscribe then pcall(self._MediaUnsubscribe) self._MediaUnsubscribe=nil end
		Root:Destroy()
	end

	AddConnection(SoundInstance.Ended,function()
		if Config.Loop and #Disc.Playlist>0 then Disc:Next() end
	end)
	AddConnection(PlayButton.MouseButton1Click,function() Disc:TogglePlay() end)
	AddConnection(NextButton.MouseButton1Click,function() Disc:Next() end)
	AddConnection(PrevButton.MouseButton1Click,function() Disc:Previous() end)
	AddConnection(CloseBtn.MouseButton1Click,function() Disc:Hide() end)

	if Config.MediaPlayer or Config.SyncWith then
		Disc:BindMediaPlayer(Config.MediaPlayer or Config.SyncWith)
	else
		if #Disc.Playlist>0 then Disc:LoadTrack(1) end
		if Config.AutoPlay and #Disc.Playlist>0 then Disc:Play() end
	end
	if Config.Visible==false then
		Disc:Hide()
	elseif XLQPGen1._SetupPresentationLock==true or XLQPGen1._SetupFlowOpen==true or XLQPGen1._StartupBlocked==true then
		Root.Visible=false
	end

	XLQPGen1._DiscPlayers=XLQPGen1._DiscPlayers or {}
	table.insert(XLQPGen1._DiscPlayers,Disc)
	return Disc
end
