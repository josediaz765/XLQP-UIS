function XLQPGen1:_RiskConfigPath()
	local config=self._WindowConfig or self._ActiveWindowConfig or {}
	local folder=tostring(config.ConfigFolder or self.Folder or "XLQPGen1")
	return folder.."/risk_tabs.json",folder
end

function XLQPGen1:_LoadRiskAcknowledgements()
	local path=self:_RiskConfigPath()
	if self._RiskAcknowledgementCache and self._RiskAcknowledgementCache.Path==path then return self._RiskAcknowledgementCache.Values end
	local values={}
	if isfile and readfile and isfile(path) then
		pcall(function()
			local decoded=HttpService:JSONDecode(readfile(path))
			if type(decoded)=="table" then values=decoded end
		end)
	end
	self._RiskAcknowledgementCache={Path=path,Values=values}
	return values
end

function XLQPGen1:_RiskTabKey(tabInfo)
	local config=tabInfo and tabInfo.Config or {}
	local id=tostring(config.RiskId or config.Id or config.Name or config.Title or tabInfo and tabInfo.Name or "RiskyTab")
	return tostring(game.GameId or game.PlaceId or 0)..":"..id
end

function XLQPGen1:IsRiskAcknowledged(tabInfo)
	local values=self:_LoadRiskAcknowledgements()
	return values[self:_RiskTabKey(tabInfo)]~=nil and values[self:_RiskTabKey(tabInfo)]~=false
end

function XLQPGen1:AcknowledgeRisk(tabInfo)
	local path,folder=self:_RiskConfigPath()
	local values=self:_LoadRiskAcknowledgements()
	values[self:_RiskTabKey(tabInfo)]={accepted=true,time=os.time()}
	self._RiskAcknowledgementCache={Path=path,Values=values}
	if makefolder then pcall(function() if not isfolder or not isfolder(folder) then makefolder(folder) end end) end
	if writefile then pcall(function() writefile(path,HttpService:JSONEncode(values)) end) end
	return true
end

function XLQPGen1:ClearRiskAcknowledgements()
	local path,folder=self:_RiskConfigPath()
	self._RiskAcknowledgementCache={Path=path,Values={}}
	if makefolder then pcall(function() if not isfolder or not isfolder(folder) then makefolder(folder) end end) end
	if writefile then pcall(function() writefile(path,"{}") end) end
	return self
end

function XLQPGen1:_CreateTabSelectionRequest(tabInfo, continueCallback)
	local request={Tab=tabInfo,Name=tostring(tabInfo and tabInfo.Name or "Tab"),Deferred=false,Cancelled=false,Completed=false}
	function request:Cancel() if self.Completed then return self end self.Cancelled=true self.Completed=true return self end
	function request:Continue() if self.Completed then return self end self.Completed=true self.Deferred=false if type(continueCallback)=="function" then task.defer(continueCallback) end return self end
	function request:Prompt(config)
		if self.Completed then return self end
		config=type(config)=="table" and config or {}
		self.Deferred=true
		local options=config.Options or config.options or {{Text="Accept",Timeout=tonumber(config.Timeout or config.timeout) or 0,Accept=true},{Text="Cancel",Accept=false}}
		local normalized={}
		for _,option in ipairs(options) do
			option=type(option)=="table" and option or {Text=tostring(option)}
