local origin=MainWindow.AbsolutePosition
local extent=MainWindow.AbsoluteSize
local wantPosition=UDim2.fromOffset(math.floor(origin.X),math.floor(origin.Y+extent.Y+8))
local wantSize=UDim2.fromOffset(math.max(360,math.floor(extent.X)),28)
local wantVisible=WindowConfig.StatusBar~=false and MainWindow.Visible==true and XLQPGen1._StartupBlocked~=true and XLQPGen1._MainWindowMinimized~=true and Minimized~=true
if bar.Position~=wantPosition then bar.Position=wantPosition end
if bar.Size~=wantSize then bar.Size=wantSize end
if bar.Visible~=wantVisible then bar.Visible=wantVisible end
statusVisible=wantVisible
if wantVisible and type(statsState.statusBarRefresh)=="function" then
	task.defer(function()
		if statusAlive and bar.Parent and bar.Visible then
			statsState.statusBarRefresh(statsState.fps,statsState.ping,true)
		end
	end)
end
end
