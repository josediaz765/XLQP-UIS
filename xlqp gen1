	local buttonsWidth=math.max(118,(size.X.Offset>0 and size.X.Offset or width)-infoX-10)
	local rejoinButton
	local serverHopButton
	if rejoinEnabled and serverHopEnabled then
		local rejoinWidth=math.max(56,math.floor((buttonsWidth-6)*0.42))
		local hopWidth=math.max(72,buttonsWidth-rejoinWidth-6)
		rejoinButton=makeInfoButton("Rejoin",infoX,rejoinWidth)
		serverHopButton=makeInfoButton("Server Hop",infoX+rejoinWidth+6,hopWidth)
	elseif rejoinEnabled then
		rejoinButton=makeInfoButton("Rejoin",infoX,math.min(92,buttonsWidth))
	elseif serverHopEnabled then
		serverHopButton=makeInfoButton("Server Hop",infoX,math.min(112,buttonsWidth))
	end

	if rejoinButton then
		AddConnection(rejoinButton.Activated,function()
			if type(gameInfo.RejoinCallback)=="function" then
				SafeCallback(gameInfo.RejoinCallback,"Widget game rejoin")
				return
			end
			local player=Players.LocalPlayer
			if player then pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId,player) end) end
		end)
	end

	if serverHopButton then
		AddConnection(serverHopButton.Activated,function()
			if type(gameInfo.ServerHopCallback)=="function" then
				SafeCallback(gameInfo.ServerHopCallback,"Widget game server hop")
				return
			end
			task.spawn(function()
				local player=Players.LocalPlayer
				if not player then return end
				local ok,raw=pcall(function()
					return game:HttpGet("https://games.roblox.com/v1/games/"..tostring(game.PlaceId).."/servers/Public?sortOrder=Asc&limit=100")
				end)
				if not ok then
					local requester=XLQPResolveRequest()
					if type(requester)=="function" then
						local responseOk,response=pcall(requester,{
							Url="https://games.roblox.com/v1/games/"..tostring(game.PlaceId).."/servers/Public?sortOrder=Asc&limit=100",
							Method="GET",
							Headers={["Accept"]="application/json"}
						})
						if responseOk and type(response)=="table" then raw=tostring(response.Body or response.body or "") ok=raw~="" end
					end
				end
				if not ok then return end
				local decodedOk,data=pcall(HttpService.JSONDecode,HttpService,raw)
				if not decodedOk or type(data)~="table" or type(data.data)~="table" then return end
				for _,server in ipairs(data.data) do
					if tostring(server.id or "")~="" and tostring(server.id)~=tostring(game.JobId) and tonumber(server.playing or 0)<tonumber(server.maxPlayers or 0) then
						pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId,tostring(server.id),player) end)
						break
					end
				end
			end)
		end)
	end

	local widget={
		Name=widgetKey,
		Config=widgetConfig,
		Frame=card,
		TitleLabel=title,
		GameCreatorLabel=creator,
		Image=hero,
		RejoinButton=rejoinButton,
		ServerHopButton=serverHopButton,
		Visible=card.Visible,
		IsGameInfoWidget=true
	}

	setmetatable(widget,{__index=function(_,key)
		if tostring(key):match("^Add") then return function() return nil end end
	end})

	function widget:SetVisible(value)
		self.Visible=value==true
		card.Visible=self.Visible
		return self
	end

	function widget:Toggle(value)
		if value==nil then value=not card.Visible end
		return self:SetVisible(value)
	end

	function widget:SetPosition(value)
		if typeof(value)=="UDim2" then card.Position=value end
		return self
	end

	function widget:SetSize(value,heightValue)
