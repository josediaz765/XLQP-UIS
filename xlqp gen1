XLQPGen1._UIAudio=setmetatable({},{__mode="k"})
XLQPGen1._GlobalMuteEnabled=false
XLQPGen1._GlobalMuteVolumes=setmetatable({},{__mode="k"})
XLQPGen1._GlobalMuteWatchers=setmetatable({},{__mode="k"})
XLQPGen1._GlobalMuteConnections={}

function XLQPGen1:RegisterUIAudio(sound)
	if typeof(sound)~="Instance" then return sound end
	if not (sound:IsA("Sound") or sound:IsA("AudioPlayer")) then return sound end
	self._UIAudio[sound]=true
	pcall(function() sound:SetAttribute("XLQPUIAudio",true) end)
	local watcher=self._GlobalMuteWatchers[sound]
	if watcher then
		pcall(function() watcher:Disconnect() end)
		self._GlobalMuteWatchers[sound]=nil
	end
	local stored=self._GlobalMuteVolumes[sound]
	if stored~=nil then
		self._GlobalMuteVolumes[sound]=nil
		pcall(function() sound.Volume=stored end)
	end
	return sound
end

function XLQPGen1:IsUIAudio(sound)
	if typeof(sound)~="Instance" then return false end
	if self._UIAudio[sound] then return true end
	local tagged=false
	pcall(function() tagged=sound:GetAttribute("XLQPUIAudio")==true end)
	if tagged then return true end
	if XLQPGen1Gui and sound:IsDescendantOf(XLQPGen1Gui) then return true end
	local pluginsWindow=self._PluginsWindowRef
	if pluginsWindow and typeof(pluginsWindow)=="Instance" and sound:IsDescendantOf(pluginsWindow) then return true end
	return false
end

local XLQPGlobalMuteRootCache
local function XLQPGlobalMuteRoots()
	if XLQPGlobalMuteRootCache then return XLQPGlobalMuteRootCache end
	local roots={}
	local function add(name)
		local ok,service=pcall(function() return game:GetService(name) end)
		if ok and typeof(service)=="Instance" then table.insert(roots,service) end
	end
	add("Workspace")
	add("SoundService")
	add("Players")
	XLQPGlobalMuteRootCache=roots
	return roots
end

function XLQPGlobalMuteEligible(sound)
	if typeof(sound)~="Instance" then return false end
	if not (sound:IsA("Sound") or sound:IsA("AudioPlayer")) then return false end
	if XLQPGen1:IsUIAudio(sound) then return false end
	for _,root in ipairs(XLQPGlobalMuteRoots()) do
		if sound:IsDescendantOf(root) then return true end
	end
	return false
end

function XLQPWatchMutedSound(sound)
	if XLQPGen1._GlobalMuteWatchers[sound] then return end
	local ok,connection=pcall(function()
		return sound:GetPropertyChangedSignal("Volume"):Connect(function()
			if not XLQPGen1._GlobalMuteEnabled then return end
			local level=sound.Volume
			if level and level>0 then
				XLQPGen1._GlobalMuteVolumes[sound]=level
				sound.Volume=0
			end
		end)
	end)
	if ok and connection then XLQPGen1._GlobalMuteWatchers[sound]=connection end
end

local function XLQPMuteSound(sound)
	if not XLQPGlobalMuteEligible(sound) then return end
	pcall(function()
		if XLQPGen1._GlobalMuteVolumes[sound]==nil then
			XLQPGen1._GlobalMuteVolumes[sound]=sound.Volume
		end
		if sound.Volume~=0 then sound.Volume=0 end
	end)
	XLQPWatchMutedSound(sound)
end

function XLQPRestoreMutedSounds(scanToken)
	local processed=0
	for sound,connection in pairs(XLQPGen1._GlobalMuteWatchers) do
		if scanToken and (scanToken~=XLQPGen1._GlobalMuteScanToken or XLQPGen1._GlobalMuteEnabled) then return end
		pcall(function() connection:Disconnect() end)
		XLQPGen1._GlobalMuteWatchers[sound]=nil
		processed+=1
		if processed%80==0 then RunService.Heartbeat:Wait() end
	end
	for sound,level in pairs(XLQPGen1._GlobalMuteVolumes) do
		if scanToken and (scanToken~=XLQPGen1._GlobalMuteScanToken or XLQPGen1._GlobalMuteEnabled) then return end
		XLQPGen1._GlobalMuteVolumes[sound]=nil
		pcall(function()
			if sound.Parent then sound.Volume=level end
		end)
		processed+=1
		if processed%80==0 then RunService.Heartbeat:Wait() end
	end
end

function XLQPGen1:GetGlobalSoundsMuted()
	return self._GlobalMuteEnabled==true
end

function XLQPGen1:SetGlobalSoundsMuted(state)
	state=state==true
	if state~=self._GlobalMuteEnabled then
		self._GlobalMuteEnabled=state
		self._GlobalMuteScanToken=(tonumber(self._GlobalMuteScanToken) or 0)+1
		local scanToken=self._GlobalMuteScanToken
		if state then
			table.insert(self._GlobalMuteConnections,AddConnection(game.DescendantAdded,function(object)
				if not XLQPGen1._GlobalMuteEnabled then return end
				if typeof(object)~="Instance" then return end
				if object:IsA("Sound") or object:IsA("AudioPlayer") then
					XLQPMuteSound(object)
				end
			end))
			task.spawn(function()
				local processed=0
				for _,root in ipairs(XLQPGlobalMuteRoots()) do
					if scanToken~=self._GlobalMuteScanToken or not self._GlobalMuteEnabled then return end
					local ok,descendants=pcall(function() return root:GetDescendants() end)
					if ok and type(descendants)=="table" then
						for _,object in ipairs(descendants) do
							if scanToken~=self._GlobalMuteScanToken or not self._GlobalMuteEnabled then return end
							XLQPMuteSound(object)
							processed+=1
							if processed%80==0 then RunService.Heartbeat:Wait() end
						end
					end
				end
			end)
		else
			for index=#self._GlobalMuteConnections,1,-1 do
				local connection=self._GlobalMuteConnections[index]
				pcall(function() connection:Disconnect() end)
				self._GlobalMuteConnections[index]=nil
			end
			task.spawn(XLQPRestoreMutedSounds,scanToken)
		end
	end
	if self._GlobalMuteSyncing then return self._GlobalMuteEnabled end
	self._GlobalMuteSyncing=true
	local settingsToggle=self._GlobalMuteSettingsToggle
	if settingsToggle and settingsToggle.Refresh then pcall(settingsToggle.Refresh) end
	local tabToggle=self._GlobalMuteTabToggle
	if tabToggle and tabToggle.Set and tabToggle.Value~=self._GlobalMuteEnabled then
		pcall(function() tabToggle:Set(self._GlobalMuteEnabled,true) end)
	end
	self._GlobalMuteSyncing=false
	return self._GlobalMuteEnabled
end

function XLQPGen1:ToggleGlobalSounds()
	return self:SetGlobalSoundsMuted(not self._GlobalMuteEnabled)
end


