		PluginsData:Scan()
		for _,row in ipairs(pluginRows) do row.Frame:Destroy() end
		table.clear(pluginRows)
		PluginsCountLabel.Text=(#PluginsData.Items==1) and "1 installed" or (tostring(#PluginsData.Items).." installed")
		PluginsEmptyState.Visible=#PluginsData.Items==0
		if #PluginsData.Items==0 then
			PluginsCodeScroll.Visible=false
			PluginsSelectHintFrame.Visible=false
			PluginsData.Selected=nil
		end
		for index,record in ipairs(PluginsData.Items) do
			local nameLabel=AddThemeObject(SetProps(MakeElement("Label",record.Name,12),{Size=UDim2.new(1,-64,1,0),Position=UDim2.new(0,8,0,0),Font=Enum.Font.GothamSemibold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd}),"Text")
