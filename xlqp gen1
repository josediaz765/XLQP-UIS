function XLQPGen1:_QuickPanelPointInside(gui,point)
	if not (gui and gui.Parent and gui:IsA("GuiObject")) then return false end
	local position=gui.AbsolutePosition
	local size=gui.AbsoluteSize
	return point.X>=position.X and point.X<=position.X+size.X and point.Y>=position.Y and point.Y<=position.Y+size.Y
end

function XLQPGen1:_QuickPanelPosition(panel,button)
	if not (panel and panel.Parent) then return end
	local camera=workspace.CurrentCamera
	local viewport=camera and camera.ViewportSize or Vector2.new(1280,720)
	local panelSize=panel.AbsoluteSize
	if panelSize.X<=0 or panelSize.Y<=0 then panelSize=Vector2.new(panel.Size.X.Offset,panel.Size.Y.Offset) end
	local x=viewport.X-panelSize.X-12
	local y=70
	if button and button.Parent then
		local pos=button.AbsolutePosition
		local size=button.AbsoluteSize
		x=(pos.X+size.X)-panelSize.X
		y=pos.Y+size.Y+8
	end
	x=math.clamp(x,8,math.max(8,viewport.X-panelSize.X-8))
	y=math.clamp(y,8,math.max(8,viewport.Y-panelSize.Y-8))
	panel.Position=UDim2.fromOffset(math.floor(x),math.floor(y))
end

function XLQPGen1:_GetActiveQuickToggles()
	local list={}
	local seen={}
	for _,element in ipairs(self.AllElements or {}) do
		if type(element)=="table" and element.Type=="Toggle" and element.Value==true and element._InternalQuickPanel~=true and not seen[element] then
			local wrapper=element.Wrapper
			if typeof(wrapper)~="Instance" or wrapper.Parent then
				seen[element]=true
				list[#list+1]=element
			end
		end
	end
	table.sort(list,function(a,b) return tostring(a.Name or "Toggle"):lower()<tostring(b.Name or "Toggle"):lower() end)
	return list
end

function XLQPGen1:_UpdateQuickPanelBadges()
	local activeCount=#self:_GetActiveQuickToggles()
	if self._QuickToggleBadge and self._QuickToggleBadge.Parent then
		self._QuickToggleBadge.Visible=activeCount>0
		self._QuickToggleBadge.Text=activeCount>99 and "99+" or tostring(activeCount)
	end
	local unread=math.max(0,tonumber(self._QuickNotificationUnread) or 0)
	if self._QuickNotificationBadge and self._QuickNotificationBadge.Parent then
		self._QuickNotificationBadge.Visible=unread>0
		self._QuickNotificationBadge.Text=unread>99 and "99+" or tostring(unread)
	end
end

function XLQPGen1:_RecordQuickNotification(config)
	local quickConfig=self:_GetTopBarQuickPanelsConfig()
	if not quickConfig or quickConfig.Notifications==false then return end
	self._QuickNotificationHistory=self._QuickNotificationHistory or {}
	local entry={
		Name=tostring(config.Name or "Notification"),
		Content=tostring(config.Content or ""),
		Image=config.Image or config.Icon or "bell",
		Time=os.time(),
		TimeText=os.date("%I:%M:%S %p")
	}
	table.insert(self._QuickNotificationHistory,1,entry)
	local limit=math.clamp(tonumber(quickConfig.NotificationLimit) or 100,10,500)
	while #self._QuickNotificationHistory>limit do table.remove(self._QuickNotificationHistory) end
	if not self._QuickNotificationsPanelOpen then self._QuickNotificationUnread=(tonumber(self._QuickNotificationUnread) or 0)+1 end
	if self._QuickNotificationsPanelOpen and self._RefreshQuickNotifications then task.defer(function() pcall(function() self:_RefreshQuickNotifications() end) end) end
	self:_UpdateQuickPanelBadges()
end

function XLQPGen1:_RaiseQuickPanelZ(panel)
	if typeof(panel)~="Instance" or not panel.Parent then return end
	local base=250000
	panel.ZIndex=base
	for _,object in ipairs(panel:GetDescendants()) do
		if object:IsA("GuiObject") then
			local depth=0
			local node=object.Parent
			while node and node~=panel and depth<6 do
				depth+=1
				node=node.Parent
			end
			local z=base+10+depth*4
			if object.Name=="Close" then z=base+90 end
			if object.Parent and object.Parent.Name=="Close" then z=base+91 end
			object.ZIndex=z
		end
	end
end

