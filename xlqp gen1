	header:SetAttribute("SideTabGroupKey", key)
	local compactNow=WindowConfig.ShowTabInfo==false or ((mainSidebarDragWidth or getMainSidebarWidth())<(tonumber(WindowConfig.SidebarCompactBreakpoint) or 132))
	if compactNow then
		label.Visible=false
		arrow.Visible=false
