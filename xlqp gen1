				local old = self.Value
				self.Value = math.clamp(Round(tonumber(Value) or self.Value, SliderConfig.Increment), SliderConfig.Min, SliderConfig.Max)
				local range = SliderConfig.Max - SliderConfig.Min
				local percent = range == 0 and 0 or math.clamp((self.Value - SliderConfig.Min) / range, 0, 1)
				applyVisual(percent, Instant == true or Dragging)
				local rawText, display = formatValue(self.Value)
				insideValue.Text = display
				if inputBox and not inputBox:IsFocused() then inputBox.Text = SliderConfig.DisplayFormattedInput and display or rawText end
				if topValueLabel then topValueLabel.Text = display end
				if not Silent and (old ~= self.Value or self._InitialCallback ~= true) then
					self._InitialCallback = true
					local now = os.clock()
					if not Dragging or now - lastCallback >= 1 / 60 then
						lastCallback = now
						SafeCallback(SliderConfig.Callback, SliderConfig.Name or "Slider", self.Value)
						self:_EmitChanged(self.Value)
					end
				end
			end
