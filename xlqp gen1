function XLQPGen1:ReportLoadingError(errorValue,moduleName)
	local message=tostring(errorValue or "Unknown initialization error")
	if self._GateActive then return message end
	if self._FatalLoadingError then return self._FatalLoadingError end
	self._FatalLoadingError=message
	self._ModuleLoadFailed=true
	self._StartupAbortToken=(tonumber(self._StartupAbortToken) or 0)+1
	self._StartupBlocked=true
	self._Initialized=false
	self._PendingInit=false
	self._HasLibErrors=true
	self._LastLibError=message
	if self._StopUIBuildWatcher then self:_StopUIBuildWatcher() end
	self._LoadingOverlay=nil
	if self._ActiveMainWindow then self._ActiveMainWindow.Visible=false end
	if self._MainWindow then self._MainWindow.Visible=false end
	if self._RootGui and self._RootGui.Parent then self._RootGui.Enabled=false end
	if self._UtilityDock and self._UtilityDock.Parent then self._UtilityDock.Visible=false end
	if self._TopStatsPill and self._TopStatsPill.Parent then self._TopStatsPill.Visible=false end
	for _,floatingLabel in ipairs(self._floatingLabels or {}) do
		if floatingLabel and type(floatingLabel.SetVisible)=="function" then pcall(function() floatingLabel:SetVisible(false) end) end
	end
	local loading=self._ActiveLoading
	if loading and not loading.Closed and type(loading.ShowError)=="function" then
		loading:ShowError(message,moduleName or "Module loader")
	elseif self._LoadingIssueLabel then
		local line=message:match("[Ll]ine%s+(%d+)") or message:match(":(%d+):") or "unknown"
		self._LoadingIssueLabel.Text="We couldn't run the UI. We found an error • "..tostring(moduleName or "Module loader").." • Line "..tostring(line)
		self._LoadingIssueLabel.Visible=true
	end
	return message
end

