	if not ok then return false,"Could not encode saved custom themes" end
	local wrote,err=pcall(writefile,tostring(self.CustomLiveMediaThemesFile),encoded)
	return wrote,wrote and nil or tostring(err)
end

function XLQPGen1:GetSavedCustomLiveMediaThemes()
	local source=self:_ReadCustomLiveMediaThemes()
	local result={}
	for _,entry in ipairs(source) do
		if type(entry)=="table" and tostring(entry.Name or "")~="" and tostring(entry.Link or "")~="" then
			local copy={}
			for key,value in pairs(entry) do copy[key]=value end
			result[#result+1]=copy
		end
	end
	table.sort(result,function(a,b) return tostring(a.Name):lower()<tostring(b.Name):lower() end)
	return result
end

function XLQPGen1:SaveCustomLiveMediaTheme(entry)
	entry=type(entry)=="table" and entry or {}
	local name=tostring(entry.Name or ""):match("^%s*(.-)%s*$")
	local link=tostring(entry.Link or ""):match("^%s*(.-)%s*$")
	if name=="" or link=="" then return false,"Theme name and media link are required." end
	local mediaType=tostring(entry.Type or self:_DetectCustomLiveMediaType(link))
	local themes=self:_ReadCustomLiveMediaThemes()
	local found=false
	for index,item in ipairs(themes) do
		if type(item)=="table" and tostring(item.Name or ""):lower()==name:lower() then
			themes[index]={
				Name=name,
				Link=link,
				Type=mediaType,
				Sync=entry.Sync~=false,
				Transparency=math.clamp(tonumber(entry.Transparency) or 0.14,0,1),
				Updated=os.time()
			}
			found=true
			break
		end
	end
	if not found then
		themes[#themes+1]={
			Name=name,
			Link=link,
			Type=mediaType,
			Sync=entry.Sync~=false,
			Transparency=math.clamp(tonumber(entry.Transparency) or 0.14,0,1),
			Updated=os.time()
		}
	end
	self._CustomLiveMediaThemesMemory=themes
	local ok,err=self:_WriteCustomLiveMediaThemes()
	if type(writefile)~="function" then return true,"Saved for this session." end
	return ok,err
end

function XLQPGen1:DeleteCustomLiveMediaTheme(name)
	name=tostring(name or ""):match("^%s*(.-)%s*$")
	if name=="" then return false,"Select a saved theme first." end
	local themes=self:_ReadCustomLiveMediaThemes()
	local removed=false
	for index=#themes,1,-1 do
		local entry=themes[index]
		if type(entry)=="table" and tostring(entry.Name or ""):lower()==name:lower() then
			table.remove(themes,index)
			removed=true
		end
	end
	self._CustomLiveMediaThemesMemory=themes
	if not removed then return false,"Saved theme was not found." end
	if type(writefile)=="function" then
		local ok,err=self:_WriteCustomLiveMediaThemes()
		if not ok then return false,err end
	end
	return true
end

function XLQPGen1:_DetectCustomLiveMediaType(link)
	local value=tostring(link or ""):match("^%s*(.-)%s*$")
	local lower=value:lower()
	if lower:find("tenor.com",1,true) or lower:match("%.gif[%?#]?") then return "GIF" end
	if lower:match("%.mp4[%?#]?") or lower:match("%.webm[%?#]?") or lower:match("%.mov[%?#]?") or lower:match("%.m4v[%?#]?") then return "Video" end
	if XLQPAssetId(value) then return "Image" end
	return "Image"
end

function XLQPGen1:_CustomLiveMediaDisplayName(link)
	local value=tostring(link or ""):match("^%s*(.-)%s*$")
	local assetId=XLQPAssetId(value)
	if assetId then return "Roblox Image "..tostring(assetId) end
	local clean=value:gsub("[?#].*$","")
	local name=clean:match("([^/]+)$") or ""
	name=name:gsub("%.[%w%d]+$",""):gsub("%%20"," "):gsub("[_%-]+"," ")
	name=name:match("^%s*(.-)%s*$")
	if name=="" then
		local kind=self:_DetectCustomLiveMediaType(value)
		return kind=="GIF" and "Custom GIF" or kind=="Video" and "Custom Video" or "Custom Image"
	end
	return name
end

function XLQPGen1:_ResolveCustomLiveMediaAsset(link,mediaType)
	link=tostring(link or ""):match("^%s*(.-)%s*$")
	if link=="" then return nil,"Paste a media link first." end
	mediaType=tostring(mediaType or self:_DetectCustomLiveMediaType(link))
	local assetId=XLQPAssetId(link)
	if assetId and mediaType=="Image" then return "rbxassetid://"..tostring(assetId),nil end
	local resolver=XLQPGetCustomAsset or getcustomasset or getsynasset
	if not link:match("^https?://") then
		if type(isfile)=="function" and isfile(link) and type(resolver)=="function" then
			local ok,asset=pcall(resolver,link)
			if ok and asset then return asset,link end
		end
		return nil,"Local media file was not found."
	end
	if type(writefile)~="function" or type(resolver)~="function" then
		return nil,"writefile/getcustomasset support is required for URL media."
	end
	local folder=self:_EnsureCustomLiveMediaFolder()
	local hash=5381
	for index=1,#link do hash=(hash*33+link:byte(index))%2147483647 end
	local lower=link:lower()
	local extension=lower:match("%.([%w%d]+)[%?#]?")
	if mediaType=="Video" then
		if extension~="mp4" and extension~="webm" and extension~="mov" and extension~="m4v" then extension="webm" end
	elseif mediaType=="Image" then
		if extension~="png" and extension~="jpg" and extension~="jpeg" and extension~="webp" then extension="png" end
	else
		extension=extension or "bin"
	end
	local path=folder.."/media_"..tostring(hash).."."..tostring(extension)
	if type(isfile)=="function" and isfile(path) then
		local ok,asset=pcall(resolver,path)
		if ok and asset then return asset,path end
	end
	local requester=request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)
	local body
	if type(requester)=="function" then
		local ok,response=pcall(requester,{Url=link,Method="GET",Headers={["User-Agent"]="Mozilla/5.0",["Accept"]="*/*"}})
		if ok and type(response)=="table" then
			local code=tonumber(response.StatusCode or response.Status) or 0
			if (response.Success==true or (code>=200 and code<300)) and type(response.Body or response.body)=="string" then
				body=response.Body or response.body
			end
		end
	end
	if not body then
		local ok,result=pcall(function() return game:HttpGet(link,true) end)
		if ok and type(result)=="string" then body=result end
	end
	if not body or #body<8 then return nil,"Media download failed." end
	local wrote=pcall(writefile,path,body)
	if not wrote then return nil,"Media could not be cached." end
	local ok,asset=pcall(resolver,path)
	if not ok or not asset then return nil,"getcustomasset could not load the downloaded media." end
	return asset,path
end

function XLQPGen1:GetLiveColorThemes()
	local names={}
	for name in pairs(XLQPLiveColorThemes) do
