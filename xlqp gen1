	if not parentTopTab or not groupName or tostring(groupName)=="" then return nil end
	groupIdentity=tostring(groupName):lower():gsub("^%s+",""):gsub("%s+$","")
	key=tostring(parentTopTab).."|"..groupIdentity
	if SideTabGroups[key] then return SideTabGroups[key] end
	parentTopTab._NextSideGroupOrder=(tonumber(parentTopTab._NextSideGroupOrder) or 0)+1
	groupBaseOrder=tonumber(requestedGroupOrder)
	if groupBaseOrder then
		groupBaseOrder=math.clamp(math.floor(groupBaseOrder),0,199)*10000000
