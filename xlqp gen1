			end)

			AddConnection(Click.MouseButton1Down, function()
				if BindConfig.Locked then return end
				if not XLQPGen1:IsLiveColorBound(BindFrame) then TweenService:Create(BindFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundColor3 = XLQPGen1.Themes[XLQPGen1.SelectedTheme].Second:Lerp(Color3.new(0,0,0), 0.1)}):Play() end
			end)

			function Bind:SetMenuVisibility(visible)
				Bind.MenuVisible=visible~=false
				task.defer(function()
					if XLQPGen1.RefreshKeybindFrame then XLQPGen1:RefreshKeybindFrame() end
					if XLQPGen1._QueueControlPanelRefresh then XLQPGen1:_QueueControlPanelRefresh(false) end
				end)
				return Bind
			end

			function Bind:GetMenuVisibility()
				return Bind.MenuVisible~=false
			end

			function Bind:Set(Key)
				Bind.Binding = false
				Bind.Value = (typeof(Key) == "EnumItem" and Key.Name) or (type(Key) == "string" and Key) or "None"
				if BindConfig.UIBind == true then
					Bind.Value = setUIToggleKey(Bind.Value)
				end
				if BindBox and BindBox.Value then BindBox.Value.Text = Bind.Value end
				if XLQPGen1._QueueControlPanelRefresh then XLQPGen1:_QueueControlPanelRefresh(false) end
				task.wait()
				if BindBox and BindBox.Value and BindBox.Value.TextBounds.X > 0 then
					TweenService:Create(BindBox, TweenInfo.new(0.1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, BindBox.Value.TextBounds.X + 16, 0, 24)}):Play()
				end
			end

			Bind:Set(BindConfig.Default)
			if BindConfig.Flag then
				XLQPGen1.Flags[BindConfig.Flag] = Bind
			end
			return Bind
		end
