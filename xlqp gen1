				MediaCtl.Effect2=Create("ReverbSoundEffect",{Name="XLQPGen1MediaEffect",DecayTime=1.8,Density=0.8,Diffusion=0.85,WetLevel=-10,DryLevel=-1,Parent=currentMediaInstance})
			elseif currentPreset=="Cinema" then
