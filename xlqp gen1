	function Toggle:Set(Value, Silent)
		Toggle.Value = Value == true
		local currentTheme = XLQPGen1.Themes[XLQPGen1.SelectedTheme] or XLQPGen1.Themes.Default
		local currentSecond = currentTheme.Second or currentTheme.Main or Color3.fromRGB(32,34,40)
		local currentLightness = (currentSecond.R + currentSecond.G + currentSecond.B) / 3
		local neutralOff = currentLightness > 0.58 and Color3.fromRGB(226,228,233) or Color3.fromRGB(43,46,54)
		local neutralStroke = currentLightness > 0.58 and Color3.fromRGB(176,180,190) or Color3.fromRGB(91,96,108)
		if ToggleConfig.Checkbox then
			local bgColor = Toggle.Value and ToggleConfig.Color or neutralOff
			local strokeColor = Toggle.Value and ToggleConfig.Color or neutralStroke
			tweenGui(toggleElement, {BackgroundColor3 = bgColor}, 0.24)
			tweenGui(toggleElement.Stroke, {Color = strokeColor}, 0.24)
			local icon = toggleElement:FindFirstChild(iconName)
			if icon then
				tweenGui(icon, {
					ImageTransparency = Toggle.Value and 0 or 1,
					Size = Toggle.Value and UDim2.new(0, 20, 0, 20) or UDim2.new(0, 8, 0, 8)
				}, 0.24)
			end
		else
			local pillColor = Toggle.Value and ToggleConfig.Color or neutralOff
			local knobPosition = Toggle.Value and UDim2.new(0, 28, 0.5, 0) or UDim2.new(0, 10, 0.5, 0)
			tweenGui(toggleElement, {BackgroundColor3 = pillColor}, 0.2)
			tweenGui(toggleElement.Knob, {Position = knobPosition}, 0.2)
			if ToggleConfig.ImageIcon then
				local imageIcon = toggleElement.Knob:FindFirstChild("ImageIcon")
				if imageIcon then
					tweenGui(imageIcon, {ImageTransparency = Toggle.Value and 0 or 1}, 0.2)
				end
			end
		end
		if not Toggle._InternalQuickPanel and XLQPGen1._QueueQuickToggleRefresh then
			XLQPGen1:_QueueQuickToggleRefresh()
		end
		if Silent~=true then
			Toggle._CallbackToken=(Toggle._CallbackToken or 0)+1
			local callbackToken=Toggle._CallbackToken
			local callbackValue=Toggle.Value
			task.defer(function()
				if not ToggleFrame.Parent or callbackToken~=Toggle._CallbackToken then return end
				task.wait()
				if not ToggleFrame.Parent or callbackToken~=Toggle._CallbackToken then return end
				SafeCallback(ToggleConfig.Callback,ToggleConfig.Name or "Toggle",callbackValue)
			end)
			task.defer(function()
				if ToggleFrame.Parent and callbackToken==Toggle._CallbackToken then Toggle:_EmitChanged(callbackValue) end
			end)
			task.defer(function() pcall(function() XLQPGen1:Haptic(0.34,0.024) end) end)
		end
	end

