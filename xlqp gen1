local function sharedAIFindText(value, depth)
	depth = depth or 0
	if depth > 10 then return nil end
	if type(value) == "string" then
		local text = sharedAIClean(value)
		return text ~= "" and text or nil
	end
	if type(value) ~= "table" then return nil end
	for _, key in ipairs({"response", "answer", "result", "output", "generated_text", "generated", "text", "content", "message", "completion", "data"}) do
		if value[key] ~= nil then
			local found = sharedAIFindText(value[key], depth + 1)
			if found then return found end
		end
	end
	local ignored = {
		tool_calls = true, tool_call = true, function_call = true, functions = true,
		arguments = true, images = true, image = true, image_url = true, url = true,
		sources = true, citations = true, usage = true, model = true, id = true,
		created = true, object = true
	}
	for key, child in pairs(value) do
		if not ignored[tostring(key):lower()] then
			local found = sharedAIFindText(child, depth + 1)
			if found then return found end
		end
	end
	return nil
end

local function sharedAIParseResponse(body)
	if not body or body == "" then return nil, "Empty response" end
	local data = sharedAIDecode(body)
	if not data then
