	end
	function Chat:TogglePopout()
		if not self.DockParent then
			self.DockParent=frame.Parent
			self.DockSize=frame.Size
			self.DockPosition=frame.Position
			self.ScreenParent=frame:FindFirstAncestorOfClass("ScreenGui") or frame.Parent
		end
