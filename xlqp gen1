function XLQPGen1.BytebeatTools:MakeFloatMelodyPreset()
	local A="1111100000011111111111111111111111111111111111111111111000001111111001111111110001000000000000001111110000000000000000000111111111111001111110000000000000000000000000000000000"
	local M={5,5,5,8,8,8,10,10,10,10,12,13,13,13,12,12,7,7,7,10,10,nil,8,8,8,8,17,12,12,12,8,8,7,7,7,13,13,13,17,17,17,17,13,13,12,12,13,13,0,0,0,10,10,10,8,8,8,8,5,5,0,0,5,5,5,5,5,8,8,8,10,10,10,10,12,13,13,13,12,12,7,7,7,10,10,nil,8,8,8,8,17,12,12,12,8,8,7,7,7,20,20,20,17,17,17,17,13,13,12,12,13,13,10,10,10,22,22,22,20,20,20,20,17,17,13,12,10,12}
	return function(t,s)
		s=s or {}
		if t==0 or not s.floatMelodyReady then
			s.a,s.b,s.d,s.e=0,0,0,0
			s.floatMelodyReady=true
		end
		local ti=math.floor(t)
		local idx=bit32 and bit32.band(bit32.rshift(ti,10),3) or math.floor(t/1024)%4
		local wobble=({9.8,9.5,9.3,9.1})[idx+1]
		local n=1.23
		local m=M[(bit32 and bit32.band(bit32.rshift(ti,12),127) or math.floor(t/4096)%128)+1] or wobble
		s.b=s.b+(n*(2^(m/12))-s.b)/800
		s.a=s.a+s.b
		local c=s.a
		local t13=bit32 and bit32.band(bit32.rshift(ti,13),1) or math.floor(t/8192)%2
		local t14=bit32 and bit32.band(bit32.rshift(ti,14),3) or math.floor(t/16384)%4
		local pidx=bit32 and bit32.band(bit32.rshift(ti,16),7) or math.floor(t/65536)%8
		local seqS=t14==3 and (t13==0 and 3 or 4) or 3
		local p=({1,seqS,5,t14==3 and (t13==0 and -2 or 0) or 0,1,seqS,5,t14==3 and (t13==0 and 10 or 12) or 8})[pidx+1] or 0
		s.e=s.e+(n*(2^(p/12))-s.e)/400
		s.d=s.d+s.e
		local g=s.d
		local function achar(x)
			return (A:byte((math.floor(x)%#A)+1) or 48)-48
		end
		local digits="00055522227744440005552222774422"
		local digit=(digits:byte(((bit32 and bit32.band(bit32.rshift(ti,12),31) or math.floor(t/4096)%32)%#digits)+1) or 48)-48
		local gate=(bit32 and bit32.band(bit32.rshift(bit32.band(-ti-digit*4096,4294967295),7),255) or math.floor((-ti-digit*4096)/128)%256)/200
		local vib=(bit32 and bit32.band(bit32.rshift(bit32.band(-ti,4294967295),13),1) or math.floor(-ti/8192)%2)*0.25
		local sample=(achar((c*175)/256)/1.3+(achar((g*175)/256)/2+(achar(((g/2)*175)/256)/3-1)))*gate+math.sin(t*n*math.pi/512)*vib
		sample=sample/(1+math.abs(sample)*0.45)
		return math.clamp(sample*0.915,-1,1)
	end
end
function XLQPGen1.BytebeatTools:Preset(src)
	local compact=tostring(src or ""):gsub("%s+","")
	if compact:find("111110000001111111",1,true) and compact:find("00055522227744440005552222774422",1,true) then return self:MakeFloatMelodyPreset() end
	if compact:find("this%.a%?%?=",1,false) or compact:find("parseInt%('25259474'",1,false) or compact:find('parseInt%("25259474"',1,false) or compact:find("xlqpphonk",1,true) or compact:find("functionsong",1,true) then return self:MakeXLQP() end
	if compact:find("r=repeat=",1,true) or compact:find("lim=limiter",1,true) or compact:find("Master=pan",1,true) then return self:MakeReverbPreset() end
	return nil
end
function XLQPGen1.BytebeatTools:Compile(src,mode)
	if not loadstring then return nil,"loadstring missing" end
	src=self:Clean(src)
	if tostring(src):gsub("%s+","")=="" then return nil,"empty code" end
	local preset=self:Preset(src)
	if preset then return preset end
	local env={math=math,bit32=bit32,tonumber=tonumber,tostring=tostring,string=string,table=table,pairs=pairs,ipairs=ipairs,select=select,print=print}
	env.sin,env.cos,env.tan,env.abs,env.min,env.max,env.floor,env.ceil,env.sqrt,env.log,env.exp=math.sin,math.cos,math.tan,math.abs,math.min,math.max,math.floor,math.ceil,math.sqrt,math.log,math.exp
	env.BB=function(a,b) return bit32 and bit32.band(math.floor(tonumber(a) or 0),math.floor(tonumber(b) or 0)) or 0 end
	env.BO=function(a,b) return bit32 and bit32.bor(math.floor(tonumber(a) or 0),math.floor(tonumber(b) or 0)) or 0 end
	env.BX=function(a,b) return bit32 and bit32.bxor(math.floor(tonumber(a) or 0),math.floor(tonumber(b) or 0)) or 0 end
	env.BR=function(a,b) return bit32 and bit32.rshift(math.floor(tonumber(a) or 0),math.floor(tonumber(b) or 0)) or math.floor((tonumber(a) or 0)/(2^(tonumber(b) or 0))) end
	env.BL=function(a,b) return bit32 and bit32.lshift(math.floor(tonumber(a) or 0),math.floor(tonumber(b) or 0)) or math.floor((tonumber(a) or 0)*(2^(tonumber(b) or 0))) end
	env.BN=function(a) return bit32 and bit32.bnot(math.floor(tonumber(a) or 0)) or -(math.floor(tonumber(a) or 0))-1 end
	env.BA=function(a,b) return (tonumber(a) or 0)~=0 and b or 0 end
	env.BOR=function(a,b) return (tonumber(a) or 0)~=0 and a or b end
	local body,chunk,err
	if mode=="Lua" then
		body=src:find("return",1,true) and src or "return "..src
	else
		local ok,res=pcall(function() return self:Program(src) end)
		if not ok then return nil,tostring(res) end
		body=res
	end
	chunk,err=loadstring("return function(t,s) s=s or {}; "..body.." end")
	if not chunk then return nil,err end
	pcall(function() setfenv(chunk,env) end)
	local ok,fn=pcall(chunk)
	if ok and type(fn)=="function" then return fn end
	return nil,tostring(fn)
end

