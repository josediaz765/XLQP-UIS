function XLQPGen1.BytebeatTools:Clean(src)
	src=tostring(src or ""):gsub("\r\n","\n"):gsub("Math%.",""):gsub("math%.","")
	src=src:gsub("//[^\n]*",""):gsub("/%*.-%*/","")
	return src
end
function XLQPGen1.BytebeatTools:Tokenize(src)
	src=self:Clean(src)
	local out,i={},1
	while i<=#src do
		local c=src:sub(i,i)
		if c:match("%s") then
			i=i+1
		elseif c=="\"" or c=="'" then
			local q,j,raw=c,i+1,c
			while j<=#src do
				local d=src:sub(j,j)
				raw=raw..d
				if d=="\\" then
					j=j+1
					if j<=#src then raw=raw..src:sub(j,j) end
				elseif d==q then
					break
				end
				j=j+1
			end
			out[#out+1]={"str",raw}
			i=j+1
		elseif c:match("%d") or (c=="." and src:sub(i+1,i+1):match("%d")) then
			local j=i
			if src:sub(i,i+1):lower()=="0x" then
				j=i+2
				while j<=#src and src:sub(j,j):match("[%da-fA-F]") do j=j+1 end
			else
				while j<=#src and src:sub(j,j):match("[%d%.]") do j=j+1 end
				if src:sub(j,j):lower()=="e" then
					j=j+1
					if src:sub(j,j)=="+" or src:sub(j,j)=="-" then j=j+1 end
					while j<=#src and src:sub(j,j):match("%d") do j=j+1 end
				end
			end
			out[#out+1]={"num",src:sub(i,j-1)}
			i=j
		elseif c:match("[%a_]") then
			local j=i+1
			while j<=#src and src:sub(j,j):match("[%w_]") do j=j+1 end
			out[#out+1]={"id",src:sub(i,j-1)}
			i=j
		else
			local three,two=src:sub(i,i+2),src:sub(i,i+1)
			local op=(three==">>>" or three=="===" or three=="!==") and three or ((two=="&&" or two=="||" or two=="<<" or two==">>" or two=="==" or two=="!=" or two=="<=" or two==">=" or two=="**") and two or c)
			out[#out+1]={"op",op}
			i=i+#op
		end
	end
