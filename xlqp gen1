function XLQPGen1KeyMatches(input,settings)
settings=settings or {}
input=tostring(input or "")
keyRawList=settings.CorrectKey or settings.KeySettingsKey or settings.Keys or settings.Key or {}
if type(keyRawList)~="table" then keyRawList={keyRawList} end
XLQPGen1KeyCrypt.inputSigned=XLQPGen1KeyCrypt.sign(input)
XLQPGen1KeyCrypt.inputHash=XLQPGen1KeyCrypt.hash("_SIGNED"..input)
for _,keyValue in ipairs(keyRawList) do
if XLQPGen1KeyCrypt.inputSigned==XLQPGen1KeyCrypt.sign(keyValue) then return true end
end
keyHashList=settings.KeyHashes or settings.HashedKeys or settings.KeyHash or {}
if type(keyHashList)~="table" then keyHashList={keyHashList} end
if #keyRawList>0 and settings.AllowKeyHashesWithRaw~=true then keyHashList={} end
for _,keyHashValue in ipairs(keyHashList) do
if XLQPGen1KeyCrypt.inputSigned==tostring(keyHashValue or "") or XLQPGen1KeyCrypt.inputHash==tostring(keyHashValue or "") then return true end
end
return false
end

