		rebuildOwnerMap()
		table.clear(indexRecords)
		local seen=setmetatable({},{__mode="k"})
		for _,element in ipairs(elements) do
			local wrapper=element and element.Wrapper
			if wrapper and wrapper.Parent and not seen[wrapper] then
				seen[wrapper]=true
				local owner,tabName=ownerForWrapper(wrapper)
				local parts=elementText(element,wrapper)
				local typeName=cleanName(element.Type,wrapper.Name or "Element")
				local name=cleanName(element.Name or element.Title,parts[1] or typeName)
				local category=XLQPSearchMenuCategory(typeName,name)
				indexRecords[#indexRecords+1]={name=name,type=typeName,category=category,target=element,wrapper=wrapper,owner=owner,tabName=tabName,path=tabName,search=(table.concat(parts," ").." "..typeName.." "..category.." "..tabName):lower()}
			end
		end
		table.sort(indexRecords,function(a,b)
			if a.tabName~=b.tabName then return tostring(a.tabName):lower()<tostring(b.tabName):lower() end
			return tostring(a.name):lower()<tostring(b.name):lower()
		end)
