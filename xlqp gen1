			local canvas=AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame",Color3.fromRGB(0,0,0),0,10),{Name="Canvas",Size=UDim2.new(1,-24,0,GridConfig.Height),Position=UDim2.new(0,12,0,96),BackgroundTransparency=0.18,ClipsDescendants=true,Parent=frame}),{MakeElement("Corner",0,10),AddThemeObject(MakeElement("Stroke"),"Stroke")}),"Main")
			local gridHost=SetProps(MakeElement("TFrame"),{Name="GridHost",Size=UDim2.fromScale(1,1),Parent=canvas,Visible=Grid.Boxes,ZIndex=10,ClipsDescendants=true})
