	function XLQPGen1:RefreshEditableElements()
		self.MoveableElements = self.MoveableElements or {}
		self.EditableContainers = self.EditableContainers or {}
		self._EditableRefreshToken = (self._EditableRefreshToken or 0) + 1
		local token = self._EditableRefreshToken
		local editable = self.EditableMode == true
		local pins = self.PinHandlesVisible == true
		local elements = {}
		for index = #self.MoveableElements, 1, -1 do
			local frame = self.MoveableElements[index]
			if not (frame and frame.Parent) then
				table.remove(self.MoveableElements, index)
			else
				table.insert(elements, frame)
			end
		end
		if not editable then
			self:_ClearEditableSelection()
		end
		task.spawn(function()
			for index, frame in ipairs(elements) do
				if token ~= self._EditableRefreshToken then return end
				if frame and frame.Parent then
					self:RegisterEditableContainer(self:GetMoveableContainer(frame.Parent))
					local overlay = frame:FindFirstChild("MoveableEditOverlay")
					local oldHandle = frame:FindFirstChild("MoveableHandle")
					local oldPin = frame:FindFirstChild("MoveablePin")
					self:_FixInlineEditableHandles(frame)
					local enabled=editable and (frame:GetAttribute("__XLQPGen1MoveableConfig")==true or WindowConfig.EditableAllElements==true)
					if oldHandle then oldHandle.Visible = enabled end
					if oldPin then oldPin.Visible = enabled and (pins or frame:GetAttribute("__XLQPGen1Pinned") == true) end
					if overlay then
						overlay.Visible = false
						overlay.Active = false
					end
				end
				if index % 20 == 0 then task.wait() end
			end
			if token == self._EditableRefreshToken and editable and self._EditableSelectedFrame and self._EditableSelectedFrame.Parent then
				self:_SetEditableSelection(self._EditableSelectedFrame)
			end
			if token == self._EditableRefreshToken then self:_SyncEditablePinManager() end
		end)
	end

	function XLQPGen1:SetEditableMode(Value)
		self.EditableMode = Value == true
		if not self.EditableMode then
			self:_ClearEditableSelection()
		end
		self:RefreshEditableElements()
	end

