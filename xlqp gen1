local function XLQPParseLiveColor(value)
	if typeof(value)=="Color3" then return value end
	if type(value)=="string" then
		local hex=value:gsub("#",""):gsub("%s+","")
		if #hex==6 then
			local r=tonumber(hex:sub(1,2),16)
			local g=tonumber(hex:sub(3,4),16)
			local b=tonumber(hex:sub(5,6),16)
			if r and g and b then return Color3.fromRGB(r,g,b) end
		end
	elseif type(value)=="table" then
		local r=tonumber(value.R or value.r or value[1])
		local g=tonumber(value.G or value.g or value[2])
		local b=tonumber(value.B or value.b or value[3])
		if r and g and b then
			if math.max(r,g,b)<=1 then return Color3.new(math.clamp(r,0,1),math.clamp(g,0,1),math.clamp(b,0,1)) end
			return Color3.fromRGB(math.clamp(r,0,255),math.clamp(g,0,255),math.clamp(b,0,255))
		end
	end
	return nil
end

