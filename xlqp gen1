	self._GlowSchedulerConnection=AddConnection(RunService.RenderStepped,function(deltaTime)
		if self._ReduceLagEnabled then return end
		local glowFrames=self._GlowFrames
		if not glowFrames or #glowFrames==0 then return end
		local now=os.clock()
		local moving=(tonumber(self._WindowDragActiveUntil) or 0)>now or (tonumber(self._WindowMotionPausedUntil) or 0)>now
		if moving then accumulator=0 return end
		accumulator+=deltaTime
		if accumulator<1/15 then return end
		accumulator=0
		for index=#glowFrames,1,-1 do
			local entry=glowFrames[index]
			if not (entry and entry.Holder and entry.Holder.Parent and entry.Target and entry.Target.Parent) then
				table.remove(glowFrames,index)
			elseif type(entry.Sync)=="function" then
				entry.Sync()
			end
		end
	end)
end
