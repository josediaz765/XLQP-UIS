				XLQPRegisterSecureBuiltin(robloxAsset)
				XLQPAssignProperty(imageLabel,"Image",robloxAsset)
				return
			end
			imageLabel:SetAttribute("ScriptBloxImageURL",url)
			if HubConfig._ImageAssetCache[url] then XLQPAssignProperty(imageLabel,"Image",HubConfig._ImageAssetCache[url]) return end
			task.spawn(function()
				if not prepareImageCache() then pcall(XLQPAssignProperty,imageLabel,"Image",url) return end
				local extension=url:lower():match("%.([%a%d]+)[%?%#]?")
				if extension~="jpg" and extension~="jpeg" and extension~="png" and extension~="webp" then extension="png" end
				local filePath=imageCacheFolder.."/"..stableImageKey(url).."."..extension
				local ok=pcall(function()
					local cachedValid=isfile(filePath)
					if cachedValid and readfile then
						local readOk,cachedBytes=pcall(readfile,filePath)
						cachedValid=readOk and XLQPIsImageBody(cachedBytes)
					end
					if not cachedValid then
						local bytes
