		if #rows>0 then return uniqueRows(rows) end
		return uniqueRows(type(rows.data)=="table" and rows.data or type(rows.messages)=="table" and rows.messages or type(rows.rows)=="table" and rows.rows or type(rows.results)=="table" and rows.results or {})
	end
	function Chat:NormalizeDMRows(rows)
		local out={}
		for _,msg in ipairs(self:ListRows(rows)) do out[#out+1]=self:NormalizeDMRow(msg) end
