		local function buildFilterQuery(includeStrict)
			local parts={}
			local function add(name,value)
				if value==nil or tostring(value)=="" then return end
				if type(value)=="boolean" then value=value and "1" or "0" end
				parts[#parts+1]=name.."="..HttpService:UrlEncode(tostring(value))
			end
			add("mode",filterState.mode)
			add("patched",filterState.patched)
			add("key",filterState.key)
			add("universal",filterState.universal)
			add("verified",filterState.verified)
			add("sortBy",filterState.sortBy)
			add("order",filterState.order)
			add("owner",filterState.owner)
			add("placeId",filterState.placeId)
			if includeStrict then add("strict",filterState.strict and "true" or "false") end
			return #parts>0 and ("&"..table.concat(parts,"&")) or ""
		end

