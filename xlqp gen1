function XLQPGen1:_InstallPrivateTabs(window,config)
	if not window or window._XLQPPrivateTabsInstalled then return window end
	local option=config and (config.PrivateTabs~=nil and config.PrivateTabs or config.privateTabs)
	local privateConfig=type(option)=="table" and option or {Enabled=option==true}
