local function setLiquidGlassEnabled(state, silent)
	if state==true and XLQPGen1._ReduceLagEnabled then
		XLQPGen1:_ReleaseReduceLagFor("Liquid Glass")
	end
	if XLQPGen1._ReduceLagEnabled then state=false end
	liquidGlassEnabled=state==true
	WindowConfig.LiquidGlass=liquidGlassEnabled
	if liquidGlassEnabled then
		liquidGlassRefraction:Attach(MainWindow)
		liquidGlassRefraction:Attach(SettingsWindow)
		liquidGlassRefraction:SetEnabled(true)
		if applyLiquidGlass then applyLiquidGlass(true) end
		liquidGlassShine:Sync()
		liquidGlassShine:SetVisible(true)
	else
		liquidGlassRefraction:SetEnabled(false)
		liquidGlassShine:SetVisible(false)
		setLiquidGlassCameraEffects(false)
		clearLiquidGlassStyles(MainWindow)
		clearLiquidGlassStyles(SettingsWindow)
		pcall(SetTheme)
		task.defer(function()
			if applyNewUIStyle then applyNewUIStyle() end
			if refreshNewUICornersFast then refreshNewUICornersFast() end
			if applyNewUITransparency then applyNewUITransparency() end
			if XLQPGen1._FixTopBarLayering then XLQPGen1:_FixTopBarLayering() end
		end)
	end
	refreshLiquidGlassToggles()
	if not silent then
		pcall(function()
			local content="Disabled"
			if liquidGlassEnabled then
				if liquidGlassRefraction.Enabled then
					content="Enabled with real glass refraction"
				elseif liquidGlassRefraction:QualityLevel()<7 then
					content="Enabled, but refraction needs Roblox graphics quality 7+"
				else
					content="Enabled without refraction on this device"
				end
			end
			XLQPGen1:MakeNotification({Name="Liquid Glass",Content=content,Time=4})
		end)
	end
	if XLQPGen1._LiquidGlassTabToggle and type(XLQPGen1._LiquidGlassTabToggle.Set)=="function" and XLQPGen1._LiquidGlassSyncing~=true then
		XLQPGen1._LiquidGlassSyncing=true
		pcall(function()
			if XLQPGen1._LiquidGlassTabToggle.Value~=liquidGlassEnabled then
				XLQPGen1._LiquidGlassTabToggle:Set(liquidGlassEnabled)
			end
		end)
