		 function discordImageAsset(url, key)
			url = tostring(url or "")
			if url == "" then return "" end
			if not (writefile and getcustomasset) then return url end
			local folder = XLQPGen1.Folder .. "/discord_assets"
			if makefolder and (not isfolder or not isfolder(folder)) then
				pcall(makefolder, folder)
			end
			local safe = tostring(key or "guild"):gsub("[^%w_%-]", "_")
			local path = folder .. "/" .. safe .. ".png"
			if isfile and isfile(path) then
				local ok, asset = pcall(getcustomasset, path)
				if ok and asset then return asset end
			end
			local body
			local req = getRequestFunction()
			if req then
				pcall(function()
					local response = req({Url = url, Method = "GET"})
					body = response and (response.Body or response.body)
				end)
			end
			if body then
				local wrote = pcall(writefile, path, body)
				if wrote then
					local ok, asset = pcall(getcustomasset, path)
					if ok and asset then return asset end
				end
			end
			return url
		end

