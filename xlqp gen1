	function Chat:CallAPI(names,...)
		if type(self.API)~="table" then return false,nil end
		names=type(names)=="table" and names or {names}
		for _,method in ipairs(names) do
			local fn=self.API[method]
			if type(fn)=="function" then
				local ok,result=pcall(fn,self.API,...)
				if ok then return true,result,method end
				ok,result=pcall(fn,...)
				if ok then return true,result,method end
			end
		end
		return false,nil
	end
	function Chat:FetchAPIRows(methods,...)
		local ok,rows=self:CallAPI(methods,...)
		if ok and type(rows)=="table" then return rows end
		task.wait(0.08)
		ok,rows=self:CallAPI(methods,...)
		if ok and type(rows)=="table" then return rows end
		return nil
	end
	function Chat:NormalizeDMRow(msg)
		msg=type(msg)=="table" and msg or {}
		local sender=tonumber(msg.sender_id or msg.senderId or msg.from_id or msg.fromId or msg.user_id or msg.userId or msg.author_id or msg.authorId) or 0
		local receiver=tonumber(msg.receiver_id or msg.receiverId or msg.to_id or msg.toId or msg.target_id or msg.targetId) or 0
		if sender==0 then
			if tonumber(msg.sender)==player.UserId or tostring(msg.sender or "")==player.Name then sender=player.UserId end
			if sender==0 and receiver==player.UserId then sender=self.Target or 0 end
		end
		return {
			id=msg.id or msg.message_id or msg.messageId or msg.created_at or msg.createdAt or msg.time or msg.content,
			content=msg.content or msg.message or msg.text or msg.body or "",
			timestamp=msg.timestamp or msg.created_at or msg.createdAt or msg.time or msg.sent_at or msg.sentAt,
			sender_id=sender,
