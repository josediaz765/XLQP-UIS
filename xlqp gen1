	local function applyMediaPreset()
		if not currentMediaInstance or not currentMediaInstance:IsA("Sound") then return end
		if not MediaCtl.Support.Effects then
			XLQPGen1:MakeNotification({Name="Media Player",Content="Audio effects are not supported by this Roblox environment.",Time=3})
			return
		end
		pcall(function()
			for _,child in ipairs(currentMediaInstance:GetChildren()) do
				if child.Name=="XLQPGen1MediaEffect" then child:Destroy() end
			end
			currentMediaInstance.Volume = currentVolume
			currentMediaInstance.PlaybackSpeed = currentPreset=="Slowed" and math.min(currentPitch,0.75) or currentPitch
			if currentPreset=="Echo" then
				MediaCtl.Effect=Create("EchoSoundEffect",{Name="XLQPGen1MediaEffect",Delay=0.18,Feedback=0.32,WetLevel=-5,DryLevel=0,Parent=currentMediaInstance})
			elseif currentPreset=="Underwater" then
