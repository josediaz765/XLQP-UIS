local function XLQPAdaptiveViewport()
 local camera=workspace.CurrentCamera
 local viewport=camera and camera.ViewportSize or Vector2.new(800,600)
 return Vector2.new(math.max(1,viewport.X),math.max(1,viewport.Y))
end
function XLQPAdaptivePixels(gui,fallbackWidth,fallbackHeight,viewport)
 local size=gui and gui.Size
 local width=size and size.X.Scale*viewport.X+size.X.Offset or 0
 local height=size and size.Y.Scale*viewport.Y+size.Y.Offset or 0
 if width<=0 then width=tonumber(fallbackWidth) or 615 end
 if height<=0 then height=tonumber(fallbackHeight) or 380 end
 return math.max(1,width),math.max(1,height)
end
function XLQPAdaptiveApply(self,gui,entry,viewport)
 if not gui or not gui.Parent or not entry or gui:GetAttribute("XLQPAdaptiveIgnore")==true then return end
 if gui==self._MainWindow and (Minimized==true or self._MainWindowMinimized==true) then return end
 if gui==self._SettingsWindow and settingsMinimized==true then return end
 local config=self._AdaptiveConfig or {}
 local margin=math.clamp(tonumber(config.AdaptiveSizingMargin) or 12,6,32)
 local maxWidth=math.max(1,viewport.X-margin*2)
 local maxHeight=math.max(1,viewport.Y-margin*2)
 local minWidth=math.min(math.max(1,entry.MinWidth),maxWidth)
 local minHeight=math.min(math.max(1,entry.MinHeight),maxHeight)
 local width=math.clamp(entry.PreferredWidth,minWidth,maxWidth)
 local height=math.clamp(entry.PreferredHeight,minHeight,maxHeight)
 entry.Applying=true
 if entry.Constraint then entry.Constraint.MinSize=Vector2.new(minWidth,minHeight) entry.Constraint.MaxSize=Vector2.new(maxWidth,maxHeight) end
 for _,child in ipairs(gui:GetChildren()) do
  if child:IsA("UISizeConstraint") and child~=entry.Constraint and child.Name=="VerbalResponsiveMin" then child.MinSize=Vector2.new(minWidth,minHeight) child.MaxSize=Vector2.new(maxWidth,maxHeight) end
 end
 if math.abs(gui.AbsoluteSize.X-width)>1 or math.abs(gui.AbsoluteSize.Y-height)>1 then gui.Size=UDim2.fromOffset(width,height) end
 local anchor=gui.AnchorPoint
 local left=gui.AbsolutePosition.X
 local top=gui.AbsolutePosition.Y
 left=math.clamp(left,margin,math.max(margin,viewport.X-margin-width))
 top=math.clamp(top,margin,math.max(margin,viewport.Y-margin-height))
 gui.Position=UDim2.fromOffset(left+anchor.X*width,top+anchor.Y*height)
 entry.Applying=false
end
function XLQPGen1:RefreshAdaptiveWindows(force)
 if self._AdaptiveConfig and self._AdaptiveConfig.AdaptiveSizing==false then return self end
 local viewport=XLQPAdaptiveViewport()
 if not force and self._AdaptiveViewport==viewport then return self end
 self._AdaptiveViewport=viewport
 for gui,entry in pairs(self._AdaptiveWindows or {}) do XLQPAdaptiveApply(self,gui,entry,viewport) end
 return self
end
function XLQPGen1:RegisterAdaptiveWindow(gui,preferredWidth,preferredHeight,minWidth,minHeight)
 if typeof(gui)~="Instance" or not gui:IsA("GuiObject") then return gui end
 self._AdaptiveWindows=self._AdaptiveWindows or setmetatable({},{__mode="k"})
 self._AdaptiveConfig=self._AdaptiveConfig or {}
 local entry=self._AdaptiveWindows[gui]
 if not entry then
  local viewport=XLQPAdaptiveViewport()
  local width,height=XLQPAdaptivePixels(gui,preferredWidth,preferredHeight,viewport)
  entry={PreferredWidth=width,PreferredHeight=height,MinWidth=tonumber(minWidth) or 280,MinHeight=tonumber(minHeight) or 210,Applying=false}
  self._AdaptiveWindows[gui]=entry
  gui:SetAttribute("XLQPAdaptiveSizing",true)
  local constraint=gui:FindFirstChild("XLQPAdaptiveConstraint")
  if not constraint then constraint=Instance.new("UISizeConstraint") constraint.Name="XLQPAdaptiveConstraint" constraint.Parent=gui end
  entry.Constraint=constraint
	  AddConnection(gui:GetPropertyChangedSignal("AbsoluteSize"),function()
	   if not entry.Applying and gui.Parent and not (gui==self._MainWindow and (self._MainWindowMinimized==true or self._MinimizeSizeTweenActive==true or self._LayoutSuspended==true)) and not (gui==self._SettingsWindow and settingsMinimized==true) then
	    local current=gui.AbsoluteSize
	    if current.X>0 and current.Y>0 then entry.PreferredWidth=current.X entry.PreferredHeight=current.Y end
	   end
  end)
 end
 self:RefreshAdaptiveWindows(true)
 if not self._AdaptiveCameraBound then
  self._AdaptiveCameraBound=true
  local function queue() if self._AdaptivePending then return end self._AdaptivePending=true task.defer(function() self._AdaptivePending=false self:RefreshAdaptiveWindows(false) end) end
  if workspace.CurrentCamera then AddConnection(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"),queue) end
  AddConnection(workspace:GetPropertyChangedSignal("CurrentCamera"),function() if workspace.CurrentCamera then AddConnection(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"),queue) end queue() end)
 end
 return gui
end

