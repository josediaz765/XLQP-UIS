function applyShinyMode(enabled)
    if XLQPGen1._ReduceLagEnabled then enabled=false end
    WindowConfig.Shiny = enabled and true or false

    if not enabled then
        for _,root in ipairs({MainWindow, SettingsWindow}) do
            if root and root.Parent then
                for _,g in ipairs(root:GetDescendants()) do
                    if g:IsA("UIGradient") and g.Name == "Shine" then
                        g.Enabled = false
                    end
                end
            end
        end
        for i = #gradientsToAnimate, 1, -1 do
            local gradient = gradientsToAnimate[i]
            if gradient and gradient.Name == "Shine" then
                table.remove(gradientsToAnimate, i)
            end
        end
    else
        for _,root in ipairs({MainWindow, SettingsWindow}) do
            if root and root.Parent then
                for _,g in ipairs(root:GetDescendants()) do
                    if g:IsA("UIGradient") and g.Name == "Shine" and g.Enabled and not table.find(gradientsToAnimate, g) then
                        table.insert(gradientsToAnimate, g)
                    end
                end
            end
        end
    end
end

