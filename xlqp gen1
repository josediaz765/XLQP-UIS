	XLQPGen1.PVP_API_URL="https://raw.githubusercontent.com/josediaz765/Hi/refs/heads/main/api_wrapper.lua"
	XLQPGen1.PVP=XLQPGen1.PVP or {Enabled=false,LastReason="PvP off",Users={},Notified=false,Labels={}}
	XLQPGen1.PVP.Enabled=XLQPGen1.PVP.Enabled==true
	XLQPGen1.PVP.APIUnlocked=XLQPGen1.PVP.APIUnlocked==true
	XLQPGen1.PVP.PanelAdded=XLQPGen1.PVP.PanelAdded==true
	XLQPGen1.PVP.BlockNoticeShown=XLQPGen1.PVP.BlockNoticeShown==true
	function XLQPGen1:_PVPRequest()
		return XLQPResolveRequest()
	end
	function XLQPGen1:_PVPFetch(url)
		pvpBody=""
		pcall(function()
			pvpBody=game:HttpGet(tostring(url or "").."?cb="..tostring(os.time())..tostring(math.random(10000,99999)),true)
		end)
		if type(pvpBody)=="string" and pvpBody~="" then return pvpBody end
		pvpReq=self:_PVPRequest()
		if pvpReq then
			pcall(function()
				pvpRes=pvpReq({Url=tostring(url or ""),Method="GET",Headers={["User-Agent"]="Mozilla/5.0",["Cache-Control"]="no-cache"}})
				pvpBody=pvpRes and (pvpRes.Body or pvpRes.body or pvpRes.Response or pvpRes.response) or ""
			end)
		end
		return pvpBody
	end
	function XLQPGen1:_PVPExported()
		pvpApi=nil
		pcall(function() pvpApi=_G.VerbalChatAPI end)
		if type(pvpApi)~="table" then pcall(function() pvpApi=shared.VerbalChatAPI end) end
		if type(pvpApi)~="table" and getgenv then pcall(function() pvpApi=getgenv().VerbalChatAPI end) end
		return pvpApi
	end
	function XLQPGen1:GetPVPAPI(force)
		if type(self._PVPAPI)=="table" then return self._PVPAPI end
		pvpApi=self:_PVPExported()
		if type(pvpApi)=="table" then self._PVPAPI=pvpApi return pvpApi end
		if force~=true and not (self.PVP and self.PVP.APIUnlocked==true and self.PVP.PanelAdded==true and self.PVP.Enabled==true) then
			return nil
		end
		pvpSource=self:_PVPFetch(self.PVP_API_URL)
		pvpFn=type(pvpSource)=="string" and loadstring(pvpSource)
		if pvpFn then
			pvpOk,pvpResult=pcall(pvpFn)
			if pvpOk and type(pvpResult)=="table" then self._PVPAPI=pvpResult return pvpResult end
		end
		for _=1,40 do
			pvpApi=self:_PVPExported()
			if type(pvpApi)=="table" then self._PVPAPI=pvpApi return pvpApi end
			task.wait(0.05)
		end
	end
	function XLQPGen1:_PVPGameName()
		pvpName=tostring(game.PlaceId)
		pcall(function() pvpName=game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
		return pvpName
	end
	function XLQPGen1:_PVPSetLabel(label,text)
		if not label then return end
		if type(label)=="table" and not label.Set and not label.SetText and not label.Text then
			for _,pvpLabel in ipairs(label) do
				self:_PVPSetLabel(pvpLabel,text)
			end
			return
		end
		pcall(function() label:Set(tostring(text or "")) end)
		pcall(function() label:SetText(tostring(text or "")) end)
		pcall(function() label.Text=tostring(text or "") end)
	end
	function XLQPGen1:_PVPNotifyOnce(text)
		if self.PVP.Notified then return end
		self.PVP.Notified=true
		WindowConfig._LocalRegisterState.notifySettings("PVP Mode",text or "PVP mode updated.")
	end
	function XLQPGen1:_PVPRefreshLabels()
		pvpPlayer=game:GetService("Players").LocalPlayer
		pvpUser=pvpPlayer and ((pvpPlayer.DisplayName or pvpPlayer.Name).." (@"..pvpPlayer.Name..")") or "Unknown"
		pvpGame=self:_PVPGameName()
		self:_PVPSetLabel(self.PVP.Labels.Executor,"Executed by: "..pvpUser)
		self:_PVPSetLabel(self.PVP.Labels.Game,"Game: "..pvpGame.." | PlaceId: "..tostring(game.PlaceId))
		self:_PVPSetLabel(self.PVP.Labels.Status,(self.PVP.Enabled and "PvP: ON" or "PvP: OFF").." | "..tostring(self.PVP.LastReason or "Ready"))
		if self.PVP.Labels.Users then
			self:_PVPSetLabel(self.PVP.Labels.Users,self:_PVPFormatUsers(self.PVP.Users))
		end
	end
	function XLQPGen1:SetPVPMode(value)
		pvpPlayer=game:GetService("Players").LocalPlayer
		local enabling=value==true
		self.PVP.Enabled=enabling
		self.PVP.BlockNoticeShown=false
		if enabling then self.PVP.APIUnlocked=true end
		pvpApi=enabling and self:GetPVPAPI(true) or self._PVPAPI
		if type(pvpApi)=="table" and type(pvpApi.setPvpMode)=="function" and pvpPlayer then
			pvpOk,pvpRow,pvpErr=pcall(function()
				return pvpApi:setPvpMode(pvpPlayer.UserId,pvpPlayer.Name,pvpPlayer.DisplayName,self.PVP.Enabled,true)
			end)
			if not pvpOk then
				self.PVP.LastReason=tostring(pvpRow)
			elseif pvpRow==false then
				self.PVP.LastReason=tostring(pvpErr or "PVP update failed")
			elseif pvpErr then
				self.PVP.LastReason=tostring(pvpErr)
			else
				self.PVP.LastReason=self.PVP.Enabled and "PVP enabled" or "PVP disabled"
			end
		else
			self.PVP.LastReason=enabling and "PVP API unavailable" or "PVP disabled"
		end
		self:_PVPRefreshLabels()
		if enabling then self:_PVPNotifyOnce("Enabled for "..self:_PVPGameName()) end
		return self.PVP.Enabled
	end
	function XLQPGen1:MarkPVPExecuted()
		if not (self.PVP and self.PVP.Enabled==true and self.PVP.PanelAdded==true and self.PVP.APIUnlocked==true) then
			self.PVP.LastReason=self.PVP and self.PVP.Enabled and "PVP API not unlocked" or "PVP disabled"
			self:_PVPRefreshLabels()
			return false
		end
		pvpPlayer=game:GetService("Players").LocalPlayer
		pvpApi=self:GetPVPAPI()
		if type(pvpApi)=="table" and type(pvpApi.setPvpMode)=="function" and pvpPlayer then
			pvpOk,pvpRow,pvpErr=pcall(function()
				return pvpApi:setPvpMode(pvpPlayer.UserId,pvpPlayer.Name,pvpPlayer.DisplayName,self.PVP.Enabled==true,true)
			end)
			if not pvpOk then
				self.PVP.LastReason=tostring(pvpRow)
			elseif pvpRow==false then
				self.PVP.LastReason=tostring(pvpErr or "PVP update failed")
			else
				self.PVP.LastReason=self.PVP.Enabled and "PVP enabled" or "PVP disabled"
			end
		else
			self.PVP.LastReason="PVP API unavailable"
		end
		self:_PVPRefreshLabels()
		return self.PVP.Enabled==true
	end
	function XLQPGen1:_PVPRows(rows)
		if type(rows)~="table" then return {} end
		if type(rows.data)=="table" then rows=rows.data end
		if type(rows.rows)=="table" then rows=rows.rows end
		if type(rows.users)=="table" then rows=rows.users end
		if type(rows.results)=="table" then rows=rows.results end
		if #rows<1 then
			pvpList={}
			for _,pvpRow in pairs(rows) do
				if type(pvpRow)=="table" then pvpList[#pvpList+1]=pvpRow end
			end
			if #pvpList>0 then rows=pvpList end
		end
		return rows
	end
	function XLQPGen1:_PVPFormatUsers(rows)
		rows=self:_PVPRows(rows)
		if type(rows)~="table" or #rows<1 then return "No script users found." end
		pvpLines={}
		for pvpIndex,pvpRow in ipairs(rows) do
			if pvpIndex>8 then break end
			pvpName=tostring(pvpRow.display_name or pvpRow.username or pvpRow.name or "Unknown")
			pvpUser=tostring(pvpRow.username or pvpRow.name or pvpRow.user_id or "")
			pvpUpdated=tonumber(pvpRow.updated_at or pvpRow.updated or pvpRow.last_seen or 0) or 0
			pvpFresh=pvpUpdated>0 and os.time()-pvpUpdated<=45
			pvpState=(pvpRow.pvp_enabled==true or tonumber(pvpRow.pvp_enabled)==1) and "PVP ON" or "PVP OFF"
			pvpUsing=(pvpRow.using_script==true or tonumber(pvpRow.using_script)==1) and pvpFresh and "EXECUTED" or "STALE"
			pvpLines[#pvpLines+1]=pvpName.." @"..pvpUser.." | "..pvpState.." | "..pvpUsing
		end
		return table.concat(pvpLines,"\n")
	end
	function XLQPGen1:GetPVPScriptUsers(force)
		if not (self.PVP and self.PVP.Enabled==true and self.PVP.PanelAdded==true and self.PVP.APIUnlocked==true) then
			return self.PVP and self.PVP.Users or {}
		end
		if not force and self.PVP.LastFetch and os.clock()-self.PVP.LastFetch<8 then return self.PVP.Users end
		self.PVP.LastFetch=os.clock()
		pvpApi=self:GetPVPAPI()
		if type(pvpApi)=="table" and type(pvpApi.getPvpModes)=="function" then
			pvpOk,pvpRows=pcall(function() return pvpApi:getPvpModes(100) end)
			if pvpOk and type(pvpRows)=="table" then self.PVP.Users=self:_PVPRows(pvpRows) end
		end
		self:_PVPRefreshLabels()
		return self.PVP.Users
	end
	function XLQPGen1:_PVPBool(value)
		return value==true or value==1 or tostring(value):lower()=="true" or tostring(value)=="1"
	end
	function XLQPGen1:GetPVPRowForPlayer(player)
		if not player then return nil end
		pvpId=tostring(player.UserId)
		for _,pvpRow in ipairs(self:_PVPRows(self.PVP.Users)) do
			if tostring(pvpRow.user_id or pvpRow.userid or pvpRow.UserId or pvpRow.id or "")==pvpId or tostring(pvpRow.username or pvpRow.name or "")==player.Name then
				return pvpRow
			end
		end
	end
	function XLQPGen1:IsPlayerPVPReady(player)
		if not self.PVP.Enabled then self.PVP.LastReason="Your PvP mode is off" return false,"Your PvP mode is off" end
		if not player then self.PVP.LastReason="No target" return false,"No target" end
		if not self.PVP.LastFetch or os.clock()-self.PVP.LastFetch>8 then self:GetPVPScriptUsers(true) end
		pvpRow=self:GetPVPRowForPlayer(player)
		if not pvpRow then self.PVP.LastReason="Target has not executed" return false,"Target has not executed" end
		pvpUpdated=tonumber(pvpRow.updated_at or pvpRow.updated or pvpRow.last_seen or pvpRow.lastSeen or 0) or 0
		if pvpUpdated>0 and os.time()-pvpUpdated>45 then self.PVP.LastReason="Target PvP status is stale" return false,"Target PvP status is stale" end
		if not self:_PVPBool(pvpRow.using_script or pvpRow.usingScript or pvpRow.active) then self.PVP.LastReason="Target has script off" return false,"Target has script off" end
		if not self:_PVPBool(pvpRow.pvp_enabled or pvpRow.pvpEnabled or pvpRow.pvp) then self.PVP.LastReason="Target PvP is off" return false,"Target PvP is off" end
		self.PVP.LastReason="Allowed"
		return true,"Allowed",pvpRow
	end
	function XLQPGen1:PVPCanAffect(targetPlayer)
		pvpReady,pvpReason=self:IsPlayerPVPReady(targetPlayer)
		if not pvpReady then self.PVP.LastReason=tostring(pvpReason or "Blocked") return false end
		pvpPlayer=game:GetService("Players").LocalPlayer
		pvpApi=self:GetPVPAPI()
		if type(pvpApi)=="table" and type(pvpApi.isPvpAllowed)=="function" and pvpPlayer then
			pvpOk,pvpAllowed,pvpReason,pvpMode=pcall(function()
				return pvpApi:isPvpAllowed(pvpPlayer.UserId,targetPlayer.UserId,45)
			end)
			if pvpOk then
				self.PVP.LastReason=tostring(pvpReason or (pvpAllowed and "Allowed" or "Blocked"))
				self.PVP.TargetMode=pvpMode
				return pvpAllowed==true
