				if not player then return end
				local requestUrl="https://games.roblox.com/v1/games/"..tostring(game.PlaceId).."/servers/Public?sortOrder=Asc&limit=100"
				local ok,raw=pcall(function() return game:HttpGet(requestUrl) end)
				if not ok then return end
				local decodedOk,data=pcall(HttpService.JSONDecode,HttpService,raw)
				if not decodedOk or type(data)~="table" or type(data.data)~="table" then return end
				for _,server in ipairs(data.data) do
					if tostring(server.id or "")~="" and tostring(server.id)~=tostring(game.JobId) and tonumber(server.playing or 0)<tonumber(server.maxPlayers or 0) then
						pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId,tostring(server.id),player) end)
						break
					end
				end
			end)
		end)
	end
	local content=Create("ScrollingFrame",{
		Name="Content",
		Position=UDim2.new(0,0,0,headerHeight),
		Size=UDim2.new(1,0,1,-headerHeight),
		BackgroundTransparency=1,
		BorderSizePixel=0,
		Active=not gameInfoEnabled,
		Visible=not gameInfoEnabled,
		ScrollingEnabled=not gameInfoEnabled and widgetConfig.Scrollable~=false,
		ScrollingDirection=Enum.ScrollingDirection.Y,
		ElasticBehavior=Enum.ElasticBehavior.Never,
		ScrollBarThickness=widgetConfig.Scrollable==false and 0 or math.max(3,tonumber(widgetConfig.ScrollBarThickness) or 5),
		ScrollBarImageTransparency=0.18,
		VerticalScrollBarInset=Enum.ScrollBarInset.ScrollBar,
		CanvasSize=UDim2.new(),
		ClipsDescendants=true,
		ZIndex=card.ZIndex+1,
		Parent=card
	})
	content:SetAttribute("XLQPCapturesWheel",not gameInfoEnabled)
	if not gameInfoEnabled then pcall(function() addScrollSupport(content,false) end) end
	local dashboardScroll=self._WidgetDashboardCanvas
	local parentScrollWasEnabled
	local contentPointerInside=false
	local contentTouchActive=false
	local function contentCanScroll()
		return widgetConfig.Scrollable~=false and content.AbsoluteCanvasSize.Y>content.AbsoluteWindowSize.Y+2
	end
	local function lockDashboardScroll()
		if not contentCanScroll() then return end
		if dashboardScroll and dashboardScroll:IsA("ScrollingFrame") and parentScrollWasEnabled==nil then
			parentScrollWasEnabled=dashboardScroll.ScrollingEnabled
			dashboardScroll.ScrollingEnabled=false
		end
	end
	local function restoreDashboardScroll()
		if contentPointerInside or contentTouchActive then return end
		if dashboardScroll and dashboardScroll:IsA("ScrollingFrame") and parentScrollWasEnabled~=nil then
			dashboardScroll.ScrollingEnabled=parentScrollWasEnabled
		end
		parentScrollWasEnabled=nil
	end
	AddConnection(content.MouseEnter,function()
		contentPointerInside=true
		lockDashboardScroll()
	end)
	AddConnection(content.MouseLeave,function()
		contentPointerInside=false
		restoreDashboardScroll()
	end)
	AddConnection(content.InputBegan,function(input)
		if input.UserInputType==Enum.UserInputType.Touch then
			contentTouchActive=true
			lockDashboardScroll()
		end
	end)
	AddConnection(UserInputService.InputEnded,function(input)
		if input.UserInputType==Enum.UserInputType.Touch then
			contentTouchActive=false
			restoreDashboardScroll()
		end
	end)
	local group=factoryTab:AddLeftGroupbox({Name=name,Icon=widgetConfig.Icon})
	if not (group and group.Wrapper) then card:Destroy() return nil end
	local wrapper=group.Wrapper
	local body=wrapper:FindFirstChild("Body",true)
	if not body then card:Destroy() pcall(function() wrapper:Destroy() end) return nil end
	body.Parent=content
	body.Position=UDim2.new(0,10,0,6)
	body.Size=UDim2.new(1,-20,0,0)
	body.AutomaticSize=Enum.AutomaticSize.None
	body.Visible=true
	body.ZIndex=card.ZIndex+4
	local function raiseWidgetTree(root)
		if not root then return end
		if root:IsA("GuiObject") then root.ZIndex=math.max(root.ZIndex,card.ZIndex+4) end
		for _,guiObject in ipairs(root:GetDescendants()) do
			if guiObject:IsA("GuiObject") then
				guiObject.ZIndex=math.max(guiObject.ZIndex,card.ZIndex+4)
				if guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") or guiObject:IsA("TextBox") then
					guiObject.TextTransparency=math.min(guiObject.TextTransparency,0.12)
					guiObject:SetAttribute("NoLiquidGlassText",true)
				elseif guiObject:IsA("ImageLabel") or guiObject:IsA("ImageButton") then
					guiObject.ImageTransparency=math.min(guiObject.ImageTransparency,0.12)
					guiObject:SetAttribute("NoLiquidGlassIcon",true)
				end
			end
		end
	end
	pcall(function() wrapper:Destroy() end)
	raiseWidgetTree(body)
	local bodyLayout=body:FindFirstChildOfClass("UIListLayout")
	local function refreshCanvas()
		if XLQPGen1._StartupBuildActive and not XLQPGen1._StartupFinalizing then
			XLQPGen1:_QueueStartupFinalizer(refreshCanvas)
			return
		end
		if not (body.Parent and content.Parent) then return end
		local height=bodyLayout and bodyLayout.AbsoluteContentSize.Y or 0
		body.Size=UDim2.new(1,-24,0,math.max(0,height))
		content.CanvasSize=UDim2.new(0,0,0,math.max(0,height+12))
		local needsScroll=widgetConfig.Scrollable~=false and (height+12)>math.max(0,content.AbsoluteWindowSize.Y)
		content.ScrollingEnabled=needsScroll
		content.ScrollBarThickness=needsScroll and math.max(3,tonumber(widgetConfig.ScrollBarThickness) or 5) or 0
		if not needsScroll then
			content.CanvasPosition=Vector2.new(0,0)
			if parentScrollWasEnabled~=nil then
				contentPointerInside=false
				contentTouchActive=false
				restoreDashboardScroll()
			end
		end
	end
	if bodyLayout then AddConnection(bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"),refreshCanvas) end
	AddConnection(body.ChildAdded,function(child)
		if child:IsA("GuiObject") then
			AddConnection(child:GetPropertyChangedSignal("Size"),refreshCanvas)
			AddConnection(child:GetPropertyChangedSignal("Visible"),refreshCanvas)
		end
		task.defer(function()
			raiseWidgetTree(child)
			refreshCanvas()
		end)
	end)
	AddConnection(body.DescendantAdded,function(descendant)
		task.defer(function() raiseWidgetTree(descendant) end)
	end)
	task.defer(refreshCanvas)
	local widget={
		Name=name,
		Config=widgetConfig,
		Frame=card,
		Header=header,
		TitleLabel=title,
		GameCreatorLabel=gameCreatorLabel,
		Image=heroImage,
		Content=content,
		Body=body,
		Elements=group,
		Visible=card.Visible
	}
	setmetatable(widget,{__index=function(_,key)
		if gameInfoEnabled and tostring(key):match("^Add") then
			return function() return nil end
		end
		local value=group[key]
		if type(value)=="function" then
			return function(_,...)
				local result=value(group,...)
				task.defer(function() raiseWidgetTree(body) refreshCanvas() end)
				return result
			end
		end
		return value
	end})
	function widget:SetTitle(value)
		self.Name=tostring(value or self.Name)
		title.Text=self.Name
		return self
	end
	function widget:SetImage(value)
		widgetImage=value
		local asset=tostring(value or "")
		if heroImage then
			heroImage.Image=asset
			heroImage.ImageTransparency=0
			pcall(function() game:GetService("ContentProvider"):PreloadAsync({heroImage}) end)
		else
			heroImage=Create("ImageLabel",{Name="WidgetImage",Size=UDim2.fromOffset(imageSize,imageSize),AnchorPoint=Vector2.new(0,0.5),Position=UDim2.new(0,12,0.5,0),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.96,BorderSizePixel=0,Image=asset,ImageTransparency=0,ScaleType=widgetConfig.ImageScaleType or Enum.ScaleType.Crop,ZIndex=header.ZIndex+1,Parent=header})
			pcall(function() game:GetService("ContentProvider"):PreloadAsync({heroImage}) end)
			Create("UICorner",{CornerRadius=UDim.new(0,math.min(radius,14)),Parent=heroImage})
			heroImage:SetAttribute("NoLiquidGlassIcon",true)
			heroImage:SetAttribute("NoLiquidGlass",true)
			self.Image=heroImage
			title.Position=UDim2.new(0,20+imageSize,0,gameInfoEnabled and 12 or 0)
			title.Size=UDim2.new(1,-(32+imageSize),gameInfoEnabled and 0 or 1,gameInfoEnabled and 22 or 0)
			if gameCreatorLabel then
				gameCreatorLabel.Position=UDim2.new(0,20+imageSize,0,38)
				gameCreatorLabel.Size=UDim2.new(1,-(32+imageSize),0,18)
			end
		end
		return self
	end
	function widget:SetVisible(value)
		self.Visible=value==true
		card.Visible=self.Visible
		return self
	end
	function widget:Toggle(value)
		if value==nil then value=not card.Visible end
		return self:SetVisible(value)
	end
	function widget:SetPosition(value)
		if typeof(value)=="UDim2" then card.Position=value end
		return self
	end
	function widget:SetSize(value,height)
		if typeof(value)=="UDim2" then
			card.Size=value
		else
			card.Size=UDim2.fromOffset(math.max(120,tonumber(value) or card.AbsoluteSize.X),math.max(80,tonumber(height) or card.AbsoluteSize.Y))
		end
		task.defer(refreshCanvas)
		return self
	end
	function widget:SetCornerRadius(value)
		local corner=card:FindFirstChild("WidgetCorner")
		if corner then corner.CornerRadius=UDim.new(0,math.clamp(tonumber(value) or radius,0,32)) end
		return self
	end
	function widget:AddElement(methodName,elementConfig)
		if gameInfoEnabled then return nil end
		local method=group[tostring(methodName or "")]
		if type(method)~="function" then return nil end
		local result=method(group,elementConfig)
		task.defer(function() raiseWidgetTree(body) refreshCanvas() end)
		return result
	end
	function widget:Clear()
		for _,child in ipairs(body:GetChildren()) do
			if child:IsA("GuiObject") then pcall(function() child:Destroy() end) end
		end
		task.defer(refreshCanvas)
		return self
	end
	function widget:Destroy()
		self._Destroyed=true
		if XLQPGen1._Widgets then XLQPGen1._Widgets[name]=nil end
		for index,item in ipairs(XLQPGen1._WidgetOrder or {}) do
			if item==self then table.remove(XLQPGen1._WidgetOrder,index) break end
		end
		pcall(function() card:Destroy() end)
	end
	if widgetConfig.Moveable==true and headerHeight>0 then
		local dragging=false
		local dragInput
		local startMouse
		local startPosition
		AddConnection(header.InputBegan,function(input)
			if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
			dragging=true
			dragInput=input
			startMouse=Vector2.new(input.Position.X,input.Position.Y)
			startPosition=card.Position
		end)
		AddConnection(UserInputService.InputChanged,function(input)
			if not dragging or not startMouse or not startPosition then return end
			if dragInput and dragInput.UserInputType==Enum.UserInputType.Touch and input~=dragInput then return end
			if input.UserInputType~=Enum.UserInputType.MouseMovement and input.UserInputType~=Enum.UserInputType.Touch then return end
			local point=Vector2.new(input.Position.X,input.Position.Y)
			local delta=point-startMouse
			card.Position=UDim2.new(startPosition.X.Scale,startPosition.X.Offset+delta.X,startPosition.Y.Scale,startPosition.Y.Offset+delta.Y)
		end)
		AddConnection(UserInputService.InputEnded,function(input)
			if not dragging then return end
			if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
				dragging=false
				dragInput=nil
				startMouse=nil
				startPosition=nil
			end
		end)
	end
	self._Widgets[name]=widget
	table.insert(self._WidgetOrder,widget)
	if gameInfoEnabled then
		task.spawn(function()
			local placeId=tonumber(game.PlaceId) or 0
			local universeId=tonumber(game.GameId) or 0
			local marketplace=game:GetService("MarketplaceService")
			local info
			local ok=false
			for attempt=1,4 do
				ok,info=pcall(function() return marketplace:GetProductInfo(placeId) end)
				if ok and type(info)=="table" and tostring(info.Name or "")~="" then break end
				task.wait(0.25*attempt)
			end
			if not (widget.Frame and widget.Frame.Parent) then return end
			local gameName=tostring((ok and type(info)=="table" and info.Name) or widgetConfig.FallbackName or game.Name or "Current game")
			widget:SetTitle(gameName)
			widget.Config.GameName=gameName
			local creatorName=""
			if ok and type(info)=="table" and type(info.Creator)=="table" then
				creatorName=tostring(info.Creator.Name or "")
			end
			if creatorName=="" then
				local creatorId=tonumber(game.CreatorId) or 0
				local creatorType=tostring(game.CreatorType or "")
				if creatorId>0 and creatorType:find("User") then
					pcall(function() creatorName=Players:GetNameFromUserIdAsync(creatorId) end)
				elseif creatorId>0 and creatorType:find("Group") then
					pcall(function()
						local groupInfo=game:GetService("GroupService"):GetGroupInfoAsync(creatorId)
						if type(groupInfo)=="table" then creatorName=tostring(groupInfo.Name or "") end
					end)
				end
			end
			widget.Config.GameCreator=creatorName
			if gameCreatorLabel and gameCreatorLabel.Parent then
				gameCreatorLabel.Text=creatorName~="" and ("@"..creatorName) or "Roblox experience"
			end
			if showGameImage then
				local iconAssetId=ok and type(info)=="table" and tonumber(info.IconImageAssetId or info.IconImageId or info.IconAssetId) or nil
				local finalImage
				if iconAssetId and iconAssetId>0 then
					finalImage="rbxassetid://"..tostring(math.floor(iconAssetId))
				elseif universeId>0 then
					finalImage="rbxthumb://type=GameIcon&id="..tostring(universeId).."&w=150&h=150"
				elseif placeId>0 then
					finalImage="rbxthumb://type=Asset&id="..tostring(placeId).."&w=150&h=150"
				end
				if finalImage then
					widget:SetImage(finalImage)
					task.defer(function()
						if heroImage and heroImage.Parent then
							pcall(function() game:GetService("ContentProvider"):PreloadAsync({heroImage}) end)
						end
					end)
				end
			end
		end)
	end
	if widgetConfig.OnCreate then pcall(widgetConfig.OnCreate,widget) end
	task.defer(function() raiseWidgetTree(body) refreshCanvas() end)
	return widget
end

function XLQPGen1:_InstallWidgetAPI(window,config)
	if not window then return window end
	self._WidgetWindow=window
	window.AddWidget=function(_,widgetConfig) return self:AddWidget(widgetConfig) end
	window.GetWidget=function(_,name) return self:GetWidget(name) end
	window.RemoveWidget=function(_,name) return self:RemoveWidget(name) end
	window.ClearWidgets=function(_) self:ClearWidgets() return window end
	window.OpenWidgets=function(_) self:SetWidgetsOpen(true) return window end
	window.CloseWidgets=function(_) self:SetWidgetsOpen(false) return window end
	window.ToggleWidgets=function(_) self:ToggleWidgets() return window end
	window.SetWidgetsEnabled=function(_,value) self:SetWidgetsEnabled(value) return window end
	window.IsWidgetsOpen=function(_) return self:IsWidgetsOpen() end
	window.IsWidgetsEnabled=function(_) return self:IsWidgetsEnabled() end
	if self._WidgetsEnabled and self._WidgetConfig and self._WidgetConfig.StartOpen==true then
		task.defer(function()
			task.wait()
			self:SetWidgetsOpen(true)
		end)
	end
	return window
end


makeWindowBeforeLoadingErrorBoundary=XLQPGen1.MakeWindow
function XLQPGen1:MakeWindow(config)
	self:_ConfigureDecorations(config)
	self:_ConfigureWidgets(config)
	local traceback=debug and debug.traceback or function(value) return tostring(value) end
	local ok,result=xpcall(function()
		return makeWindowBeforeLoadingErrorBoundary(self,config)
	end,traceback)
	if not ok then
		if type(self._AbortOptimizedStartupBuild)=="function" then pcall(function() self:_AbortOptimizedStartupBuild() end) end
		self:ReportLoadingError(result,"Module loader")
		XLQPWarn("XLQPGen1 module loader error: ",result)
		error(result,0)
	end
	if type(self.LoadDiscordAuthProfile)=="function" then
		pcall(function() self:LoadDiscordAuthProfile() end)
	end
	self:_InitializeDecorations()
	if result then self:_InstallWidgetAPI(result,config) end
	return result
end

XLQPGen1.SetFolder = XLQPGen1.SetFolder or function(self, folder)
	self.Folder = tostring(folder or self.Folder or "VerbalHub")
	self.ConfigFolder = self.Folder
	return self
end
XLQPGen1.SetLibrary = XLQPGen1.SetLibrary or function(self, library)
	self._ThemeLibrary = library or self
	return self
end
XLQPGen1.CreateWindow = XLQPGen1.MakeWindow
XLQPGen1.OpenWindow = XLQPGen1.MakeWindow
return XLQPGen1
