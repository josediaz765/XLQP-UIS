	local function normalizeImageUrl(url)
		url = tostring(url or "")
		if url == "" then return "" end
		if url:sub(1, 2) == "//" then url = "https:" .. url end
		if url:sub(1, 1) == "/" then url = "https://duckduckgo.com" .. url end
		return url
	end

	local function assetFromImageUrl(url)
		url = normalizeImageUrl(url)
		if url == "" or not (writefile and getcustomasset) then return nil end
		pcall(function() if makefolder and not isfolder("VerbalHub") then makefolder("VerbalHub") end end)
		pcall(function() if makefolder and not isfolder("VerbalHub/AIImages") then makefolder("VerbalHub/AIImages") end end)
		local body, code = sharedAIRawRequest("GET", url, { ["Accept"] = "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*", ["User-Agent"] = "Mozilla/5.0" }, nil, 45)
		if body == "" or (code ~= 0 and (code < 200 or code >= 300)) then return nil end
		local ext = url:lower():match("%.([a-z0-9]+)%??") or "png"
		if ext ~= "png" and ext ~= "jpg" and ext ~= "jpeg" and ext ~= "webp" then ext = "png" end
		local path = "VerbalHub/AIImages/" .. HttpService:GenerateGUID(false):gsub("-", "") .. "." .. ext
		local ok = pcall(function() writefile(path, body) end)
		if ok then
			local asset
			pcall(function() asset = getcustomasset(path) end)
			return asset
		end
		return nil
	end

	local function normalizeUICommand(value)
		local textValue = string.lower(tostring(value or ""))
		textValue = textValue:gsub("auto%s*farm", "auto farm")
		textValue = textValue:gsub("walk%s*speed", "walkspeed")
		textValue = textValue:gsub("field%s+of%s+view", "fov")
		textValue = textValue:gsub("[^%w%s%.%-_]", " ")
		textValue = textValue:gsub("[_%-]+", " ")
		textValue = textValue:gsub("%s+", " ")
		return textValue:match("^%s*(.-)%s*$") or ""
	end

	local function compactUICommand(value)
		return normalizeUICommand(value):gsub("%s+", "")
	end

	local uiStopWords = {
		the = true, a = true, an = true, please = true, pls = true, my = true,
