		local function verticalPadding(gui)
			local padding = gui:FindFirstChildOfClass("UIPadding")
			if not padding then return 0 end
			return math.max(0, padding.PaddingTop.Offset) + math.max(0, padding.PaddingBottom.Offset)
		end

		stableGuiHeight = function(gui, depth)
			if not gui or not gui:IsA("GuiObject") or gui.Visible == false then return 0 end
			depth = tonumber(depth) or 0
			if depth > 8 then return math.clamp(math.max(0, gui.Size.Y.Offset), 0, 50000) end
			local size = gui.Size
			local automaticY = automaticYEnabled(gui)
			if size.Y.Scale == 0 and not automaticY then
				local fixed = size.Y.Offset
				if fixed <= 0 then fixed = gui.AbsoluteSize.Y end
				return math.clamp(math.floor(math.max(0, fixed) + 0.5), 0, 50000)
			end
			if gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("TextBox") then
				local textHeight = 0
				pcall(function() textHeight = gui.TextBounds.Y end)
				return math.clamp(math.floor(math.max(size.Y.Offset, textHeight) + 0.5), 0, 50000)
			end
			local layout = gui:FindFirstChildOfClass("UIListLayout")
			if layout then
				return stableListHeight(gui, layout, depth + 1)
			end
			local maximum = math.max(0, size.Y.Offset)
			for _, child in ipairs(gui:GetChildren()) do
				if child:IsA("GuiObject") and child.Visible ~= false and child.Position.Y.Scale == 0 then
					local childSize = child.Size
					if childSize.Y.Scale == 0 or automaticYEnabled(child) then
						local childHeight = stableGuiHeight(child, depth + 1)
						maximum = math.max(maximum, child.Position.Y.Offset + childHeight)
					end
				end
			end
			maximum += verticalPadding(gui)
			return math.clamp(math.floor(maximum + 0.5), 0, 50000)
		end

		stableListHeight = function(container, layout, depth)
			if not container or not layout then return 0 end
			local total = verticalPadding(container)
			local count = 0
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("GuiObject") and child.Visible ~= false then
					total += stableGuiHeight(child, depth or 0)
					count += 1
				end
			end
			if count > 1 then total += math.max(0, layout.Padding.Offset) * (count - 1) end
			return math.clamp(math.floor(total + 0.5), 0, 50000)
		end

		local function ensureColumns()
