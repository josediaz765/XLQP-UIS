	updateMessageCounter()
	XLQPGen1:_InstallGlobalChatMenu(Chat,{
		Frame=frame,
		Title=title,
		Status=status,
		SoundId=ChatConfig.MessageSoundId,
		SoundVolume=ChatConfig.MessageSoundVolume,
		Render=function() updateTabs() end,
		RefreshVisibility=function() updateTabs() end,
		Clear=function()
			clearRows()
			if Chat.Tab=="global" then Chat.GlobalCache={} Chat.GlobalKey="" elseif Chat.Tab=="dm" then Chat.DMCache={} Chat.DMKey="" end
			updateCanvas()
		end,
		GetTranscript=function()
			local output={}
			for _,entry in ipairs((Chat.Tab=="dm" and Chat.DMCache or Chat.GlobalCache) or {}) do
				if Chat.Tab=="dm" then
					local stamp=Chat:FormatTimestamp(entry.timestamp or entry.created_at or entry.createdAt or entry.time)
					output[#output+1]=(stamp~="" and ("["..stamp.."] ") or "")..tostring(entry.sender_display_name or entry.sender_name or "Unknown")..": "..tostring(entry.content or "")
				else
					local stamp=Chat:FormatTimestamp(rowValue(entry,{"timestamp","created_at","createdAt","time","sent_at","sentAt"}))
					output[#output+1]=(stamp~="" and ("["..stamp.."] ") or "")..rowName(entry)..": "..rowMessage(entry)
				end
			end
			return table.concat(output,"\n")
		end
	})
	task.spawn(function()
		local api,err=XLQPGen1:LoadVerbalChatAPI(ChatConfig.API_URL)
		if not api then status.Text=tostring(err or "API failed") return end
		Chat.API=api
		Chat.Loaded=true
		status.Text="Ready"
		task.spawn(function()
			local profile=XLQPGen1:FetchDiscordAuthProfile(ChatConfig.BotId)
			if type(profile)=="table" then
				profile.avatarAsset=XLQPGen1:DownloadDiscordAuthAvatar(profile)
				Chat.BotProfile=profile
				Chat:Refresh(true)
			end
		end)
		Chat:Refresh(true)
		while frame.Parent and Chat.AutoRefresh~=false do
			task.wait(Chat.Settings.FastUpdates and 1 or ChatConfig.RefreshTime)
			Chat:Refresh(false)
		end
	end)
	Chat.Wrapper=frame
	table.insert(XLQPGen1.AllElements,Chat)
	WindowConfig._LocalRegisterState.SetupElement(ChatConfig,frame,frame,Chat)
	return Chat
end
