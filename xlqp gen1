			local button=AddThemeObject(SetChildren(SetProps(MakeElement("Button"),{
				Name=name,Size=UDim2.new(1/count,-((count-1)*6/count),1,0),LayoutOrder=index,BackgroundTransparency=0.72,Text="",AutoButtonColor=false,Parent=header
			}),{
				MakeElement("Corner",0,getNewUICornerRadius(0.62,7)),
				AddThemeObject(SetProps(MakeElement("Stroke"),{Transparency=0.64}),"Stroke"),
				AddThemeObject(SetProps(MakeElement("Label",name,11),{Name="Title",Size=UDim2.new(1,-10,1,0),Position=UDim2.fromOffset(5,0),Font=Enum.Font.GothamBold,TextSize=11,TextTruncate=Enum.TextTruncate.AtEnd}),"TextDark")
