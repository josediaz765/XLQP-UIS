				end
			end)
			function Grid:Clear()
				lastFreePoint=nil
				for index,cell in pairs(cells) do
					cell.BackgroundColor3=Color3.fromRGB(255,255,255)
					cell.BackgroundTransparency=0.94
					self.Value[index]=nil
				end
				for _,dot in ipairs(freeHost:GetChildren()) do if dot.Name=="Dot" then dot:Destroy() end end
				table.clear(points)
				self.Value.Points=points
				SafeCallback(GridConfig.Callback,{Name=GridConfig.Name,Element=self},self)
			end
			function Grid:SetColor(color)
				if typeof(color)=="Color3" then
					self.Color=color
					if colorButton then
						colorButton.BackgroundColor3=color
						colorButton.BackgroundTransparency=0.25
					end
				end
			end
			function Grid:SetTool(tool)
				self.Tool=tostring(tool or "Brush")
				lastFreePoint=nil
				updateStatus()
			end
			function Grid:SetBoxes(enabled)
				self.Boxes=enabled==true
				lastFreePoint=nil
				gridHost.Visible=self.Boxes
				freeHost.Visible=not self.Boxes
				updateStatus()
			end
			function Grid:SetGridSize(columns,rows)
				GridConfig.Columns=math.clamp(math.floor(tonumber(columns) or GridConfig.Columns),8,96)
				GridConfig.Rows=math.clamp(math.floor(tonumber(rows) or GridConfig.Rows),8,64)
				for _,cell in pairs(cells) do if cell then cell:Destroy() end end
