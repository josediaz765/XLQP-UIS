			local function updateWorldTag(player, localRootOverride)
				if player == LocalPlayer and TagConfig.IncludeLocalPlayer~=true then return end
				local char = player.Character
				local head = char and char:FindFirstChild("Head")
				if not head then removeWorldTag(player) return end
				if TagConfig.TeamCheck==true and LocalPlayer.Team and player.Team==LocalPlayer.Team then removeWorldTag(player) return end
				local existing=worldTags[player]
				if not existing or not existing.Parent then
					existing=buildWorldTag(head)
					worldTags[player]=existing
				elseif existing.Adornee~=head then
					existing.Adornee=head
					existing.Parent=head
				end
				local bubble=existing:FindFirstChild("Bubble")
				local track=existing:FindFirstChild("HealthTrack")
				local fill=track and track:FindFirstChild("Fill")
				local tagText=bubble and bubble:FindFirstChild("Text")
				local hum = char:FindFirstChildOfClass("Humanoid")
				local root = char:FindFirstChild("HumanoidRootPart") or head
				local health = hum and hum.Health or 0
				local maxHealth = hum and hum.MaxHealth or 100
				local fraction = maxHealth>0 and math.clamp(health/maxHealth,0,1) or 0
				local distance = 0
				local localRoot = localRootOverride
				if localRoot==nil then localRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") end
				if localRoot then distance = (localRoot.Position - root.Position).Magnitude end
				local info = {
					Player=player,Character=char,Humanoid=hum,Health=health,MaxHealth=maxHealth,
					Fraction=fraction,Distance=distance,Team=player.Team and player.Team.Name or nil,
					Name=resolveName(player),State=state
				}
				local text
				if type(TagConfig.Format)=="function" then
					local ok,value=pcall(TagConfig.Format,player,info)
					if ok and value~=nil then text=tostring(value) end
				end
				if text==nil then
					text = info.Name
					if state.ShowHealth and hum then
						text = text.."  "..tostring(state.ShowDecimal and math.floor(health*10)/10 or math.floor(health)).."hp"
					end
					if state.ShowTeam and info.Team then text = text.."  ["..info.Team.."]" end
					if state.ShowDistance and localRoot then text = text.."  "..tostring(math.floor(distance)).."m" end
				end
				if tagText and tagText.Text~=text then tagText.Text=text end
				if track then track.Visible = state.ShowHealth and hum~=nil end
				if fill then
					fill.Size=UDim2.fromScale(fraction,1)
					fill.BackgroundColor3=healthColor(fraction)
				end
				if bubble then
					local edge=bubble:FindFirstChild("Edge")
					local accentBar=bubble:FindFirstChild("Accent")
					local shade=state.ShowHealth and hum and healthColor(fraction) or tagAccent()
					if edge then edge.Color=shade end
					if accentBar then accentBar.BackgroundColor3=shade end
				end
				if TagConfig.FadeWithDistance~=false and localRoot then
					local far=math.clamp(distance/(tonumber(TagConfig.MaxDistance) or 1000),0,1)
					existing.Enabled=far<1
				end
			end
			addCheck("Show Health", "ShowHealth", 1)
			addCheck("Show Distance", "ShowDistance", 2)
			addCheck("Show Decimal", "ShowDecimal", 3)
			addCheck("Show Team", "ShowTeam", 4)
			local worldTagWorkerToken=0
			local function clearWorldTags()
				for player in pairs(worldTags) do removeWorldTag(player) end
			end
			local function stopWorldTagWorker()
				worldTagWorkerToken+=1
