function XLQPGen1:SetWidgetsOpen(value)
	value=value==true
	if value and not self._WidgetsEnabled then return self end
	local gui=self:_BuildWidgetDashboard()
	if not gui then return self end
	self._WidgetsOpen=value
	gui.Enabled=value
	if value then
		local target=type(self._WidgetConfig)=="table" and self._WidgetConfig or {}
		if target.HideMainWindow~=false then
			local host=self._MainWindowWrapper or self._MainWindow
			if host then
				pcall(function() self._WidgetRestoreMainVisible=host.Visible host.Visible=false end)
			end
			if self._SettingsWindow then pcall(function() self._WidgetRestoreSettingsVisible=self._SettingsWindow.Visible self._SettingsWindow.Visible=false end) end
		end
		if self._WidgetDashboardRoot then
			self._WidgetDashboardRoot.BackgroundTransparency=1
		end
		if self._WidgetDashboardScale then
			self._WidgetDashboardScale.Scale=math.max(0.92,self._WidgetDashboardScale.Scale*0.96)
			task.defer(function()
				if self._WidgetDashboardScale and self._WidgetDashboardScale.Parent then
					TweenService:Create(self._WidgetDashboardScale,TweenInfo.new(0.18,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
				end
			end)
		end
	else
		gui.Enabled=false
		local target=type(self._WidgetConfig)=="table" and self._WidgetConfig or {}
		if target.HideMainWindow~=false then
			local host=self._MainWindowWrapper or self._MainWindow
			if host and self._WidgetRestoreMainVisible~=nil then pcall(function() host.Visible=self._WidgetRestoreMainVisible end) end
			if self._SettingsWindow and self._WidgetRestoreSettingsVisible~=nil then pcall(function() self._SettingsWindow.Visible=self._WidgetRestoreSettingsVisible end) end
			self._WidgetRestoreMainVisible=nil
			self._WidgetRestoreSettingsVisible=nil
		end
	end
	self:_RefreshWidgetsBetaButton()
	return self
end

