	local PauseBarRight=Create("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0.5,4,0.5,0),Size=UDim2.new(0,3,0,13),BackgroundColor3=Color3.fromRGB(240,240,240),BorderSizePixel=0,Visible=false,ZIndex=9003,Parent=PlayButton})

