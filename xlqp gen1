local function sharedAIFindHuggingFaceAnswer(value, depth)
	depth = depth or 0
	if depth > 14 or type(value) ~= "table" then return nil end
	local found
	if value.role == "assistant" then
		if type(value.content) == "string" then
			local text = sharedAIClean(value.content)
			if text ~= "" then found = text end
		elseif type(value.content) == "table" then
			for _, part in ipairs(value.content) do
				if type(part) == "table" and type(part.content or part.text) == "string" then
					local text = sharedAIClean(part.content or part.text)
					if text ~= "" then found = text end
				end
			end
		end
	end
	for _, child in pairs(value) do
		if type(child) == "table" then
			local result = sharedAIFindHuggingFaceAnswer(child, depth + 1)
			if result and result ~= "" then found = result end
		end
	end
	return found
end

local function sharedAIExtractSSE(body)
	local answer
	for line in tostring(body or ""):gmatch("[^\r\n]+") do
		local payload = line:match("^data:%s*(.+)$")
		if payload and payload ~= "[DONE]" then
			local data = sharedAIDecode(payload)
			if data then
				local result = sharedAIFindHuggingFaceAnswer(data)
				if result and result ~= "" then answer = result end
			end
		end
	end
	if answer then return answer end
	local direct = sharedAIDecode(body)
	return direct and sharedAIFindHuggingFaceAnswer(direct) or nil
end

