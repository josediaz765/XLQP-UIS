		local options = {
			Url = url,
			Method = method,
			Headers = headers or {},
			Timeout = timeout or 70
		}
		if body ~= nil then options.Body = body end
		local ok, response = pcall(function() return fn(options) end)
		if not ok then
			options.Timeout = nil
			ok, response = pcall(function() return fn(options) end)
		end
		if ok and response then
			local responseBody = tostring(response.Body or response.body or response.ResponseBody or response.responseBody or "")
			local code = tonumber(response.StatusCode or response.Status or response.status) or (responseBody ~= "" and 200 or 0)
