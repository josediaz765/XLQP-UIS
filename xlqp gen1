	local function decorateFavorite(result)
        if type(result) ~= "table" or result.LockedOut == true then return end
        local tabInfo = result.Tab
        if type(tabInfo) ~= "table" then return end
        if not tabInfo.Button or typeof(tabInfo.Button) ~= "Instance" or tabInfo._XLQPFavoriteReady then return end
        tabInfo._XLQPFavoriteReady = true
        local key = tostring((tabInfo.ParentTopTab and tabInfo.ParentTopTab.Name or "Main") .. "/" .. tostring(tabInfo.Name or "Tab"))
        local button = tabInfo.Button
        local titleLabel = button:FindFirstChild("Title")
        if titleLabel then titleLabel.Size = UDim2.new(1, -62, 1, 0) end
        local star = Instance.new("TextButton")
        star.Name = "Favorite"
        star.BackgroundTransparency = 1
        star.AnchorPoint = Vector2.new(1, 0.5)
        star.Position = UDim2.new(1, -6, 0.5, 0)
        star.Size = UDim2.fromOffset(26, 26)
        star.TextSize = 19
        star.Font = Enum.Font.GothamBold
        star.AutoButtonColor = false
		star.Active = true
		star.Selectable = true
		star.ClipsDescendants = false
        star.ZIndex = math.max(button.ZIndex + 3, 6)
        star.Parent = button
		button.ClipsDescendants = true
		favoriteOrderSerial += 1
		local baseOrder = tonumber(button.LayoutOrder)
		if baseOrder == nil then baseOrder = 0 end
		local groupBaseOrder = tabInfo.Group and tonumber(tabInfo.Group.BaseOrder) or nil
		local favoriteOrder = groupBaseOrder and (groupBaseOrder + 500000 + favoriteOrderSerial) or (-100000 + favoriteOrderSerial)
		button:SetAttribute("XLQPFavoriteBaseOrder", baseOrder)
		local function liftFavoriteButton()
			star.ZIndex = math.max(button.ZIndex + 140, 180)
			star.Visible=config.ShowTabInfo~=false
			if config.ShowTabInfo~=false then
				star.AnchorPoint=Vector2.new(1,.5)
				star.Position=UDim2.new(1,-8,.5,0)
				star.Size=UDim2.fromOffset(28,28)
				star.TextSize=19
			end
			for _, child in ipairs(button:GetChildren()) do
				if child:IsA("GuiObject") and child ~= star then
					child.ZIndex = math.min(child.ZIndex, star.ZIndex - 1)
				end
			end
			if titleLabel then
				titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
				titleLabel.Size = button:FindFirstChild("Ico") and UDim2.new(1, -86, 1, 0) or UDim2.new(1, -58, 1, 0)
			end
		end
		local function refreshFavorite()
            local active = favorites[key] == true
            star.Text = active and "★" or "☆"
            star.TextColor3 = active and Color3.fromRGB(255, 205, 55) or Color3.fromRGB(160, 160, 170)
			button.LayoutOrder = active and favoriteOrder or baseOrder
			liftFavoriteButton()
			local _, _, holder = getTabListObjects()
			if holder then
				holder.ClipsDescendants = true
				task.defer(function()
					if holder and holder.Parent then
						holder.CanvasPosition = Vector2.new(0, 0)
						local layout = holder:FindFirstChildOfClass("UIListLayout")
						if layout then holder.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20) end
					end
				end)
			end
        end
		local favoriteDebounce = false
        star.Activated:Connect(function()
			if favoriteDebounce then return end
			favoriteDebounce = true
			if favorites[key] == true then
				favorites[key] = nil
			else
				favorites[key] = true
			end
            refreshFavorite()
            XLQPWriteFavoriteMap(config.ConfigFolder or config.Name, favorites)
			task.delay(0.12, function() favoriteDebounce = false end)
        end)
		function tabInfo:SetFavorite(value)
			favorites[key] = value == true and true or nil
			refreshFavorite()
			XLQPWriteFavoriteMap(config.ConfigFolder or config.Name, favorites)
			return self
		end
		function tabInfo:IsFavorite() return favorites[key] == true end
		function tabInfo:ToggleFavorite() return self:SetFavorite(not self:IsFavorite()) end
		AddConnection(button:GetPropertyChangedSignal("ZIndex"), liftFavoriteButton)
        refreshFavorite()
    end

    local refreshTabListLayout = function() end

    local function decorateResult(result, tabConfig)
        XLQPDecorateElementHost(library, window, result, config)
        local logo = XLQPGetTabListLogoFromConfig(tabConfig)
        if logo ~= nil then window:SetTabListLogo(logo) end
        task.defer(function()
            decorateFavorite(result)
            refreshTabListLayout()
			if library._RefreshWindowLiveColor then library:_RefreshWindowLiveColor() end
        end)
        return result
    end

    local function makeTabStub()
        local stub
        stub = setmetatable({Name = "Unavailable", Type = "Stub", Failed = true}, {
            __index = function(self, key)
                if key == "Container" or key == "Wrapper" or key == "Frame" or key == "Button" then return nil end
                return function() return self end
            end
        })
        return stub
    end

    local function callTabMethod(methodName, oldMethod, target, tabConfig)
        local results = table.pack(xpcall(oldMethod, function(err)
            local trace = ""
            pcall(function() trace = "\n" .. debug.traceback("", 2) end)
            return tostring(err) .. trace
        end, target, tabConfig))
        if results[1] then return true, table.unpack(results, 2, results.n) end
        local tabName = type(tabConfig) == "table" and tostring(tabConfig.Name or tabConfig.Title or "?") or tostring(tabConfig)
        local message = "[XLQPGen1] " .. methodName .. "(\"" .. tabName .. "\") failed and was skipped: " .. tostring(results[2])
        pcall(XLQPEnvironment.XLQPRealWarn or warn, message)
        pcall(function()
            library.LibErrors[#library.LibErrors + 1] = {Name = "Tab", Message = message, Time = os.clock()}
            library._HasLibErrors = true
            library._LastElementError = message
        end)
        return false
    end

    local oldMethods = {}
    for _, methodName in ipairs({"MakeTab", "AddTab", "CreateTab"}) do
        if type(window[methodName]) == "function" then oldMethods[methodName] = window[methodName] end
    end
    for methodName, oldMethod in pairs(oldMethods) do
        window[methodName] = function(target, tabConfig)
            local ok, result = callTabMethod(methodName, oldMethod, target, tabConfig)
            if not ok then return makeTabStub() end
            local decorated
            local decorateOk = pcall(function() decorated = decorateResult(result, tabConfig) end)
            if not decorateOk then return result end
            return decorated
        end
    end

    for _, methodName in ipairs({"newmaketabtop", "AddTopTab", "MakeTopTab", "CreateTopTab"}) do
        local oldMethod = window[methodName]
        if type(oldMethod) == "function" then
            window[methodName] = function(target, tabConfig)
                local ok, result = callTabMethod(methodName, oldMethod, target, tabConfig)
                if not ok then return makeTabStub() end
                pcall(function()
                    local logo = XLQPGetTabListLogoFromConfig(tabConfig)
                    if logo ~= nil then target:SetTabListLogo(logo) end
                    task.defer(refreshTabListLayout)
                end)
                local decorated = result
                pcall(function() decorated = XLQPDecorateElementHost(library, window, result, config) end)
                return decorated
            end
        end
    end

	local lastDetachedWidth, lastDetachedCollapsed
	local function applyDetachedLayout(positionOnly)
        local mainWindow, sideFrame, holder = getTabListObjects()
        if not mainWindow or not mainWindow.Parent or not sideFrame or not holder then return end
        local root = XLQPGetRoot(mainWindow)
        if not root then return end
		if library._MainWindowMinimized==true then
			sideFrame.Visible=false
			local sidebarToggle=context.MainSidebarToggle or mainWindow:FindFirstChild("MainSidebarToggle") or root:FindFirstChild("MainSidebarToggle")
			if sidebarToggle then sidebarToggle.Visible=false end
			return
		end
		local collapsedWidth=math.clamp(tonumber(config.SidebarCollapsedWidth) or 76,64,104)
		local dragWidth=tonumber(config._SidebarDragWidth)
		local width = dragWidth and math.clamp(dragWidth,collapsedWidth,300) or (config.ShowTabInfo == false and collapsedWidth or math.clamp(tonumber(config.SidebarWidth) or 168,112,300))
		local collapsedState = config.ShowTabInfo == false
		if positionOnly == true and (lastDetachedWidth ~= width or lastDetachedCollapsed ~= collapsedState) then positionOnly = false end
		lastDetachedWidth = width
		lastDetachedCollapsed = collapsedState
        local gap = math.clamp(tonumber(config.TabListGap) or 12, 4, 40)
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
        local x = mainWindow.AbsolutePosition.X - width - gap
        local y = mainWindow.AbsolutePosition.Y
        local height = mainWindow.AbsoluteSize.Y
        x = math.clamp(math.floor(x), 6, math.max(6, viewport.X - width - 6))
        y = math.clamp(math.floor(y), 6, math.max(6, viewport.Y - height - 6))
        if sideFrame.Parent ~= root then sideFrame.Parent = root end
        sideFrame.AnchorPoint = Vector2.new(0, 0)
        sideFrame.Position = UDim2.fromOffset(x, y)
		local sidebarToggle=context.MainSidebarToggle or mainWindow:FindFirstChild("MainSidebarToggle") or root:FindFirstChild("MainSidebarToggle")
		if positionOnly == true then
			if sidebarToggle then
				context.MainSidebarToggle=sidebarToggle
				if sidebarToggle.Parent~=root then sidebarToggle.Parent=root end
				sidebarToggle.AnchorPoint=Vector2.new(.5,.5)
				sidebarToggle.Position=UDim2.fromOffset(x+width,y+height*.5)
				sidebarToggle.Visible=sideFrame.Visible
				sidebarToggle.ZIndex=620
			end
			return
		end
		sideFrame.Size = UDim2.fromOffset(width, height)
        sideFrame.Visible = mainWindow.Visible and height > 120
		local liveTabBackground=config.LiveColorBackground==true
		local cleanModeActive=(XLQPGen1._CleanBackgroundEnabled==true) or (XLQPGen1._TransparentUIEnabled==true)
		sideFrame.BackgroundTransparency = cleanModeActive and 0.62 or (liveTabBackground and 0.01 or 0.06)
		sideFrame.BackgroundColor3 = liveTabBackground and Color3.new(1,1,1) or Color3.fromRGB(25, 25, 29)
		sideFrame.ClipsDescendants = true
		sideFrame.ZIndex = 40
		local sidebarRadius=math.clamp(tonumber(config.SidebarCornerRadius) or tonumber(config.NewUICornerRadius) or 14,0,math.min(32,math.floor(width*.5),math.floor(height*.5)))
		local sideCorner=sideFrame:FindFirstChildOfClass("UICorner")
		if not sideCorner then sideCorner=Create("UICorner",{Name="XLQPSidebarCorner",Parent=sideFrame}) end
		sideCorner.CornerRadius=UDim.new(0,sidebarRadius)
		if sidebarToggle then
			context.MainSidebarToggle=sidebarToggle
			if sidebarToggle.Parent~=root then sidebarToggle.Parent=root end
			sidebarToggle.AnchorPoint=Vector2.new(.5,.5)
			sidebarToggle.Position=UDim2.fromOffset(x+width,y+height*.5)
			sidebarToggle.Visible=sideFrame.Visible
			sidebarToggle.ZIndex=620
		end
		local detachedImage=sideFrame:FindFirstChild("XLQPDetachedTabListBackground")
		if not detachedImage then
			detachedImage=Instance.new("ImageLabel")
			detachedImage.Name="XLQPDetachedTabListBackground"
			detachedImage.BackgroundTransparency=1
			detachedImage.BorderSizePixel=0
			detachedImage.ScaleType=Enum.ScaleType.Crop
			detachedImage.Parent=sideFrame
		end
		detachedImage.Position=UDim2.fromScale(0,0)
		detachedImage.Size=UDim2.fromScale(1,1)
		detachedImage.ClipsDescendants=true
		detachedImage.ZIndex=sideFrame.ZIndex+1
		detachedImage.ImageColor3=Color3.new(1,1,1)
		local detachedCorner=detachedImage:FindFirstChild("XLQPBackgroundCorner") or detachedImage:FindFirstChildOfClass("UICorner")
		if not detachedCorner then detachedCorner=Create("UICorner",{Name="XLQPBackgroundCorner",Parent=detachedImage}) end
		detachedCorner.CornerRadius=UDim.new(0,sidebarRadius)
		local restoredCustom=false
		if config.LiveColorTheme=="Custom" and library._RestoreCustomTabListMedia then
			local ok,result=pcall(function()
				return library:_RestoreCustomTabListMedia(sideFrame,detachedImage)
			end)
			restoredCustom=ok and result==true
		end
		if not restoredCustom then
			if thumbnailOverlay then
				pcall(function() detachedImage.ImageContent=thumbnailOverlay.ImageContent end)
				detachedImage.Image=thumbnailOverlay.Image
				detachedImage.ImageTransparency=thumbnailOverlay.ImageTransparency
				detachedImage.ImageColor3=thumbnailOverlay.ImageColor3
				detachedImage.Visible=thumbnailOverlay.Visible and (tostring(thumbnailOverlay.Image or "")~="" or pcall(function() return thumbnailOverlay.ImageContent~=nil end))
			else
				detachedImage.Visible=false
			end
		end
		local legacyDetachedImage=sideFrame:FindFirstChild("XLQPTabListBackground")
		if legacyDetachedImage then
			legacyDetachedImage.Visible=false
			if config.LiveColorTheme=="Custom" and library._GifRuntime and library._GifRuntime.Content then
				local found=false
				for _,layer in ipairs(library._GifRuntime.Layers or {}) do
					if layer==legacyDetachedImage then found=true break end
				end
				if found then
					for index=#library._GifRuntime.Layers,1,-1 do
						if library._GifRuntime.Layers[index]==legacyDetachedImage then table.remove(library._GifRuntime.Layers,index) end
					end
				end
			end
		end
		local liveHeader=sideFrame:FindFirstChild("XLQPTabListHeaderShield")
		if liveHeader then
			liveHeader.BackgroundColor3=(cleanModeActive or liveTabBackground) and Color3.new(1,1,1) or sideFrame.BackgroundColor3
			liveHeader.BackgroundTransparency=cleanModeActive and 0.62 or (liveTabBackground and 0.42 or sideFrame.BackgroundTransparency)
			local liveFill=sideFrame:FindFirstChild("XLQPTabListHeaderBottomFill")
			if liveFill then liveFill.BackgroundColor3=liveHeader.BackgroundColor3 liveFill.BackgroundTransparency=liveHeader.BackgroundTransparency end
		end
		local liveProfile=sideFrame:FindFirstChild("ProfileBar")
		if liveProfile and liveProfile:IsA("GuiObject") and liveTabBackground then liveProfile.BackgroundTransparency=0.32 end
		setTabListDockDecorations(sideFrame, true)
		local function raiseDetachedObject(gui)
			if not gui:IsA("GuiObject") then return end
			if gui.Name=="XLQPTabListBackground" then gui.ZIndex=sideFrame.ZIndex+1 return end
			local baseZIndex = gui:GetAttribute("XLQPDetachedBaseZIndex")
			if type(baseZIndex) ~= "number" then baseZIndex = gui.ZIndex gui:SetAttribute("XLQPDetachedBaseZIndex", baseZIndex) end
			gui.ZIndex = sideFrame.ZIndex + math.max(2, math.floor(baseZIndex))
		end
		if sideFrame:GetAttribute("XLQPDetachedStyled") ~= true then
			sideFrame:SetAttribute("XLQPDetachedStyled", true)
			for _, gui in ipairs(sideFrame:GetDescendants()) do raiseDetachedObject(gui) end
		end
		if not sideFrame:GetAttribute("XLQPDetachedZIndexHooked") then
			sideFrame:SetAttribute("XLQPDetachedZIndexHooked", true)
			sideFrame.DescendantAdded:Connect(function(gui)
				task.defer(function() if gui and gui.Parent then raiseDetachedObject(gui) applyDetachedLayout() end end)
			end)
		end
		if not sideFrame:FindFirstChildOfClass("UIStroke") then XLQPCreateStroke(sideFrame, 0.44) end
		setTabListDockDecorations(sideFrame, true)
		local profile = sideFrame:FindFirstChild("ProfileBar")
		local logo = sideFrame:FindFirstChild("XLQPTabListLogo") or sideFrame:FindFirstChild("XLQPSidebarLogo")
		if logo then
			layoutTabListLogo(logo, width)
		end
		local logoHeight = getRenderedLogoHeight(sideFrame, logo)
		local logoGap = logo and logo.Visible and (config.ShowTabInfo==false and 8 or math.clamp(tonumber(logo:GetAttribute("XLQPHeaderGap")) or 10, 4, 28)) or 0
		local profileHeight = profile and profile.Visible and math.max(50, profile.AbsoluteSize.Y, profile.Size.Y.Offset) or 0
		holder.ClipsDescendants = true
		holder.Position = UDim2.fromOffset(0, logoHeight + logoGap)
		holder.Size = UDim2.new(1, 0, 1, -(logoHeight + logoGap + profileHeight))
		local headerShield = sideFrame:FindFirstChild("XLQPTabListHeaderShield")
		if headerShield then
			headerShield.Size = UDim2.new(1, 0, 0, logoHeight + logoGap)
			headerShield.BackgroundColor3 = sideFrame.BackgroundColor3
			headerShield.BackgroundTransparency = liveTabBackground and 0.42 or sideFrame.BackgroundTransparency
			headerShield.ZIndex = sideFrame.ZIndex + 240
			headerShield.Visible = logo ~= nil and logo.Visible
			local radius = math.clamp(tonumber(config.SidebarCornerRadius) or tonumber(config.NewUICornerRadius) or 14, 0, 32)
			local headerCorner = headerShield:FindFirstChild("XLQPHeaderCorner")
			if headerCorner then headerCorner.CornerRadius = UDim.new(0, radius) end
			local headerBottomFill = sideFrame:FindFirstChild("XLQPTabListHeaderBottomFill")
			if headerBottomFill then
				headerBottomFill.BackgroundColor3 = headerShield.BackgroundColor3
				headerBottomFill.BackgroundTransparency = headerShield.BackgroundTransparency
				headerBottomFill.Position = UDim2.new(0, 0, 0, math.max(0, logoHeight + logoGap - radius))
				headerBottomFill.Size = UDim2.new(1, 0, 0, math.max(2, radius))
				headerBottomFill.ZIndex = headerShield.ZIndex
				headerBottomFill.Visible = headerShield.Visible
			end
			if logo then
				logo.ZIndex = headerShield.ZIndex + 1
				for _, gui in ipairs(logo:GetDescendants()) do
					if gui:IsA("GuiObject") then gui.ZIndex = logo.ZIndex + 1 end
				end
			end
		end
		local holderLayout = holder:FindFirstChildOfClass("UIListLayout")
		if holderLayout then holder.CanvasSize = UDim2.new(0,0,0,holderLayout.AbsoluteContentSize.Y + 20) end

        local searchField = mainWindow:FindFirstChild("TopSearchField")
        local contentTop = searchField and searchField.Parent == mainWindow and searchField.Visible and 132 or 95
        for _, tab in ipairs(context.AllTopTabObjects or {}) do
            if tab.Container and tab.Container:GetAttribute("XLQPDetachedLayout")~=true then
                tab.Container.Position = UDim2.new(0, 0, 0, contentTop)
                tab.Container.Size = UDim2.new(1, 0, 1, -contentTop)
            end
        end
        for _, tab in ipairs(context.AllSideTabObjects or {}) do
            if tab.Container and tab.Container:GetAttribute("XLQPDetachedLayout")~=true then
                tab.Container.Position = UDim2.new(0, 0, 0, contentTop)
                tab.Container.Size = UDim2.new(1, 0, 1, -contentTop)
            end
        end
        for _, child in ipairs(mainWindow:GetChildren()) do
            if child:IsA("GuiObject") and (child.Name == "ItemContainer_Direct" or child.Name == "ItemContainer_Side" or child.Name == "ScriptHubContainer") then
                child.Position = UDim2.new(0, 0, 0, contentTop)
                child.Size = UDim2.new(1, 0, 1, -contentTop)
            end
        end
		window.TabListFrame = sideFrame
        window.TabListDetached = true
        if window.DetachedQuickMenus then
            for _, menu in ipairs(window.DetachedQuickMenus) do
                if menu and menu.RefreshPosition then pcall(menu.RefreshPosition) end
            end
        end
    end

	local function applyInternalLayout()
		local mainWindow, sideFrame, holder = getTabListObjects()
		if not mainWindow or not sideFrame then return end
		if sideFrame.Parent ~= mainWindow then sideFrame.Parent = mainWindow end
		local sidebarToggle=context.MainSidebarToggle
		if sidebarToggle and sidebarToggle.Parent~=mainWindow then sidebarToggle.Parent=mainWindow end
		if library._MainWindowMinimized==true then
			sideFrame.Visible=false
			if sidebarToggle then sidebarToggle.Visible=false end
			return
		end
		sideFrame.Visible = true
		sideFrame.ClipsDescendants=true
		local internalRadius=math.clamp(tonumber(config.SidebarCornerRadius) or tonumber(config.NewUICornerRadius) or 14,0,32)
		local internalCorner=sideFrame:FindFirstChildOfClass("UICorner")
		if not internalCorner then internalCorner=Create("UICorner",{Name="XLQPSidebarCorner",Parent=sideFrame}) end
		internalCorner.CornerRadius=UDim.new(0,internalRadius)
		local internalImage=sideFrame:FindFirstChild("XLQPTabListBackground")
		if config.LiveColorTheme=="Custom" and library._RestoreCustomTabListMedia then
			pcall(function() library:_RestoreCustomTabListMedia(sideFrame,nil) end)
		end
		if internalImage and internalImage:IsA("ImageLabel") then
			internalImage.ClipsDescendants=true
			local imageCorner=internalImage:FindFirstChild("XLQPBackgroundCorner") or internalImage:FindFirstChildOfClass("UICorner")
			if not imageCorner then imageCorner=Create("UICorner",{Name="XLQPBackgroundCorner",Parent=internalImage}) end
			imageCorner.CornerRadius=UDim.new(0,internalRadius)
		end
		local logo = sideFrame:FindFirstChild("XLQPTabListLogo") or sideFrame:FindFirstChild("XLQPSidebarLogo")
		if logo and holder then
			layoutTabListLogo(logo)
			local logoHeight = getRenderedLogoHeight(sideFrame, logo)
			local logoGap = logo.Visible and (config.ShowTabInfo==false and 8 or math.clamp(tonumber(logo:GetAttribute("XLQPHeaderGap")) or 10, 4, 28)) or 0
			local profile = sideFrame:FindFirstChild("ProfileBar")
			local profileHeight = profile and profile.Visible and math.max(50, profile.AbsoluteSize.Y, profile.Size.Y.Offset) or 0
			holder.Position = UDim2.fromOffset(0, logoHeight + logoGap)
			holder.Size = UDim2.new(1, 0, 1, -(logoHeight + logoGap + profileHeight))
			local headerShield = sideFrame:FindFirstChild("XLQPTabListHeaderShield")
			if headerShield then
				headerShield.Size = UDim2.new(1, 0, 0, logoHeight + logoGap)
				headerShield.Visible = logo.Visible
				local radius = math.clamp(tonumber(config.SidebarCornerRadius) or tonumber(config.NewUICornerRadius) or 14, 0, 32)
				local headerCorner = headerShield:FindFirstChild("XLQPHeaderCorner")
				if headerCorner then headerCorner.CornerRadius = UDim.new(0, radius) end
				local headerBottomFill = sideFrame:FindFirstChild("XLQPTabListHeaderBottomFill")
				if headerBottomFill then
					headerBottomFill.Position = UDim2.new(0, 0, 0, math.max(0, logoHeight + logoGap - radius))
					headerBottomFill.Size = UDim2.new(1, 0, 0, math.max(2, radius))
					headerBottomFill.Visible = headerShield.Visible
				end
			end
		end
        setTabListDockDecorations(sideFrame, false)
        window.TabListFrame = sideFrame
        window.TabListDetached = false
    end

    local function stabilizeSideTabRows()
        local _, sideFrame, holder = getTabListObjects()
        if not (sideFrame and holder) then return end
        local expanded=config.ShowTabInfo~=false
        local rowHeight=XLQPGen1._BigUIEnabled and 52 or 48
        for _,tab in ipairs(context.AllSideTabObjects or {}) do
            local button=tab and tab.Button
            if button and button.Parent==holder then
                button.AutomaticSize=Enum.AutomaticSize.None
                button.Size=expanded and UDim2.new(1,-20,0,rowHeight) or UDim2.new(1,-16,0,48)
                button.ClipsDescendants=true
                local title=button:FindFirstChild("Title")
                if title then
                    title.Visible=expanded
                    title.TextTruncate=Enum.TextTruncate.AtEnd
                    title.Size=button:FindFirstChild("Ico") and UDim2.new(1,-86,1,0) or UDim2.new(1,-58,1,0)
                end
                local favorite=button:FindFirstChild("Favorite")
                if favorite and favorite:IsA("GuiObject") then favorite.Visible=expanded end
                local icon=button:FindFirstChild("Ico")
                local iconCenterX=28
                if icon and icon:IsA("ImageLabel") then
                    icon.AnchorPoint=Vector2.new(.5,.5)
                    icon.Size=UDim2.fromOffset(expanded and 20 or 21,expanded and 20 or 21)
                    icon.Position=expanded and UDim2.new(0,iconCenterX,.5,0) or UDim2.fromScale(.5,.5)
                end
                local well=button:FindFirstChild("IconWell")
                if well and well:IsA("GuiObject") then
                    well.Size=UDim2.fromOffset(expanded and 40 or 38,expanded and 40 or 38)
                    well.AnchorPoint=Vector2.new(.5,.5)
                    well.Position=expanded and UDim2.new(0,iconCenterX,.5,0) or UDim2.fromScale(.5,.5)
                    well.ClipsDescendants=true
                    local wellCorner=well:FindFirstChildOfClass("UICorner")
                    if wellCorner then wellCorner.CornerRadius=UDim.new(0,11) end
                end
                if title and icon then
                    title.Position=UDim2.new(0,58,0,0)
                    title.Size=UDim2.new(1,-92,1,0)
                end
            end
        end
        local state=config._LocalRegisterState
        if state and type(state.applySidebarCompactVisuals)=="function" then
			local currentWidth=math.max(sideFrame.AbsoluteSize.X,sideFrame.Size.X.Offset)
			local compact=(config.ShowTabInfo==false) or (currentWidth>0 and currentWidth<(tonumber(config.SidebarCompactBreakpoint) or 132))
			state.applySidebarCompactVisuals(compact,currentWidth)
		end
        local layout=holder:FindFirstChildOfClass("UIListLayout")
        if layout then holder.CanvasSize=UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+20) end
    end

    refreshTabListLayout = function()
        if config.SidebarTab then applyDetachedLayout() else applyInternalLayout() end
        stabilizeSideTabRows()
		if library._RefreshUtilityDockLayout then task.defer(library._RefreshUtilityDockLayout) end
    end

    library._TabListLayoutHook = function()
        if library._TabListLayoutHookQueued then return end
        library._TabListLayoutHookQueued = true
        task.defer(function()
            library._TabListLayoutHookQueued = false
            pcall(refreshTabListLayout)
			if config.LiveColorTheme=="Custom" and library._RestoreCustomTabListMedia then
				local _,sideFrameNow=getTabListObjects()
				local detached=sideFrameNow and sideFrameNow:FindFirstChild("XLQPDetachedTabListBackground")
				pcall(function() library:_RestoreCustomTabListMedia(sideFrameNow,detached) end)
			end
        end)
    end

    function window:RefreshTabListLayout()
        refreshTabListLayout()
        return self
    end

    task.defer(function()
        local mainWindow, sideFrame, holder = getTabListObjects()
        if not mainWindow or not sideFrame or not holder then
            warn("[XLQP Gen1] TabList could not find the window tab-list objects")
            return
        end
        createTabListLogo(config.TabListLogo)
        if config.SidebarTab then applyDetachedLayout() else applyInternalLayout() end
		if library._RefreshWindowLiveColor then library:_RefreshWindowLiveColor() end

        mainWindow:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            if not config.SidebarTab then return end
            local state=config._LocalRegisterState
            if state and type(state.resizeWorkPaused)=="function" and state.resizeWorkPaused() then
                if type(state.queueResizeFollowup)=="function" then
                    state.queueResizeFollowup(sideFrame,function() if config.SidebarTab then applyDetachedLayout() end end)
                end
                return
            end
            applyDetachedLayout(true)
        end)
        mainWindow:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if not config.SidebarTab then return end
            local state=config._LocalRegisterState
            if state and type(state.resizeWorkPaused)=="function" and state.resizeWorkPaused() then
                if type(state.queueResizeFollowup)=="function" then
                    state.queueResizeFollowup(sideFrame,function() if config.SidebarTab then applyDetachedLayout() end end)
                end
                return
            end
            applyDetachedLayout()
        end)
		mainWindow:GetPropertyChangedSignal("Visible"):Connect(function()
            if config.SidebarTab then applyDetachedLayout() else sideFrame.Visible = mainWindow.Visible end
			if mainWindow.Visible and config.LiveColorTheme=="Custom" then
				task.defer(function()
					if not mainWindow.Parent or not mainWindow.Visible then return end
					local detached=sideFrame and sideFrame:FindFirstChild("XLQPDetachedTabListBackground")
					if library._RestoreCustomTabListMedia then
						pcall(function() library:_RestoreCustomTabListMedia(sideFrame,detached) end)
					end
					if library._SyncCustomLiveThemeSurfaces then
						pcall(function() library:_SyncCustomLiveThemeSurfaces() end)
					end
				end)
            end
        end)
        mainWindow.AncestryChanged:Connect(function(_, parent)
            if not parent and sideFrame and sideFrame.Parent then sideFrame:Destroy() end
        end)
		task.spawn(function()
			for _ = 1, 5 do
				task.wait(0.2)
				if not mainWindow.Parent then break end
                if config.TabListLogo and not sideFrame:FindFirstChild("XLQPTabListLogo") then createTabListLogo(config.TabListLogo) end
                if config.SidebarTab then applyDetachedLayout() end
            end
        end)
    end)

	if XLQPSecureMode and not self._SecureFailureNoticeScheduled then
		self._SecureFailureNoticeScheduled = true
		task.delay(4, function()
			if XLQPSecureFailures > 0 and self.MakeNotification then
				pcall(function()
					self:MakeNotification({
						Name = "Secure mode",
						Content = "Some built-in assets could not be cached and will stay blank.",
						Image = "",
						Time = 6
					})
				end)
			end
		end)
	end

	if XLQPAssetModelRaw ~= nil and not self._AssetModelNoticeScheduled then
		self._AssetModelNoticeScheduled = true
		task.delay(2, function()
			local issue = XLQPAssetModelIssue()
			if issue and self.MakeNotification then
				pcall(function()
					self:MakeNotification({
						Name = "Invalid model asset",
						Content = issue,
						Image = "",
						Time = 10
					})
				end)
			end
		end)
	end
	if config.PrivateTabs==true or config.privateTabs==true or type(config.PrivateTabs)=="table" or type(config.privateTabs)=="table" then self:_InstallPrivateTabs(window,config) end

    return window
end


