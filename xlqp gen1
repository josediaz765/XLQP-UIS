local function normalizeNotificationPosition(pos)
	local value = tostring(pos or ""):lower():gsub("%s+", "")
	if value == "topleft" or value == "lefttop" then
		return UDim2.new(0, 15, 0, 15), Vector2.new(0, 0), Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top
	elseif value == "topright" or value == "righttop" then
		return UDim2.new(1, -15, 0, 15), Vector2.new(1, 0), Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Top
	elseif value == "bottomleft" or value == "leftbottom" then
		return UDim2.new(0, 15, 1, -15), Vector2.new(0, 1), Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom
	end
	return UDim2.new(1, -15, 1, -15), Vector2.new(1, 1), Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom
end

local function applyNotificationPosition(pos)
	local position, anchor, horizontal, vertical = normalizeNotificationPosition(pos)
	NotificationHolder.Position = position
	NotificationHolder.AnchorPoint = anchor
	local layout = NotificationHolder:FindFirstChildOfClass("UIListLayout")
	if layout then
		layout.HorizontalAlignment = horizontal
		layout.VerticalAlignment = vertical
	end
end

local function normalizeIconAsset(icon)
	if typeof(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	end
	local value = tostring(icon or "")
	if value == "" then return "rbxassetid://4384403532" end
	if value:match("^%d+$") then return "rbxassetid://" .. value end
	local named = {
		bell = "rbxassetid://6031154871",
		info = "rbxassetid://6026568198",
		warning = "rbxassetid://6031071053",
		error = "rbxassetid://6031094678",
		success = "rbxassetid://6031090995"
	}
	return named[value:lower()] or value
end

local XLQPToastStack = {}
local XLQPToastCounter = 0
local XLQPToastMaxVisible = 5

local function XLQPToastLooksLikeAvatar(value)
	local text = tostring(value or ""):lower()
	return text:find("rbxthumb", 1, true) ~= nil or text:find("headshot", 1, true) ~= nil or text:find("thumbnail", 1, true) ~= nil
end

local function XLQPToastAvatarAsset(value)
	local text = tostring(value or "")
	if typeof(value) == "number" or text:match("^%d+$") then
		return "rbxthumb://type=AvatarHeadShot&id=" .. text .. "&w=150&h=150"
	end
	return text
end

local function XLQPToastTextBounds(text, size, font, width)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(width, 4000))
	end)
	if ok and typeof(bounds) == "Vector2" then return bounds end
	return Vector2.new(width, size + 3)
end

function XLQPGen1:MakeToast(ToastConfig)
	if self._SetupPresentationLock==true or self._SetupFlowOpen==true then return nil end
	ensureNotificationLayer()
	ToastConfig = type(ToastConfig) == "table" and ToastConfig or {Title=tostring(ToastConfig or "Toast")}
	local titleText = tostring(ToastConfig.Title or ToastConfig.Name or ToastConfig.Text or "Notification")
	local contentText = tostring(ToastConfig.Content or ToastConfig.Description or "")
	local duration = math.max(0.8, tonumber(ToastConfig.Time or ToastConfig.Duration) or 3)
	local sticky = ToastConfig.Sticky == true or duration >= 1e6
	local variant = tostring(ToastConfig.Variant or ToastConfig.Type or "Default"):lower()
	local colors = {success=Color3.fromRGB(64,222,138),warning=Color3.fromRGB(255,190,80),error=Color3.fromRGB(255,94,108),info=Color3.fromRGB(96,152,255),default=Color3.fromRGB(139,158,255)}
	local accent = typeof(ToastConfig.Color)=="Color3" and ToastConfig.Color or colors[variant] or colors.default

	local avatarValue = ToastConfig.Avatar or ToastConfig.Thumbnail or ToastConfig.Headshot
	local rawIcon = avatarValue or ToastConfig.Image or ToastConfig.Icon or (variant=="success" and "success" or variant=="warning" and "warning" or variant=="error" and "error" or "info")
	local isAvatar = avatarValue ~= nil or XLQPToastLooksLikeAvatar(rawIcon)
	local iconAsset = isAvatar and XLQPToastAvatarAsset(rawIcon) or normalizeIconAsset(rawIcon)
	local showIcon = ToastConfig.Icon ~= false and ToastConfig.Image ~= false and ToastConfig.Avatar ~= false

	local hasContent = contentText ~= ""
	local hasAction = type(ToastConfig.Action) == "table" or type(ToastConfig.Callback) == "function"
	local closable = ToastConfig.Closable ~= false

	local holderWidth = ToastHolder.AbsoluteSize.X
	local toastWidth = math.clamp(holderWidth > 40 and math.floor(holderWidth) or 332, 260, 360)
	local padL, padR, padT, padB = 13, 11, 11, 12
	local iconBox = showIcon and (isAvatar and 36 or 32) or 0
	local textLeft = padL + (iconBox > 0 and iconBox + 11 or 0)
	local actionWidth = hasAction and 74 or 0
	local rightReserve = padR + (closable and 24 or 0) + (hasAction and actionWidth + 8 or 0)
	local textWidth = math.max(70, toastWidth - textLeft - rightReserve)
	local titleHeight = 17
	local contentHeight = 0
	if hasContent then
		local bounds = XLQPToastTextBounds(contentText, 12, Enum.Font.Gotham, textWidth)
		contentHeight = math.clamp(math.ceil(bounds.Y), 14, 56)
	end
	local height = math.max(hasContent and 64 or 52, padT + titleHeight + (hasContent and contentHeight + 3 or 0) + padB)

	for i = #XLQPToastStack, 1, -1 do
		local existing = XLQPToastStack[i]
		if not existing or existing.Closed or not existing.Frame or not existing.Frame.Parent then
			table.remove(XLQPToastStack, i)
		end
	end
	while #XLQPToastStack >= XLQPToastMaxVisible do
		local oldest = table.remove(XLQPToastStack, 1)
		if oldest and not oldest.Closed then pcall(function() oldest:Close("overflow") end) end
	end

	XLQPToastCounter = XLQPToastCounter + 1
	local toastScale = Create("UIScale", {Scale=0.94})
	local toastStroke = Create("UIStroke", {Color=accent,Thickness=1,Transparency=1})
	local toast = AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(13,14,19), 0, 13), {
		Name="XLQPToast",Size=UDim2.new(1,0,0,0),BackgroundTransparency=1,Parent=ToastHolder,ZIndex=2501,ClipsDescendants=true,LayoutOrder=XLQPToastCounter
	}), {
		toastScale,toastStroke
	}), "Main")
	toast:SetAttribute("NoLiquidGlass", true)

	local rail = Create("Frame", {Name="Rail",Size=UDim2.new(0,3,1,0),Position=UDim2.new(0,0,0,0),BackgroundColor3=accent,BackgroundTransparency=1,BorderSizePixel=0,ZIndex=2502,Parent=toast})
	local wash = Create("Frame", {Name="Wash",Size=UDim2.new(0,132,1,0),Position=UDim2.new(0,0,0,0),BackgroundColor3=accent,BackgroundTransparency=1,BorderSizePixel=0,ZIndex=2501,Parent=toast})
	Create("UIGradient", {Rotation=0,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}),Parent=wash})

	local iconFrame, iconImage
	if showIcon then
		iconFrame = SetProps(MakeElement("RoundFrame", accent, isAvatar and 1 or 0, isAvatar and 0 or 10), {
			Name="Icon",Size=UDim2.new(0,iconBox,0,iconBox),BackgroundTransparency=1,ZIndex=2502,Parent=toast,ClipsDescendants=true
		})
		if hasContent then
			iconFrame.Position = UDim2.new(0,padL,0,padT-1)
		else
			iconFrame.AnchorPoint = Vector2.new(0,0.5)
			iconFrame.Position = UDim2.new(0,padL,0.5,-1)
		end
		if isAvatar then
			iconImage = Create("ImageLabel", {Name="Avatar",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ImageTransparency=1,ScaleType=Enum.ScaleType.Crop,ZIndex=2503,Parent=iconFrame})
			Create("UICorner", {CornerRadius=UDim.new(1,0),Parent=iconImage})
			Create("UIStroke", {Color=accent,Thickness=1.4,Transparency=0.45,Parent=iconFrame})
			pcall(XLQPSetSecureAsset, iconImage, "Image", iconAsset, true)
		else
			iconImage = Create("ImageLabel", {Name="Glyph",Size=UDim2.new(0,17,0,17),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),BackgroundTransparency=1,ImageColor3=accent,ImageTransparency=1,ZIndex=2503,Parent=iconFrame})
			pcall(XLQPSetSecureAsset, iconImage, "Image", iconAsset, false)
		end
	end

	local title = Create("TextLabel", {Name="Title",Size=UDim2.new(0,textWidth,0,titleHeight),BackgroundTransparency=1,Text=titleText,TextColor3=Color3.fromRGB(244,246,252),TextTransparency=1,TextSize=13,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=2503,Parent=toast})
	if hasContent then
		title.Position = UDim2.new(0,textLeft,0,padT)
	else
		title.AnchorPoint = Vector2.new(0,0.5)
		title.Position = UDim2.new(0,textLeft,0.5,-1)
	end

	local content
	if hasContent then
		content = Create("TextLabel", {Name="Content",Size=UDim2.new(0,textWidth,0,contentHeight),Position=UDim2.new(0,textLeft,0,padT+titleHeight+3),BackgroundTransparency=1,Text=contentText,TextColor3=Color3.fromRGB(170,177,196),TextTransparency=1,TextSize=12,Font=Enum.Font.Gotham,LineHeight=1.12,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,TextWrapped=true,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=2503,Parent=toast})
	end

	local progressBack = Create("Frame", {Name="ProgressBack",Size=UDim2.new(1,0,0,2),Position=UDim2.new(0,0,1,-2),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=1,BorderSizePixel=0,ZIndex=2503,Parent=toast})
	local progress = Create("Frame", {Name="Progress",Size=UDim2.fromScale(1,1),BackgroundColor3=accent,BackgroundTransparency=1,BorderSizePixel=0,ZIndex=2504,Parent=progressBack})
	local showProgress = ToastConfig.Progress ~= false and not sticky

	local controller = {Frame=toast,Closed=false,OnClose=CreateXLQPSignal(),Title=title,Content=content,Progress=progress,Accent=accent,Paused=false}
	table.insert(XLQPToastStack, controller)

	function controller:SetTitle(value) title.Text = tostring(value or "") return self end
	function controller:SetContent(value) if content then content.Text = tostring(value or "") end return self end
	function controller:SetProgress(value) progress.Size = UDim2.fromScale(math.clamp(tonumber(value) or 0,0,1),1) return self end
	function controller:IsVisible() return toast and toast.Parent ~= nil and not self.Closed end
	function controller:Pause() self.Paused = true return self end
	function controller:Resume() self.Paused = false return self end
	function controller:Close(reason)
		if self.Closed then return self end
		self.Closed = true
		for i = #XLQPToastStack, 1, -1 do
			if XLQPToastStack[i] == self then table.remove(XLQPToastStack, i) end
		end
		self.OnClose:Fire(reason or "closed", self)
		if toast and toast.Parent then
			local out = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			TweenService:Create(toast, out, {Size=UDim2.new(1,0,0,0),BackgroundTransparency=1}):Play()
			TweenService:Create(toastScale, out, {Scale=0.92}):Play()
			TweenService:Create(toastStroke, out, {Transparency=1}):Play()
			if title then TweenService:Create(title, out, {TextTransparency=1}):Play() end
			if content then TweenService:Create(content, out, {TextTransparency=1}):Play() end
			if iconImage then TweenService:Create(iconImage, out, {ImageTransparency=1}):Play() end
			if iconFrame then TweenService:Create(iconFrame, out, {BackgroundTransparency=1}):Play() end
			TweenService:Create(rail, out, {BackgroundTransparency=1}):Play()
			TweenService:Create(wash, out, {BackgroundTransparency=1}):Play()
			TweenService:Create(progressBack, out, {BackgroundTransparency=1}):Play()
			TweenService:Create(progress, out, {BackgroundTransparency=1}):Play()
			task.delay(0.2, function() if toast and toast.Parent then toast:Destroy() end end)
		end
		return self
	end
	controller.Destroy = controller.Close

	if closable then
		local close = Create("TextButton", {Name="Close",Size=UDim2.new(0,22,0,22),Position=UDim2.new(1,-(padR+22),0,padT-3),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=1,Text="\u{2715}",TextColor3=Color3.fromRGB(150,156,174),TextTransparency=1,TextSize=11,Font=Enum.Font.GothamBold,AutoButtonColor=false,ZIndex=2505,Parent=toast})
		Create("UICorner", {CornerRadius=UDim.new(1,0),Parent=close})
		if not hasContent then
			close.AnchorPoint = Vector2.new(0,0.5)
			close.Position = UDim2.new(1,-(padR+22),0.5,-1)
		end
		close.MouseEnter:Connect(function()
			TweenService:Create(close, TweenInfo.new(0.12), {BackgroundTransparency=0.88,TextColor3=Color3.fromRGB(238,240,248)}):Play()
		end)
		close.MouseLeave:Connect(function()
			TweenService:Create(close, TweenInfo.new(0.12), {BackgroundTransparency=1,TextColor3=Color3.fromRGB(150,156,174)}):Play()
		end)
		close.Activated:Connect(function() controller:Close("manual") end)
		controller.CloseButton = close
	end

	local actionLabel
	if hasAction then
		local actionConfig = type(ToastConfig.Action)=="table" and ToastConfig.Action or {Text=ToastConfig.ActionText or "Open",Callback=ToastConfig.Callback}
		local action = SetChildren(SetProps(MakeElement("Button"), {
			Name="Action",Size=UDim2.new(0,actionWidth,0,28),AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-(padR+(closable and 26 or 0)),0.5,-1),BackgroundColor3=accent,BackgroundTransparency=0.86,ZIndex=2505,Parent=toast
		}), {
			Create("UICorner", {CornerRadius=UDim.new(0,8)}),
			Create("UIStroke", {Color=accent,Thickness=1,Transparency=0.55})
		})
		actionLabel = Create("TextLabel", {Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=tostring(actionConfig.Text or actionConfig.Name or "Open"),TextColor3=accent,TextTransparency=1,TextSize=11,Font=Enum.Font.GothamBold,ZIndex=2506,Parent=action})
		action.MouseEnter:Connect(function() TweenService:Create(action, TweenInfo.new(0.12), {BackgroundTransparency=0.72}):Play() end)
		action.MouseLeave:Connect(function() TweenService:Create(action, TweenInfo.new(0.12), {BackgroundTransparency=0.86}):Play() end)
		action.Activated:Connect(function()
			SafeCallback(actionConfig.Callback, "Toast Action", controller)
			if actionConfig.Close ~= false then controller:Close("action") end
		end)
		controller.ActionButton = action
	end

	if ToastConfig.ClickToClose == true then
		local hit = Create("TextButton", {Name="Hit",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",AutoButtonColor=false,ZIndex=2502,Parent=toast})
		hit.Activated:Connect(function() controller:Close("clicked") end)
	end

	toast.MouseEnter:Connect(function()
		controller.Paused = true
		TweenService:Create(toastStroke, TweenInfo.new(0.14), {Transparency=0.34}):Play()
		TweenService:Create(toastScale, TweenInfo.new(0.14, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Scale=1.015}):Play()
	end)
	toast.MouseLeave:Connect(function()
		controller.Paused = false
		TweenService:Create(toastStroke, TweenInfo.new(0.14), {Transparency=0.62}):Play()
		TweenService:Create(toastScale, TweenInfo.new(0.14, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Scale=1}):Play()
	end)

	local into = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(toast, into, {Size=UDim2.new(1,0,0,height),BackgroundTransparency=0.02}):Play()
	TweenService:Create(toastScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1}):Play()
	TweenService:Create(toastStroke, into, {Transparency=0.62}):Play()
	TweenService:Create(rail, into, {BackgroundTransparency=0.05}):Play()
	TweenService:Create(wash, into, {BackgroundTransparency=0.9}):Play()
	if iconFrame then TweenService:Create(iconFrame, into, {BackgroundTransparency=isAvatar and 0.6 or 0.86}):Play() end
	if iconImage then TweenService:Create(iconImage, into, {ImageTransparency=0}):Play() end
	TweenService:Create(title, into, {TextTransparency=0}):Play()
	if content then TweenService:Create(content, into, {TextTransparency=0}):Play() end
	if actionLabel then TweenService:Create(actionLabel, into, {TextTransparency=0}):Play() end
	if showProgress then
		TweenService:Create(progressBack, into, {BackgroundTransparency=0.9}):Play()
		TweenService:Create(progress, into, {BackgroundTransparency=0.1}):Play()
	else
		progressBack.Visible = false
	end

	if not sticky then
		local remaining = duration
		task.spawn(function()
			local connection
			connection = RunService.Heartbeat:Connect(function(delta)
				if controller.Closed or not toast or not toast.Parent then
					connection:Disconnect()
					return
				end
				if controller.Paused then return end
				remaining = remaining - delta
				if showProgress then
					progress.Size = UDim2.fromScale(math.clamp(remaining/duration,0,1),1)
				end
				if remaining <= 0 then
					connection:Disconnect()
					controller:Close("timeout")
				end
			end)
		end)
	end

	return controller
end
