    function Dropdown:GetSelectedPlayers()
        local selected = {}
        local selectedSeen = {}
        for key, meta in pairs(self.PlayerMeta or {}) do
            if self.SelectedValues and (self.SelectedValues[key] or (meta.UserId and self.SelectedValues[tostring(meta.UserId)])) then
                local metaKey = tostring(meta.UserId or meta.Username or meta.Name or key)
                if not selectedSeen[metaKey] then
                    selectedSeen[metaKey]=true
                    if self.PVP then
                        pvpTarget=nil
                        if meta.UserId then pcall(function() pvpTarget=game:GetService("Players"):GetPlayerByUserId(tonumber(meta.UserId)) end) end
                        if not pvpTarget and meta.Username then pvpTarget=game:GetService("Players"):FindFirstChild(tostring(meta.Username)) end
                        if pvpTarget and XLQPGen1:IsPlayerPVPReady(pvpTarget) then table.insert(selected, meta) end
                    else
                        table.insert(selected, meta)
                    end
                end
            end
        end
        return selected
    end

    function Dropdown:GetWhitelist()
        local whitelist = {}
        if not self.Whitelist then return whitelist end
        for _, meta in ipairs(self:GetSelectedPlayers()) do
            if meta.UserId then whitelist[tostring(meta.UserId)] = true end
            if meta.Username then whitelist[meta.Username] = true end
            if meta.Name then whitelist[meta.Name] = true end
        end
        return whitelist
    end

    function Dropdown:RefreshWhitelist()
        if self.Whitelist then
            XLQPGen1.PlayerWhitelists[self.Name] = self:GetWhitelist()
        end
    end

    function Dropdown:IsWhitelisted(player)
        local map = self:GetWhitelist()
        local id = typeof(player) == "Instance" and player.UserId or tonumber(player)
        local name = typeof(player) == "Instance" and player.Name or tostring(player or "")
        return (id and map[tostring(id)] == true) or map[name] == true
    end

    function Dropdown:GetSelected()
        if not self.MultiSelect then
            return self.Value
        end
        local selected = {}
        for key, value in pairs(self.SelectedValues or {}) do
            if value and not tonumber(key) then
                table.insert(selected, key)
            end
        end
        table.sort(selected)
        return selected
    end

    function Dropdown:Clear(silent)
        if self.MultiSelect then
            self:Set({}, silent == true)
        else
            self.Value = ""
            if DropdownFrame and DropdownFrame.F and DropdownFrame.F.Selected then
                DropdownFrame.F.Selected.Text = "Select option"
            end
            for _, optButton in pairs(self.Buttons or {}) do
                if optButton then
                    local stroke = optButton:FindFirstChild("SelectionStroke")
                    local title = optButton:FindFirstChild("Title")
                    local checkmark = optButton:FindFirstChild("Checkmark")
                    if stroke then
                        stroke.Enabled = false
                        stroke.Transparency = 1
                    end
                    if title then title.TextTransparency = 0.4 end
                    if checkmark then checkmark.ImageTransparency = 1 end
                    optButton.BackgroundColor3 = XLQPGen1.Themes.Default.Main
                    optButton.BackgroundTransparency = 1
                end
            end
            if not silent then
                SafeCallback(DropdownConfig.Callback, DropdownConfig.Name or "Dropdown", "")
                self:_EmitChanged("")
            end
        end
        if XLQPGen1.SaveCfg and DropdownConfig.Save and not silent then pcall(SaveCfg, game.GameId) end
        return self
    end

    function Dropdown:GetBulkSelectableNames(visibleOnly)
        local names = {}
        local seen = {}
        for name, button in pairs(self.Buttons or {}) do
            if button and button.Parent and (not visibleOnly or button.Visible) then
                local key = tostring(name)
                if key ~= "" and not seen[key] then
                    seen[key] = true
                    names[#names + 1] = key
                end
            end
        end
        table.sort(names)
        return names
    end

    function Dropdown:SelectAll(silent)
        local visibleOnly = searchBox and searchBox.Text ~= ""
        local values = self:GetBulkSelectableNames(visibleOnly)
        if self.MultiSelect then
            self:Set(values, silent == true)
        elseif #values > 0 then
            self:Set(values[1], silent == true)
        end
        if XLQPGen1.SaveCfg and DropdownConfig.Save and not silent then pcall(SaveCfg, game.GameId) end
        return self
    end

