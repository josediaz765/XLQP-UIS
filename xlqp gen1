		end
		self:RefreshEditableElements()
		self:_SyncEditablePinManager()
	end

	function XLQPGen1:InstallMoveableElement(Frame, Config, ReturnedObject, ItemParent)
		if typeof(Frame) ~= "Instance" or not Frame:IsA("GuiObject") then return end
		local moveContainer = self:GetMoveableContainer(ItemParent)
		if not moveContainer or Frame:GetAttribute("__XLQPGen1MoveableInstalled") == true then return end
		self:RegisterEditableContainer(moveContainer)
		ReturnedObject = type(ReturnedObject) == "table" and ReturnedObject or {}
		local configMoveable = Config and (Config.Moveable == true or Config.moveable == true or Config.Movable == true or Config.movable == true)
		local editableAllElements = WindowConfig and WindowConfig.EditableAllElements == true
		if not configMoveable and not editableAllElements then
			ReturnedObject.Moveable = false
			function ReturnedObject:SetMoveable(Value)
				self.Moveable = Value == true
				Frame:SetAttribute("__XLQPGen1MoveableConfig", Value == true)
				if Value == true and XLQPGen1 and XLQPGen1.InstallMoveableElement then
					XLQPGen1:InstallMoveableElement(Frame, {Name = tostring(Config and (Config.Name or Config.Title or Config.Text) or Frame.Name or "Element"), Moveable = true}, self, ItemParent)
				end
			end
			return
		end
		Frame:SetAttribute("__XLQPGen1MoveableInstalled", true)
		Frame:SetAttribute("__XLQPGen1MoveableFrame", true)
		Frame:SetAttribute("__XLQPGen1MoveableConfig", configMoveable == true)
		Frame:SetAttribute("__XLQPGen1MoveableName", tostring(Config and (Config.Name or Config.Title or Config.Text) or Frame.Name or "Element"))
		ReturnedObject.Moveable = configMoveable == true
		self.MoveableElements = self.MoveableElements or {}
		self._MoveableOrigins = self._MoveableOrigins or setmetatable({}, {__mode = "k"})
		if not self._MoveableOrigins[Frame] then
			local originIndex = 1
			for _, sibling in ipairs(moveContainer:GetChildren()) do
				if sibling ~= Frame and sibling:IsA("GuiObject") and sibling:GetAttribute("__XLQPGen1MoveableFrame") == true then originIndex += 1 end
			end
			local anchor = Instance.new("Frame")
			anchor.Name = "MoveableOriginAnchor"
			anchor.Size = UDim2.fromOffset(0,0)
			anchor.BackgroundTransparency = 1
			anchor.BorderSizePixel = 0
			anchor.Visible = false
			anchor.LayoutOrder = Frame.LayoutOrder
			anchor:SetAttribute("ProtectedMoveDrop",true)
			anchor.Parent = moveContainer
			self._MoveableOrigins[Frame] = {
				Parent = moveContainer,
				Anchor = anchor,
				Key = self:GetMoveableContainerKey(moveContainer),
				LayoutOrder = Frame.LayoutOrder,
				Size = Frame.Size,
				Position = Frame.Position,
				AnchorPoint = Frame.AnchorPoint,
				AutomaticSize = Frame.AutomaticSize,
				Visible = Frame.Visible,
				Index = originIndex
			}
			Frame:SetAttribute("__XLQPGen1MoveOriginKey",self:GetMoveableContainerKey(moveContainer) or "")
			Frame:SetAttribute("__XLQPGen1MoveCurrentKey",self:GetMoveableContainerKey(moveContainer) or "")
		end
		self._EditableDragStarters = self._EditableDragStarters or setmetatable({}, {__mode = "k"})
		table.insert(self.MoveableElements, Frame)
		task.defer(function() if XLQPGen1 and XLQPGen1._SyncEditablePinManager then XLQPGen1:_SyncEditablePinManager() end end)
		local Overlay = Create("TextButton", {
			Name = "MoveableEditOverlay",
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			Active = false,
			Selectable = false,
			Visible = false,
			ZIndex = 0,
			Parent = Frame
		})
		Overlay:SetAttribute("NoLiquidGlass", true)
		local dragging = false
		local pending = false
		local activeInput
		local pressPosition
		local lastPosition
		local ghost
		local lastTarget
		local targetStroke
		local dragToken = 0
		local userInputService = game:GetService("UserInputService")
		local function clearTarget()
			lastTarget = nil
			if targetStroke and targetStroke.Parent then targetStroke:Destroy() end
			targetStroke = nil
		end
		local function cleanupDrag()
			dragging = false
			pending = false
			activeInput = nil
			pressPosition = nil
			clearTarget()
			if ghost and ghost.Parent then ghost:Destroy() end
			ghost = nil
		end
		local function showTarget(target)
			if target == lastTarget then return end
			clearTarget()
			lastTarget = target
			if target and target:IsA("GuiObject") then
				targetStroke = Instance.new("UIStroke")
				targetStroke.Name = "MoveableTargetStroke"
				targetStroke.Color = Color3.fromRGB(75, 170, 255)
				targetStroke.Thickness = 2
				targetStroke.Transparency = 0.08
				targetStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				targetStroke.Parent = target
			end
		end
