function XLQPGen1:_ResolveDecorationAsset(value,callback)
	value=tostring(value or "")
	if self.DecorationImages[value:lower()] then value=self.DecorationImages[value:lower()] end
	if value=="" then return "" end
	if value:match("^rbxasset") or value:match("^content://") or value:match("^synasset://") then return value end
	if tonumber(value) then return "rbxassetid://"..value end
	if not value:match("^https?://") then return normalizeIconAsset(value) end
	if self._DecorationAssetCache[value] then return self._DecorationAssetCache[value] end
	self._DecorationAssetPending[value]=self._DecorationAssetPending[value] or {}
	if type(callback)=="function" then
		table.insert(self._DecorationAssetPending[value],callback)
	end
	if #self._DecorationAssetPending[value]>1 then return "" end
	if type(writefile)~="function" or type(isfile)~="function" or type(makefolder)~="function" or type(isfolder)~="function" or type(getcustomasset or getsynasset)~="function" then return "" end
	task.spawn(function()
		pcall(function() if not isfolder("XLQPGen1") then makefolder("XLQPGen1") end end)
		pcall(function() if not isfolder("XLQPGen1/decorations") then makefolder("XLQPGen1/decorations") end end)
		local hash=5381
		for index=1,#value do hash=(hash*33+value:byte(index))%4294967296 end
		local extension=value:lower():find("%.jpe?g") and ".jpg" or ".png"
		local path="XLQPGen1/decorations/"..string.format("%08x",math.floor(hash))..extension
		local ready=false
		pcall(function() ready=isfile(path) end)
		if not ready then
			local body=XLQPSecureHttpGet(value)
			if XLQPIsImageBody(body) then ready=pcall(writefile,path,body) end
		end
		local asset=""
		if ready then pcall(function() asset=(getcustomasset or getsynasset)(path) end) end
		if asset~="" then self._DecorationAssetCache[value]=asset end
		local pending=self._DecorationAssetPending[value] or {}
		self._DecorationAssetPending[value]=nil
		for _,listener in ipairs(pending) do pcall(listener,asset) end
	end)
	return ""
end

function XLQPGen1:_ApplyDecorationAsset(image,asset)
	if not image or not image.Parent or asset==nil then return false end
	if type(asset)=="string" then
		if asset=="" then return false end
		return pcall(function() image.Image=asset end)
	end
	if typeof(asset)=="Instance" then
		return pcall(function() image.ImageContent=Content.fromObject(asset) end)
	end
	return false
end

function XLQPGen1:_AttachDecorations(target)
	if self._DecorationController and self._DecorationController.Destroy then self._DecorationController:Destroy() end
	if not target or not target.Parent or not self._RootGui then return nil end
	local controller={Library=self,Target=target,Slots={},Designs={},Connections={},Animated={},Clock=0}
	local layer=Instance.new("Frame")
	layer.Name="XLQPWindowDecorations"
	layer.BackgroundTransparency=1
	layer.BorderSizePixel=0
	layer.Size=UDim2.fromScale(1,1)
	layer.Position=UDim2.fromScale(0,0)
	layer.ClipsDescendants=false
	layer.Active=false
	layer.ZIndex=26000
	layer.Parent=self._RootGui
	controller.Layer=layer
	function controller:Clear()
		for _,slot in ipairs(self.Slots) do if slot.Frame and slot.Frame.Parent then slot.Frame:Destroy() end end
		for _,design in ipairs(self.Designs) do if design.Frame and design.Frame.Parent then design.Frame:Destroy() end end
		table.clear(self.Slots)
		table.clear(self.Designs)
		table.clear(self.Animated)
		self.Signature=nil
	end
	function controller:PlayEntrance()
		if self.Library.WindowDesignsEnabled~=true then return end
		if self.Library.WindowDesignEntrance==false then return end
		self.EntranceToken=(tonumber(self.EntranceToken) or 0)+1
		local token=self.EntranceToken
		self.EntranceUntil=os.clock()+0.78
		local order=0
		local entranceBudget=tonumber(self.Library.WindowDesignEntranceBudget) or 26
		for _,design in ipairs(self.Designs) do
			local root=design.Frame
			if root and root.Parent then
				order+=1
				if order>entranceBudget then break end
				local wait=math.min(order*0.014,0.36)
				local pieces={}
				local function collect(object)
					if object:IsA("Frame") and object.BackgroundTransparency<1 then
						pieces[#pieces+1]={Object=object,Property="BackgroundTransparency",Value=object.BackgroundTransparency}
					elseif object:IsA("UIStroke") and object.Transparency<1 then
						pieces[#pieces+1]={Object=object,Property="Transparency",Value=object.Transparency}
					end
				end
				collect(root)
				for _,child in ipairs(root:GetDescendants()) do collect(child) end
				for _,piece in ipairs(pieces) do
					piece.Object[piece.Property]=1
				end
				task.delay(wait,function()
					if self.EntranceToken~=token then return end
					for _,piece in ipairs(pieces) do
						if piece.Object.Parent then
							TweenService:Create(piece.Object,TweenInfo.new(0.34,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{[piece.Property]=piece.Value}):Play()
						end
					end
				end)
			end
		end
	end
	function controller:Animate(delta)
		if #self.Animated==0 then return end
		if self.Library.WindowDesignsEnabled~=true then return end
		if not self.Layer or not self.Layer.Visible then return end
		if (tonumber(self.EntranceUntil) or 0)>os.clock() then return end
		self.Clock+=delta
		local clock=self.Clock
		for _,entry in ipairs(self.Animated) do
			local object=entry.Object
			if object and object.Parent then
				local phase=clock*(entry.Speed or 1)+(entry.Phase or 0)
				if entry.Mode=="spin" then
					object.Rotation=(entry.Base or 0)+phase*60%360
				elseif entry.Mode=="drift" then
					object.Offset=Vector2.new((math.sin(phase)*0.5),0)
				elseif entry.Mode=="breathe" then
					object.BackgroundTransparency=math.clamp((entry.Base or 0.88)+math.sin(phase)*(entry.Amount or 0.06),0,1)
				elseif entry.Mode=="shimmer" then
					object.BackgroundTransparency=math.clamp((entry.Base or 0.1)+((math.sin(phase)+1)*0.5)*(entry.Amount or 0.5),0,1)
				elseif entry.Mode=="pulse" then
					object.Transparency=math.clamp((entry.Base or 0.3)+math.sin(phase)*(entry.Amount or 0.2),0,1)
				end
			end
		end
	end
	function controller:Sync()
		if not self.Target or not self.Target.Parent then return end
		local anyEnabled=self.Library.DecorationsEnabled==true or self.Library.WindowDesignsEnabled==true
		local layerVisible=anyEnabled and self.Target.Visible
		if self.Layer.Visible~=layerVisible then self.Layer.Visible=layerVisible end
		if not layerVisible then return end
		local position=self.Target.AbsolutePosition
		local bounds=self.Target.AbsoluteSize
		local signature=string.format("%d:%d:%d:%d:%s:%s",position.X,position.Y,bounds.X,bounds.Y,tostring(self.Library.WindowDesignsEnabled==true),tostring(self.Library.DecorationsEnabled==true))
		if self.Signature==signature then return end
		self.Signature=signature
		local centerX=position.X+bounds.X*0.5
		local centerY=position.Y+bounds.Y*0.5
		local designsOn=self.Library.WindowDesignsEnabled==true
		for _,design in ipairs(self.Designs) do
			local frame=design.Frame
			if frame.Visible~=designsOn then frame.Visible=designsOn end
			if not designsOn then continue end
			if design.Kind=="Outline" then
				local padding=design.Padding or 24
				frame.Size=UDim2.fromOffset(bounds.X+padding*2,bounds.Y+padding*2)
				frame.Position=UDim2.fromOffset(math.floor(centerX+0.5),math.floor(centerY+0.5))
			elseif design.Kind=="Rail" then
				local side=design.Side or 1
				frame.Size=UDim2.fromOffset(design.Width or 5,math.max(24,math.floor(bounds.Y*(design.HeightScale or 0.6))))
				frame.Position=UDim2.fromOffset(math.floor(centerX+side*(bounds.X*0.5+(design.Offset or 26))+0.5),math.floor(centerY+0.5))
			elseif design.Kind=="Corner" then
				local signX=design.SignX or 1
				local signY=design.SignY or 1
				local offset=design.Offset or 14
				local arm=design.Arm or 32
				frame.Position=UDim2.fromOffset(
					math.floor(centerX+signX*(bounds.X*0.5+offset-arm*0.5)+0.5),
					math.floor(centerY+signY*(bounds.Y*0.5+offset-arm*0.5)+0.5)
				)
			elseif design.Kind=="Wing" then
				local side=design.Side or 1
				local level=design.Level or 1
				frame.Position=UDim2.fromOffset(
					math.floor(centerX+side*(bounds.X*0.5+(design.Offset or 30))+0.5),
					math.floor(centerY+level*bounds.Y*0.32+0.5)
				)
			elseif design.Kind=="Blade" then
				local side=design.Side or 1
				local level=design.Level or 0
				frame.Position=UDim2.fromOffset(math.floor(centerX+side*(bounds.X*0.5+34)+0.5),math.floor(centerY+level*bounds.Y*0.28+0.5))
			elseif design.Kind=="Aura" then
				local padding=design.Padding or 80
				frame.Size=UDim2.fromOffset(bounds.X+padding*2,bounds.Y+padding*2)
				frame.Position=UDim2.fromOffset(math.floor(centerX+0.5),math.floor(centerY+0.5))
			elseif design.Kind=="Cross" then
				local place=design.Place or "Top"
				local offset=design.Offset or 38
				local halfX=bounds.X*0.5
				local halfY=bounds.Y*0.5
				local x=centerX
				local y=centerY
				if place=="Top" then y=centerY-halfY-offset
				elseif place=="Bottom" then y=centerY+halfY+offset
				elseif place=="Left" then x=centerX-halfX-offset
				elseif place=="Right" then x=centerX+halfX+offset
				elseif place=="TopLeft" then x=centerX-halfX-offset*0.62 y=centerY-halfY-offset*0.62
				elseif place=="TopRight" then x=centerX+halfX+offset*0.62 y=centerY-halfY-offset*0.62
				elseif place=="BottomLeft" then x=centerX-halfX-offset*0.62 y=centerY+halfY+offset*0.62
				elseif place=="BottomRight" then x=centerX+halfX+offset*0.62 y=centerY+halfY+offset*0.62 end
				frame.Position=UDim2.fromOffset(math.floor(x+0.5),math.floor(y+0.5))
			elseif design.Kind=="Stud" then
				local edge=design.Edge or "Top"
				local offset=design.Offset or 26
				local ratio=math.clamp(tonumber(design.Ratio) or 0.5,0,1)
				local x=centerX
				local y=centerY
				if edge=="Top" or edge=="Bottom" then
					x=position.X+bounds.X*0.16+bounds.X*0.68*ratio
					y=edge=="Top" and (centerY-bounds.Y*0.5-offset) or (centerY+bounds.Y*0.5+offset)
				else
					y=position.Y+bounds.Y*0.2+bounds.Y*0.6*ratio
					x=edge=="Left" and (centerX-bounds.X*0.5-offset) or (centerX+bounds.X*0.5+offset)
				end
				frame.Position=UDim2.fromOffset(math.floor(x+0.5),math.floor(y+0.5))
			elseif design.Kind=="Ring" then
				local signX=design.SignX or 1
				local signY=design.SignY or 1
				local offset=design.Offset or 8
				frame.Position=UDim2.fromOffset(
					math.floor(centerX+signX*(bounds.X*0.5+offset)+0.5),
					math.floor(centerY+signY*(bounds.Y*0.5+offset)+0.5)
				)
			elseif design.Kind=="Beam" then
				local edge=design.Edge or "Top"
				local offset=design.Offset or 16
				local inset=design.Inset or 0.12
				frame.Size=UDim2.fromOffset(math.max(24,math.floor(bounds.X*(1-inset*2))),frame.Size.Y.Offset)
				frame.Position=UDim2.fromOffset(
					math.floor(centerX+0.5),
					math.floor(edge=="Top" and (centerY-bounds.Y*0.5-offset) or (centerY+bounds.Y*0.5+offset))
				)
			elseif design.Kind=="Tick" then
				local edge=design.Edge or "Top"
				local offset=design.Offset or 14
				local ratio=math.clamp(tonumber(design.Ratio) or 0.5,0,1)
				local x=centerX
				local y=centerY
				if edge=="Top" or edge=="Bottom" then
					x=position.X+bounds.X*0.1+bounds.X*0.8*ratio
					y=edge=="Top" and (centerY-bounds.Y*0.5-offset) or (centerY+bounds.Y*0.5+offset)
				else
					y=position.Y+bounds.Y*0.12+bounds.Y*0.76*ratio
					x=edge=="Left" and (centerX-bounds.X*0.5-offset) or (centerX+bounds.X*0.5+offset)
				end
				frame.Position=UDim2.fromOffset(math.floor(x+0.5),math.floor(y+0.5))
			end
		end
		for _,slot in ipairs(self.Slots) do
			slot.Frame.Visible=self.Library.DecorationsEnabled==true
			local spec=slot.Spec
			local size=slot.Size
			local corner=tostring(spec.Corner or "TopRight")
			local x=position.X+bounds.X*0.5
			local y=position.Y+bounds.Y*0.5
			if corner=="TopLeft" then x=position.X-size*0.12 y=position.Y-size*0.12
			elseif corner=="TopRight" then x=position.X+bounds.X+size*0.12 y=position.Y-size*0.12
			elseif corner=="BottomLeft" then x=position.X-size*0.12 y=position.Y+bounds.Y+size*0.12
			elseif corner=="BottomRight" then x=position.X+bounds.X+size*0.12 y=position.Y+bounds.Y+size*0.12
			elseif corner=="Top" then y=position.Y-size*0.12
			elseif corner=="Bottom" then y=position.Y+bounds.Y+size*0.12
			elseif corner=="Left" then x=position.X-size*0.12
			elseif corner=="Right" then x=position.X+bounds.X+size*0.12 end
			x+=tonumber(spec.OffsetX) or (typeof(spec.Offset)=="Vector2" and spec.Offset.X or 0)
			y+=tonumber(spec.OffsetY) or (typeof(spec.Offset)=="Vector2" and spec.Offset.Y or 0)
			slot.Frame.Position=UDim2.fromOffset(math.floor(x+0.5),math.floor(y+0.5))
		end
	end
	function controller:Rebuild()
		self:Clear()
		local designPreset=self.Library.WindowDesignPresets[self.Library.WindowDesignStyle] or self.Library.WindowDesignPresets["Crystal Rails"]
		local theme=self.Library.Themes[self.Library.SelectedTheme] or {}
		local accent=designPreset.Accent or Color3.fromRGB(175,92,255)
		if designPreset.UseThemeAccent==true and typeof(theme.Bloom)=="Color3" then accent=theme.Bloom end
		local light=typeof(designPreset.Light)=="Color3" and designPreset.Light or accent:Lerp(Color3.new(1,1,1),0.58)
		local shade=typeof(designPreset.Shade)=="Color3" and designPreset.Shade or accent:Lerp(Color3.fromRGB(10,12,20),0.5)
		if designPreset.UseThemeAccent==true then
			light=accent:Lerp(Color3.new(1,1,1),0.6)
			shade=accent:Lerp(Color3.fromRGB(8,9,14),0.55)
		end
		local motion=designPreset.Motion~=false and self.Library.WindowDesignMotion~=false
		local animationBudget=tonumber(self.Library.WindowDesignMotionBudget) or 20
		local function animate(object,mode,speed,base,amount,phase)
			if not motion then return object end
			if #self.Animated>=animationBudget then return object end
			table.insert(self.Animated,{Object=object,Mode=mode,Speed=speed or 1,Base=base,Amount=amount,Phase=phase or 0})
			return object
		end
		local bloomSpread=designPreset.Bloom
		if bloomSpread==true then bloomSpread=10 end
		bloomSpread=tonumber(bloomSpread) or 0
		local function bloom(frame,color,round)
			if bloomSpread<=0 or not frame then return frame end
			local halo=Instance.new("Frame")
			halo.Name="Bloom"
			halo.AnchorPoint=Vector2.new(0.5,0.5)
			halo.Position=UDim2.fromScale(0.5,0.5)
			halo.Size=UDim2.new(1,bloomSpread,1,bloomSpread)
			halo.BackgroundColor3=color or accent
			halo.BackgroundTransparency=math.clamp(tonumber(designPreset.BloomTransparency) or 0.78,0,1)
			halo.BorderSizePixel=0
			halo.ZIndex=math.max(0,(tonumber(frame.ZIndex) or 1)-1)
			halo.Parent=frame
			halo:SetAttribute("NoLiquidGlass",true)
			local haloCorner=Instance.new("UICorner")
			haloCorner.CornerRadius=round==false and UDim.new(0,6) or UDim.new(1,0)
			haloCorner.Parent=halo
