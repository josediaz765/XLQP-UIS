			local metricCount=0
			local function createMetric(name)
				name=tostring(name)
				metricCount+=1
				local cell=AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame",Color3.fromRGB(255,255,255),0.16,8),{Name=name,Parent=grid}),{AddThemeObject(MakeElement("Stroke"),"Stroke")}),"Main")
				local dot=SetProps(MakeElement("RoundFrame",metricColors[name] or Color3.fromRGB(111,92,238),0,999),{Size=UDim2.fromOffset(6,6),Position=UDim2.new(0,10,0.5,-3),Parent=cell})
				local label=AddThemeObject(SetProps(MakeElement("Label",name,10),{Size=UDim2.new(0.48,-20,1,0),Position=UDim2.new(0,22,0,0),Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,BackgroundTransparency=1,Parent=cell}),"TextDark")
				local value=AddThemeObject(SetProps(MakeElement("Label","--",13),{Size=UDim2.new(0.52,-10,1,0),Position=UDim2.new(0.48,0,0,0),Font=Enum.Font.GothamBlack,TextXAlignment=Enum.TextXAlignment.Right,TextTruncate=Enum.TextTruncate.AtEnd,BackgroundTransparency=1,Parent=cell}),"Text")
				Monitor.Cells[name]={Frame=cell,Value=value,Dot=dot}
				frame.Size=UDim2.new(1,0,0,52+math.ceil(metricCount/2)*51)
			end
			for _,name in ipairs(MonitorConfig.Metrics) do createMetric(name) end
			local monitorToken=0
			function Monitor:SetMetric(name,value,color)
				name=tostring(name)
				if not self.Cells[name] then createMetric(name) end
				self.Value[name]=value
				local nextText=tostring(value==nil and "--" or value)
				if self.Cells[name].Value.Text~=nextText then self.Cells[name].Value.Text=nextText end
				if typeof(color)=="Color3" and self.Cells[name].Dot.BackgroundColor3~=color then self.Cells[name].Dot.BackgroundColor3=color end
				return self
			end
			function Monitor:Refresh()
				local shared=WindowConfig._LocalRegisterState
				local fps=tonumber(shared.fps)
				if fps then fps=tostring(math.floor(fps+0.5)) else fps="--" pcall(function() fps=tostring(math.floor(workspace:GetRealPhysicsFPS()+0.5)) end) end
				local ping=tonumber(shared.ping)
				if ping then ping=tostring(math.floor(ping+0.5)).." ms" else ping="--" pcall(function() ping=tostring(math.floor(LocalPlayer:GetNetworkPing()*1000+0.5)).." ms" end) end
				local memory="--"
				pcall(function() memory=string.format("%.0f MB",game:GetService("Stats"):GetTotalMemoryUsageMb()) end)
				local playerCount=tostring(#Players:GetPlayers())
				if self.Cells.FPS then self:SetMetric("FPS",fps) end
				if self.Cells.Ping then self:SetMetric("Ping",ping) end
				if self.Cells.Memory then self:SetMetric("Memory",memory) end
				if self.Cells.Players then self:SetMetric("Players",playerCount) end
				if type(MonitorConfig.Provider)=="function" then
					local ok,values=pcall(MonitorConfig.Provider,self)
					if ok and type(values)=="table" then for key,value in pairs(values) do self:SetMetric(key,value) end end
				end
				self:_EmitChanged(self.Value)
				return self
			end
			function Monitor:Stop()
				monitorToken+=1
				self.Running=false
				if WindowConfig._LocalRegisterState.unregisterPeriodic then WindowConfig._LocalRegisterState.unregisterPeriodic(self) end
				return self
			end
			function Monitor:Start()
				self:Stop()
				self.Running=true
				monitorToken+=1
				if WindowConfig._LocalRegisterState.registerPeriodic then
					WindowConfig._LocalRegisterState.registerPeriodic(self,MonitorConfig.Interval,function()
						if self.Running and frame.Parent then self:Refresh() end
					end,frame,false,true)
				else
					local token=monitorToken
					task.spawn(function()
						while token==monitorToken and frame.Parent do self:Refresh() task.wait(MonitorConfig.Interval) end
					end)
				end
				return self
			end
			AddConnection(frame.AncestryChanged,function(_,parent) if not parent then Monitor:Stop() end end)
			Monitor.Wrapper=frame
			table.insert(XLQPGen1.AllElements,Monitor)
			WindowConfig._LocalRegisterState.SetupElement(MonitorConfig,frame,frame,Monitor)
			if MonitorConfig.AutoStart then Monitor:Start() else Monitor:Refresh() end
			return Monitor
		end
