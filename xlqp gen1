	local pieces=string.split(translated,token)
	if translatedSuccessfully and #pieces==#missing then
		for index,piece in ipairs(pieces) do
			local clean=tostring(piece):gsub("^%s+",""):gsub("%s+$","")
			local source=missing[index]
			XLQPGen1._TranslationCache[tostring(language).."|"..source]=clean
			output[missingIndexes[index]]=clean
		end
	else
		for index,source in ipairs(missing) do output[missingIndexes[index]]=source end
	end
	return output
end
 function hasNoTranslateAncestor(obj)
	local current=obj
	while current do
		if current:GetAttribute("NoTranslate")==true then return true end
		current=current.Parent
	end
	return false
end
 function shouldTranslateTextObject(obj)
	if not obj or hasNoTranslateAncestor(obj) then return false end
	if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return false end
	local name=string.lower(tostring(obj.Name or ""))
	if name:find("code",1,true) or name:find("script",1,true) or name:find("console",1,true) or name:find("searchbox",1,true) then return false end
	return true
end
 function translateOneTextObject(obj,language)
	if not shouldTranslateTextObject(obj) then return end
	if obj:IsA("TextBox") then
		if obj.Text=="TextBox" then obj.Text="" end
		local lastPh=obj:GetAttribute("LastTranslatedPlaceholder")
		if obj:GetAttribute("OriginalPlaceholder")==nil or (lastPh and obj.PlaceholderText~=lastPh) then obj:SetAttribute("OriginalPlaceholder",obj.PlaceholderText or "") end
		local ph=obj:GetAttribute("OriginalPlaceholder") or ""
		if language=="en" then obj.PlaceholderText=ph obj:SetAttribute("LastTranslatedPlaceholder",ph) return end
		if ph~="" and not ph:find("<",1,true) then
			local translated=translateTextAsync(ph,language)
			obj.PlaceholderText=translated
			obj:SetAttribute("LastTranslatedPlaceholder",translated)
		end
	else
		local lastText=obj:GetAttribute("LastTranslatedText")
		if obj:GetAttribute("OriginalText")==nil or (lastText and obj.Text~=lastText) then obj:SetAttribute("OriginalText",obj.Text or "") end
		local original=obj:GetAttribute("OriginalText") or ""
		if language=="en" then obj.Text=original obj:SetAttribute("LastTranslatedText",original) return end
		if original~="" and not original:match("^%s*https?://") and not original:find("<",1,true) then
			local translated=translateTextAsync(original,language)
			obj.Text=translated
			obj:SetAttribute("LastTranslatedText",translated)
		end
	end
end
function XLQPGen1:SetLanguage(language)
	language=tostring(language or "en")
	local parsed=language:match("%(([^()]+)%)%s*$")
	if parsed and translatorLanguageNames[parsed] then language=parsed end
	if language=="Auto" then language=getAutoLanguageCode() end
	if not translatorLanguageNames[language] then language="en" end
	self._SelectedLanguage=language
	selectedLanguage=language
	self._TranslationGeneration=(self._TranslationGeneration or 0)+1
	local generation=self._TranslationGeneration
	if not self._TranslatorDescendantConnection and XLQPGen1Gui then
		self._TranslatorDescendantConnection=AddConnection(XLQPGen1Gui.DescendantAdded,function(obj)
			XLQPApplyTextObject(obj)
			local currentLanguage=self._SelectedLanguage or "en"
			if currentLanguage=="en" then return end
			local scheduledGeneration=self._TranslationGeneration
			task.delay(0.04,function()
				if obj and obj.Parent and scheduledGeneration==self._TranslationGeneration then translateOneTextObject(obj,currentLanguage) end
			end)
		end)
	end
	task.spawn(function()
		if not XLQPGen1Gui then return end
		local objects={}
		for object in pairs(self._TextObjectRegistry or {}) do if object and object.Parent and shouldTranslateTextObject(object) then objects[#objects+1]=object end end
		if #objects==0 then for _,object in ipairs(XLQPGen1Gui:GetDescendants()) do if shouldTranslateTextObject(object) then objects[#objects+1]=object XLQPApplyTextObject(object) end end end
		table.sort(objects,function(a,b)
			local aVisible=a.Visible and 0 or 1
			local bVisible=b.Visible and 0 or 1
			if aVisible~=bVisible then return aVisible<bVisible end
			local ay=a.AbsolutePosition.Y
			local by=b.AbsolutePosition.Y
			if ay~=by then return ay<by end
			return a.AbsolutePosition.X<b.AbsolutePosition.X
		end)
		if language=="en" then
			for index,object in ipairs(objects) do
				if generation~=self._TranslationGeneration then return end
				if object:IsA("TextBox") then
					local original=object:GetAttribute("OriginalPlaceholder")
					if original~=nil then object.PlaceholderText=tostring(original) object:SetAttribute("LastTranslatedPlaceholder",tostring(original)) end
				else
					local original=object:GetAttribute("OriginalText")
					if original~=nil then object.Text=tostring(original) object:SetAttribute("LastTranslatedText",tostring(original)) end
				end
				if index%180==0 then task.wait() end
			end
		else
			local groups={}
			local keys={}
			self._TranslationCache=self._TranslationCache or {}
			for _,object in ipairs(objects) do
				local property=object:IsA("TextBox") and "PlaceholderText" or "Text"
				local originalAttribute=object:IsA("TextBox") and "OriginalPlaceholder" or "OriginalText"
				local lastAttribute=object:IsA("TextBox") and "LastTranslatedPlaceholder" or "LastTranslatedText"
				local current=tostring(object[property] or "")
				local last=object:GetAttribute(lastAttribute)
				if object:GetAttribute(originalAttribute)==nil or (last and current~=last) then object:SetAttribute(originalAttribute,current) end
				local source=tostring(object:GetAttribute(originalAttribute) or "")
				if source~="" and not source:match("^%s*https?://") and not source:find("<",1,true) then
					local cached=self._TranslationCache[language.."|"..source]
					if cached then
						object[property]=cached
						object:SetAttribute(lastAttribute,cached)
					else
						if not groups[source] then groups[source]={} keys[#keys+1]=source end
						groups[source][#groups[source]+1]={object=object,property=property,lastAttribute=lastAttribute}
					end
				end
			end
			local batches={}
			local batch={}
			local batchLength=0
			for _,source in ipairs(keys) do
				if #batch>=20 or (batchLength+#source)>1600 then batches[#batches+1]=batch batch={} batchLength=0 end
				batch[#batch+1]=source
				batchLength+=#source
			end
			if #batch>0 then batches[#batches+1]=batch end
			local nextIndex=1
			local workers=math.min(8,math.max(1,#batches))
			local finished=0
			for _=1,workers do
				task.spawn(function()
					while generation==self._TranslationGeneration do
						local index=nextIndex nextIndex+=1
						local currentBatch=batches[index]
						if not currentBatch then break end
						local translatedBatch=translateTextBatch(currentBatch,language)
						for sourceIndex,source in ipairs(currentBatch) do
							local translated=translatedBatch[sourceIndex] or source
							for _,entry in ipairs(groups[source] or {}) do
								if generation~=self._TranslationGeneration then return end
								if entry.object and entry.object.Parent then entry.object[entry.property]=translated entry.object:SetAttribute(entry.lastAttribute,translated) end
							end
						end
					end
					finished+=1
				end)
			end
			while finished<workers and generation==self._TranslationGeneration do task.wait(0.03) end
		end
		self._SearchIndexVersion=(self._SearchIndexVersion or 0)+1
		if SearchBox and tostring(SearchBox.Text or "")~="" and SearchHandle then SearchHandle(true) end
	end)
	return language
end

 function PackColor(Color)
	return {R = Color.R * 255, G = Color.G * 255, B = Color.B * 255}
end

 function UnpackColor(Color)
	return Color3.fromRGB(Color.R, Color.G, Color.B)
end

 function LoadCfg(Config)
	local s, Data = pcall(HttpService.JSONDecode, HttpService, Config)
	if not s or not Data then return end
	for a, b in pairs(Data) do
		if XLQPGen1.Flags[a] then
			task.spawn(function()
				local s,e = pcall(function()
					if XLQPGen1.Flags[a].Type == "Colorpicker" then
						XLQPGen1.Flags[a]:Set(UnpackColor(b))
						if type(b)=="table" and b.Transparency and XLQPGen1.Flags[a].SetTransparency then
							XLQPGen1.Flags[a]:SetTransparency(tonumber(b.Transparency) or 0,true)
						end
					elseif XLQPGen1.Flags[a].Type == "Textbox" then
						XLQPGen1.Flags[a]:Set(b, true)
					elseif tostring(a)=="XLQPLiveColorTheme" and tostring(b)=="Custom" then
						if XLQPGen1._WindowConfig then XLQPGen1._WindowConfig.LiveColorTheme="Custom" end
						XLQPGen1.Flags[a]:Set(b,true)
						if XLQPGen1._RefreshLiveColorDropdowns then
							task.defer(function()
								if not XLQPGen1._Destroyed then XLQPGen1:_RefreshLiveColorDropdowns() end
							end)
						end
					else
						XLQPGen1.Flags[a]:Set(b)
					end
				end)
				if not s then
					warn("XLQPGen1 Error: ", e)
				end
			end)
		else
		end
	end
end

function SaveCfg(Name)
	if not (writefile and XLQPGen1.Folder and Name) then return end
	local Data = {}
	for i,v in pairs(XLQPGen1.Flags) do
		if v.Save then
			if v.Type == "Colorpicker" then
				Data[i] = PackColor(v.Value)
				Data[i].Transparency = tonumber(v.Transparency) or 0
			else
				Data[i] = v.Value
			end
		end
	end
	pcall(writefile, XLQPGen1.Folder .. "/" .. Name .. ".txt", tostring(HttpService:JSONEncode(Data)))
end

