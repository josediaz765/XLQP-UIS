		local function reportElementFailure(methodName, err)
			local message = "[XLQPGen1] " .. tostring(methodName) .. "() failed and was skipped: " .. tostring(err)
			pcall(XLQPEnvironment.XLQPRealWarn or warn, message)
			pcall(function()
				XLQPGen1.LibErrors[#XLQPGen1.LibErrors + 1] = {Name = "Element", Message = message, Time = os.clock()}
				XLQPGen1._HasLibErrors = true
				XLQPGen1._LastLibError = message
				XLQPGen1._LastElementError = message
				if XLQPGen1._LoadingIssueLabel then
					XLQPGen1._LoadingIssueLabel.Text = tostring(methodName) .. "() failed and was skipped. Full error printed to the console (F9)."
