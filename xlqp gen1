	local function aiSafeClean(value)
		local text = tostring(value or "")
		text = text:gsub("\r", "")
		text = text:gsub("<think>.-</think>", "")
		text = text:gsub("<reasoning>.-</reasoning>", "")
		text = text:gsub("<span[^>]*>", "")
		text = text:gsub("</span>", "")
		text = text:gsub("&quot;", "\"")
		text = text:gsub("&#39;", "'")
		text = text:gsub("&apos;", "'")
		text = text:gsub("&lt;", "<")
		text = text:gsub("&gt;", ">")
		text = text:gsub("&amp;", "&")
		text = text:gsub("^%s+", "")
		text = text:gsub("%s+$", "")
		return text
	end

	local function aiStripFenceArtifacts(code)
		code = tostring(code or "")
		code = code:gsub("\r\n", "\n"):gsub("\r", "\n")
		code = code:gsub("^%s*```%s*[%a%d_%-+]*%s*\n?", "")
		code = code:gsub("\n?%s*```%s*$", "")
		code = code:gsub("^%s*[Ll][Uu][Aa]%s*\n", "")
		code = code:gsub("^%s+", "")
		code = code:gsub("%s+$", "")
		return code
	end

	local function aiPlainTextLooksLua(text)
		local trimmed = tostring(text or "")
		if trimmed == "" then return false end
		local luaHints = {
			"game:GetService", "game%.Players", "Players%.LocalPlayer", "workspace", "script%.Parent",
			"local%s+[%w_]+%s*=", "for%s+[%w_,%s]+%s+in%s+", "function%s*%(",
			"function%s+[%w_%.:]+", "Instance%.new", "print%s*%(", "Humanoid", "Enum%.",
			"CFrame", "Vector3", "UDim2", "Color3", "task%.", "pairs%s*%(", "ipairs%s*%("
		}
		for _, pattern in ipairs(luaHints) do
			if trimmed:find(pattern) then return true end
		end
		return false
	end

	local function aiExtractFencedLua(text)
		local source = tostring(text or ""):gsub("\r\n", "\n"):gsub("\r", "\n")
		for lang, body in source:gmatch("```%s*([%w_%-+]*)%s*\n(.-)\n%s*```") do
			lang = tostring(lang or ""):lower()
			if lang == "" or lang:find("lua", 1, true) or lang == "luau" then
				local code = aiStripFenceArtifacts(body)
				if code ~= "" then return code end
			end
		end
		for lang, body in source:gmatch("```%s*([%w_%-+]*)%s*(.-)%s*```") do
			lang = tostring(lang or ""):lower()
			if lang == "" or lang:find("lua", 1, true) or lang == "luau" then
				local code = aiStripFenceArtifacts(body)
				if code ~= "" then return code end
			end
		end
		return nil
	end

	local function aiExtractRunnableLua(text, allowPlain)
		local fenced = aiExtractFencedLua(text)
		if fenced and fenced ~= "" then return fenced, true end
		if allowPlain then
			local raw = aiStripFenceArtifacts(aiSafeClean(text))
			local lower = raw:lower()
