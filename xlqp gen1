			local function formatPlayers(value)
				local number=tonumber(value)
				if not number then return nil end
				local text=tostring(math.floor(number))
				local formatted=text
				while true do
					local replaced
					formatted,replaced=formatted:gsub("^(-?%d+)(%d%d%d)","%1,%2")
					if replaced==0 then break end
				end
				return formatted
			end

			local function httpJson(url)
				local requester=XLQPResolveRequest()
				if type(requester)~="function" then return nil end
				local ok,response=pcall(requester,{Url=url,Method="GET"})
				if not ok or type(response)~="table" then return nil end
				local body=tostring(response.Body or response.body or "")
				if body=="" then return nil end
				local decoded,result=pcall(HttpService.JSONDecode,HttpService,body)
				if decoded and type(result)=="table" then return result end
				return nil
			end

			local function httpPostJson(url,payload)
				local requester=XLQPResolveRequest()
				if type(requester)~="function" then return nil end
				local encoded=HttpService:JSONEncode(payload)
				local ok,response=pcall(requester,{Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=encoded})
				if not ok or type(response)~="table" then return nil end
				local body=tostring(response.Body or response.body or "")
				if body=="" then return nil end
				local decoded,result=pcall(HttpService.JSONDecode,HttpService,body)
				if decoded and type(result)=="table" then return result end
				return nil
			end

			local function activeCount(placeId)
				placeId=tonumber(placeId)
				if not placeId or placeId<=0 then return nil end
				if countCache[placeId]~=nil then return countCache[placeId] end
				local universeId=universeCache[placeId]
				if universeId==nil then
					local data=httpJson("https://apis.roblox.com/universes/v1/places/"..tostring(placeId).."/universe")
					universeId=data and tonumber(data.universeId) or false
					universeCache[placeId]=universeId
				end
				if not universeId then return nil end
				local games=httpJson("https://games.roblox.com/v1/games?universeIds="..tostring(universeId))
				local entry=games and games.data and games.data[1]
				local playing=entry and tonumber(entry.playing) or nil
				countCache[placeId]=playing or false
				return playing
			end

