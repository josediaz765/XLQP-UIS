                   if os.clock() - lastAntiFlingSweep < 0.5 then return end
                   lastAntiFlingSweep = os.clock()
                   local localCharacter = homeLocalPlayer.Character
                   local localRoot = getCharacterRoot(localCharacter)
                   if not localRoot then return end
                   for _, p in pairs(Players:GetPlayers()) do
                       if p ~= homeLocalPlayer and p.Character then
                           local otherRoot = getCharacterRoot(p.Character)
                           if otherRoot and (otherRoot.Position-localRoot.Position).Magnitude <= 90 then
                           for _, v in pairs(p.Character:GetChildren()) do
                               if v:IsA("BasePart") then
                                   if antiFlingDefaults[v] == nil then
                                       antiFlingDefaults[v] = {CanCollide = v.CanCollide, Massless = v.Massless}
                                   end
                                   v.AssemblyLinearVelocity = Vector3.zero
                                   v.AssemblyAngularVelocity = Vector3.zero
                                   v.CanCollide = false
                                   v.Massless = true
                               end
                           end
                           end
                       end
                   end
               end)
           else
               if antiFlingConnection then
                   antiFlingConnection:Disconnect()
                   antiFlingConnection = nil
               end
               local restored = 0
