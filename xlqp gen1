	local function send(forcedPrompt, fromRobloxChat)
		local displayPrompt = tostring(forcedPrompt or aiTextBox.Text or "")
		local requestPrompt = displayPrompt
		if type(TextboxConfig.PromptTransform)=="function" and not fromRobloxChat then
			local ok,transformed=pcall(TextboxConfig.PromptTransform,displayPrompt,Textbox)
			if ok and transformed~=nil and tostring(transformed)~="" then requestPrompt=tostring(transformed) end
		end
		local tabData = activeTabId and chatTabs[activeTabId]
		if XLQPGen1.AIService.Config.ChatPromptsOnly and not fromRobloxChat then
			aiStatusLabel.Text = "Roblox chat prompts only"
			return
		end
		if displayPrompt ~= "" and activeTabId and tabData and not tabData.Awaiting then
			sendSound:Play()
			aiTextBox.Text = ""
			addMessageToLog(activeTabId, "You", displayPrompt)
			local handled,worldReply,worldAction=XLQPGen1.AIService:HandleWorldCommand(displayPrompt,true)
			if handled then
				XLQPGen1._AIReplyThenRunTool(activeTabId,worldReply,function()
					local ok,err=pcall(worldAction)
					if ok then addMessageToLog(activeTabId,"AI","Called tool: place_world_object")
					else addMessageToLog(activeTabId,"AI","Executed tool: place_world_object (failed: "..tostring(err)..")") end
				end)
			elseif handlePluginBuildCommand(activeTabId,displayPrompt) then
			elseif XLQPGen1.AIService:IsThemeRequest(displayPrompt) then
				local requestTabId=activeTabId
				tabData.Awaiting=true
				aiStatusLabel.Text="building theme..."
				task.spawn(function()
					local ok,message=XLQPGen1.AIService:CreateThemeFromPrompt(displayPrompt)
					addMessageToLog(requestTabId,"AI",message)
					if ok then XLQPGen1.AIService:Speak(message) end
					tabData.Awaiting=false
					aiStatusLabel.Text=ok and "theme applied" or "theme failed"
					task.delay(1.2,function() if aiStatusLabel and aiStatusLabel.Parent then aiStatusLabel.Text="ready | "..XLQPGen1.AIService:GetShortProvider() end end)
				end)
			elseif not handleLocalUIToolCommand(activeTabId, displayPrompt) then
				askAI(activeTabId, requestPrompt)
			end
		end
	end

