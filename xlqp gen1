					local label=tostring(raw.Name or raw.Title or raw.Text or raw.Value or ("Option "..index))
					return label,raw.Value~=nil and raw.Value or label,raw.Disabled==true or raw.Locked==true
				end
				return tostring(raw),raw,false
			end
			local function sameValue(a,b) return a==b or tostring(a)==tostring(b) end
