function XLQPGen1:_SyncCustomLiveThemeSurfaces()
	local data=self:GetLiveColorThemeData("Custom") or {}
	if WindowConfig.LiveColorTheme~="Custom" or data.CustomMedia~=true then return self end
	local link=tostring(data.MediaLink or data.BackgroundImage or data.Image or "")
	if link=="" then return self end
	local mediaType=tostring(data.MediaType or self:_DetectCustomLiveMediaType(link))
	local transparency=math.clamp(tonumber(data.ImageTransparency or data.Transparency) or .14,0,1)

	if data.Sync~=false and self.SetTransparentUI then
		pcall(function() self:SetTransparentUI(true) end)
	end

	if SettingsWindow then
		SettingsWindow.BackgroundTransparency=1
	end
	if MainWindow and data.Sync~=false then
		MainWindow.BackgroundTransparency=1
	end

	if mediaType=="Image" then
		local asset=self._CustomLiveMediaResolvedAsset
		if self._CustomLiveMediaResolvedSignature~=("Image|"..link) then
			asset=resolveCustomBackgroundAsset(link)
			if asset and asset~="" and not tostring(asset):match("^https?://") then
				self._CustomLiveMediaResolvedAsset=asset
				self._CustomLiveMediaResolvedSignature="Image|"..link
			end
		end
		if asset and asset~="" and not tostring(asset):match("^https?://") then
			for _,overlay in ipairs({thumbnailOverlay,settingsThumbnailOverlay,tabListThumbnailOverlay}) do
				if overlay and overlay.Parent then
					pcall(function() overlay.ImageContent=nil end)
					XLQPAssignProperty(overlay,"Image",asset)
					overlay.ImageTransparency=transparency
					overlay.ImageColor3=Color3.new(1,1,1)
					overlay.ScaleType=Enum.ScaleType.Crop
					overlay.Visible=true
				end
			end
			if videoBgFrame then videoBgFrame.Visible=false end
			if settingsVideoBgFrame then settingsVideoBgFrame.Visible=false end
			if tabListVideoBgFrame then tabListVideoBgFrame.Visible=false end

			local roots={XLQPGen1Gui,WindowStuff}
			for _,root in ipairs(roots) do
				if root then
					for _,gui in ipairs(root:GetDescendants()) do
						if gui:IsA("ImageLabel") and (gui.Name=="XLQPTabListBackground" or gui.Name=="XLQPDetachedTabListBackground") then
							pcall(function() gui.ImageContent=nil end)
							XLQPAssignProperty(gui,"Image",asset)
							gui.ImageTransparency=transparency
							gui.ImageColor3=Color3.new(1,1,1)
							gui.ScaleType=Enum.ScaleType.Crop
							gui.Visible=true
						end
					end
				end
			end
		end
	elseif mediaType=="GIF" then
		local runtime=self._GifRuntime
		if runtime and runtime.Content then
			for _,overlay in ipairs({thumbnailOverlay,settingsThumbnailOverlay,tabListThumbnailOverlay}) do
				if overlay and overlay.Parent then
					overlay.Image=""
					overlay.ImageTransparency=transparency
					overlay.ImageColor3=Color3.new(1,1,1)
					overlay.ScaleType=Enum.ScaleType.Crop
					local ok=pcall(function() overlay.ImageContent=runtime.Content end)
					overlay.Visible=ok
				end
			end
			if XLQPGen1Gui then
				for _,gui in ipairs(XLQPGen1Gui:GetDescendants()) do
					if gui:IsA("ImageLabel") and gui.Name=="XLQPDetachedTabListBackground" then
						gui.Image=""
						gui.ImageTransparency=transparency
						gui.ImageColor3=Color3.new(1,1,1)
						gui.ScaleType=Enum.ScaleType.Crop
						local ok=pcall(function() gui.ImageContent=runtime.Content end)
						gui.Visible=ok
						local found=false
						for _,layer in ipairs(runtime.Layers or {}) do
							if layer==gui then found=true break end
						end
						if not found then table.insert(runtime.Layers,gui) end
					end
				end
			end
		end
	elseif mediaType=="Video" then
		local asset=self._CustomLiveMediaResolvedAsset
		if self._CustomLiveMediaResolvedSignature~=("Video|"..link) then
			asset=self:_ResolveCustomLiveMediaAsset(link,"Video")
			if asset then
				self._CustomLiveMediaResolvedAsset=asset
				self._CustomLiveMediaResolvedSignature="Video|"..link
			end
		end
		if asset then
			for _,video in ipairs({videoBgFrame,settingsVideoBgFrame,tabListVideoBgFrame}) do
				if video and video.Parent then
					pcall(function()
						video.Video=asset
						video.Looped=true
						video.Volume=0
						video.Visible=true
						if not video.IsPlaying then video:Play() end
					end)
				end
			end
			for _,overlay in ipairs({thumbnailOverlay,settingsThumbnailOverlay,tabListThumbnailOverlay}) do
				if overlay then overlay.Visible=false end
			end
		end
	end

	if WindowStuff then
		WindowStuff.BackgroundTransparency=math.max(WindowStuff.BackgroundTransparency,0.5)
		local headerShield=WindowStuff:FindFirstChild("XLQPTabListHeaderShield")
		if headerShield and headerShield:IsA("GuiObject") then
			headerShield.BackgroundTransparency=math.max(headerShield.BackgroundTransparency,0.48)
		end
		local headerFill=WindowStuff:FindFirstChild("XLQPTabListHeaderBottomFill")
		if headerFill and headerFill:IsA("GuiObject") then
			headerFill.BackgroundTransparency=math.max(headerFill.BackgroundTransparency,0.48)
		end
	end

	if SettingsSideTabBar and data.Sync~=false then
		SettingsSideTabBar.BackgroundTransparency=math.max(SettingsSideTabBar.BackgroundTransparency,0.62)
	end
	if SettingsContent and data.Sync~=false then
		SettingsContent.BackgroundTransparency=math.max(SettingsContent.BackgroundTransparency,0.62)
	end

	return self
end

function XLQPGen1:_RestoreCustomTabListMedia(sideFrame,detachedImage)
	local data=self:GetLiveColorThemeData("Custom") or {}
	if WindowConfig.LiveColorTheme~="Custom" or data.CustomMedia~=true then return false end
	local link=tostring(data.MediaLink or data.BackgroundImage or data.Image or "")
	if link=="" or not sideFrame then return false end
	local mediaType=tostring(data.MediaType or self:_DetectCustomLiveMediaType(link))
	local transparency=math.clamp(tonumber(data.ImageTransparency or data.Transparency) or .14,0,1)

	if mediaType=="GIF" then
		local runtime=self._GifRuntime
		if runtime and runtime.Content and detachedImage then
			detachedImage.Image=""
			detachedImage.ImageTransparency=transparency
			detachedImage.ImageColor3=Color3.new(1,1,1)
			detachedImage.ScaleType=Enum.ScaleType.Crop
			local ok=pcall(function() detachedImage.ImageContent=runtime.Content end)
			detachedImage.Visible=ok
			if ok then
				local found=false
				for _,layer in ipairs(runtime.Layers or {}) do
					if layer==detachedImage then found=true break end
				end
				if not found then table.insert(runtime.Layers,detachedImage) end
			end
		end
		local internal=sideFrame:FindFirstChild("XLQPTabListBackground")
		if internal and internal:IsA("ImageLabel") and runtime and runtime.Content then
			internal.Image=""
			internal.ImageTransparency=transparency
			internal.ImageColor3=Color3.new(1,1,1)
			local ok=pcall(function() internal.ImageContent=runtime.Content end)
			internal.Visible=ok and WindowConfig.SidebarTab~=true
			local found=false
			for _,layer in ipairs(runtime.Layers or {}) do
				if layer==internal then found=true break end
			end
			if not found then table.insert(runtime.Layers,internal) end
		end
		local video=sideFrame:FindFirstChild("XLQPTabListVideoBackground")
		if video and video:IsA("VideoFrame") then
			pcall(function() video:Pause() end)
			video.Visible=false
		end
		return runtime and runtime.Content~=nil
	elseif mediaType=="Video" then
		if detachedImage then detachedImage.Visible=false end
		local internal=sideFrame:FindFirstChild("XLQPTabListBackground")
		if internal and internal:IsA("ImageLabel") then internal.Visible=false end
		local asset=self._CustomLiveMediaResolvedAsset
		if self._CustomLiveMediaResolvedSignature~=("Video|"..link) then
			local ok,result=pcall(function() return self:_ResolveCustomLiveMediaAsset(link,"Video") end)
			if ok and result then
				asset=result
				self._CustomLiveMediaResolvedAsset=result
				self._CustomLiveMediaResolvedSignature="Video|"..link
			end
		end
		local video=sideFrame:FindFirstChild("XLQPTabListVideoBackground")
		if video and video:IsA("VideoFrame") and asset then
			pcall(function()
				video.Video=asset
				video.Looped=true
				video.Volume=0
				video.Visible=true
				if not video.IsPlaying then video:Play() end
			end)
			return true
		end
		return false
	else
		local asset=self._CustomLiveMediaResolvedAsset
		if self._CustomLiveMediaResolvedSignature~=("Image|"..link) then
			local source=tabListThumbnailOverlay and tabListThumbnailOverlay.Image or ""
			if source=="" and thumbnailOverlay then source=thumbnailOverlay.Image end
			if source~="" then
				asset=source
				self._CustomLiveMediaResolvedAsset=source
				self._CustomLiveMediaResolvedSignature="Image|"..link
			else
				local ok,result=pcall(resolveCustomBackgroundAsset,link)
				if ok and result and result~="" and not tostring(result):match("^https?://") then
					asset=result
					self._CustomLiveMediaResolvedAsset=result
					self._CustomLiveMediaResolvedSignature="Image|"..link
				end
			end
		end
		if not asset or asset=="" then return false end

		if detachedImage then
			pcall(function() detachedImage.ImageContent=nil end)
			XLQPAssignProperty(detachedImage,"Image",asset)
			detachedImage.ImageTransparency=transparency
			detachedImage.ImageColor3=Color3.new(1,1,1)
			detachedImage.ScaleType=Enum.ScaleType.Crop
			detachedImage.Visible=true
		end

		local internal=sideFrame:FindFirstChild("XLQPTabListBackground")
		if internal and internal:IsA("ImageLabel") then
			pcall(function() internal.ImageContent=nil end)
			XLQPAssignProperty(internal,"Image",asset)
			internal.ImageTransparency=transparency
			internal.ImageColor3=Color3.new(1,1,1)
			internal.ScaleType=Enum.ScaleType.Crop
			internal.Visible=WindowConfig.SidebarTab~=true
		end

		local video=sideFrame:FindFirstChild("XLQPTabListVideoBackground")
		if video and video:IsA("VideoFrame") then
			pcall(function() video:Pause() end)
			video.Visible=false
		end
		return true
	end
end

WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync=function(delayTime)
	WindowConfig._LocalRegisterState.customLiveSurfaceSyncToken=(WindowConfig._LocalRegisterState.customLiveSurfaceSyncToken or 0)+1
	local token=WindowConfig._LocalRegisterState.customLiveSurfaceSyncToken
	task.delay(tonumber(delayTime) or 0,function()
		if token~=WindowConfig._LocalRegisterState.customLiveSurfaceSyncToken then return end
		if XLQPGen1 and XLQPGen1._SyncCustomLiveThemeSurfaces then
			pcall(function() XLQPGen1:_SyncCustomLiveThemeSurfaces() end)
		end
	end)
end

if WindowStuff then
	AddConnection(WindowStuff.DescendantAdded,function(gui)
		if WindowConfig.LiveColorTheme~="Custom" then return end
		if gui:IsA("ImageLabel") and (gui.Name=="XLQPTabListBackground" or gui.Name=="XLQPDetachedTabListBackground") then
			WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0)
		elseif gui:IsA("VideoFrame") and gui.Name=="XLQPTabListVideoBackground" then
			WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0)
		end
	end)
	AddConnection(WindowStuff:GetPropertyChangedSignal("Parent"),function()
		if WindowConfig.LiveColorTheme=="Custom" then
			WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0.03)
		end
	end)
end

if SettingsWindow then
	AddConnection(SettingsWindow:GetPropertyChangedSignal("Visible"),function()
		if SettingsWindow.Visible and WindowConfig.LiveColorTheme=="Custom" then
			WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0)
			WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0.08)
		end
	end)
end

function XLQPGen1:_ApplyCustomLiveThemeMedia(data)
	data=type(data)=="table" and data or self:GetLiveColorThemeData("Custom") or {}
	local link=tostring(data.MediaLink or data.BackgroundImage or data.Image or "")
	local mediaType=tostring(data.MediaType or self:_DetectCustomLiveMediaType(link))
	local transparency=math.clamp(tonumber(data.ImageTransparency or data.Transparency) or .14,0,1)
	if link=="" then return false,"No custom media is selected." end
	WindowConfig.BackgroundEnabled=true
	WindowConfig.LiveColorThemeImages=true
	WindowConfig.GifBackgroundEnabled=false
	if mediaType=="GIF" then
		if self._AppliedCustomMediaSignature=="GIF|"..link and self._GifRuntime and self._GifRuntime.Active then
			self:_SyncCustomLiveThemeSurfaces()
			return true,"Ready"
		end
		cleanupCurrentMedia()
		local ok,message=self:_SetGifBackgroundAwait(link,transparency,data.ProgressCallback)
		WindowConfig.URLBackgroundEnabled=false
		WindowConfig.BackgroundEnabled=true
		if tabListVideoBgFrame then tabListVideoBgFrame.Visible=false end
		if ok then
			self._AppliedCustomMediaSignature="GIF|"..link
			self:_SyncCustomLiveThemeSurfaces()
			if WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync then
				WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0.05)
				WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0.35)
			end
		end
		return ok,message
	elseif mediaType=="Video" then
		cleanupCurrentMedia()
		local asset,errorMessage=self:_ResolveCustomLiveMediaAsset(link,"Video")
		if not asset then return false,errorMessage end
		self._CustomLiveMediaResolvedAsset=asset
		self._CustomLiveMediaResolvedSignature="Video|"..link
		for _,video in ipairs({videoBgFrame,settingsVideoBgFrame,tabListVideoBgFrame}) do
			if video and video.Parent then
				pcall(function()
					video.Video=asset
					video.Looped=true
					video.Volume=0
					video.Visible=true
					video:Play()
				end)
			end
		end
		thumbnailOverlay.Visible=false
		settingsThumbnailOverlay.Visible=false
		tabListThumbnailOverlay.Visible=false
		currentMedia=videoBgFrame
		backgroundMode="Video"
		WindowConfig.URLBackgroundEnabled=false
		MainWindow.BackgroundTransparency=1
		SettingsWindow.BackgroundTransparency=1
		if self._TabListLayoutHook then pcall(self._TabListLayoutHook) end
		self._AppliedCustomMediaSignature="Video|"..link
		self:_SyncCustomLiveThemeSurfaces()
		return true
	else
		if tabListVideoBgFrame then
			pcall(function() tabListVideoBgFrame:Pause() end)
			tabListVideoBgFrame.Visible=false
			tabListVideoBgFrame.Video=""
		end
		local ok=applyCustomBackgroundAsset(link,transparency,true,true)
		if ok then
			local asset=tabListThumbnailOverlay and tabListThumbnailOverlay.Image or ""
			if asset=="" and thumbnailOverlay then asset=thumbnailOverlay.Image end
			if asset~="" then
				self._CustomLiveMediaResolvedAsset=asset
				self._CustomLiveMediaResolvedSignature="Image|"..link
			end
		end
		WindowConfig.URLBackgroundEnabled=false
		WindowConfig.BackgroundEnabled=true
		if ok then
			self._AppliedCustomMediaSignature="Image|"..link
			if self._TabListLayoutHook then pcall(self._TabListLayoutHook) end
			self:_SyncCustomLiveThemeSurfaces()
			if WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync then
				WindowConfig._LocalRegisterState.queueCustomLiveSurfaceSync(0.06)
			end
		end
		return ok,ok and nil or "Image could not be applied."
	end
end

