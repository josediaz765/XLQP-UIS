	local pausedParentScrolls={}
	local function releaseParentScrolls()
		for scrollFrame,wasEnabled in pairs(pausedParentScrolls) do
			if scrollFrame.Parent then scrollFrame.ScrollingEnabled=wasEnabled end
			pausedParentScrolls[scrollFrame]=nil
		end
	end
	local function captureParentScrolls()
		if not Dropdown.Toggled then return end
		local ancestor=DropdownFrame.Parent
		while ancestor do
			if ancestor:IsA("ScrollingFrame") and pausedParentScrolls[ancestor]==nil then
				pausedParentScrolls[ancestor]=ancestor.ScrollingEnabled
				ancestor.ScrollingEnabled=false
			end
			ancestor=ancestor.Parent
		end
	end
	AddConnection(DropdownContainer.MouseEnter,captureParentScrolls)
	AddConnection(DropdownContainer.MouseLeave,releaseParentScrolls)
	AddConnection(DropdownFrame.AncestryChanged,function(_,parent) if not parent then releaseParentScrolls() end end)

	local dropdownLayoutQueued = false
	local dropdownLayoutAnimate = false
	local function refreshDropdownLayout(animate)
		if not (DropdownFrame and DropdownFrame.Parent and DropdownContainer and DropdownList) then return end
		local visibleButtons = {}
		local seen = {}
		for _,button in pairs(Dropdown.Buttons) do
			if button and button.Parent and button.Visible then visibleButtons[#visibleButtons+1]=button seen[button]=true end
		end
		for _,child in ipairs(DropdownContainer:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible and child:GetAttribute("__XLQPGen1MoveableFrame")==true and not seen[child] then
				visibleButtons[#visibleButtons+1]=child
				seen[child]=true
			end
		end
		local visibleHeight = 0
		local visibleCount = 0
		if bulkActions and bulkActions.Visible then
			visibleHeight += math.max(0, bulkActions.Size.Y.Offset)
			visibleCount += 1
		end
		if searchContainer and searchContainer.Visible then
			visibleHeight += math.max(0,searchContainer.Size.Y.Offset)
			visibleCount += 1
		end
		local shownOptions = math.min(#visibleButtons,math.max(1,MaxElements))
		for index=1,shownOptions do
			local button=visibleButtons[index]
			visibleHeight += math.max(0,button.Size.Y.Offset > 0 and button.Size.Y.Offset or button.AbsoluteSize.Y)
			visibleCount += 1
		end
		if visibleCount>1 then visibleHeight += (visibleCount-1)*math.max(0,DropdownList.Padding.Offset) end
		local viewportHeight = visibleCount>0 and (visibleHeight+8) or 0
		local contentHeight = math.max(0,DropdownList.AbsoluteContentSize.Y)+8
		DropdownContainer.CanvasSize=UDim2.new(0,0,0,contentHeight)
		local scrolling=Dropdown.Toggled and contentHeight>viewportHeight+1
		DropdownContainer.ScrollBarThickness=scrolling and (isMobile and 7 or 4) or 0
		DropdownContainer.ScrollingEnabled=scrolling
		local targetHeight=Dropdown.Toggled and (38+viewportHeight) or 38
		local goal={Size=UDim2.new(1,0,0,targetHeight)}
		if animate then
			TweenService:Create(DropdownFrame,TweenInfo.new(.2,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),goal):Play()
		else
			DropdownFrame.Size=goal.Size
		end
		task.defer(function()
			if not (DropdownContainer and DropdownContainer.Parent) then return end
			local maxY=math.max(0,DropdownContainer.AbsoluteCanvasSize.Y-DropdownContainer.AbsoluteWindowSize.Y)
			if DropdownContainer.CanvasPosition.Y>maxY then DropdownContainer.CanvasPosition=Vector2.new(0,maxY) end
		end)
	end
	local function queueDropdownLayout(animate)
		dropdownLayoutAnimate=dropdownLayoutAnimate or animate==true
		if dropdownLayoutQueued then return end
		dropdownLayoutQueued=true
		task.defer(function()
			dropdownLayoutQueued=false
			local shouldAnimate=dropdownLayoutAnimate
			dropdownLayoutAnimate=false
			refreshDropdownLayout(shouldAnimate)
		end)
	end
	AddConnection(DropdownList:GetPropertyChangedSignal("AbsoluteContentSize"),function() queueDropdownLayout(false) end)
	AddConnection(DropdownContainer.ChildAdded,function(child)
		if child:IsA("GuiObject") and child:GetAttribute("__XLQPGen1MoveableFrame")==true then task.defer(function() queueDropdownLayout(false) end) end
	end)
	AddConnection(DropdownContainer.ChildRemoved,function(child)
		if child:IsA("GuiObject") and child:GetAttribute("__XLQPGen1MoveableFrame")==true then task.defer(function() queueDropdownLayout(false) end) end
	end)

