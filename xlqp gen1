local function cleanDiscordInvite(invite)
local code=tostring(invite or ""):gsub("%s+","")
code=code:gsub("^https://discord%.gg/",""):gsub("^http://discord%.gg/",""):gsub("^https://discord%.com/invite/",""):gsub("^http://discord%.com/invite/",""):gsub("^discord%.gg/",""):gsub("^discord%.com/invite/",""):gsub("^/","")
return code:match("([^%?]+)") or code
end
 function WindowConfig._LocalRegisterState.copyText(text)
local clip=setclipboard or toclipboard or set_clipboard or writeclipboard or (syn and syn.write_clipboard)
if clip then return pcall(function() clip(tostring(text or "")) end) end
return false
end
local function openUrl(url)
local opened=false
pcall(function()
if syn and syn.openurl then syn.openurl(url) opened=true elseif openurl then openurl(url) opened=true elseif GuiService and GuiService.OpenBrowserWindow then GuiService:OpenBrowserWindow(url) opened=true end
end)
if not opened then WindowConfig._LocalRegisterState.copyText(url) end
return opened
end
 function WindowConfig._LocalRegisterState.promptDiscordInvite(invite)
local code=cleanDiscordInvite(invite)
if code=="" then return false end
local inviteLink="https://discord.gg/"..code
local req=XLQPResolveRequest()
if req then
local ok,res=pcall(function()
return req({Url="http://127.0.0.1:6463/rpc?v=1",Method="POST",Headers={["Content-Type"]="application/json",["Origin"]="https://discord.com"},Body=HttpService:JSONEncode({cmd="INVITE_BROWSER",nonce=HttpService:GenerateGUID(false),args={code=code}})})
end)
if ok and res then return true end
end
if openUrl(inviteLink) then return true end
WindowConfig._LocalRegisterState.copyText(inviteLink)
return false
end
function XLQPGen1:_DiscordAuthRequest()
return XLQPResolveRequest()
end
function XLQPGen1:_DiscordAuthPath(name)
return tostring(WindowConfig.ConfigFolder or "XLQPGen1").."/"..tostring(name or "discord_auth_profile")..".json"
end
function XLQPGen1:_DiscordAuthRequestUrl(url)
local req=self:_DiscordAuthRequest()
if not req then
local body
pcall(function() body=game:HttpGet(tostring(url or ""),true) end)
return body
end
local ok,res=pcall(function()
return req({Url=tostring(url or ""),Method="GET",Headers={["User-Agent"]="Mozilla/5.0",["Accept"]="*/*"}})
end)
if ok and res then
local body=res.Body or res.body or res.Data or res.data
if body and body~="" then return body end
end
local body
pcall(function() body=game:HttpGet(tostring(url or ""),true) end)
return body
end
function XLQPGen1:_DiscordAuthDecode(text)
local ok,data=pcall(function() return HttpService:JSONDecode(text or "") end)
return ok and data or nil
end
function XLQPGen1:_DiscordAuthGrab(text,patterns)
if not text then return nil end
for _,pattern in ipairs(patterns or {}) do
local found=tostring(text):match(pattern)
if found and found~="" and found~="null" then return found end
end
end
function XLQPGen1:_DiscordAuthClean(text)
if not text then return "Unknown" end
return tostring(text):gsub('\\"','"'):gsub("\\/","/"):gsub("\\n"," "):gsub("\\u0020"," ")
end
function XLQPGen1:FetchDiscordAuthProfile(id)
id=tostring(id or ""):gsub("%D+","")
if id=="" then return nil end
for _,api in ipairs({"https://api.lanyard.rest/v1/users/"..id,"https://japi.rest/discord/v1/user/"..id}) do
local body=self:_DiscordAuthRequestUrl(api)
local data=self:_DiscordAuthDecode(body)
local user=data and data.data and data.data.discord_user or data and data.data and data.data.user or data and data.data or data and data.user
local avatar=user and (user.avatar_url or user.avatarURL or user.displayAvatarURL or user.avatar or user.avatar_hash or user.avatarHash or user.hash) or self:_DiscordAuthGrab(body,{'"avatar_url"%s*:%s*"([^"]+)"','"avatarURL"%s*:%s*"([^"]+)"','"displayAvatarURL"%s*:%s*"([^"]+)"','"avatar"%s*:%s*"([^"]+)"','"avatar_hash"%s*:%s*"([^"]+)"','"avatarHash"%s*:%s*"([^"]+)"','"hash"%s*:%s*"([^"]+)"'})
local username=user and (user.username or user.global_name or user.display_name or user.displayName) or self:_DiscordAuthGrab(body,{'"username"%s*:%s*"([^"]+)"','"global_name"%s*:%s*"([^"]+)"'})
local displayName=user and (user.global_name or user.display_name or user.displayName or user.username) or self:_DiscordAuthGrab(body,{'"global_name"%s*:%s*"([^"]+)"','"display_name"%s*:%s*"([^"]+)"','"displayName"%s*:%s*"([^"]+)"'})
if username or displayName or avatar then
local avatarUrl=nil
if avatar and tostring(avatar)~="" then
avatar=tostring(avatar):gsub("\\/","/")
avatarUrl=avatar:find("^https?://") and avatar or "https://cdn.discordapp.com/avatars/"..id.."/"..avatar..".png?size=1024"
avatarUrl=avatarUrl:gsub("%.webp","%.png"):gsub("%.gif","%.png"):gsub("%?size=%d+","?size=1024")
end
return {id=id,username=self:_DiscordAuthClean(username),displayName=self:_DiscordAuthClean(displayName or username),avatar=avatarUrl,avatarAsset=nil}
end
