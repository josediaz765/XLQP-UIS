 function WindowConfig._LocalRegisterState.isGuiBranchVisible(object,root)
 	local current=object
 	while current and current~=root do
 		if current:IsA("GuiObject") and current.Visible==false then return false end
 		if current:IsA("LayerCollector") and current.Enabled==false then return false end
 		current=current.Parent
 	end
 	if root and current~=root then return false end
 	if root then
 		if root:IsA("GuiObject") and root.Visible==false then return false end
 		if root:IsA("LayerCollector") and root.Enabled==false then return false end
