function XLQPGen1:_InstallBuiltInTabs(window, config, targetTop)
if not window or window._BuiltInTabsInstalled or window._BuiltInTabsInstalling then return window end
local builtIn=config and (config.BuiltInTabs or config.NativeTabs or config.UtilityTabs)
if builtIn==nil or builtIn==false then return window end
if builtIn==true then builtIn={Enabled=true} end
if type(builtIn)~="table" or builtIn.Enabled==false then return window end
local defaultEnabled=builtIn.Enabled==true
local settingsEnabled,settingsOptions=self:_ResolveBuiltInPanel(builtIn.Settings,defaultEnabled)
local securityEnabled,securityOptions=self:_ResolveBuiltInPanel(builtIn.Security,defaultEnabled)
local pvpEnabled,pvpOptions=self:_ResolveBuiltInPanel(builtIn.PVP,defaultEnabled)
if type(config.Security)=="table" then
local mergedSecurityOptions={}
for key,value in pairs(config.Security) do mergedSecurityOptions[key]=value end
for key,value in pairs(securityOptions) do mergedSecurityOptions[key]=value end
securityOptions=mergedSecurityOptions
end
if not settingsEnabled and not securityEnabled and not pvpEnabled then return window end
window._BuiltInTabsInstalling=true
local previousTop=window._GetCreationTop and window:_GetCreationTop() or nil
if window._SetCreationTop and targetTop then window:_SetCreationTop(targetTop) end
local created={}
local ok,err=pcall(function()
local function yieldBuild()
if self._PerformanceMode then RunService.Heartbeat:Wait() end
end
local group=tostring(builtIn.Group or "Configs")
local groupIcon=tostring(builtIn.GroupIcon or "folder")
if settingsEnabled then
created.Settings=window:AddTab({Title=tostring(settingsOptions.Title or "Settings"),Icon=tostring(settingsOptions.Icon or "settings"),Group=group,GroupIcon=groupIcon,LayoutOrder=100000})
yieldBuild()
end
if securityEnabled then
created.Security=window:AddTab({Title=tostring(securityOptions.Title or "Security"),Icon=tostring(securityOptions.Icon or "shield"),Group=group,GroupIcon=groupIcon,LayoutOrder=99999})
yieldBuild()
end
if pvpEnabled then
created.PVP=window:AddTab({Title=tostring(pvpOptions.Title or "PVP"),Icon=tostring(pvpOptions.Icon or "swords"),Group=group,GroupIcon=groupIcon,LayoutOrder=99998,Risky=pvpOptions.Risky~=false,RiskTitle=tostring(pvpOptions.RiskTitle or "Risky PVP tools"),RiskDescription=tostring(pvpOptions.RiskDescription or "This tab contains features that can affect other players. Do you want to continue?"),RiskTimeout=tonumber(pvpOptions.RiskTimeout) or 5,RiskOptions=pvpOptions.RiskOptions,RiskDimBackground=pvpOptions.RiskDimBackground==true,RiskBackgroundTransparency=pvpOptions.RiskBackgroundTransparency,RememberRisk=pvpOptions.RememberRisk~=false,RiskId=pvpOptions.RiskId or "BuiltInPVP"})
yieldBuild()
end
local refreshPVP=function() end
if created.PVP then
refreshPVP=self:_BuildNativePVPPanel(window,created.PVP,pvpOptions)
yieldBuild()
created.PVP.OnSelect:Connect(function()
refreshPVP()
end)
end
if created.Settings then self:_BuildNativeSettingsPanel(window,created.Settings,settingsOptions,refreshPVP,config) yieldBuild() end
if created.Security then self:_BuildNativeSecurityPanel(window,created.Security,securityOptions) yieldBuild() end
end)
if window._SetCreationTop then window:_SetCreationTop(previousTop) end
window._BuiltInTabsInstalling=false
window._BuiltInTabsInstalled=ok
window.BuiltInTabs=created
if not ok then
warn("XLQP Gen1 built-in tabs failed: "..tostring(err))
pcall(function() self:MakeNotification({Name="Built-in tabs",Content=tostring(err),Image="triangle-alert",Time=5}) end)
end
return window
end

function XLQPGen1:_PrepareBuiltInTabs(window, config)
if not window or window._BuiltInTabsPrepared then return window end
local builtIn=config and (config.BuiltInTabs or config.NativeTabs or config.UtilityTabs)
if builtIn==nil or builtIn==false or type(window.newmaketabtop)~="function" then return window end
window._BuiltInTabsPrepared=true
local originalNewTopTab=window.newmaketabtop
local library=self
window.newmaketabtop=function(target,tabConfig)
local result=originalNewTopTab(target,tabConfig)
if not target._BuiltInTabsInstalled and not target._BuiltInTabsInstalling and type(tabConfig)=="table" and tabConfig.MultiTab==true then
library:_InstallBuiltInTabs(target,config,result)
end
return result
end
return window
end


