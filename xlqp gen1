			ColorH,ColorS,ColorV=Color3.toHSV(stop.Color)
			ColorA=stop.Transparency
			RebuildGradientMarkers()
			UpdateColorPicker(true)
		end)
		RebuildGradientMarkers()
	end

	function Colorpicker:Set(Value, internalCall)
		local suppliedTransparency
		if type(Value)=="table" then
			if Value.Transparency ~= nil or Value.Alpha ~= nil then
				suppliedTransparency = Value.Transparency or Value.Alpha
			end
			Value = Value.Color or Value.Value or Value[1] or Colorpicker.Value
		end
		if GradientMode then
			if typeof(Value) == "ColorSequence" then
				local transparency = typeof(suppliedTransparency) == "NumberSequence" and suppliedTransparency or BuildGradientTransparency()
				LoadGradientStops(Value, transparency)
				if RebuildGradientMarkers then RebuildGradientMarkers() end
			elseif typeof(Value) == "Color3" then
				GradientStops[SelectedGradientStop].Color = Value
			else
				return self
			end
			if typeof(suppliedTransparency) == "NumberSequence" then
				for _, stop in ipairs(GradientStops) do stop.Transparency = SampleTransparency(suppliedTransparency, stop.Time) end
			elseif typeof(suppliedTransparency) == "number" then
				for _, stop in ipairs(GradientStops) do stop.Transparency = math.clamp(suppliedTransparency, 0, 1) end
			end
			local selected = GradientStops[SelectedGradientStop]
			ColorH, ColorS, ColorV = Color3.toHSV(selected.Color)
			ColorA = selected.Transparency
		else
			if typeof(Value) == "ColorSequence" then Value = Value.Keypoints[1].Value end
			if typeof(Value) ~= "Color3" then return self end
			if typeof(suppliedTransparency) == "number" then ColorA = math.clamp(suppliedTransparency, 0, 1) end
			ColorH, ColorS, ColorV = Color3.toHSV(Value)
		end
		suppressColorCallback = true
		UpdateColorPicker(true)
		suppressColorCallback = false
		if not internalCall then
			SafeCallback(ColorpickerConfig.Callback, ColorpickerConfig.Name or "Colorpicker", Colorpicker.Value, Colorpicker.Transparency, Colorpicker)
			self:_EmitChanged(Colorpicker.Value, Colorpicker.Transparency)
		end
		if XLQPGen1.SaveCfg and self.Save and not internalCall then pcall(SaveCfg, game.GameId) end
		return self
	end

	function Colorpicker:SetTransparency(Value, internalCall)
		if GradientMode and typeof(Value) == "NumberSequence" then
			for _, stop in ipairs(GradientStops) do stop.Transparency = SampleTransparency(Value, stop.Time) end
			ColorA = GradientStops[SelectedGradientStop].Transparency
		else
			ColorA = math.clamp(tonumber(Value) or 0, 0, 1)
		end
		suppressColorCallback = true
		UpdateColorPicker(true)
		suppressColorCallback = false
		if not internalCall then
				SafeCallback(ColorpickerConfig.Callback, ColorpickerConfig.Name or "Colorpicker", Colorpicker.Value, Colorpicker.Transparency, Colorpicker)
			self:_EmitChanged(Colorpicker.Value, Colorpicker.Transparency)
		end
		if XLQPGen1.SaveCfg and self.Save and not internalCall then pcall(SaveCfg, game.GameId) end
		return self
	end

	function Colorpicker:Reset()
		if GradientMode then
			self:Set({Color = DefaultGradient, Transparency = DefaultGradientTransparency}, false)
		else
			self:Set({Color = ColorpickerConfig.Default, Transparency = DefaultAlpha}, false)
		end
	end
