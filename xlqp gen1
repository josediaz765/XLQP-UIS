		local function intersectionArea(ax, ay, aw, ah, bx, by, bw, bh)
			local left = math.max(ax, bx)
			local topEdge = math.max(ay, by)
			local right = math.min(ax + aw, bx + bw)
			local bottom = math.min(ay + ah, by + bh)
			if right <= left or bottom <= topEdge then return 0 end
			return (right - left) * (bottom - topEdge)
		end
		local function overflowScore(px, py, pw, ph, viewport)
			local score = 0
			if px < 8 then score = score + (8 - px) * 1000 end
			if py < 8 then score = score + (8 - py) * 1000 end
			if px + pw > viewport.X - 8 then score = score + (px + pw - viewport.X + 8) * 1000 end
			if py + ph > viewport.Y - 8 then score = score + (py + ph - viewport.Y + 8) * 1000 end
			return score
		end
		local function updateGuidePosition(animated)
			if not (gui and gui.Parent and currentStep) then return end
			local target = isActuallyVisible(currentTarget) and currentTarget or ctx.MainWindow
			if not (target and target.Parent) then return end
			scrollIntoView(target)
			local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
			local ap = target.AbsolutePosition
			local size = target.AbsoluteSize
			local margin = 5
			local x = math.clamp(ap.X - margin, 4, math.max(4, viewport.X - 22))
			local y = math.clamp(ap.Y - margin, 4, math.max(4, viewport.Y - 22))
			local width = math.clamp(size.X + margin * 2, 20, math.max(20, viewport.X - x - 4))
			local height = math.clamp(size.Y + margin * 2, 20, math.max(20, viewport.Y - y - 4))
			local props = {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height)}
			if animated then
				if guideTween then pcall(function() guideTween:Cancel() end) end
				guideTween = TweenService:Create(ring, TweenInfo.new(0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
				guideTween:Play()
			else
				ring.Position = props.Position
				ring.Size = props.Size
			end
			local cardWidth = math.clamp(math.floor(viewport.X * 0.46), 276, 368)
			cardWidth = math.min(cardWidth, math.max(250, viewport.X - 16))
			local bodyMeasure = TextService:GetTextSize(tostring(currentStep[2] or ""), 13, Enum.Font.Gotham, Vector2.new(math.max(210, cardWidth - 28), 1000))
			local cardHeight = math.clamp(92 + bodyMeasure.Y, 134, math.min(184, math.max(134, viewport.Y - 16)))
			card.Size = UDim2.fromOffset(cardWidth, cardHeight)
			body.Size = UDim2.new(1, 0, 0, math.max(42, cardHeight - 88))
			local gap = 8
			local candidates = {
				{x + width * 0.5 - cardWidth * 0.5, y + height + gap},
				{x + width * 0.5 - cardWidth * 0.5, y - cardHeight - gap},
				{x + width + gap, y + height * 0.5 - cardHeight * 0.5},
				{x - cardWidth - gap, y + height * 0.5 - cardHeight * 0.5}
			}
			local bestX, bestY, bestScore
			for _, candidate in ipairs(candidates) do
				local px, py = candidate[1], candidate[2]
				local score = overflowScore(px, py, cardWidth, cardHeight, viewport)
				score = score + intersectionArea(px, py, cardWidth, cardHeight, x, y, width, height) * 20
				if not bestScore or score < bestScore then bestX, bestY, bestScore = px, py, score end
			end
			bestX = math.clamp(bestX or 8, 8, math.max(8, viewport.X - cardWidth - 8))
			bestY = math.clamp(bestY or 8, 8, math.max(8, viewport.Y - cardHeight - 8))
			card.Position = UDim2.fromOffset(bestX, bestY)
		end
		local function closeGuide(save)
			if save and writefile then
				pcall(function()
					if makefolder and (not isfolder or not isfolder(folder)) then makefolder(folder) end
					writefile(path, HttpService:JSONEncode({seen = true, time = os.time()}))
				end)
			end
			if guideConn then guideConn:Disconnect() guideConn = nil end
			if guideTween then pcall(function() guideTween:Cancel() end) guideTween = nil end
			self._GuideRunning = false
			if self._GuideRunId == guideRunId then self._GuideRunId = self._GuideRunId + 1 end
			if gui and gui.Parent then gui:Destroy() end
		end
		local function show(stepIndex)
			index = math.clamp(stepIndex, 1, #steps)
			local step = steps[index]
			if step[4] then pcall(step[4]) end
			task.delay(0.16, function()
				currentStep = step
				currentTarget = isActuallyVisible(step[3]) and step[3] or ctx.MainWindow
				if not (gui and gui.Parent and currentTarget and currentTarget.Parent) then return end
				scrollIntoView(currentTarget)
				title.Text = step[1]
				body.Text = step[2]
				count.Text = tostring(index) .. "/" .. tostring(#steps)
				nextButton.Text = index >= #steps and "Finish" or "Next"
				card.Visible = true
				shade.Visible = true
				ring.Visible = true
				updateGuidePosition(true)
			end)
		end
		guideConn = AddConnection(RunService.RenderStepped,function()
			if self._GuideRunId ~= guideRunId or not (self._GuideRunning and gui and gui.Parent) then
				if guideConn then guideConn:Disconnect() guideConn = nil end
				return
			end
			updateGuidePosition(false)
		end)
		local guideClickLock = false
		local function bind(button, callback)
			button.Activated:Connect(function()
				if guideClickLock then return end
				guideClickLock = true
				pcall(callback)
				task.delay(0.14, function() guideClickLock = false end)
			end)
		end
		bind(nextButton, function() if index >= #steps then closeGuide(false) else show(index + 1) end end)
		bind(skip, function() closeGuide(false) end)
		bind(dont, function() closeGuide(true) end)
		show(1)
	end)
end
function XLQPGen1:StartGuide(force)
	if not self._GuideContext then return end
	local ctx={}
	for k,v in pairs(self._GuideContext) do
		ctx[k]=v
