XLQPGen1._PremiumElements = XLQPGen1._PremiumElements or {}
XLQPGen1.PremiumUnlocked = false
XLQPGen1.PremiumTier = nil

function XLQPGen1:GetPremiumConfig()
	local config = self._PremiumConfig
	return type(config) == "table" and config or {}
end

function XLQPGen1:IsPremiumUnlocked()
	return self.PremiumUnlocked == true
end

function XLQPGen1:GetPremiumTier()
	return self.PremiumTier
end

function XLQPGen1:SetPremiumUnlocked(value, tier)
	local unlocked = value == true
	self.PremiumUnlocked = unlocked
	self.PremiumTier = unlocked and (tier or self.PremiumTier or "Premium") or nil
	for _, entry in ipairs(self._PremiumElements or {}) do
		local object = entry.Object
		if type(object) == "table" then
			if unlocked then
				if type(object.Unlock) == "function" then pcall(function() object:Unlock() end) end
			elseif entry.Config and entry.Config.Unlocked ~= true then
				if type(object.Lock) == "function" then pcall(function() object:Lock() end) end
			end
		end
		if entry.Badge and entry.Badge.Parent then entry.Badge.Visible = not unlocked end
	end
	if type(self._PremiumRefreshButton) == "function" then pcall(self._PremiumRefreshButton) end
	if type(self._BetaPremiumRefresh) == "function" then pcall(self._BetaPremiumRefresh) end
	local config = self:GetPremiumConfig()
	SafeCallback(config.Callback, "Premium", unlocked, self.PremiumTier)
	return unlocked
end

function XLQPGen1:_PremiumKeyPath()
	local folder = tostring(self.Folder or "XLQPGen1")
	return folder .. "/premium-key.txt"
end

function XLQPGen1:SavePremiumKey(key)
	local config = self:GetPremiumConfig()
	if config.Save == false then return false end
	if not (writefile and isfolder and makefolder) then return false end
	local ok = pcall(function()
		local folder = tostring(self.Folder or "XLQPGen1")
		if not isfolder(folder) then makefolder(folder) end
		writefile(self:_PremiumKeyPath(), tostring(key or ""))
	end)
	return ok
end

function XLQPGen1:LoadPremiumKey()
	if not (readfile and isfile) then return nil end
	local ok, contents = pcall(function()
		local path = self:_PremiumKeyPath()
		if isfile(path) then return readfile(path) end
		return nil
	end)
	if ok and type(contents) == "string" and contents ~= "" then return contents end
	return nil
end

function XLQPGen1:RedeemPremiumKey(key)
	key = tostring(key or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if key == "" then return false, "Enter a licence key." end
	local config = self:GetPremiumConfig()
	local validator = config.Validate or config.Validator or config.Check or config.Api
	if type(validator) == "function" then
		local ok, accepted, tier = pcall(validator, key, Players and Players.LocalPlayer or nil)
		if not ok then return false, "The key server could not be reached." end
		if accepted == false or accepted == nil then
			return false, type(tier) == "string" and tier or "That key is not valid."
		end
		local resolvedTier = tier
		if type(accepted) == "string" and resolvedTier == nil then resolvedTier = accepted end
		self:SetPremiumUnlocked(true, resolvedTier)
		self:SavePremiumKey(key)
		return true, resolvedTier or "Premium"
	end
	local keys = config.Keys
	if type(keys) == "string" then keys = {keys} end
	if type(keys) == "table" then
		for _, candidate in pairs(keys) do
			if tostring(candidate) == key then
				self:SetPremiumUnlocked(true, config.Tier or "Premium")
				self:SavePremiumKey(key)
				return true, config.Tier or "Premium"
			end
		end
	end
	return false, "That key is not valid."
end

