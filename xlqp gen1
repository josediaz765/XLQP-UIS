       elseif code <= 3 then
           return icons.Weather.Cloudy
       elseif code >= 45 and code <= 48 then
           return icons.Weather.Fog
       elseif (code >= 51 and code <= 67) or (code >= 80 and code <= 82) then
           return icons.Weather.Rain
       elseif code >= 71 and code <= 77 or (code >= 85 and code <= 86) then
