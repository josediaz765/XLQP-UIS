    function Dropdown:RefreshPlayers()
        if not self.Players then return end
        if self.PVP then pcall(function() XLQPGen1:GetPVPScriptUsers(false) end) end
        local savedSelected = {}
        for k, v in pairs(self.SelectedValues or {}) do
            if v then savedSelected[k] = true end
        end
        local options = {}
        local seen = {}
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if not self.PVP or XLQPGen1:IsPlayerPVPReady(player) then
                local option = makePlayerOption(player, true)
                seen[tostring(option.UserId)] = true
                table.insert(options, option)
            end
        end
        for _, meta in pairs(self.PlayerMeta or {}) do
            local selected = savedSelected[meta.Name] or (meta.UserId and savedSelected[tostring(meta.UserId)])
            if selected and meta.UserId and not seen[tostring(meta.UserId)] then
                local offlineMeta = {}
                for k, v in pairs(meta) do offlineMeta[k] = v end
                offlineMeta.Status = "Offline"
                table.insert(options, offlineMeta)
            end
        end
        self.PlayerMeta = {}
        self:Refresh(options, true, true)
        for k, v in pairs(savedSelected) do
            self.SelectedValues[k] = v
        end
        self:Set(self:GetSelectedPlayers())
        self:RefreshWhitelist()
    end

    function Dropdown:Refresh(Options, Delete, KeepSelected)
		local previousValue
		if not self.MultiSelect then previousValue=self.Value end
		local incoming={}
		for _,option in ipairs(type(Options)=="table" and Options or {}) do
			incoming[#incoming+1]=option
		end
        if Delete then
            for _,v in pairs(Dropdown.Buttons) do
                if v and v.Parent then pcall(function() v:Destroy() end) end
            end
            table.clear(Dropdown.Options)
            table.clear(Dropdown.Buttons)
            if self.MultiSelect and not KeepSelected then
                table.clear(self.SelectedValues)
                selectedLabel.Text = "Select options"
            end
        end
        Dropdown.Options = incoming
        AddOptions(Dropdown.Options)
		if not self.MultiSelect then self:Set(previousValue,true) end
		queueDropdownLayout(false)
    end

    function Dropdown:Set(Value, Silent)
        if self.MultiSelect then
            table.clear(self.SelectedValues)
            if type(Value) == "table" then
                for _, v in ipairs(Value) do
                    if type(v) == "table" then
                        if v.Name then self.SelectedValues[v.Name] = true end
                        if v.UserId then self.SelectedValues[tostring(v.UserId)] = true end
                    else
                        self.SelectedValues[v] = true
                    end
                end
            end
            
            for optKey, optButton in pairs(self.Buttons) do
                local isSelected = self.SelectedValues[optKey]
                local stroke = optButton:FindFirstChild("SelectionStroke")
                local title = optButton:FindFirstChild("Title")
                local checkmark = optButton:FindFirstChild("Checkmark")
                
                if stroke then
                    stroke.Enabled = true
                    TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = isSelected and 0 or 1}):Play()
                end
                if title then
                    TweenService:Create(title, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextTransparency = isSelected and 0 or 0.4}):Play()
                end
                if checkmark then
                    TweenService:Create(checkmark, TweenInfo.new(0.2), {ImageTransparency = isSelected and 0 or 1}):Play()
                end
                
                if isSelected then
                    if DropdownConfig.Fill then
                        optButton.BackgroundColor3 = finalFillColor
                        optButton.BackgroundTransparency = tonumber(DropdownConfig.FillTransparency) or 0.5
                    end
                else
                    optButton.BackgroundColor3 = XLQPGen1.Themes.Default.Main
                    optButton.BackgroundTransparency = 1
                end
            end
            
            local selectedCount = 0
            for k,v in pairs(self.SelectedValues) do
                if v and not tonumber(k) then
                    selectedCount = selectedCount + 1
                end
            end
            selectedLabel.Text = selectedCount > 0 and ("Selected: "..selectedCount) or "Select options"
            
            local selected = {}
            for k, v in pairs(self.SelectedValues) do
                if v and not tonumber(k) then table.insert(selected, k) end
            end
            if self.Whitelist then
                self:RefreshWhitelist()
            end
			if not Silent then SafeCallback(DropdownConfig.Callback, DropdownConfig.Name or "Dropdown", selected, self.Players and self:GetSelectedPlayers() or nil, self.Whitelist and self:GetWhitelist() or nil) end
        else
            local found = false
            for _, opt in ipairs(Dropdown.Options) do
                local optName = type(opt) == "table" and opt.Name or opt
                if optName == Value then
                    found = true
                    break
                end
            end
            if not found then
                if #Dropdown.Options > 0 then
                    Dropdown.Value = type(Dropdown.Options[1]) == "table" and Dropdown.Options[1].Name or Dropdown.Options[1]
                else
                    Dropdown.Value = "..."
                end
            else
                Dropdown.Value = Value
            end

            if DropdownFrame and DropdownFrame.F and DropdownFrame.F.Selected then
                DropdownFrame.F.Selected.Text = Dropdown.Value
                if DropdownConfig.FontPreview then
                    local selectedFont,_,selectedFace=XLQPResolveFont(Dropdown.Value)
                    DropdownFrame.F.Selected:SetAttribute("XLQPPreserveFont",true)
                    DropdownFrame.F.Selected.TextStrokeTransparency=1
                    if selectedFace then pcall(function() DropdownFrame.F.Selected.FontFace=selectedFace end) else DropdownFrame.F.Selected.Font=selectedFont end
                end
            end

            for optKey, optButton in pairs(Dropdown.Buttons) do
                local isSelected = (optKey == Dropdown.Value)
                local stroke = optButton:FindFirstChild("SelectionStroke")
                local title = optButton:FindFirstChild("Title")

                if stroke then
                    stroke.Enabled = true
                    TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = isSelected and 0 or 1}):Play()
                end
                if title then
                    TweenService:Create(title, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextTransparency = isSelected and 0 or 0.4}):Play()
                end
                
                if isSelected and DropdownConfig.Fill then
                    optButton.BackgroundColor3 = finalFillColor
                    optButton.BackgroundTransparency = tonumber(DropdownConfig.FillTransparency) or 0.5
                elseif not isSelected then
                    optButton.BackgroundColor3 = XLQPGen1.Themes.Default.Main
                    optButton.BackgroundTransparency = 1
                end
            end

					if not Silent then SafeCallback(DropdownConfig.Callback, DropdownConfig.Name or "Dropdown", Dropdown.Value) end
        end
        if not Silent then self:_EmitChanged(self.MultiSelect and self:GetSelected() or self.Value) end
    end

    function Dropdown:UpdateAppearance()
        task.spawn(function()
            task.wait(0.15)
            for label, button in pairs(self.Buttons or {}) do
                local isSelected = self.MultiSelect and self.SelectedValues[label] or (self.Value == label)
                
                if button then
                    if isSelected then
                        if DropdownConfig.Fill then
                            button.BackgroundColor3 = finalFillColor
                            button.BackgroundTransparency = tonumber(DropdownConfig.FillTransparency) or 0.5
                        end
                        if DropdownConfig.Outline then
                            local stroke = button:FindFirstChild("SelectionStroke")
                            if stroke then
                                stroke.Enabled = true
                                stroke.Transparency = 0
                            end
                        end
                    else
                        button.BackgroundColor3 = XLQPGen1.Themes.Default.Main
                        button.BackgroundTransparency = 1
                        if DropdownConfig.Outline then
                            local stroke = button:FindFirstChild("SelectionStroke")
                            if stroke then
                                stroke.Enabled = false
                                stroke.Transparency = 1
                            end
                        end
                    end
                end
            end
        end)
    end

    AddConnection(Click.MouseButton1Click, function()
        if DropdownConfig.Locked then return end
        Dropdown.Toggled = not Dropdown.Toggled
        if DropdownFrame and DropdownFrame.F and DropdownFrame.F.Line then
            DropdownFrame.F.Line.Visible = Dropdown.Toggled
        end
        if DropdownFrame and DropdownFrame.F and DropdownFrame.F.Ico then
            TweenService:Create(DropdownFrame.F.Ico,TweenInfo.new(.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),{Rotation = Dropdown.Toggled and 180 or 0}):Play()
        end
        
        if searchContainer then searchContainer.Visible = Dropdown.Toggled end
        if bulkActions then bulkActions.Visible = Dropdown.Toggled and DropdownConfig.SelectAllButtons end
		if not Dropdown.Toggled then releaseParentScrolls() end
		queueDropdownLayout(true)
    end)
    
    if searchBox then
        AddConnection(searchBox:GetPropertyChangedSignal("Text"), function()
            local query = searchBox.Text:lower()
            for name, button in pairs(Dropdown.Buttons) do
                button.Visible = (query == "" or name:lower():find(query, 1, true))
            end
			queueDropdownLayout(true)
        end)
    end

    if Dropdown.Players then
        Dropdown:RefreshPlayers()
        local playersService = game:GetService("Players")
        table.insert(Dropdown.PlayerConnections, playersService.PlayerAdded:Connect(function()
            task.defer(function()
                Dropdown:RefreshPlayers()
            end)
        end))
        table.insert(Dropdown.PlayerConnections, playersService.PlayerRemoving:Connect(function()
            task.defer(function()
                Dropdown:RefreshPlayers()
            end)
        end))
    else
        Dropdown:Refresh(Dropdown.Options, false)
    end
    if Dropdown.MultiSelect then
        if type(DropdownConfig.Default) == "table" then
            Dropdown:Set(DropdownConfig.Default, DropdownConfig.InitialCallback == false)
        end
    else
        Dropdown:Set(DropdownConfig.Default, DropdownConfig.InitialCallback == false)
    end
    if DropdownConfig.Flag then
        XLQPGen1.Flags[DropdownConfig.Flag] = Dropdown
    end
    return Dropdown
end
