   function normResponse(res)
       local c = 0
       local b = ""
       if res then
           c = res.StatusCode or res.Status or res.status or 0
           b = res.Body or res.body or ""
           if type(b) ~= "string" then
               b = tostring(b)
           end
       end
       return tonumber(c) or 0, b
   end

   function normalizeAssistantText(value)
       value = tostring(value or ""):lower()
       value = value:gsub("[%c%p]+", " "):gsub("%s+", " ")
       return value
   end

   function resolveAssistantActionIntent(q)
       local text = normalizeAssistantText(q)
       if text:find("who is", 1, true) or text:find("what is", 1, true) or text:find("tell me about", 1, true) or text:find("explain", 1, true) or text:find("how to", 1, true) then
           return false
       end
       if text:find("script", 1, true) or text:find("code", 1, true) or text:find("source", 1, true) or text:find("fix", 1, true) then
           return false
       end
       local terms = {"set my", "change my", "make my", "turn on", "turn off", "enable", "disable", "run ", "execute ", "click ", "press ", "toggle ", "walkspeed", "jump power", "jumpheight", "fov", "print players", "list players", "player names"}
       for _, term in ipairs(terms) do
           if text:find(term, 1, true) then return true end
       end
       return false
   end

   function buildPrompt(q)
       local intent = resolveAssistantActionIntent(q) and "ACTION_COMMAND" or "GENERAL_CONVERSATION"
       local p = "You are Verbal Hub AI inside a Roblox executor UI, but you are a general assistant first. Do not assume every message is about Roblox. UI_INTENT: " .. intent .. ". GENERAL_CONVERSATION: answer naturally without code, without Roblox script suggestions, and without Lua. Questions like 'who is ...' must be answered as normal factual questions. ACTION_COMMAND: only when UI_INTENT is ACTION_COMMAND, return only one complete Roblox Lua script inside a lua markdown block and no explanation. SCRIPT_OR_CODE_REQUEST: if the user asks for code or a script, provide it normally but do not execute it. Never add random Roblox scripts to normal answers."
       return p .. "\nUser: " .. q
   end

