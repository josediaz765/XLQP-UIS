			local installBtn=SetChildren(SetProps(MakeElement("Button"),{Size=UDim2.new(0,72,0,26),Position=UDim2.new(1,-82,0.5,-13),BackgroundTransparency=0}),{MakeElement("Corner",0,6),AddThemeObject(SetProps(MakeElement("Label","Install",11),{Size=UDim2.fromScale(1,1),Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Center}),"Text")})
