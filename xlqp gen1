	local file=tostring(self.CustomLiveMediaThemesFile or "XLQPGen1/LiveColors/CustomMedia/themes.json")
	if type(readfile)=="function" and type(isfile)=="function" and isfile(file) then
		local ok,raw=pcall(readfile,file)
		if ok and type(raw)=="string" and raw~="" then
			local decodeOk,data=pcall(HttpService.JSONDecode,HttpService,raw)
			if decodeOk and type(data)=="table" then themes=data end
