			local columnUpdateQueued = false
			local columnUpdating = false
			local function updateColumnLayout()
				if columnUpdating or not columnHost or not columnHost.Parent or not columnLayout or not leftColumn or not rightColumn then return end
				columnUpdating = true
				local width = columnHost.AbsoluteSize.X
				local stacked = width > 0 and width < 620
				local leftHeight = leftLayout and stableListHeight(leftColumn, leftLayout, 0) or 0
				local rightHeight = rightLayout and stableListHeight(rightColumn, rightLayout, 0) or 0
				columnLayout.FillDirection = stacked and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
