			end
			local function finish(input)
				if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then drawing=false lastFreePoint=nil end
			end
			local cursor=AddThemeObject(SetProps(MakeElement("Image","brush"),{Name="BrushCursor",Size=UDim2.new(0,24,0,24),BackgroundTransparency=1,Visible=false,ZIndex=130,Parent=canvas}),"Text")
			local colorButton
			colorButton=makeTool("Color",70,function()
