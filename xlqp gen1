       task.spawn(function()
           local locSuccess, locData = pcall(function()
               return HttpService:JSONDecode(game:HttpGet("https://ipinfo.io/json", true))
           end)
           if locSuccess and locData then
               local cityStr = translateText("City", selectedLanguage)
               local regionStr = translateText("Region", selectedLanguage)
               local countryStr = translateText("Country", selectedLanguage)
               local ispStr = translateText("ISP", selectedLanguage)
               local timezoneStr = translateText("Timezone", selectedLanguage)
               locationContent.Text = string.format("%s: %s\n%s: %s", cityStr, locData.city or "N/A", regionStr, locData.region or "N/A")
               regionContent.Text = string.format("%s: %s\n%s: %s", regionStr, locData.region or "N/A", countryStr, locData.country or "N/A")
               networkContent.Text = string.format("%s: %s\n%s: %s", ispStr, locData.org or "N/A", timezoneStr, locData.timezone or "N/A")
               if locData.loc then
                   local parts = locData.loc:split(",")
                   latitude, longitude = tonumber(parts[1]) or 0, tonumber(parts[2]) or 0
               end
           else
               locationContent.Text="Unavailable"
               regionContent.Text="Unavailable"
               networkContent.Text="Unavailable"
           end
           if latitude ~= 0 and longitude ~= 0 then
               local weatherUrl = "https://api.open-meteo.com/v1/forecast?latitude=" .. latitude .. "&longitude=" .. longitude .. "&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,cloud_cover,surface_pressure,wind_speed_10m,wind_direction_10m&timezone=auto"
