	function TabFunction:SetThemeColor(key, color)
		if typeof(color) ~= "Color3" then return self end
		key = tostring(key or "Main")
		local base = XLQPGen1.Themes[XLQPGen1.SelectedTheme] or XLQPGen1.Themes.Default
		XLQPGen1.Themes.Custom = XLQPGen1.Themes.Custom or {}
		for themeKey, themeValue in pairs(base) do
			XLQPGen1.Themes.Custom[themeKey] = themeValue
		end
		XLQPGen1.Themes.Custom[key] = color
		if key == "Text" and not XLQPGen1._CustomTextDarkExplicit then
			XLQPGen1.Themes.Custom.TextDark = color:Lerp(Color3.fromRGB(128, 128, 128), 0.35)
		elseif key == "TextDark" then
			XLQPGen1._CustomTextDarkExplicit = true
		end
		XLQPGen1.SelectedTheme = "Custom"
		local now=os.clock()
		XLQPGen1._LastThemeColorEdit=now
		if not XLQPGen1._ThemeColorFlushQueued then
			XLQPGen1._ThemeColorFlushQueued=true
			task.defer(function()
				repeat task.wait(0.12) until os.clock()-(XLQPGen1._LastThemeColorEdit or 0)>=0.22 and not XLQPGen1._ThemePickerDragging
				XLQPGen1._ThemeColorFlushQueued=false
				SetTheme()
				if applyNewUIStyle then applyNewUIStyle() end
				if applyNewUITransparency then applyNewUITransparency() end
				if ApplyTheme then ApplyTheme() end
			end)
		end
		return self
	end

