				if stacked then
					totalHeight = leftHeight + rightHeight + ((leftHeight > 0 and rightHeight > 0) and 10 or 0)
				else
					totalHeight = math.max(leftHeight, rightHeight)
				end
				totalHeight = math.clamp(totalHeight, 0, 100000)
				columnStack.Size = UDim2.new(1, 0, 0, totalHeight)
				columnHost.Size = UDim2.new(1, 0, 0, totalHeight)
				columnUpdating = false
			end
				local function queueColumnLayout()
					if WindowConfig._LocalRegisterState.resizeWorkPaused() then WindowConfig._LocalRegisterState.queueResizeFollowup(columnHost,queueColumnLayout) return end
					if columnUpdateQueued then return end
					columnUpdateQueued = true
					task.defer(function()
						columnUpdateQueued = false
						updateColumnLayout()
					end)
				end

				if leftLayout then AddConnection(leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"), queueColumnLayout) end
				if rightLayout then AddConnection(rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"), queueColumnLayout) end
				AddConnection(leftColumn.ChildAdded,function(child)
					if child:IsA("GuiObject") then
						AddConnection(child:GetPropertyChangedSignal("Size"),queueColumnLayout)
						AddConnection(child:GetPropertyChangedSignal("Visible"),queueColumnLayout)
					end
					queueColumnLayout()
				end)
				AddConnection(rightColumn.ChildAdded,function(child)
					if child:IsA("GuiObject") then
						AddConnection(child:GetPropertyChangedSignal("Size"),queueColumnLayout)
						AddConnection(child:GetPropertyChangedSignal("Visible"),queueColumnLayout)
					end
					queueColumnLayout()
				end)
				AddConnection(columnHost:GetPropertyChangedSignal("AbsoluteSize"), queueColumnLayout)
				AddConnection(stackLayout:GetPropertyChangedSignal("AbsoluteContentSize"), queueColumnLayout)
				Create("BindableEvent",{Name="XLQPColumnRefresh",Parent=columnHost})
				AddConnection(columnHost.XLQPColumnRefresh.Event,queueColumnLayout)
