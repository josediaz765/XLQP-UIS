	end
	for i=1,12 do
		Create("Frame",{Size=UDim2.new(0,1,1,-38),Position=UDim2.new(i/13,0,0,34),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.88,BorderSizePixel=0,Parent=frame})
	end
	local bars={}
	local area=Create("Frame",{Size=UDim2.new(1,0,1,-38),Position=UDim2.new(0,0,0,34),BackgroundTransparency=1,Parent=frame})
	for i=1,count do
		local x=(i-1)/math.max(count-1,1)
		local bar=AddThemeObject(Create("Frame",{AnchorPoint=Vector2.new(0.5,1),Size=UDim2.new(0,math.max(2,math.floor(420/count)),0,2),Position=UDim2.new(x,0,1,0),BackgroundColor3=Color3.fromRGB(245,245,245),BorderSizePixel=0,Parent=area},{MakeElement("Corner",0,2)}),"Text")
		bars[i]={Obj=bar,Level=0,Phase=math.random()*10}
	end
	local visualizer={Frame=frame,Sound=nil,Enabled=config.Enabled~=false,Last=0,Connection=nil}
	function visualizer:SetEnabled(value)
		self.Enabled=value~=false
		frame.Visible=self.Enabled
	end
	function visualizer:Bind(sound)
		self.Sound=sound
	end
	function visualizer:Stop()
		self.Sound=nil
		for _,bar in ipairs(bars) do
			bar.Level=0
			bar.Obj.Size=UDim2.new(bar.Obj.Size.X.Scale,bar.Obj.Size.X.Offset,0,2)
		end
	end
	visualizer.Connection=AddConnection(RunService.Heartbeat,function()
		if not visualizer.Enabled or not frame.Parent then return end
		if (tonumber(XLQPGen1._WindowMotionPausedUntil) or 0)>os.clock() then return end
		if WindowConfig._LocalRegisterState.isGuiBranchVisible and not WindowConfig._LocalRegisterState.isGuiBranchVisible(frame) then return end
		local now=os.clock()
		if now-visualizer.Last<0.045 then return end
		visualizer.Last=now
		local sound=visualizer.Sound
		local playing=sound and sound.Parent and sound:IsA("Sound") and sound.IsPlaying
		local loud=0
		local pos=now
		if playing then
			loud=math.clamp((tonumber(sound.PlaybackLoudness) or 0)/700,0,1)
			pos=tonumber(sound.TimePosition) or now
		end
		for i,bar in ipairs(bars) do
			local f=i/count
			local wave=(math.noise(pos*2.2,bar.Phase,0)+1)/2
			local shape=(1-f)^0.45
			if playing and loud <= 0.02 then loud=0.38 end
			local target=playing and math.clamp((loud*0.55+wave*0.45)*shape+math.random()*0.04,0.04,1) or 0.08
			bar.Level=bar.Level+(target-bar.Level)*0.32
			bar.Obj.Size=UDim2.new(bar.Obj.Size.X.Scale,bar.Obj.Size.X.Offset,bar.Level,0)
			bar.Obj.BackgroundTransparency=playing and math.clamp(0.08+f*0.35,0.08,0.52) or 0.7
		end
	end)
	return visualizer
end

function XLQPGen1:LoadVerbalChatAPI(url)
	local function alias(api)
		if type(api)~="table" then return nil end
		local proxy={}
		pcall(function() setmetatable(proxy,{__index=api}) end)
		proxy.getGlobalMessages=api.getGlobalMessages or api.GetGlobalMessages or api.RefreshGlobalMessages or api.refreshGlobalMessages
		proxy.sendGlobalMessage=api.sendGlobalMessage or api.SendGlobalMessage or api.SendGlobal or api.sendGlobal
		proxy.getDirectMessages=api.getDirectMessages or api.GetDirectMessages or api.GetDMMessages or api.getDMMessages or api.GetDMs or api.getDMs
		proxy.sendDirectMessage=api.sendDirectMessage or api.SendDirectMessage or api.SendDM or api.sendDM or api.SendPrivateMessage or api.sendPrivateMessage
		proxy.reportPlayer=api.reportPlayer or api.ReportPlayer or api.SubmitReport or api.submitReport or api.SendReport or api.sendReport or api.ReportUser or api.reportUser
		return proxy
	end
	local function valid(api)
		api=alias(api)
		return type(api)=="table" and type(api.getGlobalMessages)=="function" and type(api.sendGlobalMessage)=="function"
	end
	local function full(api)
		api=alias(api)
		return type(api)=="table" and type(api.getGlobalMessages)=="function" and type(api.sendGlobalMessage)=="function" and (type(api.reportPlayer)=="function" or type(api.submitReport)=="function" or type(api.sendReport)=="function" or type(api.reportUser)=="function" or type(api.reportMessage)=="function" or type(api.createReport)=="function")
	end
	local function saveAPI(api)
		api=alias(api)
		if type(api)~="table" then return nil end
		self.VerbalGlobalChatAPI=api
		self.VerbalChatAPI=api
		pcall(function() rawset(_G,"VerbalChatAPI",api) end)
		pcall(function() rawset(shared,"VerbalChatAPI",api) end)
		pcall(function() if getgenv then rawset(getgenv(),"VerbalChatAPI",api) end end)
		pcall(function() rawset(_G,"VH_CHAT_READY",true) end)
		pcall(function() rawset(shared,"VH_CHAT_READY",true) end)
		pcall(function() if getgenv then rawset(getgenv(),"VH_CHAT_READY",true) end end)
		return api
	end
	if full(self.VerbalGlobalChatAPI) then return self.VerbalGlobalChatAPI end
	if full(self.VerbalChatAPI) then return saveAPI(self.VerbalChatAPI) end
	local API_URL=XLQPGlobalChatAuthUrl
	local function getRequest()
		return XLQPResolveRequest()
	end
	local function pickAPI()
		local api
		pcall(function() api=rawget(_G,"VerbalChatAPI") end)
		if type(api)~="table" then pcall(function() api=rawget(shared,"VerbalChatAPI") end) end
		if type(api)~="table" and getgenv then pcall(function() api=rawget(getgenv(),"VerbalChatAPI") end) end
		return api
	end
	local function fetchSource(sourceUrl)
		sourceUrl=tostring(sourceUrl or API_URL)
		local fullUrl=sourceUrl..(sourceUrl:find("?",1,true) and "&" or "?").."cb="..tostring(os.time())..tostring(math.random(1000,9999))
		local body=""
		pcall(function() body=game:HttpGet(fullUrl,true) end)
		if type(body)=="string" and body~="" then return body end
		local req=getRequest()
		if req then
			local ok,res=pcall(function()
				return req({Url=fullUrl,Method="GET",Headers={["User-Agent"]="Mozilla/5.0",["Cache-Control"]="no-cache"}})
			end)
			if ok and res then return res.Body or res.body or "" end
		end
		return ""
	end
	local function nestedSource(source)
		if type(source)~="string" or source=="" then return source end
		if source:find("API%[\"getGlobalMessages\"%]",1) or source:find("function%s+API[:%.]getGlobalMessages",1) then return source end
		local nested=source:match("local%s+API_URL%s*=%s*\"([^\"]+)\"") or source:match("API_URL%s*=%s*\"([^\"]+)\"") or source:match("ApiUrl%s*=%s*\"([^\"]+)\"")
		if source:find("GlobalChatDMGui",1,true) or source:find("local%s+API%s*=%s*loadAPI%(") then
			local body=fetchSource("https://raw.githubusercontent.com/josediaz765/Hi/main/api_wrapper.lua")
			if type(body)=="string" and body~="" then
				API_URL=XLQPGlobalChatAuthUrl
				return body
			end
			return ""
		end
		if type(nested)=="string" and nested~="" and nested~=API_URL then
			local body=fetchSource(nested)
			if type(body)=="string" and body~="" then
				API_URL=nested
				return body
			end
		end
		return source
	end
	local api=pickAPI()
	if full(api) then return saveAPI(api) end
	pcall(function() rawset(_G,"VerbalChatAPI",nil) rawset(_G,"VH_CHAT_READY",nil) end)
	pcall(function() rawset(shared,"VerbalChatAPI",nil) rawset(shared,"VH_CHAT_READY",nil) end)
	pcall(function() if getgenv then rawset(getgenv(),"VerbalChatAPI",nil) rawset(getgenv(),"VH_CHAT_READY",nil) end end)
	local lastErr="failed to fetch api wrapper"
	local source=nestedSource(fetchSource(API_URL))
	if type(source)=="string" and source~="" then
		local fn,err=loadstring(source)
		if fn then
			local ok,result=pcall(fn)
			if ok and type(result)=="table" then
				if full(result) then return saveAPI(result) end
				for _=1,40 do
					api=pickAPI()
					if full(api) then return saveAPI(api) end
					task.wait(0.05)
				end
				if valid(result) then return saveAPI(result) end
			end
			api=pickAPI()
			if valid(api) then return saveAPI(api) end
			if ok and result==nil and source:find("local%s+API_URL%s*=",1) then
				source=nestedSource(source)
				if type(source)=="string" and source~="" then
					fn,err=loadstring(source)
					if fn then
						ok,result=pcall(fn)
						if ok and type(result)=="table" and valid(result) then return saveAPI(result) end
						api=pickAPI()
						if valid(api) then return saveAPI(api) end
					end
				end
			end
			lastErr=ok and "api wrapper did not export VerbalChatAPI, wrapper returned: "..tostring(result) or tostring(result)
		else
			lastErr="api wrapper compile error: "..tostring(err)
		end
	end
	for _=1,120 do
		api=pickAPI()
		if valid(api) then return saveAPI(api) end
		task.wait(0.05)
	end
	return nil,lastErr
end

