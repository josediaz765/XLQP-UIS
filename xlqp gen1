	local function BuildGradientColor()
		local keypoints = {}
		for index, stop in ipairs(GradientStops) do keypoints[index] = ColorSequenceKeypoint.new(stop.Time, stop.Color) end
		return ColorSequence.new(keypoints)
	end
	local function BuildGradientTransparency()
		local keypoints = {}
		for index, stop in ipairs(GradientStops) do keypoints[index] = NumberSequenceKeypoint.new(stop.Time, math.clamp(stop.Transparency or 0, 0, 1)) end
		return NumberSequence.new(keypoints)
	end
	local function SampleGradientColor(position)
		if position <= GradientStops[1].Time then return GradientStops[1].Color end
		for index=2,#GradientStops do
			local right=GradientStops[index]
			if position <= right.Time then
				local left=GradientStops[index-1]
				local span=right.Time-left.Time
				return left.Color:Lerp(right.Color,span>0 and (position-left.Time)/span or 0)
			end
		end
		return GradientStops[#GradientStops].Color
