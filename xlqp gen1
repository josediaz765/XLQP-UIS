    function fetchServers()
       if serverFetchInProgress then
           return
       end
        serverFetchInProgress = true
        serverLastFetchTime = tick()
        clearServerCards()
       cachedServers = {}
       local cursor = nil
       local pages = 0
       repeat
           pages = pages + 1
           local url = ("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100%s"):format(tostring(game.PlaceId), cursor and ("&cursor=" .. HttpService:UrlEncode(cursor)) or "")
           local ok, res = pcall(function()
               return game:HttpGet(url)
           end)
           if not ok then
               break
           end
           local data = nil
           local ok2 = pcall(function()
               data = HttpService:JSONDecode(res)
           end)
           if not ok2 or type(data) ~= "table" or type(data.data) ~= "table" then
               break
           end
           for _, sv in ipairs(data.data) do
               if type(sv) == "table" and sv.id and sv.playing and sv.maxPlayers then
                   table.insert(cachedServers, { id = sv.id, playing = sv.playing, maxPlayers = sv.maxPlayers })
               end
           end
           cursor = data.nextPageCursor
           if pages % 2 == 0 then task.wait() end
       until not cursor or pages >= 2
       table.sort(cachedServers, function(a, b)
           if a.id == game.JobId then
               return true
           end
           if b.id == game.JobId then
               return false
           end
           return a.playing > b.playing
       end)
       for _, sData in ipairs(cachedServers) do
           createServerCard(sData)
       end
       serverFetchInProgress = false
       serversListPage.CanvasSize = UDim2.new(0, 0, 0, serversListLayout.AbsoluteContentSize.Y + 20)
   end

   serverRefreshBtn.Activated:Connect(fetchServers)
   smallJoinBtn.Activated:Connect(function()
       if #cachedServers == 0 then
           fetchServers()
           task.wait(0.5)
       end
       if #cachedServers == 0 then
           return
       end
       local best = nil
       for _, sData in ipairs(cachedServers) do
           if sData.id ~= game.JobId and sData.playing < sData.maxPlayers then
               if not best or sData.playing < best.playing then
                   best = sData
               end
           end
       end
       if best then
           TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, homeLocalPlayer)
       end
   end)

