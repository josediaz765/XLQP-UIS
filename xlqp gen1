	local label=Instance.new("TextLabel",frame) label.Size=UDim2.new(1,-18,1,-14) label.Position=UDim2.fromOffset(9,7) label.BackgroundTransparency=1 label.Text=clean label.TextColor3=Color3.fromRGB(34,34,40) label.TextWrapped=true label.Font=Enum.Font.GothamSemibold label.TextSize=12
	task.delay(6,function() if bubble.Parent then bubble:Destroy() end end)
end

function SharedAIService:HandleWorldCommand(prompt,deferExecution)
	if not self.Config.UltraAI or not self.Config.WorldToolsEnabled then return false,nil end
	local text=tostring(prompt or ""):lower()
	if not (text:find("place",1,true) or text:find("spawn",1,true) or text:find("create",1,true) or text:find("make",1,true)) then return false,nil end
	local player=Players.LocalPlayer
	local root=player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false,nil end
	local position=(root.CFrame*CFrame.new(0,1,-7)).Position
	local object
	local meshId=text:match("mesh%s+(%d+)") or text:match("meshid%s*[:=]?%s*(%d+)")
	if meshId then
		object=Instance.new("MeshPart")
		XLQPAssignProperty(object,"MeshId","rbxassetid://"..meshId)
		object.Size=Vector3.new(4,4,4)
	elseif text:find("ball",1,true) or text:find("sphere",1,true) then
		object=Instance.new("Part")
		object.Shape=Enum.PartType.Ball
		object.Size=Vector3.new(4,4,4)
