	local function pluginsHighlight(code)
		code=tostring(code or "")
		local keywordSet={}
		for _,kw in ipairs({"local","function","end","if","then","else","elseif","return","true","false","nil","for","while","do","repeat","until","and","or","not","break","continue","in","self"}) do
			keywordSet[kw]=true
		end
		local function esc(s) return (s:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;")) end
		local out={}
		local i,n=1,#code
		while i<=n do
			local c=code:sub(i,i)
			if c=="-" and code:sub(i+1,i+1)=="-" then
				local j=code:find("\n",i) or (n+1)
				out[#out+1]="<font color=\"rgb(106,153,85)\">"..esc(code:sub(i,j-1)).."</font>"
				i=j
			elseif c=="\"" or c=="'" then
				local q=c
				local j=i+1
				while j<=n and code:sub(j,j)~=q do
					if code:sub(j,j)=="\\" then j=j+1 end
					j=j+1
				end
				j=math.min(j,n)
				out[#out+1]="<font color=\"rgb(206,145,120)\">"..esc(code:sub(i,j)).."</font>"
				i=j+1
			elseif c:match("%d") then
				local j=i
				while j<=n and code:sub(j,j):match("[%d%.]") do j=j+1 end
				out[#out+1]="<font color=\"rgb(181,206,168)\">"..esc(code:sub(i,j-1)).."</font>"
				i=j
			elseif c:match("[%a_]") then
				local j=i
				while j<=n and code:sub(j,j):match("[%w_]") do j=j+1 end
				local word=code:sub(i,j-1)
				if keywordSet[word] then
					out[#out+1]="<font color=\"rgb(86,156,214)\">"..word.."</font>"
				else
					out[#out+1]=esc(word)
				end
				i=j
			else
				out[#out+1]=esc(c)
				i=i+1
			end
		end
		return table.concat(out)
	end

	function PluginsData:Scan()
		table.clear(self.Items)
		ensurePluginsFolder()
		if listfiles and isfolder and isfolder(PluginsFolder) then
			local ok,files=pcall(listfiles,PluginsFolder)
			if ok and type(files)=="table" then
				for _,path in ipairs(files) do
					local lower=tostring(path):lower()
					if lower:sub(-4)==".lua" or lower:sub(-4)==".txt" or lower:sub(-5)==".luau" then
						local rawName=pluginsStripExt(pluginsBasename(path))
						table.insert(self.Items,{Name=pluginsDisplayName(rawName),Path=path,Kind="File"})
					end
				end
			end
		end
		for _,record in ipairs(self.RuntimeItems) do table.insert(self.Items,record) end
		table.sort(self.Items,function(a,b) return a.Name:lower()<b.Name:lower() end)
		return self.Items
	end
	local function pluginsFindTab(name)
		name=tostring(name or ""):match("^%s*(.-)%s*$") or ""
		if pluginsHomeRestricted(name) then return nil end
		for _,info in ipairs(AllSideTabObjects or {}) do
			if info and info.Name and tostring(info.Name):lower()==name:lower() then
				return GetElements(info.Container)
			end
		end
		for _,info in ipairs(AllTopTabObjects or {}) do
			if info and info.Name and tostring(info.Name):lower()==name:lower() then
				if info.Container then return GetElements(info.Container) end
				for _,side in ipairs(info.SideTabs or {}) do if side and side.Container then return GetElements(side.Container) end end
			end
		for _,side in ipairs(info and info.SideTabs or {}) do
			local compound=tostring(info.Name or "").."/"..tostring(side.Name or "")
			if compound:lower()==name:lower() and side.Container then return GetElements(side.Container) end
		end
		end
		return nil
	end
	local function pluginsListTabs()
		local names,seen={},{ }
		local function add(name)
			name=tostring(name or "")
			local key=name:lower()
			if name~="" and not pluginsHomeRestricted(name) and not seen[key] then seen[key]=true table.insert(names,name) end
		end
		for _,info in ipairs(AllTopTabObjects or {}) do
			if info and info.Name then add(info.Name) end
			for _,side in ipairs(info and info.SideTabs or {}) do if side and side.Name then add(tostring(info.Name).."/"..tostring(side.Name)) end end
		end
		for _,info in ipairs(AllSideTabObjects or {}) do
			if info and info.Name then add(info.Name) end
		end
		table.sort(names,function(a,b) return a:lower()<b:lower() end)
		return names
	end
	local function makePluginAPI(record)
		local api={}
		api.Library=XLQPGen1
