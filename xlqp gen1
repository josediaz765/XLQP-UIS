function XLQPGen1:_ResolveUpdateLogImage(source,config)
	if source==nil then return nil end
	if typeof(source)=="number" then return "rbxassetid://"..tostring(source) end
	if type(source)~="string" then return nil end
	source=source:gsub("^%s+",""):gsub("%s+$","")
	if source=="" then return nil end
	local icon=GetIcon(source)
	if icon and icon~="" then return icon end
	if source:match("^%d+$") then return "rbxassetid://"..source end
	if source:match("^rbxasset") or source:match("^rbxthumb://") or source:match("^content://") or source:match("^synasset://") then return source end
	if not source:match("^https?://") then return source end
	local resolver=XLQPGetCustomAsset
	if not (resolver and writefile and isfile) then return source end
	local folder=tostring((config and (config.AssetFolder or config.Folder)) or ((self._WindowConfig or {}).ConfigFolder) or self.ConfigFolder or "XLQPGen1")
	folder=folder:gsub("\\","/"):gsub("/+$","").."/UpdateLogAssets"
	XLQPSetupEnsureFolder(folder)
	local hash=5381
	for i=1,#source do hash=(hash*33+string.byte(source,i))%2147483647 end
	local file=folder.."/image_"..tostring(hash)..".png"
	if not isfile(file) then
		local body=XLQPSecureHttpGet(source)
		if type(body)=="string" and #body>0 then pcall(writefile,file,body) end
	end
	if isfile(file) then
		local ok,asset=pcall(resolver,file)
		if ok and asset then return asset end
	end
	return source
end
