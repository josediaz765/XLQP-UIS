				ElementFunction[methodName] = function(...)
					local results = table.pack(xpcall(methodValue, function(err)
						local trace = ""
						pcall(function() trace = "\n" .. debug.traceback("", 2) end)
						return tostring(err) .. trace
					end, ...))
					if results[1] then
						if tostring(methodName):sub(1,3)=="Add" and type(results[2])=="table" then
							local elementResult=results[2]
							local parameterInfo=XLQPGen1:GetElementParameters(methodName)
							elementResult.Parameters=parameterInfo.Parameters
							elementResult.ParameterInfo=parameterInfo
							if elementResult.GetParameters==nil then
								elementResult.GetParameters=function()
									return XLQPGen1:GetElementParameters(methodName)
								end
							end
						end
						return table.unpack(results, 2, results.n)
					end
					reportElementFailure(methodName, results[2])
					return elementStub
				end
			end
		end
