 function WindowConfig._LocalRegisterState.cleanFileName(name,fallback)
	name=tostring(name or ""):gsub("^%s+",""):gsub("%s+$","")
	if name=="" then name=tostring(fallback or "Default") end
	name=name:gsub("[\\/:*?\"<>|]","_")
	return name
end

 function WindowConfig._LocalRegisterState.ensureFolder(path)
	if not path or path=="" then return false end
	if isfolder and isfolder(path) then return true end
	if makefolder then
		local ok=pcall(makefolder,path)
		return ok and (not isfolder or isfolder(path))
	end
	return false
end

 function WindowConfig._LocalRegisterState.listNamedFiles(folder,extension)
	local results={}
	if not (listfiles and WindowConfig._LocalRegisterState.ensureFolder(folder)) then return results end
	for _,path in ipairs(listfiles(folder)) do
		local name=tostring(path):match("[^/\\]+$") or tostring(path)
		if not extension or name:sub(-#extension)==extension then
			local cleanName=name
			if extension and extension~="" then
				cleanName=(name:gsub("%"..extension.."$",""))
			end
			results[#results+1]=cleanName
		end
	end
	table.sort(results)
	return results
end

