		local token=renderToken
		local target=math.min(#pendingEntries,maxRenderedEntries,renderedEntries+renderBatchSize)
		for index=renderedEntries+1,target do
			if token~=renderToken or not searchOpen then return end
			local entry=pendingEntries[index]
			if entry.section then makeSection(entry.section,entry.count,index) else makeResult(entry.record,index) end
		end
