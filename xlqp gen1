function installWindowCompatibility(window)
	if not window or window.__VerbalDialogCompat then return window end
	window.__VerbalDialogCompat = true
	window.AddDialog = window.AddDialog or function(self, id, config)
		return XLQPGen1:_CreateDialog(self, id, config)
	end
	window.ShowDialog = window.ShowDialog or window.AddDialog
	window.CreateDialog = window.CreateDialog or window.AddDialog
	window.CreatePopup = window.CreatePopup or function(self, config) return XLQPGen1:CreatePopup(config) end
	window.MakePopup = window.MakePopup or window.CreatePopup
	window.ShowPopup = window.ShowPopup or window.CreatePopup
	window.SetDestructor = window.SetDestructor or function(self, callback)
		XLQPGen1._WindowDestructor = type(callback) == "function" and callback or nil
		return self
	end
	window.Unload = window.Unload or function(self)
		XLQPGen1:Destroy()
		return self
	end
	return window
end

function XLQPGen1:MakeWindow(config)
