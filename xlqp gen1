	local function setScaleFromX(x)
		if not scaleTrack then return end
		local left=scaleTrack.AbsolutePosition.X
		local width=math.max(1,scaleTrack.AbsoluteSize.X)
		local alpha=math.clamp((x-left)/width,0,1)
		result.Scale=math.floor((0.78+alpha*(1.22-0.78))*100+0.5)/100
