	local pluginsZBase=130000
	local function raisePluginsZIndex()
		local function raiseOne(gui)
			local original=gui:GetAttribute("PluginsZOriginal")
			if type(original)~="number" then
				original=gui.ZIndex
				gui:SetAttribute("PluginsZOriginal",original)
			end
			gui.ZIndex=pluginsZBase+math.max(0,math.floor(original))
		end
		raiseOne(PluginsWindow)
		for _,gui in ipairs(PluginsWindow:GetDescendants()) do
			if gui:IsA("GuiObject") then raiseOne(gui) end
		end
	end

	local function selectPluginRecord(record)
		PluginsData.Selected=record
		for _,row in ipairs(pluginRows) do
			local isSelected=row.Record==record
			row.Frame.BackgroundTransparency=isSelected and 0.08 or 0.35
			if row.Stroke then row.Stroke.Transparency=isSelected and 0.15 or 0.75 end
		end
		if not record then
			PluginsCodeScroll.Visible=false
			PluginsSelectHintFrame.Visible=#PluginsData.Items>0
			return
		end
		PluginsSelectHintFrame.Visible=false
		local source,err=PluginsData:Read(record)
		PluginsCodeScroll.Visible=true
		if source then
			PluginsCodeLabel.Text=pluginsHighlight(source)
		else
			PluginsCodeLabel.Text="<font color=\"rgb(220,90,90)\">"..tostring(err or "Could not read plugin").."</font>"
		end
	end

