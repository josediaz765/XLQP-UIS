		local lower = text:lower()
		if text == "" or #text < 7 or #text > 95 then return true end
		if lower:find("what's up", 1, true) or lower:find("whats up", 1, true) then return true end
		if lower:find("how can i", 1, true) or lower:find("make your day", 1, true) then return true end
		if lower:find("how can") and lower:find("help") then return true end
		if lower == "hi" or lower == "hello" or lower == "hey" then return true end
		if text:sub(-1) == "?" then return true end
		local actionWords = {"read", "parsed", "identified", "checked", "searched", "found", "fetched", "opened", "reviewed", "combined", "prepared", "selected", "generated", "received", "cleaned", "displayed", "updated", "executed", "confirmed", "summarized", "inspected", "built", "loaded"}
		for _, word in ipairs(actionWords) do
			if lower:find(word, 1, true) then return false end
		end
		return true
	end

	local function parseAIPlanText(text)
		local steps = {}
		local seen = {}
		text = tostring(text or "")
		text = text:gsub("```json", ""):gsub("```", "")
		local function addStep(value)
			value = sharedAIClean(value)
			local key = value:lower()
			if not isBadTaskLabel(value) and not seen[key] then
				seen[key] = true
				steps[#steps + 1] = value
			end
		end
		local decoded
		pcall(function() decoded = HttpService:JSONDecode(text) end)
		if type(decoded) == "table" then
			local source = decoded.steps or decoded.tasks or decoded.actions or decoded
			if type(source) == "table" then
				for _, item in ipairs(source) do
					local value = item
					if type(item) == "table" then value = item.text or item.title or item.name or item.step or item.label end
					addStep(value)
				end
			end
		end
		if #steps == 0 then
			for quoted in text:gmatch('"([^"]+)"') do
				addStep(quoted)
				if #steps >= 6 then break end
			end
		end
		while #steps > 6 do table.remove(steps) end
		if #steps < 3 then return {} end
		return steps
	end

	local function generateAIProcessingPlan(prompt, searchNeeded)
		if isSimpleGreeting(prompt) then
			return nil
		end
		local plannerSystem = [[
You create visible progress labels for an AI chat UI. You MUST describe operations already happening in the UI, not answer the user. Return ONLY a valid JSON array of 3 to 6 labels. Each label must be a past/progressive task phrase under 75 characters, not a question and not a chat reply. Good examples: "Read the request about iShowSpeed", "Checked whether fresh web results are needed", "Reviewed search snippets for useful facts", "Prepared the model request", "Cleaned the response for display". Bad examples: "What's up?", "How can I help you?", "Here is the answer". Do not mention hidden reasoning or chain-of-thought.
]]
		local plannerUser = "User request: " .. tostring(prompt or "") .. "\nWeb search planned: " .. tostring(searchNeeded == true) .. "\nReturn JSON array only."
		local ok, result = pollinationsAI({
			{role = "system", content = plannerSystem},
			{role = "user", content = plannerUser}
		}, plannerSystem .. "\n" .. plannerUser)
		if ok and result then
			local text = extractAIText(result)
			local steps = parseAIPlanText(text)
			if #steps > 0 then return steps end
		end
		return nil
	end

