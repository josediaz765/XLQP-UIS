function XLQPGen1:_QueueUIWork(key,callback,delayTime)
	if key==nil or type(callback)~="function" or self._Destroyed then return self end
	self._UIWorkQueue=self._UIWorkQueue or {}
	self._UIWorkQueue[key]={Callback=callback,Due=os.clock()+math.max(0,tonumber(delayTime) or 0)}
	if self._UIWorkWorkerRunning then return self end
	self._UIWorkWorkerRunning=true
	self._UIWorkWorkerToken=(tonumber(self._UIWorkWorkerToken) or 0)+1
	local token=self._UIWorkWorkerToken
	task.spawn(function()
		while not self._Destroyed and token==self._UIWorkWorkerToken do
			local queue=self._UIWorkQueue
			local now=os.clock()
			local nextDue
			local ready={}
			for workKey,entry in pairs(queue) do
				if type(entry)~="table" or type(entry.Callback)~="function" then
					queue[workKey]=nil
				elseif (tonumber(entry.Due) or 0)<=now then
					ready[#ready+1]={Key=workKey,Callback=entry.Callback}
					queue[workKey]=nil
				else
					local due=tonumber(entry.Due) or now
					if not nextDue or due<nextDue then nextDue=due end
				end
			end
			if #ready>0 then
				local slice=os.clock()
				for _,job in ipairs(ready) do
					pcall(job.Callback)
					if os.clock()-slice>=0.002 then
						task.wait()
						slice=os.clock()
					end
				end
			end
			if next(queue)==nil then break end
			now=os.clock()
			if not nextDue then
				for _,entry in pairs(queue) do
					local due=tonumber(entry.Due) or now
					if not nextDue or due<nextDue then nextDue=due end
				end
			end
			task.wait(math.clamp((nextDue or now+0.03)-now,0.01,0.08))
		end
		if token==self._UIWorkWorkerToken then self._UIWorkWorkerRunning=false end
	end)
	return self
end

function XLQPGen1:_BindScrollCanvas(container, extraPadding)
	if typeof(container) ~= "Instance" or not container:IsA("ScrollingFrame") then return container end
	if container:GetAttribute("XLQPCanvasBound") == true then return container end
	container:SetAttribute("XLQPCanvasBound", true)
	local extra = tonumber(extraPadding) or 30
	container:SetAttribute("XLQPCanvasExtra",extra)
	pcall(function()
		container.CanvasSize = UDim2.new(0, 0, 0, 0)
		container.AutomaticCanvasSize = Enum.AutomaticSize.None
		container.Active = true
		container.ScrollingEnabled = true
		container.ScrollingDirection = Enum.ScrollingDirection.Y
		container.ElasticBehavior = Enum.ElasticBehavior.Never
	end)
	if type(addScrollSupport) == "function" and container:GetAttribute("XLQPWheelBound") ~= true then
		container:SetAttribute("XLQPWheelBound", true)
		pcall(addScrollSupport, container, false)
	end
	local syncKey={}
	local function branchVisible()
		local state=XLQPGen1._WindowConfig and XLQPGen1._WindowConfig._LocalRegisterState
		if state and type(state.isGuiBranchVisible)=="function" then
			local ok,visible=pcall(state.isGuiBranchVisible,container)
			if ok then return visible==true end
		end
		local current=container
		while current do
			if current:IsA("GuiObject") and current.Visible==false then return false end
			if current:IsA("LayerCollector") and current.Enabled==false then return false end
			current=current.Parent
		end
		return true
	end
	local function sync()
		if container:GetAttribute("XLQPCanvasSyncing") == true or not container.Parent then return end
		container:SetAttribute("XLQPCanvasDirty",false)
		container:SetAttribute("XLQPCanvasSyncing", true)
		local layout = container:FindFirstChildOfClass("UIListLayout") or container:FindFirstChildOfClass("UIGridLayout")
		if not layout then container:SetAttribute("XLQPCanvasSyncing", false) return end
		local height = math.max(0, layout.AbsoluteContentSize.Y)
		local desired = UDim2.new(0, 0, 0, height + extra)
		if container.CanvasSize ~= desired then container.CanvasSize = desired end
		local windowHeight=container.AbsoluteWindowSize.Y
		local maximum=math.max(0,height+extra-windowHeight)
		if container.CanvasPosition.Y>maximum then container.CanvasPosition=Vector2.new(container.CanvasPosition.X,maximum) end
		container:SetAttribute("XLQPCanvasSyncing", false)
	end
	local function queueSync()
		if XLQPGen1._StartupBuildActive and not XLQPGen1._StartupFinalizing then
			XLQPGen1:_QueueStartupFinalizer(sync)
			return
		end
		if container:GetAttribute("XLQPCanvasSyncing") == true then return end
		XLQPGen1:_QueueUIWork(syncKey,sync,0.025)
	end
	local layout = container:FindFirstChildOfClass("UIListLayout") or container:FindFirstChildOfClass("UIGridLayout")
	if layout then AddConnection(layout:GetPropertyChangedSignal("AbsoluteContentSize"), queueSync) end
	AddConnection(container:GetPropertyChangedSignal("Visible"),queueSync)
	AddConnection(container:GetPropertyChangedSignal("AbsoluteSize"),queueSync)
	AddConnection(container:GetPropertyChangedSignal("Parent"),function() task.defer(queueSync) end)
	AddConnection(container.AncestryChanged,function() task.defer(queueSync) end)
	AddConnection(container.ChildAdded,queueSync)
	AddConnection(container.ChildRemoved,queueSync)
	local refreshSignal=Instance.new("BindableEvent")
	refreshSignal.Name="XLQPScrollRefresh"
	refreshSignal.Parent=container
	AddConnection(refreshSignal.Event,queueSync)
	queueSync()
	task.defer(function()
		if self._InstallTouchScroll then pcall(function() self:_InstallTouchScroll(container) end) end
	end)
	return container
end

function XLQPGen1:_InstallTouchScroll(container)
	if typeof(container)~="Instance" or not container:IsA("ScrollingFrame") then return container end
	if container:GetAttribute("XLQPTouchScrollInstalled")==true then return container end
	container:SetAttribute("XLQPTouchScrollInstalled",true)
	container.Active=true
	container.ScrollingEnabled=true
	local activeTouch=nil
	local startPoint=nil
	local lastPoint=nil
	local startCanvas=nil
	local moved=false
	local function visible()
		local current=container
		while current do
			if current:IsA("GuiObject") and current.Visible==false then return false end
			if current:IsA("LayerCollector") and current.Enabled==false then return false end
			current=current.Parent
		end
		return true
	end
	local function pointInside(position)
		if not visible() then return false end
		local point=Vector2.new(position.X,position.Y)
		local p=container.AbsolutePosition
		local s=container.AbsoluteSize
		if point.X>=p.X and point.X<=p.X+s.X and point.Y>=p.Y and point.Y<=p.Y+s.Y then return true end
		local ok,inset=pcall(function() return GuiService:GetGuiInset() end)
		if ok and typeof(inset)=="Vector2" then
			local q=point-inset
			return q.X>=p.X and q.X<=p.X+s.X and q.Y>=p.Y and q.Y<=p.Y+s.Y
		end
		return false
	end
	local function maximumY()
		return math.max(0,container.AbsoluteCanvasSize.Y-container.AbsoluteWindowSize.Y)
	end
	local function begin(input)
		if activeTouch or input.UserInputType~=Enum.UserInputType.Touch or not pointInside(input.Position) then return end
		if self._RefreshScrollCanvas then pcall(function() self:_RefreshScrollCanvas(container) end) end
		activeTouch=input
		startPoint=Vector2.new(input.Position.X,input.Position.Y)
		lastPoint=startPoint
		startCanvas=container.CanvasPosition
		moved=false
	end
	local function update(input)
		if input~=activeTouch or not startPoint or not startCanvas then return end
		local point=Vector2.new(input.Position.X,input.Position.Y)
		local delta=point-startPoint
		if not moved and math.abs(delta.Y)<4 and math.abs(delta.X)<4 then return end
		moved=true
		local targetY=math.clamp(startCanvas.Y-delta.Y,0,maximumY())
		container.CanvasPosition=Vector2.new(container.CanvasPosition.X,targetY)
		lastPoint=point
	end
	local function finish(input)
		if input~=activeTouch then return end
		activeTouch=nil
		startPoint=nil
		lastPoint=nil
		startCanvas=nil
		moved=false
	end
	pcall(function()
		AddConnection(UserInputService.TouchStarted,begin)
		AddConnection(UserInputService.TouchMoved,update)
		AddConnection(UserInputService.TouchEnded,finish)
	end)
	pcall(function()
		AddConnection(container.TouchPan,function(touchPositions,totalTranslation,velocity,state)
			if not UserInputService.TouchEnabled or not visible() then return end
			if state==Enum.UserInputState.Begin then
				container:SetAttribute("XLQPTouchPanStartY",container.CanvasPosition.Y)
			elseif state==Enum.UserInputState.Change then
				local startY=tonumber(container:GetAttribute("XLQPTouchPanStartY")) or container.CanvasPosition.Y
				local deltaY=typeof(totalTranslation)=="Vector2" and totalTranslation.Y or 0
				container.CanvasPosition=Vector2.new(container.CanvasPosition.X,math.clamp(startY-deltaY,0,maximumY()))
			elseif state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel then
				container:SetAttribute("XLQPTouchPanStartY",nil)
			end
		end)
	end)
	AddConnection(UserInputService.InputBegan,function(input)
		if input.UserInputType==Enum.UserInputType.Touch then begin(input) end
	end)
	AddConnection(UserInputService.InputChanged,function(input)
		if input.UserInputType==Enum.UserInputType.Touch then update(input) end
	end)
	AddConnection(UserInputService.InputEnded,function(input)
		if input.UserInputType==Enum.UserInputType.Touch then finish(input) end
	end)
	return container
end

function XLQPGen1:_RefreshScrollCanvas(container)
	if typeof(container)~="Instance" or not container:IsA("ScrollingFrame") then return self end
	for _,descendant in ipairs(container:GetDescendants()) do
		if descendant:IsA("BindableEvent") and descendant.Name=="XLQPColumnRefresh" then descendant:Fire() end
	end
	local refreshSignal=container:FindFirstChild("XLQPScrollRefresh")
	if refreshSignal and refreshSignal:IsA("BindableEvent") then refreshSignal:Fire() end
	return self
end

function XLQPGen1:_RefreshScrollCanvasFast(container)
	if typeof(container)~="Instance" or not container:IsA("ScrollingFrame") then return self end
	local refreshSignal=container:FindFirstChild("XLQPScrollRefresh")
	if refreshSignal and refreshSignal:IsA("BindableEvent") then refreshSignal:Fire() end
	if container:GetAttribute("XLQPFastColumnRefreshQueued")~=true then
		container:SetAttribute("XLQPFastColumnRefreshQueued",true)
		task.delay(0.045,function()
			if not container.Parent then return end
			container:SetAttribute("XLQPFastColumnRefreshQueued",false)
			for _,child in ipairs(container:GetChildren()) do
				if child:IsA("BindableEvent") and child.Name=="XLQPColumnRefresh" then child:Fire() end
			end
		end)
	end
	return self
end

function XLQPBindScrollCanvasDeferred(descendant)
	if not descendant or not descendant.Parent then return end
	local scrollingFrame
	if descendant:IsA("ScrollingFrame") then
		scrollingFrame=descendant
	elseif descendant:IsA("UIListLayout") or descendant:IsA("UIGridLayout") then
		scrollingFrame=descendant.Parent
	end
	if scrollingFrame and scrollingFrame:IsA("ScrollingFrame") and scrollingFrame.AutomaticCanvasSize==Enum.AutomaticSize.Y and (scrollingFrame:FindFirstChildOfClass("UIListLayout") or scrollingFrame:FindFirstChildOfClass("UIGridLayout")) then
		XLQPGen1:_BindScrollCanvas(scrollingFrame,12)
	end
end
AddConnection(XLQPGen1Gui.DescendantAdded,function(descendant)
	if descendant:IsA("ScrollingFrame") then
		if descendant:GetAttribute("XLQPCanvasBound")==true then return end
	elseif not (descendant:IsA("UIListLayout") or descendant:IsA("UIGridLayout")) then
		return
	end
	task.defer(XLQPBindScrollCanvasDeferred,descendant)
end)

function XLQPGen1:_BeginStartupGate()
	self._GateActive = true
	self._StartupBlocked = true
	local loading = self._ActiveLoading
	if loading and not loading.Closed and type(loading.SetVisible) == "function" then
		pcall(function() loading:SetVisible(false) end)
	end
	if XLQPGen1Gui then XLQPGen1Gui.Enabled = true end
	return self
end

function XLQPGen1:_EndStartupGate()
	if not self._FatalLoadingError then self._StartupBlocked = false end
	if not self._GateActive then return self end
	self._GateActive = false
	local loading = self._ActiveLoading
	if loading and not loading.Closed and not loading.Failed and type(loading.SetVisible) == "function" then
		pcall(function() loading:SetVisible(true) end)
	end
	local now = os.clock()
	self._UIBuildStartedAt = now
	self._UIBuildLastActivity = now
	if self._PendingInit and not self._StartupBlocked and not self._Initialized then
		self._PendingInit = false
		task.defer(function()
			if not XLQPGen1._Initialized and not XLQPGen1._StartupBlocked then
				XLQPGen1:Init()
			end
		end)
	end
	return self
end

function XLQPGen1:_StopUIBuildWatcher()
	self._UIBuildWatchToken = (self._UIBuildWatchToken or 0) + 1
	if self._UIBuildActivityConnection then
		pcall(function() self._UIBuildActivityConnection:Disconnect() end)
		self._UIBuildActivityConnection = nil
	end
end

function XLQPGen1:_BeginUIBuildWatcher(config)
	config = type(config) == "table" and config or {}
	self:_StopUIBuildWatcher()
	self._Initialized = false
	self._UIBuildStartedAt = os.clock()
	self._UIBuildLastActivity = self._UIBuildStartedAt
	local token = self._UIBuildWatchToken
	local root = XLQPGen1Gui
	if root and root.DescendantAdded then
		local clock = os.clock
		self._UIBuildActivityConnection = root.DescendantAdded:Connect(function()
			if self._UIBuildWatchToken == token then
				self._UIBuildLastActivity = clock()
			end
		end)
	end
	task.spawn(function()
		local quietTime = math.max(0.04, tonumber(config.LoadQuietTime or config.IntroQuietTime or config.AutoInitQuietTime) or 0.08)
		local minimumTime = math.max(0.06, tonumber(config.MinIntroTime or config.IntroMinimumTime) or 0.1)
		local hardTimeout = math.max(12, tonumber(config.LoadTimeout or config.StartupTimeout or config.InitTimeout) or 30)
		local longLoadStage = 0
		while self._UIBuildWatchToken == token and self._LoadingOverlay and not self._Destroyed do
			if not self._StartupBlocked then
				local now = os.clock()
				local elapsed = now - (self._UIBuildStartedAt or now)
				local quietFor = now - (self._UIBuildLastActivity or now)
				local hasBuiltContent = (#(AllTopTabObjects or {}) > 0) or (#(AllSideTabObjects or {}) > 0) or (#(self.AllElements or {}) > 0)
				if self._PendingInit and hasBuiltContent and elapsed >= minimumTime then
					self._PendingInit = false
					pcall(function() self:Init() end)
					if self._Initialized then return end
				end
				if elapsed >= 14 and longLoadStage < 2 then
					longLoadStage = 2
					if self._ActiveLoading and not self._ActiveLoading.Closed then self._ActiveLoading:SetStep("Loading complex elements",0.72):SetHint("The interface is still building. It will open when initialization finishes."):SetHintColor(Color3.fromRGB(255,92,104)) end
				elseif elapsed >= 6 and longLoadStage < 1 then
					longLoadStage = 1
					if self._ActiveLoading and not self._ActiveLoading.Closed then self._ActiveLoading:SetStep("Still building interface",0.48):SetHint("Large interfaces can take a little longer to prepare.") end
				end
				if config.AutoInit == true and hasBuiltContent and elapsed >= minimumTime and quietFor >= quietTime then
					self:Init()
					return
				end
				if elapsed >= hardTimeout and quietFor >= math.max(quietTime, 1.5) then
					local captured = XLQPGen1._LastLibError
					if hasBuiltContent then
						self:Init()
						if captured then
							pcall(function()
								self:MakeNotification({Name="Script error",Content="Your script stopped early: "..(tostring(captured):gsub("\n"," ")),Image="alert-triangle",Time=10})
							end)
						end
					elseif type(self.ReportLoadingError) == "function" then
						self:ReportLoadingError(captured or ("Initialization timed out after "..tostring(math.floor(elapsed)).."s. The script stopped before Init() was reached."), "Module loader")
					end
					return
				end
			end
			task.wait(0.06)
		end
	end)
end

function XLQPGen1:MarkUIReady()
	return self:Init()
end

function XLQPGen1:_FinishLoadingVisuals()
	if self._LoadingVisualsFinished then return self end
	self._LoadingVisualsFinished = true
	pcall(function()
		if self._ActiveLoading and not self._ActiveLoading.Closed and type(self._ActiveLoading.Complete) == "function" then
			if type(self._ActiveLoading.SetTask) == "function" then
				self._ActiveLoading:SetTask(#(self._ActiveLoading.Tasks or {1}), "Finalizing interface...", 0.96)
			end
			self._ActiveLoading:Complete("Interface ready")
			task.delay(1.2, function()
				local active = self._ActiveLoading
				if active and not active.Closed and not active.Failed then
					pcall(function() active:Close(true) end)
				end
			end)
		end
	end)
	if self._LoadingOverlay then
		local overlay = self._LoadingOverlay
		self._LoadingOverlay = nil
		task.spawn(function()
			local descendants=overlay:GetDescendants()
			for index,gui in ipairs(descendants) do
				pcall(function()
					if gui:IsA("TextLabel") then
						TweenService:Create(gui,TweenInfo.new(0.2),{TextTransparency=1}):Play()
					elseif gui:IsA("ImageLabel") then
						TweenService:Create(gui,TweenInfo.new(0.2),{ImageTransparency=1}):Play()
					elseif gui:IsA("GuiObject") then
						TweenService:Create(gui,TweenInfo.new(0.2),{BackgroundTransparency=1}):Play()
					end
				end)
				if index%12==0 then task.wait() end
			end
			pcall(function() TweenService:Create(overlay,TweenInfo.new(0.2),{BackgroundTransparency=1}):Play() end)
			task.delay(0.24,function()
				if overlay and overlay.Parent then overlay:Destroy() end
			end)
		end)
	end
	if self._IntroHolder then
		local introHolder = self._IntroHolder
		local introCanvas = self._IntroCanvas
		local introScale = self._IntroScale
		self._IntroHolder = nil
		self._IntroCanvas = nil
		self._IntroScale = nil
		pcall(function()
			local outTweenInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			if introScale then TweenService:Create(introScale, outTweenInfo, {Scale = 1.14}):Play() end
			if introCanvas then TweenService:Create(introCanvas, outTweenInfo, {GroupTransparency = 1}):Play() end
			task.delay(0.32, function()
				if introHolder and introHolder.Parent then introHolder:Destroy() end
			end)
		end)
	end
	return self
end

function XLQPGen1:Diagnose()
	local lines = {}
	local function add(text) lines[#lines + 1] = text end
	add("===== XLQPGen1 Diagnostics =====")
	add(("state: Initialized=%s StartupBlocked=%s GateActive=%s PendingInit=%s ModuleLoadFailed=%s"):format(
		tostring(self._Initialized), tostring(self._StartupBlocked), tostring(self._GateActive),
		tostring(self._PendingInit), tostring(self._ModuleLoadFailed)))
	local tops = AllTopTabObjects or {}
	local sides = AllSideTabObjects or {}
	add(("top tabs: %d"):format(#tops))
	for index, top in ipairs(tops) do
		add(("  [%d] %s multitab=%s active=%s containerVisible=%s"):format(
			index, tostring(top.Name), tostring(top.IsMultiTab),
			tostring(top == activeTopTabObject),
			tostring(top.Container and top.Container.Visible)))
	end
	add(("side tabs: %d"):format(#sides))
	for index, side in ipairs(sides) do
		local container = side.Container
		local total, real = 0, 0
		if container then
			for _, child in ipairs(container:GetChildren()) do
				total = total + 1
				if child:IsA("GuiObject") and child.Name ~= "EmptyState" then real = real + 1 end
			end
		end
		add(("  [%d] %s top=%s children=%d real=%d visible=%s buttonVisible=%s"):format(
			index, tostring(side.Name),
			tostring(side.ParentTopTab and side.ParentTopTab.Name),
			total, real,
			tostring(container and container.Visible),
			tostring(side.Button and side.Button.Visible)))
	end
	add(("elements registered: %d"):format(#(self.AllElements or {})))
	add(("errors captured: %d"):format(#(self.LibErrors or {})))
	for index, entry in ipairs(self.LibErrors or {}) do
		if index > 8 then add("  ...more in LibErrors") break end
		add(("  [%s] %s"):format(tostring(entry.Name), tostring(entry.Message)))
	end
	add("================================")
	local emit = XLQPEnvironment.XLQPRealPrint or print
	for _, line in ipairs(lines) do pcall(emit, line) end
	return table.concat(lines, "\n")
end

function XLQPGen1:Init()
	if XLQPGen1._StartupBuildActive then
		XLQPGen1:_FinishOptimizedStartupBuild()
	end
	if XLQPGen1._Initialized then return XLQPGen1 end
	if XLQPGen1.SaveCfg then
		local s, e = pcall(function()
			if isfile and isfile(XLQPGen1.Folder .. "/" .. game.GameId .. ".txt") then
				if readfile then LoadCfg(readfile(XLQPGen1.Folder .. "/" .. game.GameId .. ".txt")) end
				XLQPGen1:MakeNotification({
					Name = "Configuration",
					Content = "Auto-loaded configuration for the game " .. game.GameId .. ".",
					Time = 5
				})
			end
		end)
	if not s then
			warn("XLQPGen1 Error: ", e)
		end
	end
	if XLQPGen1._ModuleLoadFailed then
		XLQPGen1._PendingInit = false
		if XLQPGen1._ActiveMainWindow then
			XLQPGen1._ActiveMainWindow.Visible = false
		end
		return XLQPGen1
	end
	if XLQPGen1._StartupBlocked then
		XLQPGen1._PendingInit = true
		if XLQPGen1._ActiveMainWindow then
			XLQPGen1._ActiveMainWindow.Visible = false
		end
		return XLQPGen1
	end
	local shouldSetup,setupConfig=XLQPGen1:ShouldShowSetup()
	if shouldSetup then
		XLQPGen1:BeginSetupFlow(setupConfig)
		return XLQPGen1
	end
	local shouldUpdateLog,updateLogConfig,updateLogEntries=XLQPGen1:ShouldShowUpdateLog()
	if shouldUpdateLog then
		XLQPGen1:BeginUpdateLogFlow(updateLogConfig,updateLogEntries)
		return XLQPGen1
	end
	XLQPGen1._Initialized = true
	task.delay(math.max(2,(tonumber(XLQPGen1._SettleTimeout) or 10)+3),function()
		if XLQPGen1._Destroyed or not XLQPGen1._Initialized then return end
		pcall(function() XLQPGen1:_FinishLoadingVisuals() end)
		pcall(function()
			if XLQPGen1._ActiveMainWindow and XLQPGen1._MainWindowMinimized~=true and Minimized~=true then
				XLQPGen1._ActiveMainWindow.Visible=true
			end
		end)
	end)
	if XLQPGen1._StopUIBuildWatcher then XLQPGen1:_StopUIBuildWatcher() end
	XLQPGen1._BuildSettled = false
	if XLQPGen1._ClosedTabListController and XLQPGen1._ClosedTabListController.Enabled and XLQPGen1._ClosedTabListController.Dirty then
		pcall(function() XLQPGen1._ClosedTabListController:Refresh() end)
	end
	if XLQPGen1._ApplyAutoloadVisuals then
		pcall(XLQPGen1._ApplyAutoloadVisuals,false)
	end
	if XLQPGen1._ReapplySavedSetupAppearance then pcall(function() XLQPGen1:_ReapplySavedSetupAppearance(false) end) end
	task.spawn(function()
		local clock = os.clock
		local lastActivity = clock()
		local connection
		pcall(function()
			connection = XLQPGen1Gui.DescendantAdded:Connect(function() lastActivity = clock() end)
		end)
		local quietFor = math.max(0.08, tonumber(XLQPGen1._SettleQuietTime) or 0.35)
		local deadline = os.clock() + math.max(1, tonumber(XLQPGen1._SettleTimeout) or 10)
		while not XLQPGen1._Destroyed and os.clock() < deadline do
			if os.clock() - lastActivity >= quietFor then break end
			task.wait(0.05)
		end
		if connection then pcall(function() connection:Disconnect() end) end
		XLQPGen1._BuildSettled = true
		if XLQPGen1._Destroyed then return end
		pcall(function()
			if XLQPGen1._ActiveMainWindow and XLQPGen1._MainWindowMinimized~=true then
				XLQPGen1._ActiveMainWindow.Visible = true
			end
		end)
		pcall(function() XLQPGen1:_FinishLoadingVisuals() end)
		if XLQPGen1._ReapplySavedSetupAppearance then
			pcall(function() XLQPGen1:_ReapplySavedSetupAppearance(true) end)
		end
	end)
	task.delay(0.12,function()
		if XLQPGen1._Destroyed then return end
		if type(XLQPGen1._QueueResponsiveRefresh)=="function" then pcall(XLQPGen1._QueueResponsiveRefresh) end
	end)
	task.defer(function()
		if XLQPGen1._Destroyed then return end
		if type(XLQPGen1.SetUIShadow) == "function" and XLQPGen1._ActiveWindowConfig and XLQPGen1._ActiveWindowConfig.UIShadow then
			pcall(function() XLQPGen1:SetUIShadow(true, type(XLQPGen1._ActiveWindowConfig.UIShadow) == "table" and XLQPGen1._ActiveWindowConfig.UIShadow or nil) end)
		end
		if type(XLQPGen1._BuildStatusBar) == "function" and XLQPGen1._ActiveWindowConfig and XLQPGen1._ActiveWindowConfig.StatusBar then
			pcall(function() XLQPGen1:_BuildStatusBar() end)
		end
	end)
	task.defer(function()
		if XLQPGen1._Destroyed then return end
		if type(XLQPGen1.IsBetaButtonsListEnabled) ~= "function" then return end
		if not XLQPGen1:IsBetaButtonsListEnabled() then return end
		if XLQPGen1._BetaButtonsGui then
			if XLQPGen1._BetaButtonsRefresh then pcall(XLQPGen1._BetaButtonsRefresh) end
			return
		end
		pcall(function() XLQPGen1:_BuildBetaButtonsList() end)
	end)
	pcall(function()
		if WindowConfig and WindowConfig.UnlockMouse then UnlockMouse(true) end
	end)
	if XLQPEnvironment.XLQP_DIAGNOSTICS == true then
		task.delay(2, function()
			if XLQPGen1._Destroyed then return end
			pcall(function() XLQPGen1:Diagnose() end)
		end)
	end
	return XLQPGen1
end

