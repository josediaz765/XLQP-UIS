	local function pointInside(button,point)
		if not (button and button.Parent and button.Visible and button.Active) then return false end
		local position=button.AbsolutePosition
		local size=button.AbsoluteSize
		return point.X>=position.X and point.X<=position.X+size.X and point.Y>=position.Y and point.Y<=position.Y+size.Y
