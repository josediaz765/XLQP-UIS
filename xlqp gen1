						Content = "Opening invite with "..selectedMode..".",
						Image = "bell",
						Time = 2
					})
				end)
			end
			return opened
		end

		 function getDiscordGuild(invite)
			local code = cleanDiscordInvite(invite)
			if code == "" then return nil end
			local body
			local req = getRequestFunction()
			local url = "https://discord.com/api/v10/invites/" .. code .. "?with_counts=true&with_expiration=true"
			if req then
				pcall(function()
					local response = req({
						Url = url,
						Method = "GET",
						Headers = {
							["User-Agent"] = "VerbalUI/DiscordCard",
							["Accept"] = "application/json"
						}
					})
					body = response and (response.Body or response.body)
				end)
			end
			if not body and game.HttpGet then
				pcall(function() body = game:HttpGet(url, true) end)
			end
			local data
			pcall(function() data = HttpService:JSONDecode(body or "") end)
