local insetY=math.min(10,(rect.Y1-rect.Y0)*0.3)
local midX=(rect.X0+rect.X1)*0.5
local midY=(rect.Y0+rect.Y1)*0.5
local points={
Vector2.new(midX,midY),
Vector2.new(rect.X0+insetX,rect.Y0+insetY),
Vector2.new(rect.X1-insetX,rect.Y0+insetY),
Vector2.new(rect.X0+insetX,rect.Y1-insetY),
Vector2.new(rect.X1-insetX,rect.Y1-insetY),
Vector2.new(midX,rect.Y0+insetY),
Vector2.new(midX,rect.Y1-insetY),
Vector2.new(rect.X0+insetX,midY),
Vector2.new(rect.X1-insetX,midY)
}
for _,point in ipairs(points) do
local ray=lensRectRay(camera,rect,point.X,point.Y)
local result=workspace:Raycast(ray.Origin,ray.Direction*2048,params)
if result then
local distance=(result.Position-ray.Origin):Dot(look)
if distance>0 and distance<nearest then nearest=distance end
end
end
