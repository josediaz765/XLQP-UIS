			if Element:IsA("TextButton") then Child.ApplyStrokeMode=Enum.ApplyStrokeMode.Border else Child.Enabled=false end
		end
	end
	return Element
end

local GetEffectiveThemeColor

 function Round(Number, Factor)
	local Result = math.floor(Number/Factor + (math.sign(Number) * 0.5)) * Factor
	if Result < 0 then Result = Result + Factor end
	return Result
end

 function ReturnProperty(Object)
	if typeof(Object) ~= "Instance" then
		return nil
	end
	if Object:IsA("Frame") or Object:IsA("TextButton") or Object:IsA("VideoFrame") or Object:IsA("ScrollingFrame") then
		return "BackgroundColor3"
	end
	if Object:IsA("ImageLabel") or Object:IsA("ImageButton") then
		return "ImageColor3"
	end
	if Object:IsA("UIStroke") then
		return "Color"
	end
	if Object:IsA("TextLabel") or Object:IsA("TextBox") or Object:IsA("Sound") then
		return "TextColor3"
	end
end


local XLQPBuildYieldAt = 0
function XLQPBuildYield()
	if XLQPGen1._Initialized or XLQPGen1._BuildYieldDisabled or XLQPGen1._Destroyed then return end
	if not XLQPGen1._ActiveMainWindow then return end
	local now = os.clock()
	if XLQPBuildYieldAt == 0 then XLQPBuildYieldAt = now return end
	if now - XLQPBuildYieldAt < 0.0045 then return end
	RunService.Heartbeat:Wait()
	XLQPBuildYieldAt = os.clock()
end

 function AddThemeObject(Object, Type)
	if typeof(Object) ~= "Instance" then
		return Object
	end
	XLQPBuildYield()
	if XLQPIsTextObject(Object) and Object:GetAttribute("XLQPForceRichText") == nil then
		pcall(function()
			if Object.RichText == true then Object:SetAttribute("XLQPForceRichText", true) end
		end)
	end
	XLQPApplyTextObject(Object)
	if not XLQPGen1.ThemeObjects[Type] then
		XLQPGen1.ThemeObjects[Type] = {}
	end
	table.insert(XLQPGen1.ThemeObjects[Type], Object)
	local prop = ReturnProperty(Object)
	if prop and XLQPGen1.Themes[XLQPGen1.SelectedTheme][Type] then
		local resolvedColor = XLQPGen1.Themes[XLQPGen1.SelectedTheme][Type]
		if GetEffectiveThemeColor then
			resolvedColor = GetEffectiveThemeColor(Type, resolvedColor)
		end
		Object[prop] = resolvedColor
	end
	return Object
end

 function compactThemeObjects()
	for themeType, objects in pairs(XLQPGen1.ThemeObjects) do
		local write = 1
		for read = 1, #objects do
			local object = objects[read]
			if object and object.Parent then
				objects[write] = object
				write += 1
			end
		end
		for index = write, #objects do
			objects[index] = nil
		end
	end
end




















XLQP_LAYER_TIER_CAP = 100000
local XLQP_LAYER_TOP_BASE = 2147383000
XLQP_LAYER_CEILING = 2147483644
local XLQP_SHIELD_NAME = "XLQPInputShield"

XLQPGen1._LayerInfo = XLQPGen1._LayerInfo or setmetatable({}, {__mode = "k"})
XLQPGen1._LayerSeq = XLQPGen1._LayerSeq or 0

