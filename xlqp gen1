						chunk[#chunk+1]=string.char(value)
					end
					if #chunk>=4096 then
						out[#out+1]=table.concat(chunk)
						table.clear(chunk)
						status.Text="Generating "..math.floor(i/math.max(total,1)*100).."%"
						task.wait()
					end
				end
				if #chunk>0 then out[#out+1]=table.concat(chunk) table.clear(chunk) end
				if not isfolder or not isfolder("XLQPGen1Gui") then pcall(function() if makefolder then makefolder("XLQPGen1Gui") end end) end
