	local function aiAnswerNeedsRepair(prompt, answer)
		local clean = sharedAIClean(answer)
		local lower = clean:lower()
		if clean == "" or #clean < 18 then return true, "empty or too short" end
		if lower:find("i need more information", 1, true) or lower:find("please provide more context", 1, true) or lower:find("could you clarify your question", 1, true) then
			local question=normalizeUICommand(prompt)
			if #question>=12 then return true,"generic clarification instead of answering" end
		end
		if lower:find("as an ai language model",1,true) or lower:find("i don't have access to real time",1,true) then
			return true,"provider returned a generic capability disclaimer"
		end
		if lower:find("called tool:", 1, true) or lower:find("executed tool:", 1, true) then
			return true, "tool output used as the answer"
		end
		if lower:match("^https?://") or lower:match("^image preview") or lower:match("^image source") then
			return true, "image or link used as the answer"
		end
		local subject = aiDirectAnswerSubject(prompt)
		if subject then
			local compactSubject = subject:gsub("[^%w]", "")
			local compactAnswer = lower:gsub("[^%w]", "")
			if compactSubject ~= "" and not compactAnswer:find(compactSubject, 1, true) then
				return true, "answer did not identify " .. subject
			end
			local identityWords = {" is ", " was ", " refers to ", "known as", "real name", "creator", "streamer", "personality", "artist", "actor", "athlete", "company", "service", "concept"}
			local identifies = false
			for _, word in ipairs(identityWords) do
				if lower:find(word, 1, true) then identifies = true break end
			end
			if not identifies then return true, "answer did not explain who or what the subject is" end
		end
		return false
	end

