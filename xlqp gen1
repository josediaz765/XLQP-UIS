					result = ok and custom == true
				elseif item.Operator == "contains" then result = contains(value, item.Expected)
				elseif item.Operator == "!=" or item.Operator == "not" then result = value ~= item.Expected
				elseif item.Operator == ">" then result = tonumber(value) and tonumber(item.Expected) and tonumber(value) > tonumber(item.Expected) or false
				elseif item.Operator == ">=" then result = tonumber(value) and tonumber(item.Expected) and tonumber(value) >= tonumber(item.Expected) or false
				elseif item.Operator == "<" then result = tonumber(value) and tonumber(item.Expected) and tonumber(value) < tonumber(item.Expected) or false
				elseif item.Operator == "<=" then result = tonumber(value) and tonumber(item.Expected) and tonumber(value) <= tonumber(item.Expected) or false
				elseif item.Expected ~= nil then
