					cell.BackgroundTransparency=0
					Grid.Value[index]={Color=color}
				end
			end
			local function getBoxCell(x,y)
				local strideX=math.max(1,cellW+cellPad)
				local strideY=math.max(1,cellH+cellPad)
				local col=math.floor(x/strideX)+1
				local row=math.floor(y/strideY)+1
				if col<1 or row<1 or col>GridConfig.Columns or row>GridConfig.Rows then return nil,nil end
				return col,row
			end
			local function paintBoxes(x,y)
				local col,row=getBoxCell(x,y)
				if not col or not row then return end
				local radius=math.max(0,math.floor((Grid.BrushSize-1)/2))
				for yy=row-radius,row+radius do
					for xx=col-radius,col+radius do
						paintCell(xx,yy,Grid.Color,Grid.Tool=="Eraser")
					end
				end
			end
			local function paintFreePoint(x,y)
				if Grid.Tool=="Eraser" then
					for _,dot in ipairs(freeHost:GetChildren()) do
						if dot.Name=="Dot" and math.abs((dot.Position.X.Offset+dot.Size.X.Offset/2)-x)<=Grid.BrushSize*1.35 and math.abs((dot.Position.Y.Offset+dot.Size.Y.Offset/2)-y)<=Grid.BrushSize*1.35 then
							dot:Destroy()
						end
					end
					for index=#points,1,-1 do
						local point=points[index]
						if point and math.abs((point.X or 0)-x)<=Grid.BrushSize*1.35 and math.abs((point.Y or 0)-y)<=Grid.BrushSize*1.35 then
							table.remove(points,index)
						end
					end
					Grid.Value.Points=points
					return
				end
				local size=Grid.BrushSize*2
				local dot=SetProps(MakeElement("RoundFrame",Grid.Color,0,size),{Name="Dot",Size=UDim2.new(0,size,0,size),Position=UDim2.new(0,x-size/2,0,y-size/2),Parent=freeHost})
				points[#points+1]={X=x,Y=y,Size=size,Color=Grid.Color}
				Grid.Value.Points=points
			end
			local function paintFree(x,y)
				local previous=lastFreePoint
				if not previous then
					paintFreePoint(x,y)
					lastFreePoint={X=x,Y=y}
					return
				end
				local dx=x-previous.X
				local dy=y-previous.Y
				local distance=math.sqrt(dx*dx+dy*dy)
				if distance<.35 then return end
				local spacing=math.max(.75,Grid.BrushSize*.42)
				local steps=math.max(1,math.ceil(distance/spacing))
				for step=1,steps do
					local alpha=step/steps
					paintFreePoint(previous.X+dx*alpha,previous.Y+dy*alpha)
				end
				lastFreePoint={X=x,Y=y}
			end
			local function paintAt(pos)
				local x,y=clampPoint(pos)
				if Grid.Boxes then paintBoxes(x,y) else paintFree(x,y) end
				SafeCallback(GridConfig.Callback,{Name=GridConfig.Name,Element=Grid},Grid)
			end
			local function begin(input)
