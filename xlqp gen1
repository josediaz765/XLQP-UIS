		local query=tostring(savedSearch.Text or ""):lower()
		local shown=0
		for index,item in ipairs(configFiles()) do
			local matchesQuery=query=="" or item.Name:lower():find(query,1,true)~=nil
			local matchesFilter=savedFilter=="All" or (savedFilter=="Webhook" and item.Webhook) or (savedFilter=="Values" and item.Count>0)
			if matchesQuery and matchesFilter then
				shown+=1
				local card=Create("Frame",{Name="ConfigCard",LayoutOrder=index,BackgroundColor3=secondColor,BackgroundTransparency=0.08,BorderSizePixel=0,ZIndex=5,Parent=savedList})
