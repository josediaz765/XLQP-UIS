	local function stopAndClear()
		mediaLoadToken += 1
		if MediaVisualizer then MediaVisualizer:Stop() end
		if currentMediaInstance then
			pcall(function() currentMediaInstance:Destroy() end)
			currentMediaInstance = nil
		end
		if VideoContainer.Visible then
			local tween = TweenService:Create(VideoContainer, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 0)})
			tween:Play()
			task.delay(0.2, function()
				if VideoContainer and VideoContainer.Parent and not currentMediaInstance then
					VideoContainer.Visible = false
				end
			end)
		end
		isPaused = false
		statusLabel.Text = "Ready"
		LoadButtonFrame.Visible = true
		PauseButtonFrame.Visible = false
		ExitButtonFrame.Visible = false
		if currentPlayingIndex ~= -1 then
			currentPlayingIndex = -1
			updatePlaylistUI()
		end
		notifyMediaState()
	end

	loadMedia = function(url, playlistIndex)
		stopAndClear()
		local thisMediaLoad = mediaLoadToken
		task.wait(0.21)
		if thisMediaLoad~=mediaLoadToken then return end

		currentPlayingIndex = playlistIndex or -1
		updatePlaylistUI()

		if not url or url:gsub("%s", "") == "" then
			statusLabel.Text = "URL is empty"
			XLQPGen1:MakeNotification({Name = "Media Player", Content = "URL is empty."}); return
		end
		local mediaType = detectMediaType(url)
		if not mediaType then
			statusLabel.Text = "Invalid media URL"
			XLQPGen1:MakeNotification({Name = "Media Player", Content = "Unsupported media. Use a Roblox ID, URL, or supported local audio/video file."}); return
		end
		if mediaType=="YOUTUBE" then
			if type(MediaCtl.YouTubeResolver)~="function" then
				statusLabel.Text="Open YouTube Search first"
				XLQPGen1:MakeNotification({Name="Media Player",Content="YouTube search is not initialized."})
				return
			end
			statusLabel.Text="Downloading YouTube track"
			task.spawn(function()
				local ok,track,index=pcall(MediaCtl.YouTubeResolver,url,playlistIndex)
				if thisMediaLoad~=mediaLoadToken then return end
				if not ok or type(track)~="table" or not track.url then
					statusLabel.Text="YouTube download failed"
					XLQPGen1:MakeNotification({Name="Media Player",Content=tostring(track or "YouTube download failed")})
					return
				end
				index=tonumber(index or playlistIndex)
				if index and playlist[index] then
					playlist[index]=track
				else
					table.insert(playlist,track)
					index=#playlist
				end
				savePlaylist()
				updatePlaylistUI()
				loadMedia(track.url,index)
			end)
			return
		end
		if tostring(url):match("^%d+$") then url = "rbxassetid://"..url end
		if tostring(url):match("^rbxassetid://") then
			statusLabel.Text = "Playing Roblox audio"
			pcall(function()
				currentMediaInstance = Create("Sound", { Name = "XLQPGen1_MediaPlayer_Audio", Parent = XLQPGen1Gui, SoundId = url, Looped = loopOne, Volume = currentVolume, PlaybackSpeed = currentPitch })
				XLQPGen1:RegisterUIAudio(currentMediaInstance)
				applyMediaPreset()
				currentMediaInstance:Play()
				if MediaVisualizer then MediaVisualizer:Bind(currentMediaInstance) end
				if autoPlayNext then AddConnection(currentMediaInstance.Ended, function() if autoPlayNext and not loopOne then playPlaylistIndex(currentPlayingIndex + 1) end end) end
				isPaused = false
				LoadButtonFrame.Visible = false
				PauseButtonFrame.Visible = true
				PauseButtonContent.Text = "Pause"
				ExitButtonFrame.Visible = true
				SafeCallback(MediaPlayerConfig.Callback, url)
				notifyMediaState()
			end)
			return
		end
		local assetResolver=getcustomasset or getsynasset
		local localFile=false
		if isfile then pcall(function() localFile=isfile(tostring(url))==true end) end
		local fileFuncsAvailable = isfolder and makefolder and writefile and assetResolver and isfile and delfile
		if not localFile and not fileFuncsAvailable then
			XLQPGen1:MakeNotification({Name = "Media Player", Content = "File functions not found. Caching disabled."})
			XLQPGen1:MakeNotification({Name = "Media Player", Content = "This feature may not work without 'getcustomasset' support."})
			statusLabel.Text = "Executor cannot cache this media"
			return
		end
		statusLabel.Text = "Loading "..mediaType
		XLQPGen1:MakeNotification({Name = "Media Player", Content = "Loading " .. mediaType .. "..."})
		task.spawn(function()
			local function playAsset(assetId)
				if thisMediaLoad~=mediaLoadToken then return end
				pcall(function()
					if mediaType == "MP4" then
						VideoContainer.Visible = true
						local aspectRatio = 16/9
						local videoHeight = VideoContainer.AbsoluteSize.X / aspectRatio
						if videoHeight <= 0 then videoHeight = 250 end
						local tween = TweenService:Create(VideoContainer, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, videoHeight)})
						tween:Play()
						local videoPlayer = Create("VideoFrame", {
							Name = "XLQPGen1_EmbeddedVideoPlayer", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(0, 0, 0), Parent = VideoContainer,
							Draggable = false, Active = false, Video = assetId, Looped = loopOne, Volume = currentVolume
						}, { Create("UICorner", {CornerRadius = UDim.new(0, 8)}) })
						currentMediaInstance = videoPlayer
						videoPlayer:Play()
					elseif mediaType == "MP3" then
						local soundPlayer = Create("Sound", { Name = "XLQPGen1_MediaPlayer_Audio", Parent = XLQPGen1Gui, SoundId = assetId, Looped = loopOne, Volume = currentVolume, PlaybackSpeed = currentPitch })
						XLQPGen1:RegisterUIAudio(soundPlayer)
						currentMediaInstance = soundPlayer
						applyMediaPreset()
						soundPlayer:Play()
						if MediaVisualizer then MediaVisualizer:Bind(soundPlayer) end
						if autoPlayNext then AddConnection(soundPlayer.Ended, function() if autoPlayNext and not loopOne then playPlaylistIndex(currentPlayingIndex + 1) end end) end
					end
					isPaused = false
					statusLabel.Text = (currentPlayingIndex > 0 and playlist[currentPlayingIndex] and playlist[currentPlayingIndex].name) or extractFileName(url)
					LoadButtonFrame.Visible = false
					PauseButtonFrame.Visible = true
					PauseButtonContent.Text = "Pause"
					ExitButtonFrame.Visible = true
                SafeCallback(MediaPlayerConfig.Callback, url)
					notifyMediaState()
				end)
			end
			if localFile and assetResolver then
				statusLabel.Text="Loading local file"
				local ok,localAsset=pcall(assetResolver,tostring(url))
				if thisMediaLoad~=mediaLoadToken then return end
				if ok and localAsset then playAsset(localAsset)
				else
					statusLabel.Text="Could not open local file"
					XLQPGen1:MakeNotification({Name="Media Player",Content="The selected local file could not be loaded with getcustomasset."})
				end
				return
			end
			if not isfolder(mediaFolder) then makefolder(mediaFolder) end
			local fileName = extractFileName(url)
			local filePath = mediaFolder .. "/" .. fileName
			local assetId = nil
			if isfile(filePath) then
				statusLabel.Text = "Loading cached track"
				XLQPGen1:MakeNotification({Name = "Media Player", Content = "Loading from cache..."})
				local success, cachedAssetId = pcall(assetResolver, filePath)
				if success and cachedAssetId then assetId = cachedAssetId
				else
					warn("XLQP Gen1 MediaPlayer: Failed to load from cache, re-downloading...")
					XLQPGen1:MakeNotification({Name = "Media Player", Content = "Cache invalid, re-downloading..."})
					pcall(delfile, filePath)
				end
			end
			if not assetId then
				statusLabel.Text = "Downloading track"
				XLQPGen1:MakeNotification({Name = "Media Player", Content = "Downloading media..."})
				local success, data = pcall(function() return game:HttpGet(url, true) end)
				if thisMediaLoad~=mediaLoadToken then return end
				if not (success and typeof(data) == "string" and #data > 100) then
					XLQPGen1:MakeNotification({Name = "Media Player", Content = "Download failed for URL: " .. url}); return
				end
				if not pcall(writefile, filePath, data) then
					XLQPGen1:MakeNotification({Name = "Media Player", Content = "Failed to save to cache."}); return
				end
				XLQPGen1:MakeNotification({Name = "Media Player", Content = "Download complete, creating asset..."})
				local assetSuccess, newAssetId = pcall(assetResolver, filePath)
				if thisMediaLoad~=mediaLoadToken then return end
				if assetSuccess and newAssetId then assetId = newAssetId
				else XLQPGen1:MakeNotification({Name = "Media Player", Content = "Failed to create asset from file."}); return
				end
			end
			if thisMediaLoad~=mediaLoadToken then return end
			if assetId then playAsset(assetId)
			else XLQPGen1:MakeNotification({Name = "Media Player", Content = "An unknown error occurred."})
			end
		end)
	end

