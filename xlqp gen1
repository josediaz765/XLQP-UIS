local function stopXLQPCustomCursor()
	if XLQPGen1._CustomCursorConnection then
		pcall(function() XLQPGen1._CustomCursorConnection:Disconnect() end)
		XLQPGen1._CustomCursorConnection = nil
	end
	if XLQPGen1._CustomCursorIcon then XLQPGen1._CustomCursorIcon.Visible = false end
	if XLQPGen1._CustomCursorGlow then XLQPGen1._CustomCursorGlow.Visible = false end
	if XLQPGen1._CustomCursorOwnsMouse then
		UserInputService.MouseIconEnabled = XLQPGen1._CustomCursorPreviousMouseIcon ~= false
		XLQPGen1._CustomCursorOwnsMouse = false
	end
end

function XLQPGen1:SetCustomCursorEnabled(value)
	if self._ReduceLagEnabled then value=false end
	self.CustomCursorEnabled = value == true
	WindowConfig.CustomCursor = self.CustomCursorEnabled
	if not self.CustomCursorEnabled then
		stopXLQPCustomCursor()
	else
		ensureXLQPCustomCursor()
		if not self._CustomCursorConnection then
			local lastHoverCheck=0
			local lastHoverPosition=Vector2.new(-10000,-10000)
			local lastDrawPosition=Vector2.new(-10000,-10000)
