function XLQPGen1:_ApplyDiscDockOffset(offset)
offset=tonumber(offset) or 0
if not (XLQPGen1Gui and XLQPGen1Gui.Parent) then return self end
for _,child in ipairs(XLQPGen1Gui:GetChildren()) do
if child:IsA("GuiObject") and child.Name=="XLQPDiscPlayer" then
local base=child:GetAttribute("XLQPDiscBaseOffsetY")
if base==nil then
base=child.Position.Y.Offset
child:SetAttribute("XLQPDiscBaseOffsetY",base)
end
if child.Position.Y.Scale>=1 then
child.Position=UDim2.new(child.Position.X.Scale,child.Position.X.Offset,child.Position.Y.Scale,base-offset)
end
end
end
return self
end

