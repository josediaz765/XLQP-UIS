				opened=false
				TweenService:Create(list,TweenInfo.new(0.16),{Size=UDim2.new(0,button.AbsoluteSize.X,0,0)}):Play()
				task.delay(0.17,function() list.Visible=false end)
			end)
		end
		value.Text=tostring(getter() or "None")
		applyFontPreview(value,getter() or "Gotham")
