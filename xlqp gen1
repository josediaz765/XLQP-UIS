				for index,meta in ipairs(optionMeta) do
					local selected=sameValue(Radio.Value,meta.Value)
					meta.Button.BackgroundTransparency=selected and 0.12 or 0.72
					meta.Dot.BackgroundTransparency=selected and 0 or 1
					meta.Label.TextTransparency=meta.Disabled and 0.58 or (selected and 0 or 0.18)
					meta.Button.Active=not meta.Disabled
				end
