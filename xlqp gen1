	self._StartupBlocked=true
	self:_SuspendInterfaceForSetup()
	if self._ActiveMainWindow then self._ActiveMainWindow.Visible=false end
	pcall(function() self:_FinishLoadingVisuals() end)
	task.wait(0.08)
	local completed=self:OpenUpdateLogUI(config,entries)
	self._UpdateLogFlowOpen=false
	self._StartupBlocked=false
	self:_ResumeInterfaceAfterSetup()
	if completed then
		self._UpdateLogFlowFinished=true
		self._PendingInit=false
		if not self._Initialized then
			local ok,err=pcall(function() self:Init() end)
			if not ok then XLQPWarn("XLQPGen1 update log init:",err) end
		end
	else
		self._UpdateLogFlowFinished=false
	end
	return self
end
function XLQPGen1:WaitForUpdateLogs(timeout)
	local started=os.clock()
	while self._UpdateLogFlowOpen and not self._Destroyed do
		if timeout and os.clock()-started>=tonumber(timeout) then return false end
		task.wait(0.05)
	end
	local pending=self:GetPendingUpdateLogs()
	return #pending==0
end

function XLQPGen1:_SuspendInterfaceForSetup()
	if self._SetupPresentationLock==true then return end
	self._SetupPresentationLock=true
	self._SetupSuppressedGuis=self._SetupSuppressedGuis or {}
	local function suppress(gui)
		if not (gui and gui.Parent and gui:IsA("ScreenGui")) or gui.Name=="XLQPSetupWizard" then return end
		if self._SetupSuppressedGuis[gui]==nil then self._SetupSuppressedGuis[gui]=gui.Enabled end
		gui.Enabled=false
	end
	suppress(XLQPGen1Gui)
	for _,gui in ipairs(self._PopupGuis or {}) do suppress(gui) end
	if self._NotificationGui then suppress(self._NotificationGui) end
	self._SetupFloatingVisibility=self._SetupFloatingVisibility or {}
	for _,floatingLabel in ipairs(self._floatingLabels or {}) do
		if floatingLabel and floatingLabel.Frame then
			self._SetupFloatingVisibility[floatingLabel]=floatingLabel.Frame.Visible
			floatingLabel.Frame.Visible=false
		end
	end
	if self._DynamicIsland and self._DynamicIsland.Hide then pcall(function() self._DynamicIsland:Hide() end) end
	for _,disc in ipairs(self._DiscPlayers or {}) do
		local root=disc and (disc.Frame or disc.Wrapper)
		if root and root.Parent then
			root:SetAttribute("XLQPSetupDesiredVisible",disc.Visible~=false)
			root.Visible=false
		end
	end
end
function XLQPGen1:_ResumeInterfaceAfterSetup()
	self._SetupPresentationLock=false
	for gui,enabled in pairs(self._SetupSuppressedGuis or {}) do
		if gui and gui.Parent and gui:IsA("ScreenGui") then gui.Enabled=enabled~=false end
	end
	if XLQPGen1Gui and XLQPGen1Gui.Parent then XLQPGen1Gui.Enabled=true end
	self._SetupSuppressedGuis={}
	for floatingLabel,visible in pairs(self._SetupFloatingVisibility or {}) do
		if floatingLabel and floatingLabel.Frame and floatingLabel.Frame.Parent then floatingLabel.Frame.Visible=visible==true end
	end
	self._SetupFloatingVisibility={}
	for _,disc in ipairs(self._DiscPlayers or {}) do
		local root=disc and (disc.Frame or disc.Wrapper)
		if root and root.Parent then
			local desired=root:GetAttribute("XLQPSetupDesiredVisible")
			if desired==nil then desired=disc.Visible~=false end
			root.Visible=desired==true
			if disc._SetupPlayPending==true and type(disc.Play)=="function" then
				disc._SetupPlayPending=nil
				task.defer(function() if disc and type(disc.Play)=="function" then pcall(function() disc:Play() end) end end)
			end
		end
	end
	if self._PendingWatermarkVisibility~=nil then
		local pending=self._PendingWatermarkVisibility
		self._PendingWatermarkVisibility=nil
		task.defer(function() pcall(function() self:SetWatermarkVisibility(pending) end) end)
	end
end
function XLQPGen1:BeginSetupFlow(setupConfig)
	setupConfig=XLQPSetupResolveConfig(self,setupConfig)
	if not setupConfig or setupConfig.Enabled==false or self._SetupFlowOpen or self._SetupFlowFinished then return self end
	self._SetupFlowOpen=true
	self._StartupBlocked=true
	self:_SuspendInterfaceForSetup()
	if self._ActiveMainWindow then self._ActiveMainWindow.Visible=false end
	pcall(function() self:_FinishLoadingVisuals() end)
	task.wait(0.12)
	local result=self:OpenSetupWizard(setupConfig)
	self._SetupFlowOpen=false
	if type(result)=="table" and (result.completed==true or result.Completed==true) then
		if type(self._ApplySetupSelections)=="function" then pcall(function() self:_ApplySetupSelections(result) end) end
		pcall(function() self:SaveSetupState(result,setupConfig) end)
		self._SetupFlowFinished=true
		self._StartupBlocked=false
		self._PendingInit=false
		self:_ResumeInterfaceAfterSetup()
		if XLQPGen1Gui and XLQPGen1Gui.Parent then XLQPGen1Gui.Enabled=true end
		if self._GateActive and self._EndStartupGate then pcall(function() self:_EndStartupGate() end) end
		if not self._Initialized then
			local ok,err=pcall(function() self:Init() end)
			if not ok then XLQPWarn("XLQPGen1 setup finish init:",err) end
		end
		local function forceOpen()
			if self._Destroyed then return end
			if XLQPGen1Gui and XLQPGen1Gui.Parent then XLQPGen1Gui.Enabled=true end
			if result.Language and self.SetLanguage then pcall(function() self:SetLanguage(result.Language) end) end
			pcall(function() self:_FinishLoadingVisuals() end)
			local main=self._ActiveMainWindow or self._MainWindow
			if main and main.Parent and self._MainWindowMinimized~=true then
				main.Visible=true
				if self._CenterMainWindowOnOpen then pcall(self._CenterMainWindowOnOpen) end
			end
			if type(self._QueueResponsiveRefresh)=="function" then pcall(self._QueueResponsiveRefresh) end
		end
		task.defer(forceOpen)
		task.delay(0.12,forceOpen)
		task.delay(0.5,forceOpen)
	else
		self._StartupBlocked=false
		self:_ResumeInterfaceAfterSetup()
		if XLQPGen1Gui and XLQPGen1Gui.Parent then XLQPGen1Gui.Enabled=true end
	end
	return self
end


