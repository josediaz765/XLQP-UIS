function XLQPGen1:_BuildNativeSecurityPanel(window, tab, options)
local library=self
options=type(options)=="table" and options or {}
local configuredWebhookLinks={}
local configuredWebhookSeen={}
local function collectWebhookLinks(value)
if type(value)=="string" then
for link in value:gmatch("[^,%s]+") do
link=tostring(link or "")
local key=link:lower():gsub("%s+","")
if key~="" and not configuredWebhookSeen[key] then
configuredWebhookSeen[key]=true
configuredWebhookLinks[#configuredWebhookLinks+1]=link
end
end
elseif type(value)=="table" then
for _,link in pairs(value) do
link=tostring(link or "")
local key=link:lower():gsub("%s+","")
if key~="" and not configuredWebhookSeen[key] then
configuredWebhookSeen[key]=true
configuredWebhookLinks[#configuredWebhookLinks+1]=link
end
end
end
end
collectWebhookLinks(options.DiscordWebhookWhitelist)
collectWebhookLinks(options.DiscordWebhooks)
collectWebhookLinks(options.WebhookWhitelist)
collectWebhookLinks(options.WhitelistWebhooks)
collectWebhookLinks(options.Whitelist)
for _,link in ipairs(configuredWebhookLinks) do
if library.WhitelistLoggerUrl then library:WhitelistLoggerUrl(link) end
end
