		if not Camera then return end
		local Axis=self:AxisVector(self.DragAxis)
		local Origin=self.DragStartPosition
		local A=Camera:WorldToViewportPoint(Origin)
		local B=Camera:WorldToViewportPoint(Origin+Axis*6)
		local ScreenAxis=Vector2.new(B.X-A.X,B.Y-A.Y)
		local Len=ScreenAxis.Magnitude
		if Len<1 then return end
		local Delta=self:Pointer(Input)-self.DragStartPointer
		local WorldDelta=Delta:Dot(ScreenAxis.Unit)/Len*6
		self.Selected.Position=self:Snap(Origin+Axis*WorldDelta)
		self:UpdateGizmo()
	end
