function XLQPGen1:GetReduceLagEnabled()
	return self._ReduceLagEnabled==true
end
function XLQPGen1:_ReleaseReduceLagFor(featureName)
	if self._ReduceLagEnabled~=true then return false end
	if self._ReduceLagReleasing then return false end
	self._ReduceLagReleasing=true
	local snapshot=self._ReduceLagSnapshot
	if type(snapshot)=="table" then
		snapshot.Glow=false
		snapshot.Background=false
		snapshot.URLBackground=false
		snapshot.CustomCursor=false
		snapshot.LiveColorMode="Off"
		snapshot.LiveColorThemeImages=false
		snapshot.LiveColorElementBackground=false
		snapshot.LiquidGlass=false
		snapshot.SettingsBlur=false
		snapshot.MediaBlur=false
		snapshot.Rainbow=false
		snapshot.Neon=false
		snapshot.RainbowOutline=false
		snapshot.Decorations=false
		snapshot.WindowDesigns=false
		if featureName=="Ambient Glow" then snapshot.Glow=true end
		if featureName=="Liquid Glass" then snapshot.LiquidGlass=true end
		if featureName=="Rainbow Outline" then snapshot.RainbowOutline=true snapshot.Neon=true end
	end
	self:SetReduceLagEnabled(false)
	self._ReduceLagReleasing=nil
	if self._ReduceLagTabToggle and type(self._ReduceLagTabToggle.Set)=="function" then
		pcall(function() self._ReduceLagTabToggle:Set(false,true) end)
	end
	pcall(function()
		self:MakeNotification({Name="Reduce Lag",Content="Turned off so "..tostring(featureName).." can run.",Image="zap",Time=4})
	end)
	return true
end
function XLQPGen1:_SyncPerformanceGradients(disable)
	self._PerformanceGradientToken=(tonumber(self._PerformanceGradientToken) or 0)+1
	local token=self._PerformanceGradientToken
	task.spawn(function()
		if not XLQPGen1Gui then return end
		for index,object in ipairs(XLQPGen1Gui:GetDescendants()) do
			if token~=self._PerformanceGradientToken or self._Destroyed then return end
			if object:IsA("UIGradient") and object.Name~="XLQPLiveColor" then
				if disable then
					if object:GetAttribute("XLQPPerformanceRestoreEnabled")==nil then object:SetAttribute("XLQPPerformanceRestoreEnabled",object.Enabled==true) end
					object.Enabled=false
				else
					local restore=object:GetAttribute("XLQPPerformanceRestoreEnabled")
					if restore~=nil then object.Enabled=restore==true object:SetAttribute("XLQPPerformanceRestoreEnabled",nil) end
				end
			end
			if index%120==0 then RunService.Heartbeat:Wait() end
		end
	end)
	return self
end
function XLQPGen1:SetReduceLagEnabled(value)
	value=value==true
	WindowConfig.ReduceLag=value
	if value~=self._ReduceLagEnabled then
		if value then
			self._ReduceLagSnapshot={
				Glow=self._GlowEnabled==true,
				Background=WindowConfig.BackgroundEnabled==true,
				URLBackground=WindowConfig.URLBackgroundEnabled==true,
				CustomCursor=self:GetCustomCursorEnabled(),
				LiveColorMode=self:GetLiveColorMode(),
				LiveColorThemeImages=WindowConfig.LiveColorThemeImages~=false,
				LiveColorElementBackground=WindowConfig.LiveColorElementBackground==true,
