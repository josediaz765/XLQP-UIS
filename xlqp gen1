local function XLQPCursorGuiRaycast(x, y)
	local hits = {}
	local ok = pcall(function()
		hits = game:GetService("GuiService"):GetGuiObjectsAtPosition(x, y)
	end)
	if ok and type(hits) == "table" then
		for _, hit in ipairs(hits) do
			if tostring(hit.Name or ""):find("XLQPAmbientGlow",1,true) then continue end
			local current = hit
			local ignoredCursor = false
			while current do
				if current == XLQPGen1._CustomCursorGui then ignoredCursor = true break end
				if current == XLQPGen1Gui then return true end
				if current:IsA("ScreenGui") then
					local guiName = tostring(current.Name or ""):lower()
					if guiName:find("xlqp", 1, true) or guiName:find("verbal hub", 1, true) then return true end
					break
				end
				current = current.Parent
			end
			if ignoredCursor then continue end
		end
		return false
	end
	local function pointInsideTopLevel(root)
		if not root or root == XLQPGen1._CustomCursorGui then return false end
		local enabled=true
		if root:IsA("ScreenGui") then enabled=root.Enabled end
		if not enabled then return false end
		local objects=root:IsA("GuiObject") and {root} or root:GetChildren()
		for _,object in ipairs(objects) do
			if object:IsA("GuiObject") and object.Visible and object.AbsoluteSize.X>0 and object.AbsoluteSize.Y>0 and not tostring(object.Name):find("XLQPAmbientGlow",1,true) then
				local position,size=object.AbsolutePosition,object.AbsoluteSize
				if x>=position.X and x<=position.X+size.X and y>=position.Y and y<=position.Y+size.Y then return true end
			end
		end
		return false
	end
	if pointInsideTopLevel(XLQPGen1Gui) then return true end
	for _,popup in ipairs(XLQPGen1._PopupGuis or {}) do if popup~=XLQPGen1._CustomCursorGui and popup.Parent and pointInsideTopLevel(popup) then return true end end
	return false
end

