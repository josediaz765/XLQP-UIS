function XLQPGen1:SetDecorationsEnabled(value)
	self.DecorationsEnabled=value==true
	local controller=self._DecorationController
	if controller then
		for _,slot in ipairs(controller.Slots or {}) do
			if slot.Frame and slot.Frame.Parent then slot.Frame.Visible=self.DecorationsEnabled end
		end
		controller.Signature=nil
		controller:Sync()
	end
	return self.DecorationsEnabled
end

function XLQPGen1:SetWindowDesignsEnabled(value)
	local previous=self.WindowDesignsEnabled==true
	self.WindowDesignsEnabled=value==true
	local controller=self._DecorationController
	if controller then
		for _,design in ipairs(controller.Designs or {}) do
			if design.Frame and design.Frame.Parent then design.Frame.Visible=self.WindowDesignsEnabled end
		end
		controller.Signature=nil
		controller:Sync()
		if self.WindowDesignsEnabled and not previous then controller:PlayEntrance() end
	end
	return self.WindowDesignsEnabled
end
