function ElementFunction:AddPlugins(PluginConfig)
	PluginConfig = PluginConfig or {}
	PluginConfig.Name = PluginConfig.Name or "Plugins"
	PluginConfig.Folder = PluginConfig.Folder or ((XLQPGen1.Folder or "XLQPGen1") .. "/plugins")
	PluginConfig.AutoLoad = PluginConfig.AutoLoad == true
	PluginConfig.AllowRemote = PluginConfig.AllowRemote ~= false
	PluginConfig.AllowInline = PluginConfig.AllowInline ~= false
	PluginConfig.SaveInline = PluginConfig.SaveInline ~= false
	PluginConfig.RemotePlugins = PluginConfig.RemotePlugins or PluginConfig.URLs or {}

	local Manager = {
		Type = "Plugins",
		Name = PluginConfig.Name,
		Folder = PluginConfig.Folder,
		Plugins = {},
		RuntimePlugins = {},
		Loaded = {},
		Selected = nil,
		PendingCode = "",
		PendingName = "",
		Host = self
	}

	local function notify(title, text)
		if XLQPGen1 and XLQPGen1.MakeNotification then
			XLQPGen1:MakeNotification({Name = tostring(title), Content = tostring(text), Time = 4})
		end
	end

	local function trim(value)
		return tostring(value or ""):match("^%s*(.-)%s*$") or ""
	end

	local function ensureFolder()
		if not makefolder then return false end
		pcall(function()
			local root = tostring(XLQPGen1.Folder or "XLQPGen1")
			if not isfolder or not isfolder(root) then makefolder(root) end
			if not isfolder or not isfolder(Manager.Folder) then makefolder(Manager.Folder) end
		end)
		return true
	end

	local function basename(path)
		return tostring(path or ""):gsub("\\", "/"):match("([^/]+)$") or "Plugin"
	end

	local function stripExtension(name)
		return tostring(name or "Plugin"):gsub("%.lua$", ""):gsub("%.txt$", ""):gsub("%.luau$", "")
	end

	local function safeName(name)
		name = stripExtension(trim(name)):gsub("[^%w%-%_ ]", ""):gsub("%s+", "_")
		if name == "" then name = "Plugin_" .. tostring(os.time()) end
		return name
	end

	local function displayName(name)
		return stripExtension(tostring(name or "Plugin")):gsub("_", " ")
	end

	local function normalizeRemote(entry, index)
		if type(entry) == "string" then
			return {Name = "Remote Plugin " .. tostring(index), URL = entry, Save = false}
		end
		if type(entry) == "table" then
			return {
				Name = tostring(entry.Name or entry.Title or ("Remote Plugin " .. tostring(index))),
				URL = tostring(entry.URL or entry.Url or entry.Source or ""),
				AutoLoad = entry.AutoLoad == true,
				Save = entry.Save == true
			}
		end
	end

	local function makeAPI(record)
		local api = {
			Library = XLQPGen1,
			Plugin = record,
			Manager = Manager,
			Name = record.Name,
			Source = record.Source,
			Folder = Manager.Folder,
			WindowFolder = XLQPGen1.Folder,
			Notify = notify
		}
		function api.GetTab(name)
			name=tostring(name or "")
			for _,info in ipairs(AllSideTabObjects or {}) do
				if info and info.Name and tostring(info.Name):lower()==name:lower() then
					return GetElements(info.Container)
				end
			end
			return nil
		end
		api.Tab=api.GetTab
		function api.ListTabs()
			local names={}
			for _,info in ipairs(AllSideTabObjects or {}) do
				if info and info.Name then table.insert(names,tostring(info.Name)) end
			end
			return names
		end
		setmetatable(api, {
			__index = function(_, key)
				local value = Manager.Host[key]
				if type(value) == "function" then
					return function(_, ...)
						return value(Manager.Host, ...)
					end
				end
				return value
			end
		})
		return api
	end

	local function uniqueRecordName(base)
		local wanted = displayName(base)
		local used = {}
		for _, record in ipairs(Manager.Plugins) do used[record.Name:lower()] = true end
		if not used[wanted:lower()] then return wanted end
		local index = 2
		while used[(wanted .. " " .. tostring(index)):lower()] do index += 1 end
		return wanted .. " " .. tostring(index)
	end

	function Manager:Scan()
		table.clear(self.Plugins)
		ensureFolder()
		if listfiles and isfolder and isfolder(self.Folder) then
			local ok, files = pcall(listfiles, self.Folder)
			if ok and type(files) == "table" then
				for _, path in ipairs(files) do
					local lower = tostring(path):lower()
					if lower:sub(-4) == ".lua" or lower:sub(-4) == ".txt" or lower:sub(-5) == ".luau" then
						local rawName = stripExtension(basename(path))
						table.insert(self.Plugins, {Name = displayName(rawName), FileName = rawName, Path = path, Kind = "File", Source = path})
					end
				end
			end
		end
		for _, record in ipairs(self.RuntimePlugins) do table.insert(self.Plugins, record) end
		for index, entry in ipairs(PluginConfig.RemotePlugins) do
			local remote = normalizeRemote(entry, index)
			if remote and remote.URL ~= "" then
				table.insert(self.Plugins, {Name = remote.Name, URL = remote.URL, Kind = "Remote", Source = remote.URL, AutoLoad = remote.AutoLoad, Save = remote.Save})
			end
		end
		table.sort(self.Plugins, function(a, b)
			if a.Kind == b.Kind then return a.Name:lower() < b.Name:lower() end
			local order = {File = 1, Inline = 2, Remote = 3}
			return (order[a.Kind] or 9) < (order[b.Kind] or 9)
		end)
		return self.Plugins
	end

	function Manager:GetNames()
		local names = {}
		for _, plugin in ipairs(self.Plugins) do table.insert(names, plugin.Name) end
		if #names == 0 then table.insert(names, "No plugins found") end
		return names
	end

	function Manager:Find(name)
		for _, plugin in ipairs(self.Plugins) do
			if plugin.Name == name then return plugin end
		end
	end

	function Manager:Read(record)
		if not record then return nil, "No plugin selected" end
		if record.Kind == "Inline" then return tostring(record.Code or "") end
		if record.Kind == "File" then
			if not readfile then return nil, "readfile is unavailable" end
			local ok, source = pcall(readfile, record.Path)
			if not ok then return nil, source end
			return tostring(source)
		end
		if record.Kind == "Remote" then
			if not PluginConfig.AllowRemote then return nil, "Remote plugins are disabled" end
			local ok, source = pcall(function() return game:HttpGet(record.URL) end)
			if not ok then return nil, source end
			return tostring(source)
		end
		return nil, "Unsupported plugin type"
	end

	function Manager:SaveCode(code, name)
		code = tostring(code or "")
		if trim(code) == "" then return false, "Paste plugin code first" end
		if not writefile then return false, "writefile is unavailable" end
		ensureFolder()
		local fileName = safeName(name)
		local path = self.Folder .. "/" .. fileName .. ".lua"
		local ok, err = pcall(writefile, path, code)
		if not ok then return false, err end
		self:Refresh(displayName(fileName))
		return true, path
	end

	function Manager:AddCode(code, name, saveToFolder)
		if not PluginConfig.AllowInline then return false, "Inline plugins are disabled" end
		code = tostring(code or "")
		if trim(code) == "" then return false, "Paste plugin code first" end
		name = uniqueRecordName(name ~= "" and name or "Pasted Command")
		if saveToFolder == nil then saveToFolder = PluginConfig.SaveInline end
		if saveToFolder and writefile then
			local ok, result = self:SaveCode(code, name)
			if ok then return true, self:Find(name) or result end
		end
		local record = {Name = name, Kind = "Inline", Code = code, Source = "Pasted code", Runtime = true}
		table.insert(self.RuntimePlugins, record)
		self:Refresh(name)
		return true, record
	end

	function Manager:InstallURL(url, name)
		if not PluginConfig.AllowRemote then return false, "Remote plugins are disabled" end
		url = trim(url)
		if url == "" then return false, "Missing plugin URL" end
		local ok, source = pcall(function() return game:HttpGet(url) end)
		if not ok then return false, source end
		local pluginName = name ~= "" and name or stripExtension(basename(url:gsub("%?.*$", "")))
		local saved, result = self:SaveCode(source, pluginName)
		if not saved then return false, result end
		return true, self:Find(displayName(safeName(pluginName))) or result
	end

	function Manager:ExecuteSource(source, record)
		if type(loadstring) ~= "function" then return false, "loadstring is unavailable" end
		local chunk, compileError = loadstring(tostring(source or ""), "XLQPPlugin:" .. tostring(record.Name))
		if not chunk then return false, compileError end
		local ok, exported = pcall(chunk)
		if not ok then return false, exported end
		local result = exported
		local api = makeAPI(record)
		if type(exported) == "function" then
			local ran, output = pcall(exported, api)
			if not ran then return false, output end
			result = output
		elseif type(exported) == "table" then
			record.Metadata = exported
			local renamed = trim(exported.Name or exported.Title)
			if renamed ~= "" then record.DisplayName = renamed end
			local initializer = exported.Init or exported.Load or exported.Start
			if type(initializer) == "function" then
				local ran, output = pcall(initializer, exported, api)
				if not ran then return false, output end
				result = output or exported
			end
		end
		return true, result
	end

	function Manager:Load(name, forceReload)
		local record = type(name) == "table" and name or self:Find(name or self.Selected)
		if not record then return false, "Plugin not found" end
		if self.Loaded[record.Name] and not forceReload then return true, self.Loaded[record.Name].Result end
		if forceReload and self.Loaded[record.Name] then self:Unload(record.Name) end
		local source, readError = self:Read(record)
		if not source then return false, readError end
		local ok, result = self:ExecuteSource(source, record)
		if not ok then return false, result end
		self.Loaded[record.Name] = {Result = result, Record = record, LoadedAt = os.time()}
		notify("Plugin loaded", record.DisplayName or record.Name)
		if type(PluginConfig.Callback) == "function" then SafeCallback(PluginConfig.Callback, PluginConfig.Name, record, result) end
		return true, result
	end

	function Manager:RunCode(code, name, saveToFolder)
		local ok, record = self:AddCode(code, name, saveToFolder)
		if not ok then return false, record end
		if type(record) ~= "table" then
			self:Refresh(name)
			record = self:Find(name) or self:Find(displayName(safeName(name)))
		end
		return self:Load(record, true)
	end

	function Manager:RunCommand(command, name, saveToFolder)
		command = trim(command)
		if command == "" then return false, "Paste a command, URL, or Lua source first" end
		local named, body = command:match("^%s*([^:\n]+)%s*::%s*(.+)$")
		if named and body then name, command = trim(named), body end
		if command:match("^https?://") then
			local ok, recordOrError = self:InstallURL(command, name)
			if not ok then return false, recordOrError end
			return self:Load(recordOrError, true)
		end
		return self:RunCode(command, name, saveToFolder)
	end

	function Manager:Unload(name)
		local record = type(name) == "table" and name or self:Find(name or self.Selected)
		if not record then return false, "Plugin not found" end
		local state = self.Loaded[record.Name]
		local loaded = state and state.Result
		if type(loaded) == "table" then
			local unload = loaded.Unload or loaded.Destroy or loaded.Stop
			if type(unload) == "function" then pcall(unload, loaded) end
		elseif record.Metadata and type(record.Metadata) == "table" then
			local unload = record.Metadata.Unload or record.Metadata.Destroy or record.Metadata.Stop
			if type(unload) == "function" then pcall(unload, record.Metadata) end
		end
		self.Loaded[record.Name] = nil
		notify("Plugin unloaded", record.Name)
		return true
	end

	function Manager:Delete(name)
		local record = type(name) == "table" and name or self:Find(name or self.Selected)
		if not record then return false, "Plugin not found" end
		self:Unload(record)
		if record.Kind == "File" then
			if not delfile then return false, "delfile is unavailable" end
			local ok, err = pcall(delfile, record.Path)
			if not ok then return false, err end
		elseif record.Kind == "Inline" then
			for index = #self.RuntimePlugins, 1, -1 do
				if self.RuntimePlugins[index] == record then table.remove(self.RuntimePlugins, index) break end
			end
		else
			return false, "Remote entries cannot be deleted from this list"
		end
		self:Refresh()
		return true
	end

	local selector = self:AddDropdown({
		Name = PluginConfig.Name,
		Options = {"Scanning plugins..."},
		Default = "Scanning plugins...",
		Callback = function(value) Manager.Selected = value end
	})

	local nameBox = self:AddTextbox({
		Name = PluginConfig.NameTextbox or "Plugin name (optional)",
		Default = "",
		TextDisappear = false,
		Callback = function(value) Manager.PendingName = trim(value) end
	})

	local commandBox = self:AddTextbox({
		Name = PluginConfig.CodeTextbox or "Paste plugin code, command, or raw URL",
		Default = "",
		TextDisappear = false,
		Callback = function(value) Manager.PendingCode = tostring(value or "") end
	})

self:AddActionRow({
		Name = "Code",
		Outline = true,
		OutlineColor = "Bloom",
		Buttons = {
			{Name = "Run", Callback = function()
				local ok, result = Manager:RunCommand(Manager.PendingCode, Manager.PendingName, PluginConfig.SaveInline)
				if not ok then notify("Plugin error", result) end
			end},
			{Name = "Save Only", Callback = function()
				local ok, result = Manager:SaveCode(Manager.PendingCode, Manager.PendingName)
				if ok then notify("Plugin saved", result) else notify("Save failed", result) end
			end},
			{Name = "Refresh", Callback = function() Manager:Refresh() end}
		}
	})
	self:AddActionRow({
		Name = "Selected",
		Outline = true,
		OutlineColor = "Bloom",
		Buttons = {
			{Name = "Load", Callback = function()
				local ok, err = Manager:Load()
				if not ok then notify("Plugin error", err) end
			end},
			{Name = "Reload", Callback = function()
				local ok, err = Manager:Load(nil, true)
				if not ok then notify("Plugin error", err) end
			end},
			{Name = "Unload", Callback = function()
				local ok, err = Manager:Unload()
				if not ok then notify("Plugin error", err) end
			end},
			{Name = "Delete", Callback = function()
				local ok, err = Manager:Delete()
				if ok then notify("Plugin deleted", "Removed from plugins") else notify("Delete failed", err) end
			end}
		}
	})

	function Manager:Refresh(preferred)
		self:Scan()
		local names = self:GetNames()
		if selector and selector.Refresh then selector:Refresh(names, true, false) end
		local selected = preferred and self:Find(preferred) and preferred or names[1]
		self.Selected = selected
		if selector and selector.Set then pcall(function() selector:Set(selected) end) end
		return names
	end

	Manager.Selector = selector
	Manager.NameBox = nameBox
	Manager.CommandBox = commandBox
	Manager:Refresh()

	if PluginConfig.AutoLoad then
		task.defer(function()
			for _, record in ipairs(Manager.Plugins) do
				if record.Kind == "File" or record.AutoLoad then
					local ok, err = Manager:Load(record)
					if not ok then warn("[XLQP Plugin]", record.Name, err) end
				end
			end
		end)
	end

	table.insert(XLQPGen1.AllElements, Manager)
	return Manager
end

