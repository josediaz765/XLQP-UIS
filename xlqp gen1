function XLQPGen1:CreatePopup(PopupConfig)
	PopupConfig=type(PopupConfig)=="table" and PopupConfig or {Title=tostring(PopupConfig or "Popup")}
	local options=PopupConfig.Options or PopupConfig.options or {{Text="Okay",Variant="Primary"}}
	local footer={}
	local popup
	local resultSignal=CreateXLQPSignal()
	for index,option in ipairs(options) do
		option=type(option)=="table" and option or {Text=tostring(option)}
		local key=tostring(option.Key or option.key or option.Name or option.name or option.Text or option.text or ("Option"..index))
		footer[key]={Title=option.Text or option.text or option.Title or option.title or option.Name or option.name or key,Variant=option.Variant or option.variant or (index==1 and "Primary" or "Secondary"),Order=option.Order or option.order or index,WaitTime=option.Timeout or option.timeout or option.WaitTime or option.waitTime,Callback=function(dialog)
			local value=option.Value
			if value==nil then value=option.Accept==true or option.Continue==true end
			if type(option.Callback or option.callback)=="function" then pcall(option.Callback or option.callback,popup or dialog,value,index,option) end
			resultSignal:Fire(value,index,option,popup or dialog)
			if option.Close~=false and option.close~=false and PopupConfig.AutoDismiss~=false then dialog:Dismiss() end
		end}
	end
	popup=self:_CreateDialog(self._ActiveWindow or self,PopupConfig.Id or PopupConfig.Name or "Popup",{Title=PopupConfig.Title or PopupConfig.Name or "Popup",Description=PopupConfig.Description or PopupConfig.Content or "",FooterButtons=footer,AutoDismiss=false,OutsideClickDismiss=PopupConfig.OutsideClickDismiss==true,DimBackground=PopupConfig.DimBackground,BackgroundTransparency=PopupConfig.BackgroundTransparency,OverlayColor=PopupConfig.OverlayColor})
	popup.OnResult=resultSignal
	popup.Options=options
	function popup:Close() self:Dismiss() return self end
	return popup
end
