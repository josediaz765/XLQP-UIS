function XLQPRequestFunctions()
	local list = {}
	local seen = {}
	local environment = getgenv and getgenv() or nil
	local function add(candidate)
		if type(candidate) == "function" and not seen[candidate] then
			seen[candidate] = true
			list[#list + 1] = candidate
		end
	end
	add(request)
	add(environment and environment.request)
	add(http_request)
	add(environment and environment.http_request)
	add(http and http.request)
	add(fluxus and fluxus.request)
	add(syn and syn.request)
	add(flux and flux.request)
	add(krnl and krnl.request)
	return list
end

function XLQPResolveRequest()
