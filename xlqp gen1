function playGroupTween(object,info,goals)
if not object then return nil end
local existing=XLQPGroupTweens[object]
if existing then pcall(function() existing:Cancel() end) end
local tween=TweenService:Create(object,info,goals)
XLQPGroupTweens[object]=tween
tween:Play()
return tween
end
