					local repairSystem = "You are a precise general AI assistant. Answer CURRENT_USER_QUESTION directly in the first sentence. Images, URLs, tools, search steps, and reference context are supplementary only. For a who/what question, repeat the requested name or topic and clearly identify it. Never answer a different subject."
					local repairPrompt = aiBuildDirectRepairPrompt(prompt, augmentedPrompt)
					local retrySuccess, retryResult = pollinationsAI({
						{role = "system", content = repairSystem},
						{role = "user", content = repairPrompt}
					}, repairSystem .. "\n" .. repairPrompt, function(candidate)
						local rejected, reason = aiAnswerNeedsRepair(prompt, candidate)
						if rejected then return false, reason end
						if aiResponseLooksRobloxScriptBiased(candidate) then return false, "script-style answer for a general question" end
						return true
					end)
					if retrySuccess and retryResult then
						local retryText = sharedAIClean(extractAIText(retryResult))
						local retryNeedsRepair = aiAnswerNeedsRepair(prompt, retryText)
						if retryText ~= "" and not retryNeedsRepair and not aiResponseLooksRobloxScriptBiased(retryText) then
							responseText = retryText
							process:Event({State = "done", Id = "repair_direct_answer", Tool = "repair_response", Detail = "rebuilt as a direct matching answer"})
						else
							process:Event({State = "fail", Id = "repair_direct_answer", Tool = "repair_response", Detail = "retry still did not match the current question"})
						end
