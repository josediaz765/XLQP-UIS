		if not ok then return false,err end
		return true,path
	end
	function PluginsData:Execute(record)
		if type(loadstring)~="function" then return false,"loadstring is unavailable" end
		local source,err=self:Read(record)
		if not source then return false,err end
		local chunk,compileError=loadstring(source,"XLQPPlugin:"..tostring(record.Name))
		if not chunk then return false,compileError end
		local ok,exported=pcall(chunk)
		if not ok then return false,exported end
		local api=makePluginAPI(record)
		if type(exported)=="table" then
			exported.API=api
			local initializer=exported.Init or exported.Load or exported.Start
			if type(initializer)=="function" then
				local ran,output=pcall(initializer,exported,api)
				if not ran then return false,output end
			end
		elseif type(exported)=="function" then
			local ran,output=pcall(exported,api)
			if not ran then return false,output end
		end
		record.Loaded=true
		return true
	end
	function PluginsData:ValidateSource(source,name)
		source=tostring(source or "")
		if pluginsTrim(source)=="" then return false,"Plugin source is empty" end
		if #source>120000 then return false,"Plugin source is too large" end
		if type(loadstring)~="function" then return false,"loadstring is unavailable" end
		local lower=source:lower()
		local forbidden={
			{"loadstring%s*%(","nested loadstring"},{"game%s*:%s*httpget","remote code download"},{"getgenv%s*%(","global environment access"},
			{"getrawmetatable%s*%(","metatable hooking"},{"hookfunction%s*%(","function hooking"},{"delfile%s*%(","file deletion"},
			{"queue_on_teleport%s*%(","teleport persistence"},{"while%s+true%s+do","unbounded loop"}
		}
		for _,rule in ipairs(forbidden) do if lower:match(rule[1]) then return false,"Unsupported generated-plugin operation: "..rule[2] end end
		local requestedTabs={}
		for tabName in source:gmatch('API%.GetTab%s*%(%s*"([^"]+)"') do requestedTabs[#requestedTabs+1]=tabName end
		for tabName in source:gmatch("API%.GetTab%s*%(%s*'([^']+)'") do requestedTabs[#requestedTabs+1]=tabName end
		for _,tabName in ipairs(requestedTabs) do
			if pluginsHomeRestricted(tabName) then return false,"Plugins cannot add controls to the Home tab." end
			if not pluginsFindTab(tabName) then return false,"Tab '"..tostring(tabName).."' does not exist. Available tabs: "..table.concat(pluginsListTabs(),", ") end
		end
		local chunk,compileError=loadstring(source,"XLQPPluginValidation:"..tostring(name or "Plugin"))
		if not chunk then return false,"Syntax error: "..tostring(compileError) end
		local exportedOk,exported=pcall(chunk)
		if not exportedOk then return false,"Top-level error: "..tostring(exported) end
		local initializer
		if type(exported)=="function" then initializer=exported
		elseif type(exported)=="table" then initializer=exported.Init or exported.Load or exported.Start
		else return false,"Plugin must return function(API) or a table with Init, Load, or Start" end
		if type(initializer)~="function" then return false,"Plugin initializer is missing" end
		local validationHost=Create("Frame",{Name="XLQPPluginValidationHost",Size=UDim2.fromOffset(520,520),Position=UDim2.fromOffset(-10000,-10000),Visible=false,BackgroundTransparency=1,Parent=XLQPGen1Gui})
		Create("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Parent=validationHost})
		local validationElements=GetElements(validationHost)
		local validationRecord={Name=tostring(name or "AI Plugin"),Kind="Validation",Validation=true}
		local validationAPI={Library=XLQPGen1,XLQPGen1=XLQPGen1,Plugin=validationRecord,Folder=PluginsFolder}
		function validationAPI.Notify() end
		function validationAPI.ListTabs() return pluginsListTabs() end
		function validationAPI.GetTab(requested)
			if pluginsFindTab(requested) then return validationElements end
			return nil
		end
		validationAPI.Tab=validationAPI.GetTab
		local ran,runError
		if type(exported)=="table" then exported.API=validationAPI ran,runError=pcall(initializer,exported,validationAPI)
		else ran,runError=pcall(initializer,validationAPI) end
		pcall(function() validationHost:Destroy() end)
		if not ran then return false,"Initialization error: "..tostring(runError) end
		return true,"Validated"
	end
