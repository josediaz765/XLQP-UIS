	local function descendantOf(object,ancestor)
		if not (object and ancestor) then return false end
		local ok,value=pcall(function() return object:IsDescendantOf(ancestor) end)
		return ok and value==true
	end
	local function cleanName(value,fallback)
		value=tostring(value or ""):gsub("<[^>]->",""):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
		return value~="" and value or fallback
	end
	local function ownerForWrapper(wrapper)
		for _,tab in ipairs(AllSideTabObjects or {}) do if tab.Container and descendantOf(wrapper,tab.Container) then return tab,cleanName(tab.Name,"Tab") end end
		for _,tab in ipairs(AllTopTabObjects or {}) do if tab.Container and descendantOf(wrapper,tab.Container) then return tab,cleanName(tab.Name,"Page") end end
		return nil,"Interface"
	end
	local function elementText(element,wrapper)
		local parts={} local seen={} local count=0
		local function push(value)
			if value==nil then return end
			local text=tostring(value):gsub("<[^>]->",""):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
			local key=text:lower()
			if text~="" and #text<=180 and not seen[key] then seen[key]=true parts[#parts+1]=text end
		end
		push(element and element.Name) push(element and element.Title) push(element and element.Type)
		if wrapper then
			push(wrapper:GetAttribute("SearchName"))
			for _,desc in ipairs(wrapper:GetDescendants()) do
				if count>=24 then break end
				if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
					push(desc:GetAttribute("OriginalText")) push(desc.Text)
					if desc:IsA("TextBox") then push(desc.PlaceholderText) end
					count+=1
				end
			end
		end
		return parts
	end
	local function buildIndex()
		table.clear(indexRecords)
		local seen=setmetatable({},{__mode="k"})
		for _,element in ipairs(self.AllElements or {}) do
			local wrapper=element and element.Wrapper
			if wrapper and wrapper.Parent and not seen[wrapper] then
				seen[wrapper]=true
				local owner,tabName=ownerForWrapper(wrapper)
				local parts=elementText(element,wrapper)
				local typeName=cleanName(element.Type,wrapper.Name or "Element")
				local name=cleanName(element.Name or element.Title,parts[1] or typeName)
				local category=XLQPSearchMenuCategory(typeName,name)
				local path=tabName
				indexRecords[#indexRecords+1]={name=name,type=typeName,category=category,target=element,wrapper=wrapper,owner=owner,tabName=tabName,path=path,search=(table.concat(parts," ").." "..typeName.." "..category.." "..tabName):lower()}
			end
		end
		table.sort(indexRecords,function(a,b)
			if a.tabName~=b.tabName then return tostring(a.tabName):lower()<tostring(b.tabName):lower() end
			return tostring(a.name):lower()<tostring(b.name):lower()
		end)
		liveBadge.Text=tostring(#indexRecords).." LIVE"
	end
