local XLQPYouTubeMusic={}

function XLQPYouTubeMusic.trim(value)
	return tostring(value or ""):match("^%s*(.-)%s*$")
end

function XLQPYouTubeMusic.videoId(value)
	value=XLQPYouTubeMusic.trim(value)
	if value:match("^[%w_-]+$") and #value==11 then return value end
	for _,pattern in ipairs({"[?&]v=([%w_-]+)","youtu%.be/([%w_-]+)","youtube%.com/shorts/([%w_-]+)","youtube%.com/embed/([%w_-]+)","youtube%.com/live/([%w_-]+)"}) do
		local id=value:match(pattern)
		if id and #id>=11 then return id:sub(1,11) end
	end
	return nil
end

function XLQPYouTubeMusic.header(headers,name)
	if type(headers)~="table" then return nil end
	name=tostring(name or ""):lower()
	for key,value in pairs(headers) do if tostring(key):lower()==name then return value end end
	return nil
end

function XLQPYouTubeMusic.request(options)
	local requester=request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)
	local current=options
	for _=1,5 do
		local response
		if type(requester)=="function" then
			local ok,result=pcall(requester,current)
			if not ok then error(tostring(result)) end
			response=result
		elseif tostring(current.Method or "GET"):upper()=="GET" then
			local ok,result=pcall(function() return game:HttpGet(current.Url,true) end)
			if not ok then error(tostring(result)) end
			response={StatusCode=200,Body=result,Headers={}}
		else
			error("Executor HTTP request function was not found")
		end
		if type(response)~="table" then error("Executor returned an invalid HTTP response") end
		response.Headers=type(response.Headers)=="table" and response.Headers or response.headers or {}
		response.Body=type(response.Body)=="string" and response.Body or response.body or response.ResponseBody or response.responseBody or response.Data
		local code=tonumber(response.StatusCode or response.Status or 0) or 0
		if code>=300 and code<400 then
			local location=XLQPYouTubeMusic.header(response.Headers,"location")
			if not location then error("Redirect response did not include a location") end
			current={Url=location,Method="GET",Headers=current.Headers or {},Timeout=current.Timeout}
		else
			if code<200 or code>=400 then error("HTTP "..tostring(code)..": "..tostring(response.Body or "request failed")) end
			if type(response.Body)~="string" or #response.Body==0 then error("Downloaded response was empty") end
			return response
		end
	end
	error("Too many HTTP redirects")
end

function XLQPYouTubeMusic.base64(value)
	local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local output={}
	for index=1,#value,3 do
		local first=value:byte(index) or 0
		local second=value:byte(index+1)
		local third=value:byte(index+2)
		local packed=first*65536+(second or 0)*256+(third or 0)
		local a=math.floor(packed/262144)%64
		local b=math.floor(packed/4096)%64
		local c=math.floor(packed/64)%64
		local d=packed%64
		output[#output+1]=alphabet:sub(a+1,a+1)
		output[#output+1]=alphabet:sub(b+1,b+1)
		output[#output+1]=second and alphabet:sub(c+1,c+1) or "="
		output[#output+1]=third and alphabet:sub(d+1,d+1) or "="
	end
	return table.concat(output)
end

function XLQPYouTubeMusic.folder(path)
	if type(makefolder)~="function" or type(isfolder)~="function" then return false end
	local current=""
	for part in tostring(path or ""):gmatch("[^/\\]+") do
		current=current=="" and part or current.."/"..part
		if not isfolder(current) then pcall(makefolder,current) end
	end
	return isfolder(path)
end

function XLQPYouTubeMusic.asset(path)
	local resolver=getcustomasset or getsynasset
	if type(resolver)~="function" then return nil end
	local ok,result=pcall(resolver,path)
	return ok and result or nil
end

function XLQPYouTubeMusic.writeAsset(url,path,headers)
	if type(isfile)=="function" and isfile(path) then return XLQPYouTubeMusic.asset(path),path end
	if type(writefile)~="function" then error("writefile was not found") end
	local response=XLQPYouTubeMusic.request({Url=url,Method="GET",Headers=headers or {},Timeout=60})
	writefile(path,response.Body)
	return XLQPYouTubeMusic.asset(path),path
end

function XLQPYouTubeMusic.decodeText(value)
	return tostring(value or ""):gsub("&amp;","&"):gsub("&quot;","\""):gsub("&#39;","'"):gsub("&lt;","<"):gsub("&gt;",">")
end

function XLQPYouTubeMusic.textValue(node)
	if type(node)~="table" then return tostring(node or "") end
	if type(node.simpleText)=="string" then return XLQPYouTubeMusic.decodeText(node.simpleText) end
	local output={}
	for _,run in ipairs(type(node.runs)=="table" and node.runs or {}) do if run.text then output[#output+1]=run.text end end
	return XLQPYouTubeMusic.decodeText(table.concat(output))
end

function XLQPYouTubeMusic.innertubeClient()
	if XLQPYouTubeMusic.WebKey and XLQPYouTubeMusic.WebVersion then return XLQPYouTubeMusic.WebKey,XLQPYouTubeMusic.WebVersion,XLQPYouTubeMusic.VisitorData end
	local response=XLQPYouTubeMusic.request({Url="https://www.youtube.com/?hl=en",Method="GET",Headers={Accept="text/html,application/xhtml+xml",["Accept-Language"]="en-US,en;q=0.9",["User-Agent"]="Mozilla/5.0"},Timeout=30})
	local body=response.Body
	local key=body:match('"INNERTUBE_API_KEY":"([^"]+)"')
	local version=body:match('"INNERTUBE_CLIENT_VERSION":"([^"]+)"')
	local visitor=body:match('"VISITOR_DATA":"([^"]+)"') or ""
	if not key or key=="" or not version or version=="" then error("YouTube web search configuration was not found") end
	XLQPYouTubeMusic.WebKey=key
	XLQPYouTubeMusic.WebVersion=version
	XLQPYouTubeMusic.VisitorData=visitor
	return key,version,visitor
end

function XLQPYouTubeMusic.innertubeResults(data)
	local results={}
	local seen={}
	local continuation=""
	local function walk(node)
		if type(node)~="table" then return end
		local video=node.videoRenderer
		if type(video)=="table" and video.videoId and not seen[video.videoId] and #results<10 then
			seen[video.videoId]=true
			local thumbnails=video.thumbnail and video.thumbnail.thumbnails or {}
			local thumbnail=thumbnails[#thumbnails] and thumbnails[#thumbnails].url or ("https://i.ytimg.com/vi/"..video.videoId.."/hqdefault.jpg")
			if thumbnail:sub(1,2)=="//" then thumbnail="https:"..thumbnail end
			results[#results+1]={VideoId=video.videoId,Title=XLQPYouTubeMusic.textValue(video.title),Channel=XLQPYouTubeMusic.textValue(video.ownerText or video.longBylineText or video.shortBylineText),ThumbnailUrl=thumbnail,URL="https://www.youtube.com/watch?v="..video.videoId}
		end
		local item=node.continuationItemRenderer
		local token=item and item.continuationEndpoint and item.continuationEndpoint.continuationCommand and item.continuationEndpoint.continuationCommand.token
		if type(token)=="string" and token~="" then continuation=token end
		for _,value in pairs(node) do if type(value)=="table" then walk(value) end end
	end
	walk(data)
	return results,continuation
end

function XLQPYouTubeMusic.innertubeSearch(query,pageToken)
	local key,version,visitor=XLQPYouTubeMusic.innertubeClient()
	local client={clientName="WEB",clientVersion=version,hl="en",gl="US",utcOffsetMinutes=0}
	if visitor~="" then client.visitorData=visitor end
	local payload={context={client=client}}
	if pageToken and pageToken~="" then payload.continuation=pageToken else payload.query=query end
	local response=XLQPYouTubeMusic.request({Url="https://www.youtube.com/youtubei/v1/search?prettyPrint=false&key="..HttpService:UrlEncode(key),Method="POST",Headers={Accept="application/json",["Content-Type"]="application/json",Origin="https://www.youtube.com",Referer="https://www.youtube.com/",["User-Agent"]="Mozilla/5.0",["X-Youtube-Client-Name"]="1",["X-Youtube-Client-Version"]=version},Body=HttpService:JSONEncode(payload),Timeout=30})
	local ok,data=pcall(HttpService.JSONDecode,HttpService,response.Body)
	if not ok or type(data)~="table" then error("YouTube search returned invalid JSON") end
	local results,nextToken=XLQPYouTubeMusic.innertubeResults(data)
	if #results==0 then error("YouTube search returned no videos") end
	return results,nextToken,""
end

function XLQPYouTubeMusic.search(query,key,pageToken)
	query=XLQPYouTubeMusic.trim(query)
	key=XLQPYouTubeMusic.trim(key)
	if query=="" then error("Enter a song name") end
	if key=="" then return XLQPYouTubeMusic.innertubeSearch(query,pageToken) end
	local url="https://www.googleapis.com/youtube/v3/search?part=snippet&type=video&order=relevance&safeSearch=moderate&maxResults=10&q="..HttpService:UrlEncode(query).."&key="..HttpService:UrlEncode(key)
	if pageToken and pageToken~="" then url=url.."&pageToken="..HttpService:UrlEncode(pageToken) end
	local response=XLQPYouTubeMusic.request({Url=url,Method="GET",Headers={Accept="application/json"},Timeout=30})
	local ok,data=pcall(HttpService.JSONDecode,HttpService,response.Body)
	if not ok or type(data)~="table" then error("YouTube API returned invalid JSON") end
	if data.error then error(tostring(data.error.message or "YouTube API request failed")) end
	local results={}
	for _,entry in ipairs(type(data.items)=="table" and data.items or {}) do
		local id=entry.id and entry.id.videoId
		local snippet=entry.snippet or {}
		if id then
			local thumbs=snippet.thumbnails or {}
			local thumb=(thumbs.high or thumbs.medium or thumbs.default or {}).url or ("https://i.ytimg.com/vi/"..id.."/hqdefault.jpg")
			results[#results+1]={VideoId=id,Title=XLQPYouTubeMusic.decodeText(snippet.title or id),Channel=XLQPYouTubeMusic.decodeText(snippet.channelTitle or "YouTube"),ThumbnailUrl=thumb,URL="https://www.youtube.com/watch?v="..id}
		end
	end
	return results,tostring(data.nextPageToken or ""),tostring(data.prevPageToken or "")
end

function XLQPYouTubeMusic.convert(videoId,base,progress)
	base=tostring(base or "https://yt-api.org"):gsub("/+$","")
	local payload=HttpService:JSONEncode({videoId=videoId,format="mp3"})
	progress("Creating MP3 conversion session")
	local session=XLQPYouTubeMusic.request({Url=base.."/",Method="POST",Headers={Accept="application/json",["Content-Type"]="application/json",["X-Requested-With"]="XMLHttpRequest",Authorization=XLQPYouTubeMusic.base64(payload),Origin=base,Referer=base.."/button/mp3/"..videoId},Body=payload,Timeout=60})
	local token=XLQPYouTubeMusic.header(session.Headers,"authorization")
	if type(token)~="string" or token=="" then error("Converter session did not return an authorization token") end
	local data
	for attempt=1,3 do
		progress("Requesting MP3 conversion "..attempt.."/3")
		local response=XLQPYouTubeMusic.request({Url=base.."/api",Method="POST",Headers={Accept="application/json",["Content-Type"]="application/x-www-form-urlencoded",Authorization=token,Origin=base,Referer=base.."/button/mp3/"..videoId},Body="",Timeout=60})
		local ok,result=pcall(HttpService.JSONDecode,HttpService,response.Body)
		if not ok or type(result)~="table" then error("Converter returned invalid JSON") end
		data=result
		if not data.error then break end
	end
	for _=1,40 do
		if type(data.downloadUrl)=="string" and data.downloadUrl~="" then return data.downloadUrl,data.title or videoId end
		if data.status=="fail" then error(tostring(data.message or "MP3 conversion failed")) end
		if data.status~="processing" or type(data.hash)~="string" then error(tostring(data.message or "Converter did not return an MP3 URL")) end
		progress("Converting MP3 "..tostring(data.progress or 0).."%")
		task.wait(3)
		local response=XLQPYouTubeMusic.request({Url=base.."/api/status",Method="POST",Headers={Accept="application/json",["Content-Type"]="application/json",Authorization=token,Origin=base,Referer=base.."/button/mp3/"..videoId},Body=HttpService:JSONEncode({hash=data.hash}),Timeout=60})
		local ok,result=pcall(HttpService.JSONDecode,HttpService,response.Body)
		if not ok or type(result)~="table" then error("Converter status returned invalid JSON") end
		data=result
	end
	error("MP3 conversion timed out")
end

function XLQPYouTubeMusic.frames(videoId,folder,progress)
	progress("Fetching ten YouTube video frames")
	local response=XLQPYouTubeMusic.request({Url="https://www.youtube.com/watch?v="..videoId.."&hl=en",Method="GET",Headers={Accept="text/html,application/xhtml+xml",["Accept-Language"]="en-US,en;q=0.9",["User-Agent"]="Mozilla/5.0"},Timeout=30})
	local encoded=response.Body:match('"playerStoryboardSpecRenderer"%s*:%s*{%s*"spec"%s*:%s*"(.-)"')
	if type(encoded)~="string" or encoded=="" then error("YouTube did not return storyboard frames") end
	local ok,spec=pcall(HttpService.JSONDecode,HttpService,'"'..encoded..'"')
	if not ok or type(spec)~="string" then error("YouTube returned an invalid storyboard specification") end
	local chunks=string.split(spec,"|")
	if #chunks<2 then error("YouTube returned no storyboard levels") end
	local values=string.split(chunks[#chunks],"#")
	if #values<8 then error("YouTube returned an incomplete storyboard level") end
	local width,height,count,columns,rows,interval=tonumber(values[1]),tonumber(values[2]),tonumber(values[3]),tonumber(values[4]),tonumber(values[5]),tonumber(values[6])
	if not width or not height or not count or not columns or not rows or not interval or interval<=0 then error("YouTube returned invalid storyboard dimensions") end
	local capacity=columns*rows
	local template=chunks[1]:gsub("%$L",tostring(#chunks-2)):gsub("%$N",values[7]).."&sigh="..values[8]
	local sheets={}
	local frames={}
	local sampleCount=math.min(10,count)
	for sample=1,sampleCount do
		local frameIndex=sampleCount==1 and 0 or math.floor((sample-1)*(count-1)/(sampleCount-1)+0.5)
		local sheetIndex=math.floor(frameIndex/capacity)
		local localFrame=frameIndex%capacity
		if not sheets[sheetIndex] then
			progress("Downloading frame sheet "..tostring(#frames+1).."/10")
			local path=folder.."/"..videoId.."_frames_"..sheetIndex..".jpg"
			local asset=type(isfile)=="function" and isfile(path) and XLQPYouTubeMusic.asset(path) or nil
			if not asset then asset=XLQPYouTubeMusic.writeAsset(template:gsub("%$M",tostring(sheetIndex)),path,{Accept="image/jpeg,image/*",["User-Agent"]="Mozilla/5.0"}) end
			sheets[sheetIndex]={Asset=asset,Path=path}
		end
		frames[#frames+1]={Asset=sheets[sheetIndex].Asset,Path=sheets[sheetIndex].Path,Width=width,Height=height,X=(localFrame%columns)*width,Y=math.floor(localFrame/columns)*height,SourceIndex=frameIndex,Interval=interval}
	end
	return frames
end

