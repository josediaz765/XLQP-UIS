function XLQPGen1:_ShadowName(target)
return "XLQPUIShadow_"..tostring(target and target.Name or "Frame")
end

function XLQPGen1:RemoveUIShadow(target)
if typeof(target)~="Instance" then return end
local host=target.Parent
if host then
local existing=host:FindFirstChild(self:_ShadowName(target))
if existing then existing:Destroy() end
end
local nested=target:FindFirstChild("XLQPUIShadow")
if nested then nested:Destroy() end
end

function XLQPGen1:ApplyUIShadow(target,options)
if typeof(target)~="Instance" or not target:IsA("GuiObject") then return nil end
local host=target.Parent
if not host then return nil end
options=type(options)=="table" and options or {}
self:RemoveUIShadow(target)
local spread=math.clamp(tonumber(options.Spread or options.Size) or 18,4,90)
local transparency=math.clamp(tonumber(options.Transparency) or 0.62,0,1)
local color=typeof(options.Color)=="Color3" and options.Color or Color3.fromRGB(0,0,0)
local offsetX=tonumber(options.OffsetX) or 0
local offsetY=tonumber(options.OffsetY) or 6
local shadow=Create("ImageLabel",{Name=self:_ShadowName(target),BackgroundTransparency=1,Image="rbxassetid://6014261993",ImageColor3=color,ImageTransparency=transparency,ScaleType=Enum.ScaleType.Slice,SliceCenter=Rect.new(49,49,450,450),Active=false,Visible=target.Visible,ZIndex=math.max(0,(target.ZIndex or 1)-1),Parent=host})
shadow:SetAttribute("NoLiquidGlass",true)
local function sync()
if not (shadow.Parent and target.Parent) then return end
local anchor=target.AnchorPoint
shadow.AnchorPoint=anchor
shadow.Position=UDim2.new(target.Position.X.Scale,target.Position.X.Offset+offsetX+spread*(2*anchor.X-1),target.Position.Y.Scale,target.Position.Y.Offset+offsetY+spread*(2*anchor.Y-1))
shadow.Size=UDim2.new(target.Size.X.Scale,target.Size.X.Offset+spread*2,target.Size.Y.Scale,target.Size.Y.Offset+spread*2)
shadow.Visible=target.Visible
shadow.ZIndex=math.max(0,(target.ZIndex or 1)-1)
end
sync()
AddConnection(target:GetPropertyChangedSignal("Position"),sync)
AddConnection(target:GetPropertyChangedSignal("Size"),sync)
AddConnection(target:GetPropertyChangedSignal("Visible"),sync)
AddConnection(target:GetPropertyChangedSignal("AnchorPoint"),sync)
AddConnection(target:GetPropertyChangedSignal("ZIndex"),sync)
AddConnection(target.AncestryChanged,function(_,parent)
if not parent and shadow and shadow.Parent then shadow:Destroy() end
end)
return shadow
end

function XLQPGen1:SetUIShadow(enabled,options)
enabled=enabled==true
WindowConfig.UIShadow=enabled and (type(options)=="table" and options or true) or false
local settings=type(WindowConfig.UIShadow)=="table" and WindowConfig.UIShadow or {}
local targets={MainWindow,SettingsWindow,WindowStuff}
for _,target in ipairs(targets) do
if typeof(target)=="Instance" and target:IsA("GuiObject") then
if enabled then
self:ApplyUIShadow(target,settings)
else
self:RemoveUIShadow(target)
end
end
end
return self
end

