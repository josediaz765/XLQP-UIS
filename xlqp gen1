local statusAlive=true
local statusVisible=false
local statusMemory=0
local nextMemoryRead=0
local lastMemoryText
local lastPingText
local lastFpsText
local lastRegionText
local lastErrorCount
local lastHasErrors

local function layoutStatusBar()
if XLQPGen1._MinimizeSizeTweenActive==true then return end
