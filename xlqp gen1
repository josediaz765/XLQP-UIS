		if StyleTable.Gap~=nil then target.Gap=math.max(0,math.floor(tonumber(StyleTable.Gap) or 0)) end
		if StyleTable.Padding~=nil then target.Padding=math.max(0,math.floor(tonumber(StyleTable.Padding) or 0)) end
		if StyleTable.CornerRadius~=nil then target.CornerRadius=math.clamp(tonumber(StyleTable.CornerRadius) or 0,0,32) end
		if StyleTable.Indicator~=nil then target.Indicator=StyleTable.Indicator==true end
		if StyleTable.IndicatorWidth~=nil then target.IndicatorWidth=math.max(1,math.floor(tonumber(StyleTable.IndicatorWidth) or 2)) end
		if StyleTable.IndicatorHeight~=nil then target.IndicatorHeight=math.max(4,math.floor(tonumber(StyleTable.IndicatorHeight) or 20)) end

		if TopTabHolder then
			local layout=TopTabHolder:FindFirstChildOfClass("UIListLayout")
			if layout then layout.Padding=UDim.new(0,target.Gap or 5) end
		end
		if TabHolder then
			local layout=TabHolder:FindFirstChildOfClass("UIListLayout")
			if layout then layout.Padding=UDim.new(0,target.Gap or (WindowConfig.ShowTabInfo and 8 or 6)) end
		end
		if styleNewUITopTabs then pcall(styleNewUITopTabs) end
		if styleNewUISidebar then pcall(styleNewUISidebar) end
		if refreshSelectedTabVisuals then pcall(refreshSelectedTabVisuals) end
