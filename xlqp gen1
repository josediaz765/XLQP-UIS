XLQPGen1._RefreshElementBackgroundImages=function(self,themeName)
	local enabled=WindowConfig.LiveColorElementBackground==true
	local data=enabled and self:GetLiveColorThemeData(themeName or WindowConfig.LiveColorTheme or "Cold Heat") or nil
	local source=data and tostring(data.ElementBackgroundImage or data.BackgroundImage or data.Image or "") or ""
	local transparency=math.clamp(tonumber(data and (data.ElementImageTransparency or data.ImageTransparency)) or .14,0,1)
	transparency=math.clamp(transparency+.3,.3,.72)
	self._LiveColorElementBackgroundTransparency=transparency
	if not enabled or source=="" then
		elementBackgroundImageToken+=1
		elementBackgroundImageLoading=false
		elementBackgroundImageSource=""
		elementBackgroundImageAsset=""
		self._LiveColorElementBackgroundAsset=""
		applyElementBackgroundImages(false,"",transparency)
		return self
	end
	if elementBackgroundImageSource==source and elementBackgroundImageAsset~="" then
		self._LiveColorElementBackgroundAsset=elementBackgroundImageAsset
		applyElementBackgroundImages(true,elementBackgroundImageAsset,transparency)
		return self
	end
	if elementBackgroundImageLoading and elementBackgroundImageSource==source then return self end
	elementBackgroundImageToken+=1
	local token=elementBackgroundImageToken
	elementBackgroundImageSource=source
	elementBackgroundImageLoading=true
	task.spawn(function()
		local resolved=resolveCustomBackgroundAsset(source)
		if token~=elementBackgroundImageToken or WindowConfig.LiveColorElementBackground~=true then return end
		elementBackgroundImageLoading=false
		elementBackgroundImageAsset=resolved or ""
		self._LiveColorElementBackgroundAsset=elementBackgroundImageAsset
		applyElementBackgroundImages(elementBackgroundImageAsset~="",elementBackgroundImageAsset,transparency)
	end)
	return self
end

