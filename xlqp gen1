	local function polishLegacySettingsRow(obj)
		if not (SettingsWindow and obj and obj:IsA("GuiObject") and obj:IsDescendantOf(SettingsWindow)) then return end
		local height=obj.Size.Y.Offset
		if height<36 or height>50 or obj.Size.Y.Scale~=0 then return end
		local labels={}
		for _,child in ipairs(obj:GetChildren()) do
			if child:IsA("TextLabel") and child.Visible and child.BackgroundTransparency>=.9 then labels[#labels+1]=child end
		end
		if #labels<2 then return end
		table.sort(labels,function(a,b) return a.Position.Y.Offset<b.Position.Y.Offset end)
		local title=labels[1]
		local description=labels[2]
		local titleTop=title.Position.Y.Scale*height+title.Position.Y.Offset
		local titleHeight=title.Size.Y.Scale*height+title.Size.Y.Offset
		local descriptionTop=description.Position.Y.Scale*height+description.Position.Y.Offset
		local titleBottom=titleTop+math.max(1,titleHeight)
		if titleBottom<=descriptionTop+2 then return end
		obj.Size=UDim2.new(obj.Size.X.Scale,obj.Size.X.Offset,0,58)
		title.Position=UDim2.new(title.Position.X.Scale,math.max(12,title.Position.X.Offset),0,8)
		title.Size=UDim2.new(title.Size.X.Scale,title.Size.X.Offset,0,20)
		title.TextYAlignment=Enum.TextYAlignment.Center
		title.TextTruncate=Enum.TextTruncate.AtEnd
		description.Position=UDim2.new(description.Position.X.Scale,math.max(12,description.Position.X.Offset),0,33)
		description.Size=UDim2.new(description.Size.X.Scale,description.Size.X.Offset,0,16)
		description.TextYAlignment=Enum.TextYAlignment.Center
		description.TextTruncate=Enum.TextTruncate.AtEnd
		for _,child in ipairs(obj:GetChildren()) do
			if child:IsA("GuiObject") and child~=title and child~=description and child.Size.Y.Scale==0 and child.Size.Y.Offset>0 and child.Position.X.Scale>=.45 then
				child.Position=UDim2.new(child.Position.X.Scale,child.Position.X.Offset,.5,-math.floor(child.Size.Y.Offset/2))
			end
		end
