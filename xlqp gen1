XLQPGen1:MakeNotification({Name="Diagnostics",Content="Errors: "..tostring(#(XLQPGen1.LibErrors or {})).."  |  FPS: "..string.format("%.1f",currentFps()),Image="info",Time=6})
end)

task.defer(layoutStatusBar)
return bar
end

