 function WindowConfig._LocalRegisterState.queueResizeFollowup(key,callback)
	if key==nil or type(callback)~="function" then return end
	WindowConfig._LocalRegisterState.pendingResizeFollowups[key]=callback
	if WindowConfig._LocalRegisterState.resizeFollowupWorkerRunning then return end
	WindowConfig._LocalRegisterState.resizeFollowupWorkerRunning=true
	XLQPGen1._ResizeFollowupsRunning=true
	task.spawn(function()
		while true do
			while WindowConfig._LocalRegisterState.resizeWorkPaused() do task.wait(0.04) end
			RunService.Heartbeat:Wait()
			local jobs=WindowConfig._LocalRegisterState.pendingResizeFollowups
			WindowConfig._LocalRegisterState.pendingResizeFollowups=WindowConfig._LocalRegisterState.resizeFollowupBuffer or setmetatable({},{__mode="k"})
			WindowConfig._LocalRegisterState.resizeFollowupBuffer=jobs
			for key in pairs(WindowConfig._LocalRegisterState.pendingResizeFollowups) do WindowConfig._LocalRegisterState.pendingResizeFollowups[key]=nil end
			local processed=0
			local sliceStarted=os.clock()
			for _,job in pairs(jobs) do
				pcall(job)
				processed=processed+1
				if processed>=4 or os.clock()-sliceStarted>=0.002 then
					RunService.Heartbeat:Wait()
					processed=0
					sliceStarted=os.clock()
				end
			end
			if next(WindowConfig._LocalRegisterState.pendingResizeFollowups)==nil then
				WindowConfig._LocalRegisterState.resizeFollowupWorkerRunning=false
				XLQPGen1._ResizeFollowupsRunning=false
				return
			end
		end
	end)
 end
