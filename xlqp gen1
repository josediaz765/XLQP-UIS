function XLQPGen1:AddDecoration(spec)
	if type(spec)~="table" then return false end
	if self.DecorationStyle~="Custom Set" then
		local copied={}
		for _,item in ipairs(self.DecorationPresets[self.DecorationStyle] or {}) do table.insert(copied,item) end
		self.DecorationPresets["Custom Set"]=copied
		self.DecorationStyle="Custom Set"
	end
	table.insert(self.DecorationPresets["Custom Set"],spec)
	self.DecorationsEnabled=true
	if self._DecorationController then self._DecorationController:Rebuild() end
	return true
end

function XLQPGen1:AddDecorationLink(link,styleName,size)
	link=tostring(link or ""):gsub("^%s+",""):gsub("%s+$","")
	if link=="" or (not link:match("^https?://") and not link:match("^rbxasset") and not tonumber(link)) then return nil,"Use a direct HTTPS image link or Roblox asset id." end
	styleName=tostring(styleName or "")
	if styleName=="" then
		local index=1
		repeat styleName="Custom Sticker "..index index+=1 until not self.DecorationPresets[styleName]
	end
	size=math.clamp(tonumber(size) or 82,30,180)
	self.DecorationPresets[styleName]={
		{Image=link,Corner="TopRight",Size=size,Tilt=8,Glow=Color3.fromRGB(180,120,255)},
		{Image=link,Corner="BottomLeft",Size=size,Tilt=-8,Glow=Color3.fromRGB(100,190,255)},
		{Image="sparkles",Corner="TopLeft",Size=46,Glow=Color3.fromRGB(185,125,255)},
		{Image="sparkle",Corner="BottomRight",Size=50,Glow=Color3.fromRGB(110,200,255)}
	}
	self.DecorationStyle=styleName
	self.DecorationsEnabled=true
	if self._DecorationController then self._DecorationController:Rebuild() end
	return styleName
end

function XLQPGen1:_ConfigureDecorations(config)
	config=type(config)=="table" and config or {}
	local appearance=type(config.Appearance)=="table" and config.Appearance or {}
	local enabled=config.DecorationsEnabled
	if enabled==nil then enabled=appearance.DecorationsEnabled end
	if enabled==nil then enabled=appearance.StickersEnabled end
	local style=config.DecorationStyle or appearance.DecorationStyle or appearance.StickerStyle
	local designsEnabled=config.WindowDesignsEnabled
	if designsEnabled==nil then designsEnabled=appearance.WindowDesignsEnabled end
	if designsEnabled==nil then designsEnabled=appearance.DesignsEnabled end
	local designStyle=config.WindowDesignStyle or appearance.WindowDesignStyle or appearance.DesignStyle
	self.DecorationsEnabled=enabled==true
	if style and self.DecorationPresets[tostring(style)] then self.DecorationStyle=tostring(style) end
	self.WindowDesignsEnabled=designsEnabled==true
	if designStyle and self.WindowDesignPresets[tostring(designStyle)] then self.WindowDesignStyle=tostring(designStyle) end
	self._PendingDecorationLink=config.DecorationLink or appearance.DecorationLink or appearance.StickerLink
end

function XLQPGen1:_InitializeDecorations()
	local target=self._MainWindow or self._ActiveMainWindow
	if not target then return end
	self:_AttachDecorations(target)
	if self._PendingDecorationLink and tostring(self._PendingDecorationLink)~="" then self:AddDecorationLink(self._PendingDecorationLink,"Custom URL") end
end

function XLQPGen1:_BuildHomeChangelog(page,initial,options)
	options=type(options)=="table" and options or {}
	local controller={Type="HomeChangelog",Wrapper=page,Entries={}}
	local font=typeof(options.ChangelogFont)=="EnumItem" and options.ChangelogFont or XLQPGen1.UIFont or Enum.Font.Gotham
	local titleFont=typeof(options.ChangelogTitleFont)=="EnumItem" and options.ChangelogTitleFont or Enum.Font.GothamBold
	local changelogTheme=XLQPGen1.Themes[XLQPGen1.SelectedTheme] or XLQPGen1.Themes.Default or {}
	local function readableChangelogColor(value,fallback,strength)
		local color=typeof(value)=="Color3" and value or fallback
		if typeof(color)~="Color3" then color=Color3.fromRGB(235,237,244) end
		local luminance=color.R*0.2126+color.G*0.7152+color.B*0.0722
		if luminance<0.44 then color=color:Lerp(Color3.new(1,1,1),strength or 0.48) end
		return color
	end
	local titleColor=readableChangelogColor(options.ChangelogTitleColor,changelogTheme.Text or Color3.fromRGB(242,244,250),0.34)
	local textColor=readableChangelogColor(options.ChangelogTextColor,changelogTheme.Text or Color3.fromRGB(220,223,232),0.46)
	local mutedColor=readableChangelogColor(options.ChangelogMutedColor,changelogTheme.TextDark or changelogTheme.Text or Color3.fromRGB(178,182,194),0.58)
	local typeStyle={Added={Color=Color3.fromRGB(128,210,152),Icon="star"},Changed={Color=Color3.fromRGB(245,190,100),Icon="refresh-cw"},Fixed={Color=Color3.fromRGB(132,176,255),Icon="settings"},Removed={Color=Color3.fromRGB(235,128,132),Icon="minus"}}
	local function normalize(input)
		if type(input)~="table" then return {{Version=tostring(options.ChangelogVersion or "Updates"),Subtitle=tostring(options.ChangelogSubtitle or "Latest release"),Changes={{Type="Changed",Text=tostring(input or "")}}}} end
		if type(input.Versions)=="table" then return input.Versions end
		if input.Version or input.Changes then return {input} end
		if #input>0 and type(input[1])=="table" and (input[1].Version or input[1].Changes) then return input end
		local changes={}
		for _,entry in ipairs(input) do
			if type(entry)=="table" then
				changes[#changes+1]={Type=entry.Type or "Changed",Text=entry.Text or entry.Content or entry.Title or "Update",Description=entry.Description or entry.Paragraph,Color=entry.Color,Icon=entry.Icon}
			else
				changes[#changes+1]={Type="Changed",Text=tostring(entry)}
			end
		end
		return {{Version=tostring(input.VersionTitle or options.ChangelogVersion or "Updates"),Subtitle=tostring(input.Subtitle or options.ChangelogSubtitle or "Latest release"),Changes=changes}}
	end
	local function renderVersion(version,index)
		version=type(version)=="table" and version or {Version=tostring(version),Changes={}}
		local card=Create("Frame",{Name="ChangelogVersion"..index,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,LayoutOrder=index,BackgroundColor3=typeof(version.BackgroundColor)=="Color3" and version.BackgroundColor or Color3.fromRGB(31,32,38),BackgroundTransparency=tonumber(version.BackgroundTransparency) or 0.12,BorderSizePixel=0,Parent=page})
		card:SetAttribute("HomeResponsiveWidth",true)
		card:SetAttribute("HomeResponsiveInset",0)
		Create("UICorner",{CornerRadius=UDim.new(0,12),Parent=card})
		Create("UIStroke",{Color=Color3.fromRGB(85,87,101),Transparency=0.65,Thickness=1,Parent=card})
		Create("UIPadding",{PaddingTop=UDim.new(0,13),PaddingBottom=UDim.new(0,13),PaddingLeft=UDim.new(0,14),PaddingRight=UDim.new(0,14),Parent=card})
		Create("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,5),Parent=card})
		local header=Create("Frame",{Name="Header",Size=UDim2.new(1,0,0,29),LayoutOrder=0,BackgroundTransparency=1,Parent=card})
		local versionLabel=Create("TextLabel",{Name="Version",Size=UDim2.new(0.62,0,1,0),BackgroundTransparency=1,Text=tostring(version.Version or version.Title or "Update"),Font=titleFont,TextSize=15,TextColor3=typeof(version.TitleColor)=="Color3" and version.TitleColor or titleColor,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=header})
		local subtitleText=tostring(version.Subtitle or version.Date or "")
		local subtitleLabel=Create("TextLabel",{Name="Subtitle",Size=UDim2.new(0.38,0,1,0),Position=UDim2.new(0.62,0,0,0),BackgroundTransparency=1,Text=subtitleText,Font=font,TextSize=12,TextColor3=mutedColor,TextXAlignment=Enum.TextXAlignment.Right,TextTruncate=Enum.TextTruncate.AtEnd,Parent=header})
		versionLabel:SetAttribute("VHNoAutoTextFit",true)
		subtitleLabel:SetAttribute("VHNoAutoTextFit",true)
		local function layoutHeader()
			local width=header.AbsoluteSize.X
			if subtitleText=="" or width<330 then
				versionLabel.Size=UDim2.new(1,0,1,0)
				subtitleLabel.Visible=false
			else
				versionLabel.Size=UDim2.new(.62,0,1,0)
				subtitleLabel.Position=UDim2.new(.62,0,0,0)
				subtitleLabel.Size=UDim2.new(.38,0,1,0)
				subtitleLabel.Visible=true
			end
		end
		AddConnection(header:GetPropertyChangedSignal("AbsoluteSize"),layoutHeader)
		task.defer(layoutHeader)
		local changes=type(version.Changes)=="table" and version.Changes or type(version.Entries)=="table" and version.Entries or {}
		for rowIndex,change in ipairs(changes) do
			change=type(change)=="table" and change or {Text=tostring(change),Type="Changed"}
			local kind=tostring(change.Type or change.Kind or "Changed")
			kind=kind:sub(1,1):upper()..kind:sub(2):lower()
			local style=typeStyle[kind] or typeStyle.Changed
			local badgeColor=typeof(change.Color)=="Color3" and change.Color or typeof(version.BadgeColor)=="Color3" and version.BadgeColor or style.Color
			local row=Create("Frame",{Name="Change"..rowIndex,Size=UDim2.new(1,0,0,35),LayoutOrder=rowIndex*2,BackgroundTransparency=1,Parent=card})
			local badge=Create("Frame",{Name="Badge",Size=UDim2.fromOffset(112,24),Position=UDim2.fromOffset(0,5),BackgroundColor3=badgeColor,BackgroundTransparency=0.68,BorderSizePixel=0,Parent=row})
			Create("UICorner",{CornerRadius=UDim.new(0,7),Parent=badge})
			Create("ImageLabel",{Name="Icon",Size=UDim2.fromOffset(14,14),Position=UDim2.fromOffset(9,5),BackgroundTransparency=1,Image=GetIcon(change.Icon or style.Icon) or GetIcon("info"),ImageColor3=badgeColor,Parent=badge})
			local kindLabel=Create("TextLabel",{Name="Kind",Size=UDim2.new(1,-31,1,0),Position=UDim2.fromOffset(29,0),BackgroundTransparency=1,Text=kind:upper(),Font=titleFont,TextSize=10,TextColor3=badgeColor,TextXAlignment=Enum.TextXAlignment.Left,Parent=badge})
			kindLabel:SetAttribute("VHNoAutoTextFit",true)
			kindLabel:SetAttribute("NoLiquidGlassText",true)
			local description=tostring(change.Text or change.Title or change.Content or "")
			local paragraph=change.Description or change.Paragraph
			if paragraph and tostring(paragraph)~="" then description=description.."\n"..tostring(paragraph) end
			local descriptionFont=typeof(change.Font)=="EnumItem" and change.Font or font
			local descriptionLabel=Create("TextLabel",{Name="Description",Size=UDim2.new(1,0,0,34),Position=UDim2.fromOffset(0,34),BackgroundTransparency=1,Text=description,TextWrapped=true,Font=descriptionFont,TextSize=12,TextColor3=typeof(change.TextColor)=="Color3" and change.TextColor or textColor,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,TextTruncate=Enum.TextTruncate.None,Parent=row})
			descriptionLabel:SetAttribute("VHNoAutoTextFit",true)
			descriptionLabel:SetAttribute("NoLiquidGlassText",true)
			local lastWidth=-1
			local function layoutRow()
				if not row.Parent then return end
				local width=math.max(40,math.floor(row.AbsoluteSize.X+0.5))
				if width==lastWidth then return end
				lastWidth=width
				badge.Size=UDim2.fromOffset(math.min(112,width),24)
				badge.Position=UDim2.fromOffset(0,2)
				local measured=TextService:GetTextSize(description,12,descriptionFont,Vector2.new(width,10000))
				local descHeight=math.max(24,math.ceil(measured.Y)+4)
				descriptionLabel.Position=UDim2.fromOffset(0,34)
				descriptionLabel.Size=UDim2.new(1,0,0,descHeight)
				row.Size=UDim2.new(1,0,0,38+descHeight)
			end
			AddConnection(row:GetPropertyChangedSignal("AbsoluteSize"),layoutRow)
			task.defer(layoutRow)
			if rowIndex<#changes then Create("Frame",{Name="Separator",Size=UDim2.new(1,0,0,1),LayoutOrder=rowIndex*2+1,BackgroundColor3=Color3.fromRGB(180,184,198),BackgroundTransparency=0.84,BorderSizePixel=0,Parent=card}) end
		end
		return card
	end
	function controller:SetEntries(input)
		for _,child in ipairs(page:GetChildren()) do if child:IsA("Frame") and child.Name:match("^ChangelogVersion") then child:Destroy() end end
		table.clear(self.Entries)
		for _,version in ipairs(normalize(input)) do self.Entries[#self.Entries+1]=version renderVersion(version,#self.Entries) end
		if XLQPGen1._RefreshScrollCanvas then XLQPGen1:_RefreshScrollCanvas(page) end
		return self
	end
	function controller:AddVersion(version)
		self.Entries[#self.Entries+1]=version
		renderVersion(version,#self.Entries)
		if XLQPGen1._RefreshScrollCanvas then XLQPGen1:_RefreshScrollCanvas(page) end
		return self
	end
	controller:SetEntries(initial)
	return controller
end


local function XLQPSearchMenuCategory(typeName,name)
	typeName=tostring(typeName or "")
	name=tostring(name or "")
	local lower=(typeName.." "..name):lower()
	if lower:find("tab",1,true) or lower:find("groupbox",1,true) or lower:find("section",1,true) or lower:find("layout",1,true) or lower:find("sidebar",1,true) then return "Layout" end
	if lower:find("textbox",1,true) or lower:find("textarea",1,true) or lower:find("dropdown",1,true) or lower:find("color",1,true) or lower:find("command",1,true) or lower:find("input",1,true) then return "Inputs" end
	if lower:find("button",1,true) or lower:find("toggle",1,true) or lower:find("slider",1,true) or lower:find("bind",1,true) or lower:find("radio",1,true) or lower:find("segment",1,true) or lower:find("rating",1,true) or lower:find("stepper",1,true) or lower:find("progress",1,true) then return "Controls" end
	if lower:find("label",1,true) or lower:find("paragraph",1,true) or lower:find("notice",1,true) or lower:find("log",1,true) or lower:find("status",1,true) or lower:find("badge",1,true) or lower:find("faq",1,true) or lower:find("timeline",1,true) or lower:find("checklist",1,true) or lower:find("tag",1,true) or lower:find("shortcut",1,true) then return "Text & Status" end
	if lower:find("table",1,true) or lower:find("data",1,true) or lower:find("chart",1,true) or lower:find("runtime",1,true) or lower:find("count",1,true) or lower:find("clock",1,true) or lower:find("friend",1,true) or lower:find("metric",1,true) or lower:find("revenue",1,true) then return "Data" end
	if lower:find("image",1,true) or lower:find("video",1,true) or lower:find("viewport",1,true) or lower:find("visual",1,true) or lower:find("drawing",1,true) or lower:find("nametag",1,true) then return "Visual" end
	if lower:find("media",1,true) or lower:find("music",1,true) or lower:find("audio",1,true) or lower:find("bytebeat",1,true) or lower:find("spotify",1,true) then return "Media" end
	if lower:find("executor",1,true) or lower:find("executer",1,true) or lower:find("script",1,true) or lower:find("chat",1,true) or lower:find("studio",1,true) or lower:find("ai",1,true) or lower:find("passthrough",1,true) then return "Advanced" end
	return "Other"
end

local function XLQPSearchMenuIcon(typeName,category)
	local lower=tostring(typeName or ""):lower()
	if lower:find("toggle",1,true) then return "toggle-right" end
	if lower:find("slider",1,true) then return "sliders-horizontal" end
	if lower:find("dropdown",1,true) then return "chevrons-up-down" end
	if lower:find("color",1,true) then return "palette" end
	if lower:find("button",1,true) then return "mouse-pointer-click" end
	if lower:find("textbox",1,true) or lower:find("textarea",1,true) or lower:find("input",1,true) then return "text-cursor-input" end
	if lower:find("tab",1,true) then return "panel-left" end
	if lower:find("executor",1,true) or lower:find("executer",1,true) or lower:find("code",1,true) then return "code-2" end
	if lower:find("chat",1,true) then return "message-square" end
