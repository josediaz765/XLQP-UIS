	local function mediaPreview(link)
		link=tostring(link or ""):match("^%s*(.-)%s*$")
		if link=="" then
			stopPreview()
			mediaName.Text="Paste media below"
			status.Text="Paste a link to preview it live."
			return
		end
		previewToken+=1
		local token=previewToken
		previewGif:Stop(true)
		pcall(function() previewVideo:Pause() end)
		previewVideo.Video=""
		previewVideo.Visible=false
		previewImage.Image=""
		pcall(function() previewImage.ImageContent=nil end)
		previewImage.Visible=false
		previewEmpty.Visible=true
		emptyIcon.Visible=true
		local kind=self:_DetectCustomLiveMediaType(link)
		local display=self:_CustomLiveMediaDisplayName(link)
		mediaName.Text=display.."  ·  "..kind
		if nameBox.Text=="" or mode=="Custom" and not selectedSaved then nameBox.Text=display end
		status.Text="Fetching "..kind:lower().." preview…"
		task.spawn(function()
			if kind=="GIF" then
				previewImage.Visible=true
				previewEmpty.Visible=false
				emptyIcon.Visible=false
				local ok,message=previewGif:Apply(link,0)
				if token~=previewToken then return end
				status.Text=ok and "GIF preview ready." or tostring(message or "GIF preview failed.")
			elseif kind=="Video" then
				local asset,errorMessage=self:_ResolveCustomLiveMediaAsset(link,"Video")
				if token~=previewToken then return end
				if asset then
					previewVideo.Video=asset
					previewVideo.Visible=true
					previewEmpty.Visible=false
					emptyIcon.Visible=false
					pcall(function() previewVideo:Play() end)
					status.Text="Video preview ready."
				else
					status.Text=tostring(errorMessage or "Video preview failed.")
				end
			else
				local asset,errorMessage=self:_ResolveCustomLiveMediaAsset(link,"Image")
				if token~=previewToken then return end
				if asset then
					previewImage.Image=asset
					previewImage.Visible=true
					previewEmpty.Visible=false
					emptyIcon.Visible=false
					status.Text="Image preview ready."
				else
					status.Text=tostring(errorMessage or "Image preview failed.")
				end
			end
		end)
	end

