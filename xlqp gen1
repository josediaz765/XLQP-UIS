function XLQPGen1:Dialog(DialogConfig)
	DialogConfig = type(DialogConfig) == "table" and DialogConfig or {Title = tostring(DialogConfig or "Dialog")}
	local title = tostring(DialogConfig.Title or DialogConfig.Name or "Dialog Title")
	local description = tostring(DialogConfig.Description or DialogConfig.Content or DialogConfig.Desc or "")
	local buttons = DialogConfig.Buttons or DialogConfig.Options or DialogConfig.Actions or {}
	local theme = self.Themes[self.SelectedTheme] or {}
	local mainColor = theme.Main or Color3.fromRGB(18, 18, 20)
	local secondColor = theme.Second or Color3.fromRGB(28, 28, 32)
	local strokeColor = theme.Stroke or Color3.fromRGB(60, 60, 66)
	local textColor = theme.Text or Color3.fromRGB(235, 235, 240)
	local darkText = theme.TextDark or Color3.fromRGB(150, 150, 158)
	local width = math.clamp(math.floor(tonumber(DialogConfig.Width) or 320), 220, 720)
	local bannerHeight = DialogConfig.Image ~= nil and math.clamp(math.floor(tonumber(DialogConfig.ImageHeight) or 118), 40, 320) or 0
	local hasBanner = bannerHeight > 0

	local gui = Instance.new("ScreenGui")
	gui.Name = "XLQPDialog"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	gui.DisplayOrder = math.min(2147483647, (self:GetZIndex() or 9999) + 40)
	gui.Parent = XLQPGetGuiParent()
	self:RegisterPopupGui(gui)

	local shade = Create("Frame", {
		Name = "Shade",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = true,
		ZIndex = 1,
		Parent = gui
	})
	local shadeClick = Create("TextButton", {Size = UDim2.fromScale(1, 1), Text = "", BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 1, Parent = shade})

	local card = Create("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, 100),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = mainColor,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = gui
	}, {
		Create("UICorner", {CornerRadius = UDim.new(0, math.floor(tonumber(DialogConfig.CornerRadius) or 22))}),
		Create("UIPadding", {PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14)}),
		Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10)})
	})
	local cardScale = Create("UIScale", {Scale = 0.88, Parent = card})
	local cardStroke = Create("UIStroke", {Color = strokeColor, Thickness = 1, Transparency = 1, Parent = card})

	local fadeTargets = {}
	local function track(object, property, value)
		fadeTargets[#fadeTargets + 1] = {Object = object, Property = property, Value = value}
		object[property] = 1
	end
	track(card, "BackgroundTransparency", 0)
	track(cardStroke, "Transparency", 0.4)

	if hasBanner then
		local banner = Create("Frame", {
			Name = "Banner",
			Size = UDim2.new(1, 0, 0, bannerHeight),
			BackgroundColor3 = secondColor,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			LayoutOrder = 1,
			ZIndex = 4,
			Parent = card
		}, {Create("UICorner", {CornerRadius = UDim.new(0, 16)})})
		track(banner, "BackgroundTransparency", 0)
		local image = Create("ImageLabel", {
			Name = "Image",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = tostring(DialogConfig.Image),
			ScaleType = Enum.ScaleType.Crop,
			ZIndex = 5,
			Parent = banner
		})
		image:SetAttribute("PreserveImageColor", true)
		image:SetAttribute("NoLiquidGlassIcon", true)
		track(image, "ImageTransparency", 0)
	end

	local titleLabel = Create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = textColor,
		TextSize = 19,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
		ZIndex = 4,
		Parent = card
	})
	track(titleLabel, "TextTransparency", 0)

	local descriptionLabel
	if description ~= "" then
		descriptionLabel = Create("TextLabel", {
			Name = "Description",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = description,
			TextColor3 = darkText,
			TextSize = 14,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			RichText = DialogConfig.RichText == true,
			LayoutOrder = 3,
			ZIndex = 4,
			Parent = card
		})
		track(descriptionLabel, "TextTransparency", 0)
	end

	local Dialog = {Title = title, Type = "Dialog", Gui = gui, Card = card, Open = true, Buttons = {}}
	local closing = false
	function Dialog:Close(reason)
		if closing then return self end
		closing = true
		self.Open = false
		TweenService:Create(shade, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
		TweenService:Create(cardScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.9}):Play()
		for _, entry in ipairs(fadeTargets) do
			if entry.Object.Parent then
				TweenService:Create(entry.Object, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {[entry.Property] = 1}):Play()
			end
		end
		task.delay(0.24, function()
			if gui and gui.Parent then gui:Destroy() end
		end)
		SafeCallback(DialogConfig.OnClose, "Dialog " .. title, reason, self)
		return self
	end

	local rowIndex = 0
	local pending = {}
	for _, entry in ipairs(buttons) do
		pending[#pending + 1] = type(entry) == "table" and entry or {Text = tostring(entry)}
	end
	local cursor = 1
	while cursor <= #pending do
		local remaining = #pending - cursor + 1
		local pair = remaining >= 2 and (remaining ~= 3 or cursor + 1 < #pending)
		local count = pair and 2 or 1
		rowIndex += 1
		local row = Create("Frame", {
			Name = "ButtonRow",
			Size = UDim2.new(1, 0, 0, 46),
			BackgroundTransparency = 1,
			LayoutOrder = 10 + rowIndex,
			ZIndex = 4,
			Parent = card
		}, {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 10)
			})
		})
		for slot = 1, count do
			local config = pending[cursor]
			cursor += 1
			local label = tostring(config.Text or config.Name or config.Title or "OK")
			local accent = XLQPResolveTagColor(config.Color, nil)
			local button = Create("TextButton", {
				Name = "DialogButton",
				Size = count == 2 and UDim2.new(0.5, -5, 1, 0) or UDim2.new(1, 0, 1, 0),
				BackgroundColor3 = accent or secondColor,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				LayoutOrder = slot,
				ZIndex = 5,
				Parent = row
			}, {Create("UICorner", {CornerRadius = UDim.new(0, 14)})})
			track(button, "BackgroundTransparency", accent and 0.06 or 0.02)
			local buttonLabel = Create("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = label,
				TextColor3 = accent and Color3.fromRGB(255, 255, 255) or textColor,
				TextSize = 15,
				Font = Enum.Font.GothamBold,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 6,
				Parent = button
			})
			track(buttonLabel, "TextTransparency", 0)
			XLQPAttachCursorGlow(button, button, config)
			AddConnection(button.Activated, function()
				SafeCallback(config.Callback, "Dialog " .. label, Dialog)
				if config.Close ~= false and DialogConfig.CloseOnAction ~= false then Dialog:Close(label) end
			end)
			Dialog.Buttons[#Dialog.Buttons + 1] = {Text = label, Button = button, Label = buttonLabel}
		end
	end

	TweenService:Create(shade, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {BackgroundTransparency = math.clamp(tonumber(DialogConfig.Dim) or 0.45, 0, 1)}):Play()
	TweenService:Create(cardScale, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	for _, entry in ipairs(fadeTargets) do
		TweenService:Create(entry.Object, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {[entry.Property] = entry.Value}):Play()
	end

	if DialogConfig.CloseOnOutside ~= false then
		AddConnection(shadeClick.Activated, function() Dialog:Close("Outside") end)
	end
	if tonumber(DialogConfig.Time) then
		task.delay(tonumber(DialogConfig.Time), function() Dialog:Close("Timeout") end)
	end
	pcall(function() self:Haptic(0.4, 0.03) end)
	return Dialog
end

