function XLQPGen1:_GetTopBarQuickPanelsConfig()
	local windowConfig=self._WindowConfig or {}
	local config=windowConfig.TopBarQuickPanels
	if config==nil then config=windowConfig.QuickPanels end
	if config==nil then config=windowConfig.TopPanels end
	if config==true then config={Enabled=true} end
	if type(config)~="table" or config.Enabled==false then return nil end
	if config.Enabled==nil then config.Enabled=true end
	if config.Toggles==nil then config.Toggles=true end
	if config.Notifications==nil then config.Notifications=true end
	return config
