	self._NavigationLayoutFixInstalled=true
	if not (window and MainWindow and TopBar) then return end
	local library=self
	local headerConfig=type(library._ActiveWindowConfig)=="table" and library._ActiveWindowConfig or {}
	local textService=game:GetService("TextService")
	local historyBack={}
	local historyForward={}
	local navigatingHistory=false
	local searchNormalVisible=SearchContainer and SearchContainer.Visible or false
	local layoutQueued=false
	local lastPageInset=nil
	local searchPolished=false
	local paragraphFrames=setmetatable({},{__mode="k"})
	local paragraphAttachPending=setmetatable({},{__mode="k"})
	local textboxes=setmetatable({},{__mode="k"})
	local pendingInspect=setmetatable({},{__mode="k"})
