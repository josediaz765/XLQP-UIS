			ProfileConfig.Items = ProfileConfig.Items or ProfileConfig.Players or ProfileConfig.Profiles or {}
			local Profiles = {Name=ProfileConfig.Name, Type="ProfileCards", Items={}}
			local columns = math.clamp(math.floor(tonumber(ProfileConfig.Columns) or 2), 1, 4)
			local wrapper = AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(255,255,255), 0, getNewUICornerRadius and getNewUICornerRadius(0.9,12) or 12), {
